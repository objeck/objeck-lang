core/utils/updater/obu
# obi, obd, obb and obn build in place the same way
core/repl/obi
core/debugger/obd
core/utils/launcher/obb
core/utils/launcher/obn

# Build output directories (ONNX)
core/lib/onnx/vs/x64/
core/lib/onnx/x64/
core/release/ONNX

# Local helper scripts and temp files
core/release/run_*.bat
core/release/code_doc_output.txt

# Downloaded models and data (large).
#
# ANCHORED ON PURPOSE. A bare "data/" matches a directory of that name at any
# depth, so every new file under programs/**/data/ was silently unstageable:
# git add said nothing and the file never reached a commit. The datasets that
# live there today survive only because they were added before the rule. That
# is how programs/frameworks/ml/data/dt2.csv could be replaced by an unrelated
# file and go unnoticed. Ignore the big downloads by name instead, so a new
# dataset is visible by default and a large file is something you decline to
# add rather than something git hides from you.
/data/
programs/frameworks/ml/data/*.zip
programs/tests/data/*.zip
programs/frameworks/opencv_onnx/data/faces/
programs/frameworks/opencv_onnx/data/models/
programs/frameworks/opencv_onnx/data/media/visdrone/

# Benchmark results
perf-results/

# Scratch / work-in-progress (not part of the build)
wip/

# Local test scripts
programs/regression/run_tests.sh
programs/tests/clbg/run_binarytrees.sh
programs/tests/run_prgm_tests.sh
programs/deploy/test_sdl.obs

# Misc
nul
.ftpquota
build.txt
/git
core/release/out.txt
*.zip
# Build artifacts. POSIX builds leave each native library next to its source
# (core/lib/sdl/sdl.so); the vendored .so files deeper down stay tracked.
core/lib/*/*.so
core/vm/obr_dbg
core/lib/onnx/eq/*.dylib

# Large media files (host externally)
*.mp4
*.pptx
*.ppt

# Python bytecode (test harnesses under programs/regression and tools/lsp/tests)
__pycache__/
*.pyc

# Coverity Scan working files. cov_scan.cmd stages under %TEMP%, but cov_scan.sh
# writes objeck-int.tgz into core/release, and a stray cov-int/ from a hand-run
# cov-build lands wherever it was invoked. Never commit a token file either --
# both scripts read the token from OUTSIDE the repo for exactly that reason.
cov-int/
objeck-int.tgz
cov_token.dat
coverity_config.xml

# build-sandbox.sh stages obc/obr/*.obl here inside the work tree on the VPS
programs/web-playground/docker/sandbox-deploy/

# Release-candidate results written by tools/cicd/verify_platform.sh|.cmd
rc-results/
