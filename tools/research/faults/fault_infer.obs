#~
Fault-injection harness for concurrent ONNX inference (research H6, see README.md).

M worker threads share ONE Session (even workers call Session->Run, odd workers use a DeviceTensor and
BoundSession). Every answer is compared with a single-threaded reference computed before the threads
start. Faults come from the same seeded schedule as fault_agents.obs.

  obr fault_infer.obe <seed> <workers> <iters> <fault> <rate> <ep> <deadline_s> <model> [session option k=v ...]

  fault  none | bad_shape | close_inflight | oom_burst | gpu_oom | thread_fault | thread_exit

Output: "W ..." per worker, "HANG" per unfinished worker, "SUMMARY ...". "SKIP ..." when the provider
cannot open.

EXTRA_LIBS: models,onnx,opencv,cipher,json
~#
use API.Onnx;
use API.Models;
use Collection;
use System.Concurrency;

class IFaults {
	function : Mix(seed : Int, a : Int, r : Int, salt : Int) ~ Int {
		x := (seed * 7919 + a * 104729 + r * 1299709 + salt * 15485863 + 12345) % 2147483647;
		if(x = 0) {
			x := 1;
		};
		for(i := 0; i < 4; i += 1;) {
			x := (x * 48271) % 2147483647;
		};
		return x;
	}

	function : Faulted(seed : Int, a : Int, r : Int, rate : Float) ~ Bool {
		u := Mix(seed, a, r, 1)->ToFloat() / 2147483647.0;
		return (a % 4 = 0) & u < rate;
	}

	function : Ids(shift : Int) ~ Float[] {
		values := Float->New[12];
		for(i := 0; i < 12; i += 1;) {
			values[i] := ((i * 7 + shift * 3) % 25)->ToFloat();
		};
		return values;
	}

	function : Ones(n : Int) ~ Float[] {
		values := Float->New[n];
		for(i := 0; i < n; i += 1;) {
			values[i] := 1.0;
		};
		return values;
	}

	function : Same(a : Float[], b : Float[]) ~ Bool {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return false;
		};
		for(i := 0; i < a->Size(); i += 1;) {
			if((a[i] - b[i])->Abs() > 0.001) {
				return false;
			};
		};
		return true;
	}

	function : Plain(session : Session, ids : Float[], bad : Bool) ~ Float[] {
		inputs := Vector->New()<Tensor>;
		if(bad) {
			# a sequence length of 5 against a mask and type ids of length 6: the model cannot accept it
			inputs->AddBack(Tensor->New("input_ids", "INT64", [2, 5], Ones(10)));
		}
		else {
			inputs->AddBack(Tensor->New("input_ids", "INT64", [2, 6], ids));
		};
		inputs->AddBack(Tensor->New("attention_mask", "INT64", [2, 6], Ones(12)));
		inputs->AddBack(Tensor->New("token_type_ids", "INT64", [2, 6], Float->New[12]));
		outputs := session->Run(inputs);
		if(outputs = Nil | outputs->Size() = 0) {
			return Nil;
		};
		return outputs->Get(0)->GetFloats();
	}
}

class Floats {
	@values : Float[];

	New(values : Float[]) {
		@values := values;
	}

	method : public : Get() ~ Float[] {
		return @values;
	}
}

class IBoard {
	@mutex : ThreadMutex;
	@finished : Int;
	@done_flag : Bool[];
	@at : Int[];

	New(n : Int) {
		@mutex := ThreadMutex->New("iboard");
		@done_flag := Bool->New[n];
		@at := Int->New[n];
	}

	method : public : Line(text : String) ~ Nil {
		critical(@mutex) {
			text->PrintLine();
		};
	}

	method : public : Progress(w : Int, i : Int) ~ Nil {
		@at[w] := i;
	}

	method : public : Finish(w : Int) ~ Nil {
		critical(@mutex) {
			@done_flag[w] := true;
			@finished += 1;
		};
	}

	method : public : Finished() ~ Int {
		critical(@mutex) {
			return @finished;
		};
		return 0;
	}

	method : public : IsDone(w : Int) ~ Bool {
		critical(@mutex) {
			return @done_flag[w];
		};
		return false;
	}

	method : public : At(w : Int) ~ Int {
		return @at[w];
	}
}

class InferWorker from Thread {
	@id : Int;
	@iters : Int;
	@seed : Int;
	@fault : String;
	@rate : Float;
	@session : Session;
	@expected : Vector<Floats>;
	@board : IBoard;

	New(id : Int, iters : Int, seed : Int, fault : String, rate : Float, session : Session, expected : Vector<Floats>, board : IBoard) {
		Parent("worker {$id}");
		@id := id;
		@iters := iters;
		@seed := seed;
		@fault := fault;
		@rate := rate;
		@session := session;
		@expected := expected;
		@board := board;
	}

	method : public : Run(param : System.Base) ~ Nil {
		ok := 0;
		refused := 0;
		wrong := 0;
		injected := 0;
		inj_clean := 0;
		maxms := 0;
		bound_mode := (@id % 2) = 1;

		ids_t : DeviceTensor;
		mask_t : DeviceTensor;
		types_t : DeviceTensor;
		out_t : DeviceTensor;
		bound : BoundSession;
		if(bound_mode) {
			ids_t := DeviceTensor->ForInput(@session, "input_ids", [2, 6]);
			mask_t := DeviceTensor->ForInput(@session, "attention_mask", [2, 6]);
			types_t := DeviceTensor->ForInput(@session, "token_type_ids", [2, 6]);
			out_t := DeviceTensor->ForOutput(@session, "logits", [2, 1]);
			bound := BoundSession->New(@session);
			bound->BindInput("input_ids", ids_t);
			bound->BindInput("attention_mask", mask_t);
			bound->BindInput("token_type_ids", types_t);
			bound->BindOutput("logits", out_t);
			mask_t->Upload(IFaults->Ones(12));
			types_t->Upload(Float->New[12]);
		};

		for(i := 0; i < @iters; i += 1;) {
			@board->Progress(@id, i);
			shift := (@id * 13 + i) % @expected->Size();
			want := @expected->Get(shift)->Get();
			bad := false;
			if(@fault->Equals("bad_shape") & IFaults->Faulted(@seed, @id, i, @rate)) {
				bad := true;
				injected += 1;
			};

			timer := System.Time.Timer->New(true);
			# a local declared in a loop body keeps its value from the previous iteration (see RESULTS.md)
			got : Float[] := Nil;
			if(bound_mode) {
				if(bad) {
					# an upload of the wrong length is the bound path's bad shape
					ids_t->Upload(Float->New[5]);
				}
				else {
					ids_t->Upload(IFaults->Ids(shift));
					if(bound->Run()) {
						got := out_t->Download();
					};
				};
			}
			else {
				got := IFaults->Plain(@session, IFaults->Ids(shift), bad);
			};
			timer->End();
			ms := (timer->GetElapsedTime() * 1000.0)->As(Int);
			if(ms > maxms) {
				maxms := ms;
			};

			if(got = Nil) {
				refused += 1;
				if(bad) {
					inj_clean += 1;
				};
			}
			else if(IFaults->Same(got, want)) {
				ok += 1;
			}
			else {
				wrong += 1;
			};
		};

		if(bound_mode) {
			bound->Close();
			ids_t->Close();
			mask_t->Close();
			types_t->Close();
			out_t->Close();
		};
		@board->Line("W id={$@id} bound={$bound_mode} ok={$ok} refused={$refused} wrong={$wrong} injected={$injected} inj_clean={$inj_clean} maxms={$maxms}");
		@board->Finish(@id);
	}
}

class Closer from Thread {
	@session : Session;
	@delay : Int;
	@board : IBoard;

	New(session : Session, delay : Int, board : IBoard) {
		Parent("closer");
		@session := session;
		@delay := delay;
		@board := board;
	}

	method : public : Run(param : System.Base) ~ Nil {
		Thread->Sleep(@delay);
		@session->Close();
		@board->Line("CLOSED session while workers run");
	}
}

# allocates until the runtime or the provider refuses (or the cap is hit)
class Hog from Thread {
	@gpu : Bool;
	@session : Session;
	@cap : Int;
	@board : IBoard;

	New(gpu : Bool, session : Session, cap : Int, board : IBoard) {
		Parent("hog");
		@gpu := gpu;
		@session := session;
		@cap := cap;
		@board := board;
	}

	method : public : Run(param : System.Base) ~ Nil {
		Thread->Sleep(30);
		if(@gpu) {
			held := Vector->New()<DeviceTensor>;
			refused_at := -1;
			for(i := 0; i < @cap & refused_at < 0; i += 1;) {
				t := DeviceTensor->New(@session, "FP32", [2097152]);
				if(<>t->IsOpen()) {
					refused_at := i;
				}
				else {
					held->AddBack(t);
				};
			};
			@board->Line("HOG gpu blocks_held={$held->Size()} refused_at={$refused_at} (8 MB blocks, cap {$@cap})");
			each(t in held) {
				t->Close();
			};
		}
		else {
			held := Vector->New()<Floats>;
			for(i := 0; i < @cap; i += 1;) {
				held->AddBack(Floats->New(Float->New[8388608]));
				held->Get(i)->Get()[0] := i->ToFloat();
				if(i % 10 = 0) {
					@board->Line("HOG cpu blocks={$(i + 1)} (64 MB each)");
				};
			};
			@board->Line("HOG cpu finished cap {$@cap} blocks without refusal");
		};
	}
}

class Saboteur from Thread {
	@kind : String;

	New(kind : String) {
		Parent("saboteur");
		@kind := kind;
	}

	method : public : Run(param : System.Base) ~ Nil {
		Thread->Sleep(40);
		"SABOTEUR firing {$@kind}"->PrintLine();
		if(@kind->Equals("thread_fault")) {
			zero := 0;
			(10 / zero)->PrintLine();
		}
		else {
			Runtime->Exit(7);
		};
	}
}

class FaultInfer {
	function : Main(args : String[]) ~ Nil {
		if(args->Size() < 8) {
			"usage: fault_infer <seed> <workers> <iters> <fault> <rate> <ep> <deadline_s> <model> [k=v ...]"->ErrorLine();
			Runtime->Exit(2);
		};

		seed := args[0]->ToInt();
		workers := args[1]->ToInt();
		iters := args[2]->ToInt();
		fault := args[3];
		rate := args[4]->ToFloat();
		ep := args[5];
		deadline := args[6]->ToInt();
		model := args[7];

		config := Map->New()<String, String>;
		config->Insert("ep", ep);
		for(i := 8; i < args->Size(); i += 1;) {
			kv := args[i];
			eq := kv->Find('=');
			if(eq > 0) {
				config->Insert(kv->SubString(eq), kv->SubString(eq + 1, kv->Size() - eq - 1));
			};
		};

		session := Session->New(model, config);
		if(<>session->IsOpen()) {
			"SKIP session did not open for ep={$ep}"->PrintLine();
			Runtime->Exit(3);
		};

		expected := Vector->New()<Floats>;
		for(s := 0; s < 25; s += 1;) {
			ref := IFaults->Plain(session, IFaults->Ids(s), false);
			if(ref = Nil) {
				"SKIP reference run failed"->PrintLine();
				Runtime->Exit(3);
			};
			expected->AddBack(Floats->New(ref));
		};

		board := IBoard->New(workers);
		overall := System.Time.Timer->New(true);
		for(w := 0; w < workers; w += 1;) {
			InferWorker->New(w, iters, seed, fault, rate, session, expected, board)->Execute(Nil);
		};

		if(fault->Equals("close_inflight")) {
			Closer->New(session, 25, board)->Execute(Nil);
		}
		else if(fault->Equals("oom_burst")) {
			Hog->New(false, session, 400, board)->Execute(Nil);
		}
		else if(fault->Equals("gpu_oom")) {
			Hog->New(true, session, 64, board)->Execute(Nil);
		}
		else if(fault->StartsWith("thread_")) {
			Saboteur->New(fault)->Execute(Nil);
		};

		waited := 0;
		while(board->Finished() < workers & waited < deadline * 100) {
			Thread->Sleep(10);
			waited += 1;
		};

		stuck := 0;
		for(w := 0; w < workers; w += 1;) {
			if(<>board->IsDone(w)) {
				stuck += 1;
				at := board->At(w);
				board->Line("HANG w={$w} iter={$at}");
			};
		};

		overall->End();
		ms := (overall->GetElapsedTime() * 1000.0)->As(Int);
		finished := board->Finished();
		board->Line("SUMMARY workers={$workers} finished={$finished} stuck={$stuck} wall_ms={$ms}");
		if(stuck > 0) {
			Runtime->Exit(0);
		};
	}
}
