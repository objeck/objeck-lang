{
	"name": "objeck-lsp",
	"description": "Language server for Objeck",
	"icon": "images/gear_wheel_128.png",
	"author": "Randy Hollines",
	"license": "New BSD",
	"version": "2026.11.4",
	"repository": {
		"type": "git",
		"url": "https://github.com/objeck/objeck-lang",
		"directory": "tools/lsp/clients/vscode"
	},
	"publisher": "objeck-lsp",
	"categories": [
		"Programming Languages",
		"Formatters",
		"Debuggers"
	],
	"keywords": [
		"multi-root ready"
	],
	"engines": {
		"vscode": "^1.75.0"
	},
	"activationEvents": [
		"onLanguage:objeck",
		"onDebug:objeck"
	],
	"main": "./client/out/extension",
	"contributes": {
		"taskDefinitions": [{
			"type": "objeck",
			"properties": {
				"step": { "type": "string", "description": "build or run, for the Run code lens" }
			}
		}],
		"configuration": {
			"type": "object",
			"title": "LSP configuration",
			"properties": {
				"objk.win.install.dir": {
					"type": "string",
					"default": "C:\\Program Files\\Objeck",
					"description": "Objeck Windows install directory"
				},
				"objk.posix.install.dir": {
					"type": "string",
					"default": "/usr/local/objeck",
					"description": "Objeck Posix install directory"
				},
				"objeck.inlineCompletion.provider": {
					"type": "string",
					"enum": ["none", "ollama", "anthropic", "openai", "gemini"],
					"default": "none",
					"markdownDescription": "Ghost-text code suggestions from a language model. **Off by default: with `none` no code is sent anywhere.** `ollama` asks a local Ollama server (see `#objeck.inlineCompletion.ollamaHost#`). `anthropic`, `openai` and `gemini` send the text around the cursor to that company's API and need a key already configured the way the Objeck library reads it (`ANTHROPIC_API_KEY` or `anthropic_api_key.dat`, `openai_api_key.dat`, the Gemini key file); the key is refused while `OBJECK_TLS_INSECURE_SKIP_VERIFY` is set. Takes effect without a restart."
				},
				"objeck.inlineCompletion.model": {
					"type": "string",
					"default": "",
					"description": "Model name for the provider. Empty uses the provider's default (ollama: qwen2.5-coder:1.5b, anthropic: claude-haiku-4-5, openai: gpt-4o-mini, gemini: gemini-2.5-flash)."
				},
				"objeck.inlineCompletion.ollamaHost": {
					"type": "string",
					"default": "http://localhost:11434",
					"markdownDescription": "URL of the Ollama server. **A host other than this machine receives the code around your cursor.**"
				},
				"objeck.inlineCompletion.timeoutMs": {
					"type": "number",
					"default": 3000,
					"minimum": 200,
					"maximum": 30000,
					"description": "Longest wait for a suggestion, in milliseconds. A provider that is slower than this is ignored for that request."
				}
			}
		},
		"languages": [{
            "id": "objeck",
            "aliases": ["Objeck", "objeck"],
            "extensions": [".obs"],
            "configuration": "./language-configuration.json"
        }],
        "grammars": [{
            "language": "objeck",
            "scopeName": "source.objeck",
            "path": "./syntaxes/objeck.tmLanguage.json"
        }],
		"breakpoints": [
			{ "language": "objeck" }
		],
		"debuggers": [{
			"type": "objeck",
			"label": "Objeck Debug",
			"languages": ["objeck"],
			"configurationAttributes": {
				"launch": {
					"required": ["program"],
					"properties": {
						"program": {
							"type": "string",
							"description": "Path to the compiled Objeck binary (.obe file)"
						},
						"sourceDir": {
							"type": "string",
							"description": "Path to the source files directory",
							"default": "${workspaceFolder}"
						},
						"args": {
							"type": "string",
							"description": "Program arguments",
							"default": ""
						}
					}
				}
			},
			"initialConfigurations": [{
				"type": "objeck",
				"request": "launch",
				"name": "Debug Objeck Program",
				"program": "${workspaceFolder}/${fileBasenameNoExtension}.obe",
				"sourceDir": "${workspaceFolder}"
			}],
			"configurationSnippets": [{
				"label": "Objeck: Launch",
				"description": "Launch and debug an Objeck program",
				"body": {
					"type": "objeck",
					"request": "launch",
					"name": "Debug ${1:program}",
					"program": "^\"\\${workspaceFolder}/${2:app}.obe\"",
					"sourceDir": "^\"\\${workspaceFolder}\""
				}
			}]
		}]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -b",
		"watch": "tsc -b -w",
		"postinstall": "cd client && npm install && cd ..",
		"lint": "eslint client/src --ext .ts"
	},
	"devDependencies": {
		"@types/node": "^20.0.0",
		"@typescript-eslint/eslint-plugin": "^7.0.0",
		"@typescript-eslint/parser": "^7.0.0",
		"eslint": "^8.56.0",
		"typescript": "^5.4.0"
	},
	"overrides": {
		"@typescript-eslint/typescript-estree": {
			"minimatch": "^11.0.1"
		}
	}
}
