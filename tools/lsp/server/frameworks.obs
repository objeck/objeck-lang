use Collection, System.IO.Net, System.IO, Data.JSON;

bundle LSP {
	#~
	Abstract socket server worker
	~#
	class LspWorker from System.Concurrency.Thread {
		@quit : Bool;
		# 'initialize' has been answered; until then requests get ServerNotInitialized
		@initialize_seen : Bool;
		# the client's 'initialized' notification has arrived
		@is_initialized : Bool;
		# 'shutdown' has been answered; only 'exit' is valid now
		@is_shutdown : Bool;
		@is_debug : Bool;
		@workspace : LspWorkspace;
		@socket : TCPSocket;
		@pipe : Pipe;
		# the id of the request being answered, exactly as the client sent it
		@reply_id : JsonElement;
		@next_server_id : Int;
		# pipe input not yet consumed: bytes [@pipe_start, @pipe_end)
		@pipe_bytes : Byte[];
		@pipe_start : Int;
		@pipe_end : Int;
		# messages read ahead by the LspReader thread, not yet handled
		@inbox : Vector<RpcRequest>;
		@inbox_mutex : System.Concurrency.ThreadMutex;
		@stream_closed : Bool;
		# documents whose diagnostics wait for typing to pause
		@pending_diagnostics : Map<String, String>;
		@quiet_ticks : Int;
		# Server-initiated progress (window/workDoneProgress/create): the client
		# takes it, a token it has acknowledged and that is not in use yet, and the
		# create request still waiting for its reply.
		@client_progress : Bool;
		@reply_uri : String;
		# Pull diagnostics (textDocument/diagnostic): the client asks, and nothing
		# is pushed to it; and it can be told to ask again.
		@pull_diagnostics : Bool;
		@diagnostic_refresh : Bool;
		@progress_token : String;
		@progress_pending_id : String;
		@progress_pending_token : String;
		@progress_count : Int;

		# JSON-RPC / LSP error codes
		consts ErrorCode {
			PARSE_ERROR := -32700,
			INVALID_REQUEST := -32600,
			METHOD_NOT_FOUND := -32601,
			SERVER_NOT_INITIALIZED := -32002,
			REQUEST_FAILED := -32803,
			REQUEST_CANCELLED := -32800,
			CONTENT_MODIFIED := -32801
		}

		# Diagnostics are published once no message has arrived for this many idle
		# ticks of IDLE_TICK_MS (about 150 ms). Ticks, not a clock: the VM's Timer
		# measures CPU time on POSIX.
		consts Debounce {
			IDLE_TICK_MS := 10,
			QUIET_TICKS := 15
		}

		New(pipe : Pipe, socket : TCPSocket, is_debug : Bool) {
			Parent();

			@socket := socket;
			@pipe := pipe;

			@is_debug := is_debug;
			@workspace := LspWorkspace->New(@is_debug);

			@inbox := Vector->New()<RpcRequest>;
			@inbox_mutex := System.Concurrency.ThreadMutex->New("lsp-inbox");
			@pending_diagnostics := Map->New()<String, String>;
		}

		#
		# A reader thread reads ahead into the inbox; this thread handles what has
		# arrived in batches. That is what lets a burst of keystrokes cost one
		# analysis instead of one each, and lets a request that was cancelled, or
		# whose document changed under it, be answered without doing the work.
		# Handling and reading used to alternate on one thread, so every message
		# waited behind every analysis before it, and a cancel arrived only after
		# its request had been answered (#1217).
		#
		method : public : Run(param : Base) ~ Nil {
			reader := LspReader->New(@self);
			reader->Execute(Nil);

			while(<>@quit) {
				batch := TakeInbox();
				if(batch->Size() > 0) {
					@quiet_ticks := 0;
					ProcessBatch(batch);
				}
				else if(@stream_closed) {
					@quit := true;
				}
				else {
					@quiet_ticks += 1;
					if(@quiet_ticks >= LspWorker->Debounce->QUIET_TICKS->As(Int)) {
						PublishPendingDiagnostics();
					};
					System.Concurrency.Thread->Sleep(LspWorker->Debounce->IDLE_TICK_MS->As(Int));
				};
			};

			if(@socket <> Nil) {
				@socket->Close();
			}
			else if(@pipe <> Nil) {
				@pipe->Close();
			};
		}

		# called by the reader thread; Nil means the stream has closed
		method : public : Enqueue(request : RpcRequest) ~ Nil {
			critical(@inbox_mutex) {
				if(request = Nil) {
					@stream_closed := true;
				}
				else {
					@inbox->AddBack(request);
				};
			};
		}

		method : TakeInbox() ~ Vector<RpcRequest> {
			batch : Vector<RpcRequest>;
			critical(@inbox_mutex) {
				batch := @inbox;
				@inbox := Vector->New()<RpcRequest>;
			};
			return batch;
		}

		method : public : IsQuitting() ~ Bool {
			return @quit;
		}

		#
		# Everything that had arrived, in order. Two things are decided from the
		# whole batch first: which requests the client has since cancelled, and
		# which documents change later in it -- a request about a document that
		# the client edited after asking is answered ContentModified, since its
		# answer would describe text that no longer exists.
		#
		method : ProcessBatch(batch : Vector<RpcRequest>) ~ Nil {
			cancelled := Map->New()<String, String>;
			last_change := Map->New()<String, IntRef>;
			each(i : batch) {
				request := batch->Get(i);
				method_id := request->GetMethod();
				if(method_id <> Nil & request->IsNotification()) {
					if(method_id->Equals("$/cancelRequest")) {
						id_json := FindJson(request->GetParams(), "id");
						if(id_json <> Nil) {
							key := id_json->ToString();
							cancelled->Insert(key, key);
						};
					}
					else if(method_id->Equals("textDocument/didChange")) {
						uri := FindString(request->GetParams(), "textDocument/uri");
						if(uri <> Nil) {
							last_change->Remove(uri);
							last_change->Insert(uri, IntRef->New(i));
						};
					};
				};
			};

			each(i : batch) {
				request := batch->Get(i);
				method_id := request->GetMethod();

				if(method_id <> Nil & <>request->IsNotification() & <>request->IsResponse() & <>@is_shutdown) {
					@reply_id := request->GetIdJson();
					uri := FindString(request->GetParams(), "textDocument/uri");
					# the document a reply's positions belong to, unless they name another
					@reply_uri := uri;
					if(@workspace->IsUtf16()) {
						request->SetParams(ConvertPositions(request->GetParams(), uri, false, Map->New()<String, TextLines>));
					};
					# Assigned, not just declared: a local declared in a loop body keeps
					# the previous pass's value, so a request with no document (such as
					# workspace/symbol) inherited the one before it and could be refused
					# ContentModified for an edit to a document it never named.
					changed_at : IntRef := Nil;
					if(uri <> Nil) {
						changed_at := last_change->Find(uri);
					};

					if(cancelled->Has(@reply_id->ToString())) {
						WriteRpcError(request->GetId(), LspWorker->ErrorCode->REQUEST_CANCELLED->As(Int), "Request cancelled");
					}
					else if(changed_at <> Nil & changed_at->Get() > i) {
						WriteRpcError(request->GetId(), LspWorker->ErrorCode->CONTENT_MODIFIED->As(Int), "Content modified");
					}
					else {
						# These read the last text that analyzed cleanly, which a
						# diagnostics run refreshes; run a pending one first, so a
						# completion right after typing sees what was just typed.
						if(uri <> Nil & @pending_diagnostics->Has(uri) &
								(method_id->Equals("textDocument/completion") | method_id->Equals("textDocument/hover") |
								 method_id->Equals("textDocument/signatureHelp"))) {
							PublishDiagnostics(uri);
						};

						# A client that passes a workDoneToken shows progress for the
						# request on it: it was ignored.
						work_token := FindJson(request->GetParams(), "workDoneToken");
						if(work_token <> Nil & work_token->GetType() <> JsonElement->JsonType->STRING &
								work_token->GetType() <> JsonElement->JsonType->NUMBER) {
							work_token := Nil;
						};
						if(work_token <> Nil) {
							SendProgressBegin(work_token, "Objeck: {$method_id}");
						};
						ProcessResponse(request);
						if(work_token <> Nil) {
							SendProgressEnd(work_token);
						};
					};
				}
				else if(method_id = Nil | <>method_id->Equals("$/cancelRequest")) {
					ProcessResponse(request);
				};
			};
		}

		# a document changed: publish its diagnostics once typing pauses
		method : public : DeferDiagnostics(uri : String) ~ Nil {
			@pending_diagnostics->Remove(uri);
			@pending_diagnostics->Insert(uri, uri);
		}

		method : public : DropPendingDiagnostics(uri : String) ~ Nil {
			@pending_diagnostics->Remove(uri);
		}

		method : PublishPendingDiagnostics() ~ Nil {
			uris := @pending_diagnostics->GetKeys()<String>;
			each(i : uris) {
				PublishDiagnostics(uris->Get(i));
			};
		}

		method : PublishDiagnostics(uri : String) ~ Nil {
			@pending_diagnostics->Remove(uri);
			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				# A workspace program -- every file its build.json lists -- is the
				# analysis that takes seconds; it is reported while it runs, when
				# it will run rather than come from the cache.
				token : String := Nil;
				folder := @workspace->FolderFor(uri);
				if(folder <> Nil & @workspace->NeedsAnalysis(uri)) {
					folder_name := folder->GetName();
					token := BeginServerProgress("Objeck: analyzing '{$folder_name}'");
				};

				# A pull client keeps the report until it asks; pushing to it as well
				# would show every diagnostic twice.
				diagnostics := document->GetDiagnostics();
				if(@pull_diagnostics) {
					document->KeepReport(diagnostics);
				}
				else {
					WriteRpcRequest("textDocument/publishDiagnostics", diagnostics);
				};

				if(token <> Nil) {
					EndServerProgress(token);
				};
			};
		}

		# A closed document's diagnostics are cleared; a pull client drops a closed
		# document's report itself.
		method : public : PublishClosed(uri : String) ~ Nil {
			if(@pull_diagnostics) {
				return;
			};

			empty_diagnostics := JsonElement->New(JsonElement->JsonType->OBJECT);
			empty_diagnostics->Insert("uri", uri);
			empty_diagnostics->Insert("diagnostics", JsonElement->New(JsonElement->JsonType->ARRAY));
			WriteRpcRequest("textDocument/publishDiagnostics", empty_diagnostics);
		}

		method : public : SetPullDiagnostics(pull : Bool, refresh : Bool) ~ Nil {
			@pull_diagnostics := pull;
			@diagnostic_refresh := refresh;
		}

		method : public : IsPullDiagnostics() ~ Bool {
			return @pull_diagnostics;
		}

		#
		# textDocument/diagnostic: the document's report, analyzed now if an edit
		# is waiting; 'unchanged' when it's the report the client already has.
		#
		method : public : PullDiagnostics(uri : String, previous_id : String) ~ JsonElement {
			document := @workspace->GetDocument(uri);
			if(document = Nil) {
				return Nil;
			};

			if(@pending_diagnostics->Has(uri) | <>document->HasReport()) {
				PublishDiagnostics(uri);
			};

			return document->DiagnosticReport(previous_id);
		}

		# Results elsewhere may have changed (a build.json, a folder): a pull client
		# that takes it is asked to pull again.
		method : public : RefreshPulledDiagnostics() ~ Nil {
			if(@pull_diagnostics & @diagnostic_refresh) {
				WriteRpcServerRequest("workspace/diagnostic/refresh", Nil);
			};
		}

		#
		# Progress
		#
		method : public : SetClientProgress(client_progress : Bool) ~ Nil {
			@client_progress := client_progress;
		}

		# Asks the client for a token ahead of time, so one is ready when an
		# analysis starts: progress may be reported only on a token the client has
		# acknowledged, and its reply can't be waited for mid-analysis.
		method : RequestProgressToken() ~ Nil {
			if(<>@client_progress | @progress_token <> Nil | @progress_pending_id <> Nil) {
				return;
			};

			@progress_count += 1;
			token := "objk-progress-{$@progress_count}";
			params := JsonElement->New(JsonElement->JsonType->OBJECT);
			params->Insert("token", token);
			@progress_pending_token := token;
			@progress_pending_id := WriteRpcServerRequest("window/workDoneProgress/create", params);
		}

		# the ready token, now in use; Nil when there is none
		method : BeginServerProgress(title : String) ~ String {
			token := @progress_token;
			if(token <> Nil) {
				@progress_token := Nil;
				SendProgressBegin(JsonElement->New(token), title);
			};
			return token;
		}

		# a token ends with its work; the next one is asked for straight away
		method : EndServerProgress(token : String) ~ Nil {
			SendProgressEnd(JsonElement->New(token));
			RequestProgressToken();
		}

		method : SendProgressBegin(token : JsonElement, title : String) ~ Nil {
			value := JsonElement->New(JsonElement->JsonType->OBJECT);
			value->Insert("kind", "begin");
			value->Insert("title", title);
			value->Insert("cancellable", false);
			SendProgress(token, value);
		}

		method : SendProgressEnd(token : JsonElement) ~ Nil {
			value := JsonElement->New(JsonElement->JsonType->OBJECT);
			value->Insert("kind", "end");
			SendProgress(token, value);
		}

		method : SendProgress(token : JsonElement, value : JsonElement) ~ Nil {
			params := JsonElement->New(JsonElement->JsonType->OBJECT);
			params->Insert("token", token);
			params->Insert("value", value);
			WriteRpcRequest("$/progress", params);
		}

		#
		# window/logMessage: what used to go only to a log file the user never
		# sees. Type 1 error, 2 warning, 3 info, 4 log.
		#
		method : public : LogMessage(type : Int, message : String) ~ Nil {
			params := JsonElement->New(JsonElement->JsonType->OBJECT);
			params->Insert("type", type);
			params->Insert("message", message);
			WriteRpcRequest("window/logMessage", params);
		}

		#
		# Columns between the client's UTF-16 units and the server's Chars, where a
		# Char is a whole code point (Linux, macOS) and the client takes only
		# UTF-16 -- VS Code among them. A character outside the BMP is one Char and
		# two UTF-16 units, so every later column on its line was one short:
		# diagnostics, navigation, edits and the client's own edits (#1226).
		#
		# Every Position ({line, character}) in the message is converted against the
		# text of the document it belongs to: the request's, or the one a
		# containing object names ('uri', 'textDocument', or a key of a
		# WorkspaceEdit's 'changes'). The text is the open document's, else the file
		# on disk; lines are looked up once per message.
		#
		method : ConvertPositions(elem : JsonElement, uri : String, to_client : Bool, lines : Map<String, TextLines>) ~ JsonElement {
			if(elem = Nil) {
				return Nil;
			};

			type := elem->GetType();
			if(type = JsonElement->JsonType->ARRAY) {
				elems := Vector->New()<JsonElement>;
				each(i : elem) {
					elems->AddBack(ConvertPositions(elem->Get(i), uri, to_client, lines));
				};
				return JsonElement->New(elems);
			};

			if(type <> JsonElement->JsonType->OBJECT) {
				return elem;
			};

			# the document this object's positions belong to
			scope_uri := uri;
			uri_json := elem->Get("uri");
			if(uri_json <> Nil & uri_json->GetType() = JsonElement->JsonType->STRING) {
				scope_uri := uri_json->GetValue();
			}
			else {
				doc_uri := FindString(elem, "textDocument/uri");
				if(doc_uri <> Nil) {
					scope_uri := doc_uri;
				};
			};

			line_json := elem->Get("line");
			char_json := elem->Get("character");
			is_position := line_json <> Nil & char_json <> Nil &
				line_json->GetType() = JsonElement->JsonType->NUMBER & char_json->GetType() = JsonElement->JsonType->NUMBER;

			members := Map->New()<String, JsonElement>;
			names := elem->GetNames();
			each(i : names) {
				name := names->Get(i);
				child := elem->Get(name);
				if(is_position & name->Equals("character")) {
					line_text := LineOf(scope_uri, line_json->GetInt(), lines);
					column := char_json->GetInt();
					if(to_client) {
						column := Document->CharsToUnits(line_text, column);
					}
					else {
						column := Document->UnitsToChars(line_text, column);
					};
					members->Insert(name, JsonElement->New(column));
				}
				else if(name->Equals("changes") & child->GetType() = JsonElement->JsonType->OBJECT) {
					# a WorkspaceEdit's changes: each key is a document
					changes := Map->New()<String, JsonElement>;
					change_uris := child->GetNames();
					each(j : change_uris) {
						change_uri := change_uris->Get(j);
						changes->Insert(change_uri, ConvertPositions(child->Get(change_uri), change_uri, to_client, lines));
					};
					members->Insert(name, JsonElement->New(changes));
				}
				else {
					members->Insert(name, ConvertPositions(child, scope_uri, to_client, lines));
				};
			};

			return JsonElement->New(members);
		}

		# a line of a document: the open text, else the file; "" when neither has it
		method : LineOf(uri : String, line : Int, lines : Map<String, TextLines>) ~ String {
			if(uri = Nil | line < 0) {
				return "";
			};

			text_lines := lines->Find(uri);
			if(text_lines = Nil) {
				text : String := Nil;
				document := @workspace->GetDocument(uri);
				if(document <> Nil) {
					text := document->GetText();
				}
				else {
					text := System.IO.Filesystem.FileReader->ReadFile(LspFolder->LocalPath(uri));
				};

				if(text = Nil) {
					text := "";
				};
				text_lines := TextLines->New(text->Split('\n'));
				lines->Insert(uri, text_lines);
			};

			return text_lines->Get(line);
		}

		function : FindJson(params : JsonElement, path : String) ~ JsonElement {
			if(params = Nil | params->GetType() <> JsonElement->JsonType->OBJECT) {
				return Nil;
			};
			return params->FindElements(path);
		}

		function : FindString(params : JsonElement, path : String) ~ String {
			found := FindJson(params, path);
			if(found = Nil | found->GetType() <> JsonElement->JsonType->STRING) {
				return Nil;
			};
			return found->GetValue();
		}

		method : public : IsDebug() ~ Bool {
			return @is_debug;
		}

		#
		# Notifications
		#
		method : virtual : NotifyInitialized(params : JsonElement) ~ Nil;
		method : virtual : NotifyCancel(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidOpen(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidChange(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidChangeWatchedFiles(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidSave(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidClose(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidChangeWorkspace(params : JsonElement) ~ Nil;

		#
		# Callbacks
		#
		method : virtual : CallbackInitialize(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackShutdown(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackCompletion(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackHover(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackCodeAction(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackResolve(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackRename(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackPrepareRename(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDocumentSymbol(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackWorkspaceSymbol(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackReferences(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDeclaration(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDefinition(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSignatureHelp(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackFormatDocument(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackFormatRange(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDocumentHighlight(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackFoldingRange(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSelectionRange(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackTypeDefinition(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackImplementation(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackPrepareCallHierarchy(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackIncomingCalls(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackOutgoingCalls(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackInlayHint(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSemanticTokensFull(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSemanticTokensRange(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSemanticTokensDelta(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackCodeLens(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDocumentDiagnostic(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDocumentLink(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackPrepareTypeHierarchy(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackTypeHierarchySupertypes(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackTypeHierarchySubtypes(id : Int, params : JsonElement) ~ Nil;

		# --- process requests ---
		method : ProcessResponse(request : RpcRequest) ~ Nil {
			# A reply to one of OUR requests (client/registerCapability). Nothing
			# waits on it; these used to be dispatched as requests named '<none>'.
			if(request->IsResponse()) {
				reply_id := request->GetIdJson()->GetValue();
				is_progress := @progress_pending_id <> Nil & reply_id <> Nil & reply_id->Equals(@progress_pending_id);
				if(is_progress) {
					@progress_pending_id := Nil;
				};

				if(request->GetError() <> Nil) {
					error_text := request->GetError()->ToString();
					System.IO.Filesystem.Logger->Instance()->Error("*** Client rejected a server request: {$error_text} ***");
					LogMessage(2, "The client rejected a server request: {$error_text}");
				}
				else if(is_progress) {
					@progress_token := @progress_pending_token;
				};
				return;
			};

			# Not JSON, or JSON that is not a request: answer with a null id, as
			# JSON-RPC asks, and carry on reading. This used to end the session.
			if(request->GetMethod() = Nil) {
				@reply_id := Nil;
				if(request->IsParseError()) {
					WriteRpcError(-1, LspWorker->ErrorCode->PARSE_ERROR->As(Int), "Parse error");
				}
				else {
					WriteRpcError(-1, LspWorker->ErrorCode->INVALID_REQUEST->As(Int), "Invalid request");
				};
				return;
			};

			id := request->GetId();
			method_id := request->GetMethod();
			@reply_id := request->GetIdJson();

			# notification
			if(request->IsNotification()) {
				if(@is_debug) {
					System.IO.Filesystem.Logger->Instance()->Info("NOTIFICATION='{$method_id}'\n");
				};

				# Before 'initialize', every notification except 'exit' is dropped.
				if(<>@initialize_seen & <>method_id->Equals("exit")) {
					return;
				};

				select(method_id) {
					label "initialized" {
						NotifyInitialized(request->GetParams());
					}
					
					label "$/cancelRequest" {
						NotifyCancel(request->GetParams());
					}
					
					label "workspace/didChangeWatchedFiles" {
						NotifyDidChangeWatchedFiles(request->GetParams());
					}
					
					label "textDocument/didOpen" {
						NotifyDidOpen(request->GetParams());
					}
					
					label "textDocument/didChange" {
						NotifyDidChange(request->GetParams());
					}
					
					label "textDocument/didSave" {
						NotifyDidSave(request->GetParams());
					}
					
					label "textDocument/didClose" {
						NotifyDidClose(request->GetParams());
					}
					
					label "workspace/didChangeWorkspaceFolders" {
						NotifyDidChangeWorkspace(request->GetParams());
					}

					label "exit" {
						Exit();
					}

					other {
						# unknown notifications ($/setTrace, $/progress, ...) are ignored
						if(@is_debug) {
							System.IO.Filesystem.Logger->Instance()->Error("*** Unknown notification='{$method_id}' ***");
						};
					}
				};
			}
			# callback
			else {
				if(@is_debug) {
					System.IO.Filesystem.Logger->Instance()->Info("METHOD='{$method_id}', id={$id}");
				};

				# After 'shutdown' only 'exit' is valid.
				if(@is_shutdown) {
					WriteRpcError(id, LspWorker->ErrorCode->INVALID_REQUEST->As(Int), "Server is shutting down");
					return;
				};

				# Until 'initialize', nothing else may be answered.
				if(<>@initialize_seen & <>method_id->Equals("initialize")) {
					WriteRpcError(id, LspWorker->ErrorCode->SERVER_NOT_INITIALIZED->As(Int), "Server not initialized");
					return;
				};

				select(method_id) {
					label "initialize" {
						@initialize_seen := true;
						CallbackInitialize(id, request->GetParams());
					}
					
					label "textDocument/completion" {
						CallbackCompletion(id, request->GetParams());
					}
					
					label "textDocument/hover" {
						CallbackHover(id, request->GetParams());
					}
					
					label "textDocument/codeAction" {
						CallbackCodeAction(id, request->GetParams());
					}
					
					label "completionItem/resolve" {
						CallbackResolve(id, request->GetParams());
					}
					
					label "textDocument/rename" {
						CallbackRename(id, request->GetParams());
					}

					label "textDocument/prepareRename" {
						CallbackPrepareRename(id, request->GetParams());
					}
					
					label "textDocument/documentSymbol" {
						CallbackDocumentSymbol(id, request->GetParams());
					}
					
					label "workspace/symbol" {
						CallbackWorkspaceSymbol(id, request->GetParams());
					}
					
					label "textDocument/references" {
						CallbackReferences(id, request->GetParams());
					}
					
					label "textDocument/declaration" {
						CallbackDeclaration(id, request->GetParams());
					}
					
					label "textDocument/definition" {
						CallbackDefinition(id, request->GetParams());
					}
					
					label "textDocument/signatureHelp" {
						CallbackSignatureHelp(id, request->GetParams());
					}
					
					label "shutdown" {
						CallbackShutdown(id, request->GetParams());
					}
					
					label "textDocument/formatting" {
						CallbackFormatDocument(id, request->GetParams());
					}

					
					label "textDocument/rangeFormatting" {
						CallbackFormatRange(id, request->GetParams());
					}

					label "textDocument/documentHighlight" {
						CallbackDocumentHighlight(id, request->GetParams());
					}

					label "textDocument/foldingRange" {
						CallbackFoldingRange(id, request->GetParams());
					}

					label "textDocument/selectionRange" {
						CallbackSelectionRange(id, request->GetParams());
					}

					label "textDocument/typeDefinition" {
						CallbackTypeDefinition(id, request->GetParams());
					}

					label "textDocument/implementation" {
						CallbackImplementation(id, request->GetParams());
					}

					label "textDocument/prepareCallHierarchy" {
						CallbackPrepareCallHierarchy(id, request->GetParams());
					}

					label "callHierarchy/incomingCalls" {
						CallbackIncomingCalls(id, request->GetParams());
					}

					label "callHierarchy/outgoingCalls" {
						CallbackOutgoingCalls(id, request->GetParams());
					}

					label "textDocument/inlayHint" {
						CallbackInlayHint(id, request->GetParams());
					}

					label "textDocument/semanticTokens/full" {
						CallbackSemanticTokensFull(id, request->GetParams());
					}

					label "textDocument/semanticTokens/range" {
						CallbackSemanticTokensRange(id, request->GetParams());
					}

					label "textDocument/semanticTokens/full/delta" {
						CallbackSemanticTokensDelta(id, request->GetParams());
					}

					label "textDocument/codeLens" {
						CallbackCodeLens(id, request->GetParams());
					}

					label "textDocument/diagnostic" {
						CallbackDocumentDiagnostic(id, request->GetParams());
					}

					label "textDocument/documentLink" {
						CallbackDocumentLink(id, request->GetParams());
					}

					label "textDocument/prepareTypeHierarchy" {
						CallbackPrepareTypeHierarchy(id, request->GetParams());
					}

					label "typeHierarchy/supertypes" {
						CallbackTypeHierarchySupertypes(id, request->GetParams());
					}

					label "typeHierarchy/subtypes" {
						CallbackTypeHierarchySubtypes(id, request->GetParams());
					}

					other {
						# Every request gets an answer. An unknown one used to get none,
						# and the client's promise waited forever.
						if(@is_debug) {
							System.IO.Filesystem.Logger->Instance()->Error("*** Unknown method='{$method_id}' ***");
						};
						WriteRpcError(id, LspWorker->ErrorCode->METHOD_NOT_FOUND->As(Int), "Method not found: {$method_id}");
					}
				};
			};
		}

		# --- utilities ---

		#
		# One message: header lines up to a blank line, then Content-Length bytes.
		# Returns Nil when the stream has closed.
		#
		# This read exactly ONE header line and one blank line, so a client that
		# sent Content-Type (legal, and sent first by some) got no answer at all.
		# The pipe was read as if each read returned one whole message, which a
		# message-mode pipe does not promise: a body over 8 KB was cut short and the
		# message lost, and a client that writes the header and the body separately
		# (vscode-jsonrpc does) had its body discarded as the "blank line". The pipe
		# is now read as a byte stream through a buffer.
		#
		method : ReadString() ~ String {
			length := -1;
			while(true) {
				line := ReadHeaderLine();
				if(line = Nil) {
					return Nil;
				};

				if(line->IsEmpty()) {
					# end of the header block; a blank line before any header means
					# the stream is gone (a closed console or socket reads as empty)
					if(length < 0) {
						return Nil;
					};

					text := ReadBody(length);
					if(@is_debug & text <> Nil) {
						System.IO.Filesystem.Logger->Instance()->Info("====\nREAD='{$text}'");
					};
					return text;
				};

				index := line->Find(':');
				if(index > 0) {
					name := line->SubString(index)->Trim()->ToLower();
					if(name->Equals("content-length")) {
						length := line->SubString(index + 1, line->Size() - index - 1)->Trim()->ToInt();
					};
				};
			};

			return Nil;
		}

		# A header line without its line ending, or Nil when the stream has closed.
		method : ReadHeaderLine() ~ String {
			line : String;
			if(@socket <> Nil) {
				line := @socket->ReadLine();
			}
			else if(@pipe <> Nil) {
				line := ReadPipeLine();
			}
			else {
				line := Console->ReadLine();
			};

			if(line = Nil) {
				return Nil;
			};

			return line->Trim();
		}

		method : ReadBody(length : Int) ~ String {
			if(length = 0) {
				return "";
			};

			# socket
			if(@socket <> Nil) {
				buffer := Byte->New[length];
				@socket->ReadBuffer(0, buffer->Size(), buffer);
				return String->New(buffer->ToUnicode());
			}
			# pipe
			else if(@pipe <> Nil) {
				buffer := ReadPipeBytes(length);
				if(buffer = Nil) {
					return Nil;
				};
				return String->New(buffer->ToUnicode());
			};

			# stdin
			buffer := Char->New[length];
			Console->ReadBuffer(0, buffer->Size(), buffer);
			return String->New(buffer);
		}

		#
		# Buffered pipe input: whatever each read returns -- part of a message, one
		# message, or several -- is appended here and framing is parsed from it.
		#
		method : FillPipe() ~ Bool {
			chunk := Byte->New[8192];
			read := @pipe->ReadBuffer(0, chunk->Size(), chunk);
			if(read <= 0) {
				return false;
			};

			if(@pipe_bytes = Nil) {
				@pipe_bytes := Byte->New[16384];
			};

			# compact, then grow if needed
			if(@pipe_start > 0) {
				pending := @pipe_end - @pipe_start;
				for(i := 0; i < pending; i += 1;) {
					@pipe_bytes[i] := @pipe_bytes[@pipe_start + i];
				};
				@pipe_start := 0;
				@pipe_end := pending;
			};

			if(@pipe_end + read > @pipe_bytes->Size()) {
				size := @pipe_bytes->Size() * 2;
				while(@pipe_end + read > size) {
					size *= 2;
				};
				grown := Byte->New[size];
				for(i := 0; i < @pipe_end; i += 1;) {
					grown[i] := @pipe_bytes[i];
				};
				@pipe_bytes := grown;
			};

			for(i := 0; i < read; i += 1;) {
				@pipe_bytes[@pipe_end + i] := chunk[i];
			};
			@pipe_end += read;

			return true;
		}

		method : ReadPipeLine() ~ String {
			while(true) {
				for(i := @pipe_start; i < @pipe_end; i += 1;) {
					if(@pipe_bytes[i] = 10) {
						size := i - @pipe_start;
						line := Byte->New[size];
						for(j := 0; j < size; j += 1;) {
							line[j] := @pipe_bytes[@pipe_start + j];
						};
						@pipe_start := i + 1;
						return String->New(line->ToUnicode());
					};
				};

				if(<>FillPipe()) {
					return Nil;
				};
			};

			return Nil;
		}

		method : ReadPipeBytes(length : Int) ~ Byte[] {
			while(@pipe_end - @pipe_start < length) {
				if(<>FillPipe()) {
					return Nil;
				};
			};

			bytes := Byte->New[length];
			for(i := 0; i < length; i += 1;) {
				bytes[i] := @pipe_bytes[@pipe_start + i];
			};
			@pipe_start += length;

			return bytes;
		}

		method : WriteString(text : String) ~ Nil {
			length := text->Size();
			line := "Content-Length: {$length}\r\n\r\n{$text}";

			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("WRITE='{$line}'");
			};

			# write to socket
			if(@socket <> Nil) {
				@socket->WriteString(line);
			}
			# write to pipe
			else if(@pipe <> Nil) {
				@pipe->WriteString(line);
			}
			# write to stdout
			else {
				Console->WriteString(line);
				Console->Flush();
			};
		}

		# The next message, or Nil once the stream has closed. A body that is not
		# a JSON-RPC message comes back as a request with no method, so it can be
		# answered with an error instead of ending the session.
		method : public : ReadRpcRequest() ~ RpcRequest {
			text := ReadString();
			if(text = Nil) {
				return Nil;
			};

			json := JsonParser->New(text);
			if(<>json->Parse()) {
				return RpcRequest->New(true);
			};

			node := json->GetRoot();
			if(node = Nil | node->GetType() <> JsonElement->JsonType->OBJECT) {
				return RpcRequest->New(false);
			};

			# kept as sent: ids are 'integer | string' and are echoed back verbatim
			id_elem := node->Get("id");
			if(id_elem <> Nil & id_elem->GetType() = JsonElement->JsonType->NULL) {
				id_elem := Nil;
			};

			mthd_elem := node->Get("method");
			if(mthd_elem = Nil) {
				# a reply to one of our requests
				if(id_elem <> Nil & (node->Get("result") <> Nil | node->Get("error") <> Nil)) {
					return RpcRequest->New(id_elem, node->Get("error"));
				};
				return RpcRequest->New(false);
			};

			ver := node->Get("jsonrpc");
			if(ver = Nil | <>ver->GetValue()->Equals("2.0")) {
				return RpcRequest->New(false);
			};

			return RpcRequest->New(Decoded(id_elem), JsonElement->Decode(mthd_elem->GetValue()), Decoded(node->Get("params")));
		}

		#
		# Data.JSON's parser keeps string values as they were written, escapes and
		# all, and leaves decoding to the caller (JsonElement->Decode). Every string
		# in a message is decoded here, once, so the rest of the server works on
		# plain text and the serializer's escaping on the way out is the only one.
		#
		# The Document used to hand-decode its text instead, and only \t \r \n \\
		# and \": a client that sent non-ASCII as \u escapes left six characters
		# in the document per character, and every column after it on the line was
		# wrong (#1216).
		#
		function : Decoded(elem : JsonElement) ~ JsonElement {
			if(elem = Nil) {
				return Nil;
			};

			type := elem->GetType();
			if(type = JsonElement->JsonType->STRING) {
				return JsonElement->New(JsonElement->Decode(elem->GetValue()));
			}
			else if(type = JsonElement->JsonType->ARRAY) {
				elems := Vector->New()<JsonElement>;
				each(i : elem) {
					elems->AddBack(Decoded(elem->Get(i)));
				};
				return JsonElement->New(elems);
			}
			else if(type = JsonElement->JsonType->OBJECT) {
				members := Map->New()<String, JsonElement>;
				names := elem->GetNames();
				if(names <> Nil) {
					each(i : names) {
						name := names->Get(i);
						members->Insert(JsonElement->Decode(name), Decoded(elem->Get(name)));
					};
				};
				return JsonElement->New(members);
			};

			return elem;
		}

		# --- server-to-client request ---
		# the request's id, to match its reply
		method : WriteRpcServerRequest(kind : String, params : JsonElement) ~ String {
			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			# Its own id space, as strings, so it can never be mistaken for one of
			# the client's numeric ids. This was a fixed 101.
			@next_server_id += 1;
			id := "objk-{$@next_server_id}";
			node->Insert("jsonrpc", "2.0");
			node->Insert("id", id);
			node->Insert("method", kind);
			# JSON-RPC's params is an object or an array, or absent: never null
			if(params <> Nil) {
				node->Insert("params", params);
			};

			WriteString(node->ToString());
			return id;
		}

		# --- response ---
		method : WriteRpcResponse(id : Int, result : JsonElement) ~ Nil {
			if(result <> Nil & @workspace->IsUtf16()) {
				result := ConvertPositions(result, @reply_uri, true, Map->New()<String, TextLines>);
			};

			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			node->Insert("jsonrpc", "2.0");
			InsertReplyId(node, id);
			if(result = Nil) {
				node->Insert("result", JsonElement->New(JsonElement->JsonType->NULL));
			}
			else {
				node->Insert("result", result);
			};

			WriteString(node->ToString());
		}

		method : WriteRpcError(id : Int, code : Int, message : String) ~ Nil {
			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			node->Insert("jsonrpc", "2.0");
			InsertReplyId(node, id);
			error := node->AddChild("error");
			error->Insert("code", code);
			error->Insert("message", message);

			WriteString(node->ToString());
		}

		# The id exactly as the client sent it -- a string id used to be read with
		# ToInt and answered as 0. JSON-RPC answers an unidentifiable request with
		# a null id.
		method : InsertReplyId(node : JsonElement, id : Int) ~ Nil {
			if(@reply_id <> Nil) {
				node->Insert("id", @reply_id);
			}
			else if(id > -1) {
				node->Insert("id", id);
			}
			else {
				node->Insert("id", JsonElement->New(JsonElement->JsonType->NULL));
			};
		}

		#
		# 'exit': the process ends with 0 after a 'shutdown' and 1 without one. On a
		# TCP connection the process serves other clients, so only this connection
		# ends.
		#
		method : Exit() ~ Nil {
			if(@socket <> Nil) {
				@quit := true;
				return;
			};

			if(@is_shutdown) {
				Runtime->Exit(0);
			};
			Runtime->Exit(1);
		}

		# --- request ---
		method : WriteRpcRequest(kind : String, result : JsonElement) ~ Nil {
			# publishDiagnostics names its document
			if(result <> Nil & @workspace->IsUtf16() & kind->Equals("textDocument/publishDiagnostics")) {
				result := ConvertPositions(result, Nil, true, Map->New()<String, TextLines>);
			};

			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			node->Insert("jsonrpc", "2.0");
			node->Insert("method", kind);

			if(result = Nil) {
				node->Insert("params", JsonElement->New(JsonElement->JsonType->NULL));
			}
			else {
				node->Insert("params", result);
			};

			WriteString(node->ToString());
		}
	}

	#~
	Workspace: the open documents, and one configuration per workspace folder
	~#
	class : private : LspWorkspace {
		@is_debug : Bool;
		@documents : Map<String, Document>;
		@folders : Vector<LspFolder>;
		@texts : String[,];
		# parsed and analyzed programs, kept until any text changes (#1218)
		@proxies : Map<String, AstProxy>;
		@generation : Int;
		@proxies_generation : Int;
		@no_cache : Bool;
		# columns go to and from the client in UTF-16 units while Chars are code points
		@utf16 : Bool;

		New(is_debug : Bool) {
			@is_debug := is_debug;
			@documents := Map->New()<String, Document>;
			@folders := Vector->New()<LspFolder>;
			@proxies := Map->New()<String, AstProxy>;

			# OBJECK_LSP_NO_CACHE=1 parses afresh for every request, as before, to
			# compare against the cache
			no_cache := Runtime->GetEnvironmentVariable("OBJECK_LSP_NO_CACHE");
			@no_cache := no_cache <> Nil & no_cache->Equals("1");
		}

		#
		# A parsed and analyzed program for these texts, shared by every request
		# until a text changes. Each request used to parse and analyze the whole
		# workspace and throw the result away, so the native side's per-program
		# analyzer cache never outlived a request: hover, symbols, highlights and
		# the rest each paid for a full analysis.
		#
		# One program per folder whose build.json lists the document; otherwise one
		# per document, and one for 'every open document outside a folder' (a Nil
		# uri, from workspace/symbol). Each comes in a current and a last-clean
		# ('alt') text version.
		#
		method : public : GetProxy(uri : String, use_alt : Bool) ~ AstProxy {
			folder : LspFolder := Nil;
			if(uri <> Nil) {
				folder := FolderFor(uri);
			};
			return GetProxy(uri, folder, use_alt);
		}

		method : GetProxy(uri : String, folder : LspFolder, use_alt : Bool) ~ AstProxy {
			if(@no_cache | @proxies_generation <> @generation) {
				ReleaseProxies();
				@proxies_generation := @generation;
			};

			key := ProxyKey(uri, folder, use_alt);
			proxy := @proxies->Find(key);
			if(proxy = Nil) {
				texts : String[,];
				if(folder <> Nil) {
					texts := folder->GetTexts(@documents, use_alt);
				}
				else {
					texts := GetStandaloneTexts(uri, use_alt);
				};
				proxy := AstProxy->New(texts, @is_debug);
				@proxies->Insert(key, proxy);
			};

			return proxy;
		}

		function : ProxyKey(uri : String, folder : LspFolder, use_alt : Bool) ~ String {
			key := use_alt ? "alt|" : "text|";
			if(folder <> Nil) {
				key += "folder|";
				key += folder->GetUri();
			}
			else if(uri = Nil) {
				key += "*";
			}
			else {
				key += uri;
			};
			return key;
		}

		# diagnostics for this document would parse and analyze, not reuse a program
		method : public : NeedsAnalysis(uri : String) ~ Bool {
			if(@no_cache | @proxies_generation <> @generation) {
				return true;
			};
			return <>@proxies->Has(ProxyKey(uri, FolderFor(uri), false));
		}

		method : public : SetUtf16(utf16 : Bool) ~ Nil {
			@utf16 := utf16;
		}

		method : public : IsUtf16() ~ Bool {
			return @utf16;
		}

		# some text the programs were parsed from has changed
		method : public : Invalidate() ~ Nil {
			@generation += 1;
		}

		# the last cleanly analyzed text of a document changed
		method : public : InvalidateAlt() ~ Nil {
			keys := @proxies->GetKeys()<String>;
			each(i : keys) {
				key := keys->Get(i);
				if(key->StartsWith("alt|")) {
					@proxies->Find(key)->Release();
					@proxies->Remove(key);
				};
			};
		}

		method : ReleaseProxies() ~ Nil {
			proxies := @proxies->GetValues()<AstProxy>;
			each(i : proxies) {
				proxies->Get(i)->Release();
			};
			@proxies := Map->New()<String, AstProxy>;
		}

		#
		# A workspace folder, configured from its own build.json. Folders used to
		# share one root and one file list, and each new folder overwrote the last
		# (SetRoot): with two folders open, the first was analyzed against the
		# second's files and libraries (#1232).
		#
		method : public : AddFolder(name : String, uri : String) ~ LspFolder {
			if(uri = Nil | uri->IsEmpty()) {
				return Nil;
			};
			RemoveFolder(uri);

			folder := LspFolder->New(name, uri, @is_debug);
			folder->Load();
			@folders->AddBack(folder);
			Invalidate();

			return folder;
		}

		# A folder the client closed: its documents are analyzed without it.
		# didChangeWorkspaceFolders used to only log a removal.
		method : public : RemoveFolder(uri : String) ~ Bool {
			key := LspFolder->TrimUri(uri);
			kept := Vector->New()<LspFolder>;
			removed := false;
			each(i : @folders) {
				folder := @folders->Get(i);
				if(folder->GetUri()->Equals(key)) {
					removed := true;
				}
				else {
					kept->AddBack(folder);
				};
			};

			if(removed) {
				@folders := kept;
				Invalidate();
			};

			return removed;
		}

		#
		# A watched file changed: reload the build.json of the folder it is in, or
		# every folder's when it is in none of them. This reloaded whichever folder
		# happened to be configured last.
		#
		method : public : ReloadFolders(changed_uri : String) ~ Vector<LspFolder> {
			reloaded := Vector->New()<LspFolder>;
			each(i : @folders) {
				folder := @folders->Get(i);
				if(changed_uri <> Nil & folder->Contains(changed_uri)) {
					folder->Load();
					reloaded->AddBack(folder);
				};
			};

			if(reloaded->Size() = 0) {
				each(i : @folders) {
					folder := @folders->Get(i);
					folder->Load();
					reloaded->AddBack(folder);
				};
			};

			Invalidate();
			return reloaded;
		}

		method : public : HasFolders() ~ Bool {
			return @folders->Size() > 0;
		}

		#
		# The folder whose build.json lists this document, the innermost when
		# folders nest; Nil when none does and the document stands alone.
		#
		method : public : FolderFor(uri : String) ~ LspFolder {
			found : LspFolder;
			each(i : @folders) {
				folder := @folders->Get(i);
				if(folder->Lists(uri)) {
					if(found = Nil | folder->GetUri()->Size() > found->GetUri()->Size()) {
						found := folder;
					};
				};
			};

			return found;
		}

		#
		# The build.json a quick fix should use for this document: its folder's,
		# configured or not, or one beside the document outside every folder. With
		# no folder the fix offered to create 'file:////build.json', at the root of
		# the file system.
		#
		method : public : BuildFileFor(uri : String) ~ String {
			found : LspFolder;
			each(i : @folders) {
				folder := @folders->Get(i);
				if(folder->Contains(uri)) {
					if(found = Nil | folder->GetUri()->Size() > found->GetUri()->Size()) {
						found := folder;
					};
				};
			};

			if(found <> Nil) {
				return found->GetBuildFile();
			};

			path := LspFolder->LocalPath(uri);
			slash := path->FindLast('/');
			if(slash < 0) {
				return "build.json";
			};
			return path->SubString(slash + 1) + "build.json";
		}

		method : public : GetLibs(uri : String) ~ String {
			if(uri <> Nil) {
				folder := FolderFor(uri);
				if(folder <> Nil) {
					return folder->GetLibs();
				};
			};

			return LspFolder->StandaloneLibs();
		}

		#
		# One document, or -- with no uri, which is how workspace/symbol asks --
		# every open document that no folder's build.json lists. The uri = Nil case
		# called Equals(Nil) here once and took the server down (#1214).
		#
		method : GetStandaloneTexts(uri : String, use_alt : Bool) ~ String[,] {
			key_values := @documents->GetKeyValues()<Pair<String, Document>>;
			count := 0;
			each(i : key_values) {
				file_uri := key_values->Get(i)->GetFirst();
				if(IsStandaloneMatch(uri, file_uri)) {
					count += 1;
				};
			};

			@texts := String->New[count > 0 ? count : 1, 2];
			index := 0;
			each(i : key_values) {
				key_value := key_values->Get(i);
				file_uri := key_value->GetFirst();
				if(IsStandaloneMatch(uri, file_uri)) {
					document := key_value->GetSecond();

					text : String;
					if(use_alt) {
						text := document->GetAltText();
					}
					else {
						text := document->GetText();
					};

					if(@is_debug & text <> Nil) {
						size := text->Size();
						System.IO.Filesystem.Logger->Instance()->Info("### Cached: file_uri='{$file_uri}', size={$size} ###");
					};

					@texts[index,0] := file_uri;
					@texts[index,1] := text;
					index += 1;
				};
			};

			return @texts;
		}

		# the document asked for, or with no uri any document outside every folder
		method : IsStandaloneMatch(uri : String, file_uri : String) ~ Bool {
			if(uri = Nil) {
				return FolderFor(file_uri) = Nil;
			};
			return file_uri->Equals(uri);
		}

		method : public : GetDocument(uri : String) ~ Document {
			return @documents->Find(uri);
		}

		method : public : GetUris() ~ Vector<String> {
			return @documents->GetKeys()<String>;
		}

		method : public : AddDocument(uri : String, document : Document) ~ Nil {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> Add: {$uri}");
			};

			@documents->Remove(uri);
			@documents->Insert(uri, document);
			Invalidate();
		}

		method : public : RemoveDocument(uri : String, document : Document) ~ Nil {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> Remove: {$uri}");
			};

			if(@documents->Remove(uri)) {
				document->Release();
			};
			Invalidate();
		}

		#
		# workspace/symbol: matches from each folder's program, and from the open
		# documents that belong to none, restricted to open documents.
		#
		method : public : GetSymbol(query : String) ~ JsonElement {
			uris := @documents->GetKeys()<String>;
			matches := JsonElement->New(JsonElement->JsonType->ARRAY);

			each(i : @folders) {
				folder := @folders->Get(i);
				if(folder->IsConfigured()) {
					proxy := GetProxy(Nil, folder, false);
					if(proxy->Build()) {
						AddAll(matches, proxy->GetSymbol(query, uris, folder->GetLibs()));
					};
				};
			};

			standalone := false;
			each(i : uris) {
				if(FolderFor(uris->Get(i)) = Nil) {
					standalone := true;
				};
			};

			if(standalone) {
				proxy := GetProxy(Nil, Nil, false);
				if(proxy->Build()) {
					AddAll(matches, proxy->GetSymbol(query, uris, LspFolder->StandaloneLibs()));
				};
			};

			return matches;
		}

		function : AddAll(to : JsonElement, from_json : JsonElement) ~ Nil {
			if(from_json <> Nil & from_json->GetType() = JsonElement->JsonType->ARRAY) {
				each(i : from_json) {
					to->Add(from_json->Get(i));
				};
			};
		}
	}

	#~
	A workspace folder and the build.json that configures it
	~#
	class : private : LspFolder {
		@name : String;
		# as the client sent it, without a trailing slash
		@uri : String;
		@local_path : String;
		@build_file : String;
		@file_strs : String[];
		@libs_str : String;
		@load_error : String;
		@is_missing : Bool;
		@is_debug : Bool;

		New(name : String, uri : String, is_debug : Bool) {
			@name := name;
			@uri := TrimUri(uri);
			@is_debug := is_debug;

			@local_path := LocalPath(@uri);
			@build_file := String->New(@local_path);
			@build_file += "/build.json";
		}

		# 'file:///c%3A/dir' -> 'c:/dir', 'file:///home/dir' -> '/home/dir'
		function : LocalPath(uri : String) ~ String {
			path := Web.HTTP.Url->Decode(uri);
			if(path->StartsWith("file:///")) {
				offset : Int;
				if(Query.RegEx.RegEx->New("file:///([a-z]|[A-Z]):.*")->MatchExact(path)) {
					offset := "file:///"->Size();
				}
				else {
					offset := "file://"->Size();
				};
				path->Delete(0, offset);
			};
			return path;
		}

		function : TrimUri(uri : String) ~ String {
			if(uri <> Nil & uri->EndsWith('/')) {
				return uri->SubString(uri->Size() - 1);
			};
			return uri;
		}

		# Libraries assumed for a file no build.json lists. gen_collect.obl was
		# listed TWICE here once, and the list omitted regex, xml, csv, query and the
		# json_rpc/json_stream pair -- so a standalone file using any of them was
		# told its classes were undefined, with the diagnostic pointing at the
		# user's code rather than at this list.
		function : StandaloneLibs() ~ String {
			return "gen_collect.obl,cipher.obl,csv.obl,json.obl,json_rpc.obl,json_stream.obl,misc.obl,net.obl,net_server.obl,query.obl,regex.obl,rss.obl,xml.obl";
		}

		#
		# (Re)reads build.json. True when it configured the folder; otherwise the
		# folder's documents stand alone and GetLoadError says why.
		#
		method : public : Load() ~ Bool {
			@file_strs := Nil;
			@libs_str := Nil;
			@load_error := Nil;

			if(<>System.IO.Filesystem.File->Exists(@build_file)) {
				@is_missing := true;
				return false;
			};
			@is_missing := false;

			text := System.IO.Filesystem.FileReader->ReadFile(@build_file);
			if(text = Nil) {
				@load_error := "Unable to load configuration '{$@build_file}'";
				System.IO.Filesystem.Logger->Instance()->Error("--- {$@load_error} ---");
				return false;
			};

			json := JsonParser->New(text);
			if(<>json->Parse()) {
				@load_error := "Unable to parse configuration '{$@build_file}'";
				System.IO.Filesystem.Logger->Instance()->Error("--- {$@load_error} ---");
				return false;
			};

			root := json->GetRoot();
			files_json := root->Get("files");
			libs_json := root->Get("libs");
			if(files_json = Nil | libs_json = Nil) {
				@load_error := "Configuration '{$@build_file}' needs 'files' and 'libs'";
				System.IO.Filesystem.Logger->Instance()->Error("--- {$@load_error} ---");
				return false;
			};

			file_strs := String->New[files_json->Size()];
			each(i : files_json) {
				file_strs[i] := JsonElement->Decode(files_json->Get(i)->GetValue());
			};

			libs_str := "";
			each(i : libs_json) {
				libs_str += JsonElement->Decode(libs_json->Get(i)->GetValue());
				libs_str += ',';
			};

			if(<>libs_str->IsEmpty()) {
				libs_str->Pop();
			};

			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("--- Files and libraries:  local_path='{$@local_path}', libs_str='{$libs_str}' ---\n");
			};

			@file_strs := file_strs;
			@libs_str := libs_str;
			return true;
		}

		method : public : IsConfigured() ~ Bool {
			return @file_strs <> Nil;
		}

		method : public : GetLoadError() ~ String {
			return @load_error;
		}

		# no build.json at all: the folder's files are analyzed one at a time
		method : public : IsMissing() ~ Bool {
			return @is_missing;
		}

		method : public : FileCount() ~ Int {
			if(@file_strs = Nil) {
				return 0;
			};
			return @file_strs->Size();
		}

		method : public : GetName() ~ String {
			return @name;
		}

		method : public : GetUri() ~ String {
			return @uri;
		}

		method : public : GetBuildFile() ~ String {
			return @build_file;
		}

		method : public : GetLocalPath() ~ String {
			return @local_path;
		}

		# the build.json files, as obc's -src takes them
		method : public : GetSources() ~ String {
			sources := "";
			if(@file_strs <> Nil) {
				each(i : @file_strs) {
					if(i > 0) {
						sources += ',';
					};
					sources += @file_strs[i];
				};
			};
			return sources;
		}

		method : public : GetLibs() ~ String {
			return @libs_str;
		}

		# a uri inside this folder
		method : public : Contains(uri : String) ~ Bool {
			return uri <> Nil & uri->StartsWith(@uri + "/");
		}

		# a document this folder's build.json lists
		method : public : Lists(uri : String) ~ Bool {
			if(@file_strs = Nil | <>Contains(uri)) {
				return false;
			};

			each(i : @file_strs) {
				file_uri := String->New(@uri);
				file_uri += '/';
				file_uri += @file_strs[i];
				if(file_uri->Equals(uri)) {
					return true;
				};
			};

			return false;
		}

		# every file the build.json lists: the open text where it is open, else disk
		method : public : GetTexts(documents : Map<String, Document>, use_alt : Bool) ~ String[,] {
			if(@file_strs = Nil | @file_strs->Size() = 0) {
				return String->New[1, 2];
			};

			texts := String->New[@file_strs->Size(), 2];
			each(i : @file_strs) {
				local_file_path := String->New(@local_path);
				local_file_path += '/';
				local_file_path += @file_strs[i];

				file_uri := String->New(@uri);
				file_uri += '/';
				file_uri += @file_strs[i];

				text : String;
				document := documents->Find(file_uri);
				if(document <> Nil) {
					if(use_alt) {
						text := document->GetAltText();
					}
					else {
						text := document->GetText();
					};
				}
				else {
					text := System.IO.Filesystem.FileReader->ReadFile(local_file_path);
				};

				if(text = Nil) {
					System.IO.Filesystem.Logger->Instance()->Error("Unable to open file: {$local_file_path}");
				}
				else {
					texts[i,0] := file_uri;
					texts[i,1] := text;
				};
			};

			return texts;
		}
	}

	#~
	In-memory text document
	~#
	class : private : Document {
		@workspace : LspWorkspace;
		@uri : String;
		@text : String;
		@alt_text : String;
		@is_debug : Bool;
		# the client's version of the text, or -1 if it sent none
		@version : Int;
		# the last diagnostics report, for a pull client; its id changes with it
		@report_items : JsonElement;
		@report_text : String;
		@report_id : String;
		@report_count : Int;
		# the semantic tokens last sent, for semanticTokens/full/delta
		@token_data : Int[];
		@token_result_id : String;
		@token_count : Int;

		New(uri : String, text : String, workspace : LspWorkspace, is_debug : Bool) {
			@workspace := workspace;
			@uri := uri;
			@text := String->New(text);
			@is_debug := is_debug;
			@version := -1;
		}

		method : public : SetVersion(version : Int) ~ Nil {
			@version := version;
		}

		method : public : Refresh(text : String) ~ Nil {
			@text := String->New(text);
			@workspace->Invalidate();
		}
		
		method : public : Reload() ~ Nil {
			if(@uri->StartsWith("file://")) {
				filename : String;
				if(System.IO.Filesystem.Directory->GetSlash() = '\\') {
					offset := "file:///"->Size();
					filename := @uri->SubString(offset, @uri->Size() - offset);
					filename := filename->ReplaceAll('/', '\\');
				}	
				else {
					offset := "file://"->Size();
					filename := @uri->SubString(offset, @uri->Size() - offset);
				};
								
				text := System.IO.Filesystem.FileReader->ReadFile(filename);
				if(text <> Nil) {
					@text := text;
					@workspace->Invalidate();
				};
			};
		}
		
		method : public : GetDiagnostics() ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			was_analyzed := BoolRef->New();
			result := proxy->GetDiagnostics(was_analyzed, @uri, @workspace->GetLibs(@uri));
			if(was_analyzed->Get()) {
				@alt_text := @text->Clone()->As(String);
				# completion and hover parse this text, not the current one
				@workspace->InvalidateAlt();
			};

			# which text these describe, so a client can discard a stale set
			if(result <> Nil & @version > -1) {
				result->Insert("version", @version);
			};

			return result;
		}

		# keeps a diagnostics result (publishDiagnostics params) as the report
		method : public : KeepReport(result : JsonElement) ~ Nil {
			items : JsonElement := Nil;
			if(result <> Nil) {
				items := result->Get("diagnostics");
			};
			if(items = Nil) {
				items := JsonElement->New(JsonElement->JsonType->ARRAY);
			};

			text := items->ToString();
			if(@report_text = Nil | <>@report_text->Equals(text)) {
				@report_count += 1;
				@report_id := "{$@version}.{$@report_count}";
				@report_text := text;
			};
			@report_items := items;
		}

		method : public : HasReport() ~ Bool {
			return @report_items <> Nil;
		}

		method : public : DiagnosticReport(previous_id : String) ~ JsonElement {
			report := JsonElement->New(JsonElement->JsonType->OBJECT);
			if(previous_id <> Nil & @report_id <> Nil & previous_id->Equals(@report_id)) {
				report->Insert("kind", "unchanged");
				report->Insert("resultId", @report_id);
				return report;
			};

			report->Insert("kind", "full");
			if(@report_id <> Nil) {
				report->Insert("resultId", @report_id);
			};
			if(@report_items <> Nil) {
				report->Insert("items", @report_items);
			}
			else {
				report->Insert("items", JsonElement->New(JsonElement->JsonType->ARRAY));
			};
			return report;
		}

		method : public : GetSymbols(uri : String, hierarchical : Bool) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			if(proxy->Build()) {
				if(hierarchical) {
					return proxy->GetDocumentSymbols(uri, @workspace->GetLibs(@uri), @text);
				};
				return proxy->GetSymbols(uri, @workspace->GetLibs(@uri));
			};

			return Nil;
		}

		method : public : FindReferences(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->FindReferences(line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		method : public : CodeRename(new_name : String, line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->CodeRename(new_name, line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		#
		# The text a rename writes for new_name at this position, or Nil if it isn't
		# a name the program could use. An instance variable's references span its
		# '@', so a new name typed without one gets it back: renaming @radius to
		# 'rad' wrote 'rad' over '@radius' and turned it into an undefined local.
		#
		method : public : RenameTo(new_name : String, line_pos : Int, char_pos : Int) ~ String {
			if(new_name = Nil) {
				return Nil;
			};

			span := IdentifierAt(line_pos, char_pos);
			is_instance := span <> Nil & @text->Get(span[0]) = '@';

			name := new_name;
			if(name->StartsWith('@')) {
				if(<>is_instance) {
					return Nil;
				};
				name := name->SubString(1, name->Size() - 1);
			};

			if(<>IsIdentifier(name)) {
				return Nil;
			};

			if(is_instance) {
				return "@" + name;
			};

			return name;
		}

		#
		# textDocument/prepareRename: the range and text of the identifier under the
		# cursor, or Nil when it can't be renamed -- a keyword, a literal, or a name
		# that resolves to nothing in the user's code (a library method). The
		# editor used to offer rename everywhere and then get back no edits.
		#
		method : public : PrepareRename(line_pos : Int, char_pos : Int) ~ JsonElement {
			span := IdentifierAt(line_pos, char_pos);
			if(span = Nil) {
				return Nil;
			};

			name := @text->SubString(span[0], span[1] - span[0]);
			bare := name->StartsWith('@') ? name->SubString(1, name->Size() - 1) : name;
			if(bare->IsEmpty() | bare->Get(0)->IsDigit() | IsReserved(bare)) {
				return Nil;
			};

			# renameable only where the references the rename would edit include
			# the name under the cursor
			start_char := char_pos - (GetDocumentIndex(line_pos, char_pos) - span[0]);
			end_char := start_char + name->Size();
			references := FindReferences(line_pos, char_pos);
			if(references = Nil | references->GetType() <> JsonElement->JsonType->ARRAY) {
				return Nil;
			};

			found := false;
			each(i : references) {
				reference := references->Get(i);
				ref_uri := reference->Get("uri");
				ref_line := reference->FindElements("range/start/line");
				ref_start := reference->FindElements("range/start/character");
				ref_end := reference->FindElements("range/end/character");
				if(ref_uri <> Nil & ref_line <> Nil & ref_start <> Nil & ref_end <> Nil) {
					if(ref_uri->GetValue()->Equals(@uri) & ref_line->GetInt() = line_pos &
							ref_start->GetInt() <= char_pos & char_pos <= ref_end->GetInt()) {
						found := true;
					};
				};
			};

			if(<>found) {
				return Nil;
			};

			range := JsonElement->New(JsonElement->JsonType->OBJECT);
			start := JsonElement->New(JsonElement->JsonType->OBJECT);
			start->Insert("line", line_pos);
			start->Insert("character", start_char);
			end := JsonElement->New(JsonElement->JsonType->OBJECT);
			end->Insert("line", line_pos);
			end->Insert("character", end_char);
			range->Insert("start", start);
			range->Insert("end", end);

			result := JsonElement->New(JsonElement->JsonType->OBJECT);
			result->Insert("range", range);
			result->Insert("placeholder", name);
			return result;
		}

		#
		# [start, end) of the identifier at or just before a position, or Nil. An
		# instance variable's '@' is part of it, as it is of the ranges a rename
		# edits.
		#
		method : IdentifierAt(line_pos : Int, char_pos : Int) ~ Int[] {
			if(@text = Nil) {
				return Nil;
			};

			index := GetDocumentIndex(line_pos, char_pos);
			# the cursor may sit just after the name
			if((index >= @text->Size() | <>IsIdentifierChar(@text->Get(index))) & index > 0 &
					IsIdentifierChar(@text->Get(index - 1))) {
				index -= 1;
			};

			if(index >= @text->Size() | <>IsIdentifierChar(@text->Get(index))) {
				return Nil;
			};

			start := index;
			while(start > 0 & IsIdentifierChar(@text->Get(start - 1))) {
				start -= 1;
			};

			if(start > 0 & @text->Get(start - 1) = '@') {
				start -= 1;
			};

			end := index;
			while(end < @text->Size() & IsIdentifierChar(@text->Get(end))) {
				end += 1;
			};

			span := Int->New[2];
			span[0] := start;
			span[1] := end;
			return span;
		}

		function : IsIdentifierChar(c : Char) ~ Bool {
			return c->IsChar() | c->IsDigit() | c = '_';
		}

		#
		# A name the rename may write: an Objeck identifier that isn't reserved.
		# Anything else produced edits that left the program uncompilable.
		#
		function : IsIdentifier(name : String) ~ Bool {
			if(name = Nil | name->IsEmpty() | name->Get(0)->IsDigit()) {
				return false;
			};

			each(i : name) {
				if(<>IsIdentifierChar(name->Get(i))) {
					return false;
				};
			};

			return <>IsReserved(name);
		}

		# the scanner's words (core/compiler/scanner.cpp), less the trap names
		function : IsReserved(name : String) ~ Bool {
			words := ["and", "not", "or", "xor", "virtual", "if", "else", "do", "while", "break",
				"continue", "use", "bundle", "native", "static", "public", "private", "class",
				"record", "interface", "alias", "readonly", "implements", "function", "method",
				"select", "other", "enum", "consts", "for", "each", "in", "reverse", "label",
				"return", "leaving", "Byte", "Int", "Parent", "from", "Float", "Char", "Bool",
				"true", "false", "New", "Nil", "As", "TypeOf", "critical"];
			each(i : words) {
				if(words[i]->Equals(name)) {
					return true;
				};
			};

			return false;
		}

		#
		# source.organizeImports: the leading 'use' statements, deduplicated and
		# sorted, as a CodeAction; Nil when there are none or they are in order.
		# 'use class' and 'use bundle' lines are kept as they are, after the rest.
		# A block it can't read with certainty (a statement over several lines, a
		# comment on a 'use' line) is left alone.
		#
		method : public : OrganizeImports() ~ JsonElement {
			if(@text = Nil) {
				return Nil;
			};

			line_ending := "\n";
			if(@text->Find("\r\n") > -1) {
				line_ending := "\r\n";
			};

			lines := @text->Split('\n');
			first := -1;
			last := -1;
			in_comment := false;
			done := false;
			for(i := 0; i < lines->Size() & <>done; i += 1;) {
				line := lines[i]->Trim();
				if(in_comment) {
					if(line->Find("~#") > -1) {
						in_comment := false;
					};
				}
				else if(line->IsEmpty()) {
					# blank lines before or inside the block
				}
				else if(first < 0 & line->StartsWith("#~")) {
					in_comment := line->Find("~#") < 0;
				}
				else if(first < 0 & line->StartsWith("#")) {
					# a line comment before the block
				}
				else if(line->StartsWith("use ") | line->StartsWith("use\t")) {
					if(<>line->EndsWith(";") | line->Find('#') > -1) {
						return Nil;
					};
					if(first < 0) {
						first := i;
					};
					last := i;
				}
				else {
					done := true;
				};
			};

			if(first < 0) {
				return Nil;
			};

			names := Vector->New()<String>;
			seen := Set->New()<String>;
			kept := Vector->New()<String>;
			plain_count := 0;
			for(i := first; i <= last; i += 1;) {
				line := lines[i]->Trim();
				if(<>line->IsEmpty()) {
					body := line->SubString(3, line->Size() - 4)->Trim();
					if(body->StartsWith("class ") | body->StartsWith("bundle ")) {
						kept->AddBack(line);
					}
					else {
						plain_count += 1;
						parts := body->Split(',');
						each(j : parts) {
							part := parts[j]->Trim();
							if(part->IsEmpty()) {
								return Nil;
							};
							if(<>seen->Has(part)) {
								seen->Insert(part);
								names->AddBack(part);
							};
						};
					};
				};
			};

			# sorted, ordinal
			for(i := 1; i < names->Size(); i += 1;) {
				j := i;
				while(j > 0 & names->Get(j - 1)->Compare(names->Get(j)) > 0) {
					swap := names->Get(j);
					names->Set(names->Get(j - 1), j);
					names->Set(swap, j - 1);
					j -= 1;
				};
			};

			organized := "";
			# one statement stays one statement
			if(plain_count = 1 & kept->Size() = 0) {
				organized += "use ";
				each(i : names) {
					if(i > 0) {
						organized += ", ";
					};
					organized += names->Get(i);
				};
				organized += ';';
			}
			else {
				each(i : names) {
					if(<>organized->IsEmpty()) {
						organized += line_ending;
					};
					organized += "use ";
					organized += names->Get(i);
					organized += ';';
				};
				each(i : kept) {
					if(<>organized->IsEmpty()) {
						organized += line_ending;
					};
					organized += kept->Get(i);
				};
			};

			# the block as written, from its first character to the end of its last line
			last_line := lines[last];
			if(last_line->EndsWith("\r")) {
				last_line := last_line->SubString(last_line->Size() - 1);
			};
			original := "";
			for(i := first; i <= last; i += 1;) {
				line := lines[i];
				if(line->EndsWith("\r")) {
					line := line->SubString(line->Size() - 1);
				};
				if(i > first) {
					original += line_ending;
				};
				original += line;
			};

			if(original->Equals(organized)) {
				return Nil;
			};

			range := JsonElement->New(JsonElement->JsonType->OBJECT);
			start := JsonElement->New(JsonElement->JsonType->OBJECT);
			start->Insert("line", first);
			start->Insert("character", 0);
			end := JsonElement->New(JsonElement->JsonType->OBJECT);
			end->Insert("line", last);
			end->Insert("character", last_line->Size());
			range->Insert("start", start);
			range->Insert("end", end);

			text_edit := JsonElement->New(JsonElement->JsonType->OBJECT);
			text_edit->Insert("range", range);
			text_edit->Insert("newText", organized);
			edits := JsonElement->New(JsonElement->JsonType->ARRAY);
			edits->Add(text_edit);

			changes := JsonElement->New(JsonElement->JsonType->OBJECT);
			changes->Insert(@uri, edits);
			edit := JsonElement->New(JsonElement->JsonType->OBJECT);
			edit->Insert("changes", changes);

			action := JsonElement->New(JsonElement->JsonType->OBJECT);
			action->Insert("title", "Organize 'use' statements");
			action->Insert("kind", "source.organizeImports");
			action->Insert("edit", edit);
			return action;
		}
		
		method : public : FindDeclaration(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->FindDeclaration(line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		method : public : FindDefinition(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->FindDefinition(line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		method : public : Completion(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, true);
			
			index := GetDocumentIndex(line_pos, char_pos);
			if(index > -1) {
				# a library enum's items after its '->': the analyzer only knows the
				# program's own enums
				enum_completion := EnumCompletion(index);
				if(enum_completion <> Nil) {
					return enum_completion;
				};

				var_str := ""; mthd_str := "";
				if(GetVariableMethodStrings(index - 1, var_str, mthd_str, false)) {
					return proxy->Completion(line_pos, char_pos, var_str, mthd_str, @uri, @workspace->GetLibs(@uri));
				};
			};

			return Nil;
		}

		# the items of the enum named before the '->' that precedes the cursor
		method : EnumCompletion(index : Int) ~ JsonElement {
			if(@text = Nil | index > @text->Size()) {
				return Nil;
			};

			prefix_start := index;
			while(prefix_start > 0 & IsIdentifierChar(@text->Get(prefix_start - 1))) {
				prefix_start -= 1;
			};

			arrow := SkipSpaceBefore(prefix_start);
			if(arrow < 2 | @text->Get(arrow - 1) <> '>' | @text->Get(arrow - 2) <> '-') {
				return Nil;
			};

			chain := ChainBefore(SkipSpaceBefore(arrow - 2));
			if(chain->IsEmpty() | IsOwnEnum(chain)) {
				return Nil;
			};

			prefix := @text->SubString(prefix_start, index - prefix_start);
			return AstProxy->EnumCompletion(chain, prefix, GetUses());
		}

		method : public : Hover(line_pos : Int, char_pos : Int, markdown : Bool) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, true);

			index := GetDocumentIndex(line_pos, char_pos);
			if(index > -1) {
				var_str := ""; mthd_str := "";
				if(GetVariableMethodStrings(index - 1, var_str, mthd_str, false)) {
					hover := proxy->Hover(line_pos, char_pos, var_str, mthd_str, @uri, @workspace->GetLibs(@uri), markdown);
					if(hover <> Nil) {
						return hover;
					};
				};

				# a library enum or item: the analyzer resolves the call but names neither
				return EnumHover(line_pos, char_pos, markdown);
			};

			return Nil;
		}

		# hover for the library enum, or enum item, under the cursor
		method : EnumHover(line_pos : Int, char_pos : Int, markdown : Bool) ~ JsonElement {
			span := IdentifierAt(line_pos, char_pos);
			if(span = Nil) {
				return Nil;
			};

			start := span[0];
			end := span[1];
			word := @text->SubString(start, end - start);

			item_receiver : String;
			arrow := SkipSpaceBefore(start);
			if(arrow >= 2 & @text->Get(arrow - 1) = '>' & @text->Get(arrow - 2) = '-') {
				item_receiver := ChainBefore(SkipSpaceBefore(arrow - 2));
				if(item_receiver->IsEmpty() | IsOwnEnum(item_receiver)) {
					item_receiver := Nil;
				};
			};

			enum_chain := ChainBefore(end);
			if(IsOwnEnum(enum_chain)) {
				enum_chain := Nil;
			};

			return AstProxy->EnumHover(enum_chain, item_receiver, word, GetUses(), markdown);
		}

		# the index after the whitespace that ends just before 'index'
		method : SkipSpaceBefore(index : Int) ~ Int {
			while(index > 0 & (@text->Get(index - 1) = ' ' | @text->Get(index - 1) = '\t' |
					@text->Get(index - 1) = '\r' | @text->Get(index - 1) = '\n')) {
				index -= 1;
			};

			return index;
		}

		#
		# The names and '->' links that end at 'end': 'Number->Format',
		# 'Query.Structured.ColumnType'. Stops at anything else, a call's ')' included.
		#
		method : ChainBefore(end : Int) ~ String {
			chain := "";
			index := end;
			done := false;
			while(<>done) {
				start := index;
				while(start > 0 & (IsIdentifierChar(@text->Get(start - 1)) | @text->Get(start - 1) = '.')) {
					start -= 1;
				};

				if(start = index) {
					done := true;
				}
				else {
					segment := @text->SubString(start, index - start);
					if(chain->IsEmpty()) {
						chain := segment;
					}
					else {
						chain := "{$segment}->{$chain}";
					};

					arrow := SkipSpaceBefore(start);
					if(arrow >= 2 & @text->Get(arrow - 1) = '>' & @text->Get(arrow - 2) = '-') {
						index := SkipSpaceBefore(arrow - 2);
					}
					else {
						done := true;
					};
				};
			};

			return chain;
		}

		#
		# Whether 'chain' could name an enum this file declares itself: its last name
		# is declared with 'enum' or 'consts' here and nothing qualifies it with a
		# bundle. The program's own enum comes before a library's, as it does for
		# the compiler, and the analyzer answers for it.
		#
		method : IsOwnEnum(chain : String) ~ Bool {
			if(@text = Nil | chain->Find('.') > -1) {
				return false;
			};

			name := chain;
			arrow := chain->FindLast('>');
			if(arrow > -1) {
				name := chain->SubString(arrow + 1, chain->Size() - arrow - 1);
			};

			keywords := ["enum", "consts"];
			each(i : keywords) {
				keyword := keywords[i];
				index := @text->Find(0, keyword);
				while(index > -1) {
					after := index + keyword->Size();
					if((index = 0 | <>IsIdentifierChar(@text->Get(index - 1))) & after < @text->Size() &
							<>IsIdentifierChar(@text->Get(after))) {
						start := after;
						while(start < @text->Size() & (@text->Get(start) = ' ' | @text->Get(start) = '\t')) {
							start += 1;
						};

						end := start;
						while(end < @text->Size() & IsIdentifierChar(@text->Get(end))) {
							end += 1;
						};

						if(end > start & @text->SubString(start, end - start)->Equals(name)) {
							return true;
						};
					};
					index := @text->Find(after, keyword);
				};
			};

			return false;
		}

		# the bundles this file's 'use' statements name, and System
		method : GetUses() ~ Vector<String> {
			uses := Vector->New()<String>;
			uses->AddBack("System");
			if(@text = Nil) {
				return uses;
			};

			lines := @text->Split('\n');
			each(i : lines) {
				line := lines[i]->Trim();
				if(line->StartsWith("use ") | line->StartsWith("use\t")) {
					end := line->Find(';');
					if(end < 0) {
						end := line->Size();
					};

					names := line->SubString(3, end - 3)->Split(",");
					each(j : names) {
						name := names[j]->Trim();
						if(<>name->IsEmpty()) {
							uses->AddBack(name);
						};
					};
				};
			};

			return uses;
		}

		# the signature and documentation of a completion item (completionItem/resolve)
		method : public : ResolveCompletion(item_name : String, line_pos : Int, char_pos : Int, var_str : String, markdown : Bool) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, true);
			return proxy->ResolveCompletion(item_name, line_pos, char_pos, var_str, @uri, @workspace->GetLibs(@uri), markdown);
		}

		method : public : SignatureHelp(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, true);

			index := GetDocumentIndex(line_pos, char_pos);
			if(index > -1) {
				var_str := "";	mthd_str := "";
				if(GetVariableMethodStrings(index, var_str, mthd_str)) {
					return proxy->SignatureHelp(line_pos, char_pos, var_str, mthd_str, @uri, @workspace->GetLibs(@uri));
				};
			};
			
			return Nil;
		}

		method : public : CodeAction(start_range_line : Int, start_range_char : Int, end_range_line : Int, end_range_char : Int, message : String, context : String, build_file : String) ~  JsonElement {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> CodeAction: uri='{$@uri}'");
			};
			
			proxy := @workspace->GetProxy(@uri, false);

			if(context->Equals("quickfix") & message->StartsWith("Undefined class")) {
				#
				# The FIRST quoted token, not everything between the first quote and the
				# last. These messages do not all quote one thing: an inferred-type local
				# reports
				#
				#   Undefined class: 'Vector'\n\t'Vector' is defined in bundle 'Collection'
				#
				# so first-to-last yielded "Vector'\n\t'Vector' is defined in bundle
				# 'Collection", which matches no class and so produced no fix at all --
				# while the declared form, whose message quotes only the class, worked.
				# That is half of #1057; any future message that adds a hint would have
				# broken the same way.
				#
				# String has no Find(Char, Int) here, so the search for the CLOSING quote
				# runs on the remainder and its result is relative to that.
				start := message->Find('\'');
				if(start > -1) {
					start += 1;
					tail := message->SubString(start, message->Size() - start);
					length := tail->Find('\'');
					if(length > 0) {
						class_name := tail->SubString(length);
						#
						# Is the DIAGNOSTIC anchored on the class token itself? That is what
						# separates the shapes a symbol-table lookup cannot serve -- an
						# inferred-type local like `v := Vector->New()`, whose entry does not
						# exist yet because analysis aborted on this very error -- from the
						# shapes where the diagnostic points at a variable, a parameter or a
						# method name instead. Measured across six shapes: only five of ten
						# such diagnostics start on the class, and they are exactly the ones
						# where it is a method-call target. Offering a qualifier at the other
						# five would insert "Bundle." before a variable or a method name --
						# an applied fix that leaves the program still not compiling, which
						# is what #1052 was.
						#
						# Only this layer can tell: the document text lives here, and the
						# native analysis has no source to compare against.
						#
						on_class := false;
						index := GetDocumentIndex(start_range_line, start_range_char);
						if(@text <> Nil & index > -1 & index + class_name->Size() <= @text->Size()) {
							on_class := @text->SubString(index, class_name->Size())->Equals(class_name);
						};
						
						return proxy->CodeAction(@uri, start_range_line, start_range_char, class_name, build_file, on_class);
					};
				};
			};

			return Nil;
		}

		method : public : FindTypeDefinition(line_pos : Int, char_pos : Int) ~ JsonElement {
