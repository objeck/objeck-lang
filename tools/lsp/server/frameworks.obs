use Collection, System.IO.Net, System.IO, Data.JSON;

bundle LSP {
	#~
	Abstract socket server worker
	~#
	class LspWorker from System.Concurrency.Thread {
		@quit : Bool;
		# 'initialize' has been answered; until then requests get ServerNotInitialized
		@initialize_seen : Bool;
		# the client's 'initialized' notification has arrived
		@is_initialized : Bool;
		# 'shutdown' has been answered; only 'exit' is valid now
		@is_shutdown : Bool;
		@is_debug : Bool;
		@workspace : LspWorkspace;
		@socket : TCPSocket;
		@pipe : Pipe;
		# the id of the request being answered, exactly as the client sent it
		@reply_id : JsonElement;
		@next_server_id : Int;
		# pipe input not yet consumed: bytes [@pipe_start, @pipe_end)
		@pipe_bytes : Byte[];
		@pipe_start : Int;
		@pipe_end : Int;
		# messages read ahead by the LspReader thread, not yet handled
		@inbox : Vector<RpcRequest>;
		@inbox_mutex : System.Concurrency.ThreadMutex;
		@stream_closed : Bool;
		# documents whose diagnostics wait for typing to pause
		@pending_diagnostics : Map<String, String>;
		@quiet_ticks : Int;

		# JSON-RPC / LSP error codes
		consts ErrorCode {
			PARSE_ERROR := -32700,
			INVALID_REQUEST := -32600,
			METHOD_NOT_FOUND := -32601,
			SERVER_NOT_INITIALIZED := -32002,
			REQUEST_CANCELLED := -32800,
			CONTENT_MODIFIED := -32801
		}

		# Diagnostics are published once no message has arrived for this many idle
		# ticks of IDLE_TICK_MS (about 150 ms). Ticks, not a clock: the VM's Timer
		# measures CPU time on POSIX.
		consts Debounce {
			IDLE_TICK_MS := 10,
			QUIET_TICKS := 15
		}

		New(pipe : Pipe, socket : TCPSocket, is_debug : Bool) {
			Parent();

			@socket := socket;
			@pipe := pipe;

			@is_debug := is_debug;
			@workspace := LspWorkspace->New(@is_debug);

			@inbox := Vector->New()<RpcRequest>;
			@inbox_mutex := System.Concurrency.ThreadMutex->New("lsp-inbox");
			@pending_diagnostics := Map->New()<String, String>;
		}

		#
		# A reader thread reads ahead into the inbox; this thread handles what has
		# arrived in batches. That is what lets a burst of keystrokes cost one
		# analysis instead of one each, and lets a request that was cancelled, or
		# whose document changed under it, be answered without doing the work.
		# Handling and reading used to alternate on one thread, so every message
		# waited behind every analysis before it, and a cancel arrived only after
		# its request had been answered (#1217).
		#
		method : public : Run(param : Base) ~ Nil {
			reader := LspReader->New(@self);
			reader->Execute(Nil);

			while(<>@quit) {
				batch := TakeInbox();
				if(batch->Size() > 0) {
					@quiet_ticks := 0;
					ProcessBatch(batch);
				}
				else if(@stream_closed) {
					@quit := true;
				}
				else {
					@quiet_ticks += 1;
					if(@quiet_ticks >= LspWorker->Debounce->QUIET_TICKS->As(Int)) {
						PublishPendingDiagnostics();
					};
					System.Concurrency.Thread->Sleep(LspWorker->Debounce->IDLE_TICK_MS->As(Int));
				};
			};

			if(@socket <> Nil) {
				@socket->Close();
			}
			else if(@pipe <> Nil) {
				@pipe->Close();
			};
		}

		# called by the reader thread; Nil means the stream has closed
		method : public : Enqueue(request : RpcRequest) ~ Nil {
			critical(@inbox_mutex) {
				if(request = Nil) {
					@stream_closed := true;
				}
				else {
					@inbox->AddBack(request);
				};
			};
		}

		method : TakeInbox() ~ Vector<RpcRequest> {
			batch : Vector<RpcRequest>;
			critical(@inbox_mutex) {
				batch := @inbox;
				@inbox := Vector->New()<RpcRequest>;
			};
			return batch;
		}

		method : public : IsQuitting() ~ Bool {
			return @quit;
		}

		#
		# Everything that had arrived, in order. Two things are decided from the
		# whole batch first: which requests the client has since cancelled, and
		# which documents change later in it -- a request about a document that
		# the client edited after asking is answered ContentModified, since its
		# answer would describe text that no longer exists.
		#
		method : ProcessBatch(batch : Vector<RpcRequest>) ~ Nil {
			cancelled := Map->New()<String, String>;
			last_change := Map->New()<String, IntRef>;
			each(i : batch) {
				request := batch->Get(i);
				method_id := request->GetMethod();
				if(method_id <> Nil & request->IsNotification()) {
					if(method_id->Equals("$/cancelRequest")) {
						id_json := FindJson(request->GetParams(), "id");
						if(id_json <> Nil) {
							key := id_json->ToString();
							cancelled->Insert(key, key);
						};
					}
					else if(method_id->Equals("textDocument/didChange")) {
						uri := FindString(request->GetParams(), "textDocument/uri");
						if(uri <> Nil) {
							last_change->Remove(uri);
							last_change->Insert(uri, IntRef->New(i));
						};
					};
				};
			};

			each(i : batch) {
				request := batch->Get(i);
				method_id := request->GetMethod();

				if(method_id <> Nil & <>request->IsNotification() & <>request->IsResponse() & <>@is_shutdown) {
					@reply_id := request->GetIdJson();
					uri := FindString(request->GetParams(), "textDocument/uri");
					changed_at : IntRef;
					if(uri <> Nil) {
						changed_at := last_change->Find(uri);
					};

					if(cancelled->Has(@reply_id->ToString())) {
						WriteRpcError(request->GetId(), LspWorker->ErrorCode->REQUEST_CANCELLED->As(Int), "Request cancelled");
					}
					else if(changed_at <> Nil & changed_at->Get() > i) {
						WriteRpcError(request->GetId(), LspWorker->ErrorCode->CONTENT_MODIFIED->As(Int), "Content modified");
					}
					else {
						# These read the last text that analyzed cleanly, which a
						# diagnostics run refreshes; run a pending one first, so a
						# completion right after typing sees what was just typed.
						if(uri <> Nil & @pending_diagnostics->Has(uri) &
								(method_id->Equals("textDocument/completion") | method_id->Equals("textDocument/hover") |
								 method_id->Equals("textDocument/signatureHelp"))) {
							PublishDiagnostics(uri);
						};
						ProcessResponse(request);
					};
				}
				else if(method_id = Nil | <>method_id->Equals("$/cancelRequest")) {
					ProcessResponse(request);
				};
			};
		}

		# a document changed: publish its diagnostics once typing pauses
		method : public : DeferDiagnostics(uri : String) ~ Nil {
			@pending_diagnostics->Remove(uri);
			@pending_diagnostics->Insert(uri, uri);
		}

		method : public : DropPendingDiagnostics(uri : String) ~ Nil {
			@pending_diagnostics->Remove(uri);
		}

		method : PublishPendingDiagnostics() ~ Nil {
			uris := @pending_diagnostics->GetKeys()<String>;
			each(i : uris) {
				PublishDiagnostics(uris->Get(i));
			};
		}

		method : PublishDiagnostics(uri : String) ~ Nil {
			@pending_diagnostics->Remove(uri);
			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				WriteRpcRequest("textDocument/publishDiagnostics", document->GetDiagnostics());
			};
		}

		function : FindJson(params : JsonElement, path : String) ~ JsonElement {
			if(params = Nil | params->GetType() <> JsonElement->JsonType->OBJECT) {
				return Nil;
			};
			return params->FindElements(path);
		}

		function : FindString(params : JsonElement, path : String) ~ String {
			found := FindJson(params, path);
			if(found = Nil | found->GetType() <> JsonElement->JsonType->STRING) {
				return Nil;
			};
			return found->GetValue();
		}

		method : public : IsDebug() ~ Bool {
			return @is_debug;
		}

		#
		# Notifications
		#
		method : virtual : NotifyInitialized(params : JsonElement) ~ Nil;
		method : virtual : NotifyCancel(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidOpen(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidChange(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidChangeWatchedFiles(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidSave(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidClose(params : JsonElement) ~ Nil;
		method : virtual : NotifyDidChangeWorkspace(params : JsonElement) ~ Nil;

		#
		# Callbacks
		#
		method : virtual : CallbackInitialize(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackShutdown(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackCompletion(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackHover(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackCodeAction(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackResolve(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackRename(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDocumentSymbol(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackWorkspaceSymbol(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackReferences(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDeclaration(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDefinition(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSignatureHelp(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackFormatDocument(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackFormatRange(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackDocumentHighlight(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackFoldingRange(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSelectionRange(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackTypeDefinition(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackImplementation(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackPrepareCallHierarchy(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackIncomingCalls(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackOutgoingCalls(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackInlayHint(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackSemanticTokensFull(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackPrepareTypeHierarchy(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackTypeHierarchySupertypes(id : Int, params : JsonElement) ~ Nil;
		method : virtual : CallbackTypeHierarchySubtypes(id : Int, params : JsonElement) ~ Nil;

		# --- process requests ---
		method : ProcessResponse(request : RpcRequest) ~ Nil {
			# A reply to one of OUR requests (client/registerCapability). Nothing
			# waits on it; these used to be dispatched as requests named '<none>'.
			if(request->IsResponse()) {
				if(request->GetError() <> Nil) {
					error_text := request->GetError()->ToString();
					System.IO.Filesystem.Logger->Instance()->Error("*** Client rejected a server request: {$error_text} ***");
				};
				return;
			};

			# Not JSON, or JSON that is not a request: answer with a null id, as
			# JSON-RPC asks, and carry on reading. This used to end the session.
			if(request->GetMethod() = Nil) {
				@reply_id := Nil;
				if(request->IsParseError()) {
					WriteRpcError(-1, LspWorker->ErrorCode->PARSE_ERROR->As(Int), "Parse error");
				}
				else {
					WriteRpcError(-1, LspWorker->ErrorCode->INVALID_REQUEST->As(Int), "Invalid request");
				};
				return;
			};

			id := request->GetId();
			method_id := request->GetMethod();
			@reply_id := request->GetIdJson();

			# notification
			if(request->IsNotification()) {
				if(@is_debug) {
					System.IO.Filesystem.Logger->Instance()->Info("NOTIFICATION='{$method_id}'\n");
				};

				# Before 'initialize', every notification except 'exit' is dropped.
				if(<>@initialize_seen & <>method_id->Equals("exit")) {
					return;
				};

				select(method_id) {
					label "initialized" {
						NotifyInitialized(request->GetParams());
					}
					
					label "$/cancelRequest" {
						NotifyCancel(request->GetParams());
					}
					
					label "workspace/didChangeWatchedFiles" {
						NotifyDidChangeWatchedFiles(request->GetParams());
					}
					
					label "textDocument/didOpen" {
						NotifyDidOpen(request->GetParams());
					}
					
					label "textDocument/didChange" {
						NotifyDidChange(request->GetParams());
					}
					
					label "textDocument/didSave" {
						NotifyDidSave(request->GetParams());
					}
					
					label "textDocument/didClose" {
						NotifyDidClose(request->GetParams());
					}
					
					label "workspace/didChangeWorkspaceFolders" {
						NotifyDidChangeWorkspace(request->GetParams());
					}

					label "exit" {
						Exit();
					}

					other {
						# unknown notifications ($/setTrace, $/progress, ...) are ignored
						if(@is_debug) {
							System.IO.Filesystem.Logger->Instance()->Error("*** Unknown notification='{$method_id}' ***");
						};
					}
				};
			}
			# callback
			else {
				if(@is_debug) {
					System.IO.Filesystem.Logger->Instance()->Info("METHOD='{$method_id}', id={$id}");
				};

				# After 'shutdown' only 'exit' is valid.
				if(@is_shutdown) {
					WriteRpcError(id, LspWorker->ErrorCode->INVALID_REQUEST->As(Int), "Server is shutting down");
					return;
				};

				# Until 'initialize', nothing else may be answered.
				if(<>@initialize_seen & <>method_id->Equals("initialize")) {
					WriteRpcError(id, LspWorker->ErrorCode->SERVER_NOT_INITIALIZED->As(Int), "Server not initialized");
					return;
				};

				select(method_id) {
					label "initialize" {
						@initialize_seen := true;
						CallbackInitialize(id, request->GetParams());
					}
					
					label "textDocument/completion" {
						CallbackCompletion(id, request->GetParams());
					}
					
					label "textDocument/hover" {
						CallbackHover(id, request->GetParams());
					}
					
					label "textDocument/codeAction" {
						CallbackCodeAction(id, request->GetParams());
					}
					
					label "completionItem/resolve" {
						CallbackResolve(id, request->GetParams());
					}
					
					label "textDocument/rename" {
						CallbackRename(id, request->GetParams());
					}
					
					label "textDocument/documentSymbol" {
						CallbackDocumentSymbol(id, request->GetParams());
					}
					
					label "workspace/symbol" {
						CallbackWorkspaceSymbol(id, request->GetParams());
					}
					
					label "textDocument/references" {
						CallbackReferences(id, request->GetParams());
					}
					
					label "textDocument/declaration" {
						CallbackDeclaration(id, request->GetParams());
					}
					
					label "textDocument/definition" {
						CallbackDefinition(id, request->GetParams());
					}
					
					label "textDocument/signatureHelp" {
						CallbackSignatureHelp(id, request->GetParams());
					}
					
					label "shutdown" {
						CallbackShutdown(id, request->GetParams());
					}
					
					label "textDocument/formatting" {
						CallbackFormatDocument(id, request->GetParams());
					}

					
					label "textDocument/rangeFormatting" {
						CallbackFormatRange(id, request->GetParams());
					}

					label "textDocument/documentHighlight" {
						CallbackDocumentHighlight(id, request->GetParams());
					}

					label "textDocument/foldingRange" {
						CallbackFoldingRange(id, request->GetParams());
					}

					label "textDocument/selectionRange" {
						CallbackSelectionRange(id, request->GetParams());
					}

					label "textDocument/typeDefinition" {
						CallbackTypeDefinition(id, request->GetParams());
					}

					label "textDocument/implementation" {
						CallbackImplementation(id, request->GetParams());
					}

					label "textDocument/prepareCallHierarchy" {
						CallbackPrepareCallHierarchy(id, request->GetParams());
					}

					label "callHierarchy/incomingCalls" {
						CallbackIncomingCalls(id, request->GetParams());
					}

					label "callHierarchy/outgoingCalls" {
						CallbackOutgoingCalls(id, request->GetParams());
					}

					label "textDocument/inlayHint" {
						CallbackInlayHint(id, request->GetParams());
					}

					label "textDocument/semanticTokens/full" {
						CallbackSemanticTokensFull(id, request->GetParams());
					}

					label "textDocument/prepareTypeHierarchy" {
						CallbackPrepareTypeHierarchy(id, request->GetParams());
					}

					label "typeHierarchy/supertypes" {
						CallbackTypeHierarchySupertypes(id, request->GetParams());
					}

					label "typeHierarchy/subtypes" {
						CallbackTypeHierarchySubtypes(id, request->GetParams());
					}

					other {
						# Every request gets an answer. An unknown one used to get none,
						# and the client's promise waited forever.
						if(@is_debug) {
							System.IO.Filesystem.Logger->Instance()->Error("*** Unknown method='{$method_id}' ***");
						};
						WriteRpcError(id, LspWorker->ErrorCode->METHOD_NOT_FOUND->As(Int), "Method not found: {$method_id}");
					}
				};
			};
		}

		# --- utilities ---

		#
		# One message: header lines up to a blank line, then Content-Length bytes.
		# Returns Nil when the stream has closed.
		#
		# This read exactly ONE header line and one blank line, so a client that
		# sent Content-Type (legal, and sent first by some) got no answer at all.
		# The pipe was read as if each read returned one whole message, which a
		# message-mode pipe does not promise: a body over 8 KB was cut short and the
		# message lost, and a client that writes the header and the body separately
		# (vscode-jsonrpc does) had its body discarded as the "blank line". The pipe
		# is now read as a byte stream through a buffer.
		#
		method : ReadString() ~ String {
			length := -1;
			while(true) {
				line := ReadHeaderLine();
				if(line = Nil) {
					return Nil;
				};

				if(line->IsEmpty()) {
					# end of the header block; a blank line before any header means
					# the stream is gone (a closed console or socket reads as empty)
					if(length < 0) {
						return Nil;
					};

					text := ReadBody(length);
					if(@is_debug & text <> Nil) {
						System.IO.Filesystem.Logger->Instance()->Info("====\nREAD='{$text}'");
					};
					return text;
				};

				index := line->Find(':');
				if(index > 0) {
					name := line->SubString(index)->Trim()->ToLower();
					if(name->Equals("content-length")) {
						length := line->SubString(index + 1, line->Size() - index - 1)->Trim()->ToInt();
					};
				};
			};

			return Nil;
		}

		# A header line without its line ending, or Nil when the stream has closed.
		method : ReadHeaderLine() ~ String {
			line : String;
			if(@socket <> Nil) {
				line := @socket->ReadLine();
			}
			else if(@pipe <> Nil) {
				line := ReadPipeLine();
			}
			else {
				line := Console->ReadLine();
			};

			if(line = Nil) {
				return Nil;
			};

			return line->Trim();
		}

		method : ReadBody(length : Int) ~ String {
			if(length = 0) {
				return "";
			};

			# socket
			if(@socket <> Nil) {
				buffer := Byte->New[length];
				@socket->ReadBuffer(0, buffer->Size(), buffer);
				return String->New(buffer->ToUnicode());
			}
			# pipe
			else if(@pipe <> Nil) {
				buffer := ReadPipeBytes(length);
				if(buffer = Nil) {
					return Nil;
				};
				return String->New(buffer->ToUnicode());
			};

			# stdin
			buffer := Char->New[length];
			Console->ReadBuffer(0, buffer->Size(), buffer);
			return String->New(buffer);
		}

		#
		# Buffered pipe input: whatever each read returns -- part of a message, one
		# message, or several -- is appended here and framing is parsed from it.
		#
		method : FillPipe() ~ Bool {
			chunk := Byte->New[8192];
			read := @pipe->ReadBuffer(0, chunk->Size(), chunk);
			if(read <= 0) {
				return false;
			};

			if(@pipe_bytes = Nil) {
				@pipe_bytes := Byte->New[16384];
			};

			# compact, then grow if needed
			if(@pipe_start > 0) {
				pending := @pipe_end - @pipe_start;
				for(i := 0; i < pending; i += 1;) {
					@pipe_bytes[i] := @pipe_bytes[@pipe_start + i];
				};
				@pipe_start := 0;
				@pipe_end := pending;
			};

			if(@pipe_end + read > @pipe_bytes->Size()) {
				size := @pipe_bytes->Size() * 2;
				while(@pipe_end + read > size) {
					size *= 2;
				};
				grown := Byte->New[size];
				for(i := 0; i < @pipe_end; i += 1;) {
					grown[i] := @pipe_bytes[i];
				};
				@pipe_bytes := grown;
			};

			for(i := 0; i < read; i += 1;) {
				@pipe_bytes[@pipe_end + i] := chunk[i];
			};
			@pipe_end += read;

			return true;
		}

		method : ReadPipeLine() ~ String {
			while(true) {
				for(i := @pipe_start; i < @pipe_end; i += 1;) {
					if(@pipe_bytes[i] = 10) {
						size := i - @pipe_start;
						line := Byte->New[size];
						for(j := 0; j < size; j += 1;) {
							line[j] := @pipe_bytes[@pipe_start + j];
						};
						@pipe_start := i + 1;
						return String->New(line->ToUnicode());
					};
				};

				if(<>FillPipe()) {
					return Nil;
				};
			};

			return Nil;
		}

		method : ReadPipeBytes(length : Int) ~ Byte[] {
			while(@pipe_end - @pipe_start < length) {
				if(<>FillPipe()) {
					return Nil;
				};
			};

			bytes := Byte->New[length];
			for(i := 0; i < length; i += 1;) {
				bytes[i] := @pipe_bytes[@pipe_start + i];
			};
			@pipe_start += length;

			return bytes;
		}

		method : WriteString(text : String) ~ Nil {
			length := text->Size();
			line := "Content-Length: {$length}\r\n\r\n{$text}";

			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("WRITE='{$line}'");
			};

			# write to socket
			if(@socket <> Nil) {
				@socket->WriteString(line);
			}
			# write to pipe
			else if(@pipe <> Nil) {
				@pipe->WriteString(line);
			}
			# write to stdout
			else {
				Console->WriteString(line);
				Console->Flush();
			};
		}

		# The next message, or Nil once the stream has closed. A body that is not
		# a JSON-RPC message comes back as a request with no method, so it can be
		# answered with an error instead of ending the session.
		method : public : ReadRpcRequest() ~ RpcRequest {
			text := ReadString();
			if(text = Nil) {
				return Nil;
			};

			json := JsonParser->New(text);
			if(<>json->Parse()) {
				return RpcRequest->New(true);
			};

			node := json->GetRoot();
			if(node = Nil | node->GetType() <> JsonElement->JsonType->OBJECT) {
				return RpcRequest->New(false);
			};

			# kept as sent: ids are 'integer | string' and are echoed back verbatim
			id_elem := node->Get("id");
			if(id_elem <> Nil & id_elem->GetType() = JsonElement->JsonType->NULL) {
				id_elem := Nil;
			};

			mthd_elem := node->Get("method");
			if(mthd_elem = Nil) {
				# a reply to one of our requests
				if(id_elem <> Nil & (node->Get("result") <> Nil | node->Get("error") <> Nil)) {
					return RpcRequest->New(id_elem, node->Get("error"));
				};
				return RpcRequest->New(false);
			};

			ver := node->Get("jsonrpc");
			if(ver = Nil | <>ver->GetValue()->Equals("2.0")) {
				return RpcRequest->New(false);
			};

			return RpcRequest->New(Decoded(id_elem), JsonElement->Decode(mthd_elem->GetValue()), Decoded(node->Get("params")));
		}

		#
		# Data.JSON's parser keeps string values as they were written, escapes and
		# all, and leaves decoding to the caller (JsonElement->Decode). Every string
		# in a message is decoded here, once, so the rest of the server works on
		# plain text and the serializer's escaping on the way out is the only one.
		#
		# The Document used to hand-decode its text instead, and only \t \r \n \\
		# and \": a client that sent non-ASCII as \u escapes left six characters
		# in the document per character, and every column after it on the line was
		# wrong (#1216).
		#
		function : Decoded(elem : JsonElement) ~ JsonElement {
			if(elem = Nil) {
				return Nil;
			};

			type := elem->GetType();
			if(type = JsonElement->JsonType->STRING) {
				return JsonElement->New(JsonElement->Decode(elem->GetValue()));
			}
			else if(type = JsonElement->JsonType->ARRAY) {
				elems := Vector->New()<JsonElement>;
				each(i : elem) {
					elems->AddBack(Decoded(elem->Get(i)));
				};
				return JsonElement->New(elems);
			}
			else if(type = JsonElement->JsonType->OBJECT) {
				members := Map->New()<String, JsonElement>;
				names := elem->GetNames();
				if(names <> Nil) {
					each(i : names) {
						name := names->Get(i);
						members->Insert(JsonElement->Decode(name), Decoded(elem->Get(name)));
					};
				};
				return JsonElement->New(members);
			};

			return elem;
		}

		# --- server-to-client request ---
		method : WriteRpcServerRequest(kind : String, params : JsonElement) ~ Nil {
			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			# Its own id space, as strings, so it can never be mistaken for one of
			# the client's numeric ids. This was a fixed 101.
			@next_server_id += 1;
			node->Insert("jsonrpc", "2.0");
			node->Insert("id", "objk-{$@next_server_id}");
			node->Insert("method", kind);
			node->Insert("params", params);

			WriteString(node->ToString());
		}

		# --- response ---
		method : WriteRpcResponse(id : Int, result : JsonElement) ~ Nil {
			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			node->Insert("jsonrpc", "2.0");
			InsertReplyId(node, id);
			if(result = Nil) {
				node->Insert("result", JsonElement->New(JsonElement->JsonType->NULL));
			}
			else {
				node->Insert("result", result);
			};

			WriteString(node->ToString());
		}

		method : WriteRpcError(id : Int, code : Int, message : String) ~ Nil {
			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			node->Insert("jsonrpc", "2.0");
			InsertReplyId(node, id);
			error := node->AddChild("error");
			error->Insert("code", code);
			error->Insert("message", message);

			WriteString(node->ToString());
		}

		# The id exactly as the client sent it -- a string id used to be read with
		# ToInt and answered as 0. JSON-RPC answers an unidentifiable request with
		# a null id.
		method : InsertReplyId(node : JsonElement, id : Int) ~ Nil {
			if(@reply_id <> Nil) {
				node->Insert("id", @reply_id);
			}
			else if(id > -1) {
				node->Insert("id", id);
			}
			else {
				node->Insert("id", JsonElement->New(JsonElement->JsonType->NULL));
			};
		}

		#
		# 'exit': the process ends with 0 after a 'shutdown' and 1 without one. On a
		# TCP connection the process serves other clients, so only this connection
		# ends.
		#
		method : Exit() ~ Nil {
			if(@socket <> Nil) {
				@quit := true;
				return;
			};

			if(@is_shutdown) {
				Runtime->Exit(0);
			};
			Runtime->Exit(1);
		}

		# --- request ---
		method : WriteRpcRequest(kind : String, result : JsonElement) ~ Nil {
			node := JsonElement->New(JsonElement->JsonType->OBJECT);

			node->Insert("jsonrpc", "2.0");
			node->Insert("method", kind);

			if(result = Nil) {
				node->Insert("params", JsonElement->New(JsonElement->JsonType->NULL));
			}
			else {
				node->Insert("params", result);
			};

			WriteString(node->ToString());
		}
	}

	#~
	Workspaace
	~#
	class : private : LspWorkspace {
		@is_debug : Bool;
		@name : String;
		@root : String;
		@local_path : String;
		@file_strs : String[];		
		@libs_str : String;		
		@documents : Map<String, Document>;
		@texts : String[,];

		New(is_debug : Bool) {
			@is_debug := is_debug;
			@documents := Map->New()<String, Document>;
		}

		method : public : SetRoot(name : String, root : String) ~ Nil {
			@name := name;
			@root := root;
		}

		method : public : SetFilesLibs(local_path : String, file_strs : String[], libs_str : String) ~ Nil {
			@local_path := local_path;
			@file_strs := file_strs;
			@libs_str := libs_str;
		}

		method : public : GetTexts(uri : String, use_alt : Bool) ~ String[,] {
			# workspace
			if(@file_strs <> Nil) {
				file_count := @file_strs->Size();
				if(file_count > 0) {
					@texts := String->New[file_count, 2];

					each(i : file_count) {
						local_file_path := String->New(@local_path);
						local_file_path += '/';
						local_file_path += @file_strs[i];

						file_uri := String->New(@root);
						file_uri += '/';
						file_uri += @file_strs[i];

						text : String;
						document := @documents->Find(file_uri);
						if(document <> Nil) {
							if(use_alt) {
								text := document->GetAltText();
							}
							else {
								text := document->GetText();
							};

							if(@is_debug & text <> Nil) {
								size := text->Size();
								System.IO.Filesystem.Logger->Instance()->Info("### Cached: file_uri='{$file_uri}', size={$size} ###");
							};
						}
						else {
							text := System.IO.Filesystem.FileReader->ReadFile(local_file_path);
							if(@is_debug & text <> Nil) {
								size := text->Size();
								System.IO.Filesystem.Logger->Instance()->Info("### From disk: local_file_path='{$local_file_path}', size={$size} ###");
							};
						};

						if(text = Nil) {
							System.IO.Filesystem.Logger->Instance()->Error("Unable to open file: {$local_file_path}");
						}
						else {
							@texts[i,0] := file_uri;
							@texts[i,1] := text;
						};
					};

					return @texts;
				};
			}
			# non-workspace
			else {
				# Libraries assumed for a file with no build.json. gen_collect.obl was
				# listed TWICE here, and the list omitted regex, xml, csv, query and the
				# json_rpc/json_stream pair -- so a standalone file using any of them was
				# told its classes were undefined, with the diagnostic pointing at the
				# user's code rather than at this list.
				@libs_str := "gen_collect.obl,cipher.obl,csv.obl,json.obl,json_rpc.obl,json_stream.obl,misc.obl,net.obl,net_server.obl,query.obl,regex.obl,rss.obl,xml.obl";

				# One document, or -- with no uri, which is how workspace/symbol asks once
				# more than one file is open -- every open document. That case called
				# Equals(Nil) here and took the server down (#1214).
				key_values := @documents->GetKeyValues()<Pair<String, Document>>;
				count := 0;
				each(i : key_values) {
					key_value := key_values->Get(i);
					if(uri = Nil | key_value->GetFirst()->Equals(uri)) {
						count += 1;
					};
				};

				@texts := String->New[count > 0 ? count : 1, 2];
				index := 0;
				each(i : key_values) {
					key_value := key_values->Get(i);

					file_uri := key_value->GetFirst();
					if(uri = Nil | file_uri->Equals(uri)) {
						document := key_value->GetSecond();

						text : String;
						if(use_alt) {
							text := document->GetAltText();
						}
						else {
							text := document->GetText();
						};

						if(@is_debug & text <> Nil) {
							size := text->Size();
							System.IO.Filesystem.Logger->Instance()->Info("### Cached: file_uri='{$file_uri}', size={$size} ###");
						};

						@texts[index,0] := file_uri;
						@texts[index,1] := text;
						index += 1;
					};
				};
			};
			
			return @texts;
		}

		method : public : GetLibs() ~ String {
			return @libs_str;
		}

		method : public : GetDocument(uri : String) ~ Document {
			return @documents->Find(uri);
		}

		method : public : AddDocument(uri : String, document : Document) ~ Nil {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> Add: {$uri}");
			};

			@documents->Remove(uri);
			@documents->Insert(uri, document);
		}

		method : public : RemoveDocument(uri : String, document : Document) ~ Nil {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> Remove: {$uri}");
			};

			if(@documents->Remove(uri)) {
				document->Release();
			};
		}

		method : public : GetSymbol(query : String) ~ JsonElement {
			uri : String;
			uris := @documents->GetKeys()<String>;
			if(uris->Size() = 1) {
				uri := uris->Get(0);
			};

			proxy := AstProxy->New(@self, uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			if(proxy->Build()) {
				return proxy->GetSymbol(query, uris, GetLibs());
			};

			return Nil;
		}
	}

	#~
	In-memory text document
	~#
	class : private : Document {
		@workspace : LspWorkspace;
		@uri : String;
		@text : String;
		@alt_text : String;
		@is_debug : Bool;
		# the client's version of the text, or -1 if it sent none
		@version : Int;

		New(uri : String, text : String, workspace : LspWorkspace, is_debug : Bool) {
			@workspace := workspace;
			@uri := uri;
			@text := String->New(text);
			@is_debug := is_debug;
			@version := -1;
		}

		method : public : SetVersion(version : Int) ~ Nil {
			@version := version;
		}

		method : public : Refresh(text : String) ~ Nil {
			@text := String->New(text);
		}
		
		method : public : Reload() ~ Nil {
			if(@uri->StartsWith("file://")) {
				filename : String;
				if(System.IO.Filesystem.Directory->GetSlash() = '\\') {
					offset := "file:///"->Size();
					filename := @uri->SubString(offset, @uri->Size() - offset);
					filename := filename->ReplaceAll('/', '\\');
				}	
				else {
					offset := "file://"->Size();
					filename := @uri->SubString(offset, @uri->Size() - offset);
				};
								
				text := System.IO.Filesystem.FileReader->ReadFile(filename);
				if(text <> Nil) {
					@text := text;
				};
			};
		}
		
		method : public : GetDiagnostics() ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			was_analyzed := BoolRef->New();
			result := proxy->GetDiagnostics(was_analyzed, @uri, @workspace->GetLibs());
			if(was_analyzed->Get()) {
				@alt_text := @text->Clone()->As(String);
			};

			# which text these describe, so a client can discard a stale set
			if(result <> Nil & @version > -1) {
				result->Insert("version", @version);
			};

			return result;
		}

		method : public : GetSymbols(uri : String) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			if(proxy->Build()) {
				return proxy->GetSymbols(uri, @workspace->GetLibs());
			};

			return Nil;
		}

		method : public : FindReferences(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			return proxy->FindReferences(line_pos, char_pos, @uri, @workspace->GetLibs());
		}

		method : public : CodeRename(new_name : String, line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			return proxy->CodeRename(new_name, line_pos, char_pos, @uri, @workspace->GetLibs());
		}
		
		method : public : FindDeclaration(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			return proxy->FindDeclaration(line_pos, char_pos, @uri, @workspace->GetLibs());
		}

		method : public : FindDefinition(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			return proxy->FindDefinition(line_pos, char_pos, @uri, @workspace->GetLibs());
		}

		method : public : Completion(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, true, @is_debug);
			leaving {
				proxy->Release();
			};
			
			index := GetDocumentIndex(line_pos, char_pos);
			if(index > -1) {
				var_str := ""; mthd_str := "";
				if(GetVariableMethodStrings(index - 1, var_str, mthd_str, false)) {
					return proxy->Completion(line_pos, char_pos, var_str, mthd_str, @uri, @workspace->GetLibs());
				};
			};

			return Nil;
		}

		method : public : Hover(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, true, @is_debug);
			leaving {
				proxy->Release();
			};
			
			index := GetDocumentIndex(line_pos, char_pos);
			if(index > -1) {
				var_str := ""; mthd_str := "";
				if(GetVariableMethodStrings(index - 1, var_str, mthd_str, false)) {
					return proxy->Hover(line_pos, char_pos, var_str, mthd_str, @uri, @workspace->GetLibs());
				};
			};

			return Nil;
		}

		method : public : SignatureHelp(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, true, @is_debug);
			leaving {
				proxy->Release();
			};

			index := GetDocumentIndex(line_pos, char_pos);
			if(index > -1) {
				var_str := "";	mthd_str := "";
				if(GetVariableMethodStrings(index, var_str, mthd_str)) {
					return proxy->SignatureHelp(line_pos, char_pos, var_str, mthd_str, @uri, @workspace->GetLibs());
				};
			};
			
			return Nil;
		}

		method : public : CodeAction(start_range_line : Int, start_range_char : Int, end_range_line : Int, end_range_char : Int, message : String, context : String, build_file : String) ~  JsonElement {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> CodeAction: uri='{$@uri}'");
			};
			
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			if(context->Equals("quickfix") & message->StartsWith("Undefined class")) {
				#
				# The FIRST quoted token, not everything between the first quote and the
				# last. These messages do not all quote one thing: an inferred-type local
				# reports
				#
				#   Undefined class: 'Vector'\n\t'Vector' is defined in bundle 'Collection'
				#
				# so first-to-last yielded "Vector'\n\t'Vector' is defined in bundle
				# 'Collection", which matches no class and so produced no fix at all --
				# while the declared form, whose message quotes only the class, worked.
				# That is half of #1057; any future message that adds a hint would have
				# broken the same way.
				#
				# String has no Find(Char, Int) here, so the search for the CLOSING quote
				# runs on the remainder and its result is relative to that.
				start := message->Find('\'');
				if(start > -1) {
					start += 1;
					tail := message->SubString(start, message->Size() - start);
					length := tail->Find('\'');
					if(length > 0) {
						class_name := tail->SubString(length);
						#
						# Is the DIAGNOSTIC anchored on the class token itself? That is what
						# separates the shapes a symbol-table lookup cannot serve -- an
						# inferred-type local like `v := Vector->New()`, whose entry does not
						# exist yet because analysis aborted on this very error -- from the
						# shapes where the diagnostic points at a variable, a parameter or a
						# method name instead. Measured across six shapes: only five of ten
						# such diagnostics start on the class, and they are exactly the ones
						# where it is a method-call target. Offering a qualifier at the other
						# five would insert "Bundle." before a variable or a method name --
						# an applied fix that leaves the program still not compiling, which
						# is what #1052 was.
						#
						# Only this layer can tell: the document text lives here, and the
						# native analysis has no source to compare against.
						#
						on_class := false;
						index := GetDocumentIndex(start_range_line, start_range_char);
						if(@text <> Nil & index > -1 & index + class_name->Size() <= @text->Size()) {
							on_class := @text->SubString(index, class_name->Size())->Equals(class_name);
						};
						
						return proxy->CodeAction(@uri, start_range_line, start_range_char, class_name, build_file, on_class);
					};
				};
			};

			return Nil;
		}

		method : public : FindTypeDefinition(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			return proxy->FindTypeDefinition(line_pos, char_pos, @uri, @workspace->GetLibs());
		}

		method : public : FindImplementation(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
			};

			return proxy->FindImplementation(line_pos, char_pos, @uri, @workspace->GetLibs());
		}

		method : public : PrepareCallHierarchy(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := AstProxy->New(@workspace, @uri, false, @is_debug);
			leaving {
				proxy->Release();
