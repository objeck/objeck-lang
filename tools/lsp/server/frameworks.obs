		#
		# semanticTokens/full, with a resultId: the next delta request names it, and
		# is answered with the edit from these tokens to the new ones. Every edit
		# re-sent every token in the file.
		#
		method : public : SemanticTokensFull() ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);
			rows := TokenUnits(proxy->SemanticTokenRows(@uri, @workspace->GetLibs(@uri)));
			if(rows = Nil) {
				return Nil;
			};

			data := AstProxy->EncodeTokens(rows, -1, -1);
			result := JsonElement->New(JsonElement->JsonType->OBJECT);
			result->Insert("resultId", KeepTokens(data));
			result->Insert("data", AstProxy->IntsToJson(data));
			return result;
		}

		# semanticTokens/range: the tokens of these lines
		method : public : SemanticTokensRange(start_line : Int, end_line : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);
			rows := TokenUnits(proxy->SemanticTokenRows(@uri, @workspace->GetLibs(@uri)));
			if(rows = Nil) {
				return Nil;
			};

			result := JsonElement->New(JsonElement->JsonType->OBJECT);
			result->Insert("data", AstProxy->IntsToJson(AstProxy->EncodeTokens(rows, start_line, end_line)));
			return result;
		}

		#
		# semanticTokens/full/delta: the edit from the tokens last sent under
		# previous_id to the current ones -- one replacement of the span between
		# their common prefix and suffix. Full tokens when previous_id isn't the
		# last result, which the client then takes as they are.
		#
		method : public : SemanticTokensDelta(previous_id : String) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);
			rows := TokenUnits(proxy->SemanticTokenRows(@uri, @workspace->GetLibs(@uri)));
			if(rows = Nil) {
				return Nil;
			};

			data := AstProxy->EncodeTokens(rows, -1, -1);
			old := @token_data;
			matches := previous_id <> Nil & @token_result_id <> Nil & previous_id->Equals(@token_result_id) & old <> Nil;

			result := JsonElement->New(JsonElement->JsonType->OBJECT);
			if(<>matches) {
				result->Insert("resultId", KeepTokens(data));
				result->Insert("data", AstProxy->IntsToJson(data));
				return result;
			};

			prefix := 0;
			while(prefix < old->Size() & prefix < data->Size() & old[prefix] = data[prefix]) {
				prefix += 1;
			};

			suffix := 0;
			while(suffix < old->Size() - prefix & suffix < data->Size() - prefix &
					old[old->Size() - 1 - suffix] = data[data->Size() - 1 - suffix]) {
				suffix += 1;
			};

			edits := JsonElement->New(JsonElement->JsonType->ARRAY);
			delete_count := old->Size() - prefix - suffix;
			insert_count := data->Size() - prefix - suffix;
			if(delete_count > 0 | insert_count > 0) {
				inserted := Int->New[insert_count];
				for(i := 0; i < insert_count; i += 1;) {
					inserted[i] := data[prefix + i];
				};

				edit := JsonElement->New(JsonElement->JsonType->OBJECT);
				edit->Insert("start", prefix);
				edit->Insert("deleteCount", delete_count);
				edit->Insert("data", AstProxy->IntsToJson(inserted));
				edits->Add(edit);
			};

			result->Insert("resultId", KeepTokens(data));
			result->Insert("edits", edits);
			return result;
		}

		#
		# Columns of one line, between Chars and UTF-16 units. A Char above U+FFFF
		# is two units; a column inside such a pair means the Char after it.
		#
		function : CharsToUnits(line : String, chars : Int) ~ Int {
			units := 0;
			for(i := 0; i < chars & i < line->Size(); i += 1;) {
				units += line->Get(i)->As(Int) > 0xffff ? 2 : 1;
			};
			if(chars > line->Size()) {
				units += chars - line->Size();
			};
			return units;
		}

		function : UnitsToChars(line : String, units : Int) ~ Int {
			counted := 0;
			index := 0;
			while(counted < units & index < line->Size()) {
				counted += line->Get(index)->As(Int) > 0xffff ? 2 : 1;
				index += 1;
			};
			if(counted < units) {
				index += units - counted;
			};
			return index;
		}

		# the text of one line of this document
		method : public : LineText(line : Int) ~ String {
			start := GetDocumentIndex(line, 0);
			end := start;
			while(end < @text->Size() & @text->Get(end) <> '\n' & @text->Get(end) <> '\r') {
				end += 1;
			};
			return @text->SubString(start, end - start);
		}

		# token rows (line, char, length, ...) with columns and lengths in UTF-16 units
		method : TokenUnits(rows : Int[]) ~ Int[] {
			if(rows = Nil | <>@workspace->IsUtf16()) {
				return rows;
			};

			line_index := -1;
			line_text := "";
			for(i := 0; i < rows->Size(); i += 5;) {
				if(rows[i] <> line_index) {
					line_index := rows[i];
					line_text := LineText(line_index);
				};
				start := CharsToUnits(line_text, rows[i + 1]);
				end := CharsToUnits(line_text, rows[i + 1] + rows[i + 2]);
				rows[i + 1] := start;
				rows[i + 2] := end - start;
			};
			return rows;
		}

		# the tokens a later delta is computed from, and their id
		method : KeepTokens(data : Int[]) ~ String {
			@token_count += 1;
			@token_data := data;
			@token_result_id := "{$@token_count}";
			return @token_result_id;
		}

		#
		# textDocument/codeLens: one on each 'function : Main(args : String[])',
		# saying how to build and run the program it starts. With run_command (the
		# client's command id, from initializationOptions.runCommand) the lens runs
		# it, given { cwd, obc, obr } -- the compiler's and the VM's arguments;
		# otherwise it's a label. A file in a configured folder builds with that
		# folder's build.json files and libraries.
		#
		method : public : CodeLens(run_command : String) ~ JsonElement {
			lenses := JsonElement->New(JsonElement->JsonType->ARRAY);
			if(@text = Nil) {
				return lenses;
			};

			# the program: its sources, libraries and directory
			local_path := LspFolder->LocalPath(@uri);
			slash := local_path->FindLast('/');
			dir := slash > 0 ? local_path->SubString(slash) : ".";
			file_name := slash > -1 ? local_path->SubString(slash + 1, local_path->Size() - slash - 1) : local_path;
			sources := file_name;
			libs := "";

			folder := @workspace->FolderFor(@uri);
			if(folder <> Nil) {
				dir := folder->GetLocalPath();
				sources := folder->GetSources();
				libs := folder->GetLibs()->ReplaceAll(".obl", "");
			};

			program := file_name;
			if(program->EndsWith(".obs")) {
				program := program->SubString(program->Size() - 4);
			};
			program += ".obe";

			lines := @text->Split('\n');
			in_comment := false;
			each(i : lines) {
				line := lines[i];
				trimmed := line->Trim();
				if(in_comment) {
					if(trimmed->Find("~#") > -1) {
						in_comment := false;
					};
				}
				else if(trimmed->StartsWith("#~")) {
					in_comment := trimmed->Find("~#") < 0;
				}
				else if(<>trimmed->StartsWith("#")) {
					main_at := line->Find("function : Main(");
					if(main_at > -1 & line->Find("String[]") > main_at) {
						name_at := main_at + "function : "->Size();
						lenses->Add(MakeRunLens(i, name_at, run_command, dir, sources, libs, program));
					};
				};
			};

			return lenses;
		}

		method : MakeRunLens(line : Int, start_char : Int, run_command : String, dir : String,
				sources : String, libs : String, program : String) ~ JsonElement {
			obc_args := JsonElement->New(JsonElement->JsonType->ARRAY);
			obc_args->Add("-src");
			obc_args->Add(sources);
			if(<>libs->IsEmpty()) {
				obc_args->Add("-lib");
				obc_args->Add(libs);
			};
			obc_args->Add("-dest");
			obc_args->Add(program);

			obr_args := JsonElement->New(JsonElement->JsonType->ARRAY);
			obr_args->Add(program);

			command_line := "obc -src {$sources}";
			if(<>libs->IsEmpty()) {
				command_line += " -lib {$libs}";
			};
			command_line += " -dest {$program} && obr {$program}";

			command := JsonElement->New(JsonElement->JsonType->OBJECT);
			if(run_command <> Nil) {
				command->Insert("title", "Run");
				command->Insert("command", run_command);

				run := JsonElement->New(JsonElement->JsonType->OBJECT);
				run->Insert("cwd", dir);
				run->Insert("obc", obc_args);
				run->Insert("obr", obr_args);
				arguments := JsonElement->New(JsonElement->JsonType->ARRAY);
				arguments->Add(run);
				command->Insert("arguments", arguments);
			}
			else {
				# no client command: a label that says what to run
				command->Insert("title", "Run: {$command_line}");
				command->Insert("command", "");
			};

			lens := JsonElement->New(JsonElement->JsonType->OBJECT);
			lens->Insert("range", MakeLineRange(line, start_char, line, start_char + "Main"->Size()));
			lens->Insert("command", command);
			return lens;
		}

		function : MakeLineRange(start_line : Int, start_char : Int, end_line : Int, end_char : Int) ~ JsonElement {
			start := JsonElement->New(JsonElement->JsonType->OBJECT);
			start->Insert("line", start_line);
			start->Insert("character", start_char);
			end := JsonElement->New(JsonElement->JsonType->OBJECT);
			end->Insert("line", end_line);
			end->Insert("character", end_char);
			range := JsonElement->New(JsonElement->JsonType->OBJECT);
			range->Insert("start", start);
			range->Insert("end", end);
			return range;
		}

		#
		# textDocument/documentLink: each bundle a leading 'use' names that the API
		# reference documents, linked to its entry there.
		#
		method : public : DocumentLinks() ~ JsonElement {
			links := JsonElement->New(JsonElement->JsonType->ARRAY);
			if(@text = Nil) {
				return links;
			};

			lines := @text->Split('\n');
			in_comment := false;
			done := false;
			for(i := 0; i < lines->Size() & <>done; i += 1;) {
				line := lines[i];
				trimmed := line->Trim();
				if(in_comment) {
					if(trimmed->Find("~#") > -1) {
						in_comment := false;
					};
				}
				else if(trimmed->IsEmpty()) {
				}
				else if(trimmed->StartsWith("#~")) {
					in_comment := trimmed->Find("~#") < 0;
				}
				else if(trimmed->StartsWith("#")) {
				}
				else if(trimmed->StartsWith("use ") | trimmed->StartsWith("use\t")) {
					AddUseLinks(i, line, links);
				}
				else {
					done := true;
				};
			};

			return links;
		}

		# the bundle names on one 'use' line, where they are on it
		method : AddUseLinks(line_index : Int, line : String, links : JsonElement) ~ Nil {
			index := line->Find("use") + 3;
			end := line->Find(';');
			if(end < 0) {
				end := line->Size();
			};

			while(index < end) {
				while(index < end & (line->Get(index) = ' ' | line->Get(index) = '\t' | line->Get(index) = ',')) {
					index += 1;
				};

				start := index;
				while(index < end & line->Get(index) <> ' ' & line->Get(index) <> '\t' & line->Get(index) <> ',') {
					index += 1;
				};

				if(index > start) {
					name := line->SubString(start, index - start);
					# 'use bundle X' and 'use class X' -- the keywords aren't links
					if(<>name->Equals("bundle") & <>name->Equals("class") & AstProxy->HasDocumentedBundle(name)) {
						target := "https://www.objeck.org/api/latest/index.html?scrollTo=";
						target += name->ToLower();

						link := JsonElement->New(JsonElement->JsonType->OBJECT);
						link->Insert("range", MakeLineRange(line_index, start, line_index, index));
						link->Insert("target", target);
						link->Insert("tooltip", "{$name} in the Objeck API reference");
						links->Add(link);
					};
				};
			};
		}

		method : public : DocumentHighlight(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->DocumentHighlight(line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		method : public : PrepareTypeHierarchy(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->PrepareTypeHierarchy(line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		method : public : TypeHierarchySupertypes(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->TypeHierarchySupertypes(line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		method : public : TypeHierarchySubtypes(line_pos : Int, char_pos : Int) ~ JsonElement {
			proxy := @workspace->GetProxy(@uri, false);

			return proxy->TypeHierarchySubtypes(line_pos, char_pos, @uri, @workspace->GetLibs(@uri));
		}

		method : public : FoldingRange() ~ JsonElement {
			if(@text = Nil) {
				return Nil;
			};

			array := JsonElement->New(JsonElement->JsonType->ARRAY);

			# stack for brace line tracking
			brace_lines := Int->New[256];
			brace_top := 0;

			cur_line := 0;
			in_string := false;
			in_char := false;
			in_line_comment := false;
			in_multi_comment := false;
			multi_comment_start := -1;

			for(i := 0; i < @text->Size(); i += 1;) {
				c := @text->Get(i);
				next_c := '\0';
				if(i + 1 < @text->Size()) {
					next_c := @text->Get(i + 1);
				};

				if(c = '\n') {
					cur_line += 1;
					in_line_comment := false;
				};

				if(in_line_comment) {
					# skip
				}
				else if(in_multi_comment) {
					if(c = '~' & next_c = '#') {
						range := JsonElement->New(JsonElement->JsonType->OBJECT);
						range->Insert("startLine", multi_comment_start);
						range->Insert("endLine", cur_line);
						range->Insert("kind", "comment");
						array->Add(range);
						in_multi_comment := false;
						i += 1;
					};
				}
				else if(in_string) {
					if(c = '\\') {
						i += 1;
					}
					else if(c = '"') {
						in_string := false;
					};
				}
				else if(in_char) {
					if(c = '\\') {
						i += 1;
					}
					else if(c = '\'') {
						in_char := false;
					};
				}
				else {
					if(c = '#') {
						if(next_c = '~') {
							in_multi_comment := true;
							multi_comment_start := cur_line;
							i += 1;
						}
						else {
							in_line_comment := true;
						};
					}
					else if(c = '"') {
						in_string := true;
					}
					else if(c = '\'') {
						in_char := true;
					}
					else if(c = '{') {
						if(brace_top < 256) {
							brace_lines[brace_top] := cur_line;
							brace_top += 1;
						};
					}
					else if(c = '}') {
						if(brace_top > 0) {
							brace_top -= 1;
							start_line := brace_lines[brace_top];
							if(cur_line > start_line) {
								range := JsonElement->New(JsonElement->JsonType->OBJECT);
								range->Insert("startLine", start_line);
								range->Insert("endLine", cur_line);
								array->Add(range);
							};
						};
					};
				};
			};

			return array;
		}

		method : public : SelectionRange(positions : JsonElement) ~ JsonElement {
			if(@text = Nil | positions = Nil) {
				return Nil;
			};

			# collect all brace pairs with char positions
			open_lines := Int->New[256];
			open_chars := Int->New[256];
			close_lines := Int->New[256];
			close_chars := Int->New[256];
			pair_count := 0;

			brace_stack_lines := Int->New[256];
			brace_stack_chars := Int->New[256];
			brace_top := 0;

			cur_line := 0;
			cur_char := 0;
			in_string := false;
			in_char := false;
			in_line_comment := false;
			in_multi_comment := false;

			for(i := 0; i < @text->Size(); i += 1;) {
				c := @text->Get(i);
				next_c := '\0';
				if(i + 1 < @text->Size()) {
					next_c := @text->Get(i + 1);
				};

				if(c = '\n') {
					cur_line += 1;
					cur_char := 0;
					in_line_comment := false;
				}
				else {
					if(in_line_comment) {
						# skip
					}
					else if(in_multi_comment) {
						if(c = '~' & next_c = '#') {
							in_multi_comment := false;
							i += 1;
							cur_char += 1;
						};
					}
					else if(in_string) {
						if(c = '\\') {
							i += 1;
							cur_char += 1;
						}
						else if(c = '"') {
							in_string := false;
						};
					}
					else if(in_char) {
						if(c = '\\') {
							i += 1;
							cur_char += 1;
						}
						else if(c = '\'') {
							in_char := false;
						};
					}
					else {
						if(c = '#') {
							if(next_c = '~') {
								in_multi_comment := true;
								i += 1;
								cur_char += 1;
							}
							else {
								in_line_comment := true;
							};
						}
						else if(c = '"') {
							in_string := true;
						}
						else if(c = '\'') {
							in_char := true;
						}
						else if(c = '{') {
							if(brace_top < 256) {
								brace_stack_lines[brace_top] := cur_line;
								brace_stack_chars[brace_top] := cur_char;
								brace_top += 1;
							};
						}
						else if(c = '}') {
							if(brace_top > 0 & pair_count < 256) {
								brace_top -= 1;
								open_lines[pair_count] := brace_stack_lines[brace_top];
								open_chars[pair_count] := brace_stack_chars[brace_top];
								close_lines[pair_count] := cur_line;
								close_chars[pair_count] := cur_char;
								pair_count += 1;
							};
						};
					};

					cur_char += 1;
				};
			};

			# build response for each position
			result := JsonElement->New(JsonElement->JsonType->ARRAY);

			each(p : positions) {
				pos := positions->Get(p);
				pos_line := pos->FindElements("line")->GetInt();
				pos_char := pos->FindElements("character")->GetInt();

				# find containing blocks sorted by size (innermost first)
				# simple bubble sort by span size
				containing_indices := Int->New[pair_count];
				containing_count := 0;

				for(j := 0; j < pair_count; j += 1;) {
					if(pos_line > open_lines[j] | (pos_line = open_lines[j] & pos_char >= open_chars[j])) {
						if(pos_line < close_lines[j] | (pos_line = close_lines[j] & pos_char <= close_chars[j])) {
							containing_indices[containing_count] := j;
							containing_count += 1;
						};
					};
				};

				# sort by span size ascending (innermost first)
				for(a := 0; a < containing_count - 1; a += 1;) {
					for(b := a + 1; b < containing_count; b += 1;) {
						idx_a := containing_indices[a];
						idx_b := containing_indices[b];
						span_a := (close_lines[idx_a] - open_lines[idx_a]) * 10000 + (close_chars[idx_a] - open_chars[idx_a]);
						span_b := (close_lines[idx_b] - open_lines[idx_b]) * 10000 + (close_chars[idx_b] - open_chars[idx_b]);
						if(span_a > span_b) {
							tmp := containing_indices[a];
							containing_indices[a] := containing_indices[b];
							containing_indices[b] := tmp;
						};
					};
				};

				# build nested selection range from outermost to innermost
				# Assigned, not just declared (see ProcessBatch): with several
				# positions, each one's ranges were chained onto the previous one's.
				selection : JsonElement := Nil;

				for(k := containing_count - 1; k >= 0; k -= 1;) {
					idx := containing_indices[k];

					range_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					start_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					start_json->Insert("line", open_lines[idx]);
					start_json->Insert("character", open_chars[idx]);
					end_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					end_json->Insert("line", close_lines[idx]);
					end_json->Insert("character", close_chars[idx] + 1);
					range_json->Insert("start", start_json);
					range_json->Insert("end", end_json);

					node := JsonElement->New(JsonElement->JsonType->OBJECT);
					node->Insert("range", range_json);
					if(selection <> Nil) {
						node->Insert("parent", selection);
					};
					selection := node;
				};

				if(selection <> Nil) {
					result->Add(selection);
				}
				else {
					# fallback: whole document range
					doc_end := GetDocumentEnd();
					range_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					start_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					start_json->Insert("line", 0);
					start_json->Insert("character", 0);
					end_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					end_json->Insert("line", doc_end[0]);
					end_json->Insert("character", doc_end[1]);
					range_json->Insert("start", start_json);
					range_json->Insert("end", end_json);

					node := JsonElement->New(JsonElement->JsonType->OBJECT);
					node->Insert("range", range_json);
					result->Add(node);
				};
			};

			return result;
		}

		method : public : FormatRange(tab_spaces : Int, insert_spaces : Bool, start_range_line : Int, start_range_char : Int, end_range_line : Int, end_range_char : Int) ~  JsonElement {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> FormatRange: uri='{$@uri}', tab_spaces={$tab_spaces}, insert_spaces={$insert_spaces}, start=({$start_range_line},{$start_range_char}), end=({$end_range_line},{$end_range_char})");
			};

			# create formatter
			options := Map->New()<String, String>;
			options->Insert("function-space", "false");
			if(insert_spaces) {
				options->Insert("ident-space", tab_spaces->ToString());
			};
			options->Insert("start-line", (start_range_line + 1)->ToString());
			options->Insert("end-line", (end_range_line + 1)->ToString());

			formatter := CodeFormatter->New(options);
			# @text is already plain text, and the JSON serializer escapes on the way
			# out. This was PutText(formatter->Format(GetText(@text))), which escaped
			# the result a second time -- clients received a literal backslash-n for
			# every newline and the file collapsed onto one line -- and decoded the
			# source a second time, turning an escape inside a string literal into the
			# character it names (#1213).
			new_text := formatter->Format(@text);

			# format and upate json
			edits_builder := JsonBuilder->New();
			edits_builder->PushArray();
			
			edits_builder->PushObject();
			edits_builder->Insert("newText", new_text);

			edits_builder->PushObject("range");
			obj := edits_builder->PushObject("start");
			obj->Insert("line", start_range_line);
			if(new_text->StartsWith(' ') | new_text->StartsWith('\t')) {
				obj->Insert("character", start_range_char);
			}
			else {
				obj->Insert("character", 0);
			};
			
			edits_builder->Pop();

			obj := edits_builder->PushObject("end");
			obj->Insert("line", end_range_line);
			obj->Insert("character", end_range_char);

			edits_builder->Pop();
			edits_builder->Pop();
			edits_builder->Pop();
			
			return edits_builder->Pop();
		}

		method : public : FormatDocument(tab_spaces : Int, insert_spaces : Bool) ~  JsonElement {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("=> FormatDocument: uri='{$@uri}', tab_spaces={$tab_spaces}, insert_spaces={$insert_spaces}");
			};

			# get ranges
			end_ranges := GetDocumentEnd();

			end_line := end_ranges[0];
			end_index := end_ranges[1];

			# create formatter
			options := Map->New()<String, String>;
			options->Insert("function-space", "false");
			options->Insert("trim-trailing", "true");
			if(insert_spaces) {
				options->Insert("ident-space", tab_spaces->ToString());
			};
			formatter := CodeFormatter->New(options);
			# plain text in, plain text out: see FormatRange (#1213)
			new_text := formatter->Format(@text);
			
			# format and upate json
			edits_builder := JsonBuilder->New();
			edits_builder->PushArray();
			
			edits_builder->PushObject();
			edits_builder->Insert("newText", new_text);

			edits_builder->PushObject("range");
			obj := edits_builder->PushObject("start");
			obj->Insert("line", 0);
			obj->Insert("character", 0);
			edits_builder->Pop();

			obj := edits_builder->PushObject("end");
			obj->Insert("line", end_line);
			obj->Insert("character", end_index);

			return edits_builder->PopAll();
		}

		method : public : GetVariableMethodStrings(index : Int, var_str : String, mthd_str : String, offset : Bool := true) ~ Bool {
			start_pos := index;

			while(index >= 0 & (@text->Get(index)->IsChar() | @text->Get(index) = '_'  | @text->Get(index) = '@' | @text->Get(index) = '(' | @text->Get(index) = ')')) {
				index -= 1;
			};
			end_pos := index;

			length := start_pos - end_pos;
			if(offset) {
				length -= 2;
			};

			if(length > 0) {
				mthd_str += @text->SubString(end_pos + 1, length);
			};

			# Whitespace between the receiver's '->' and the name. This skipped
			# escape PAIRS ('\' 'n'), from when the text held JSON escapes; the text
			# is plain now, so it skips the characters themselves (#1216).
			while(index >= 0 & (@text->Get(index) = ' ' | @text->Get(index) = '\t' |
					@text->Get(index) = '\r' | @text->Get(index) = '\n')) {
				index -= 1;
			};

			has_var := index >= 1 & @text->Get(index) = '>' & @text->Get(index - 1) = '-';
			if(has_var) {
				index -= 2;
				
				start_pos := index;

				# variable
				if(@text->Get(index)->IsChar() | @text->Get(index) = '_' |  @text->Get(index) = '@') {
					while(index >= 0 & (@text->Get(index)->IsChar() | @text->Get(index) = '_' |  @text->Get(index) = '@')) {
						index -= 1;
					};
				}
				# character
				else if(@text->Get(index) = '\'') {
					index -= 1;
					while(index >= 1 & @text->Get(index) <> '\'' & @text->Get(index - 1) <> '\\') {
						index -= 1;
					};
					index -= 1;
				}
				# string
				else if(@text->Get(index) = '"') {
					index -= 1;
					while(index >= 1 & @text->Get(index) <> '"' & @text->Get(index - 1) <> '\\') {
						index -= 1;
					};
					index -= 1;
				};

				end_pos := index;

				length := start_pos - end_pos;
				if(length > 0) {
					var_str += @text->SubString(end_pos + 1, length);
				};
			};

			return <>(var_str->IsEmpty() & mthd_str->IsEmpty());
		}

		method : public : UpdateAll(text : String) ~ Nil {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("### UpdatAll: text='{$text}' ###");
			};

			@text := String->New(text);
			@workspace->Invalidate();
		}

		method : public : Update(text : String, start_line : Int, start_char: Int, end_line : Int, end_char : Int) ~ Nil {
			start := GetDocumentIndex(start_line, start_char);
			end :=  GetDocumentIndex(end_line, end_char);
			Update(start, end - start, text);
		}

		method : public : Update(range_length : Int, text : String, start_line : Int, start_char: Int) ~ Nil {
			start := GetDocumentIndex(start_line, start_char);
			Update(start, range_length, text);
		}

		method : Update(start : Int, range_length : Int, text : String) ~ Nil {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("### Update: start={$start}, range_length={$range_length}, text='{$text}'; ###");
			};

			if(start > -1) {
				if(range_length > 0) {
					@text->Delete(start, range_length);
				};
				@text->Insert(start, text);
				@workspace->Invalidate();
			};
		}

		method : public : Release() ~ Nil {
			@text := @alt_text := Nil;
		}

		method : public : GetText() ~ String {
			return @text;
		}

		method : public : GetAltText() ~ String {
			return @alt_text;
		}

		#
		# The text index of a position. As LSP asks, a character past the end of its
		# line means the end of that line, and a line past the end of the document
		# means the end of the document. This returned -1 past the last line, and
		# the edit was then dropped silently, leaving the server's copy different
		# from the editor's; and a character past the line ran on into the next one.
		#
		method : GetDocumentIndex(line_pos : Int, char_pos : Int) ~ Int {
			if(@text = Nil | line_pos < 0) {
				return 0;
			};

			# start of the line
			start := 0;
			cur_line := 0;
			while(cur_line < line_pos) {
				next := -1;
				for(i := start; i < @text->Size() & next < 0; i += 1;) {
					if(@text->Get(i) = '\n') {
						next := i;
					};
				};

				if(next < 0) {
					return @text->Size();
				};

				start := next + 1;
				cur_line += 1;
			};

			# clamped to the line's end (before its line ending, or the end of the text)
			index := start;
			while(index < @text->Size() & index - start < char_pos &
					@text->Get(index) <> '\n' & @text->Get(index) <> '\r') {
				index += 1;
			};

			return index;
		}

		method : GetDocumentEnd() ~ Int[] {
			indexes := Int->New[2];

			# The position just past the last character. The newline itself was
			# counted as a character of the line it starts, so a document ending in a
			# newline reported (lines, 1) -- one past the end of an empty last line.
			cur_line := 0; cur_char := 0;
			each(pos : @text) {
				if(@text->Get(pos) = '\n') {
					cur_line += 1;
					cur_char := 0;
				}
				else {
					cur_char += 1;
				};
			};
			indexes[0] := cur_line;
			indexes[1] := cur_char;

			return indexes;
		}

		method : DumpDocument() ~ Nil {
			if(@is_debug) {
				System.IO.Filesystem.Logger->Instance()->Info("TEXT='{$@text}'");
			};
		}
	}

	#~
	A document's lines, looked up while converting one message's columns
	~#
	class : private : TextLines {
		@lines : String[];

		New(lines : String[]) {
			@lines := lines;
		}

		# the line without its ending; "" past the end
		method : public : Get(line : Int) ~ String {
			if(line < 0 | line >= @lines->Size()) {
				return "";
			};

			text := @lines[line];
			if(text->EndsWith('\r')) {
				return text->SubString(text->Size() - 1);
			};
			return text;
		}
	}

	#~
	Reads messages ahead of the worker that handles them
	~#
	class : private : LspReader from System.Concurrency.Thread {
		@worker : LspWorker;

		New(worker : LspWorker) {
			Parent();
			@worker := worker;
		}

		# Only this thread reads; only the worker writes. Nil goes on the queue
		# when the stream closes, and the worker then ends the session.
		method : public : Run(param : Base) ~ Nil {
			while(true) {
				request := @worker->ReadRpcRequest();
				@worker->Enqueue(request);
				if(request = Nil | @worker->IsQuitting()) {
					return;
				};
			};
		}
	}

	#~
	Handles JSON-RPC requests
	~#
	class : private : RpcRequest {
		@id_json : JsonElement;
		@mthd : String;
		@params : JsonElement;
		@error : JsonElement;
		@is_response : Bool;
		@is_parse_error : Bool;

		# a request (id present) or a notification (id Nil)
		New(id_json : JsonElement, mthd : String, params : JsonElement) {
			@id_json := id_json;
			@mthd := mthd;
			@params := params;
		}

		# the client's reply to a request of ours
		New(id_json : JsonElement, error : JsonElement) {
			@id_json := id_json;
			@error := error;
			@is_response := true;
		}

		# not a JSON-RPC message: no method
		New(is_parse_error : Bool) {
			@is_parse_error := is_parse_error;
		}

		# -1 for a notification. A numeric id is passed through for logging; a
		# string id reads as 0 -- the reply uses GetIdJson, never this.
		method : public : GetId() ~ Int {
			if(@id_json = Nil) {
				return -1;
			};

			if(@id_json->GetType() = JsonElement->JsonType->NUMBER) {
				id := @id_json->GetInt();
				if(id > -1) {
					return id;
				};
			};

			return 0;
		}

		method : public : GetIdJson() ~ JsonElement {
			return @id_json;
		}

		method : public : IsNotification() ~ Bool {
			return @id_json = Nil;
		}

		method : public : IsResponse() ~ Bool {
			return @is_response;
		}

		method : public : IsParseError() ~ Bool {
			return @is_parse_error;
		}

		method : public : GetError() ~ JsonElement {
			return @error;
		}

		method : public : GetMethod() ~ String {
			return @mthd;
		}

		method : public : SetParams(params : JsonElement) ~ Nil {
			@params := params;
		}

		method : public : GetParams() ~ JsonElement {
			return @params;
		}
	}
}