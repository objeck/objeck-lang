use Collection;
use System.Diagnostics;
use Data.JSON;

bundle LSP {
	#~
	Wrapper for native parser and contextual analyzer
	~#
	class AstProxy {
		@analysis : Analysis;
		@doc_json_cache : static : Cache<String, JsonElement>;
		@klass_bundles_json : static : JsonElement;
		@klass_details_json : static : JsonElement;
		@doc_path : static : String;
		@is_debug : Bool;

		New(workspace : LspWorkspace, uri : String, use_alt : Bool, is_debug : Bool) {
			@is_debug := is_debug;

			if(workspace <> Nil) {
				@analysis := Analyzer->ParseText(workspace->GetTexts(uri, use_alt));
			};
		}
		
		function : Init(doc_path : String) ~ Nil {
			@doc_path := doc_path;
			@doc_json_cache := Cache->New(Cache->Type->LRU, 16)<String, JsonElement>;
			LoadDocsFile();
		}

		method : public : GetDiagnostics(was_parsed : BoolRef, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};
			diagnostics := JsonElement->New(JsonElement->JsonType->ARRAY);

			results := @analysis->GetDiagnostics(was_parsed, uri, sys_path);
			if(results <> Nil) {
				each(i : results) {
					result := results[i];

					if(result->GetDescription()->Equals(uri)) {
						diagnostic := JsonElement->New(JsonElement->JsonType->OBJECT);

						diagnostic->Insert("severity", result->GetKind()->As(Int) - 100);
						# Plain text: the serializer escapes on the way out, so a pre-encoded
						# message reached the client with a literal backslash-n in it (#1213).
						diagnostic->Insert("message", result->GetName());
						diagnostic->Insert("source", "objk-linter");

						range := JsonElement->New(JsonElement->JsonType->OBJECT);
						# start
						start := JsonElement->New(JsonElement->JsonType->OBJECT);
						start->Insert("line", result->GetStartLine() - 1);
						start->Insert("character", result->GetStartPosition() - 1);
						range->Insert("start", start);
						
						# end
						end := JsonElement->New(JsonElement->JsonType->OBJECT);
						end_line := result->GetEndLine();
						end_pos := result->GetEndPosition();
						if(end_line > 0 & end_pos > 0) {
							end->Insert("line", end_line - 1);
							end->Insert("character", end_pos);
						}
						else {
							end->Insert("line", result->GetStartLine() - 1);
							end->Insert("character", result->GetStartPosition() + 2);
						};
						range->Insert("end", end);

						diagnostic->Insert("range", range);
						
						diagnostics->Add(diagnostic);
					};
				};
			};
			
			request := JsonElement->New(JsonElement->JsonType->OBJECT);
			request->Insert("uri", uri);
			request->Insert("diagnostics", diagnostics);
			
			return request;
		}

		method : public : FindDefinition(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			definition := @analysis->FindDefinition(uri, line_pos, char_pos, sys_path);
			if(definition <> Nil) {
				builder := JsonBuilder->New();

					start_line := end_line := definition->GetStartLine();
					start_index := definition->GetStartPosition();
					end_index := definition->GetEndPosition();
					uri := definition->GetDescription();
					
					builder->PushObject();
					builder->Insert("uri", uri);

					builder->PushObject("range");
						obj := builder->PushObject("start");
						obj->Insert("line", start_line);
						obj->Insert("character", start_index);
						builder->Pop();

						obj := builder->PushObject("end");
						obj->Insert("line", end_line);
						obj->Insert("character", end_index);
						builder->Pop();
					builder->Pop();

				return builder->Pop();
			};

			return Nil;
		}
		
		method : public : FindDeclaration(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			reference := @analysis->FindDeclaration(uri, line_pos, char_pos, sys_path);
			if(reference <> Nil) {
				builder := JsonBuilder->New();

					start_line := end_line := reference->GetStartLine();
					start_index := reference->GetStartPosition();
					end_index := reference->GetEndPosition();
					
					builder->PushObject();
					builder->Insert("uri", uri);

					builder->PushObject("range");
						obj := builder->PushObject("start");
						obj->Insert("line", start_line);
						obj->Insert("character", start_index);
						builder->Pop();

						obj := builder->PushObject("end");
						obj->Insert("line", end_line);
						obj->Insert("character", end_index);
						builder->Pop();
					builder->Pop();

				return builder->Pop();
			};

			return Nil;
		}

		method : public : CodeRename(new_name : String, line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};
			
			references := @analysis->FindReferences(uri, line_pos, char_pos, sys_path);
			if(references <> Nil) {
				file_reference_map := MultiMap->New()<String, Result>;

				each(i : references) {
					reference := references[i];
					found_uri := reference->GetDescription();
					file_reference_map->Insert(found_uri, reference);
				};
				
				doc_changes_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);

				found_uris := file_reference_map->GetKeys()<String>;
				each(i : found_uris) {
					found_uri := found_uris->Get(i);

					edits_builder := JsonBuilder->New();
					edits_builder->PushArray();

					file_references := file_reference_map->Find(found_uri)<Result>;
					each(j : file_references) {
						file_reference := file_references->Get(j);

						start_line := end_line := file_reference->GetStartLine();
						start_index := file_reference->GetStartPosition();
						end_index := file_reference->GetEndPosition();
						
						edits_builder->PushObject();
						edits_builder->Insert("newText", new_name);

						edits_builder->PushObject("range");
						obj := edits_builder->PushObject("start");
						obj->Insert("line", start_line);
						obj->Insert("character", start_index);
						edits_builder->Pop();

						obj := edits_builder->PushObject("end");
						obj->Insert("line", end_line);
						obj->Insert("character", end_index);

						edits_builder->Pop();
						edits_builder->Pop();
						edits_builder->Pop();
					};

					edits_json := edits_builder->Pop();

					text_doc_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					text_doc_json->Insert("uri", found_uri);
					text_doc_json->Insert("version", Nil);

					doc_changes_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					doc_changes_json->Insert("textDocument", text_doc_json);
					doc_changes_json->Insert("edits", edits_json);

					doc_changes_array_json->Add(doc_changes_json);
				};

				apply_changes_json := JsonElement->New(JsonElement->JsonType->OBJECT);
				apply_changes_json->Insert("documentChanges", doc_changes_array_json);
				
				return apply_changes_json;
			};

			return Nil;
		}

		method : public : FindReferences(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			references := @analysis->FindReferences(uri, line_pos, char_pos, sys_path);
			if(references <> Nil) {
				array := JsonElement->New(JsonElement->JsonType->ARRAY);

				each(i : references) {
					reference := references[i];
					
					builder := JsonBuilder->New();

					start_line := end_line := reference->GetStartLine();
					start_index := reference->GetStartPosition();
					end_index := reference->GetEndPosition();
					found_uri := reference->GetDescription();
					
					builder->PushObject();
					builder->Insert("uri", found_uri);

					builder->PushObject("range");
						obj := builder->PushObject("start");
							obj->Insert("line", start_line);
							obj->Insert("character", start_index);
						builder->Pop();

						obj := builder->PushObject("end");
							obj->Insert("line", end_line);
							obj->Insert("character", end_index);
						builder->Pop();
					builder->Pop();

					array->Add(builder->Pop());
				};
				
				return array;
			};

			return Nil;
		}

		method : public : DocumentHighlight(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			# Analysis.DocumentHighlight handles URI filtering internally so the
			# caller only needs to wrap the matches into the LSP DocumentHighlight
			# JSON shape (range + kind).
			highlights := @analysis->DocumentHighlight(uri, line_pos, char_pos, sys_path);
			if(highlights = Nil) {
				return Nil;
			};

			array := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(i : highlights) {
				highlight := highlights[i];
				builder := JsonBuilder->New();

				start_line := end_line := highlight->GetStartLine();
				start_index := highlight->GetStartPosition();
				end_index := highlight->GetEndPosition();

				builder->PushObject();
				builder->Insert("kind", 1);

				builder->PushObject("range");
					obj := builder->PushObject("start");
						obj->Insert("line", start_line);
						obj->Insert("character", start_index);
					builder->Pop();

					obj := builder->PushObject("end");
						obj->Insert("line", end_line);
						obj->Insert("character", end_index);
					builder->Pop();
				builder->Pop();

				array->Add(builder->Pop());
			};

			return array;
		}

		method : public : Completion(line_pos : Int, char_pos : Int, var_str : String, mthd_str : String, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			root_completion := @analysis->Completion(uri, line_pos, char_pos, var_str, mthd_str, sys_path);
			if(root_completion <> Nil) {
				response := JsonElement->New(JsonElement->JsonType->ARRAY);	

				completions := root_completion->GetResults();
				each(i : completions) {
					completion := completions[i];

					code := completion->GetCode();
					keyword := completion->GetName();

					item := JsonElement->New(JsonElement->JsonType->OBJECT);
					item->Insert("label", keyword);
					item->Insert("kind", code);

					# A method says where it was asked for: completionItem/resolve looks
					# its signature and documentation up from this, for the one item
					# the user lands on. Every item used to carry "<name> details" and
					# "<name> documentation", which the editor showed as they were.
					if(code = 2 | code = 3) {
						data := JsonElement->New(JsonElement->JsonType->OBJECT);
						data->Insert("uri", uri);
						data->Insert("line", line_pos);
						data->Insert("character", char_pos);
						data->Insert("var", var_str);
						item->Insert("data", data);
					}
					else if(code = 14) {
						item->Insert("detail", "keyword");
					};
					response->Add(item);
				};
				
				return response;
			};

			return Nil;
		}

		#
		# The signature and documentation of one completion item, for
		# completionItem/resolve: 'detail' and 'documentation' to merge into it, or
		# Nil when the name isn't a method that resolves here (a variable, an enum
		# item, or text that has changed since).
		#
		# The signatures come from the same lookup signature help uses, which knows
		# the receiver's class; the class names the objk_apis.json entry.
		#
		method : public : ResolveCompletion(item_name : String, line_pos : Int, char_pos : Int, var_str : String, uri : String, sys_path : String, markdown : Bool) ~ JsonElement {
			if(@analysis = Nil | item_name = Nil | item_name->IsEmpty()) {
				return Nil;
			};

			root_signature := @analysis->SignatureHelp(uri, line_pos, char_pos, var_str, item_name, sys_path);
			if(root_signature = Nil) {
				return Nil;
			};

			signatures := root_signature->GetResults();
			if(signatures = Nil | signatures->Size() = 0) {
				return Nil;
			};

			first := signatures[0]->GetName();
			if(first = Nil) {
				return Nil;
			};

			result := JsonElement->New(JsonElement->JsonType->OBJECT);
			detail := String->New(first);
			if(signatures->Size() > 1) {
				others := signatures->Size() - 1;
				detail += " (+{$others} overload";
				if(others > 1) {
					detail += 's';
				};
				detail += ')';
			};
			result->Insert("detail", detail);

			# 'method : public : Collection.Vector->AddBack(H) ~ Nil' names the class
			doc_text : String;
			klass_name := SignatureClass(first);
			if(klass_name <> Nil) {
				docs_json := GetDocumentation(klass_name, item_name);
				if(docs_json <> Nil) {
					doc_text := JoinDocumentation(docs_json);
				};
			};

			# a method of the user's own code has no entry: list its signatures
			if(doc_text = Nil | doc_text->IsEmpty()) {
				doc_text := "```objeck\n";
				each(i : signatures) {
					name := signatures[i]->GetName();
					if(name <> Nil) {
						doc_text += name;
						doc_text += '\n';
					};
				};
				doc_text += "```";
			};
			result->Insert("documentation", MakeMarkup(doc_text, markdown));

			return result;
		}

		# 'method : public : System.$Int->Pow(Int) ~ Int' -> 'System.Int'
		function : SignatureClass(signature : String) ~ String {
			arrow := signature->Find("->");
			if(arrow < 1) {
				return Nil;
			};

			start := arrow;
			while(start > 0 & signature->Get(start - 1) <> ' ') {
				start -= 1;
			};

			klass_name := signature->SubString(start, arrow - start);
			# the primitive types' methods live on hidden classes ($Int, $Float, ...)
			return klass_name->ReplaceAll("$", "");
		}

		#
		# One string, or the descriptions of each overload. The index is read with
		# Data.JSON's parser, which keeps strings as they were written, escapes and
		# all, so each is decoded once here.
		#
		function : JoinDocumentation(docs_json : JsonElement) ~ String {
			if(docs_json->GetType() = JsonElement->JsonType->STRING) {
				return JsonElement->Decode(docs_json->GetString());
			};

			text := "";
			if(docs_json->GetType() = JsonElement->JsonType->ARRAY) {
				each(i : docs_json) {
					doc := JsonElement->Decode(docs_json->Get(i)->GetString());
					if(doc <> Nil & <>doc->IsEmpty()) {
						if(<>text->IsEmpty()) {
							text += "\n\n---\n\n";
						};
						text += doc;
					};
				};
			};

			return text;
		}

		#
		# MarkupContent. The documentation index is written for the HTML API pages,
		# so code in it carries '&lt;' and '&gt;': markdown shows those literally
		# inside code, where they are decoded here. Outside code a markdown renderer
		# decodes them itself, and a bare '<' there could be taken for a tag.
		#
		function : MakeMarkup(text : String, markdown : Bool) ~ JsonElement {
			markup := JsonElement->New(JsonElement->JsonType->OBJECT);
			markup->Insert("kind", markdown ? "markdown" : "plaintext");
			markup->Insert("value", DecodeCodeEntities(text, markdown));
			return markup;
		}

		function : DecodeCodeEntities(text : String, markdown : Bool) ~ String {
			if(text->Find('&') < 0) {
				return text;
			};

			# plain text has no markup to protect
			if(<>markdown) {
				return DecodeEntities(text);
			};

			out := "";
			segment := "";
			in_code := false;
			i := 0;
			while(i < text->Size()) {
				c := text->Get(i);
				if(c = '`') {
					# a run of backticks opens or closes code (inline or fenced)
					run := "";
					while(i < text->Size() & text->Get(i) = '`') {
						run += '`';
						i += 1;
					};
					out += in_code ? DecodeEntities(segment) : segment;
					out += run;
					segment := "";
					in_code := <>in_code;
				}
				else {
					segment += c;
					i += 1;
				};
			};
			out += in_code ? DecodeEntities(segment) : segment;

			return out;
		}

		function : DecodeEntities(text : String) ~ String {
			if(text->Find('&') < 0) {
				return text;
			};

			decoded := text->ReplaceAll("&lt;", "<");
			decoded := decoded->ReplaceAll("&gt;", ">");
			decoded := decoded->ReplaceAll("&quot;", "\"");
			return decoded->ReplaceAll("&amp;", "&");
		}

		method : public : Hover(line_pos : Int, char_pos : Int, var_str : String, mthd_str : String, uri : String, sys_path : String, markdown : Bool) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			root_signature := @analysis->Hover(uri, line_pos, char_pos, var_str, mthd_str, sys_path);
			if(root_signature <> Nil) {
				content : JsonElement;

				# class variable
				name := root_signature->GetName();
				desc := root_signature->GetDescription();

				if(name <> Nil) {
					if(desc = Nil) {
						select(root_signature->GetKind()) {
							label -3999 {
								content := GetDocumentation("System.Bool", Nil);
							}

							label -3998 {
								content := GetDocumentation("System.Byte", Nil);
							}

							label -3997 {
								content := GetDocumentation("System.Char", Nil);
							}

							label -3996 {
								content := GetDocumentation("System.Int", Nil);
							}

							label -3995 {
								content := GetDocumentation("System.Float", Nil);
							}

							other {
								content := GetDocumentation(name, Nil);
							}
						};
					}
					# method call
					else {
						select(root_signature->GetKind()) {
							label -3999 {
								content := GetDocumentation("System.Bool", root_signature->GetDescription());
							}

							label -3998 {
								content := GetDocumentation("System.Byte", root_signature->GetDescription());
							}

							label -3997 {
								content := GetDocumentation("System.Char", root_signature->GetDescription());
							}

							label -3996 {
								content := GetDocumentation("System.Int", root_signature->GetDescription());
							}

							label -3995 {
								content := GetDocumentation("System.Float",root_signature->GetDescription());
							}

							other {
								content := GetDocumentation(name, desc);
							}
						};
					};

					# MarkupContent. This answered with a bare string or a string array,
					# the MarkedString form LSP deprecated in 3.0.
					text : String;
					if(content <> Nil) {
						text := JoinDocumentation(content);
					};

					# Fallback for user-defined classes (no entry in objk_apis.json):
					# a minimal hover from the name (type) and desc (method).
					if(text = Nil | text->IsEmpty()) {
						text := "```objeck\n";
						text += name;
						if(desc <> Nil) {
							text += "->";
							text += desc;
						};
						text += "\n```";
					};

					content_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					content_json->Insert("contents", MakeMarkup(text, markdown));
					return content_json;
				};
			};

			return Nil;
		}

		method : public : GetDocumentation(klass_name : String, method_name : String) ~ JsonElement {
			klass_detail_json := @doc_json_cache->Find(klass_name);
			if(klass_detail_json <> Nil) {
				if(method_name = Nil) {
					return klass_detail_json->Get("description");
				}
				else {
					key := String->New("functions/");
					key += String->New(method_name);
					key += "/descriptions";
					return klass_detail_json->FindElements(key);
				};
			}
			else {
				klass_detail_json := @klass_details_json->Get(klass_name);
				if(klass_detail_json <> Nil) {
					@doc_json_cache->Insert(klass_name, klass_detail_json);

					if(method_name = Nil) {
						return klass_detail_json->Get("description");
					}
					else {
						key := String->New("functions/");
						key += String->New(method_name);
						key += "/descriptions";
						return klass_detail_json->FindElements(key);
					};
				};
			};

			return Nil;
		}

		function : LoadDocsFile() ~ Nil {
			parser := JsonParser->New(System.IO.Filesystem.FileReader->ReadFile(@doc_path));
			if(parser->Parse()) {
				@klass_details_json := parser->GetRoot()->Get("class-details");
				@klass_bundles_json := parser->GetRoot()->Get("class-bundle-names");

				if(@klass_details_json = Nil | @klass_bundles_json = Nil) {
					"### Unable to process JSON configuration file: {$@doc_path}"->ErrorLine();
					Runtime->Exit(1);
				};
			}
			else {
				"### Unable to process JSON configuration file: {$@doc_path}"->ErrorLine();
				Runtime->Exit(1);
			};
		}

		method : public : CodeAction(uri : String, start_range_line : Int, start_range_char : Int, var_name : String, build_file : String, position_is_class : Bool)  ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			result_json := JsonElement->New(JsonElement->JsonType->ARRAY);

			code_action := @analysis->CodeAction(uri, start_range_line, start_range_char, var_name);
			
			#
			# What the fixes are built from, whichever way it was established.
			#
			# The analysis matches a symbol-table entry whose TYPE is the class, which
			# covers a declared local and yields the position of the class in its type.
			# An inferred-type local has no entry at all at this point -- it is created
			# during type inference, and analysis aborted on this very undefined class
			# -- so that lookup returns nothing for `v := Vector->New()`, which is the
			# dominant style in this codebase (#1057).
			#
			# For that shape the caller has already confirmed the diagnostic is
			# anchored on the class token, so the diagnostic range IS where the
			# qualifier belongs. Without that confirmation nothing is offered: half of
			# these diagnostics point at a variable, a parameter or a method name, and
			# inserting "Bundle." there would leave the program still not compiling.
			#
			fix_class_name : String;
			fix_var_name : String;
			fix_line := 0;
			fix_char := 0;
			has_fix := false;
			
			if(code_action <> Nil) {
				fix_class_name := code_action->GetName();
				fix_var_name := code_action->GetDescription();
				fix_line := code_action->GetStartLine();
				fix_char := code_action->GetStartPosition();
				has_fix := true;
			}
			else if(position_is_class) {
				# The class names itself here: there is no declared variable to name, so
				# the qualify title reads "Fully qualify 'Vector' as Collection.Vector".
				fix_class_name := var_name;
				fix_var_name := var_name;
				fix_line := start_range_line;
				fix_char := start_range_char;
				has_fix := true;
			};
			
			if(has_fix & @klass_bundles_json <> Nil) {
				class_name := fix_class_name;
				# An ARRAY now, one entry per bundle that defines this short name.
				# Twenty-two names are defined in more than one -- EndPoint in four of
				# them -- and this index used to carry a single entry per name, because
				# the generator emitted duplicate JSON keys and a parser keeps one. So
				# the fixes below used whichever bundle happened to be read last: for
				# 'Client' that was Data.JSON.RPC rather than API.Inference, and the
				# build file this writes named json_rpc.obl. An applied edit that left
				# the program still not compiling, not merely a bad suggestion (#1052).
				#
				# Every candidate now gets its own quick fix, which is what code actions
				# are for: the editor lists them and the user picks. Their titles name
				# the bundle, or several fixes would read identically.
				candidates_json := @klass_bundles_json->Get(class_name);

				# An index generated before #1052 holds a single object here rather
				# than an array. Iterating that produces nothing, which would be the
				# same silent failure this change exists to remove -- and the index
				# is a separate file from the server, so a stale one is a real
				# pairing. Wrap it instead: the old single-candidate behaviour, which
				# is wrong for a colliding name but not silent.
				if(candidates_json <> Nil &
						candidates_json->GetType() <> JsonElement->JsonType->ARRAY) {
					"### objk_apis.json predates #1052: 'class-bundle-names' holds one entry per name rather than a list, so only one bundle can be offered for '{$class_name}'. Regenerate it with tools/lsp/server/doc_json/gen_json.sh ###"->ErrorLine();

					wrapped_json := JsonElement->New(JsonElement->JsonType->ARRAY);
					wrapped_json->Add(candidates_json);
					candidates_json := wrapped_json;
				};

				if(candidates_json <> Nil) {
					each(candidate_index : candidates_json->Size()) {
						class_bundle_json := candidates_json->Get(candidate_index);
						#
						# build file exists
						#
						use_code_action_json := JsonElement->New(JsonElement->JsonType->OBJECT);
						if(System.IO.Filesystem.File->Exists(build_file)) {
							#
							# add use statement
							#
							# hoisted above the titles, which name the bundle so several candidates are distinguishable
							bundle_name := class_bundle_json->Get("bundle")->GetString();
							use_code_action_json->Insert("title", "Add 'use {$bundle_name};' to resolve '{$class_name}'");
							use_code_action_json->Insert("kind", "quickfix");
										
							doc_changes_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);

							new_name : String;
							if(@analysis->HasUses()) {
								new_name := "use {$bundle_name};\n";
							}
							else {
								new_name := "use {$bundle_name};\n\n";
							};
						
							text_doc_edit_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);
							text_doc_edit_array_json->Add(MakeTextEdit(new_name, 0, 0, 0, 0, uri));

							doc_changes_json := JsonElement->New(JsonElement->JsonType->OBJECT);
							doc_changes_json->Insert("documentChanges", text_doc_edit_array_json);

							doc_changes_array_json->Add(doc_changes_json);
						
							use_code_action_json->Insert("edit", doc_changes_json);
							result_json->Add(use_code_action_json);

							#
							# variable qualification
							#
							var_name := fix_var_name;
							qualify_code_action_json := JsonElement->New(JsonElement->JsonType->OBJECT);
							qualify_code_action_json->Insert("title", "Fully qualify '{$var_name}' as {$bundle_name}.{$class_name}");
							qualify_code_action_json->Insert("kind", "quickfix");

							edit_start_line := fix_line;
							edit_start_pos := fix_char;

							bundle_name := class_bundle_json->Get("bundle")->GetString();						
							create_doc_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);
							create_doc_array_json->Add(MakeTextEdit("{$bundle_name}.", edit_start_line, edit_start_pos, edit_start_line, edit_start_pos, uri));

							doc_changes_json := JsonElement->New(JsonElement->JsonType->OBJECT);
							doc_changes_json->Insert("documentChanges", create_doc_array_json);
							qualify_code_action_json->Insert("edit", doc_changes_json);

							result_json->Add(qualify_code_action_json);
						}
						#
						# no build file
						#
						else {
							src_file_name_index := uri->FindLast('/');
							if(src_file_name_index > -1) {
								#
								# add use statement
								#
								src_file_name_index += 1;
								src_file_name := uri->SubString(src_file_name_index, uri->Size() - src_file_name_index);

								# hoisted above the titles, which name the bundle so several candidates are distinguishable
								bundle_name := class_bundle_json->Get("bundle")->GetString();
								use_code_action_json->Insert("title", "Create build file and add 'use {$bundle_name};' to resolve '{$class_name}'");
								use_code_action_json->Insert("kind", "quickfix");

								# create build file
								create_uri := "file:///" + build_file->ToLower();
								if(System.IO.Filesystem.Directory->GetSlash() <> '/') {
									create_uri := create_uri->ReplaceAll('\\', '/');
								};

								create_doc_json := JsonElement->New(JsonElement->JsonType->OBJECT);
								create_doc_json->Insert("kind", "create");
								create_doc_json->Insert("uri", create_uri);

								# apply changes to the file
								files_json := JsonElement->New(JsonElement->JsonType->ARRAY);
								files_json->Add(src_file_name);

								lib_file_name := class_bundle_json->Get("file")->GetString();
								libs_json := JsonElement->New(JsonElement->JsonType->ARRAY);
								libs_json->Add("gen_collect.obl");
								libs_json->Add("net.obl");
								libs_json->Add("json.obl");
								libs_json->Add("cipher.obl");
								libs_json->Add("misc.obl");
								libs_json->Add(lib_file_name);

								build_file_json := JsonElement->New(JsonElement->JsonType->OBJECT);
								build_file_json->Insert("files", files_json);
								build_file_json->Insert("libs", libs_json);
								build_file_json->Insert("flags", "");
								build_file_text := build_file_json->ToFormattedString();

								# add changes
								create_doc_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);
								create_doc_array_json->Add(create_doc_json);
								create_doc_array_json->Add(MakeTextEdit(build_file_text, 0, 0, 0, 0, create_uri));

								new_name : String;
								if(@analysis->HasUses()) {
									new_name := "use {$bundle_name};\n";
								}
								else {
									new_name := "use {$bundle_name};\n\n";
								};
								create_doc_array_json->Add(MakeTextEdit(new_name, 0, 0, 0, 0, uri));
								doc_changes_json := JsonElement->New(JsonElement->JsonType->OBJECT);
								doc_changes_json->Insert("documentChanges", create_doc_array_json);
								use_code_action_json->Insert("edit", doc_changes_json);
								result_json->Add(use_code_action_json);

								#
								# variable qualification
								#
								var_name := fix_var_name;
								qualify_code_action_json := JsonElement->New(JsonElement->JsonType->OBJECT);
								qualify_code_action_json->Insert("title", "Fully qualify '{$var_name}' as {$bundle_name}.{$class_name}");
								qualify_code_action_json->Insert("kind", "quickfix");

								edit_start_line := fix_line;
								edit_start_pos := fix_char;
							
								create_doc_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);
								create_doc_array_json->Add(create_doc_json);
								create_doc_array_json->Add(MakeTextEdit(build_file_text, 0, 0, 0, 0, create_uri));
								create_doc_array_json->Add(MakeTextEdit("{$bundle_name}.", edit_start_line, edit_start_pos, edit_start_line, edit_start_pos, uri));

								doc_changes_json := JsonElement->New(JsonElement->JsonType->OBJECT);
								doc_changes_json->Insert("documentChanges", create_doc_array_json);
								qualify_code_action_json->Insert("edit", doc_changes_json);

								result_json->Add(qualify_code_action_json);
							};
						};
					};
				};
			};
			
			return result_json;
		}

		method : public : MakeTextEdit(text : String, start_line : Int, start_index : Int, end_line : Int, end_index : Int, uri : String) ~ JsonElement {
			edits_builder := JsonBuilder->New();
			edits_builder->PushArray();
			
			edits_builder->PushObject();
			edits_builder->Insert("newText", text);

			edits_builder->PushObject("range");
			range_json := edits_builder->PushObject("start");
			range_json->Insert("line", start_line);
			range_json->Insert("character", start_index);
			edits_builder->Pop();

			range_json := edits_builder->PushObject("end");
			range_json->Insert("line", end_line);
			range_json->Insert("character", end_index);

			edits_builder->Pop();
			edits_builder->Pop();
			edits_builder->Pop();

			text_doc_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			text_doc_json->Insert("uri", uri);
			text_doc_json->Insert("version", Nil);

			text_doc_edit_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			text_doc_edit_json->Insert("textDocument", text_doc_json);
			text_doc_edit_json->Insert("edits", edits_builder->Pop());

			return text_doc_edit_json;
		}
		
		method : public : SignatureHelp(line_pos : Int, char_pos : Int, var_str : String, mthd_str : String, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			root_signature := @analysis->SignatureHelp(uri, line_pos, char_pos, var_str, mthd_str, sys_path);
			if(root_signature <> Nil) {
				root_json := JsonElement->New(JsonElement->JsonType->OBJECT);

				signatures_json := JsonElement->New(JsonElement->JsonType->ARRAY);

				children := root_signature->GetResults();
				each(i : children) {
					signature := children[i];
					signature_json := JsonElement->New(JsonElement->JsonType->OBJECT);
					signature_json->Insert("label", signature->GetName());
					signatures_json->Add(signature_json);

					params := signature->GetResults();
					if(params <> Nil) {
						signatures_params := JsonElement->New(JsonElement->JsonType->ARRAY);
						each(j : params) {
							param := params[j];
							signature_param := JsonElement->New(JsonElement->JsonType->OBJECT);
							signature_param->Insert("label", param->GetName());
							signatures_params->Add(signature_param);
						};
						signature_json->Insert("parameters", signatures_params);
					};
				};

				root_json->Insert("signatures", signatures_json);
				return root_json;
			};
			
			return Nil;
		}

		method : public : GetSymbol(query : String, uris : Vector<String>, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			# Analysis.WorkspaceSymbols walks every bundle in the parsed program
			# and returns case-insensitive substring matches against the query.
			# This consolidates the previous per-URI tree walk (which was both
			# redundant — GetSymbols caches the same tree across URIs — and
			# limited to exact-match-only filtering).
			matches := @analysis->WorkspaceSymbols(query, sys_path);
			if(matches = Nil) {
				return Nil;
			};

			# Build a lookup of currently-open URIs so we restrict workspace symbol
			# results to files the editor knows about. Without this we would also
			# surface stdlib symbols (String, Vector, etc.) which is noisy.
			open_uris := HashSet->New()<String>;
			each(open_uri := uris) {
				open_uris->Add(open_uri);
			};

			array := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(i : matches) {
				symbol := matches[i];
				symbol_uri := symbol->GetDescription();
				if(symbol_uri <> Nil & open_uris->Has(symbol_uri)) {
					BuildSymbolJson(symbol, symbol_uri, array);
				};
			};

			return array;
		}

		method : BuildSymbolJson(symbol : Result, uri : String, array : JsonElement) ~ Nil {
			builder := JsonBuilder->New();

			start_line := symbol->GetStartLine();
			start_index := symbol->GetStartPosition();
			end_line := symbol->GetEndLine();
			end_index := symbol->GetEndPosition();

			obj := builder->PushObject();
			obj->Insert("kind", symbol->GetKind()->As(Int) - 200);
			obj->Insert("name", symbol->GetName());

				builder->PushObject("location");
					builder->Insert("uri", uri);

					builder->PushObject("range");
						obj := builder->PushObject("start");
						obj->Insert("line", start_line);
						obj->Insert("character", start_index);
						builder->Pop();

						obj := builder->PushObject("end");
						obj->Insert("line", end_line);
						obj->Insert("character", end_index);
						builder->Pop();
					builder->Pop();

			array->Add(builder->PopAll());
		}

		method : public : GetSymbols(uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			symbol := @analysis->GetSymbols(uri, sys_path);
			if(symbol <> Nil) {
				array := JsonElement->New(JsonElement->JsonType->ARRAY);

				children := symbol->GetResults();
				if(children <> Nil) {
					each(i : children) {
						GetSymbols(children[i], uri, array);
					};
				};

				return array;
			};

			return Nil;
		}

		#
		# DocumentSymbol[]: the outline as a tree -- bundle, then class, then
		# method -- for a client that declares hierarchicalDocumentSymbolSupport.
		# The native walk already returns the tree; it was flattened to
		# SymbolInformation[], so editors had no outline nesting or breadcrumbs.
		#
		# VS Code rejects the whole answer when a selectionRange falls outside its
		# range, so the ranges are normalised against the text: each runs to the
		# end of its last line, covers its children, and selects the name.
		#
		method : public : GetDocumentSymbols(uri : String, sys_path : String, text : String) ~ JsonElement {
			if(@analysis = Nil | text = Nil) {
				return Nil;
			};

			symbol := @analysis->GetSymbols(uri, sys_path);
			if(symbol = Nil) {
				return Nil;
			};

			lines := text->Split('\n');
			if(lines->Size() = 0) {
				lines := String->New[1];
				lines[0] := "";
			};

			nodes := Vector->New()<SymbolNode>;
			CollectSymbols(symbol->GetResults(), uri, lines, nodes);
			nodes := Nest(nodes);

			array := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(i : nodes) {
				array->Add(nodes->Get(i)->ToJson());
			};
			return array;
		}

		# This file's symbols at this level; a symbol of another file passes its
		# own children of this file up a level.
		method : CollectSymbols(results : Result[], uri : String, lines : String[], nodes : Vector<SymbolNode>) ~ Nil {
			if(results = Nil) {
				return;
			};

			each(i : results) {
				result := results[i];
				# a lambda's synthetic class ('json_rpc_55_48#') isn't in the source
				if(result <> Nil & result->GetName() <> Nil & result->GetName()->Find('#') < 0) {
					children := Vector->New()<SymbolNode>;
					CollectSymbols(result->GetResults(), uri, lines, children);

					desc := result->GetDescription();
					if(desc = Nil | desc->Equals(uri)) {
						node := SymbolNode->New(result->GetName(), result->GetKind()->As(Int) - 200,
							result->GetStartLine(), result->GetStartPosition(), result->GetEndLine(), lines);
						each(j : children) {
							node->AddChild(children->Get(j));
						};
						nodes->AddBack(node);
					}
					else {
						each(j : children) {
							nodes->AddBack(children->Get(j));
						};
					};
				};
			};
		}

		#
		# A symbol whose range lies inside a sibling's goes under it, where Objeck
		# can declare one inside the other: an enum
		# declared in a class is reported beside the class by the native walk.
		#
		function : Nest(source_nodes : Vector<SymbolNode>) ~ Vector<SymbolNode> {
			SortByStart(source_nodes);

			# A method with default parameters is compiled into one overload per
			# arity, all at the same place in the source: one symbol, as written.
			nodes := Vector->New()<SymbolNode>;
			each(i : source_nodes) {
				node := source_nodes->Get(i);
				if(nodes->Size() > 0 & nodes->Last()->SameDeclaration(node)) {
					nodes->Last()->Absorb(node);
				}
				else {
					nodes->AddBack(node);
				};
			};

			# Two symbols that overlap without one holding the other: the first
			# ran past the next declaration, as the native end of a class or an
			# enum does, so it ends where that one starts. Cut first, or a symbol
			# is nested in a range that no longer holds it.
			for(i := 0; i < nodes->Size(); i += 1;) {
				for(j := i + 1; j < nodes->Size(); j += 1;) {
					if(<>nodes->Get(i)->Holds(nodes->Get(j))) {
						nodes->Get(i)->EndBefore(nodes->Get(j));
					};
				};
			};

			nested := Vector->New()<SymbolNode>;
			each(i : nodes) {
				node := nodes->Get(i);
				# assigned, not just declared: a local declared in a loop body keeps
				# the value it had at the end of the previous pass
				parent : SymbolNode := Nil;
				each(j : nodes) {
					candidate := nodes->Get(j);
					if(i <> j & candidate->Holds(node) & (parent = Nil | parent->Contains(candidate))) {
						# the innermost container, and only one of two equal ranges
						if(<>node->Contains(candidate) | j < i) {
							parent := candidate;
						};
					};
				};

				if(parent <> Nil) {
					parent->AddChild(node);
				}
				else {
					nested->AddBack(node);
				};
			};

			each(i : nested) {
				nested->Get(i)->NestChildren();
			};
			return nested;
		}

		# in source order
		function : SortByStart(nodes : Vector<SymbolNode>) ~ Nil {
			for(i := 1; i < nodes->Size(); i += 1;) {
				j := i;
				while(j > 0 & nodes->Get(j)->StartsBefore(nodes->Get(j - 1))) {
					swap := nodes->Get(j);
					nodes->Set(nodes->Get(j - 1), j);
					nodes->Set(swap, j - 1);
					j -= 1;
				};
			};
		}

		method : GetSymbols(symbol : Result, uri : String, array : JsonElement) ~ Nil {
			# An empty slot in a native result array must not take the server down;
			# a Nil child here killed the process (#1214).
			if(symbol = Nil) {
				return;
			};

			builder := JsonBuilder->New();
			
			start_line := symbol->GetStartLine();
			start_index := symbol->GetStartPosition();	

			end_line := symbol->GetEndLine();			
			end_index := symbol->GetEndPosition();

			desc := symbol->GetDescription();

			if(desc = Nil | desc->Equals(uri)) {			
				obj := builder->PushObject();
				obj->Insert("kind", symbol->GetKind()->As(Int) - 200);
				obj->Insert("name", symbol->GetName());

					builder->PushObject("location");
						builder->Insert("uri", uri);

						builder->PushObject("range");
							obj := builder->PushObject("start");
							obj->Insert("line", start_line);
							obj->Insert("character", start_index);
							builder->Pop();

							obj := builder->PushObject("end");
							obj->Insert("line", end_line);
							obj->Insert("character", end_index);
							builder->Pop();
						builder->Pop();

				array->Add(builder->PopAll());
			};
			
			children := symbol->GetResults();
			if(children <> Nil) {
				each(i : children) {
					GetSymbols(children[i], uri, array);
				};
			};
		}

		method : public : FindTypeDefinition(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			definition := @analysis->FindTypeDefinition(uri, line_pos, char_pos, sys_path);
			if(definition <> Nil) {
				builder := JsonBuilder->New();

				start_line := end_line := definition->GetStartLine();
				start_index := definition->GetStartPosition();
				end_index := definition->GetEndPosition();
				def_uri := definition->GetDescription();

				builder->PushObject();
				builder->Insert("uri", def_uri);

				builder->PushObject("range");
					obj := builder->PushObject("start");
					obj->Insert("line", start_line);
					obj->Insert("character", start_index);
					builder->Pop();

					obj := builder->PushObject("end");
					obj->Insert("line", end_line);
					obj->Insert("character", end_index);
					builder->Pop();
				builder->Pop();

				return builder->Pop();
			};

			return Nil;
		}

		method : public : FindImplementation(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			implementations := @analysis->FindImplementation(uri, line_pos, char_pos, sys_path);
			if(implementations <> Nil) {
				array := JsonElement->New(JsonElement->JsonType->ARRAY);

				each(i : implementations) {
					impl := implementations[i];

					builder := JsonBuilder->New();

					start_line := end_line := impl->GetStartLine();
					start_index := impl->GetStartPosition();
					end_index := impl->GetEndPosition();
					impl_uri := impl->GetDescription();

					builder->PushObject();
					builder->Insert("uri", impl_uri);

					builder->PushObject("range");
						obj := builder->PushObject("start");
							obj->Insert("line", start_line);
							obj->Insert("character", start_index);
						builder->Pop();

						obj := builder->PushObject("end");
							obj->Insert("line", end_line);
							obj->Insert("character", end_index);
						builder->Pop();
					builder->Pop();

					array->Add(builder->Pop());
				};

				return array;
			};

			return Nil;
		}

		method : public : PrepareTypeHierarchy(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			# Analysis.PrepareTypeHierarchy delegates to FindDefinition, which
			# returns a single Result for the class at (or enclosing) the cursor.
			# LSP expects an *array* of TypeHierarchyItem so we wrap the single
			# match in an array.
			item := @analysis->PrepareTypeHierarchy(uri, line_pos, char_pos, sys_path);
			if(item = Nil) {
				return Nil;
			};

			array := JsonElement->New(JsonElement->JsonType->ARRAY);
			array->Add(BuildTypeHierarchyItem(item));
			return array;
		}

		method : public : TypeHierarchySupertypes(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			supers := @analysis->TypeHierarchySupertypes(uri, line_pos, char_pos, sys_path);
			if(supers = Nil) {
				return Nil;
			};

			array := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(i : supers) {
				array->Add(BuildTypeHierarchyItem(supers[i]));
			};
			return array;
		}

		method : public : TypeHierarchySubtypes(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			subs := @analysis->TypeHierarchySubtypes(uri, line_pos, char_pos, sys_path);
			if(subs = Nil) {
				return Nil;
			};

			array := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(i : subs) {
				array->Add(BuildTypeHierarchyItem(subs[i]));
			};
			return array;
		}

		# Helper: convert a Result into an LSP TypeHierarchyItem. Kind=5 (Class)
		# is fixed since Objeck's type hierarchy operates on classes only.
		method : BuildTypeHierarchyItem(item : Result) ~ JsonElement {
			builder := JsonBuilder->New();

			builder->PushObject();
			builder->Insert("name", item->GetName());
			builder->Insert("kind", 5);
			builder->Insert("uri", item->GetDescription());

			builder->PushObject("range");
				obj := builder->PushObject("start");
				obj->Insert("line", item->GetStartLine());
				obj->Insert("character", item->GetStartPosition());
				builder->Pop();

				obj := builder->PushObject("end");
				obj->Insert("line", item->GetEndLine());
				obj->Insert("character", item->GetEndPosition());
				builder->Pop();
			builder->Pop();

			builder->PushObject("selectionRange");
				obj := builder->PushObject("start");
				obj->Insert("line", item->GetStartLine());
				obj->Insert("character", item->GetStartPosition());
				builder->Pop();

				obj := builder->PushObject("end");
				obj->Insert("line", item->GetStartLine());
				obj->Insert("character", item->GetStartPosition() + item->GetName()->Size());
				builder->Pop();
			builder->Pop();

			return builder->Pop();
		}

		method : public : PrepareCallHierarchy(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			item := @analysis->PrepareCallHierarchy(uri, line_pos, char_pos, sys_path);
			if(item <> Nil) {
				builder := JsonBuilder->New();

				builder->PushObject();
				builder->Insert("name", item->GetName());
				builder->Insert("kind", 6);
				builder->Insert("uri", item->GetDescription());

				builder->PushObject("range");
					obj := builder->PushObject("start");
					obj->Insert("line", item->GetStartLine());
					obj->Insert("character", item->GetStartPosition());
					builder->Pop();

					obj := builder->PushObject("end");
					obj->Insert("line", item->GetEndLine());
					obj->Insert("character", item->GetEndPosition());
					builder->Pop();
				builder->Pop();

				builder->PushObject("selectionRange");
					obj := builder->PushObject("start");
					obj->Insert("line", item->GetStartLine());
					obj->Insert("character", item->GetStartPosition());
					builder->Pop();

					obj := builder->PushObject("end");
					obj->Insert("line", item->GetStartLine());
					obj->Insert("character", item->GetStartPosition() + item->GetName()->Size());
					builder->Pop();
				builder->Pop();

				return builder->Pop();
			};

			return Nil;
		}

		method : public : IncomingCalls(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			callers := @analysis->IncomingCalls(uri, line_pos, char_pos, sys_path);
			if(callers <> Nil) {
				array := JsonElement->New(JsonElement->JsonType->ARRAY);

				each(i : callers) {
					caller := callers[i];
					builder := JsonBuilder->New();

					builder->PushObject();

					# from - the calling method as a CallHierarchyItem
					from_builder := builder->PushObject("from");
					from_builder->Insert("name", caller->GetName());
					from_builder->Insert("kind", 6);
					from_builder->Insert("uri", caller->GetDescription());

					builder->PushObject("range");
						obj := builder->PushObject("start");
						obj->Insert("line", caller->GetStartLine());
						obj->Insert("character", caller->GetStartPosition());
						builder->Pop();
						obj := builder->PushObject("end");
						obj->Insert("line", caller->GetEndLine());
						obj->Insert("character", caller->GetEndPosition());
						builder->Pop();
					builder->Pop();

					builder->PushObject("selectionRange");
						obj := builder->PushObject("start");
						obj->Insert("line", caller->GetStartLine());
						obj->Insert("character", caller->GetStartPosition());
						builder->Pop();
						obj := builder->PushObject("end");
						obj->Insert("line", caller->GetStartLine());
						obj->Insert("character", caller->GetStartPosition() + caller->GetName()->Size());
						builder->Pop();
					builder->Pop();

					builder->Pop();

					# fromRanges
					from_ranges := JsonElement->New(JsonElement->JsonType->ARRAY);
					range_builder := JsonBuilder->New();
					range_builder->PushObject();
					obj := range_builder->PushObject("start");
					obj->Insert("line", caller->GetStartLine());
					obj->Insert("character", caller->GetStartPosition());
					range_builder->Pop();
					obj := range_builder->PushObject("end");
					obj->Insert("line", caller->GetStartLine());
					obj->Insert("character", caller->GetStartPosition() + caller->GetName()->Size());
					range_builder->Pop();
					from_ranges->Add(range_builder->Pop());
					builder->Insert("fromRanges", from_ranges);

					array->Add(builder->Pop());
				};

				return array;
			};

			return Nil;
		}

		method : public : OutgoingCalls(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			callees := @analysis->OutgoingCalls(uri, line_pos, char_pos, sys_path);
			if(callees <> Nil) {
				array := JsonElement->New(JsonElement->JsonType->ARRAY);

				each(i : callees) {
					callee := callees[i];
					builder := JsonBuilder->New();

					builder->PushObject();

					# to - the called method as a CallHierarchyItem
					to_builder := builder->PushObject("to");
					to_builder->Insert("name", callee->GetName());
					to_builder->Insert("kind", 6);
					to_builder->Insert("uri", callee->GetDescription());

					builder->PushObject("range");
						obj := builder->PushObject("start");
						obj->Insert("line", callee->GetStartLine());
						obj->Insert("character", callee->GetStartPosition());
						builder->Pop();
						obj := builder->PushObject("end");
						obj->Insert("line", callee->GetEndLine());
						obj->Insert("character", callee->GetEndPosition());
						builder->Pop();
					builder->Pop();

					builder->PushObject("selectionRange");
						obj := builder->PushObject("start");
						obj->Insert("line", callee->GetStartLine());
						obj->Insert("character", callee->GetStartPosition());
						builder->Pop();
						obj := builder->PushObject("end");
						obj->Insert("line", callee->GetStartLine());
						obj->Insert("character", callee->GetStartPosition() + callee->GetName()->Size());
						builder->Pop();
					builder->Pop();

					builder->Pop();

					# fromRanges
					from_ranges := JsonElement->New(JsonElement->JsonType->ARRAY);
					range_builder := JsonBuilder->New();
					range_builder->PushObject();
					obj := range_builder->PushObject("start");
					obj->Insert("line", callee->GetStartLine());
					obj->Insert("character", callee->GetStartPosition());
					range_builder->Pop();
					obj := range_builder->PushObject("end");
					obj->Insert("line", callee->GetStartLine());
					obj->Insert("character", callee->GetStartPosition() + callee->GetName()->Size());
					range_builder->Pop();
					from_ranges->Add(range_builder->Pop());
					builder->Insert("fromRanges", from_ranges);

					array->Add(builder->Pop());
				};

				return array;
			};

			return Nil;
		}

		method : public : InlayHints(line_pos : Int, char_pos : Int, uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			hints := @analysis->InlayHints(uri, line_pos, char_pos, sys_path);
			if(hints <> Nil) {
				array := JsonElement->New(JsonElement->JsonType->ARRAY);

				each(i : hints) {
					hint := hints[i];
					builder := JsonBuilder->New();

					builder->PushObject();
					builder->Insert("label", hint->GetName());
					builder->Insert("kind", hint->GetKind()->As(Int));

					# A Position, not a Range. This copied the range idiom used elsewhere in
					# this file and wrapped the coordinates in a "start" object, which is not
					# what LSP's InlayHint declares: clients read position.line directly, found
					# nothing, and dropped every hint silently. The test asserted only that the
					# response was non-empty, so it passed throughout.
					obj := builder->PushObject("position");
					obj->Insert("line", hint->GetStartLine());
					obj->Insert("character", hint->GetStartPosition());
					builder->Pop();

					array->Add(builder->Pop());
				};

				return array;
			};

			return Nil;
		}

		method : public : SemanticTokens(uri : String, sys_path : String) ~ JsonElement {
			if(@analysis = Nil) {
				return Nil;
			};

			tokens := @analysis->SemanticTokens(uri, sys_path);
			if(tokens <> Nil) {
				# encode as LSP delta format
				data := JsonElement->New(JsonElement->JsonType->ARRAY);

				prev_line := 0;
				prev_char := 0;

				each(i : tokens) {
					token := tokens[i];
					line := token->GetStartLine();
					start_char := token->GetStartPosition();
					length := token->GetEndLine();
					token_type := token->GetEndPosition();
					token_mods := token->GetKind()->As(Int);

					delta_line := line - prev_line;
					delta_char := start_char;
					if(delta_line = 0) {
						delta_char := start_char - prev_char;
					};

					data->Add(delta_line);
					data->Add(delta_char);
					data->Add(length);
					data->Add(token_type);
					data->Add(token_mods);

					prev_line := line;
					prev_char := start_char;
				};

				result := JsonElement->New(JsonElement->JsonType->OBJECT);
				result->Insert("data", data);

				return result;
			};

			return Nil;
		}

		method : public : Build() ~ Bool {
			if(@analysis = Nil) {
				return false;
			};

			return @analysis->IsParsed();
		}

		method : public : Release() ~ Nil {
			if(@analysis <> Nil) {
				@analysis->Release();
			};
		}
	}

	#~
	One DocumentSymbol, with ranges normalised against the document text
	~#
	class : private : SymbolNode {
		@name : String;
		@kind : Int;
		@start_line : Int;
		@start_char : Int;
		@end_line : Int;
		@end_char : Int;
		@select_line : Int;
		@select_start : Int;
		@select_end : Int;
		@children : Vector<SymbolNode>;
		@lines : String[];
		@detail : String;

		New(name : String, kind : Int, start_line : Int, start_char : Int, end_line : Int, lines : String[]) {
			# 'JsonBuilder' under its bundle, with 'Data.JSON.JsonBuilder' beside it;
			# a bundle keeps its whole name
			@name := name;
			if(kind <> 3 & name->FindLast('.') > -1) {
				@name := ShortName(name);
				@detail := name;
			};
			@lines := lines;
			@kind := kind;
			@children := Vector->New()<SymbolNode>;

			last := lines->Size() - 1;
			@start_line := Clamp(start_line, 0, last);
			@end_line := Clamp(end_line, @start_line, last);

			start_text := LineText(lines, @start_line);
			@start_char := Clamp(start_char, 0, start_text->Size());
			# to the end of the last line: the native end positions are
			# inconsistent from one kind of declaration to the next
			@end_char := LineText(lines, @end_line)->Size();

			# the name, where the range starts at a keyword ('class', 'method : ...')
			@select_line := @start_line;
			@select_start := @start_char;
			@select_end := @start_char;
			found := FindName(start_text, @start_char, name);
			if(found < 0) {
				short_name := ShortName(name);
				found := FindName(start_text, @start_char, short_name);
				if(found > -1) {
					@select_start := found;
					@select_end := found + short_name->Size();
				};
			}
			else {
				@select_start := found;
				@select_end := found + name->Size();
			};
		}

		function : Clamp(value : Int, low : Int, high : Int) ~ Int {
			if(value < low) {
				return low;
			};

			if(value > high) {
				return high;
			};

			return value;
		}

		function : LineText(lines : String[], line : Int) ~ String {
			text := lines[line];
			if(text = Nil) {
				return "";
			};

			if(text->EndsWith('\r')) {
				return text->SubString(text->Size() - 1);
			};
			return text;
		}

		# 'Bundle.Klass' -> 'Klass'
		function : ShortName(name : String) ~ String {
			index := name->FindLast('.');
			if(index > -1) {
				return name->SubString(index + 1, name->Size() - index - 1);
			};
			return name;
		}

		function : FindName(text : String, start : Int, name : String) ~ Int {
			if(name->IsEmpty() | start >= text->Size()) {
				return -1;
			};

			index := text->SubString(start, text->Size() - start)->Find(name);
			if(index < 0) {
				return -1;
			};
			return start + index;
		}

		# a child widens this range to cover it
		method : public : AddChild(child : SymbolNode) ~ Nil {
			@children->AddBack(child);

			if(child->GetStartLine() < @start_line | (child->GetStartLine() = @start_line & child->GetStartChar() < @start_char)) {
				@start_line := child->GetStartLine();
				@start_char := child->GetStartChar();
			};

			if(child->GetEndLine() > @end_line | (child->GetEndLine() = @end_line & child->GetEndChar() > @end_char)) {
				@end_line := child->GetEndLine();
				@end_char := child->GetEndChar();
			};
		}

		method : public : Contains(candidate : SymbolNode) ~ Bool {
			starts_before := @start_line < candidate->GetStartLine() |
				(@start_line = candidate->GetStartLine() & @start_char <= candidate->GetStartChar());
			ends_after := @end_line > candidate->GetEndLine() |
				(@end_line = candidate->GetEndLine() & @end_char >= candidate->GetEndChar());
			return starts_before & ends_after;
		}

		#
		# Declared inside this symbol: within its range, and of a kind Objeck can
		# declare there -- classes, interfaces and enums in a bundle; methods and
		# enums in a class. A method never holds another, however far its native
		# end runs.
		#
		method : public : Holds(candidate : SymbolNode) ~ Bool {
			if(<>Contains(candidate)) {
				return false;
			};

			kind := candidate->GetKind();
			if(@kind = 3) {
				return kind <> 3;
			};

			if(@kind = 5 | @kind = 11) {
				return kind = 6 | kind = 9 | kind = 12 | kind = 10;
			};

			return false;
		}

		method : public : SameDeclaration(candidate : SymbolNode) ~ Bool {
			return @kind = candidate->GetKind() & @name->Equals(candidate->GetName()) &
				@start_line = candidate->GetStartLine() & @start_char = candidate->GetStartChar();
		}

		# the other overload's extent and children
		method : public : Absorb(candidate : SymbolNode) ~ Nil {
			if(candidate->GetEndLine() > @end_line | (candidate->GetEndLine() = @end_line & candidate->GetEndChar() > @end_char)) {
				@end_line := candidate->GetEndLine();
				@end_char := candidate->GetEndChar();
			};

			children := candidate->GetChildren();
			each(i : children) {
				@children->AddBack(children->Get(i));
			};
		}

		method : public : GetName() ~ String {
			return @name;
		}

		method : public : GetChildren() ~ Vector<SymbolNode> {
			return @children;
		}

		method : public : GetKind() ~ Int {
			return @kind;
		}

		method : public : StartsBefore(candidate : SymbolNode) ~ Bool {
			return @start_line < candidate->GetStartLine() |
				(@start_line = candidate->GetStartLine() & @start_char < candidate->GetStartChar());
		}

		#
		# Ends on the line before 'next' starts, if it ran into it, or where 'next'
		# starts when both share a line. Never before its own name.
		#
		method : public : EndBefore(next : SymbolNode) ~ Nil {
			if(@end_line < next->GetStartLine() |
					(@end_line = next->GetStartLine() & @end_char <= next->GetStartChar())) {
				return;
			};

			if(next->GetStartLine() > @select_line) {
				@end_line := next->GetStartLine() - 1;
				@end_char := LineText(@lines, @end_line)->Size();
			}
			else {
				@end_line := @select_line;
				@end_char := next->GetStartChar() > @select_end ? next->GetStartChar() : @select_end;
			};
		}

		method : public : NestChildren() ~ Nil {
			# this range may have been cut short at the next symbol; so are its children
			each(i : @children) {
				@children->Get(i)->EndBy(@end_line, @end_char);
			};
			@children := AstProxy->Nest(@children);
		}

		# ends no later than this position, and never before its own name
		method : public : EndBy(end_line : Int, end_char : Int) ~ Nil {
			if(@end_line < end_line | (@end_line = end_line & @end_char <= end_char)) {
				return;
			};

			@end_line := end_line;
			@end_char := end_char;
			if(@end_line < @select_line | (@end_line = @select_line & @end_char < @select_end)) {
				@end_line := @select_line;
				@end_char := @select_end;
			};
		}

		method : public : GetStartLine() ~ Int {
			return @start_line;
		}

		method : public : GetStartChar() ~ Int {
			return @start_char;
		}

		method : public : GetEndLine() ~ Int {
			return @end_line;
		}

		method : public : GetEndChar() ~ Int {
			return @end_char;
		}

		function : MakeRange(start_line : Int, start_char : Int, end_line : Int, end_char : Int) ~ JsonElement {
			start := JsonElement->New(JsonElement->JsonType->OBJECT);
			start->Insert("line", start_line);
			start->Insert("character", start_char);

			end := JsonElement->New(JsonElement->JsonType->OBJECT);
			end->Insert("line", end_line);
			end->Insert("character", end_char);

			range := JsonElement->New(JsonElement->JsonType->OBJECT);
			range->Insert("start", start);
			range->Insert("end", end);
			return range;
		}

		method : public : ToJson() ~ JsonElement {
			symbol := JsonElement->New(JsonElement->JsonType->OBJECT);
			symbol->Insert("name", @name);
			if(@detail <> Nil) {
				symbol->Insert("detail", @detail);
			};
			symbol->Insert("kind", @kind);
			symbol->Insert("range", MakeRange(@start_line, @start_char, @end_line, @end_char));
			symbol->Insert("selectionRange", MakeRange(@select_line, @select_start, @select_line, @select_end));

			children := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(i : @children) {
				children->Add(@children->Get(i)->ToJson());
			};
			symbol->Insert("children", children);

			return symbol;
		}
	}
}