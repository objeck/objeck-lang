		}

		method : CallbackDocumentDiagnostic(id : Int, params : JsonElement) ~ Nil {
			uri := FindString(params, "textDocument/uri");
			report : JsonElement := Nil;
			if(uri <> Nil) {
				report := PullDiagnostics(uri, FindString(params, "previousResultId"));
			};

			# an empty report for a document the server doesn't have open
			if(report = Nil) {
				report := JsonElement->New(JsonElement->JsonType->OBJECT);
				report->Insert("kind", "full");
				report->Insert("items", JsonElement->New(JsonElement->JsonType->ARRAY));
			};
			WriteRpcResponse(id, report);
		}

		method : CallbackCodeLens(id : Int, params : JsonElement) ~ Nil {
