		# the open document params.textDocument.uri names, or Nil
		method : DocumentOf(params : JsonElement) ~ Document {
			uri := FindString(params, "textDocument/uri");
			if(uri = Nil) {
				return Nil;
			};
			return @workspace->GetDocument(uri);
		}

