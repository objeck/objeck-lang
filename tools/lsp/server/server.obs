		method : CallbackPrepareCallHierarchy(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();
			line_pos := params->FindElements("position/line")->GetValue();
			char_pos := params->FindElements("position/character")->GetValue();

			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				item := document->PrepareCallHierarchy(line_pos->ToInt(), char_pos->ToInt());
				if(item <> Nil) {
					array := JsonElement->New(JsonElement->JsonType->ARRAY);
					array->Add(item);
					WriteRpcResponse(id, array);
				}
				else {
					WriteRpcResponse(id, Nil);
				};
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackIncomingCalls(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("item/uri")->GetValue();
			line_pos := params->FindElements("item/range/start/line");
			char_pos := params->FindElements("item/range/start/character");

			if(uri <> Nil & line_pos <> Nil & char_pos <> Nil) {
				document := @workspace->GetDocument(uri);
				if(document <> Nil) {
					response := document->IncomingCalls(line_pos->GetInt(), char_pos->GetInt());
