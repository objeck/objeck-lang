			};
		}

		method : CallbackCodeAction(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();

			start_line := params->FindElements("range/start/line")->GetInt();
			start_char := params->FindElements("range/start/character")->GetInt();
			
			response : JsonElement;

			diagnostics_json := params->FindElements("context/diagnostics");
			each(i : diagnostics_json) {
				diagnostic_json := diagnostics_json->Get(i);

				diagnostic_start_line := diagnostic_json->FindElements("range/start/line")->GetInt();
				diagnostic_start_char := diagnostic_json->FindElements("range/start/character")->GetInt();

				diagnostic_end_line := diagnostic_json->FindElements("range/end/line")->GetInt();
				diagnostic_end_char := diagnostic_json->FindElements("range/end/character")->GetInt();

				diagnostic_message := diagnostic_json->FindElements("message")->GetValue();

				if(start_line = diagnostic_start_line & start_char = diagnostic_start_char) {
					# 'context.only' is OPTIONAL in LSP: a client sends it to restrict the
					# kinds it wants and omits it for an ordinary lightbulb at the cursor,
					# which is what VS Code does. This used to REQUIRE it, and require an
					# array of exactly one, so the common request fell through with
					# 'response' never assigned and the server answered null. Quick fixes
					# were unreachable from the editor UI while being advertised.
					only_json := params->FindElements("context/only");
					document := @workspace->GetDocument(uri);
					
					# Honour a restriction when one is given: offer a fix only if
					# 'quickfix' is among the kinds asked for. LSP kinds are
					# hierarchical, so an empty string matches everything.
					wants_quickfix := true;
					if(only_json <> Nil & only_json->GetType() = JsonElement->JsonType->ARRAY & only_json->Size() > 0) {
						wants_quickfix := false;
						each(j : only_json) {
							requested := only_json->Get(j)->GetValue();
							if(requested = Nil | requested->Size() = 0 | requested->StartsWith("quickfix")) {
								wants_quickfix := true;
							};
						};
					};
					
					if(document <> Nil & wants_quickfix) {
						response := document->CodeAction(diagnostic_start_line, diagnostic_start_char, diagnostic_end_line, diagnostic_end_char, diagnostic_message, "quickfix", @workspace->BuildFileFor(uri));
					};
				};
			};

			# Advertised in codeActionKinds all along, and never produced. Offered
			# only when asked for by kind, as editors do for "Organize Imports" and
			# on save; a lightbulb at the cursor doesn't ask for source actions.
			if(RequestsKind(params, "source.organizeImports")) {
				document := @workspace->GetDocument(uri);
				if(document <> Nil) {
					organize := document->OrganizeImports();
					if(organize <> Nil) {
						if(response = Nil) {
							response := JsonElement->New(JsonElement->JsonType->ARRAY);
						};
						response->Add(organize);
					};
				};
			};

			WriteRpcResponse(id, response);
		}

		# context.only names this kind or a parent of it ('source')
		method : RequestsKind(params : JsonElement, kind : String) ~ Bool {
			only_json := FindJson(params, "context/only");
			if(only_json = Nil | only_json->GetType() <> JsonElement->JsonType->ARRAY) {
				return false;
			};

			each(i : only_json) {
				requested := only_json->Get(i)->GetValue();
				if(requested <> Nil & <>requested->IsEmpty() &
						(kind->Equals(requested) | kind->StartsWith(requested + "."))) {
					return true;
				};
			};

			return false;
		}

		method : CallbackCompletion(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();
			line_pos := params->FindElements("position/line")->GetValue();
			char_pos := params->FindElements("position/character")->GetValue();

			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				response := document->Completion(line_pos->ToInt(), char_pos->ToInt());
				WriteRpcResponse(id, response);
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackInitialize(id : Int, params : JsonElement) ~ Nil {
			# Process workspace folders whenever the client sends them. Gating on
			# capabilities/workspace/configuration broke Sublime, which supports
			# folders without advertising the (unrelated) configuration capability.
			workspace_folders := params->FindElements("workspaceFolders");
			if(workspace_folders <> Nil) {
				each(i : workspace_folders) {
					workspace_folder := workspace_folders->Get(i);

					folder_name_obj := workspace_folder->Get("name");
					folder_uri_obj := workspace_folder->Get("uri");
					if(folder_name_obj <> Nil & folder_uri_obj <> Nil) {
						folder_name := folder_name_obj->GetValue();
						folder_uri := folder_uri_obj->GetValue();

						if(@is_debug) {
							System.IO.Filesystem.Logger->Instance()->Info("\n--- Added workspace:  folder_uri='{$folder_uri}', folder_name='{$folder_name}' ---\n");
						};
						ProcessConfiguration(folder_name, folder_uri);
					};
				};
			}
			else {
				# single-folder clients that only send rootUri
				# A JSON null reads as an empty string, which configured a folder at
				# '' -- and with it a quick fix that wrote build.json to the root of
				# the file system.
				root_uri_obj := params->Get("rootUri");
				if(root_uri_obj <> Nil & root_uri_obj->GetType() = JsonElement->JsonType->STRING) {
					root_uri := root_uri_obj->GetValue();
					if(root_uri <> Nil & <>root_uri->IsEmpty() & <>root_uri->Equals("null")) {
						if(@is_debug) {
							System.IO.Filesystem.Logger->Instance()->Info("\n--- Added workspace from rootUri: '{$root_uri}' ---\n");
						};
						ProcessConfiguration("root", root_uri);
					};
				};
			};
			
			# build response
			response := JsonElement->New(JsonElement->JsonType->OBJECT);

			# Clients surface this (Sublime's Troubleshoot Server, VS Code's
			# output channel); without it a stale server is invisible.
			serverInfo := response->AddChild("serverInfo");
			serverInfo->Insert("name", "Objeck Language Server");
			# Kept in step with core/shared/version.h by a gating test
			# (run_lsp_tests.py), because the note that used to sit here asking
			# for a manual bump was ignored through two releases.
			serverInfo->Insert("version", "2026.10.1");

			capabilities := response->AddChild("capabilities");

			# Columns are counted in the server's Chars. Where a Char is UTF-16
			# (Windows) that is LSP's default encoding exactly. Where a Char is a whole
			# code point (Linux, macOS) it is UTF-32, used when the client accepts it;
			# a client that offers only UTF-16 gets UTF-16, and every column is
			# converted at the JSON boundary (#1226).
			position_encoding := "utf-16";
			if(String->FromCodePoint(0x1F600)->Size() = 1) {
				offered := params->FindElements("capabilities/general/positionEncodings");
				if(offered <> Nil) {
					each(i : offered) {
						if(offered->Get(i)->GetValue()->Equals("utf-32")) {
							position_encoding := "utf-32";
						};
					};
				};
			};
			capabilities->Insert("positionEncoding", position_encoding);
			# answered in UTF-16 where a Char is a code point: convert every column
			@workspace->SetUtf16(position_encoding->Equals("utf-16") & String->FromCodePoint(0x1F600)->Size() = 1);
			# markdown where the client takes it, and plain text where it says it
			# takes only that
			@hover_markdown := AcceptsMarkdown(params, "capabilities/textDocument/hover/contentFormat");
			@completion_markdown := AcceptsMarkdown(params, "capabilities/textDocument/completion/completionItem/documentationFormat");

			hierarchical_json := FindJson(params, "capabilities/textDocument/documentSymbol/hierarchicalDocumentSymbolSupport");
			@hierarchical_symbols := hierarchical_json <> Nil & hierarchical_json->GetType() = JsonElement->JsonType->TRUE;

			completionProvider := capabilities->AddChild("completionProvider");
			completionProvider->Insert("resolveProvider", true);
			triggerCharacters := JsonElement->New(JsonElement->JsonType->ARRAY);
			triggerCharacters->Add("@");
			triggerCharacters->Add(".");
			triggerCharacters->Add(">");
			completionProvider->Insert("triggerCharacters", triggerCharacters);

			signatureHelpProvider := capabilities->AddChild("signatureHelpProvider");
			triggerCharacters := JsonElement->New(JsonElement->JsonType->ARRAY);
			triggerCharacters->Add("(");
			triggerCharacters->Add(",");
			signatureHelpProvider->Insert("triggerCharacters", triggerCharacters);
			# keeps the signature popup alive while arguments are edited
			retriggerCharacters := JsonElement->New(JsonElement->JsonType->ARRAY);
			retriggerCharacters->Add(",");
			retriggerCharacters->Add(")");
			signatureHelpProvider->Insert("retriggerCharacters", retriggerCharacters);

			workspace := capabilities->AddChild("workspace");
			workspace_folders := workspace->AddChild("workspaceFolders");
			workspace_folders->Insert("supported", true);
			workspace_folders->Insert("changeNotifications", true);

			documentSync := capabilities->AddChild("textDocumentSync");
			documentSyncSave := documentSync->AddChild("save");
			documentSyncSave->Insert("includeText", true);
			documentSync->Insert("openClose", true);
			documentSync->Insert("change", 2);
			
			capabilities->Insert("workspace", workspace);
			capabilities->Insert("documentSymbolProvider", true);

			# Declaring the kinds lets clients filter, bind keys, and route
			# "Organize Imports" here instead of showing an unlabelled list.
			codeActionProvider := capabilities->AddChild("codeActionProvider");
			codeActionKinds := JsonElement->New(JsonElement->JsonType->ARRAY);
			codeActionKinds->Add("quickfix");
			codeActionKinds->Add("source.organizeImports");
			codeActionProvider->Insert("codeActionKinds", codeActionKinds);
			capabilities->Insert("referencesProvider", true);
			capabilities->Insert("declarationProvider", true);
			capabilities->Insert("definitionProvider", true);
			# prepareRename tells the editor up front what can be renamed
			prepare_json := FindJson(params, "capabilities/textDocument/rename/prepareSupport");
			if(prepare_json <> Nil & prepare_json->GetType() = JsonElement->JsonType->TRUE) {
				renameProvider := capabilities->AddChild("renameProvider");
				renameProvider->Insert("prepareProvider", true);
			}
			else {
				capabilities->Insert("renameProvider", true);
			};
			capabilities->Insert("hoverProvider", true);
			capabilities->Insert("documentFormattingProvider", true);
			capabilities->Insert("documentRangeFormattingProvider", true);
			capabilities->Insert("workspaceSymbolProvider", true);
			capabilities->Insert("documentHighlightProvider", true);
			capabilities->Insert("foldingRangeProvider", true);
			capabilities->Insert("selectionRangeProvider", true);
			capabilities->Insert("typeDefinitionProvider", true);
			capabilities->Insert("implementationProvider", true);
			capabilities->Insert("inlayHintProvider", true);

			callHierarchyProvider := capabilities->AddChild("callHierarchyProvider");
			callHierarchyProvider->Insert("id", "objeck-call-hierarchy");

			typeHierarchyProvider := capabilities->AddChild("typeHierarchyProvider");
			typeHierarchyProvider->Insert("id", "objeck-type-hierarchy");

			semanticTokensLegend := JsonElement->New(JsonElement->JsonType->OBJECT);
			tokenTypes := JsonElement->New(JsonElement->JsonType->ARRAY);
			tokenTypes->Add("namespace");
			tokenTypes->Add("type");
			tokenTypes->Add("class");
			tokenTypes->Add("enum");
			tokenTypes->Add("interface");
			tokenTypes->Add("function");
			tokenTypes->Add("method");
			tokenTypes->Add("property");
			tokenTypes->Add("variable");
			tokenTypes->Add("parameter");
			tokenTypes->Add("enumMember");
			semanticTokensLegend->Insert("tokenTypes", tokenTypes);

			tokenModifiers := JsonElement->New(JsonElement->JsonType->ARRAY);
			tokenModifiers->Add("declaration");
			tokenModifiers->Add("static");
			tokenModifiers->Add("readonly");
			semanticTokensLegend->Insert("tokenModifiers", tokenModifiers);

			semanticTokensProvider := capabilities->AddChild("semanticTokensProvider");
			semanticTokensProvider->Insert("legend", semanticTokensLegend);
			semanticTokensProvider->Insert("range", true);
			semanticTokensFull := semanticTokensProvider->AddChild("full");
			semanticTokensFull->Insert("delta", true);

			# Pull diagnostics, for a client that takes them; the rest keep the push
			# model. interFileDependencies: an edit to one file can change
			# another's results, through a build.json program.
			pull_json := FindJson(params, "capabilities/textDocument/diagnostic");
			refresh_json := FindJson(params, "capabilities/workspace/diagnostics/refreshSupport");
			SetPullDiagnostics(pull_json <> Nil & pull_json->GetType() = JsonElement->JsonType->OBJECT,
				refresh_json <> Nil & refresh_json->GetType() = JsonElement->JsonType->TRUE);
			if(IsPullDiagnostics()) {
				diagnosticProvider := capabilities->AddChild("diagnosticProvider");
				diagnosticProvider->Insert("identifier", "objeck");
				diagnosticProvider->Insert("interFileDependencies", true);
				diagnosticProvider->Insert("workspaceDiagnostics", false);
			};

			codeLensProvider := capabilities->AddChild("codeLensProvider");
			codeLensProvider->Insert("resolveProvider", false);
			documentLinkProvider := capabilities->AddChild("documentLinkProvider");
			documentLinkProvider->Insert("resolveProvider", false);

			# A client that can run a program names its command; the 'Run' lens
			# then invokes it. Without one the lens only says what to run.
			@run_command := FindString(params, "initializationOptions/runCommand");

			# Dynamic registration is a request, so it waits for the client's
			# 'initialized' (NotifyInitialized), and is only sent to a client that
			# says it supports it. It went out here, unconditionally, before the
			# client had even received this response.
			# server-initiated progress for long analyses, to a client that shows it
			progress_json := FindJson(params, "capabilities/window/workDoneProgress");
			SetClientProgress(progress_json <> Nil & progress_json->GetType() = JsonElement->JsonType->TRUE);

			dynamic_json := params->FindElements("capabilities/workspace/didChangeWatchedFiles/dynamicRegistration");
			@can_register_watchers := dynamic_json <> Nil & dynamic_json->GetType() = JsonElement->JsonType->TRUE;

			WriteRpcResponse(id, response);
		}

		# A client that lists its formats and leaves markdown out gets plain text.
		# One that lists none is assumed to take markdown, as every current client does.
		method : AcceptsMarkdown(params : JsonElement, path : String) ~ Bool {
			formats := FindJson(params, path);
			if(formats = Nil | formats->GetType() <> JsonElement->JsonType->ARRAY | formats->Size() = 0) {
				return true;
			};

			each(i : formats) {
				if(formats->Get(i)->GetValue()->Equals("markdown")) {
					return true;
				};
			};

			return false;
		}

		# a workspace folder, configured from its own build.json
		method : ProcessConfiguration(folder_name : String, folder_uri : String) ~ Nil {
			folder := @workspace->AddFolder(folder_name, folder_uri);
			if(folder <> Nil) {
				ReportFolder(folder);
			};
		}

		#
		# How a folder is configured, in the client's log. A build.json that can't
		# be read or parsed was reported only to a log file, and the folder's files
		# were then analyzed without it, with no sign of why.
		#
		method : ReportFolder(folder : LspFolder) ~ Nil {
			name := folder->GetName();
			if(folder->IsConfigured()) {
				count := folder->FileCount();
				LogMessage(3, "Workspace folder '{$name}': build.json lists {$count} file(s)");
			}
			else if(folder->IsMissing()) {
				LogMessage(3, "Workspace folder '{$name}' has no build.json: each of its files is analyzed on its own");
			}
			else {
				error := folder->GetLoadError();
				LogMessage(1, "Workspace folder '{$name}': {$error}; its files are analyzed on their own");
			};
		}

		# Which files make up a program changed: every open document is analyzed
		# again, once typing pauses.
		method : RefreshAllDiagnostics() ~ Nil {
			uris := @workspace->GetUris();
			each(i : uris) {
				DeferDiagnostics(uris->Get(i));
			};
			RefreshPulledDiagnostics();
		}

		method : RegisterWatchers() ~ Nil {
			watcher := JsonElement->New(JsonElement->JsonType->OBJECT);
			watcher->Insert("globPattern", "**/*.json");

			watchers_array := JsonElement->New(JsonElement->JsonType->ARRAY);
			watchers_array->Add(watcher);

			watchers_obj := JsonElement->New(JsonElement->JsonType->OBJECT);
			watchers_obj->Insert("watchers", watchers_array);

			registrar := JsonElement->New(JsonElement->JsonType->OBJECT);
			registrar->Insert("id", "d929fc04-b4ac-4907-a3b3-0508710f3c42");
			registrar->Insert("method", "workspace/didChangeWatchedFiles");
			registrar->Insert("registerOptions", watchers_obj);

			registrars_array := JsonElement->New(JsonElement->JsonType->ARRAY);
			registrars_array->Add(registrar);

			registrars_obj := JsonElement->New(JsonElement->JsonType->OBJECT);
			registrars_obj->Insert("registrations", registrars_array);

			WriteRpcServerRequest("client/registerCapability", registrars_obj);
		}

		method : CallbackShutdown(id : Int, params : JsonElement) ~ Nil {
			if(IsDebug()) {
				System.IO.Filesystem.Logger->Instance()->Info("=> CallbackShutdown");
			};

			# Only 'exit' is valid from here on (LspWorker answers anything else with
			# InvalidRequest). Ending the read loop here closed the connection
			# before the client could send 'exit'.
			@is_shutdown := true;
			WriteRpcResponse(id, Nil);
		}

		method : CallbackDocumentSymbol(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri");
			if(uri <> Nil) {
				url_str := uri->GetValue();
				document := @workspace->GetDocument(url_str);
				if(document <> Nil & url_str <> Nil) {
					WriteRpcResponse(id, document->GetSymbols(url_str, @hierarchical_symbols));
				}
				else {
					WriteRpcResponse(id, Nil);
				};
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackWorkspaceSymbol(id : Int, params : JsonElement) ~ Nil {
			query := params->FindElements("query")->GetValue();
			response := @workspace->GetSymbol(query);
			WriteRpcResponse(id, response);
		}

		#
		# completionItem/resolve: the item back, with the signature and documentation
		# of a method filled in. Its 'data' says where completion was asked for. This
		# echoed the item unchanged, behind a resolveProvider of false.
		#
		method : CallbackResolve(id : Int, params : JsonElement) ~ Nil {
			if(params = Nil | params->GetType() <> JsonElement->JsonType->OBJECT) {
				WriteRpcResponse(id, params);
				return;
			};

			item_name := FindString(params, "label");
			uri := FindString(params, "data/uri");
			var_str := FindString(params, "data/var");
			line_json := FindJson(params, "data/line");
			char_json := FindJson(params, "data/character");
			kind_json := params->Get("kind");

			# methods and functions only: the rest carry what they have already
			is_method := kind_json <> Nil & (kind_json->GetInt() = 2 | kind_json->GetInt() = 3);
			if(is_method & item_name <> Nil & uri <> Nil & var_str <> Nil & line_json <> Nil & char_json <> Nil) {
				document := @workspace->GetDocument(uri);
				if(document <> Nil) {
					resolved := document->ResolveCompletion(item_name, line_json->GetInt(), char_json->GetInt(), var_str, @completion_markdown);
					if(resolved <> Nil) {
						# the item as sent, with what was resolved in place of its own
						item := JsonElement->New(JsonElement->JsonType->OBJECT);
						names := params->GetNames();
						each(i : names) {
							name := names->Get(i);
							if(<>resolved->Has(name)) {
								item->Insert(name, params->Get(name));
							};
						};

						names := resolved->GetNames();
						each(i : names) {
							name := names->Get(i);
							item->Insert(name, resolved->Get(name));
						};

						WriteRpcResponse(id, item);
						return;
					};
				};
			};

			WriteRpcResponse(id, params);
		}

		#
		# Notifications
		#
		method : NotifyInitialized(params : JsonElement) ~ Nil {
			@is_initialized := true;
			RequestProgressToken();

			if(@can_register_watchers) {
				RegisterWatchers();
			};
		}

		method : NotifyCancel(params : JsonElement) ~ Nil {
			id_obj := params->Get("id");
			if(id_obj = Nil) {
				return;
			};
			
			# Requests are handled one at a time, in order, so by the time this is
			# read the request it names has already been answered, and the spec lets
			# a server ignore a cancel then. Recording it only left a stale id that a
			# later request reusing it would have been refused by. Cancelling work
			# still queued needs a read-ahead queue (#1217).
			id := id_obj->GetValue();

			if(IsDebug()) {
				System.IO.Filesystem.Logger->Instance()->Info("NotifyCancel: id={$id}");
			};
		}

		method : NotifyDidChangeWatchedFiles(params : JsonElement) ~ Nil {
			changes := params->Get("changes");
			each(i : changes) {
				change := changes->Get(i);

				uri := change->Get("uri")->GetValue();
				type := change->Get("type")->GetValue()->ToInt();

				if(IsDebug()) {
					System.IO.Filesystem.Logger->Instance()->Info("NotifyDidChangeWatchedFiles: uri='{$uri}', uri={$type}");
				};

				# a configuration file added, changed or deleted: reload the folder it
				# is in
				if(type = 1 | type = 2 | type = 3) {
					reloaded := @workspace->ReloadFolders(uri);
					each(j : reloaded) {
						ReportFolder(reloaded->Get(j));
					};
					RefreshAllDiagnostics();
				};
			};
		}

		method : NotifyDidOpen(params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();
			text := params->FindElements("textDocument/text")->GetValue();

			if(IsDebug()) {
				System.IO.Filesystem.Logger->Instance()->Info("NotifyDidOpen: uri='{$uri}', text=\"{$text}\"");
			};
			
			document := Document->New(uri, text, @workspace, IsDebug());
			version_json := params->FindElements("textDocument/version");
			if(version_json <> Nil) {
				document->SetVersion(version_json->GetInt());
			};
			@workspace->AddDocument(uri, document);
			PublishDiagnostics(uri);
		}

		method : NotifyDidSave(params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue()
			document := @workspace->GetDocument(uri);			
			if(document <> Nil) {
				text_json := params->Get("text");
				if(text_json = Nil) {
					document->Reload();
				}
				else {
					document->Refresh(text_json->GetValue());
				};

				if(IsDebug()) {
					from_text := text_json <> Nil;
					System.IO.Filesystem.Logger->Instance()->Info("NotifyDidSave: uri='{$uri}', from_text={$from_text}");
				};
				
				PublishDiagnostics(uri);
			};
		}

		method : NotifyDidClose(params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();
			document:= @workspace->GetDocument(params->FindElements("textDocument/uri")->GetValue());
			if(document <> Nil) {
				# closed: nothing more to publish for it
				DropPendingDiagnostics(uri);
				@workspace->RemoveDocument(uri, document);
				PublishClosed(uri);
			};
		}

		method : NotifyDidChangeWorkspace(params : JsonElement) ~ Nil {
			changed := false;
			added := params->FindElements("event/added");
			each(i : added) {
				folder := added->Get(i);
				
				folder_uri := folder->Get("uri")->GetValue();
				folder_name := folder->Get("name")->GetValue();
				if(@is_debug) {
					System.IO.Filesystem.Logger->Instance()->Info("--- Added workspace: '{$folder_uri}', '{$folder_name}' ---");
				};
				
				# Actually configure it. This handler only LOGGED, while initialize
				# calls ProcessConfiguration for exactly the same shape of folder --
				# so a folder added mid-session got no build.json and no library set,
				# and every file in it was analysed as if standalone. The capability
				# workspaceFolders.changeNotifications was advertised as true anyway.
				ProcessConfiguration(folder_name, folder_uri);
				changed := true;
			};

			removed := params->FindElements("event/removed");
			each(i : removed) {
				folder := removed->Get(i);
				
				folder_uri := folder->Get("uri")->GetValue();
				folder_name := folder->Get("name")->GetValue();
				if(@is_debug) {
					System.IO.Filesystem.Logger->Instance()->Info("--- Removed workspace: '{$folder_uri}', '{$folder_name}' ---");
				};

				# This only logged: a removed folder's build.json went on deciding
				# how its documents were analyzed (#1232).
				if(@workspace->RemoveFolder(folder_uri)) {
					changed := true;
				};
			};

			if(changed) {
				RefreshAllDiagnostics();
			};
		}
		
		method : NotifyDidChange(params : JsonElement) ~ Nil {
			if(IsDebug()) {
				System.IO.Filesystem.Logger->Instance()->Info("NotifyDidChange");
			};

			uri := params->FindElements("textDocument/uri")->GetValue();
			document:= @workspace->GetDocument(uri);
			changes := params->FindElements("contentChanges");
			if(document <> Nil & changes <> Nil) {
				each(i : changes) {
					change := changes->Get(i);
					
					if(change->Has("range")) {
						text := change->Get("text")->GetValue();
						start_line := change->FindElements("range/start/line")->GetValue();
						start_char := change->FindElements("range/start/character")->GetValue();

						range_length_json := change->Get("rangeLength");
						end_line_json := change->FindElements("range/end/line");
						end_char_json := change->FindElements("range/end/character");

						# The range end, not 'rangeLength': that is deprecated, and it
						# counts UTF-16 units, which are not the server's characters
						# where a Char is a full code point. It is the fallback only.
						if(text <> Nil & start_line <> Nil & start_char <> Nil  & end_line_json <> Nil & end_char_json <> Nil) {
							end_line := end_line_json->GetValue();
							end_char := end_char_json->GetValue();
							# each change against the text the one before it left
							start_column := start_char->ToInt();
							end_column := end_char->ToInt();
							if(@workspace->IsUtf16()) {
								start_column := Document->UnitsToChars(document->LineText(start_line->ToInt()), start_column);
								end_column := Document->UnitsToChars(document->LineText(end_line->ToInt()), end_column);
							};
							document->Update(text, start_line->ToInt(), start_column, end_line->ToInt(), end_column);
						}
						else if(range_length_json <> Nil & text <> Nil & start_line <> Nil & start_char <> Nil) {
							range_length := range_length_json->GetValue();
							document->Update(range_length->ToInt(), text, start_line->ToInt(), start_char->ToInt());
						};
					}
					else {
						text := change->Get("text")->GetValue();
						if(text <> Nil) {
							document->UpdateAll(text);
						};
					};
				};

				# Once typing pauses (LspWorker), not per keystroke: each analysis
				# covers the whole workspace, and the next keystroke waited for it.
				version_json := params->FindElements("textDocument/version");
				if(version_json <> Nil) {
					document->SetVersion(version_json->GetInt());
				};
				DeferDiagnostics(uri);
			};
		}
	}
}