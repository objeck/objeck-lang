use Collection;
use System.IO.Net;
use Data.JSON;

bundle LSP {
	#~
	LSP TCP server
	~#
	class LintServer {
		@port : Int;
		@is_debug : Bool;

		#
		# obr objeck_lsp.obe <objk_apis.json> (stdio | --stdio | pipe | <port>) [debug]
		#
		# '--stdio' is what vscode-languageclient and others append for a stdio
		# server; it was not understood, and the server started no transport.
		#
		function : Main(args : String[]) ~ Nil {
			if(args->Size() < 2 | args->Size() > 3) {
				"Usage: obr objeck_lsp.obe <objk_apis.json> (stdio | pipe | <port>) [debug]"->ErrorLine();
				Runtime->Exit(1);
			};

			is_debug := args->Size() = 3;
			if(is_debug & <>args[2]->Equals("debug")) {
				"Usage: obr objeck_lsp.obe <objk_apis.json> (stdio | pipe | <port>) [debug]"->ErrorLine();
				Runtime->Exit(1);
			};

			port : Int;
			transport := args[1];
			if(transport->Equals("stdio") | transport->Equals("--stdio")) {
				Runtime->SetProperty("stdio", "binary");
				port := -1;
			}
			else if(transport->Equals("pipe")) {
				port := -2;
			}
			else {
				port := transport->ToInt();
			};

			AstProxy->Init(args[0]);
			LintServer->New(port, is_debug)->Listen();
		}

		New(port : Int, is_debug : Bool) {
			@port := port;
			@is_debug := is_debug;
		}

		method : public : Listen() ~ Nil {
			server : TCPSocketServer;
			leaving {
				if(server <> Nil) {
					server->Close();
				};
			};

			if(@is_debug) {
				dir := System.IO.Filesystem.Logger->Instance()->GetDirectory();
				info := System.IO.Filesystem.Logger->Instance()->GetInfoFile();
				error := System.IO.Filesystem.Logger->Instance()->GetErrorFile();
				
				"----"->ErrorLine();
				"Logging diretory='{$dir}'"->ErrorLine();
				"\tInfo file='{$info}'"->ErrorLine();
				"\tError file='{$error}'"->ErrorLine();
				"----"->ErrorLine();

				if(@port > -1) {
					"Objeck LSP server: port {$@port}"->ErrorLine();
				}
				else if(@port = -1) {
					"Objeck LSP server: using stdio"->ErrorLine();
				}
				else {
					"Objeck LSP server: pipe 'objk-pipe'"->ErrorLine();
				};
			};
						
			# use sockets
			if(@port > -1) {
				server := TCPSocketServer->New(@port);
				if(server->Listen(5)) {
					while(true) {
						LintService->New(Nil, server->Accept(), @is_debug)->Execute(Nil);
					};
				};
			}
			# use std pipes
			else if(@port = -1) {
				LintService->New(Nil, Nil, @is_debug)->Run(Nil);
			}
			# use std pipes
			else if(@port = -2) {
				pipe := Pipe->New("objk-pipe", Pipe->Mode->CREATE);
				LintService->New(pipe, Nil, @is_debug)->Run(Nil);
			};
		}
	}

	#~
	Handles TCP client requests
	~#
	class LintService from LspWorker {
		# the client can take a dynamic registration for workspace/didChangeWatchedFiles
		@can_register_watchers : Bool;
		# the client's command for running a program, from initializationOptions
		@run_command : String;
		# MarkupContent kinds the client renders
		@hover_markdown : Bool;
		# documentSymbol answers DocumentSymbol[] (a tree) rather than SymbolInformation[]
		@hierarchical_symbols : Bool;
		@completion_markdown : Bool;

		New(pipe : Pipe, socket : TCPSocket, is_debug : Bool) {
			Parent(pipe, socket, is_debug);
		}

		#
		# Callbacks
		#
		method : CallbackReferences(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();
			line_pos := params->FindElements("position/line")->GetValue();
			char_pos:= params->FindElements("position/character")->GetValue();

			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				response := document->FindReferences(line_pos->ToInt(), char_pos->ToInt());
				WriteRpcResponse(id, response);
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackRename(id : Int, params : JsonElement) ~ Nil {
			new_name := params->FindElements("newName")->GetValue();
			uri := params->FindElements("textDocument/uri")->GetValue();
			line_pos := params->FindElements("position/line")->GetValue();
			char_pos := params->FindElements("position/character")->GetValue();

			if(IsDebug()) {
				System.IO.Filesystem.Logger->Instance()->Info("=> CallbackRename: new_name={$new_name}, uri={$uri}, line_pos={$line_pos}, char_pos={$char_pos}");
			};

			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				# An edit to a name that doesn't parse leaves the program
				# uncompilable; the client shows this message instead of applying it.
				rename_to := document->RenameTo(new_name, line_pos->ToInt(), char_pos->ToInt());
				if(rename_to = Nil) {
					WriteRpcError(id, LspWorker->ErrorCode->REQUEST_FAILED->As(Int), "'{$new_name}' is not a valid Objeck name here");
					return;
				};

				response := document->CodeRename(rename_to, line_pos->ToInt(), char_pos->ToInt());
				WriteRpcResponse(id, response);
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackPrepareRename(id : Int, params : JsonElement) ~ Nil {
			uri := FindString(params, "textDocument/uri");
			line_json := FindJson(params, "position/line");
			char_json := FindJson(params, "position/character");

			document : Document;
			if(uri <> Nil) {
				document := @workspace->GetDocument(uri);
			};

			if(document <> Nil & line_json <> Nil & char_json <> Nil) {
				WriteRpcResponse(id, document->PrepareRename(line_json->GetInt(), char_json->GetInt()));
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackDeclaration(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();
			line_pos := params->FindElements("position/line")->GetValue();
			char_pos := params->FindElements("position/character")->GetValue();

			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				response := document->FindDeclaration(line_pos->ToInt(), char_pos->ToInt());
				WriteRpcResponse(id, response);
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackDefinition(id : Int, params : JsonElement) ~ Nil {
			if(IsDebug()) {
				System.IO.Filesystem.Logger->Instance()->Info("=> CallbackDefinition");
			};

			uri := params->FindElements("textDocument/uri")->GetValue();
			line_pos := params->FindElements("position/line")->GetValue();
			char_pos := params->FindElements("position/character")->GetValue();

			document := @workspace->GetDocument(uri);
			if(document <> Nil) {
				response := document->FindDefinition(line_pos->ToInt(), char_pos->ToInt());
				WriteRpcResponse(id, response);
			}
			else {
				WriteRpcResponse(id, Nil);
			};
		}

		method : CallbackSignatureHelp(id : Int, params : JsonElement) ~ Nil {
			uri := params->FindElements("textDocument/uri")->GetValue();
			line_pos := params->FindElements("position/line")->GetValue();
			char_pos := params->FindElements("position/character")->GetValue();

			document := @workspace->GetDocument(uri);
