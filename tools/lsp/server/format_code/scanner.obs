use Collection;

class Scanner {
	@buffer : Char[];
	@buffer_index : Int;
	@cur_char : Char;
	@next_char : Char;
	@line_num : Int;
	@line_pos : Int;
	@keywords : Hash<String, Token>;
	@tokens : Vector<Token>;
	@lenient : Bool;
	@code_on_line : Bool;

	New(input : String) {
		@buffer := input->ToCharArray();
		@line_num := @line_pos := 1;
		@tokens := Vector->New()<Token>;

		@keywords := Hash->New()<String, Token>;
		
		@keywords->Insert("and", Token->New(@line_num, Token->Type->AND_ID, "and_id"));
		@keywords->Insert("or", Token->New(@line_num, Token->Type->OR_ID, "or_id"));
		@keywords->Insert("xor", Token->New(@line_num, Token->Type->XOR_ID, "xor_id"));
		@keywords->Insert("virtual", Token->New(@line_num, Token->Type->VIRTUAL_ID, "virtual_id"));
		@keywords->Insert("bundle", Token->New(@line_num, Token->Type->BUNDLE_ID, "bundle_id"));
		@keywords->Insert("interface", Token->New(@line_num, Token->Type->INTERFACE_ID, "interface_id"));
		@keywords->Insert("implements", Token->New(@line_num, Token->Type->IMPLEMENTS_ID, "implements_id"));
		@keywords->Insert("enum", Token->New(@line_num, Token->Type->ENUM_ID, "enum_id"));
		@keywords->Insert("consts", Token->New(@line_num, Token->Type->CONSTS_ID, "consts_id"));
		@keywords->Insert("reverse", Token->New(@line_num, Token->Type->REVERSE_ID, "reverse_id"));
		@keywords->Insert("Parent", Token->New(@line_num, Token->Type->PARENT_ID, "parent_id"));
		@keywords->Insert("from", Token->New(@line_num, Token->Type->FROM_ID, "from_id"));
		@keywords->Insert("true", Token->New(@line_num, Token->Type->TRUE_ID, "true_id"));
		@keywords->Insert("false", Token->New(@line_num, Token->Type->FALSE_ID, "false_id"));
		@keywords->Insert("New", Token->New(@line_num, Token->Type->NEW_ID, "new_id"));
		@keywords->Insert("As", Token->New(@line_num, Token->Type->AS_ID, "as_id"));
		@keywords->Insert("TypeOf", Token->New(@line_num, Token->Type->TYPE_OF_ID, "typeof_id"));
		@keywords->Insert("critical", Token->New(@line_num, Token->Type->CRITICAL_ID, "critical_id"));
		@keywords->Insert("use", Token->New(@line_num, Token->Type->USE_ID, "use_id"));
		@keywords->Insert("class", Token->New(@line_num, Token->Type->CLASS_ID, "class_id"));
		@keywords->Insert("function", Token->New(@line_num, Token->Type->FUNCTION_ID, "function_id"));
		@keywords->Insert("alias", Token->New(@line_num, Token->Type->ALIAS_ID, "alias_id"));
		@keywords->Insert("method", Token->New(@line_num, Token->Type->METHOD_ID, "method_id"));
		@keywords->Insert("public", Token->New(@line_num, Token->Type->PUBLIC_ID, "public_id"));
		@keywords->Insert("private", Token->New(@line_num, Token->Type->PRIVATE_ID, "private_id"));
		@keywords->Insert("native", Token->New(@line_num, Token->Type->NATIVE_ID, "native_id"));
		@keywords->Insert("static", Token->New(@line_num, Token->Type->STATIC_ID, "static_id"));
		@keywords->Insert("if", Token->New(@line_num, Token->Type->IF_ID, "if_id"));
		@keywords->Insert("else", Token->New(@line_num, Token->Type->ELSE_ID, "else_id"));
		@keywords->Insert("for", Token->New(@line_num, Token->Type->FOR_ID, "for_id"));
		@keywords->Insert("each", Token->New(@line_num, Token->Type->EACH_ID, "each_id"));
		@keywords->Insert("do", Token->New(@line_num, Token->Type->DO_ID, "do_id"));
		@keywords->Insert("while", Token->New(@line_num, Token->Type->WHILE_ID, "while_id"));
		@keywords->Insert("select", Token->New(@line_num, Token->Type->SELECT_ID, "select_id"));
		@keywords->Insert("label", Token->New(@line_num, Token->Type->LABEL_ID, "label_id"));
		@keywords->Insert("break", Token->New(@line_num, Token->Type->BREAK_ID, "break_id"));
		@keywords->Insert("continue", Token->New(@line_num, Token->Type->CONTINUE_ID, "continue_id"));
		@keywords->Insert("return", Token->New(@line_num, Token->Type->RETURN_ID, "return_id"));
		@keywords->Insert("leaving", Token->New(@line_num, Token->Type->LEAVING_ID, "leaving_id"));
		@keywords->Insert("String", Token->New(@line_num, Token->Type->STRING_ID, "string_id"));
		@keywords->Insert("Int", Token->New(@line_num, Token->Type->INT_ID, "int_id"));
		@keywords->Insert("Float", Token->New(@line_num, Token->Type->FLOAT_ID, "float_id"));
		@keywords->Insert("Char", Token->New(@line_num, Token->Type->CHAR_ID, "char_id"));
		@keywords->Insert("Bool", Token->New(@line_num, Token->Type->BOOL_ID, "bool_id"));
		@keywords->Insert("Byte", Token->New(@line_num, Token->Type->BYTE_ID, "byte_id"));
		@keywords->Insert("Nil", Token->New(@line_num, Token->Type->NIL_ID, "nil_id"));
		@keywords->Insert("other", Token->New(@line_num, Token->Type->OTHER_ID, "other_id"));
		@keywords->Insert("otherwise", Token->New(@line_num, Token->Type->OTHERWISE_ID, "otherwise_id"));
	}

	method : NextChar() ~ Nil {
		if(@buffer_index < @buffer->Size()) {
			@cur_char := @buffer[@buffer_index++];
			@line_pos += 1;

			if(@buffer_index < @buffer->Size()) {
				@next_char := @buffer[@buffer_index];
			}
			else {
				@next_char := '\0';
			};
		}
		else {
			# '\0' is the end of the text: every loop below stops at it. They
			# did not, and an unterminated string, character or block comment,
			# or a line comment on the last line, spun the language server
			# forever on a formatting request. (This assigned a stray local,
			# 'next_char', not the field.)
			@cur_char := '\0';
			@next_char := '\0';
		};
	}

	# the text from 'start' up to the current character; all of the rest at the
	# end of the text, where the current character is not part of it
	method : TextFrom(start : Int) ~ String {
		if(@cur_char = '\0' & @buffer_index >= @buffer->Size()) {
			return String->New(@buffer, start, @buffer->Size() - start);
		};

		return String->New(@buffer, start, @buffer_index - 1 - start);
	}

	method : Whitespace() ~ Nil {
		new_line_count := 0;

		while(@cur_char = ' ' | @cur_char = '\t' | @cur_char = '\r' | @cur_char = '\n') {
			if(@cur_char = '\n') {
				@line_num += 1;
				new_line_count += 1;
				@line_pos := 1;
				@code_on_line := false;
			};

			NextChar();
		};
		
		if(new_line_count > 1) {
			for(i := 0; i < new_line_count; i += 2;) {
				@tokens->AddBack(Token->New(@line_num, Token->Type->VTAB, "vtab"));
			};
		};
	}

	# leave out the characters that are tokens of their own (for a caller that only counts braces)
	method : public : SetLenient() ~ Nil {
		@lenient := true;
	}

	# What a name may start with, as the compiler reads one: a letter of any
	# script (a name such as "Δ" stopped the formatter), '_', '@' for a field
	# and '$'. The five characters that are operators in the alternative
	# spelling are not letters.
	method : IsWordStart(c : Char) ~ Bool {
		if(c->IsChar() | c = '_' | c = '@' | c = '$') {
			return true;
		};

		if(c->As(Int) > 127) {
			return c <> '→' & c <> '←' & c <> '≠' & c <> '≥' & c <> '≤';
		};

		return false;
	}

	method : public : GetTokens() ~ Vector<Token> {
		return @tokens;
	}

	method : public : Scan() ~ Bool {
		NextChar();
		token_count := 0;

		while(@cur_char <> '\0') {
			# what was read last time round is on the line a comment may now follow
			if(@tokens->Size() > token_count) {
				@code_on_line := true;
			};
			token_count := @tokens->Size();
			Whitespace();
			token_count := @tokens->Size();
			span_start := Position();

			# comment
			if(@cur_char = '#') {
				after_hash := @buffer_index;
				NextChar();

				if(@cur_char = '~') {
					start := @buffer_index;
					NextChar();
					while(@cur_char <> '\0' & <>(@cur_char = '~' & @next_char = '#')) {
						if(@cur_char = '\n') {
							@line_num += 1;
							@line_pos := 1;
						};

						NextChar();
					};
					comment := TextFrom(start);
					NextChar();
					NextChar();

					# one that starts after code on its line is part of that line
					if(@code_on_line) {
						@tokens->AddBack(Token->New(@line_num, Token->Type->INLINE_COMMENT, comment));
					}
					else {
						@tokens->AddBack(Token->New(@line_num, Token->Type->MULTI_COMMENT, comment));
					};
				}
				else {
					start := after_hash;
					while(@cur_char <> '\0' & @cur_char <> '\n') {
						NextChar();
					};
					comment := TextFrom(start);
					if(comment->EndsWith('\r')) {
						comment->Pop();
					};

					# The newline that ends the comment is left for Whitespace to count.
					# It was taken here, uncounted: every token after a line comment was
					# numbered a line short, and a blank line after a comment was not
					# seen as one (it takes two newlines), so it was dropped. A comment
					# that follows code on its line is told apart from one on a line of
					# its own, so that the formatter can leave it where it is.
					if(@code_on_line) {
						@tokens->AddBack(Token->New(@line_num, Token->Type->TRAIL_COMMENT, comment));
					}
					else {
						@tokens->AddBack(Token->New(@line_num, Token->Type->LINE_COMMENT, comment));
					};
				};
			}
			# string literal; a '$' directly before the quote ($"C:\\temp") is part of it
			else if(@cur_char = '"' | (@cur_char = '$' & @next_char = '"')) {
				is_raw := @cur_char = '$';
				if(is_raw) {
					NextChar();
				};
				start := @buffer_index;
				NextChar();
				is_escape := false;

				while(@cur_char <> '\0' & (is_escape | @cur_char <> '"')) {
					if(is_escape) {
						is_escape := false;
					}
					else if(@cur_char = '\\') {
						is_escape := true;
					};

					NextChar();
				};
				string_lit := TextFrom(start);
				# a string the text ends inside has no closing quote, and is not given one
				unterminated := @cur_char = '\0';
				NextChar();

				if(unterminated) {
					open_lit := is_raw ? "$\"" : "\"";
					open_lit += string_lit;
					@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, open_lit));
				}
				else if(is_raw) {
					# written back whole, with its '$' against the quote
					raw_lit := "$\"";
					raw_lit += string_lit;
					raw_lit += '"';
					@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, raw_lit));
				}
				else {
					@tokens->AddBack(Token->New(@line_num, Token->Type->STRING_LIT, string_lit));
				};
			}
			# char const
			else if(@cur_char = '\'') {
				start := @buffer_index;
				NextChar();
				is_escape := false;

				while(@cur_char <> '\0' & (is_escape | @cur_char <> '\'')) {
					if(is_escape) {
						is_escape := false;
					}
					else if(@cur_char = '\\') {
						is_escape := true;
					};

					NextChar();
				};
				string_lit := TextFrom(start);
				unterminated := @cur_char = '\0';
				NextChar();

				if(unterminated) {
					open_lit := "'";
					open_lit += string_lit;
					@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, open_lit));
				}
				else {
					@tokens->AddBack(Token->New(@line_num, Token->Type->CHAR_LIT, string_lit));
				};
			}
			# keyword or variable
			else if(IsWordStart(@cur_char)) {
				start := @buffer_index - 1;
				while(IsWordStart(@cur_char) | @cur_char->IsDigit() | @cur_char = '.') {
					NextChar();
				};
				word := TextFrom(start);
				
				keyword := @keywords->Find(word);
				if(keyword = Nil) {
# "|{$word}"->Print();
					@tokens->AddBack(Token->New(@line_num, Token->Type->IDENT, word));
				}
				else {
					@tokens->AddBack(keyword->Copy(@line_num));
				};
			}
			# A number, read as the compiler reads one (core/compiler/scanner.cpp): it
			# starts with a digit, or a '.' that a digit follows, and never with a sign
			# (a sign is an operator of its own). Digits, '_' separators, a 0x, 0b or
			# 0o prefix, one '.', an exponent with its sign, and a 'u' suffix that ends
			# it. The literal is one token and is written back as it was read: split
			# anywhere, "1.5e-3", "1_000" or "0o17" came back as two tokens with a
			# space between them, which is not the number.
			else if(@cur_char->IsDigit() | (@cur_char = '.' & @next_char->IsDigit())) {
				start := @buffer_index - 1;
				radix_prefix := false;
				is_float := false;
				after_exponent := false;
				count := 0;
				done := false;

				while(<>done) {
					c := @cur_char;
					if(c = 'u' | c = 'U') {
						NextChar();
						done := true;
					}
					else if(after_exponent & (c = '+' | c = '-') & @next_char->IsDigit()) {
						after_exponent := false;
						NextChar();
					}
					else if(c->IsDigit() | c = '_' | (c >= 'a' & c <= 'f') | (c >= 'A' & c <= 'F')) {
						after_exponent := is_float & <>radix_prefix & (c = 'e' | c = 'E');
						NextChar();
					}
					else if(c = '.') {
						# a second '.', or one in a literal with a prefix, is not part of it
						if(is_float | radix_prefix) {
							done := true;
						}
						else {
							is_float := true;
							after_exponent := false;
							NextChar();
						};
					}
					else if(count = 1 & (c = 'x' | c = 'X' | c = 'o' | c = 'O') & @buffer[start] = '0') {
						radix_prefix := true;
						after_exponent := false;
						NextChar();
					}
					else {
						done := true;
					};
					count += 1;
				};

				# "0b..." needs no case above ('b' is a hex digit); it has no exponent either
				num_lit := TextFrom(start);
				@tokens->AddBack(Token->New(@line_num, Token->Type->NUM_LIT, num_lit));
			}
			else {
				select(@cur_char) {
					label '{' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->OCBRACE, "ocbrace"));
						NextChar();
					}

					label '}' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->CCBRACE, "ccbrace"));
						NextChar();
					}

					label '(' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->OPREN, "opern"));
						NextChar();
					}

					label ')' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->CPREN, "cpren"));
						NextChar();
					}

					label '[' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->OBRACE, "obrace"));
						NextChar();
					}

					label ']' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->CBRACE, "cbrace"));
						NextChar();
					}

					label ',' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->COMMA, "COMMA"));
						NextChar();
					}

					label ':' {
						if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->ASGN, "asgn"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->COLON, "colon"));
						};
						NextChar();
					}

					label '~' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->TILDE, "tilde"));
						NextChar();
					}

					label ';' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->SEMI, "semi"));
						NextChar();
					}

					label '+' {
						if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->ADD_ASN, "add_asn"));
							NextChar();
						}
						else if(@next_char = '+') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->ADD_ADD, "add_add"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->ADD, "add"));
						};
						NextChar();
					}

					label '-' {
						if(@next_char = '>') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->ASSESSOR, "assessor"));
							NextChar();
						}
						else if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SUB_ASN, "sub_asn"));
							NextChar();
						}
						else if(@next_char = '-') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SUB_SUB, "sub_sub"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SUB, "sub"));
						};
						NextChar();
					}

					label '→' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->ASSESSOR, "assessor"));
						NextChar();
					}

					label '←' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->ASGN, "asgn"));
						NextChar();
					}

					label '≠' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->NEQL, "neql"));
						NextChar();
					}

					label '≥' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->GTR_EQL, "gtr_eql"));
						NextChar();
					}
					
					label '≤' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->LESS_EQL, "less_eql"));
						NextChar();
					}

					label '*' {
						if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->MUL_ASN, "mul_asn"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->MUL, "mul"));
						};
						NextChar();
					}

					label '/' {
						if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->DIV_ASN, "div_asn"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->DIV, "div"));
						};
						NextChar();
					}

					label '%' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->MOD, "mod"));
						NextChar();
					}

					label '&' {
						if(@next_char = '&') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, "&&"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->AND, "and"));
						};
						NextChar();
					}

					label '|' {
						if(@next_char = '|') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, "||"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->OR, "or"));
						};
						NextChar();
					}

					label '?' {
						# '??' must scan as one token; emitting two QUESTIONs makes
						# the formatter write '? ?', which no longer compiles.
						# '?->' needs nothing here: it scans as QUESTION followed by
						# ASSESSOR, and neither adds a space between them.
						if(@next_char = '?') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->QUESTION_QUESTION, "question_question"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->QUESTION, "question"));
						};
						NextChar();
					}

					# The '\' that starts a function type ("\Int ~ Int") or a lambda
					# ("\^(a : Int) ~ Int => a + 1", "\Func->New(...)"). The label here
					# read '\'', a quote, which the character-literal case above always
					# takes first, so a backslash had no token and the formatter stopped
					# at the first one in a file.
					label '\\' {
						@tokens->AddBack(Token->New(@line_num, Token->Type->FWD_SLASH, "back_slash"));
						NextChar();
					}

					label '=' {
						# '=>' (a lambda's body, a 'match' arm) is one token. It was scanned
						# as '<>' with the '>' left behind, so formatting wrote '<> >'.
						if(@next_char = '>') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->LAMBDA, "lambda"));
							NextChar();
							NextChar();
						}
						else if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, "=="));
							NextChar();
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->EQL, "eql"));
							NextChar();
						};
					}

					label '<' {
						if(@next_char = '>') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->NEQL, "neql"));
							NextChar();
						}
						else if(@next_char = '<') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, "<<"));
							NextChar();
						}
						else if(@next_char = '=') {
							# '<=' was given the lambda's token, and formatting wrote '=>'
							@tokens->AddBack(Token->New(@line_num, Token->Type->LESS_EQL, "less_eql"));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->LESS, "less"));
						};
						NextChar();
					}

					label '>' {
						if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->GTR_EQL, "gtr_eql"));
							NextChar();
						}
						else {
							# One '>' at a time, also for ">>" and ">>>". The compiler reads
							# those as shifts and its parser takes them apart again when they
							# close type arguments ("Map<String, Vector<Int>>"), so which they
							# are is not known here. Each carries whether the next character
							# is another '>', and the formatter writes the run back unbroken.
							if(@next_char = '>') {
								@tokens->AddBack(Token->New(@line_num, Token->Type->GTR, "joined"));
							}
							else {
								@tokens->AddBack(Token->New(@line_num, Token->Type->GTR, "gtr"));
							};
						};
						NextChar();
					}

					# the alternative spellings: '==', '!=', '&&', '||', and '!'
					label '!' {
						if(@next_char = '=') {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, "!="));
							NextChar();
						}
						else {
							@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, "!"));
						};
						NextChar();
					}

					other {
						if(@cur_char <> '\0') {
							# Every other character is a token of its own and is written back
							# as it is: '^' (a lambda's "\^"), a '.' that stands alone, '`',
							# and anything a later compiler gives a meaning to. This used to
							# end the process ("--- [Other ...] ---" and exit 1): a formatter
							# cannot write what it did not read, but stopping lost the whole
							# file for one character. The line-depth scan (SetLenient) still
							# steps over them, since it counts braces and nothing else.
							if(<>@lenient) {
								@tokens->AddBack(Token->New(@line_num, Token->Type->SYMBOL, @cur_char->ToString()));
							};
							NextChar();
						};
					}
				};
			};

			# where in the text the token just read starts and ends
			span_end := Position();
			for(k := token_count; k < @tokens->Size(); k += 1;) {
				@tokens->Get(k)->SetSpan(span_start, span_end);
			};
		};

		return true;
	}

	# the index of the current character; the length of the text at its end
	method : Position() ~ Int {
		if(@cur_char = '\0' & @buffer_index >= @buffer->Size()) {
			return @buffer->Size();
		};

		return @buffer_index - 1;
	}
}

class Token {
	@line_num : Int;
	@type : Token->Type;
	@value : String;
	@start : Int;
	@end : Int;

	enum Type := -128 {
		AND_ID,
		OR_ID,
		XOR_ID,
		VIRTUAL_ID,
		BUNDLE_ID,
		INTERFACE_ID,
		IMPLEMENTS_ID,
		ENUM_ID,
		CONSTS_ID,
		REVERSE_ID,
		PARENT_ID,
		FROM_ID,
		TRUE_ID,
		FALSE_ID,
		NEW_ID,
		AS_ID,
		TYPE_OF_ID,
		CRITICAL_ID,
		LAMBDA,
# ---
		USE_ID,
		DO_ID,
		FOR_ID,
		EACH_ID,
		BREAK_ID,
		CONTINUE_ID,
		ALIAS_ID,
		RETURN_ID,
		LEAVING_ID,
		NIL_ID,
		STRING_ID,
		INT_ID,
		FLOAT_ID,
		CHAR_ID,
		BOOL_ID,
		BYTE_ID,
		CLASS_ID,
		FUNCTION_ID,
		METHOD_ID,
		PUBLIC_ID,
		PRIVATE_ID,
		NATIVE_ID,
		STATIC_ID,
		STRING_LIT,
		CHAR_LIT,
		NUM_LIT,
		ELSE_ID,
		IF_ID,
		WHILE_ID,
		SELECT_ID,
		LABEL_ID,
		OTHER_ID,
		OTHERWISE_ID,
		ASGN,
		CHAR,
		STR,
		VAR,
		OPREN,
		CPREN,
		OBRACE,
		CBRACE,
		OCBRACE,
		CCBRACE,
		ASSESSOR,
		AND,
		OR,
		QUESTION,
		QUESTION_QUESTION,
		DIV,
		MOD,
		MUL,
		ADD,
		SUB,
		DIV_ASN,
		MUL_ASN,
		ADD_ASN,
		SUB_ASN,
		ADD_ADD,
		SUB_SUB,
		COLON,
		SEMI,
		COMMA,
		TILDE,
		FWD_SLASH,
		LESS,
		LESS_EQL,
		GTR,
		GTR_EQL,
		EQL,
		NEQL,
		NOT,
		SYMBOL,
		IDENT,
		VTAB,
		LINE_COMMENT,
		TRAIL_COMMENT,
		MULTI_COMMENT,
		INLINE_COMMENT,
		EOS,
		OTHER
	}
	
	New(line_num : Int, type : Token->Type, value : String) {
		@line_num := line_num;
		@type := type;
		@value := value;
	}

	method : public : Copy(line_num : Int) ~ Token {
		return Token->New(line_num, @type, @value);
	}
	
	method : public : GetLine() ~ Int {
		return @line_num;
	}
	
	method : public : GetType() ~ Token->Type {
		return @type;
	}
	
	method : public : GetValue() ~ String {
		return @value;
	}

	# the token's place in the text it was read from: [start, end)
	method : public : SetSpan(start : Int, end : Int) ~ Nil {
		@start := start;
		@end := end;
	}

	method : public : GetStart() ~ Int {
		return @start;
	}

	method : public : GetEnd() ~ Int {
		return @end;
	}
}