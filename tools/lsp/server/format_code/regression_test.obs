use Collection;

#~
Regression tests for LSP code formatter and new LSP features
(document highlight, folding range, selection range).
~#
class FormatterRegressionTest {
	@passed : static : Int;
	@failed : static : Int;

	function : Check(name : String, ok : Bool) ~ Nil {
		if(ok) {
			"  [PASS] {$name}"->PrintLine();
			@passed += 1;
		}
		else {
			"  [FAIL] {$name}"->PrintLine();
			@failed += 1;
		};
	}

	function : Main(args : String[]) ~ Nil {
		"=== Formatter Regression Tests ==="->PrintLine();

		TestBasicFormatting();
		TestTabIndentation();
		TestSpaceIndentation();
		TestCommentPreservation();
		TestStringLiteralPreservation();
		TestRangeFormatting();
		TestTrimTrailing();
		TestKeywordFormatting();
		TestOperatorSpacing();
		TestNilSafeOperators();
		TestArrowAndCompare();
		TestNestedBlocks();
		TestAfterClosingBrace();
		TestLineDepths();
		TestDeclarationAfterBrace();
		TestParentKeyword();
		TestLambdasAndFunctionTypes();
		TestNumbers();
		TestOperatorsKept();
		TestLiteralsVerbatim();
		TestCommentsAndBlankLines();
		TestLineBreaksKept();
		TestEveryCharacterIsRead();

		p := @passed;
		f := @failed;
		"\n  Results: {$p} passed, {$f} failed"->PrintLine();
		if(@failed > 0) {
			Runtime->Exit(1);
		};
	}

	function : TestBasicFormatting() ~ Nil {
		"\n>> Basic formatting..."->PrintLine();

		src := "class Foo{@x:Int;New(){@x:=0;}method:public:GetX()~Int{return @x;}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Basic: result not nil", result <> Nil);
		Check("Basic: contains class keyword", result->Find("class") > -1);
		Check("Basic: contains newlines", result->Find("\n") > -1);
		Check("Basic: opening brace on same line", result->Find("{\n") > -1);
	}

	function : TestTabIndentation() ~ Nil {
		"\n>> Tab indentation..."->PrintLine();

		src := "class Foo{New(){@x:=1;}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Tabs: result not nil", result <> Nil);
		Check("Tabs: contains tab chars", result->Find("\t") > -1);
	}

	function : TestSpaceIndentation() ~ Nil {
		"\n>> Space indentation..."->PrintLine();

		src := "class Foo{New(){@x:=1;}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "4");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Spaces: result not nil", result <> Nil);
		# with ident-space=4, should not have tab chars
		Check("Spaces: no tab chars", result->Find("\t") = -1);
	}

	function : TestCommentPreservation() ~ Nil {
		"\n>> Comment preservation..."->PrintLine();

		src := "class Foo{# line comment\nNew(){#~ multi\ncomment ~#@x:=1;}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Comments: result not nil", result <> Nil);
		Check("Comments: line comment preserved", result->Find("# line comment") > -1);
		Check("Comments: multi-comment start preserved", result->Find("#~") > -1);
		Check("Comments: multi-comment end preserved", result->Find("~#") > -1);
	}

	function : TestStringLiteralPreservation() ~ Nil {
		"\n>> String literal preservation..."->PrintLine();

		src := "class Foo{New(){@x:=\"hello world\";}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Strings: result not nil", result <> Nil);
		Check("Strings: literal preserved", result->Find("\"hello world\"") > -1);
	}

	function : TestRangeFormatting() ~ Nil {
		"\n>> Range formatting..."->PrintLine();

		src := "class Foo{\nNew(){\n@x:=1;\n}\n}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("start-line", "2");
		options->Insert("end-line", "3");

		result := CodeFormatter->New(options)->Format(src);

		Check("Range: result not nil", result <> Nil);
		Check("Range: result not empty", result->Size() > 0);
	}

	function : TestTrimTrailing() ~ Nil {
		"\n>> Trim trailing..."->PrintLine();

		src := "class Foo{New(){@x:=1;}}   ";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Trim: result not nil", result <> Nil);
		Check("Trim: no trailing spaces", <>result->EndsWith(" "));
		Check("Trim: no trailing tabs", <>result->EndsWith("\t"));
	}

	function : TestKeywordFormatting() ~ Nil {
		"\n>> Keyword formatting..."->PrintLine();

		src := "class Bar{method:public:DoIt()~Nil{if(true){return;}else{x:=1;}}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Keywords: result not nil", result <> Nil);
		Check("Keywords: 'class' present", result->Find("class") > -1);
		Check("Keywords: 'method' present", result->Find("method") > -1);
		Check("Keywords: 'public' present", result->Find("public") > -1);
		Check("Keywords: 'if' present", result->Find("if") > -1);
		Check("Keywords: 'else' present", result->Find("else") > -1);
		Check("Keywords: 'return' present", result->Find("return") > -1);
	}

	function : TestOperatorSpacing() ~ Nil {
		"\n>> Operator spacing..."->PrintLine();

		src := "class Foo{New(){@x:=1+2;@y:=3*4;}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Operators: result not nil", result <> Nil);
		Check("Operators: assignment ':=' present", result->Find(":=") > -1);
		Check("Operators: '+' present", result->Find("+") > -1);
		Check("Operators: '*' present", result->Find("*") > -1);
	}

	function : TestNilSafeOperators() ~ Nil {
		"\n>> Nil-safe operators..."->PrintLine();

		# '??' has to survive as one token. Scanning it as two QUESTIONs made the
		# formatter emit '? ?', which does not compile -- formatting a file would
		# silently break it.
		src := "class Foo{New(){@a:=@s??\"d\";@b:=@s?->ToUpper();@c:=@s?->ToUpper()??\"d\";}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Nil-safe: result not nil", result <> Nil);
		Check("Nil-safe: '??' not split into '? ?'", result->Find("? ?") = -1);
		Check("Nil-safe: '??' present", result->Find("??") > -1);
		Check("Nil-safe: '?->' present", result->Find("?->") > -1);

		# a plain ternary must still format, and '?-' must not be mistaken for
		# the start of '?->'
		ternary_src := "class Bar{New(){@a:=true?1:2;@b:=true?-1:2;}}";
		ternary := CodeFormatter->New(options)->Format(ternary_src);

		Check("Nil-safe: ternary still formats", ternary <> Nil);
		Check("Nil-safe: ternary '?' preserved", ternary->Find("?") > -1);
	}

	function : TestArrowAndCompare() ~ Nil {
		"\n>> '=>' and '<='..."->PrintLine();

		# '<=' was scanned as the lambda arrow and written back as '=>', and '=>'
		# as '<>' followed by a stray '>': formatting changed what a file means.
		src := "class Foo{function:F(a:Int,b:Int)~Bool{c:=a<=b;d:=a>=b;e:=a<>b;return c;}function:G(k:Int)~String{return match k{1=>\"one\",2|3=>\"few\",other=>\"many\"};}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Arrow: result not nil", result <> Nil);
		Check("Arrow: '<=' kept", result->Find("a <= b") > -1);
		Check("Arrow: '>=' kept", result->Find("a >= b") > -1);
		Check("Arrow: '<>' kept", result->Find("a <> b") > -1);
		Check("Arrow: '=>' kept", result->Find("1 => \"one\"") > -1 & result->Find("other => \"many\"") > -1);
		Check("Arrow: '=>' not split", result->Find("<> >") = -1 & result->Find("= >") = -1);
		Check("Arrow: patterns kept", result->Find("2 | 3 =>") > -1);
	}

	function : TestDeclarationAfterBrace() ~ Nil {
		"\n>> Declarations after a closing brace..."->PrintLine();

		# The second class of a file came back as 'classB' (it no longer compiled),
		# a second function as 'function: G', and an enum, consts, alias, interface
		# or bundle stayed on the line of the '}' before it.
		src := "class A{function:F()~Nil{}function:G()~Nil{}method:public:M()~Nil{}}class B{New(){}}interface I{}enum E{X,Y}consts K{Z:=1}alias Fn{F:(Int)~Int}bundle Bb{class C{}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("After brace: result not nil", result <> Nil);
		Check("After brace: 'class B' keeps its space", result->Find("class B {") > -1 & result->Find("classB") = -1);
		Check("After brace: 'function : G' keeps its space", result->Find("function : G()") > -1 & result->Find("function:") = -1);
		Check("After brace: 'method : public' keeps its space", result->Find("method : public : M()") > -1 & result->Find("method:") = -1);
		Check("After brace: interface on its own line", result->Find("}interface") = -1 & result->Find("\ninterface I {") > -1);
		Check("After brace: enum on its own line", result->Find("}enum") = -1 & result->Find("\nenum E {") > -1);
		Check("After brace: consts on its own line", result->Find("}consts") = -1 & result->Find("\nconsts K {") > -1);
		Check("After brace: alias on its own line", result->Find("}alias") = -1 & result->Find("\nalias Fn {") > -1);
		Check("After brace: bundle on its own line", result->Find("}bundle") = -1 & result->Find("\nbundle Bb {") > -1);
		Check("After brace: first class unchanged", result->Find("class A {") = 0);
	}

	function : TestNestedBlocks() ~ Nil {
		"\n>> Nested blocks..."->PrintLine();

		src := "class Foo{method:public:Do()~Nil{each(i:items){if(i>0){x:=i;}}}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);

		Check("Nested: result not nil", result <> Nil);

		# count opening braces - should match closing braces
		open_count := 0;
		close_count := 0;
		each(i : result) {
			if(result->Get(i) = '{') {
				open_count += 1;
			}
			else if(result->Get(i) = '}') {
				close_count += 1;
			};
		};
		Check("Nested: brace balance", open_count = close_count);
		Check("Nested: has 4 brace pairs", open_count = 4);
	}

	# A constructor, field, comment or statement that follows a closing brace with
	# no blank line between them. The formatter joins the next token to a '}' so
	# that "};" and "})" stay together, and these were joined too: "}New() {",
	# "}@y : Int;", "}# note". A constructor's line also lost one character of its
	# indentation, and an empty block kept a line of indentation in it. (A class,
	# method, enum or other declaration keyword after a brace is a separate case,
	# with its own tests.)
	function : TestAfterClosingBrace() ~ Nil {
		"\n>> A constructor, field, comment or statement after a closing brace..."->PrintLine();

		src := "class A {\n@x : Int;\nNew() {\n@x := 1;\n}\nNew(x : Int) {\n@x := x;\n}\n@y : Int;\nmethod : public : F() ~ Nil {\nif(@x > 1) {\n@x := 2;\n}\n# note\nb := A->New();\ndo {\n@x += 1;\n}\nwhile(@x > 5);\nc := [1, 2];\neach(i : c) {\n@x += c[i];\n};\n}\n\nmethod : public : G() ~ Nil {\n}\n}\n";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);
		Check("After '}': result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("After '}': a constructor after a field keeps its indentation", result->Find("@x : Int;\n  New() {") > -1);
		Check("After '}': a constructor starts its own line, set apart", result->Find("}New") < 0 & result->Find("  }\n\n  New(x : Int) {") > -1);
		Check("After '}': a field starts its own line", result->Find("  }\n  @y : Int;") > -1);
		Check("After '}': a comment starts its own line", result->Find("    }\n    # note\n") > -1);
		Check("After '}': the statement after that comment is unchanged", result->Find("    # note\n    b := A->New();") > -1);
		Check("After '}': a do-while's while stays on the brace's line", result->Find("    }while(@x") > -1);
		Check("After '}': a semi-colon stays on the brace's line", result->Find("    };\n  }") > -1);
		Check("After '}': an empty block has no line of indentation in it", result->Find("G() ~ Nil {\n  }") > -1);
		Check("After '}': the last brace ends the source", result->EndsWith("  }\n}"));

		again := CodeFormatter->New(options)->Format(result);
		Check("After '}': formatting the result again changes nothing", again <> Nil & again->Equals(result));

		# with the blank line already there, it is kept once
		spaced := CodeFormatter->New(options)->Format("class A {\n@x : Int;\nNew() {\n@x := 1;\n}\n\nNew(x : Int) {\n@x := x;\n}\n}\n");
		Check("After '}': a blank line before a constructor is kept, once", spaced <> Nil & spaced->Find("  }\n\n  New(x : Int) {") > -1 & spaced->Find("\n\n\n") < 0);

		# "->New" still joins the arrow
		Check("After '}': '->New' has no space after the arrow", result->Find("A->New();") > -1);
	}

	function : TestLineDepths() ~ Nil {
		"\n>> Line depths (on-type formatting)..."->PrintLine();

		# line 1 is the first. Line comments and a multi-line comment sit in the
		# middle: the scanner numbers the lines after a line comment one short,
		# and a block comment by the line it ends on, and the depths must not.
		src := "class Foo {\n  # a line comment\n  method : public : Do() ~ Nil {\n    #~\n    block\n    ~#\n    if(true) {\n      x := 1;\n\n  }\n  # another\n  y := 2;\n}\n}\n";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		formatter := CodeFormatter->New(options);
		depths := formatter->LineDepths(src, 14);

		Check("Depths: scans", depths <> Nil);
		Check("Depths: class line is 0", depths[1] = 0);
		Check("Depths: a line comment takes the depth around it", depths[2] = 1);
		Check("Depths: the method's line", depths[3] = 1);
		Check("Depths: a block comment is left alone", depths[4] = -1 & depths[5] = -1 & depths[6] = -1);
		Check("Depths: the line after a block comment", depths[7] = 2);
		Check("Depths: inside the if", depths[8] = 3);
		Check("Depths: a blank line has the depth around it", depths[9] = 3);
		Check("Depths: a closing brace is one level out", depths[10] = 2);
		Check("Depths: after a line comment the lines still count", depths[11] = 2 & depths[12] = 2);
		Check("Depths: the last closing brace is 0", depths[14] = 0);

		# a function type's '\' has no token; the formatter stops at it, the depths step over it
		backslash := "class Foo {\n  method : public : Do() ~ Nil {\n    f : \\Funcs->Op := Twice(Int) ~ Int;\n  }\n}\n";
		slashed := formatter->LineDepths(backslash, 5);
		Check("Depths: a function type does not end the scan", slashed <> Nil & slashed[3] = 2 & slashed[4] = 1);

		Check("Indent: spaces, two levels", formatter->IndentFor(2)->Equals("    "));
		Check("Indent: none", formatter->IndentFor(0)->Equals(""));

		tabs := CodeFormatter->New(Map->New()<String, String>);
		Check("Indent: tabs without a width", tabs->IndentFor(2)->Equals("\t\t"));
	}

	# The keyword is 'Parent'. The formatter wrote it 'parent', which is a name:
	# a constructor's "Parent();" came back as a call to nothing, and the class
	# no longer compiled ("Parent call required").
	function : TestParentKeyword() ~ Nil {
		"\n>> 'Parent' keeps its capital..."->PrintLine();

		src := "class Base{New(){}New(n:Int){}}class Kid from Base{New(){Parent();}New(n:Int){Parent(n);}method:public:Up()~Base{return Parent;}}";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);
		Check("Parent: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Parent: the call with no arguments", result->Find("Parent();") > -1);
		Check("Parent: the call with an argument", result->Find("Parent(n);") > -1);
		Check("Parent: as a value", result->Find("return Parent;") > -1);
		Check("Parent: never written in lower case", result->Find("parent") < 0);

		again := CodeFormatter->New(options)->Format(result);
		Check("Parent: formatting the result again changes nothing", again <> Nil & again->Equals(result));
	}

	# The '\' that starts a lambda or a function type had no token: the scanner's
	# case for it was written for a quote, which the character-literal case always
	# takes first. The formatter printed "--- [Other ...] ---" and ended the
	# process at the first backslash in a file.
	function : TestLambdasAndFunctionTypes() ~ Nil {
		"\n>> Lambdas and function types..."->PrintLine();

		src := "class A {\nfunction : Main(args : String[]) ~ Nil {\nf := \\(Int) ~ Int : (x) => x + 1;\ng := Apply(\\(a, b) => a + b);\nh := \\() => {\nreturn 1;\n};\nk := \\() ~ Int : () => f(2);\n}\nfunction : Apply(f : (Int, Int) ~ Int) ~ Int {\nreturn f(1, 2);\n}\n}\n";

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		options->Insert("trim-trailing", "true");

		result := CodeFormatter->New(options)->Format(src);
		Check("Lambda: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Lambda: a typed lambda", result->Find("f := \\(Int) ~ Int : (x) => x + 1;") > -1);
		Check("Lambda: a bare lambda as an argument", result->Find("g := Apply(\\(a, b) => a + b);") > -1);
		Check("Lambda: a lambda with a block body", result->Find("h := \\() => {\n      return 1;\n    };") > -1);
		Check("Lambda: no parameters, a call in the body", result->Find("k := \\() ~ Int : () => f(2);") > -1);
		Check("Lambda: a function type as a parameter", result->Find("Apply(f : (Int, Int) ~ Int) ~ Int {") > -1);
		Check("Lambda: the '\\' stays against what it starts", result->Find("\\ ") < 0);

		again := CodeFormatter->New(options)->Format(result);
		Check("Lambda: formatting the result again changes nothing", again <> Nil & again->Equals(result));
	}

	function : FormatBody(body : String) ~ String {
		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		options->Insert("trim-trailing", "true");

		src := "class A {\nfunction : Main(args : String[]) ~ Nil {\n";
		src += body;
		src += "\n}\n}\n";

		return CodeFormatter->New(options)->Format(src);
	}

	function : FormatsOnce(text : String) ~ Bool {
		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		options->Insert("trim-trailing", "true");

		again := CodeFormatter->New(options)->Format(text);
		return again <> Nil & again->Equals(text);
	}

	# A number is one token, read as the compiler reads one. The scanner took a
	# sign as part of it and stopped at an exponent's sign, a '_' or an octal
	# prefix, so "1.5e-3" came back as "1.5e -3" and "1_000" stopped the formatter.
	function : TestNumbers() ~ Nil {
		"\n>> Number literals and signs..."->PrintLine();

		result := FormatBody("a := 1.5e-3; b := 0x1F; c := 1_000; d := 0b1010; e := 0o17; f := 255u; g := .5; h := 2.0E+10;\ni := -1; j := a - 1; k := a-1; l := -a; m := F(-1, +2); n := a * -b; o := (a) - 1; p := v[0] - 1; q := a+-1;");
		Check("Numbers: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Numbers: an exponent with a sign", result->Find("a := 1.5e-3;") > -1 & result->Find("h := 2.0E+10;") > -1);
		Check("Numbers: hexadecimal, binary and octal", result->Find("b := 0x1F;") > -1 & result->Find("d := 0b1010;") > -1 & result->Find("e := 0o17;") > -1);
		Check("Numbers: a separator and an unsigned suffix", result->Find("c := 1_000;") > -1 & result->Find("f := 255u;") > -1);
		Check("Numbers: a leading decimal point", result->Find("g := .5;") > -1);
		Check("Numbers: a sign stays against its operand", result->Find("i := -1;") > -1 & result->Find("l := -a;") > -1 & result->Find("m := F(-1, +2);") > -1 & result->Find("n := a * -b;") > -1);
		Check("Numbers: a subtraction is spaced, however it was written", result->Find("j := a - 1;") > -1 & result->Find("k := a - 1;") > -1);
		Check("Numbers: a subtraction after ')' and ']'", result->Find("o := (a) - 1;") > -1 & result->Find("p := v[0] - 1;") > -1);
		Check("Numbers: an operator and a sign stay two tokens", result->Find("q := a + -1;") > -1);
		Check("Numbers: formatting the result again changes nothing", FormatsOnce(result));
	}

	# Every operator the compiler reads is read here, and none is made or broken
	# by taking a space away: '<' then '>' is not "<>", ':' then '=' is not ":=".
	function : TestOperatorsKept() ~ Nil {
		"\n>> Operators stay what they were..."->PrintLine();

		result := FormatBody("if(a << 2 >> 1 = 0 & b <> c & <>d) {\ne := f ?? g;\nh := i?->J();\nk := a < b;\nl := Map->New()<String, Vector<IntRef>>;\nm : Vector<String>;\nn := a < 2;\no := x ? 1 : 2;\np := a ^ b;\nq := i++;\nr := --i;\n};");
		Check("Operators: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Operators: shifts", result->Find("a << 2 >> 1 = 0") > -1);
		Check("Operators: 'not' against its operand, '<>' between two", result->Find("b <> c & <>d") > -1);
		Check("Operators: '??'", result->Find("e := f ?? g;") > -1);
		Check("Operators: the Nil-safe call", result->Find("h := i?->J();") > -1);
		Check("Operators: a comparison is spaced on both sides", result->Find("k := a < b;") > -1 & result->Find("n := a < 2;") > -1);
		Check("Operators: type arguments sit against their type", result->Find("l := Map->New()<String, Vector<IntRef>>;") > -1 & result->Find("m : Vector<String>;") > -1);
		Check("Operators: a conditional", result->Find("o := x ? 1 : 2;") > -1);
		Check("Operators: a character with no rule of its own is kept", result->Find("p := a ^ b;") > -1);
		Check("Operators: increment and decrement", result->Find("q := i++;") > -1 & result->Find("r := --i;") > -1);
		Check("Operators: formatting the result again changes nothing", FormatsOnce(result));

		# written with no spaces at all, the same tokens come back
		tight := FormatBody("a:=b<c;d:=e>f;g:=h<>i;j:=k<=l;m:=n>=o;p:=q-1;r:=s- -1;t:=u+ +1;v:=w->X()-1;");
		Check("Operators: a tight line is spaced, not rejoined", tight <> Nil & tight->Find("a := b < c;") > -1 & tight->Find("d := e > f;") > -1 &
			tight->Find("g := h <> i;") > -1 & tight->Find("j := k <= l;") > -1 & tight->Find("m := n >= o;") > -1 & tight->Find("p := q - 1;") > -1 &
			tight->Find("r := s - -1;") > -1 & tight->Find("t := u + +1;") > -1 & tight->Find("v := w->X() - 1;") > -1);
	}

	# A literal is written back as it was read. A string that ended "; " or "} "
	# lost its last space to the rule that tidies the space after a ';' or '}'.
	function : TestLiteralsVerbatim() ~ Nil {
		"\n>> Literals are written back whole..."->PrintLine();

		# an interpolated string, put together here so that this file does not interpolate it
		interpolated := "f := \"{";
		interpolated += "$a} and {";
		interpolated += "$b}\";";

		body := "a := \"x; \"; b := \"y} \"; c := ';'; d := '}'; e := $\"C:\\\\temp\"; g := '\\''; h := \" \"; ";
		body += interpolated;
		result := FormatBody(body);
		Check("Literals: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Literals: a string ending in \"; \"", result->Find("a := \"x; \";") > -1);
		Check("Literals: a string ending in \"} \"", result->Find("b := \"y} \";") > -1);
		Check("Literals: the characters ';' and '}'", result->Find("c := ';';") > -1 & result->Find("d := '}';") > -1);
		Check("Literals: a '$' string keeps its '$' against the quote", result->Find("e := $\"C:\\\\temp\";") > -1);
		Check("Literals: an interpolated string", result->Find(interpolated) > -1);
		Check("Literals: an escaped quote character and a lone space", result->Find("g := '\\'';") > -1 & result->Find("h := \" \";") > -1);
		Check("Literals: formatting the result again changes nothing", FormatsOnce(result));

		# a map or JSON literal is an expression: it stays in its line
		maps := FormatBody("m := {\"a\": 1, \"b\": {\"c\": [1, 2]}}; e := {}; o := {\"p\": {}}; n := F({\"k\": \"v\"});");
		Check("Literals: a map literal stays in its line", maps <> Nil & maps->Find("m := {\"a\": 1, \"b\": {\"c\": [1, 2]}};") > -1);
		Check("Literals: an empty literal, and one as an argument", maps <> Nil & maps->Find("e := {};") > -1 & maps->Find("o := {\"p\": {}};") > -1 & maps->Find("n := F({\"k\": \"v\"});") > -1);
		Check("Literals: formatting a map literal again changes nothing", maps <> Nil & FormatsOnce(maps));
	}

	# Comments and blank lines stay where they were put.
	function : TestCommentsAndBlankLines() ~ Nil {
		"\n>> Comments and blank lines keep their place..."->PrintLine();

		result := FormatBody("a := 1; # one\nb := 2;\n# own line\nc := 3;\n\n# after a blank line\nd := 4;\n\n\n\ne := 5;\nif(a = 1) { # why\nf := 6;\n}\n# before else\nelse {\ng := [ # first\n1,\n2];\n};");
		Check("Comments: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Comments: one after a statement stays on its line", result->Find("    a := 1; # one\n    b := 2;\n") > -1);
		Check("Comments: one on its own line keeps it", result->Find("    b := 2;\n    # own line\n    c := 3;\n") > -1);
		Check("Comments: a blank line before a comment is kept", result->Find("    c := 3;\n\n    # after a blank line\n    d := 4;\n") > -1);
		Check("Comments: several blank lines are one", result->Find("    d := 4;\n\n    e := 5;\n") > -1 & result->Find("\n\n\n") < 0);
		Check("Comments: one after '{' stays on its line", result->Find("    if(a = 1) { # why\n      f := 6;\n    }\n") > -1);
		Check("Comments: one before 'else' leaves no line of indentation", result->Find("    }\n    # before else\n    else {\n") > -1);
		Check("Comments: one after '[' stays on its line", result->Find("g := [ # first\n") > -1);
		Check("Comments: no line holds only indentation", result->Find(" \n") < 0 & result->Find("\t\n") < 0);
		Check("Comments: formatting the result again changes nothing", FormatsOnce(result));

		options := Map->New()<String, String>;
		options->Insert("function-space", "false");
		options->Insert("ident-space", "2");
		options->Insert("trim-trailing", "true");
		header := CodeFormatter->New(options)->Format("#~\nWhat this file is.\n~#\nuse Collection;\n\n#~ about A ~#\nclass A {\n#~\nabout F\n~#\nfunction : F(a : Int #~ in ~#, b : Int) ~ Nil {\n}\n}\n");
		Check("Comments: a block comment on its own lines ends its line", header <> Nil & header->Find("~#\nuse Collection;\n\n#~ about A ~#\nclass A {\n") > -1);
		Check("Comments: a block comment before a member", header <> Nil & header->Find("  #~\nabout F\n~#\n  function : F(") > -1);
		Check("Comments: a block comment inside a line stays inside it", header <> Nil & header->Find("F(a : Int #~ in ~#, b : Int) ~ Nil {") > -1);
		Check("Comments: formatting block comments again changes nothing", header <> Nil & FormatsOnce(header));
	}

	# A line break inside a statement is kept; "for" keeps its parts apart.
	function : TestLineBreaksKept() ~ Nil {
		"\n>> Line breaks inside a statement are kept..."->PrintLine();

		result := FormatBody("x := F(1,\n2,\n3);\ny := a +\nb;\nfor(i := 0; i < 10; i += 1;) {\nz := i;\n};\nw := G(1, 2, 3);");
		Check("Breaks: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Breaks: arguments on their own lines stay there", result->Find("    x := F(1,\n      2,\n      3);\n") > -1);
		Check("Breaks: an expression continued on the next line", result->Find("    y := a +\n      b;\n") > -1);
		Check("Breaks: the parts of a for are set apart", result->Find("for(i := 0; i < 10; i += 1;) {") > -1);
		Check("Breaks: a statement on one line stays on one", result->Find("    w := G(1, 2, 3);") > -1);
		Check("Breaks: formatting the result again changes nothing", FormatsOnce(result));
	}

	# A character the scanner has no token for is written back; a name may be
	# written in any script. Each used to end the process.
	function : TestEveryCharacterIsRead() ~ Nil {
		"\n>> Characters with no rule, and names in any script..."->PrintLine();

		result := FormatBody("Δ := 1; größe := Δ + 1; s := a ` b; t := c . d;");
		Check("Characters: result not nil", result <> Nil);
		if(result = Nil) {
			return;
		};

		Check("Characters: a name that is not ASCII", result->Find("Δ := 1;") > -1 & result->Find("größe := Δ + 1;") > -1);
		Check("Characters: one with no token is kept", result->Find("`") > -1 & result->Find("c . d") > -1);
		Check("Characters: formatting the result again changes nothing", FormatsOnce(result));
	}
}
