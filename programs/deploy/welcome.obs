#~
# The index of the example programs that ship with Objeck.
#
# This is the first thing to run in this folder. It needs no libraries and no
# display, so it works over SSH and in a container, and it prints the exact
# command for every other example here.
#
# compile: obc -src welcome.obs
# run:     obr welcome.obe
#
# The table below is checked by tools/cicd/check_examples_index.py: every .obs
# in this folder must appear here, every file named here must exist, and the
# library list of each row must be the one that actually compiles it. Add a row
# when you add an example, or CI fails.
~#

class Welcome {
	function : Main(args : String[]) ~ Nil {
		files := [
			"hello_0.obs", "values_1.obs", "control_flow_2.obs", "functions_3.obs",
			"classes_4.obs", "records_enums_5.obs", "errors_6.obs", "generics_7.obs",
			"closures_8.obs", "arrays_9.obs", "strings_10.obs", "collections_11.obs",
			"threads_12.obs", "files_13.obs", "json_14.obs", "xml_15.obs",
			"csv_16.obs", "regex_17.obs", "sql_tables_18.obs", "sql_files_19.obs",
			"serialize_20.obs", "odbc_21.obs", "http_client_22.obs", "web_server_23.obs",
			"rss_reader_24.obs", "ml_regression_25.obs", "ml_classify_26.obs", "ml_outliers_27.obs",
			"nlp_28.obs", "llm_29.obs", "ai_search_30.obs", "game_31.obs"];

		libs := [
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"",
			"cipher",
			"",
			"concurrent",
			"",
			"json,json_stream",
			"xml",
			"csv",
			"regex",
			"query,misc,net,json,regex,xml,csv,cipher",
			"query,misc,net,json,regex,xml,csv,cipher",
			"",
			"odbc",
			"net,json,cipher",
			"net,net_server,json,cipher",
			"rss,xml,net,cipher",
			"csv,ml",
			"csv,ml",
			"csv,ml",
			"nlp",
			"gemini,net,net_server,json,misc,cipher",
			"ai",
			"sdl2,sdl_game,json"];

		about := [
			"a class, a function, Main, and one line of output",
			"types, literals, variables, interpolation and conversions",
			"if, select, while, do/while, for, each, break and continue",
			"functions, default and named arguments, ref parameters, recursion",
			"classes, inheritance, virtual methods, interfaces and Stringify",
			"records, readonly records, enums and consts",
			"custom errors, try/on/finally, built-in errors and ?-> recovery",
			"generic classes, bounded generic functions, Vector and Map",
			"functions as values, lambdas and closures",
			"arrays: literals, 2-D, jagged, sorting, Fill and Copy",
			"string methods, comparison, formatting, SHA-256 and Base64",
			"Vector, List, Map, Hash, Set, Stack, Queue, unboxed collections",
			"threads, critical sections and a CountDownLatch",
			"write, read, append and list files and folders",
			"parse, walk, query and build JSON; stream a file",
			"parse XML, walk elements and attributes, build XML",
			"read CSV by row and column, quoted fields, write CSV",
			"match, find all, capture groups, replace and split",
			"SQL over in-memory tables: group by, indexes, Explain",
			"SQL over CSV and JSON files and a folder, with a join",
			"save objects to a file and load them back",
			"a database through ODBC: prepared inserts and queries",
			"HTTPS GET: status, headers, JSON and failure handling",
			"a two-route web server that tests itself and stops",
			"fetch an RSS feed and list the latest headlines",
			"linear and logistic regression with a test split",
			"random forest, cross-validation and a confusion matrix",
			"anomaly detection with isolation forest and LOF",
			"tokenizing, stemming, sentiment and TF-IDF search",
			"ask a large language model (Gemini) a question",
			"A* pathfinding and minimax",
			"an SDL2 game: collect gems, dodge spiders, keep a best score"];

		""->PrintLine();
		"Objeck example programs"->PrintLine();
		"======================="->PrintLine();
		""->PrintLine();
		"Every file listed below is in this folder. Compile one, then run it:"->PrintLine();
		""->PrintLine();
		"    obc -src hello_0.obs"->PrintLine();
		"    obr hello_0.obe"->PrintLine();
		""->PrintLine();
		"When a program needs libraries, pass the list in its LIBRARIES column:"->PrintLine();
		""->PrintLine();
		"    obc -src json_14.obs -lib json,json_stream"->PrintLine();
		"    obr json_14.obe"->PrintLine();
		""->PrintLine();

		header := Pad("  FILE", 24) + Pad("LIBRARIES (-lib ...)", 44) + "WHAT IT SHOWS";
		header->PrintLine();
		rule := Pad("  ----", 24) + Pad("--------------------", 44) + "-------------";
		rule->PrintLine();

		each(i : files) {
			file := files[i];
			lib := libs[i];
			desc := about[i];
			if(lib->Size() = 0) {
				lib := "(none)";
			};
			# The indent is concatenated into a local BEFORE it is passed. Passing
			# "  " + file straight into Pad() inside this expression prints the
			# file name twice -- issue #750, a compiler defect, not a style choice.
			indented := "  " + file;
			line := Pad(indented, 24) + Pad(lib, 44) + desc;
			line->PrintLine();
		};

		""->PrintLine();
		"Notes"->PrintLine();
		"-----"->PrintLine();
		"  Read them in order: 0-13 teach the language, 14-21 data, 22-24 networking,"->PrintLine();
		"  25-30 AI and machine learning, and 31 is a game."->PrintLine();
		"  game_31 opens a window, so it needs a display (not SSH or a container)."->PrintLine();
		"  odbc_21 needs a configured data source, llm_29 needs an API key, and"->PrintLine();
		"  http_client_22 and rss_reader_24 need the internet."->PrintLine();
		"  The OpenGL examples, gl_fps among them, ship in the opengl folder beside this one."->PrintLine();
		""->PrintLine();
	}

	function : Pad(text : String, width : Int) ~ String {
		out := "";
		out += text;
		i := text->Size();
		while(i < width) {
			out += " ";
			i += 1;
		};

		return out;
	}
}
