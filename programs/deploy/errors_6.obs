#~
# compile: obc -src errors_6.obs
# run:     obr errors_6.obe
#
# Handling errors. When something goes wrong, a program can raise an error:
# an object describing the problem. Runtime->Raise raises any Error, or a
# subclass you write yourself, and it travels up through the calls until a
# 'try' that asks for it catches it. The runtime's own faults are errors too:
# NilError, IndexError, DivideByZeroError, CastError and RuntimeError.
#
#   try { ... }
#   on(e : ConfigError) { ... }   # clauses are tested in order; e is typed
#   on(e : Error) { ... }         # so a catch-all goes last
#   finally { ... };              # runs on every way out
#
# An error that no 'on' clause names carries on after 'finally', so a typed
# try never swallows what it did not ask for.
#
# For a one-line fallback, '?->' in place of '->' recovers from any error in
# that call: the result is Nil instead, and Runtime->GetLastError() says what
# went wrong.
#
# output:
#   line 1: port 8080
#     checked line 1
#   line 2: missing port
#     checked line 2
#   line 3: port 443
#     checked line 3
#   caught IndexError: Index out of bounds: 10,3
#   caught DivideByZeroError: Divide by zero
#   caught NilError: Attempting to dereference a 'Nil' memory instance
#   ?-> gave 8080
#   ?-> gave Nil, because: missing port
~#

# a custom error: subclass Error and add whatever the handler needs to know
class ConfigError from Error {
  @line : Int;

  New(message : String, line : Int) {
    # Error keeps the message; GetMessage() returns it
    Parent(message);
    @line := line;
  }

  method : public : GetLine() ~ Int {
    return @line;
  }
}

class PortReader {
  New() {
  }

  # raises a ConfigError when the text is empty. Raise leaves this method at
  # once, so the 'return' below only runs for good input.
  method : public : Read(text : String, line : Int) ~ IntRef {
    if(text->Size() = 0) {
      Runtime->Raise(ConfigError->New("missing port", line));
    };
    return IntRef->New(text->ToInt());
  }
}

class Errors {
  function : Main(args : String[]) ~ Nil {
    reader := PortReader->New();
    ports := ["8080", "", "443"];

    # --- try / on / finally with an error of our own ---
    each(i : ports) {
      try {
        port := reader->Read(ports[i], i + 1);
        "line {$(i + 1)}: port {$port}"->PrintLine();
      }
      on(e : ConfigError) {
        # e is a ConfigError here, so GetLine() is available
        "line {$(e->GetLine())}: {$(e->GetMessage())}"->PrintLine();
      }
      finally {
        # runs however the block is left: normally, by an error, or by
        # return or break -- the place for clean-up that must always happen
        "  checked line {$(i + 1)}"->PrintLine();
      };
    };

    # --- the runtime's own errors are caught the same way ---
    # reading past the end of an array
    values := [1, 2, 3];
    try {
      values[10]->PrintLine();
    }
    on(e : IndexError) {
      "caught IndexError: {$(e->GetMessage())}"->PrintLine();
    };

    # dividing a whole number by zero
    zero := 0;
    try {
      (10 / zero)->PrintLine();
    }
    on(e : DivideByZeroError) {
      "caught DivideByZeroError: {$(e->GetMessage())}"->PrintLine();
    }
    on(e : Error) {
      # never reached here, but this is how to catch "anything else"
      "something else: {$(e->GetMessage())}"->PrintLine();
    };

    # calling a method on Nil (a variable that holds no object)
    missing : String;
    try {
      missing->Size()->PrintLine();
    }
    on(e : NilError) {
      "caught NilError: {$(e->GetMessage())}"->PrintLine();
    };

    # --- ?-> : recover in one line ---
    # with '?->' an error inside the call is caught for you and the call
    # gives Nil, so a plain Nil check takes the place of a whole try block
    good := reader?->Read("8080", 1);
    if(good <> Nil) {
      "?-> gave {$good}"->PrintLine();
    };

    # clear any earlier error first, so GetLastError reports this call's
    Runtime->ClearError();
    bad := reader?->Read("", 2);
    if(bad = Nil) {
      "?-> gave Nil, because: {$(Runtime->GetLastError()->GetMessage())}"->PrintLine();
    };
  }
}
