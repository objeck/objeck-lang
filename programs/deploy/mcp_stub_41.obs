#~
# compile: obc -src mcp_stub_41.obs -lib gen_collect,json,net,net_server,cipher,misc,mcp
# run:     obr mcp_stub_41.obe
#
# Call an MCP server through a typed client. A program that calls a server
# with CallTool("price", "{\"item\":\"tea\"}") builds JSON by hand: a wrong
# argument name or type is found only when the call runs. mcp_stubs, a tool
# that ships with Objeck, asks a server for its tool list and writes an
# Objeck class with one method per tool, typed from the tool's schema, so the
# compiler checks the call.
#
# The class ShopClient at the bottom of this file was written by:
#
#   obr mcp_stubs.obe --cmd "obr shop_server.obe --stdio" --class ShopClient --out ShopClient.obs
#
# (the Shop class below, with a Main that calls Build()->ServeStdio(), is
# shop_server.obs; mcp_stubs is tools/mcp/mcp_stubs.obs in the source tree).
# Each method returns the result text, or Nil with the reason in GetError() when
# the tool failed. A parameter the tool marks optional gives a shorter overload.
# A tool that declares an output schema also gets a method ending in Json that
# returns its structured result. Try price("tea", 3) or restock("tea", "ten"):
# the compiler refuses both.
#
# output:
#   price("tea")                 -> 4.50
#   restock("tea", 12)           -> 12 x tea, standard delivery
#   restock("tea", 12, true)     -> 12 x tea, rush delivery
#   searchJson([green, tea])     -> matches=2 exact=true
#   price("coffee")              -> Nil, GetError() = no such item: coffee
~#
use API.MCP, Data.JSON, Collection;

# the server: three tools declared from their types (see mcp_declare_40)
class Shop {
	function : Price(call : McpCall) ~ McpToolResult {
		item := call->GetString("item");
		if(item->Equals("tea")) {
			return McpToolResult->Text("4.50");
		};
		return McpToolResult->Error("no such item: {$item}");
	}

	function : Restock(call : McpCall) ~ McpToolResult {
		item := call->GetString("item");
		count := call->GetInt("count", 0);
		rush := call->GetBool("rush", false);
		speed := "standard";
		if(rush) {
			speed := "rush";
		};
		return McpToolResult->Text("{$count} x {$item}, {$speed} delivery");
	}

	function : Search(call : McpCall) ~ McpToolResult {
		terms := call->GetArguments()->Get("terms");
		limit := call->GetInt("max_results", 10);
		found := terms->Size();
		if(found > limit) {
			found := limit;
		};
		hit := JsonElement->New(JsonElement->JsonType->OBJECT);
		hit->Insert("matches", found);
		hit->Insert("exact", true);
		return McpToolResult->Json(hit);
	}

	function : Build() ~ McpService {
		server := McpService->New("shop", "1.0.0");
		McpToolSpec->New("price", "The price of an item.")->Add("item", "String", "the item name")->ReadOnly()->AddTo(server, Func2Ref->New(Shop->Price(McpCall) ~ McpToolResult)<McpCall, McpToolResult>);
		McpToolSpec->New("restock", "Order more of an item.")->Add("item", "String", "the item name")->Add("count", "Int", "how many")->AddOptional("rush", "Bool", "rush delivery")->AddTo(server, Func2Ref->New(Shop->Restock(McpCall) ~ McpToolResult)<McpCall, McpToolResult>);
		McpToolSpec->New("search", "Search the catalogue.")->Add("terms", "String[]", "words to look for")->AddOptional("max_results", "Int", "most results to return")->Returns("{\"type\":\"object\",\"properties\":{\"matches\":{\"type\":\"integer\"},\"exact\":{\"type\":\"boolean\"}}}")->ReadOnly()->AddTo(server, Func2Ref->New(Shop->Search(McpCall) ~ McpToolResult)<McpCall, McpToolResult>);
		return server;
	}
}


class ShopDemo {
	function : Main(args : String[]) ~ Nil {
		client := McpClient->InProcess(Shop->Build());
		client->Initialize("shop-demo", "1.0");
		shop := ShopClient->New(client);

		price := shop->Price("tea");
		"price(\"tea\")                 -> {$price}"->PrintLine();

		order := shop->Restock("tea", 12);
		"restock(\"tea\", 12)           -> {$order}"->PrintLine();
		order := shop->Restock("tea", 12, true);
		"restock(\"tea\", 12, true)     -> {$order}"->PrintLine();

		terms := String->New[2];
		terms[0] := "green";
		terms[1] := "tea";
		hits := shop->SearchJson(terms);
		matches := hits->Get("matches")->GetInt();
		exact := hits->Get("exact")->GetType() = JsonElement->JsonType->TRUE;
		"searchJson([green, tea])     -> matches={$matches} exact={$exact}"->PrintLine();

		missing := shop->Price("coffee");
		if(missing = Nil) {
			reason := shop->GetError();
			"price(\"coffee\")              -> Nil, GetError() = {$reason}"->PrintLine();
		};
		client->Close();
	}
}

# ---- generated by mcp_stubs: change the server and generate again, not this class ----

#~
Typed client of the MCP server 'shop'. Every method calls one tool and returns the text of its result,
or Nil with the reason in GetError().
~#
class ShopClient {
	@client : McpClient;
	@error : String;

	#~
	Constructor
	@param client a client that has been initialized
	~#
	New(client : McpClient) {
		@client := client;
	}

	#~
	Why the last call returned Nil
	@return the reason, Nil after a call that worked
	~#
	method : public : GetError() ~ String {
		return @error;
	}

	method : CallText(tool : String, mcp_args : JsonElement) ~ String {
		@error := Nil;
		result := @client->CallTool(tool, mcp_args);
		if(result = Nil) {
			@error := @client->GetError();
			return Nil;
		};

		if(result->IsError()) {
			@error := result->GetText();
			return Nil;
		};

		return result->GetText();
	}

	method : CallJson(tool : String, mcp_args : JsonElement) ~ JsonElement {
		@error := Nil;
		result := @client->CallTool(tool, mcp_args);
		if(result = Nil) {
			@error := @client->GetError();
			return Nil;
		};

		if(result->IsError()) {
			@error := result->GetText();
			return Nil;
		};

		return result->GetStructured();
	}

	#~
	The price of an item.
	Read-only: the tool does not change anything.
	@param item the item name
	@return the text of the result, Nil on failure (see GetError)
	~#
	method : public : Price(item : String) ~ String {
		mcp_args := JsonElement->New(JsonElement->JsonType->OBJECT);
		if(item <> Nil) {
			mcp_args->Insert("item", item);
		};
		return CallText("price", mcp_args);
	}

	#~
	Order more of an item.
	@param item the item name
	@param count how many
	@return the text of the result, Nil on failure (see GetError)
	~#
	method : public : Restock(item : String, count : Int) ~ String {
		mcp_args := JsonElement->New(JsonElement->JsonType->OBJECT);
		if(item <> Nil) {
			mcp_args->Insert("item", item);
		};
		mcp_args->Insert("count", count);
		return CallText("restock", mcp_args);
	}

	#~
	Order more of an item.
	@param item the item name
	@param count how many
	@param rush rush delivery (optional)
	@return the text of the result, Nil on failure (see GetError)
	~#
	method : public : Restock(item : String, count : Int, rush : Bool) ~ String {
		mcp_args := JsonElement->New(JsonElement->JsonType->OBJECT);
		if(item <> Nil) {
			mcp_args->Insert("item", item);
		};
		mcp_args->Insert("count", count);
		mcp_args->Insert("rush", rush);
		return CallText("restock", mcp_args);
	}

	#~
	Search the catalogue.
	Read-only: the tool does not change anything.
	@param terms words to look for
	@return the text of the result, Nil on failure (see GetError)
	~#
	method : public : Search(terms : String[]) ~ String {
		mcp_args := JsonElement->New(JsonElement->JsonType->OBJECT);
		if(terms <> Nil) {
			mcp_list := JsonElement->New(JsonElement->JsonType->ARRAY);
			for(mcp_i := 0; mcp_i < terms->Size(); mcp_i += 1;) {
				mcp_list->Add(terms[mcp_i]);
			};
			mcp_args->Insert("terms", mcp_list);
		};
		return CallText("search", mcp_args);
	}

	#~
	Search the catalogue.
	Read-only: the tool does not change anything.
	@param terms words to look for
	@return the structured result, Nil on failure (see GetError)
	~#
	method : public : SearchJson(terms : String[]) ~ JsonElement {
		mcp_args := JsonElement->New(JsonElement->JsonType->OBJECT);
		if(terms <> Nil) {
			mcp_list := JsonElement->New(JsonElement->JsonType->ARRAY);
			for(mcp_i := 0; mcp_i < terms->Size(); mcp_i += 1;) {
				mcp_list->Add(terms[mcp_i]);
			};
			mcp_args->Insert("terms", mcp_list);
		};
		return CallJson("search", mcp_args);
	}

	#~
	Search the catalogue.
	Read-only: the tool does not change anything.
	@param terms words to look for
	@param max_results most results to return (optional)
	@return the text of the result, Nil on failure (see GetError)
	~#
	method : public : Search(terms : String[], max_results : Int) ~ String {
		mcp_args := JsonElement->New(JsonElement->JsonType->OBJECT);
		if(terms <> Nil) {
			mcp_list := JsonElement->New(JsonElement->JsonType->ARRAY);
			for(mcp_i := 0; mcp_i < terms->Size(); mcp_i += 1;) {
				mcp_list->Add(terms[mcp_i]);
			};
			mcp_args->Insert("terms", mcp_list);
		};
		mcp_args->Insert("max_results", max_results);
		return CallText("search", mcp_args);
	}

	#~
	Search the catalogue.
	Read-only: the tool does not change anything.
	@param terms words to look for
	@param max_results most results to return (optional)
	@return the structured result, Nil on failure (see GetError)
	~#
	method : public : SearchJson(terms : String[], max_results : Int) ~ JsonElement {
		mcp_args := JsonElement->New(JsonElement->JsonType->OBJECT);
		if(terms <> Nil) {
			mcp_list := JsonElement->New(JsonElement->JsonType->ARRAY);
			for(mcp_i := 0; mcp_i < terms->Size(); mcp_i += 1;) {
				mcp_list->Add(terms[mcp_i]);
			};
			mcp_args->Insert("terms", mcp_list);
		};
		mcp_args->Insert("max_results", max_results);
		return CallJson("search", mcp_args);
	}
}
