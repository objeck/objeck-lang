#~
# compile: obc -src threads_12.obs -lib concurrent
# run:     obr threads_12.obe
#
# Threads let a program do several things at the same time. 'spawn { ... }'
# runs a block on a new thread and gives you the thread, already started;
# Join waits for it to finish. When threads share data they must take turns
# changing it, or updates get lost: critical(mutex) { ... } lets only one
# thread at a time into the block. This program starts four workers that
# each add up a slice of the numbers 1 to 100,000 into one shared total. A
# CountDownLatch from System.Concurrency acts as a starting gun so they all
# begin together. The threads finish in a different order on every run, but
# the total is always the same, which is the point of the locking.
#
# output:
#   starting 4 workers
#   all workers finished
#   worker 0 added 312512500
#   worker 1 added 937512500
#   worker 2 added 1562512500
#   worker 3 added 2187512500
#   shared total: 5000050000
#   expected:     5000050000
~#
use Collection;
use System.Concurrency;

class Threads {
  function : Main(args : String[]) ~ Nil {
    count := 4;
    limit := 100000;
    slice := limit / count;

    # A spawn block copies the locals it names when the thread starts. An Int
    # is copied by value, so a write to it inside the block would never be
    # seen out here; an object is shared. So what the workers hand back lives
    # in objects: one IntRef every worker adds to (guarded by the mutex), and
    # an array in which each worker writes only its own slot.
    total := IntRef->New(0);
    lock := ThreadMutex->New("total");
    mine := Int->New[count];

    # a latch that opens after one CountDown: the starting gun
    start := CountDownLatch->New(1);

    "starting {$count} workers"->PrintLine();
    workers : Vector<Thread> := Vector->New();
    each(i : count) {
      first := i * slice + 1;
      last := (i + 1) * slice;

      # each worker gets its own slice; the loop variable i is copied too, so
      # worker 2 sees 2 however far the loop has gone on by then
      workers->AddBack(spawn {
        # wait here until the main thread fires the starting gun
        start->Await();
        sum := 0;
        for(n := first; n <= last; n += 1;) {
          sum += n;
          # total += n is really "read, add, write back"; without the lock
          # two threads could read the same old value and one addition would
          # vanish
          critical(lock) {
            total->Set(total->Get() + n);
          };
        };
        mine[i] := sum;
      });
    };

    # the workers are running, all blocked on the latch for now
    start->CountDown();

    # Join waits until a thread's block has finished
    each(worker in workers) {
      worker->Join();
    };
    "all workers finished"->PrintLine();

    # only the main thread prints, after the joins, so the output is in order
    each(i : mine) {
      "worker {$i} added {$(mine[i])}"->PrintLine();
    };

    # the sum 1 + 2 + ... + n is n * (n + 1) / 2
    "shared total: {$total}"->PrintLine();
    "expected:     {$(limit * (limit + 1) / 2)}"->PrintLine();
  }
}
