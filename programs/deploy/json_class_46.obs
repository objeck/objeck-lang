#~
# compile: obc -src json_class_46.obs -lib gen_collect,json,regex,llm_util,net,cipher,misc,agent,agent_json
# run:     obr json_class_46.obe
#
# A class declared `class Weather : json` is its own JSON Schema and its own reader: the compiler writes
# Weather->JsonSchema() from the fields, Weather->FromJson(json) (which checks the value against the schema and
# raises an Error that names the bad field), and Weather->Ask(agent, prompt), which asks the agent's model for a
# value of the class and returns a Weather. `json(note)` marks the fields the model may leave out or send as null.
# Ask puts the schema in the system prompt, checks the reply, repairs trailing commas and code fences, and sends an
# invalid reply back with the problems for a second try (see API.LlmUtil.StructuredCall).
#
# Here the model is a ScriptedBackend (fixed replies; no key, no network): its first reply is wrong (a string where
# a number belongs), so you see the retry. Swap in AnthropicBackend, OpenAIBackend, GeminiBackend or OllamaBackend
# for a real one; nothing else changes.
#
# output:
#   schema required: city,temp_c,sky,tags
#   Paris: 18.500000 C, rain=true, tags=2, note=(none)
#   model calls: 2
#   bad value: Weather: /temp_c: expected number, got string
~#

use API.Agent, API.LlmUtil, API.AgentJson, Data.JSON, Collection;

enum Sky {
	CLEAR, CLOUDY, RAIN
}

class Weather : json(note) {
	@city : get : String;
	@temp_c : get : Float;
	@sky : get : Sky;
	@tags : get : Vector<String>;
	@note : get : String;

	New() {
	}
}

class JsonClassDemo {
	function : Main(args : String[]) ~ Nil {
		# the schema the compiler derived from the fields
		required := Weather->JsonSchema()->Get("required");
		names := "";
		each(i : required) {
			if(i > 0) {
				names += ",";
			};
			names += required->Get(i)->GetString();
		};
		"schema required: {$names}"->PrintLine();

		# a model whose first answer is wrong and whose second is right
		script : Vector<AgentReply> := [
			AgentReply->Say(json {"city": "Paris", "temp_c": "warm", "sky": "RAIN", "tags": ["wet", "mild"]}->ToString()),
			AgentReply->Say(json {"city": "Paris", "temp_c": 18.5, "sky": "RAIN", "tags": ["wet", "mild"]}->ToString())];
		backend := ScriptedBackend->New(script);
		agent := Agent->New(backend, Nil);

		w := Weather->Ask(agent, "What is the weather in Paris?");
		# a field the model left out is Nil; '??' supplies a default for it
		note := w->GetNote() ?? "(none)";
		"{$w->GetCity()}: {$w->GetTempC()} C, rain={$w->GetSky() = Sky->RAIN}, tags={$w->GetTags()->Size()}, note={$note}"->PrintLine();
		"model calls: {$backend->GetAskedCount()}"->PrintLine();

		# FromJson on a value that does not fit says which field
		try {
			Weather->FromJson(json {"city": "Rome", "temp_c": "hot", "sky": "CLEAR", "tags": []});
		}
		on(e : Error) {
			"bad value: {$e->GetMessage()}"->PrintLine();
		};
	}
}
