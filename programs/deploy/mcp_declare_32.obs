#~
# compile: obc -src mcp_declare_32.obs -lib gen_collect,json,net,net_server,cipher,misc,mcp
# run:     obr mcp_declare_32.obe
#          obr mcp_declare_32.obe --stdio      (serve the same tools to Claude Code or Claude Desktop)
#
# Declare a tool, serve it, call it. MCP (the Model Context Protocol) is how an
# AI model finds and calls a program's functions. Each tool needs a JSON
# Schema that tells the model what arguments it takes; writing that schema by
# hand next to the function is where mistakes creep in. McpToolSpec derives it
# from the Objeck types you name, so the name, the types and the one-line
# description are written once. Hints such as ReadOnly() and Destructive() tell
# an agent which calls are safe to run without asking.
#
# The server and the client here run in the same program, which is how the
# regression tests exercise MCP. With --stdio the same server speaks the
# protocol on standard input and output, so a real MCP client can use it.
#
# output:
#   The server lists 3 tools:
#     add (read-only)
#       schema: {"properties":{"a":{"description":"the first number","type":"integer"},"b":{"description":"the second number","type":"integer"}},"required":["a","b"],"type":"object"}
#     greet (read-only)
#       schema: {"properties":{"name":{"description":"who to greet","type":"string"},"style":{"description":"how to greet","enum":["formal","casual"],"type":"string"}},"required":["name"],"type":"object"}
#     remove_file (destructive)
#       schema: {"properties":{"path":{"description":"the file to delete","type":"string"}},"required":["path"],"type":"object"}
#   add(17, 25)                  -> 42
#   greet("Ada")                 -> Good day, Ada
#   greet("Ada", "casual")       -> hi Ada
#   add(1, "two")                -> refused: Invalid arguments for add: argument 'b' must be of type integer
#   greet("Ada", "rude")         -> refused: Invalid arguments for greet: argument 'style' must be one of: formal, casual
#   add(1) with no b             -> refused: Invalid arguments for add: missing required argument 'b'
~#
use API.MCP, Data.JSON, Collection;

class Tools {
	# A tool's function takes the call and returns a result.
	function : Add(call : McpCall) ~ McpToolResult {
		sum := call->GetInt("a", 0) + call->GetInt("b", 0);
		return McpToolResult->Text("{$sum}");
	}

	function : Greet(call : McpCall) ~ McpToolResult {
		name := call->GetString("name");
		if(call->Has("style") & call->GetString("style")->Equals("casual")) {
			return McpToolResult->Text("hi {$name}");
		};
		return McpToolResult->Text("Good day, {$name}");
	}

	function : RemoveFile(call : McpCall) ~ McpToolResult {
		path := call->GetString("path");
		return McpToolResult->Text("pretending to delete {$path}");
	}

	function : Build() ~ McpService {
		server := McpService->New("declare-example", "1.0.0");

		# the types are written once, next to the name; the schema is derived
		McpToolSpec->New("add", "Add two integers")
			->Add("a", "Int", "the first number")
			->Add("b", "Int", "the second number")
			->ReadOnly()
			->AddTo(server, Func2Ref->New(Tools->Add(McpCall) ~ McpToolResult)<McpCall, McpToolResult>);

		McpToolSpec->New("greet", "Greet a person")
			->Add("name", "String", "who to greet")
			->AddOptional("style", "enum(formal,casual)", "how to greet")
			->ReadOnly()
			->AddTo(server, Func2Ref->New(Tools->Greet(McpCall) ~ McpToolResult)<McpCall, McpToolResult>);

		McpToolSpec->New("remove_file", "Delete a file")
			->Add("path", "String", "the file to delete")
			->Destructive()
			->AddTo(server, Func2Ref->New(Tools->RemoveFile(McpCall) ~ McpToolResult)<McpCall, McpToolResult>);
		return server;
	}

	function : Show(client : McpClient, what : String, name : String, arguments : String) ~ Nil {
		while(what->Size() < 28) {
			what += " ";
		};

		result := client->CallTool(name, arguments);
		if(result = Nil) {
			reason := client->GetError();
			"{$what} -> no answer: {$reason}"->PrintLine();
		}
		else if(result->IsError()) {
			text := result->GetText();
			"{$what} -> refused: {$text}"->PrintLine();
		}
		else {
			text := result->GetText();
			"{$what} -> {$text}"->PrintLine();
		};
	}

	function : Main(args : String[]) ~ Nil {
		server := Build();
		if(args->Size() > 0 & args[0]->Equals("--stdio")) {
			server->ServeStdio();
			return;
		};

		client := McpClient->InProcess(server);
		client->Initialize("declare-example-client", "1.0");

		tools := client->ListTools();
		count := tools->Size();
		"The server lists {$count} tools:"->PrintLine();
		each(tool in tools) {
			name := tool->GetName();
			effect := "no hint";
			if(tool->GetReadOnlyHint()) {
				effect := "read-only";
			}
			else if(tool->GetDestructiveHint()) {
				effect := "destructive";
			};
			schema := tool->GetInputSchema()->ToString();
			"  {$name} ({$effect})"->PrintLine();
			"    schema: {$schema}"->PrintLine();
		};

		Show(client, "add(17, 25)", "add", "{\"a\":17,\"b\":25}");
		Show(client, "greet(\"Ada\")", "greet", "{\"name\":\"Ada\"}");
		Show(client, "greet(\"Ada\", \"casual\")", "greet", "{\"name\":\"Ada\",\"style\":\"casual\"}");
		Show(client, "add(1, \"two\")", "add", "{\"a\":1,\"b\":\"two\"}");
		Show(client, "greet(\"Ada\", \"rude\")", "greet", "{\"name\":\"Ada\",\"style\":\"rude\"}");
		Show(client, "add(1) with no b", "add", "{\"a\":1}");
		client->Close();
	}
}
