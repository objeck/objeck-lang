#~
# Rosetta Code: Exceptions
# https://rosettacode.org/wiki/Exceptions
# Claimed in #1123
#
# Define an exception type, throw one, and catch it. An exception is a
# System.Error, or a subclass of it; Runtime->Raise throws it, and a try block
# catches it by type with 'on', runs 'finally' on every way out, and throws
# again whatever no clause names. The runtime's own errors are Errors too
# (DivideByZeroError, IndexError, NilError, CastError, RuntimeError), so the
# same try catches them. ?-> still turns any error below a guarded call into
# Nil, and Runtime->GetLastError() says which one it was.
#
# This used to be done with a note in a shared array and a divide by zero on
# purpose, which was all the language had (#1247).
~#

# the task's exception type, with a field of its own
class MyError from Error {
	@code : Int;

	New(message : String, code : Int) {
		Parent(message);
		@code := code;
	}

	method : public : GetCode() ~ Int {
		return @code;
	}
}

class Risky {
	New() {}

	method : public : Throw(message : String, code : Int) ~ Nil {
		Runtime->Raise(MyError->New(message, code));
	}

	method : public : Divide(a : Int, b : Int) ~ Int {
		return a / b;
	}

	method : public : At(values : Int[], i : Int) ~ Int {
		return values[i];
	}

	# two calls deep
	method : public : Outer(a : Int, b : Int) ~ Int {
		return Middle(a, b);
	}

	method : public : Middle(a : Int, b : Int) ~ Int {
		v := Divide(a, b);
		return v;
	}

	# catches its own error and answers -1 instead
	method : public : SafeDivide(a : Int, b : Int) ~ Int {
		try {
			return Divide(a, b);
		}
		on(e : DivideByZeroError) {
			return -1;
		};
	}
}

class RosettaExceptions {
	@failures : Int;
	@log : String;

	function : Main(args : String[]) ~ Nil {
		RosettaExceptions->New()->Run();
	}

	New() {
		@failures := 0;
		@log := "";
	}

	method : CheckTrue(what : String, ok : Bool) ~ Nil {
		if(ok) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		r := Risky->New();

		# throw and catch a user-defined exception, by type
		code := 0;
		message := "";
		try {
			r->Throw("bad input", 42);
			CheckTrue("not reached after a throw", false);
		}
		on(e : MyError) {
			code := e->GetCode();
			message := e->GetMessage();
		};
		CheckTrue("a thrown MyError is caught by type", code = 42);
		CheckTrue("the handler reads its message", message->Equals("bad input"));

		# the runtime's own errors, each by its type
		got := "";
		try {
			r->Divide(1, 0);
		}
		on(e : DivideByZeroError) {
			got := "divide";
		};
		CheckTrue("divide by zero is a DivideByZeroError", got->Equals("divide"));

		got := "";
		try {
			r->At([1, 2, 3], 3);
		}
		on(e : IndexError) {
			got := "index";
		};
		CheckTrue("an out-of-bounds index is an IndexError", got->Equals("index"));

		got := "";
		try {
			nothing : String;
			n := nothing->Size();
		}
		on(e : NilError) {
			got := "nil";
		};
		CheckTrue("a Nil dereference is a NilError", got->Equals("nil"));

		# the first clause that matches wins; Error catches anything
		got := "";
		try {
			r->Throw("x", 1);
		}
		on(e : DivideByZeroError) {
			got := "wrong";
		}
		on(e : Error) {
			got := "any";
		};
		CheckTrue("a later 'on(e : Error)' catches what earlier ones do not", got->Equals("any"));

		# finally runs whether or not anything was thrown
		@log := "";
		try {
			r->Divide(4, 2);
		}
		finally {
			@log += "a";
		};
		try {
			r->Throw("y", 2);
		}
		on(e : MyError) {
			@log += "b";
		}
		finally {
			@log += "c";
		};
		CheckTrue("finally runs on both paths", @log->Equals("abc"));

		# thrown two calls deep
		got := "";
		try {
			r->Outer(5, 0);
		}
		on(e : DivideByZeroError) {
			got := "deep";
		};
		CheckTrue("an error two calls deep is caught", got->Equals("deep"));

		# rethrow: an inner handler passes the exception on
		code := 0;
		try {
			try {
				r->Throw("passed on", 7);
			}
			on(e : MyError) {
				Runtime->Raise(e);
			};
		}
		on(e : MyError) {
			code := e->GetCode();
		};
		CheckTrue("a rethrown exception reaches the outer handler", code = 7);

		# a handler inside a method: its caller never sees the error
		CheckTrue("an inner handler substitutes its own answer", r->SafeDivide(7, 0) = -1);
		CheckTrue("and is transparent on success", r->SafeDivide(7, 7) = 1);

		# ?-> as before, and the error it recovered from
		r?->Throw("guarded", 3);
		e := Runtime->GetLastError();
		CheckTrue("?-> recovers from a throw and keeps the error", e->TypeOf(MyError) & e->As(MyError)->GetCode() = 3);

		# many in a row
		caught := 0;
		for(i := 0; i < 200; i += 1;) {
			try {
				r->Divide(i, 0);
			}
			on(e : DivideByZeroError) {
				caught += 1;
			};
		};
		CheckTrue("200 errors in a row are all caught", caught = 200);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
