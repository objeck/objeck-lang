#~
# Rosetta Code: Largest proper divisor of n
# https://rosettacode.org/wiki/Largest_proper_divisor_of_n
#
# The largest divisor below n itself. For a prime that is 1, and for n = 1 the task defines it as 0 because 1 has no proper divisor -- the boundary a divisor search returns 1 for if it is not special-cased.
#
# Expected values were computed with an independent oracle, not recalled.
~#


class RosettaLargestProperDivisor {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaLargestProperDivisor->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		out := "";
		for(n := 1; n <= 20; n += 1;) {
			out += Largest(n)->ToString();
			out += " ";
		};
		Check("largest proper divisor 1..20", out->Trim(),
			"0 1 1 2 1 3 1 4 3 5 1 6 1 7 5 8 1 9 1 10");
		# 1 has no proper divisor
		CheckInt("for 1 it is 0", Largest(1), 0);
		# for a prime it is 1
		CheckInt("for a prime it is 1", Largest(97), 1);
		# for an even number it is half
		CheckInt("for 100 it is 50", Largest(100), 50);
		# n / smallest-prime-factor, which is the shortcut the task notes
		bad := 0;
		for(n := 2; n <= 500; n += 1;) {
			if(Largest(n) <> n / SmallestFactor(n)) { bad += 1; };
		};
		CheckInt("it equals n over the smallest prime factor", bad, 0);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Largest(n : Int) ~ Int {
		if(n < 2) { return 0; };
		for(d := n / 2; d >= 1; d -= 1;) {
			if(n % d = 0) { return d; };
		};
		return 1;
	}

	function : SmallestFactor(n : Int) ~ Int {
		d := 2;
		while(d * d <= n) {
			if(n % d = 0) { return d; };
			d += 1;
		};
		return n;
	}
}
