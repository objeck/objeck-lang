# EXPECT_COMPILE_ERROR: (14,48): This map literal has the key
# EXPECT_ERROR_COUNT: 1
#~
The same constant key twice in a map that keeps one value per key would lose the first value without a word.
~#
use Collection;

class BadMapLiteralDuplicateKey {
	function : Take(m : Map<String, IntRef>) ~ Int {
		return m->Size();
	}

	function : Main(args : String[]) ~ Nil {
		m : Map<String, IntRef> := {"a": 1, "b": 2, "a": 3};
		m->Size()->PrintLine();
	}
}
