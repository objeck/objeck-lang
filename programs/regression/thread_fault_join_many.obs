#~
Thread-fault isolation: no Join of a faulted thread reads "no fault", however
many faulted threads were left unjoined before it.

The VM records a faulted thread's error text so that the thread's Join can
report it (Runtime->GetProperty("runtime.thread.join.fault")). The record was
capped: when it held 4096 entries the next fault cleared all of them. A program
that started more than 4096 workers and joined them afterwards, each of them
faulted, read "no fault" for the first 4096.

This test starts 4300 workers that each divide by zero, lets them all end, then
joins them in the order they were started. Every Join must report a fault.
Before the fix it reported 204 of 4300.

The VM keeps the messages of the newest 4096 faulted, unjoined threads (a
program that never joins must not grow without bound), so the 204 oldest have
lost theirs by the time they are joined (which 204 is exact once every worker has
faulted: the VM drops the earliest-started of those waiting whenever there are
more than 4096, and the test waits for all 4300 faults before its first Join). Their Join says so ("Thread fault
record dropped: ..."); the other 4096 report the divide by zero. A Join knows
its thread faulted from the thread's exit status, not from the record.

A second round starts 4300 workers of which the odd ones fault, and joins them
in reverse order: a fault is reported for exactly the odd ones.
~#
use System.Concurrency;

class Faulty from Thread {
	@divisor : Int;

	New(divisor : Int) {
		Parent("faulty");
		@divisor := divisor;
	}

	method : public : Run(param : System.Base) ~ Nil {
		value := 100 / @divisor;
		if(@divisor = 0) {
			"UNREACHABLE: the faulting worker went on ({$value})"->PrintLine();
		};
	}
}

class ThreadFaultJoinMany {
	function : Stat(key : String) ~ Int {
		return Runtime->GetProperty(key)->ToInt();
	}

	# every started worker has ended: the faults are all recorded before a Join
	function : Settle(active : Int) ~ Nil {
		for(i := 0; i < 20000 & Stat("runtime.threads.active") > active; i += 1;) {
			Thread->Sleep(1);
		};
	}

	# Every one of `faults` workers started since `before` was read has recorded its
	# fault. runtime.threads.active cannot say so: a worker that has been started but
	# has not begun to run is not counted in it yet, so it can read "all ended" while
	# some are still to come. This test joined on that reading: the workers that had
	# not begun faulted during the Joins, when records were being taken as fast as
	# they arrived, so nothing more was dropped and a few of the 204 oldest reported
	# their fault instead of the dropped notice (4102 and 198 with 6 out of place, then
	# 4097 and 203, on loaded windows-arm64 runners; 33 runs of 210 on Linux x64 with
	# three copies sharing three CPUs, every failing run one in which fewer than 4300
	# faults had been recorded when the wait returned). The registry never held more
	# than 4096 records in any of them. The fault count is raised under the same lock
	# as the record is made, so it is the one to wait for.
	function : SettleFaults(before : Int, faults : Int, active : Int) ~ Nil {
		for(i := 0; i < 60000 & Stat("runtime.threads.faulted") - before < faults; i += 1;) {
			Thread->Sleep(1);
		};
		Settle(active);
	}

	function : Main(args : String[]) ~ Nil {
		count := 4300;
		failures := 0;
		Runtime->SetProperty("runtime.threads.isolation", "isolate");
		active := Stat("runtime.threads.active");

		# round 1: all fault, joined in start order
		before := Stat("runtime.threads.faulted");
		workers := Faulty->New[count];
		for(i := 0; i < count; i += 1;) {
			workers[i] := Faulty->New(0);
			workers[i]->Execute(Nil);
			if(i % 64 = 63) {
				Thread->Sleep(1);
			};
		};
		SettleFaults(before, count, active);

		kept := 4096;
		reported := 0;
		dropped := 0;
		misplaced := 0;
		for(i := 0; i < count; i += 1;) {
			workers[i]->Join();
			text := Runtime->GetProperty("runtime.thread.join.fault");
			if(text->Find("Divide by zero") >= 0) {
				reported += 1;
				if(i < count - kept) {
					misplaced += 1;
				};
			}
			else if(text->Find("Thread fault record dropped") >= 0) {
				dropped += 1;
				if(i >= count - kept) {
					misplaced += 1;
				};
			};
		};
		if(reported = kept & dropped = count - kept & misplaced = 0) {
			"PASS: {$count} faulted workers joined afterwards all reported: {$reported} their fault, the {$dropped} oldest that it was dropped"->PrintLine();
		}
		else {
			"FAIL: of {$count} faulted workers {$reported} reported their fault and {$dropped} a dropped record ({$misplaced} out of place)"->PrintLine();
			failures += 1;
		};
		counted := Stat("runtime.threads.faulted") - before;
		if(counted = count) {
			"PASS: and counted"->PrintLine();
		}
		else {
			"FAIL: {$counted} of {$count} faults counted"->PrintLine();
			failures += 1;
		};

		# round 2: odd workers fault, joined in reverse order
		before := Stat("runtime.threads.faulted");
		for(i := 0; i < count; i += 1;) {
			workers[i] := Faulty->New(i % 2 = 1 ? 0 : 1);
			workers[i]->Execute(Nil);
			if(i % 64 = 63) {
				Thread->Sleep(1);
			};
		};
		SettleFaults(before, count / 2, active);

		wrong := 0;
		for(i := count - 1; i >= 0; i -= 1;) {
			workers[i]->Join();
			faulted := Runtime->GetProperty("runtime.thread.join.fault")->Size() > 0;
			if(faulted <> (i % 2 = 1)) {
				wrong += 1;
			};
		};
		if(wrong = 0) {
			"PASS: odd workers fault, even ones do not"->PrintLine();
		}
		else {
			"FAIL: {$wrong} of {$count} Joins reported the wrong outcome"->PrintLine();
			failures += 1;
		};

		if(Stat("runtime.threads.active") <> active) {
			"FAIL: a mutator slot leaked"->PrintLine();
			failures += 1;
		};

		if(failures > 0) {
			"{$failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
		"thread_fault_join_many: all checks passed"->PrintLine();
	}
}
