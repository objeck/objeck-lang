#~
# Threads making the first virtual calls on a class at the same moment
#
# A class keeps, per virtual declaration, the override a receiver of that class reaches,
# and fills the table in as calls resolve. Every thread making a virtual call read the
# table and the first call through each declaration added to it, with no lock. An insert
# that grew the table while another thread walked it sent that thread through freed
# memory, and two inserts at once corrupted the table and the C heap: SIGSEGV in
# StackClass::GetVirtualMethod or AddVirutalMethod, or glibc's "malloc(): unaligned
# tcache chunk detected". Eight threads that each made their first agent run together
# crashed about one run in ten under OBJECK_JIT_THRESHOLD=1; once any thread had made
# the calls alone, the table was complete and nothing went wrong.
#
# Here 16 threads make the first calls of 10 virtual methods on each of 48 classes, one
# class at a time: the main thread opens a gate per class, so the threads all reach a
# class whose table is still empty together. That is 48 rounds of 10 concurrent inserts
# into one table. Each thread adds up what the calls return, so a call that reached the
# wrong override shows as a wrong sum.
~#

use System.Concurrency;

class Unit {
	New() {}

	method : virtual : public : M0() ~ Int;
	method : virtual : public : M1() ~ Int;
	method : virtual : public : M2() ~ Int;
	method : virtual : public : M3() ~ Int;
	method : virtual : public : M4() ~ Int;
	method : virtual : public : M5() ~ Int;
	method : virtual : public : M6() ~ Int;
	method : virtual : public : M7() ~ Int;
	method : virtual : public : M8() ~ Int;
	method : virtual : public : M9() ~ Int;
}

class U0 from Unit {
	New() { Parent(); }
	method : public : M0() ~ Int { return 0; }
	method : public : M1() ~ Int { return 1; }
	method : public : M2() ~ Int { return 2; }
	method : public : M3() ~ Int { return 3; }
	method : public : M4() ~ Int { return 4; }
	method : public : M5() ~ Int { return 5; }
	method : public : M6() ~ Int { return 6; }
	method : public : M7() ~ Int { return 7; }
	method : public : M8() ~ Int { return 8; }
	method : public : M9() ~ Int { return 9; }
}

