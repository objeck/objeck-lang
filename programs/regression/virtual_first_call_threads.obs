class Caller from Thread {
	@units : Unit[];
	@sum : Int;
	@finished : Bool;

	New(units : Unit[]) {
		Parent("caller");
		@units := units;
	}

	method : public : GetSum() ~ Int { return @sum; }
	method : public : IsFinished() ~ Bool { return @finished; }

	method : public : Run(param : System.Base) ~ Nil {
		sum := 0;
		each(i : @units) {
			# every thread arrives at class i before any of them calls it
			while(VirtualFirstCallThreads->Gate() < i) {
			};
			unit := @units[i];
			sum += unit->M0() + unit->M1() + unit->M2() + unit->M3() + unit->M4() + unit->M5() + unit->M6() + unit->M7() + unit->M8() + unit->M9();
		};
		@sum := sum;
		@finished := true;
	}
}

class VirtualFirstCallThreads {
	@gate : static : Int;
	@failures : static : Int;

	function : Gate() ~ Int {
		return @gate;
	}

	function : Check(what : String, ok : Bool) ~ Nil {
		if(ok) {
			"  ok: {$what}"->PrintLine();
		}
		else {
			"  FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	function : Main(args : String[]) ~ Nil {
		@failures := 0;
		@gate := -1;

		units := Unit->New[48];
		units[0] := U0->New();
		units[1] := U1->New();
		units[2] := U2->New();
		units[3] := U3->New();
		units[4] := U4->New();
		units[5] := U5->New();
		units[6] := U6->New();
		units[7] := U7->New();
		units[8] := U8->New();
		units[9] := U9->New();
		units[10] := U10->New();
		units[11] := U11->New();
		units[12] := U12->New();
		units[13] := U13->New();
		units[14] := U14->New();
		units[15] := U15->New();
		units[16] := U16->New();
		units[17] := U17->New();
		units[18] := U18->New();
		units[19] := U19->New();
		units[20] := U20->New();
		units[21] := U21->New();
		units[22] := U22->New();
		units[23] := U23->New();
		units[24] := U24->New();
		units[25] := U25->New();
		units[26] := U26->New();
		units[27] := U27->New();
		units[28] := U28->New();
		units[29] := U29->New();
		units[30] := U30->New();
		units[31] := U31->New();
		units[32] := U32->New();
		units[33] := U33->New();
		units[34] := U34->New();
		units[35] := U35->New();
		units[36] := U36->New();
		units[37] := U37->New();
		units[38] := U38->New();
		units[39] := U39->New();
		units[40] := U40->New();
		units[41] := U41->New();
		units[42] := U42->New();
		units[43] := U43->New();
		units[44] := U44->New();
		units[45] := U45->New();
		units[46] := U46->New();
		units[47] := U47->New();

		threads := 16;
		callers := Caller->New[threads];
		each(t : threads) {
			callers[t] := Caller->New(units);
		};
		each(t : threads) {
			callers[t]->Execute(Nil);
		};

		# let the threads reach the gate, then open one class at a time
		Thread->Sleep(100);
		each(i : units) {
			@gate := i;
			Thread->Sleep(2);
		};

		expected := 0;
		each(i : units) {
			each(k : 10) {
				expected += i * 100 + k;
			};
		};

		finished := 0;
		wrong := 0;
		each(t : threads) {
			callers[t]->Join();
			if(callers[t]->IsFinished()) {
				finished += 1;
			};
			if(callers[t]->GetSum() <> expected) {
				wrong += 1;
			};
		};
		Check("every thread made its calls ({$finished} of {$threads})", finished = threads);
		Check("every call reached its class's own method ({$wrong} threads added up something else)", wrong = 0);

		# and again, now that every table is complete
		again := 0;
		each(i : units) {
			unit := units[i];
			again += unit->M0() + unit->M1() + unit->M2() + unit->M3() + unit->M4() + unit->M5() + unit->M6() + unit->M7() + unit->M8() + unit->M9();
		};
		Check("the same calls give the same answers afterwards", again = expected);

		if(@failures = 0) {
			"PASS: first virtual calls from several threads"->PrintLine();
		}
		else {
			"FAIL: first virtual calls from several threads ({$@failures} checks)"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
