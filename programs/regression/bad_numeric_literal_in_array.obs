# EXPECT_COMPILE_ERROR: Integer literal out of range: '99999999999999999999'
# EXPECT_ERROR_COUNT: 1
#~
An out-of-range literal inside an array literal is the only error. Recovery
used to skip to the next ';', leaving the array literal unclosed, so every
later line reported "Expected ';' or ']'".
~#
class BadNumericLiteralInArray {
	function : Main(args : String[]) ~ Nil {
		x := [1, 99999999999999999999, 3];
		x[0]->PrintLine();
		y := 2;
		y->PrintLine();
	}
}
