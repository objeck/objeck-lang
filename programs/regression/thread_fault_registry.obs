#~
What the thread-fault registry keeps is bounded by the threads that can still
be joined, not by the threads a program has started.

The VM keeps, for each thread it starts, what a later Join will need to report
the thread's fault. Three ways a thread ended used to leave that behind for
good, each one entry per thread:

- "abandoned": the Thread object is started again while its earlier run is
  still going, so the earlier run can never be joined; it then faults. Its
  fault was recorded under a key no Join could ever ask for.
- "unjoined": a thread that returns normally and is never joined kept its
  handle's binding, with thread-fault isolation on or off.
- "plain": the same with isolation off, where nothing is ever recorded.

One way is left, and is bounded instead:

- "capped": threads that fault and are never joined. Each one's message has
  to be kept in case a Join comes, so the VM keeps the newest 4096 and drops
  the oldest beyond that. Ten thousand such threads leave 4096 records, not
  ten thousand. The Join of a thread whose record was dropped does not read
  "no fault": it reports "Thread fault record dropped: ..." (it knows from the
  thread's exit status that the thread faulted). This scenario joins the
  newest worker (its own message), the oldest (dropped) and one that returned
  normally (no fault).

Each scenario runs many times; run_vm_flag_tests.py (the thread-fault registry
section) sets OBJECK_THREAD_FAULT_STATS=1, which makes the VM print what the
registry holds when Main returns, and requires it to be empty. On its own this
file checks that every Join still reports what it should.

Arguments: the scenario (abandoned, unjoined, plain, capped) and the repetitions.
~#
use System.Concurrency;

class RegistryError from Error {
	New(message : String) {
		Parent(message);
	}
}

class Held from Thread {
	@gates : Bool[];
	@faults : Bool[];
	@entered : Int;
	@runs : Int;

	New() {
		Parent("held");
		@gates := Bool->New[4];
		@faults := Bool->New[4];
		@entered := 0;
		@runs := 0;
	}

	method : public : Next(faults : Bool) ~ Int {
		run := @runs;
		@faults[run] := faults;
		@gates[run] := false;
		@runs += 1;
		return run;
	}

	method : public : Open(run : Int) ~ Nil {
		@gates[run] := true;
	}

	method : public : Entered() ~ Int {
		return @entered;
	}

	method : public : Run(param : System.Base) ~ Nil {
		run := param->As(IntRef)->Get();
		@entered += 1;
		while(<>@gates[run]) {
			Thread->Sleep(1);
		};
		if(@faults[run]) {
			Runtime->Raise(RegistryError->New("run {$run} faulted!"));
		};
	}
}

# returns at once, marking its own element of the array it was started with
# faults with a message that carries its number, unless told to return
class Numbered from Thread {
	@number : Int;
	@faults : Bool;

	New(number : Int, faults : Bool) {
		Parent("numbered");
		@number := number;
		@faults := faults;
	}

	method : public : Run(param : System.Base) ~ Nil {
		if(@faults) {
			number := @number;
			Runtime->Raise(RegistryError->New("worker {$number} faulted!"));
		};
	}
}

class Quick from Thread {
	@number : Int;

	New(number : Int) {
		Parent("quick");
		@number := number;
	}

	method : public : Run(param : System.Base) ~ Nil {
		ran := param->As(BoolArrayRef)->Get();
		ran[@number] := true;
	}
}

class ThreadFaultRegistry {
	function : Stat(key : String) ~ Int {
		return Runtime->GetProperty(key)->ToInt();
	}

	function : Settle(active : Int) ~ Nil {
		for(i := 0; i < 30000 & Stat("runtime.threads.active") > active; i += 1;) {
			Thread->Sleep(1);
		};
	}

	# the earlier run is alive when the object is started again, and faults afterwards
	function : Abandoned(count : Int) ~ Int {
		wrong := 0;
		for(i := 0; i < count; i += 1;) {
			t := Held->New();
			a := t->Next(true);
			t->Execute(IntRef->New(a));
			for(w := 0; w < 20000 & t->Entered() < 1; w += 1;) {
				Thread->Sleep(1);
			};

			b := t->Next(false);
			t->Execute(IntRef->New(b));

			before := Stat("runtime.threads.faulted");
			t->Open(a);
			for(w := 0; w < 20000 & Stat("runtime.threads.faulted") = before; w += 1;) {
				Thread->Sleep(1);
			};

			t->Open(b);
			t->Join();
			if(Runtime->GetProperty("runtime.thread.join.fault")->Size() > 0) {
				wrong += 1;
			};
		};
		return wrong;
	}

	# threads that return normally and are never joined; returns how many did not run
	function : Unjoined(count : Int) ~ Int {
		ran := Bool->New[count];
		holder := BoolArrayRef->New(ran);
		for(i := 0; i < count; i += 1;) {
			Quick->New(i)->Execute(holder);
			if(i % 32 = 31) {
				Thread->Sleep(1);
			};
		};

		# a started thread may not have begun yet: wait for each one's mark
		missing := count;
		for(w := 0; w < 30000 & missing > 0; w += 1;) {
			Thread->Sleep(1);
			missing := 0;
			for(i := 0; i < count; i += 1;) {
				if(<>ran[i]) {
					missing += 1;
				};
			};
		};
		return missing;
	}

	# faulting threads that are not joined, more of them than the VM keeps records for
	function : Capped(count : Int, active : Int) ~ Int {
		wrong := 0;
		before := Stat("runtime.threads.faulted");
		workers := Numbered->New[count];
		for(i := 0; i < count; i += 1;) {
			workers[i] := Numbered->New(i, true);
			workers[i]->Execute(Nil);
			if(i % 64 = 63) {
				Thread->Sleep(1);
			};
		};
		clean := Numbered->New(count, false);
		clean->Execute(Nil);
		Settle(active);
		if(Stat("runtime.threads.faulted") - before <> count) {
			wrong += 1;
		};

		# the newest: its own message
		last := count - 1;
		workers[last]->Join();
		if(Runtime->GetProperty("runtime.thread.join.fault")->Find("worker {$last} faulted!") < 0) {
			wrong += 1;
		};

		# the oldest: dropped when there are more than the VM keeps, and said to be
		workers[0]->Join();
		text := Runtime->GetProperty("runtime.thread.join.fault");
		if(count > 4096) {
			if(text->Find("Thread fault record dropped") < 0) {
				wrong += 1;
			};
		}
		else if(text->Find("worker 0 faulted!") < 0) {
			wrong += 1;
		};

		# and one that did not fault still reports none
		clean->Join();
		if(Runtime->GetProperty("runtime.thread.join.fault")->Size() > 0) {
			wrong += 1;
		};

		return wrong;
	}

	function : Main(args : String[]) ~ Nil {
		scenario := "abandoned";
		count := 20;
		if(args->Size() > 1) {
			scenario := args[0];
			count := args[1]->ToInt();
		};
		active := Stat("runtime.threads.active");

		wrong := 0;
		if(scenario->Equals("abandoned")) {
			Runtime->SetProperty("runtime.threads.isolation", "isolate");
			wrong := Abandoned(count);
		}
		else if(scenario->Equals("capped")) {
			Runtime->SetProperty("runtime.threads.isolation", "isolate");
			wrong := Capped(count, active);
		}
		else if(scenario->Equals("unjoined")) {
			Runtime->SetProperty("runtime.threads.isolation", "isolate");
			wrong := Unjoined(count);
		}
		else {
			wrong := Unjoined(count);
		};
		Settle(active);

		if(wrong > 0 | Stat("runtime.threads.active") <> active) {
			"FAIL: {$scenario}: {$wrong} wrong outcome(s) over {$count} repetitions, or a thread did not end"->PrintLine();
			Runtime->Exit(1);
		};
		"PASS: {$scenario} x {$count}"->PrintLine();
	}
}
