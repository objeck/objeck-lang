#~
# An accepted socket is the kind of socket its server makes
#
# The VM caches the class ids it allocates accepted sockets with, and the TCP
# and TLS getters shared one cache slot. Whichever kind of server accepted first
# fixed the class of every socket accepted after it: a plain TCPSocketServer in
# a process that had already accepted a TLS connection returned a
# TCPSecureSocket holding a raw socket, whose first read or Close then treated
# that socket number as a TLS context. A process serving HTTP and HTTPS side by
# side does exactly this.
#
# A TLS server accepts first, then a plain one; each accepted socket's class is
# checked. The mis-typed object is only inspected, never used, so the test
# fails cleanly instead of crashing.
# EXTRA_LIBS: net
~#

use System.Concurrency, System.IO.Filesystem, System.IO.Net;

class OneAccept from Thread {
	@secure : Bool;
	@port : Int;
	@listening : Bool;
	@finished : Bool;
	@class_name : String;

	New(secure : Bool, port : Int) {
		Parent("one-accept");
		@secure := secure;
		@port := port;
		@listening := false;
		@finished := false;
	}

	method : public : IsListening() ~ Bool { return @listening; }
	method : public : IsFinished() ~ Bool { return @finished; }
	method : public : GetPort() ~ Int { return @port; }
	method : public : GetClassName() ~ String { return @class_name; }

	method : public : Run(param : Base) ~ Nil {
		accepted : Base;
		if(@secure) {
			tls_server := TCPSecureSocketServer->New("socket-class-{$Runtime->GetProcessId()}-cert.pem", "socket-class-{$Runtime->GetProcessId()}-key.pem", "", @port);
			if(tls_server->Listen()) {
				@port := tls_server->GetPort();
				@listening := true;
				accepted := tls_server->Accept();
				if(accepted <> Nil) {
					@class_name := accepted->GetClass()->GetName();
					if(@class_name->Equals("System.IO.Net.TCPSecureSocket")) {
						accepted->As(TCPSecureSocket)->Close();
					};
				};
				tls_server->Close();
			};
		}
		else {
			server := TCPSocketServer->New(@port);
			if(server->Listen(4)) {
				@port := server->GetPort();
				@listening := true;
				accepted := server->Accept();
				if(accepted <> Nil) {
					@class_name := accepted->GetClass()->GetName();
					if(@class_name->Equals("System.IO.Net.TCPSocket")) {
						accepted->As(TCPSocket)->Close();
					};
				};
				server->Close();
			};
		};
		@finished := true;
	}
}

class SocketAcceptClass {
	# A self-signed certificate for the test's servers, valid from 2025 rather than
	# from the second it is made. `openssl req -x509` starts a certificate "now",
	# and a clock that steps back after that -- a VM resynchronizing its time, as
	# WSL2 does by seconds at a time -- sees a certificate that is not valid yet:
	# the handshake fails "The certificate validity starts in the future". Before
	# OpenSSL 3.4 only `openssl ca` can set the start, so it signs the request, in a
	# scratch directory removed afterwards. The extensions are written out rather
	# than left to each build's defaults.
	function : MakeServerCert(cert : String, key : String, subject : String, san : String) ~ Bool {
		dir := "{$cert}.ca";
		Directory->Delete(dir);
		File->Delete(cert);
		File->Delete(key);
		if(<>Directory->Create(dir)) {
			return false;
		};

		cnf := FileWriter->New("{$dir}/openssl.cnf");
		cnf->WriteString("[req]\ndistinguished_name = dn\n[dn]\n[ca]\ndefault_ca = fixture\n");
		cnf->WriteString("[fixture]\ndatabase = {$dir}/index.txt\nserial = {$dir}/serial\nnew_certs_dir = {$dir}\n");
		cnf->WriteString("policy = any\ndefault_md = sha256\nunique_subject = no\n[any]\ncommonName = supplied\n");
		cnf->WriteString("[server]\nbasicConstraints = critical,CA:TRUE\nsubjectKeyIdentifier = hash\nsubjectAltName = {$san}\n");
		cnf->Close();
		FileWriter->New("{$dir}/index.txt")->Close();
		serial := FileWriter->New("{$dir}/serial");
		serial->WriteString("01\n");
		serial->Close();

		made := Runtime->Command("openssl req -new -newkey rsa:2048 -nodes -config {$dir}/openssl.cnf -subj \"{$subject}\" -keyout {$key} -out {$dir}/request.csr") = 0;
		if(made) {
			made := Runtime->Command("openssl ca -batch -selfsign -notext -config {$dir}/openssl.cnf -extensions server -keyfile {$key} -in {$dir}/request.csr -startdate 250101000000Z -enddate 491231235959Z -out {$cert}") = 0;
		};

		Directory->Delete(dir);
		return made;
	}

	function : Main(args : String[]) ~ Nil {
		failed := 0;

		File->Delete("socket-class-{$Runtime->GetProcessId()}-cert.pem");
		File->Delete("socket-class-{$Runtime->GetProcessId()}-key.pem");
		if(<>MakeServerCert("socket-class-{$Runtime->GetProcessId()}-cert.pem", "socket-class-{$Runtime->GetProcessId()}-key.pem", "/CN=localhost", "DNS:localhost,IP:127.0.0.1")) {
			"FAIL: openssl could not create the TLS fixture -- is openssl on PATH?"->PrintLine();
			Runtime->Exit(1);
		};

		# TLS first
		tls := Start(true);
		if(tls = Nil) {
			"FAIL: the TLS server never started listening"->PrintLine();
			Runtime->Exit(1);
		};
		tls_client := TCPSecureSocket->New("localhost", tls->GetPort(), "socket-class-{$Runtime->GetProcessId()}-cert.pem");
		tls->Join();
		tls_client->Close();
		name := tls->GetClassName();
		if(name = Nil | <>name->Equals("System.IO.Net.TCPSecureSocket")) {
			"  FAIL: the TLS server accepted a {$name}"->PrintLine();
			failed += 1;
		};

		# then plain
		plain := Start(false);
		if(plain = Nil) {
			"FAIL: the TCP server never started listening"->PrintLine();
			Runtime->Exit(1);
		};
		plain_client := TCPSocket->New("127.0.0.1", plain->GetPort());
		plain->Join();
		plain_client->Close();
		name := plain->GetClassName();
		if(name = Nil | <>name->Equals("System.IO.Net.TCPSocket")) {
			"  FAIL: the TCP server accepted a {$name} after a TLS accept"->PrintLine();
			failed += 1;
		};

		File->Delete("socket-class-{$Runtime->GetProcessId()}-cert.pem");
		File->Delete("socket-class-{$Runtime->GetProcessId()}-key.pem");

		if(failed > 0) {
			Runtime->Exit(1);
		};
		"PASS: each server accepts sockets of its own class"->PrintLine();
	}

	# a server on port 0: the system picks a free port, which the server reads
	# back once it listens, so no two runs collide and nothing is retried
	function : Start(secure : Bool) ~ OneAccept {
		candidate := OneAccept->New(secure, 0);
		candidate->Execute(Nil);
		waited := 0;
		while(<>candidate->IsListening() & <>candidate->IsFinished() & waited < 5000) {
			Thread->Sleep(25);
			waited += 25;
		};
		if(candidate->IsListening()) {
			return candidate;
		};

		return Nil;
	}
}
