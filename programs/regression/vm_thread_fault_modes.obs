#~
Fixture for run_vm_flag_tests.py (check_thread_fault_isolation): what an error
nothing catches does, per --thread-faults / OBJECK_THREAD_FAULTS, and what never
changes.

  worker-fault   a spawned thread divides by zero while a second one keeps
                 working, and the main thread joins both and reports
  main-fault     the main thread divides by zero while a worker is alive
  worker-exit    a spawned thread calls Runtime->Exit(7)
  worker-nil     the worker dereferences Nil from a method the JIT compiles

With no argument (as the regression runner starts it) it prints one line and
exits 0.
~#
use System.Concurrency;

class Steady from Thread {
	@done : Bool;

	New() {
		Parent("steady");
		@done := false;
	}

	method : public : Run(param : System.Base) ~ Nil {
		total := 0;
		for(i := 0; i < 20000; i += 1;) {
			total += String->New("steady {$i}")->Size();
			if(i % 4000 = 0) {
				Thread->Sleep(10);
			};
		};
		@done := total > 0;
	}

	method : public : IsDone() ~ Bool {
		return @done;
	}
}

class Faulty from Thread {
	@mode : String;

	New(mode : String) {
		Parent("faulty");
		@mode := mode;
	}

	function : Deref(i : Int) ~ Int {
		s : String;
		if(i >= 30) {
			return s->Size();
		};
		return i;
	}

	method : public : Run(param : System.Base) ~ Nil {
		Thread->Sleep(20);
		if(@mode->Equals("worker-exit")) {
			Runtime->Exit(7);
		};
		if(@mode->Equals("worker-nil")) {
			total := 0;
			for(i := 0; i < 40; i += 1;) {
				total += Deref(i);
			};
			"UNREACHABLE: the worker went on"->PrintLine();
			return;
		};
		zero := 0;
		(10 / zero)->PrintLine();
		"UNREACHABLE: the worker went on"->PrintLine();
	}
}

class VmThreadFaultModes {
	function : Main(args : String[]) ~ Nil {
		if(args->Size() = 0) {
			"vm_thread_fault_modes: no mode given"->PrintLine();
			return;
		};

		mode := args[0];
		steady := Steady->New();
		steady->Execute(Nil);
		if(mode->Equals("main-fault")) {
			Thread->Sleep(20);
			zero := 0;
			(10 / zero)->PrintLine();
			"UNREACHABLE: main went on"->PrintLine();
			return;
		};

		faulty := Faulty->New(mode);
		faulty->Execute(Nil);
		faulty->Join();
		fault := Runtime->GetProperty("runtime.thread.join.fault");
		steady->Join();
		"steady finished: {$(steady->IsDone())}"->PrintLine();
		"fault reported: {$fault}"->PrintLine();
		"main continues"->PrintLine();
	}
}
