#~
Pinned Float loop locals survive calls, allocation and a safepoint park.

The JIT keeps a loop's hottest Float locals in XMM6-XMM9. Those are callee-saved
on Windows, so a call leaves them alone; under SysV every XMM register is
caller-saved, so on Linux the JIT stores the pinned floats to their frame slots
before each call in the loop and reloads them after (call_reg). Until that
existed a POSIX loop kept every float in a stack slot -- correct, but the single
thread mandelbrot ran 58 instructions per iteration to LuaJIT's 17.

Each check below runs the same arithmetic twice: once on locals, which the JIT
pins, and once on instance fields, which it cannot, in the same order of
operations, so the two agree exactly. The loops call a method, libm (Sin, Pow
with two float arguments), allocate a string, exit early with a value still in a
register, and nest a call in an inner loop. The last check spins a float-only
loop while another thread allocates until the collector runs: the spinning thread
has to park at its loop-header safepoint with the pins live, and come back with
every float intact. Exits 1 on a failure.
~#
use System.Concurrency;

class Ref {
  @a : Float;
  @b : Float;
  @c : Float;
  @d : Float;

  New() {
    @a := 0.5;
    @b := 1.25;
    @c := -0.75;
    @d := 2.0;
  }

  method : public : Mix(x : Float) ~ Float {
    return x * 0.5 + 0.125;
  }

  method : public : Step(i : Int) ~ Nil {
    @a := @a * 0.999 + Mix(@b);
    @b := @b + Float->Sin(@a) * 0.001;
    @c := @c * 0.5 + @a * 0.25;
    s := "x{$i}";
    @d := @d + s->Size()->As(Float) * 0.0001;
    @c := @c + Float->Pow(1.0 + @b * @b, 0.5) * 0.001;
  }

  method : public : Sum() ~ Float {
    return @a + @b + @c + @d;
  }
}

class Worker from Thread {
  @done : Bool;
  @rounds : Int;

  New(rounds : Int) {
    Parent("alloc-worker");
    @rounds := rounds;
    @done := false;
  }

  method : public : IsDone() ~ Bool {
    return @done;
  }

  method : public : Run(param : Base) ~ Nil {
    keep : Int[];
    each(i : @rounds) {
      keep := Int->New[512];
      keep[0] := i;
    };
    @done := true;
  }
}

class JitFloatPinCalls {
  @fails : static : Int;

  function : Main(args : String[]) ~ Nil {
    @fails := 0;

    # the reference: fields, never pinned
    ref := Ref->New();
    each(i : 4000) {
      ref->Step(i);
    };
    expect := ref->Sum();

    # the same arithmetic on locals, called enough times to compile either way
    each(r : 12) {
      got := OnLocals(4000, Ref->New());
      Expect(got = expect, "locals across calls agree with fields (round {$r}: {$got} vs {$expect})");
    };

    # a loop that exits early with floats in registers, then uses them
    early := EarlyExit(Ref->New());
    earlyRef := EarlyExitRef(Ref->New());
    Expect(early = earlyRef, "an early exit hands the pinned floats on ({$early} vs {$earlyRef})");

    # a call in an inner loop of a nest
    nested := Nested(Ref->New(), 60, 40);
    nestedRef := NestedRef(Ref->New(), 60, 40);
    Expect(nested = nestedRef, "a call in an inner loop keeps the outer loop's floats ({$nested} vs {$nestedRef})");

    # a float-only loop on this thread while another thread forces collections
    spinRef := Spin(3000000);
    worker := Worker->New(600000);
    worker->Execute(Nil);
    spins := 0;
    bad := 0;
    while(<>worker->IsDone()) {
      if(Spin(3000000) <> spinRef) {
        bad += 1;
      };
      spins += 1;
    };
    worker->Join();
    Expect(bad = 0, "a float loop parked at its safepoint keeps its floats ({$bad} of {$spins} spins differed)");
    Expect(spins > 0, "the float loop ran while the allocator did");

    if(@fails > 0) {
      Runtime->Exit(1);
    };
    "PASS: pinned floats survive calls, early exits, nests and safepoint parks"->PrintLine();
  }

  function : Expect(ok : Bool, what : String) ~ Nil {
    if(<>ok) {
      "FAIL: {$what}"->PrintLine();
      @fails += 1;
    };
  }

  function : native : OnLocals(n : Int, obj : Ref) ~ Float {
    a := 0.5;
    b := 1.25;
    c := -0.75;
    d := 2.0;
    for(i := 0; i < n; i += 1;) {
      a := a * 0.999 + obj->Mix(b);
      b := b + Float->Sin(a) * 0.001;
      c := c * 0.5 + a * 0.25;
      s := "x{$i}";
      d := d + s->Size()->As(Float) * 0.0001;
      c := c + Float->Pow(1.0 + b * b, 0.5) * 0.001;
    };

    return a + b + c + d;
  }

  function : native : EarlyExit(obj : Ref) ~ Float {
    a := 0.5;
    b := 1.25;
    c := -0.75;
    i := 0;
    while(true) {
      a := a * 1.01 + obj->Mix(b);
      b := b + Float->Sin(a) * 0.01;
      c := c + a * 0.001;
      i += 1;
      if(a > 100.0 | i > 100000) {
        break;
      };
    };

    return a + b + c + i->As(Float);
  }

  function : EarlyExitRef(obj : Ref) ~ Float {
    a := 0.5;
    b := 1.25;
    c := -0.75;
    i := 0;
    while(true) {
      a := a * 1.01 + obj->Mix(b);
      b := b + Float->Sin(a) * 0.01;
      c := c + a * 0.001;
      i += 1;
      if(a > 100.0 | i > 100000) {
        break;
      };
    };

    return a + b + c + i->As(Float);
  }

  function : native : Nested(obj : Ref, outer : Int, inner : Int) ~ Float {
    total := 0.0;
    scale := 1.0;
    for(i := 0; i < outer; i += 1;) {
      acc := scale;
      for(j := 0; j < inner; j += 1;) {
        acc := acc * 0.99 + obj->Mix(acc) * 0.01 + Float->Sin(acc) * 0.001;
      };
      total := total + acc;
      scale := scale * 1.001;
    };

    return total + scale;
  }

  function : NestedRef(obj : Ref, outer : Int, inner : Int) ~ Float {
    total := 0.0;
    scale := 1.0;
    for(i := 0; i < outer; i += 1;) {
      acc := scale;
      for(j := 0; j < inner; j += 1;) {
        acc := acc * 0.99 + obj->Mix(acc) * 0.01 + Float->Sin(acc) * 0.001;
      };
      total := total + acc;
      scale := scale * 1.001;
    };

    return total + scale;
  }

  # float-only: the sole call in the loop is the safepoint poll's slow path
  function : native : Spin(n : Int) ~ Float {
    a := 0.5;
    b := 1.25;
    c := -0.75;
    d := 2.0;
    for(i := 0; i < n; i += 1;) {
      a := a * 0.9999999 + b * 0.0000001;
      b := b * 0.9999999 - c * 0.0000001;
      c := c * 0.9999999 + d * 0.0000001;
      d := d * 0.9999999 + a * 0.0000001;
    };

    return a + b + c + d;
  }
}
