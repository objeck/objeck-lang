#~
# The same on the GPU: several Objeck threads share one CUDA or TensorRT session. Skips without a GPU provider.
#
# EXTRA_LIBS: models,onnx,opencv,cipher,json
#
# One ONNX Runtime session may be used by many threads at once: Run is thread safe. What
# this checks is that it is safe from OBJECK threads too, which is a different question,
# because Objeck's collector is stop-the-world. It waits for every thread to reach a safe
# point, and a thread inside a native call that blocks is not at one unless the library
# says so. A model run that takes 50 ms would hold up every collection in the process for
# 50 ms -- and a collection that cannot start is a thread that cannot allocate, so a
# program with a garbage-heavy thread beside an inference thread stalls both.
#
# So a Run, and a bound run, park the calling thread for the length of the inference
# (APITools_Parked), and this test is the program that would deadlock or corrupt results
# if that were wrong: 4 worker threads share ONE session and run it 60 times each,
# some through Session->Run and some through their own BoundSession, while another thread
# allocates and drops garbage without pause so that collections keep happening mid-run.
#
#   * every answer must equal the single-threaded answer for the same input (the shift of
#     the input is different for every worker and round, so a crossed result between threads
#     would show),
#   * the program must finish (the test runner kills a hang at 60 seconds),
#   * and the churn thread must have made progress, so collections really did run.
#
# The model is the tiny BERT classifier tracked under data/bert.
~#

use API.Onnx;
use API.Models;
use Collection;
use System.Concurrency;
use System.IO.Filesystem;

class Shared {
	@mutex : ThreadMutex;
	@done : Bool;
	@churned : Int;

	New() {
		@mutex := ThreadMutex->New("shared");
	}

	method : public : IsDone() ~ Bool {
		critical(@mutex) {
			return @done;
		};

		return false;
	}

	method : public : Finish() ~ Nil {
		critical(@mutex) {
			@done := true;
		};
	}

	method : public : AddChurn(n : Int) ~ Nil {
		critical(@mutex) {
			@churned += n;
		};
	}

	method : public : GetChurn() ~ Int {
		critical(@mutex) {
			return @churned;
		};

		return 0;
	}
}

# makes garbage until told to stop
class Churn from Thread {
	@shared : Shared;

	New(shared : Shared) {
		Parent("churn");
		@shared := shared;
	}

	method : public : Run(param : System.Base) ~ Nil {
		rounds := 0;
		while(<>@shared->IsDone()) {
			keep := Vector->New()<String>;
			for(i := 0; i < 400; i += 1;) {
				keep->AddBack(String->New("garbage {$rounds} {$i}"));
				block := Float->New[256];
				block[0] := i->ToFloat();
			};
			rounds += 1;
		};

		@shared->AddChurn(rounds);
	}
}

class Worker from Thread {
	@session : Session;
	@expected : Vector<Floats>;
	@id : Int;
	@rounds : Int;
	@bound : Bool;
	@failures : Int;

	New(id : Int, session : Session, expected : Vector<Floats>, rounds : Int, bound : Bool) {
		Parent("worker {$id}");
		@id := id;
		@session := session;
		@expected := expected;
		@rounds := rounds;
		@bound := bound;
	}

	method : public : GetFailures() ~ Int {
		return @failures;
	}

	method : public : Run(param : System.Base) ~ Nil {
		if(@bound) {
			RunBound();
		}
		else {
			RunPlain();
		};
	}

	method : RunPlain() ~ Nil {
		for(i := 0; i < @rounds; i += 1;) {
			shift := (@id + i) % @expected->Size();
			got := OnnxConcurrency->Answer(@session, shift);
			if(<>OnnxConcurrency->Close(got, @expected->Get(shift)->Get())) {
				@failures += 1;
			};
		};
	}

	method : RunBound() ~ Nil {
		ids := DeviceTensor->ForInput(@session, "input_ids", [2, 6]);
		mask := DeviceTensor->ForInput(@session, "attention_mask", [2, 6]);
		types := DeviceTensor->ForInput(@session, "token_type_ids", [2, 6]);
		out := DeviceTensor->ForOutput(@session, "logits", [2, 1]);
		bound := BoundSession->New(@session);
		bound->BindInput("input_ids", ids);
		bound->BindInput("attention_mask", mask);
		bound->BindInput("token_type_ids", types);
		bound->BindOutput("logits", out);
		mask->Upload(OnnxConcurrency->Ones());
		types->Upload(Float->New[12]);

		for(i := 0; i < @rounds; i += 1;) {
			shift := (@id + i) % @expected->Size();
			ids->Upload(OnnxConcurrency->Ids(shift));
			if(<>bound->Run()) {
				@failures += 1;
			}
			else if(<>OnnxConcurrency->Close(out->Download(), @expected->Get(shift)->Get())) {
				@failures += 1;
			};
		};

		bound->Close();
		ids->Close();
		mask->Close();
		types->Close();
		out->Close();
	}
}

# a Float[] cannot be a generic argument
class Floats {
	@values : Float[];

	New(values : Float[]) {
		@values := values;
	}

	method : public : Get() ~ Float[] {
		return @values;
	}
}

class OnnxConcurrency {
	@ok : Bool;

	function : Main(args : String[]) ~ Nil {
		t := OnnxConcurrency->New();
		t->Go();
	}

	New() {
		@ok := true;
	}

	method : Report(name : String, cond : Bool) ~ Nil {
		if(cond) {
			"PASS: {$name}"->PrintLine();
		}
		else {
			"FAIL: {$name}"->PrintLine();
			@ok := false;
		};
	}

	method : LibraryPresent() ~ Bool {
		dir := Runtime->GetProperty("lib_dir");
		if(dir = Nil) {
			return false;
		};

		base := "{$dir}native/libobjk_onnx";
		return System.IO.Filesystem.File->Exists("{$base}.dll") |
			System.IO.Filesystem.File->Exists("{$base}.so") |
			System.IO.Filesystem.File->Exists("{$base}.dylib");
	}

	function : Model() ~ String {
		return "data/bert/classifier/bert_one_label/model.onnx";
	}

	function : Ids(shift : Int) ~ Float[] {
		values := Float->New[12];
		for(i := 0; i < 12; i += 1;) {
			values[i] := ((i * 7 + shift * 3) % 25)->ToFloat();
		};

		return values;
	}

	function : Ones() ~ Float[] {
		values := Float->New[12];
		for(i := 0; i < 12; i += 1;) {
			values[i] := 1.0;
		};

		return values;
	}

	function : Answer(session : Session, shift : Int) ~ Float[] {
		inputs := Vector->New()<Tensor>;
		inputs->AddBack(Tensor->New("input_ids", "INT64", [2, 6], Ids(shift)));
		inputs->AddBack(Tensor->New("attention_mask", "INT64", [2, 6], Ones()));
		inputs->AddBack(Tensor->New("token_type_ids", "INT64", [2, 6], Float->New[12]));
		outputs := session->Run(inputs);
		if(outputs = Nil | outputs->Size() = 0) {
			return Nil;
		};

		return outputs->Get(0)->GetFloats();
	}

	function : Close(a : Float[], b : Float[]) ~ Bool {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return false;
		};

		for(i := 0; i < a->Size(); i += 1;) {
			if((a[i] - b[i])->Abs() > 0.00001) {
				return false;
			};
		};

		return true;
	}

	method : Go() ~ Nil {
		if(<>LibraryPresent()) {
			"SKIP: libobjk_onnx is not deployed"->PrintLine();
			return;
		};

		if(<>File->Exists(Model())) {
			Report("the tiny BERT classifier is present at {$Model()}", false);
			Runtime->Exit(1);
		};

		# which GPU providers really open a session here?
		usable := Vector->New()<String>;
		candidates := ["cuda", "tensorrt"];
		each(provider in candidates) {
			if(OnnxRuntime->HasProvider(provider)) {
				config := Map->New()<String, String>;
				config->Insert("ep", provider);
				probe := Session->New(Model(), config);
				if(probe->IsOpen()) {
					probe->Close();
					usable->AddBack(provider);
				}
				else {
					"note: ep={$provider} is listed by this runtime but a session did not open"->PrintLine();
				};
			};
		};

		if(usable->Size() = 0) {
			"SKIP: no GPU execution provider opens a session here (needs a CUDA or TensorRT ONNX Runtime, the NVIDIA driver, CUDA 12 and cuDNN 9)"->PrintLine();
			return;
		};

		each(provider in usable) {
			Suite(provider);
		};

		if(<>@ok) {
			Runtime->Exit(1);
		};

		"reached the end without aborting"->PrintLine();
	}

	method : Suite(ep : String) ~ Nil {
		tag := "ep={$ep}";
		config := Map->New()<String, String>;
		config->Insert("ep", ep);
		session := Session->New(Model(), config);
		Report("{$tag}: the shared session opens", session->IsOpen());
		if(<>session->IsOpen()) {
			return;
		};

		# the single-threaded answer for each of eight inputs
		expected := Vector->New()<Floats>;
		for(s := 0; s < 8; s += 1;) {
			expected->AddBack(Floats->New(Answer(session, s)));
		};
		Report("{$tag}: eight different inputs give eight single-threaded answers", expected->Get(0)->Get() <> Nil & <>Close(expected->Get(0)->Get(), expected->Get(1)->Get()));

		shared := Shared->New();
		churn := Churn->New(shared);
		workers := Vector->New()<Worker>;
		for(w := 0; w < 4; w += 1;) {
			# half the workers use Session->Run, half their own IO binding
			workers->AddBack(Worker->New(w, session, expected, 60, w % 2 = 1));
		};

		churn->Execute(Nil);
		each(w : workers) { workers->Get(w)->Execute(Nil); };
		failures := 0;
		each(w : workers) {
			workers->Get(w)->Join();
			failures += workers->Get(w)->GetFailures();
		};
		shared->Finish();
		churn->Join();

		Report("{$tag}: 4 threads x 60 runs on one session, every answer right ({$failures} wrong)", failures = 0);
		Report("{$tag}: the garbage thread ran throughout, so collections did happen mid-run", shared->GetChurn() > 0);
		session->Close();
	}
}
