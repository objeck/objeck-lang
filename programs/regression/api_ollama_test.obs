# SKIP_ALLOWED: Ollama not running
# EXTRA_LIBS: ollama,net,json,cipher,misc
use API.Ollama, Collection;

class ApiOllamaTest {
	function : Main(args : String[]) ~ Nil {
		pass := true;

		# --- Offline tests ---

		# Host configuration
		EndPoint->SetHost("http://myhost:1234");
		if(<>EndPoint->GetHost()->Equals("http://myhost:1234")) {
			"  FAIL: SetHost/GetHost"->PrintLine();
			pass := false;
		};
		# reset to default
		EndPoint->SetHost("http://localhost:11434");

		# Options class
		opts := Options->New();
		opts->SetTemperature(0.7)->SetTopP(0.9)->SetTopK(40);
		opts_json := opts->ToJson();
		if(opts_json = Nil) {
			"  FAIL: Options ToJson returned Nil"->PrintLine();
			pass := false;
		};

		# Tool class
		params := Data.JSON.JsonParser->TextToElement("{\"type\":\"object\",\"properties\":{\"location\":{\"type\":\"string\"}}}");
		tool := Tool->New("get_weather", "Get the weather", params);
		tool_json := tool->ToJson();
		if(tool_json = Nil) {
			"  FAIL: Tool ToJson returned Nil"->PrintLine();
			pass := false;
		};

		# --- Online tests (skip if Ollama not running) ---
		# OLLAMA_HOST (e.g. http://myserver:11434) selects a non-default server
		host := System.Runtime->GetEnvironmentVariable("OLLAMA_HOST");
		if(host <> Nil & host->Size() > 0) {
			if(<>host->StartsWith("http")) {
				host := "http://{$host}";
			};
			EndPoint->SetHost(host);
		};

		models := Model->List();
		if(models = Nil) {
			"SKIP: Ollama not running"->PrintLine();
		}
		else {
			# Model list
			"  Ollama models found: {$models->Size()}"->PrintLine();

			# every listing entry, old or new server, is a listing entry with a name
			each(i : models) {
				pulled := models->Get(i)->GetPulled();
				if(pulled = Nil | pulled->GetName() = Nil) {
					"  FAIL: model list entry {$i} is not a listing entry"->PrintLine();
					pass := false;
				};
			};

			# Simple generation (use the first model that can complete text)
			model_name : String;
			each(i : models) {
				pulled := models->Get(i)->GetPulled();
				if(model_name = Nil & pulled <> Nil & pulled->GetName() <> Nil) {
					caps := pulled->GetCapabilities();
					if(caps->Size() = 0 | HasCap(caps, "completion")) {
						model_name := pulled->GetName();
					};
				};
			};

			if(model_name = Nil) {
				"SKIP: no completion model on the Ollama server"->PrintLine();
			}
			else {
				# Show returns the model information record
				shown := Model->Show(model_name);
				if(shown = Nil | shown->GetInfo() = Nil) {
					"  FAIL: Show did not return a model information record"->PrintLine();
					pass := false;
				}
				else {
					"  Show OK"->PrintLine();
				};

				response := Completion->Generate(model_name, "Say hello in one word");
				if(response = Nil | response->IsEmpty()) {
					"  FAIL: Generate returned empty"->PrintLine();
					pass := false;
				}
				else {
					"  Generate OK"->PrintLine();
				};

				# Chat with options
				chat := Chat->New(model_name);
				opts := Options->New();
				opts->SetTemperature(0.1);
				chat_response := chat->Send("What is 2+2? Answer with just the number.", opts);
				if(chat_response = Nil | chat_response->IsEmpty()) {
					"  FAIL: Chat Send returned empty"->PrintLine();
					pass := false;
				}
				else {
					"  Chat OK"->PrintLine();
				};
			};
		};

		if(pass) {
			"PASS: Ollama API tests"->PrintLine();
		}
		else {
			"FAIL: Ollama API tests"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : HasCap(caps : Vector<String>, name : String) ~ Bool {
		each(i : caps) {
			if(caps->Get(i)->Equals(name)) {
				return true;
			};
		};
		return false;
	}
}
