# EXPECT_COMPILE_ERROR: Invalid escape sequence '\q' in a string literal
# EXPECT_ERROR_COUNT: 1
#~
The error names the escape and points at its backslash, with the source line, instead of
"Invalid escaped string literal" for the string as a whole.
~#
class BadStringEscapeUnknown {
	function : Main(args : String[]) ~ Nil {
		s := "a\qb";
		s->PrintLine();
	}
}
