# EXTRA_LIBS: mcp,agent,mcp_agent,net,net_server,cipher,misc
#~
The run's deadline reaches a tool that runs on the loop's own thread (API.Agent, API.MCP), against a
scripted model, so no key and no network are needed.

A tool handed the run's token (AgentCancelableHandler), and a declared MCP function, which hears of it as
McpCall->IsCancelled(), are told that the token also becomes cancelled when the run's deadline passes. It
did only when somebody else noticed the deadline: the loop, between calls, or while it waited for a worker
(BOUNDED_THREAD). In the default mode, IN_THREAD, the loop is inside the handler, nobody looked at the
clock, and a handler that worked until it was cancelled never returned. The token now knows the deadline
itself.

Each handler here works until its token says stop, with a limit of its own of 20 s so that a failure is a
failed check and not a hung test. The run has a deadline of 1 s (300 ms for the scope) and must be back in
under 5 s, with the stop reason deadline.
~#
use API.MCP, API.Agent, Data.JSON, Collection, System.Concurrency;

# works until the token is cancelled
class Polite implements AgentCancelableHandler {
	New() {
	}

	method : public : Run(arguments : JsonElement, cancel : AgentCancel) ~ String {
		waited := 0;
		while(<>cancel->IsCancelled() & waited < 20000) {
			Thread->Sleep(5);
			waited += 5;
		};
		McpAgentDeadlineTest->Saw(cancel->IsCancelled(), cancel->GetReason());
		return "stopped after {$waited} ms";
	}
}

class McpAgentDeadlineTest {
	@pass : static : Int;
	@fail : static : Int;
	@saw : static : Bool;
	@why : static : String;

	function : Check(ok : Bool, what : String) ~ Nil {
		if(ok) {
			@pass += 1;
		}
		else {
			@fail += 1;
			"  FAIL: {$what}"->PrintLine();
		};
	}

	function : Saw(cancelled : Bool, why : String) ~ Nil {
		@saw := cancelled;
		@why := why;
	}

	# works until the call is cancelled, as a polite tool does
	function : Wait(call : McpCall) ~ McpToolResult {
		waited := 0;
		while(<>call->IsCancelled() & waited < 20000) {
			Thread->Sleep(5);
			waited += 5;
		};
		@saw := call->IsCancelled();
		return McpToolResult->Text("stopped after {$waited} ms");
	}

	# returns at once, and says what the token looked like
	function : Quick(call : McpCall) ~ McpToolResult {
		@saw := call->IsCancelled();
		return McpToolResult->Text("quick");
	}

	function : Registry() ~ ToolRegistry {
		registry := ToolRegistry->New();
		registry->Add(McpAgentTools->FromSpec(McpToolSpec->New("wait", "Works until cancelled"), Func2Ref->New(McpAgentDeadlineTest->Wait(McpCall) ~ McpToolResult)<McpCall, McpToolResult>));
		registry->Add(McpAgentTools->FromSpec(McpToolSpec->New("quick", "Returns at once"), Func2Ref->New(McpAgentDeadlineTest->Quick(McpCall) ~ McpToolResult)<McpCall, McpToolResult>));
		registry->Add(AgentTool->New("polite", "Works until its token is cancelled", JsonParser->TextToElement("{\"type\":\"object\",\"properties\":{}}"), Polite->New()));
		return registry;
	}

	function : NewAgent(tool : String) ~ Agent {
		script := Vector->New()<AgentReply>;
		script->AddBack(AgentReply->Ask("c1", tool, "{}"));
		script->AddBack(AgentReply->Say("done"));
		return Agent->New(ScriptedBackend->New(script), Registry());
	}

	function : Status(result : AgentResult) ~ String {
		return result->GetSteps()->Get(0)->GetResults()->Get(0)->GetStatus();
	}

	function : Same(a : String, b : String) ~ Bool {
		return a <> Nil & b <> Nil & a->Equals(b);
	}

	# one run of a tool that works until it is cancelled, under a deadline of a second
	function : Deadline(tool : String, mode : AgentTool->Mode, what : String) ~ Nil {
		@saw := false;
		@why := Nil;
		agent := NewAgent(tool);
		agent->SetToolMode(mode);
		agent->SetBudget(AgentBudget->New()->SetMaxWallMs(1000));

		timer := System.Time.Timer->New(true);
		result := agent->Run("go");
		elapsed := (timer->GetElapsedTime() * 1000.0)->As(Int);
		"  {$what}: back after {$elapsed} ms, {$result->GetStopReason()}"->ErrorLine();
		Check(elapsed >= 900 & elapsed < 5000, "{$what}: the run is back about when its deadline passes, not at the handler's own limit ({$elapsed} ms)");
		Check(Same(result->GetStopReason(), "deadline"), "{$what}: the stop reason is deadline");
		Check(result->GetSteps()->Size() = 1 & result->GetModelCalls() = 1, "{$what}: the model is not asked again");
		if(mode = AgentTool->Mode->BOUNDED_THREAD) {
			# the handler hears of the deadline from the token as soon as the loop does; the call is a timeout either way
			Check(Same(Status(result), "timeout"), "{$what}: the call is a timeout, its result discarded");
		}
		else {
			Check(Same(Status(result), "ok"), "{$what}: the handler returned by itself, so its result is kept");
		};
	}

	function : InThread() ~ Nil {
		Deadline("wait", AgentTool->Mode->IN_THREAD, "a declared MCP function on the loop's thread");
		Check(@saw, "the function saw IsCancelled");

		Deadline("polite", AgentTool->Mode->IN_THREAD, "a handler with a token on the loop's thread");
		Check(@saw & Same(@why, "deadline"), "the handler saw its token cancelled, with the reason deadline");
	}

	# what already worked: a worker thread, where the loop watches the clock
	function : Bounded() ~ Nil {
		Deadline("wait", AgentTool->Mode->BOUNDED_THREAD, "a declared MCP function on a worker");
		Deadline("polite", AgentTool->Mode->BOUNDED_THREAD, "a handler with a token on a worker");
		# the abandoned workers hear of the deadline at their next poll and end
		Thread->Sleep(200);
	}

	function : UnderScope() ~ Nil {
		agent := NewAgent("wait");
		timer := System.Time.Timer->New(true);
		result := agent->Run("go");
		elapsed := (timer->GetElapsedTime() * 1000.0)->As(Int);
		"  a scope's wall limit: back after {$elapsed} ms, {$result->GetStopReason()}"->ErrorLine();
		Check(elapsed >= 250 & elapsed < 5000, "a scope's wall limit is a deadline the token knows as well ({$elapsed} ms)");
		Check(Same(result->GetStopReason(), "deadline"), "and the stop reason is deadline");
	}

	function : Unchanged() ~ Nil {
		# no deadline: the token says nothing by itself
		@saw := true;
		agent := NewAgent("quick");
		result := agent->Run("go");
		Check(result->IsCompleted() & <>@saw, "with no deadline the token is not cancelled and the run completes");

		# a deadline that is not reached changes nothing
		@saw := true;
		agent := NewAgent("quick");
		agent->SetBudget(AgentBudget->New()->SetMaxWallMs(60000));
		result := agent->Run("go");
		Check(result->IsCompleted() & <>@saw & Same(Status(result), "ok"), "a deadline that is not reached changes nothing");

		# a cancel before the deadline is still a cancel
		cancel := AgentCancel->New();
		cancel->Cancel("the user stopped it");
		agent := NewAgent("quick");
		agent->SetCancel(cancel);
		agent->SetBudget(AgentBudget->New()->SetMaxWallMs(60000));
		result := agent->Run("go");
		Check(Same(result->GetStopReason(), "cancelled") & result->GetError()->Has("the user stopped it"), "a cancel before the deadline is reported as cancelled, with its reason");

		# the same agent runs again after a deadline, with a new token
		agent := NewAgent("wait");
		agent->SetBudget(AgentBudget->New()->SetMaxWallMs(200));
		first := agent->Run("go");
		agent->SetBudget(Nil);
		second := agent->Run("again");
		Check(Same(first->GetStopReason(), "deadline") & second->IsCompleted(), "after a deadline the same agent runs again: the next run's token is new");
	}

	function : Main(args : String[]) ~ Nil {
		InThread();
		Bounded();
		AgentScope->Run(AgentScope->New()->SetMaxWallMs(300), McpAgentDeadlineTest->UnderScope() ~ Nil);
		Unchanged();

		pass := @pass;
		fail := @fail;
		if(fail = 0) {
			"PASS: MCP agent deadline, {$pass} checks"->PrintLine();
		}
		else {
			"FAIL: MCP agent deadline, {$fail} of {$pass + fail} checks failed"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
