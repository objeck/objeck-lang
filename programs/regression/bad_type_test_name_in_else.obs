# EXPECT_COMPILE_ERROR: (28,4): Undefined variable: 't'
# EXPECT_ERROR_COUNT: 1
#~
In the else block the value is not of the type, so the name is not there either.
~#
class Part {
	New() {
	}
}

class TextPart from Part {
	New() {
		Parent();
	}

	method : public : Size() ~ Int {
		return 4;
	}
}

class BadTypeTestNameInElse {
	function : Main(args : String[]) ~ Nil {
		p : Part := TextPart->New();
		if(p is TextPart t) {
			t->Size()->PrintLine();
		}
		else {
			t->Size()->PrintLine();
		};
	}
}
