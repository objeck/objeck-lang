#~
Regression: Float constants, Float->Abs, ToBinaryString and hoisted Float
division (#1176, #1178).

- Float->Pi() and Float->E() were ten-digit literals, off by about 2e-11, so
  ArcTan2(0, -1) <> Pi() and 2 * Cos(Pi() / 2) was about 4e-11.
- Float->Abs(-0.0) returned -0.0: it multiplied only values below zero.
- Int->ToBinaryString(-5) never returned: `v >> 1` sign-fills, so v stuck at
  -1. The Byte overload looped the same way on a Byte holding -1.
- Loop-invariant code motion counted Float division as unable to trap, so a
  division by zero inside a loop that runs no times could be hoisted out of
  it and raise.
~#

class FloatConstantsAbsBinary {
	@failures : Int;

	New() {
		@failures := 0;
	}

	method : Check(what : String, ok : Bool) ~ Nil {
		if(ok) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckString(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected '{$want}', got '{$got}'"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		pi := Float->Pi();
		Check("Pi() is ArcTan2(0, -1)", Float->ArcTan2(0.0, -1.0) = pi);
		Check("Pi() is 4 * ArcTan(1)", 4.0 * Float->ArcTan(1.0) = pi);
		Check("Cos(Pi() / 2) is below 1e-15", Float->Abs(Float->Cos(pi / 2.0)) < 0.000000000000001);
		Check("E() is Exp(1)", Float->Abs(Float->E() - Float->Exp(1.0)) < 0.000000000000001);

		# the sign of -0.0 only shows through ArcTan2: atan2(+0, -1) = pi,
		# atan2(-0, -1) = -pi
		Check("Abs(-0.0) is +0.0", Float->ArcTan2(Float->Abs(-0.0), -1.0) > 0.0);
		Check("Abs(0.0) is +0.0", Float->ArcTan2(Float->Abs(0.0), -1.0) > 0.0);
		Check("Abs(-2.5) is 2.5", Float->Abs(-2.5) = 2.5);
		Check("Abs(2.5) is 2.5", Float->Abs(2.5) = 2.5);

		CheckString("ToBinaryString(5)", Int->ToBinaryString(5), "101");
		CheckString("ToBinaryString(0)", Int->ToBinaryString(0), "0");
		neg := Int->ToBinaryString(-5);
		Check("ToBinaryString(-5) returns 64 digits", neg->Size() = 64);
		Check("ToBinaryString(-5) ends in ...1011", neg->EndsWith("1011") & neg->StartsWith("1111"));
		CheckString("ToBinaryString(-1) is 64 ones", Int->ToBinaryString(-1), "1111111111111111111111111111111111111111111111111111111111111111");
		b : Byte := 0;
		b -= 1;
		CheckString("Byte ToBinaryString of 0 - 1", Byte->ToBinaryString(b), "11111111");
		c : Byte := 6;
		CheckString("Byte ToBinaryString(6)", Byte->ToBinaryString(c), "110");

		# a loop that runs no times must not evaluate its body's division
		Check("a zero-trip loop's Float division is not hoisted", ZeroTrip(0.0, 0) = 0.0);
		Check("the same loop still divides when it runs", ZeroTrip(2.0, 3) = 1.5);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	method : ZeroTrip(d : Float, n : Int) ~ Float {
		total := 0.0;
		for(i := 0; i < n; i += 1;) {
			total += 1.0 / d;
		};
		return total;
	}

	function : Main(args : String[]) ~ Nil {
		FloatConstantsAbsBinary->New()->Run();
	}
}
