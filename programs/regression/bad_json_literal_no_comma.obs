# EXPECT_COMPILE_ERROR: (13,5): Expected ',' or '}' after a JSON member
# EXPECT_ERROR_COUNT: 1
#~
Members are separated by commas.
~#
use Collection;
use Data.JSON;

class BadJsonLiteralNoComma {
	function : Main(args : String[]) ~ Nil {
		request := json{
			"model": "m"
			"n": 3
		};
		request->ToString()->PrintLine();
	}
}
