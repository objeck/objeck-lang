#~
# A DTLS server can listen on one address, and keeps to it
#
# DTLSSocketServer->New(cert, key, passwd, port) binds every interface, and so
# does each listener after it: a datagram accept hands the listening socket to
# the client and binds a fresh one. New(cert, key, passwd, address, port) binds
# one address, as TCPSocketServer->New(address, port) does -- and the fresh
# listener must bind that address again. Had it bound the wildcard, as every
# listener did, a server given 127.0.0.1 would take clients from anywhere after
# its first.
#
# A server on 127.0.0.1 is sent a ::1 client, a 127.0.0.1 client, a ::1
# client -- after its first accept replaced the listener -- and a second
# 127.0.0.1 client. It must accept exactly the two 127.0.0.1 clients; had either
# ::1 client reached it, it would be among the first two accepted. The same with
# the families swapped for a server on ::1. What is checked is what the server
# accepted: the clients take the self-signed fixture in insecure test mode
# (OBJECK_TLS_INSECURE_SKIP_VERIFY), and whether a client then also accepts
# the certificate for an IP address is a matter for the client, not the bind.
# A name that does not resolve fails Listen().
# EXTRA_LIBS: net
~#

use System.Concurrency, System.IO.Filesystem, System.IO.Net;

class TwoDtlsAccepts from Thread {
	@server : DTLSSocketServer;
	@finished : Bool;
	@first : String;
	@second : String;

	New(server : DTLSSocketServer) {
		Parent("two-dtls-accepts");
		@server := server;
		@finished := false;
	}

	method : public : IsFinished() ~ Bool { return @finished; }
	method : public : GetFirst() ~ String { return @first; }
	method : public : GetSecond() ~ String { return @second; }

	method : public : Run(param : Base) ~ Nil {
		client := @server->Accept();
		if(client <> Nil) {
			@first := client->GetAddress();
			client->Close();
		};
		client := @server->Accept();
		if(client <> Nil) {
			@second := client->GetAddress();
			client->Close();
		};
		@finished := true;
	}
}

class DtlsBindAddress {
	@failed : static : Int;

	# A self-signed certificate for the test's servers, valid from 2025 rather than
	# from the second it is made. `openssl req -x509` starts a certificate "now",
	# and a clock that steps back after that -- a VM resynchronizing its time, as
	# WSL2 does by seconds at a time -- sees a certificate that is not valid yet:
	# the handshake fails "The certificate validity starts in the future". Before
	# OpenSSL 3.4 only `openssl ca` can set the start, so it signs the request, in a
	# scratch directory removed afterwards. The extensions are written out rather
	# than left to each build's defaults.
	function : MakeServerCert(cert : String, key : String, subject : String, san : String) ~ Bool {
		dir := "{$cert}.ca";
		Directory->Delete(dir);
		File->Delete(cert);
		File->Delete(key);
		if(<>Directory->Create(dir)) {
			return false;
		};

		cnf := FileWriter->New("{$dir}/openssl.cnf");
		cnf->WriteString("[req]\ndistinguished_name = dn\n[dn]\n[ca]\ndefault_ca = fixture\n");
		cnf->WriteString("[fixture]\ndatabase = {$dir}/index.txt\nserial = {$dir}/serial\nnew_certs_dir = {$dir}\n");
		cnf->WriteString("policy = any\ndefault_md = sha256\nunique_subject = no\n[any]\ncommonName = supplied\n");
		cnf->WriteString("[server]\nbasicConstraints = critical,CA:TRUE\nsubjectKeyIdentifier = hash\nsubjectAltName = {$san}\n");
		cnf->Close();
		FileWriter->New("{$dir}/index.txt")->Close();
		serial := FileWriter->New("{$dir}/serial");
		serial->WriteString("01\n");
		serial->Close();

		made := Runtime->Command("openssl req -new -newkey rsa:2048 -nodes -config {$dir}/openssl.cnf -subj \"{$subject}\" -keyout {$key} -out {$dir}/request.csr") = 0;
		if(made) {
			made := Runtime->Command("openssl ca -batch -selfsign -notext -config {$dir}/openssl.cnf -extensions server -keyfile {$key} -in {$dir}/request.csr -startdate 250101000000Z -enddate 491231235959Z -out {$cert}") = 0;
		};

		Directory->Delete(dir);
		return made;
	}

	function : Main(args : String[]) ~ Nil {
		@failed := 0;

		File->Delete("dtls-bind-{$Runtime->GetProcessId()}-cert.pem");
		File->Delete("dtls-bind-{$Runtime->GetProcessId()}-key.pem");
		if(<>MakeServerCert("dtls-bind-{$Runtime->GetProcessId()}-cert.pem", "dtls-bind-{$Runtime->GetProcessId()}-key.pem", "/CN=localhost", "DNS:localhost,IP:127.0.0.1,IP:::1")) {
			"FAIL: openssl could not create the DTLS fixture -- is openssl on PATH?"->PrintLine();
			Runtime->Exit(1);
		};
		Runtime->SetEnvironmentVariable("OBJECK_TLS_INSECURE_SKIP_VERIFY", "1");

		"stage: 127.0.0.1"->ErrorLine();
		CheckBound("127.0.0.1", "::1");
		"stage: ::1"->ErrorLine();
		CheckBound("::1", "127.0.0.1");

		"stage: bad address"->ErrorLine();
		bad := DTLSSocketServer->New("dtls-bind-{$Runtime->GetProcessId()}-cert.pem", "dtls-bind-{$Runtime->GetProcessId()}-key.pem", "", "no-such-host.invalid", 0);
		Check("no-such-host.invalid: Listen() fails", <>bad->Listen());
		bad->Close();

		File->Delete("dtls-bind-{$Runtime->GetProcessId()}-cert.pem");
		File->Delete("dtls-bind-{$Runtime->GetProcessId()}-key.pem");

		if(@failed > 0) {
			Runtime->Exit(1);
		};
		"PASS: a DTLS server binds the one address it is given, after each accept too"->PrintLine();
	}

	function : Check(name : String, ok : Bool) ~ Nil {
		if(<>ok) {
			"  FAIL: {$name}"->PrintLine();
			@failed += 1;
		};
	}

	# a DTLS client of address tries a handshake
	function : Try(address : String, port : Int) ~ Nil {
		DTLSSocket->New(address, port)->Close();
	}

	function : CheckBound(bound : String, elsewhere : String) ~ Nil {
		# port 0: the system picks a free port, read back once the server
		# listens, so no two runs collide and nothing is retried
		server := DTLSSocketServer->New("dtls-bind-{$Runtime->GetProcessId()}-cert.pem", "dtls-bind-{$Runtime->GetProcessId()}-key.pem", "", bound, 0);
		Check("{$bound}: the server listens", server->Listen());
		port := server->GetPort();
		if(port = 0) {
			return;
		};

		acceptor := TwoDtlsAccepts->New(server);
		acceptor->Execute(Nil);

		Try(elsewhere, port);
		Try(bound, port);
		# the listener has been replaced by now: it must still be on bound only
		Try(elsewhere, port);
		Try(bound, port);

		waited := 0;
		while(<>acceptor->IsFinished() & waited < 10000) {
			Thread->Sleep(25);
			waited += 25;
		};
		if(acceptor->IsFinished()) {
			acceptor->Join();
		};

		first := acceptor->GetFirst();
		second := acceptor->GetSecond();
		Check("{$bound}: the first client came from {$bound} (reported as '{$first}')", first <> Nil & first->Equals(bound));
		Check("{$bound}: the second client came from {$bound} (reported as '{$second}')", second <> Nil & second->Equals(bound));
		server->Close();
	}
}
