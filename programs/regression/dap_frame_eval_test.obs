# Fixture for frame-scoped DAP evaluation and hit-count breakpoints.
#
# The point of the nesting is that the SAME local name holds a DIFFERENT value
# in every frame. An 'evaluate' that ignores frameId cannot be caught by a
# fixture where each frame has distinct names -- it just answers from the top
# frame and looks right.

class FrameEval {
  function : Main(args : String[]) ~ Nil {
    depth := 1;
    label_text := "main";

    # A line hit repeatedly, for hitCondition. The counter is what the test
    # reads back to learn which hit it stopped on.
    counter := 0;
    for(i := 0; i < 5; i += 1;) {
      counter := i;
    };

    Middle(2);
    "done={$depth},{$counter},{$label_text}"->PrintLine();
  }

  function : Middle(depth : Int) ~ Nil {
    label_text := "middle";
    Inner(3);
    "{$depth}{$label_text}"->PrintLine();
  }

  function : Inner(depth : Int) ~ Nil {
    label_text := "inner";
    # BREAKPOINT LINE -- the stack here is Inner(3) <- Middle(2) <- Main(1).
    marker := depth;
    "{$marker}{$label_text}"->PrintLine();
  }
}
