# EXPECT_COMPILE_ERROR: is overloaded, so the reference is ambiguous
# EXPECT_ERROR_COUNT: 2
#~
A method reference without a signature names more than one function: the
signature cannot be read, so the compiler asks for the full form (line 9).
~#
class BadMethodRefOverloaded {
	function : Main(args : String[]) ~ Nil {
		f : Func2Ref<IntRef, IntRef> := BadMethodRefOverloaded->Dbl;
	}

	function : Dbl(x : IntRef) ~ IntRef { return x; }
	function : Dbl(x : FloatRef) ~ FloatRef { return x; }
}
