  function : Main(args : String[]) ~ Nil {
    bad := 0;
    for(r := 0; r < 50; r += 1;) {
      bad += WithAndOr(20);
      bad += WithLambda(20);
      bad += WithLoop(20);
    };

    if(bad = 0) {
      "PASS: 96-slot frames with the and/or temporary"->PrintLine();
    }
    else {
      "FAIL: {$bad} corrupted local(s)"->PrintLine();
      Runtime->Exit(1);
    };
  }
