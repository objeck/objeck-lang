# EXPECT_COMPILE_ERROR: An array literal element cannot be Nil alone
#~
Array literals with expressions (#1245): Nil takes its type from the literal's
other elements (core_array_literal_nil_element.obs), so a literal of nothing
but Nil has no type to give the array.
~#
class BadArrayLiteralNilElement {
	function : Main(args : String[]) ~ Nil {
		a := [Nil, Nil];
		a->Size()->PrintLine();
	}
}
