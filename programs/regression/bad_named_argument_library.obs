# EXPECT_COMPILE_ERROR: No parameter named 'chr'; the parameters are: char, num, is_left
#~
Named arguments (#1244): a name a library method does not have. The error lists the
parameter names its .obl records.
~#
class BadNamedArgumentLibrary {
	function : Main(args : String[]) ~ Nil {
		"s"->Pad(chr: ' ', num: 4);
	}
}
