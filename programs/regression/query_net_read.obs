# EXTRA_LIBS: net,net_server,regex,csv,misc,query,concurrent
#~
Query.Structured reading files over HTTP (docs/QUERY_DESIGN.md, section 10, phase 5), against an
in-process Web.HTTP.Server: a URL in FROM and in a source's constructor, the format from the URL's
path (a query string ignored, '.gz' honoured), the download cache revalidated by ETag and by
Last-Modified (an unchanged file answers 304 and is not read again, a changed one is), a server
with neither validator, and an error status. Then threads sharing one catalog query URLs at once:
with no validator every query downloads, and each changed file must still be read once, with
every answer right (two threads downloading one URL once wrote one partial file, and one of them
failed).
~#
use Collection, System.IO.Net, Web.HTTP.Server, Query.Structured;

class NetReadHandler from HttpRequestHandler {
	New() { Parent(); }

	method : ProcessGet(request : Request, response : Response) ~ Bool {
		QueryNetRead->Serve(request, response);
		return false;
	}

	method : ProcessPost(request : Request, response : Response) ~ Bool {
		response->SetCode(405);
		return false;
	}
}

class NetReader from System.Concurrency.Thread {
	@catalog : Catalog;
	@sqls : String[];
	@expected : String[];
	@barrier : System.Concurrency.Barrier;
	@wrong : Int;
	@first : String;

	New(catalog : Catalog, sqls : String[], expected : String[], barrier : System.Concurrency.Barrier) {
		Parent("net_reader");
		@catalog := catalog;
		@sqls := sqls;
		@expected := expected;
		@barrier := barrier;
	}

	method : public : GetWrong() ~ Int { return @wrong; }
	method : public : GetFirst() ~ String { return @first; }

	method : public : Run(param : System.Base) ~ Nil {
		each(i : @sqls) {
			@barrier->Await();
			rs := @catalog->Query(@sqls[i]);
			got := rs <> Nil ? rs->ToCsv()->ReplaceAll("\r\n", "\n") : "ERROR: {$(@catalog->GetError())}";
			if(<>got->Equals(@expected[i])) {
				@wrong += 1;
				if(@first = Nil) {
					@first := "'{$(@sqls[i])}' gave '{$got}'";
				};
			};
		};
	}
}

class QueryNetRead {	@port : static : Int;
	@serve_returned : static : Bool;
	@failures : static : Int;
	@bodies : static : Map<String, String>;
	@etags : static : Map<String, String>;
	@dates : static : Map<String, String>;
	@full : static : Int;
	@not_modified : static : Int;

	function : Port() ~ Int { return @port; }
	function : ServeReturned() ~ Nil { @serve_returned := true; }

	function : Check(what : String, ok : Bool) ~ Nil {
		if(<>ok) {
			@failures += 1;
			"  FAIL: {$what}"->PrintLine();
		};
	}

	function : Header(request : Request, name : String) ~ String {
		value := request->GetHeader(name);
		if(value = Nil) {
			value := request->GetHeader(name->ToLower());
		};
		return value;
	}

	# canned files, with whatever validators the test set for each
	function : Serve(request : Request, response : Response) ~ Nil {
		path := request->GetPath();
		body := @bodies->Find(path);
		if(body = Nil) {
			response->SetCode(404);
			return;
		};

		etag := @etags->Find(path);
		date := @dates->Find(path);
		match := Header(request, "If-None-Match");
		since := Header(request, "If-Modified-Since");
		if((etag <> Nil & match <> Nil & match->Equals(etag)) | (etag = Nil & date <> Nil & since <> Nil & since->Equals(date))) {
			@not_modified += 1;
			response->SetCode(304);
			return;
		};

		@full += 1;
		if(etag <> Nil) {
			response->SetHeader("ETag", etag);
		};
		if(date <> Nil) {
			response->SetHeader("Last-Modified", date);
		};

		if(path->EndsWith(".gz")) {
			response->SetCodeContent(200, body->ToByteArray()->CompressGzip());
		}
		else {
			response->SetCodeContent(200, body);
		};
	}

	function : Put(path : String, body : String, etag : String, date : String) ~ Nil {
		@bodies->Insert(path, body);
		if(etag <> Nil) {
			@etags->Insert(path, etag);
		}
		else {
			@etags->Remove(path);
		};
		if(date <> Nil) {
			@dates->Insert(path, date);
		}
		else {
			@dates->Remove(path);
		};
	}

	function : StartServer() ~ Bool {
		# Serve on port 0: the system picks a free port, so two runs of this suite
		# on one machine cannot collide. The port is known once the server listens
		# (WebServer->GetBoundPort), so no client probe and no retry are needed.
		@port := 0;
		@serve_returned := false;
		server_thread := System.Concurrency.Thread->New() {
			New() { Parent(); }
			method : public : Run(arg : System.Base) ~ Nil {
				WebServer->Serve(NetReadHandler->New()->GetClass(), 0, false);
				QueryNetRead->ServeReturned();
			}
		};
		server_thread->Execute(Nil);

		waited := 0;
		while(<>@serve_returned & WebServer->GetBoundPort() = 0 & waited < 10000) {
			System.Concurrency.Thread->Sleep(25);
			waited += 25;
		};
		@port := WebServer->GetBoundPort();
		return @port > 0;
	}

	function : Main(args : String[]) ~ Nil {
		@failures := 0;
		@bodies := Map->New()<String, String>;
		@etags := Map->New()<String, String>;
		@dates := Map->New()<String, String>;

		# The download cache lives under the system's temporary folder, keyed by URL, and
		# this run's URLs name whatever port the system chose: an earlier run on the same
		# port leaves entries that would answer the first fetch with a 304, and a run
		# alongside this one shares the folder. So the cache is pointed, through the
		# 'tmp_dir' property Runtime->GetTempDir reads, at a folder of this process's
		# own, removed at the end.
		pid := Runtime->GetProcessId();
		cache_root := "{$Runtime->GetTempDir()}/objeck_query_net_read_{$pid}";
		System.IO.Filesystem.Directory->Create(cache_root);
		Runtime->SetProperty("tmp_dir", cache_root);

		Put("/data/runs.csv", "id,score\n1,0.5\n2,0.75\n", "\"v1\"", Nil);
		Put("/data/dated.csv", "id\n1\n", Nil, "Wed, 21 Oct 2026 07:28:00 GMT");
		Put("/data/plain.csv", "id\n7\n", Nil, Nil);
		Put("/data/runs.csv.gz", "id,score\n3,1.5\n", "\"g1\"", Nil);
		Put("/data/evals.jsonl", "{\"id\": 1}\n{\"id\": 2}\n", "\"j1\"", Nil);

		if(<>StartServer()) {
			"FAIL: query over HTTP (the test server did not start)"->PrintLine();
			Runtime->Exit(1);
		};
		base := "http://127.0.0.1:{$@port}";

		catalog := Catalog->New();
		rs := catalog->Query("select id, score from '{$base}/data/runs.csv' order by id");
		Check("a URL in FROM", rs <> Nil & rs->Size() = 2 & rs->Get(1)->Get("score")->As(FloatRef)->Get() = 0.75);
		if(rs = Nil) {
			catalog->GetError()->PrintLine();
		};

		reads := catalog->GetFileReads();
		full := @full;
		rs := catalog->Query("select count(*) from '{$base}/data/runs.csv'");
		Check("an unchanged URL is revalidated, not downloaded", @not_modified = 1 & @full = full);
		Check("and not read again", catalog->GetFileReads() = reads & rs <> Nil & rs->Get(0)->Get(1)->As(IntRef)->Get() = 2);

		Put("/data/runs.csv", "id,score\n1,0.5\n2,0.75\n3,0.9\n", "\"v2\"", Nil);
		rs := catalog->Query("select count(*) from '{$base}/data/runs.csv'");
		Check("a changed URL is downloaded and read again", catalog->GetFileReads() = reads + 1 & rs <> Nil & rs->Get(0)->Get(1)->As(IntRef)->Get() = 3);

		catalog->Query("select id from '{$base}/data/dated.csv'");
		not_modified := @not_modified;
		catalog->Query("select id from '{$base}/data/dated.csv'");
		Check("Last-Modified revalidates too", @not_modified = not_modified + 1);

		full := @full;
		plain_reads := catalog->GetFileReads();
		catalog->Query("select id from '{$base}/data/plain.csv'");
		catalog->Query("select id from '{$base}/data/plain.csv'");
		Check("without validators each query downloads", @full = full + 2);
		Check("but unchanged content is not read again", catalog->GetFileReads() = plain_reads + 1);

		rs := catalog->Query("select score from '{$base}/data/runs.csv.gz?token=abc'");
		Check("'.gz' and a query string in a URL", rs <> Nil & rs->Size() = 1 & rs->Get(0)->Get("score")->As(FloatRef)->Get() = 1.5);

		direct := CsvSource->New("{$base}/data/runs.csv");
		table := direct->Read(Nil);
		Check("a source given a URL", table <> Nil & table->GetName()->Equals("runs") & table->Size() = 3);
		lines := JsonLinesSource->New("{$base}/data/evals.jsonl")->Read();
		Check("JSON Lines by URL", lines <> Nil & lines->Size() = 2);

		missing := CsvSource->New("{$base}/data/none.csv");
		Check("an error status names it", missing->Read(Nil) = Nil & missing->GetError()->Has("404"));
		Check("an error status in SQL", catalog->Query("select * from '{$base}/data/none.csv'") = Nil & catalog->GetError()->Has("404"));
		Check("a URL cannot be a pattern", catalog->Query("select * from '{$base}/data/*.csv'") = Nil & catalog->GetError()->Has("pattern"));

		# threads sharing one catalog: plain.csv has no validator, so every query downloads it
		# (a new copy each time), and runs.csv answers 304; each round changes plain.csv, which
		# must then be read once whichever thread downloads it first
		shared := Catalog->New();
		threads := 4;
		wrong := 0;
		first : String := Nil;
		shared_reads := 0;
		each(round : 8) {
			rows := round + 2;
			body := "id\n";
			each(i : rows) {
				body += "{$(i * 10 + round)}\n";
			};
			Put("/data/plain.csv", body, Nil, Nil);
			sqls := String->New[6];
			expected := String->New[6];
			each(q : sqls) {
				if(q % 2 = 0) {
					sqls[q] := "select count(*) as n, sum(id) as s from '{$base}/data/plain.csv'";
					total := 0;
					each(j : rows) {
						total += j * 10 + round;
					};
					expected[q] := "n,s\n{$rows},{$total}\n";
				}
				else {
					sqls[q] := "select id, score from '{$base}/data/runs.csv' order by id";
					expected[q] := "id,score\n1,0.5\n2,0.75\n3,0.9\n";
				};
			};

			before := shared->GetFileReads();
			barrier := System.Concurrency.Barrier->New(threads);
			readers := NetReader->New[threads];
			each(t : threads) {
				readers[t] := NetReader->New(shared, sqls, expected, barrier);
			};
			each(t : threads) {
				readers[t]->Execute(Nil);
			};
			each(t : threads) {
				readers[t]->Join();
			};
			each(t : threads) {
				wrong += readers[t]->GetWrong();
				if(first = Nil & readers[t]->GetFirst() <> Nil) {
					first := "round {$round}: {$(readers[t]->GetFirst())}";
				};
			};

			# plain.csv once per round; runs.csv once, in the first round
			reads := shared->GetFileReads() - before;
			if(reads <> (round = 0 ? 2 : 1)) {
				shared_reads += 1;
				if(first = Nil) {
					first := "round {$round}: the shared catalog read {$reads} files";
				};
			};
		};
		Check("threads sharing a catalog read URLs right", wrong = 0 & shared_reads = 0);
		if(first <> Nil) {
			"    {$first}"->PrintLine();
		};

		WebServer->Stop();
		System.IO.Filesystem.Directory->Delete(cache_root);
		if(@failures = 0) {
			"PASS: query over HTTP"->PrintLine();
		}
		else {
			"FAIL: query over HTTP ({$@failures} checks)"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
