#~
A Thread started again on the same object is joined, and its fault reported,
whatever a Join of the earlier run was doing at the time; and a run that can no
longer be joined leaves nothing behind when it ends.

A Thread object holds the handle of the thread it started. Join read the
handle, waited, and cleared the slot afterwards (the interpreter's Join on
Windows) or cleared it with a separate store (everywhere else), with nothing
between it and a second Execute on the same object, which overwrites the slot:

- "parked Join": worker A runs; another thread calls Join and waits for A; the
  object is started again (worker B); A ends. The waiting Join, done with A,
  cleared the slot that by then held B's handle, so the next Join saw an empty
  slot and returned at once: B was never waited for and its fault was lost.
  (Windows, Join interpreted: the default for a Join called a few times, and
  --jit=off.)
- "restart, then the old run faults": worker A runs; the object is started
  again (B), so A can never be joined; A then faults. The Join is B's and must
  report B's outcome, not A's.

The workers wait on flags the main thread sets, so the order of events is the
one described and not a matter of timing; the sleeps only give a thread time to
reach the wait it is about to make. run_vm_flag_tests.py runs this program
with the registry's exit report on and checks that nothing is left in it.

ARM64 and macOS: this test and thread_fault_join_own.obs are the ones to run
(default, OBJECK_JIT_THRESHOLD=1 and --jit=off) for the thread-fault registry.
~#
use System.Concurrency;

class RestartError from Error {
	New(message : String) {
		Parent(message);
	}
}

# what a run does is fixed when it starts, so the object can be set up for the
# next run while this one is still going
class Gated from Thread {
	@gates : Bool[];
	@faults : Bool[];
	@entered : Int;
	@returned : Int;
	@runs : Int;

	New() {
		Parent("gated");
		@gates := Bool->New[8];
		@faults := Bool->New[8];
		@entered := 0;
		@returned := 0;
		@runs := 0;
	}

	# the next Execute's run: waits for Open(run), then faults or returns
	method : public : Next(faults : Bool) ~ Int {
		run := @runs;
		@faults[run] := faults;
		@gates[run] := false;
		@runs += 1;
		return run;
	}

	method : public : Open(run : Int) ~ Nil {
		@gates[run] := true;
	}

	method : public : Entered() ~ Int {
		return @entered;
	}

	# runs that came to their end without a fault
	method : public : Returned() ~ Int {
		return @returned;
	}

	method : public : Run(param : System.Base) ~ Nil {
		run := param->As(IntRef)->Get();
		@entered += 1;
		while(<>@gates[run]) {
			Thread->Sleep(1);
		};
		if(@faults[run]) {
			Runtime->Raise(RestartError->New("run {$run} faulted!"));
		};
		@returned += 1;
	}
}

# joins the thread it is given and keeps what the Join reported
class Joiner from Thread {
	@target : Gated;
	@text : String;
	@done : Bool;

	New(target : Gated) {
		Parent("joiner");
		@target := target;
		@text := "";
		@done := false;
	}

	method : public : Run(param : System.Base) ~ Nil {
		@target->Join();
		@text := Runtime->GetProperty("runtime.thread.join.fault");
		@done := true;
	}

	method : public : Done() ~ Bool {
		return @done;
	}

	method : public : Text() ~ String {
		return @text;
	}
}

class ThreadRestartJoin {
	function : WaitEntered(t : Gated, count : Int) ~ Nil {
		for(i := 0; i < 20000 & t->Entered() < count; i += 1;) {
			Thread->Sleep(1);
		};
	}

	# worker B is started while another thread's Join waits for worker A
	function : ParkedJoin(a_faults : Bool, b_faults : Bool) ~ Int {
		wrong := 0;
		t := Gated->New();
		a := t->Next(a_faults);
		t->Execute(IntRef->New(a));
		WaitEntered(t, 1);

		j := Joiner->New(t);
		j->Execute(Nil);
		# the Join is waiting for A by now
		Thread->Sleep(30);

		b := t->Next(b_faults);
		t->Execute(IntRef->New(b));
		WaitEntered(t, 2);

		t->Open(a);
		j->Join();
		if(<>j->Done()) {
			wrong += 1;
		};
		# the parked Join took A's handle: it reports A's run
		if(a_faults <> (j->Text()->Find("run {$a} faulted!") >= 0)) {
			wrong += 1;
		};

		# B is still running: a Join now has to wait for it, and report it
		Thread->Sleep(5);
		t->Open(b);
		t->Join();
		text := Runtime->GetProperty("runtime.thread.join.fault");
		if(b_faults) {
			if(text->Find("run {$b} faulted!") < 0) {
				wrong += 1;
			};
		}
		else if(text->Size() > 0) {
			wrong += 1;
		};
		# and it did wait: every run that does not fault has returned
		returned := 0;
		if(<>a_faults) {
			returned += 1;
		};
		if(<>b_faults) {
			returned += 1;
		};
		if(t->Entered() <> 2 | t->Returned() <> returned) {
			wrong += 1;
		};

		return wrong;
	}

	# worker A outlives the restart that makes it unjoinable, then faults
	function : RestartThenOldFaults(b_faults : Bool) ~ Int {
		wrong := 0;
		t := Gated->New();
		a := t->Next(true);
		t->Execute(IntRef->New(a));
		WaitEntered(t, 1);

		b := t->Next(b_faults);
		t->Execute(IntRef->New(b));
		WaitEntered(t, 2);

		# A faults now, with nothing left that could join it
		before := Runtime->GetProperty("runtime.threads.faulted")->ToInt();
		t->Open(a);
		for(i := 0; i < 20000 & Runtime->GetProperty("runtime.threads.faulted")->ToInt() = before; i += 1;) {
			Thread->Sleep(1);
		};

		t->Open(b);
		t->Join();
		text := Runtime->GetProperty("runtime.thread.join.fault");
		if(b_faults) {
			if(text->Find("run {$b} faulted!") < 0) {
				wrong += 1;
			};
		}
		else if(text->Size() > 0) {
			wrong += 1;
		};

		return wrong;
	}

	function : Main(args : String[]) ~ Nil {
		rounds := 12;
		if(args->Size() > 0) {
			rounds := args[0]->ToInt();
		};
		failures := 0;
		Runtime->SetProperty("runtime.threads.isolation", "isolate");
		active := Runtime->GetProperty("runtime.threads.active")->ToInt();

		wrong := 0;
		for(i := 0; i < rounds; i += 1;) {
			wrong += ParkedJoin(i % 2 = 0, i % 4 < 2);
		};
		if(wrong = 0) {
			"PASS: a Thread restarted while a Join waited for its earlier run is joined, and both runs reported"->PrintLine();
		}
		else {
			"FAIL: {$wrong} wrong outcome(s) over {$rounds} restarts under a waiting Join"->PrintLine();
			failures += 1;
		};

		wrong := 0;
		for(i := 0; i < rounds; i += 1;) {
			wrong += RestartThenOldFaults(i % 2 = 0);
		};
		if(wrong = 0) {
			"PASS: a run that faults after its Thread was restarted does not reach the new run's Join"->PrintLine();
		}
		else {
			"FAIL: {$wrong} wrong outcome(s) over {$rounds} restarts whose earlier run then faulted"->PrintLine();
			failures += 1;
		};

		for(i := 0; i < 20000 & Runtime->GetProperty("runtime.threads.active")->ToInt() > active; i += 1;) {
			Thread->Sleep(1);
		};
		if(Runtime->GetProperty("runtime.threads.active")->ToInt() <> active) {
			"FAIL: a mutator slot leaked"->PrintLine();
			failures += 1;
		};

		if(failures > 0) {
			"{$failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
		"thread_restart_join: all checks passed"->PrintLine();
	}
}
