#~
# Network Buffer Read Test
# Tests that TCP socket ReadBuffer correctly handles partial reads
# by verifying large payloads over a local loopback connection.
~#

use System.Concurrency, System.IO.Net;

class ServerThread from Thread {
	@port : Int;
	@listening : Bool;

	New(port : Int) {
		Parent("server");
		@port := port;
	}

	# the port the server has, which for a port of 0 the system chose
	method : public : GetPort() ~ Int { return @port; }
	method : public : IsListening() ~ Bool { return @listening; }

	method : public : Run(param : Base) ~ Nil {
		server := TCPSocketServer->New(@port);
		if(server->Listen(5)) {
			@port := server->GetPort();
			@listening := true;
			done := false;
			while(<>done) {
				client := server->Accept();
				if(client <> Nil & client->IsOpen()) {
					# Read 4-byte header to get desired size
					header := Byte->New[4];
					client->ReadBuffer(0, 4, header);
					size := (header[0]->As(Int) << 24) or
							(header[1]->As(Int) << 16) or
							(header[2]->As(Int) << 8) or
							header[3]->As(Int);

					if(size = 0) {
						client->Close();
						done := true;
					}
					else {
						# Generate pattern data and send
						buffer := Byte->New[size];
						each(i : size) {
							buffer[i] := (i % 251)->As(Byte);
						};
						client->WriteBuffer(0, size, buffer);
						# Writing and closing immediately is what #669 discards on
						# Windows loopback; let the client read and hang up first.
						client->CloseGracefully();
					};
				};
			};
			server->Close();
		};
	}
}

class NetBufferTest {
	function : Main(args : String[]) ~ Nil {
		"Testing network buffer reads..."->PrintLine();

		passed := true;

		# the server takes a port the system chooses (port 0), read back once it
		# listens, so two runs on one machine cannot collide as they did on the
		# fixed 19876 (which websocket_test listened on too)
		server_thread := ServerThread->New(0);
		server_thread->Execute(Nil);
		waited := 0;
		while(<>server_thread->IsListening() & waited < 10000) {
			Thread->Sleep(25);
			waited += 25;
		};
		port := server_thread->GetPort();
		if(<>server_thread->IsListening()) {
			"FAIL: the server never listened"->PrintLine();
			Runtime->Exit(1);
		};

		# Test: send and receive payloads of various sizes over TCP
		test_sizes := [1024, 4096, 8192, 16384, 32768];
		# Locals are hoisted: declaring them inside the nested blocks below
		# compiles and then segfaults.
		client : TCPSocket;
		header : Byte[];
		buffer : Byte[];
		read : Int;
		attempt : Int;
		expected : Byte;

		each(t : test_sizes) {
			size := test_sizes[t];

			# On Windows loopback the server's teardown can discard a response the
			# kernel had already delivered, so the read comes back with nothing at
			# all -- see #669. That is a platform race, not a defect in ReadBuffer,
			# so a transfer that returns nothing is retried. A transfer that
			# ARRIVES and is wrong, short or corrupt, still fails the test.
			read := -1;
			attempt := 0;

			while(attempt < 8 & read <> size) {
				client := TCPSocket->New("127.0.0.1", port);
				if(client->IsOpen()) {
					# Send the desired size as a 4-byte header
					header := Byte->New[4];
					header[0] := (size >> 24)->As(Byte);
					header[1] := (size >> 16)->As(Byte);
					header[2] := (size >> 8)->As(Byte);
					header[3] := size->As(Byte);
					client->WriteBuffer(0, 4, header);

					# Read the response
					buffer := Byte->New[size];
					read := client->ReadBuffer(0, size, buffer);
					client->Close();
				};

				attempt += 1;
				if(read <> size) {
					Thread->Sleep(25);
				};
			};

			if(read <> size) {
				"  FAIL: size={$size}, read={$read}"->PrintLine();
				passed := false;
			}
			else {
				# Verify pattern: each byte should be (index % 251)
				each(i : size) {
					expected := (i % 251)->As(Byte);
					if(buffer[i] <> expected) {
						"  FAIL: size={$size}, corrupt at byte {$i}"->PrintLine();
						passed := false;
						break;
					};
				};
			};
		};

		# Signal server to stop
		stop := TCPSocket->New("127.0.0.1", port);
		if(stop->IsOpen()) {
			header := Byte->New[4];
			stop->WriteBuffer(0, 4, header);
			stop->Close();
		};

		server_thread->Join();

		if(passed) {
			"...
PASS"->PrintLine();
		}
		else {
			"...
FAIL"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
