#~
Fixture for check_map_literal_lowering.py. Each function 'ValueN' returns a map
literal; 'HandN' builds the same map by hand with New and Insert. The check
compiles this file with -asm and requires the two listings of every pair to be
the same instruction for instruction.
~#
use Collection;

class MapLiteralLowering {
	# constants, boxed as Insert boxes them
	function : Value1() ~ Map<IntRef, String> {
		return {200: "OK", 404: "Not Found", 500: "Server Error"};
	}

	function : Hand1() ~ Map<IntRef, String> {
		status := Map->New()<IntRef, String>;
		status->Insert(200, "OK");
		status->Insert(404, "Not Found");
		status->Insert(500, "Server Error");
		return status;
	}

	# a Hash, with keys and values that are expressions
	function : Value2(name : String, n : Int) ~ Hash<String, FloatRef> {
		return {name: n->As(Float), name->ToUpper(): n->As(Float) / 2.0, "fixed": 1.5};
	}

	function : Hand2(name : String, n : Int) ~ Hash<String, FloatRef> {
		scaled := Hash->New()<String, FloatRef>;
		scaled->Insert(name, n->As(Float));
		scaled->Insert(name->ToUpper(), n->As(Float) / 2.0);
		scaled->Insert("fixed", 1.5);
		return scaled;
	}

	# no type arguments, and the empty literal
	function : Value3(a : Int) ~ IntMap {
		return {1: a, 2: a * 2};
	}

	function : Hand3(a : Int) ~ IntMap {
		ints := IntMap->New();
		ints->Insert(1, a);
		ints->Insert(2, a * 2);
		return ints;
	}

	function : Value4() ~ Map<String, String> {
		return {};
	}

	function : Hand4() ~ Map<String, String> {
		empty := Map->New()<String, String>;
		return empty;
	}

	function : Main(args : String[]) ~ Nil {
		ok := Value1()->Find(404)->Equals(Hand1()->Find(404)) & Value1()->Size() = Hand1()->Size() &
			Value2("k", 9)->Find("K")->Get() = Hand2("k", 9)->Find("K")->Get() & Value2("k", 9)->Find("K")->Get() = 4.5 &
			Value3(7)->Find(2) = Hand3(7)->Find(2) & Value3(7)->Find(2) = 14 & Value4()->Size() = 0 & Hand4()->Size() = 0;
		if(ok) {
			"PASS: map literal lowering"->PrintLine();
		}
		else {
			"FAIL: map literal lowering"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
