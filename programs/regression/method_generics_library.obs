#~
Method-level generics in libraries (#1242, phase 2; docs/METHOD_GENERICS_DESIGN.md).

A library's .obl now records where a method's own type parameters stand in its
signature, so a call into a library infers them as a call into the program does.
Vector, List and CompareList take Map<R>((H) ~ R): the result's element type is
the function's result, so mapping Strings to their lengths gives a Vector<IntRef>
with no cast. R is inferred from a typed lambda's declared return, from a
function value's type, and from an inferred lambda's body.

An inferred lambda for R must return an object: a primitive is not boxed into
the bound, as it is not in an assignment to a Base.
check_lib_generic_methods.py covers a library of the program's own.
~#
use Collection;

class MethodGenericsLibrary {
	@failures : Int;

	New() {
		@failures := 0;
	}

	method : Check(what : String, ok : Bool) ~ Nil {
		if(ok) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	function : Length(s : String) ~ IntRef {
		return IntRef->New(s->Size());
	}

	method : Run() ~ Nil {
		words := Vector->New()<String>;
		words->AddBack("map");
		words->AddBack("reduce");
		words->AddBack("filter");

		# a typed lambda: R from its declared return
		lengths := words->Map(\(String) ~ IntRef : (s) => IntRef->New(s->Size()));
		Check("Vector<String> to Vector<IntRef>", lengths->Get(1)->Get() = 6);

		# an inferred lambda: R from its body
		upper := words->Map(\(s) => s->ToUpper());
		Check("an inferred lambda keeps String", upper->Get(2)->Equals("FILTER"));
		boxed := words->Map(\(s) => IntRef->New(s->Size()));
		Check("an inferred lambda to IntRef", boxed->Get(0)->Get() = 3);

		# a function value
		f := Length(String) ~ IntRef;
		Check("a function value's type", words->Map(f)->Get(2)->Get() = 6);

		# chained: the next call sees Vector<IntRef>
		Check("chained on the mapped type", words->Map(\(String) ~ IntRef : (s) => IntRef->New(s->Size()))->Get(1)->Get() = 6);

		# the same element type, as before
		same := words->Map(\(s) => s);
		Check("the same element type", same->Get(0)->Equals("map"));

		# List and CompareList
		numbers := List->New()<IntRef>;
		numbers->AddBack(IntRef->New(7));
		texts := numbers->Map(\(IntRef) ~ String : (n) => n->ToString());
		texts->Rewind();
		Check("List<IntRef> to List<String>", texts->Get()->Equals("7"));

		sorted := CompareList->New()<IntRef>;
		sorted->AddBack(IntRef->New(4));
		names := sorted->Map(\(n) => n->ToString());
		names->Rewind();
		Check("CompareList<IntRef> to CompareList<String>", names->Get()->Equals("4"));

		# often enough for the JIT
		total := 0;
		for(i := 0; i < 2000; i += 1;) {
			total += words->Map(\(s) => IntRef->New(s->Size()))->Get(i % 3)->Get();
		};
		Check("in a loop ({$total})", total = 9999);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Main(args : String[]) ~ Nil {
		MethodGenericsLibrary->New()->Run();
	}
}
