# EXTRA_LIBS: ml,gen_collect,csv
#~
System.ML DenseNetwork and AutoencoderDetector against an independent numpy
reference.

The reference (ml_outlier_ref/outlier_ref.py, DenseRef) is written from the
textbook forward/backward equations with numpy matrix products and PyTorch's Adam.
It draws the Glorot-uniform weights and the epoch shuffles from the same Lehmer
generator, so a whole training run replays step for step and the trained weights,
the loss and the predictions must agree to 1e-9:
  network A: 3-5-2-3, ReLU hidden, linear output, batches of 7 over 40 rows (the
    last batch short), lr 0.01, 5 epochs;
  network B: 3-4-2, tanh hidden, sigmoid output, batches of 16, lr 0.05, 8 epochs;
  the autoencoder detector: 126 rows x 4 (6 uniform outliers), hidden 3-2-3,
    15 epochs, seed 42 -- per-row reconstruction errors and the 95th-percentile
    threshold.
Data is built by both sides from System.ML.Random with arithmetic only.

Also: detection of injected outliers, the percentile sweep (99.5 / 97.5 / 95),
SetSensitivity equal to a fresh fit, determinism, default hidden sizes, a constant
feature, and refusals.
~#
use System.ML;

class MlOutlierAutoencoder {
	function : Main(args : String[]) ~ Nil {
		ok := true;
		ok := NetworkA() & ok;
		ok := NetworkB() & ok;
		ok := Detector() & ok;
		ok := Behaviour() & ok;

		if(ok) {
			"PASS: ml_outlier_autoencoder"->PrintLine();
		}
		else {
			"FAIL: ml_outlier_autoencoder"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : NetworkA() ~ Bool {
		X := MakeData(41, 40, 0, 3, 8.0);
		net := DenseNetwork->New([3, 5, 2, 3], DenseNetwork->Activation->RELU, DenseNetwork->Activation->LINEAR, 7);
		net->SetLearningRate(0.01);
		net->SetBatchSize(7);
		loss := net->Fit(X, X, 5);
		passed := Report("network A: loss {$loss} matches the reference", Near(loss, NetALoss(), 1.0e-9));
		passed := Report("network A: layer 0 weights", Close(Flat(net->GetWeights(0)), NetAWeights0(), 1.0e-9)) & passed;
		passed := Report("network A: layer 0 biases", Close(Flat(net->GetBiases(0)), NetABiases0(), 1.0e-9)) & passed;
		passed := Report("network A: layer 1 weights", Close(Flat(net->GetWeights(1)), NetAWeights1(), 1.0e-9)) & passed;
		passed := Report("network A: layer 1 biases", Close(Flat(net->GetBiases(1)), NetABiases1(), 1.0e-9)) & passed;
		passed := Report("network A: layer 2 weights", Close(Flat(net->GetWeights(2)), NetAWeights2(), 1.0e-9)) & passed;
		passed := Report("network A: layer 2 biases", Close(Flat(net->GetBiases(2)), NetABiases2(), 1.0e-9)) & passed;
		passed := Report("network A: predictions", Close(Flat(net->Predict(X)), NetAPredict(), 1.0e-9)) & passed;
		mse := net->Loss(X, X);
		passed := Report("network A: Loss is the mean squared error of Predict", mse > 0.0 & mse < 10.0) & passed;
		return passed;
	}

	function : NetworkB() ~ Bool {
		X := MakeData(42, 30, 0, 3, 8.0);
		Y := Float->New[30, 2];
		each(i : 30) {
			each(j : 2) {
				Y[i, j] := (X[i, j] + 4.0) / 8.0;
			};
		};

		net := DenseNetwork->New([3, 4, 2], DenseNetwork->Activation->TANH, DenseNetwork->Activation->SIGMOID, 9);
		net->SetLearningRate(0.05);
		net->SetBatchSize(16);
		loss := net->Fit(X, Y, 8);
		passed := Report("network B: loss {$loss} matches the reference", Near(loss, NetBLoss(), 1.0e-9));
		passed := Report("network B: layer 0 weights", Close(Flat(net->GetWeights(0)), NetBWeights0(), 1.0e-9)) & passed;
		passed := Report("network B: layer 0 biases", Close(Flat(net->GetBiases(0)), NetBBiases0(), 1.0e-9)) & passed;
		passed := Report("network B: layer 1 weights", Close(Flat(net->GetWeights(1)), NetBWeights1(), 1.0e-9)) & passed;
		passed := Report("network B: layer 1 biases", Close(Flat(net->GetBiases(1)), NetBBiases1(), 1.0e-9)) & passed;
		passed := Report("network B: predictions", Close(Flat(net->Predict(X)), NetBPredict(), 1.0e-9)) & passed;

		bad := DenseNetwork->New([3, 0, 2], DenseNetwork->Activation->RELU, DenseNetwork->Activation->LINEAR, 1);
		passed := Report("a zero-unit layer is refused", bad->Fit(X, Y, 1) = -1.0 & bad->GetError()->Size() > 0) & passed;
		passed := Report("a shape mismatch is refused", net->Fit(X, X, 1) = -1.0 & net->GetError()->Has("columns")) & passed;
		return passed;
	}

	function : Detector() ~ Bool {
		X := MakeData(61, 120, 6, 4, 8.0);
		ae := AutoencoderDetector->New([3, 2, 3], 95.0, 15, 42);
		passed := Report("the detector fits", ae->Fit(X));
		if(<>ae->IsFitted()) {
			return false;
		};

		loss := ae->GetTrainingLoss();
		passed := Report("training loss {$loss} matches the reference", Near(loss, AeLoss(), 1.0e-9)) & passed;
		passed := Report("per-row reconstruction errors match the reference",
			Close(ae->GetTrainingScores(), AeErrors(), 1.0e-9)) & passed;
		t := ae->GetThreshold();
		passed := Report("the 95th-percentile threshold matches ({$t})", Near(t, AeThreshold95(), 1.0e-9)) & passed;
		scores := ae->Score(X);
		passed := Report("Score on the training rows equals the training errors", Close(scores, ae->GetTrainingScores(), 1.0e-12)) & passed;

		fp := Fingerprint(ae->GetTrainingScores());
		"  fingerprint: {$fp}"->PrintLine();
		return passed;
	}

	function : Behaviour() ~ Bool {
		X := MakeData(51, 400, 20, 6, 8.0);
		y := Labels(400, 20);

		detector : OutlierDetector := AutoencoderDetector->New();
		flags := detector->FitPredict(X);
		passed := Report("defaults fit", flags <> Nil);
		if(flags = Nil) {
			"  {$detector->GetError()}"->PrintLine();
			return false;
		};

		net := detector->As(AutoencoderDetector)->GetNetwork();
		sizes := net->GetLayerSizes();
		passed := Report("default layers are 6-3-2-3-6", sizes->Size() = 5 & sizes[1] = 3 & sizes[2] = 2 & sizes[3] = 3 & sizes[4] = 6) & passed;

		auc := Metrics->AucRoc(detector->GetTrainingScores(), y);
		passed := Report("reconstruction error ranks the outliers (AUC {$auc} > 0.95)", auc > 0.95) & passed;
		n := Count(flags);
		passed := Report("percentile 95 flags 21 of 420 training rows ({$n})", n = 21) & passed;

		settings := [99.5, 97.5, 95.0];
		counts := Int->New[3];
		each(s : settings) {
			detector->SetSensitivity(settings[s]);
			counts[s] := Count(detector->Predict(X));
		};
		passed := Report("99.5 < 97.5 < 95.0 in flags ({$counts[0]}, {$counts[1]}, {$counts[2]})",
			counts[0] < counts[1] & counts[1] < counts[2]) & passed;
		passed := Report("the percentile keeps the network", detector->IsFitted()) & passed;

		fresh := AutoencoderDetector->New(Nil, 97.5, 50, 42);
		fresh->Fit(X);
		detector->SetSensitivity(97.5);
		passed := Report("SetSensitivity equals a fresh fit", fresh->GetThreshold() = detector->GetThreshold()) & passed;
		passed := Report("same seed, identical errors", Same(fresh->GetTrainingScores(), detector->GetTrainingScores())) & passed;
		reseeded := AutoencoderDetector->New(Nil, 97.5, 50, 43);
		reseeded->Fit(X);
		passed := Report("another seed, different errors", <>Same(reseeded->GetTrainingScores(), detector->GetTrainingScores())) & passed;
		passed := Report("percentile 0 is rejected", <>detector->SetSensitivity(0.0)) & passed;

		recon := detector->As(AutoencoderDetector)->Reconstruct(X);
		dims := recon->Size();
		passed := Report("Reconstruct returns rows x features", dims[0] = 420 & dims[1] = 6) & passed;

		# a constant feature: fits, and a new value off the constant reconstructs worse
		C := MakeData(52, 200, 0, 3, 1.0);
		each(i : 200) {
			C[i, 2] := 5.0;
		};
		constant := AutoencoderDetector->New([2, 1, 2], 95.0, 20, 1);
		passed := Report("a constant feature fits", constant->Fit(C)) & passed;
		probe := [[0.0, 0.0, 5.0], [0.0, 0.0, 9.0]];
		ps := constant->Score(probe);
		passed := Report("a value off the constant scores higher", ps <> Nil & ps[1] > ps[0]) & passed;

		bad := MakeData(5, 30, 0, 3, 1.0);
		bad[7, 2] := Float->NaN();
		r := AutoencoderDetector->New();
		passed := Report("NaN is refused", <>r->Fit(bad) & r->GetError()->Has("row 7, column 2")) & passed;
		passed := Report("a zero hidden size is refused", <>AutoencoderDetector->New([2, 0], 95.0, 5, 1)->Fit(C)) & passed;
		passed := Report("unfitted Score is Nil", AutoencoderDetector->New()->Score(X) = Nil) & passed;
		passed := Report("a column mismatch is refused", detector->Score(C) = Nil) & passed;
		return passed;
	}

	function : Flat(m : Float[,]) ~ Float[] {
		if(m = Nil) {
			return Nil;
		};
		dims := m->Size();
		rows := dims[0];
		cols := dims[1];
		out := Float->New[rows * cols];
		each(i : rows) {
			each(j : cols) {
				out[i * cols + j] := m[i, j];
			};
		};
		return out;
	}

	function : Same(a : Float[], b : Float[]) ~ Bool {
		if(a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(a[i] <> b[i]) {
				return false;
			};
		};
		return true;
	}

	function : Count(flags : Bool[]) ~ Int {
		n := 0;
		each(i : flags) {
			if(flags[i]) {
				n += 1;
			};
		};
		return n;
	}

	function : Labels(n_in : Int, n_out : Int) ~ Bool[] {
		y := Bool->New[n_in + n_out];
		for(i := n_in; i < n_in + n_out; i += 1;) {
			y[i] := true;
		};
		return y;
	}

	function : Gauss(rng : System.ML.Random) ~ Float {
		acc := 0.0;
		each(k : 12) {
			acc += rng->NextReal();
		};
		return acc - 6.0;
	}

	function : MakeData(seed : Int, n_in : Int, n_out : Int, p : Int, spread : Float) ~ Float[,] {
		rng := System.ML.Random->New(seed);
		X := Float->New[n_in + n_out, p];
		z := Float->New[p];
		each(i : n_in) {
			each(j : p) {
				z[j] := Gauss(rng);
			};
			each(j : p) {
				v := z[j];
				if(j > 0) {
					v := v + 0.5 * z[j - 1];
				};
				X[i, j] := v;
			};
		};
		for(i := n_in; i < n_in + n_out; i += 1;) {
			each(j : p) {
				X[i, j] := rng->NextReal() * (2.0 * spread) - spread;
			};
		};
		return X;
	}

	function : Near(a : Float, b : Float, tol : Float) ~ Bool {
		scale := b->Abs();
		if(scale < 1.0) {
			scale := 1.0;
		};
		return (a - b)->Abs() <= tol * scale;
	}

	function : Close(a : Float[], b : Float[], tol : Float) ~ Bool {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(<>Near(a[i], b[i], tol)) {
				"  mismatch at {$i}: {$a[i]} vs {$b[i]}"->PrintLine();
				return false;
			};
		};
		return true;
	}

	# printed so runs under different -opt levels and JIT modes can be diffed: the
	# scores to 1e-12, folded into one integer
	function : Fingerprint(v : Float[]) ~ Int {
		total := 0;
		each(i : v) {
			total += (v[i] * 1000000000000.0)->As(Int) * (i % 7 + 1);
		};
		return total;
	}

	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};
		return passed;
	}

	# BEGIN GENERATED FIXTURE
	# by ml_outlier_ref/gen_fixtures.py; do not edit by hand
