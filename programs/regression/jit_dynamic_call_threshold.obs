#~
A call through a function value is compiled by the auto-JIT on the callee's own
call count, whatever else has been called through the same call site.

A dynamic call's instruction names no method: its operands are the words its
arguments take and its return type. The interpreter nevertheless kept JIT state
on the instruction, and two things set it for every function later called
through the site:

- one callee the JIT could not compile marked the site, after which every
  other function called there was compiled on its FIRST call, bypassing the
  auto-JIT threshold (this file);
- compiling any method whose class id and method id happened to equal the
  site's two operands rewrote the site the same way (run_vm_flag_tests.py
  section 36 builds that program: it needs a class with more than a thousand
  methods, since a return type's code is 1000 or more).

Here Apply holds the one call site. It is not compilable itself (it has a ?->
region), so the site is the interpreter's. Refused is called through it until
the JIT has tried and refused it; then Once is called through it once, and
Often twenty-four times. With OBJECK_JIT_REPORT=1 (run_vm_flag_tests.py reads it)
the report must show Often compiled and Once not; this file on its own checks
that every call returns the right value in each JIT mode.
~#
class JitDynamicCallThreshold {
	# the one dynamic call site; the ?-> region keeps Apply itself interpreted
	function : Apply(f : (Int) ~ Int, v : Int) ~ Int {
		h := IntRef->New(v);
		p := h?->Get();
		return f(v) + p - v;
	}

	# a ?-> region: the JIT declines the method
	function : Refused(v : Int) ~ Int {
		h := IntRef->New(v);
		p := h?->Get();
		return p * 2;
	}

	function : Once(v : Int) ~ Int {
		return v * 3;
	}

	function : Often(v : Int) ~ Int {
		return v * 5;
	}

	function : Main(args : String[]) ~ Nil {
		failures := 0;

		refused := JitDynamicCallThreshold->Refused(Int) ~ Int;
		once := JitDynamicCallThreshold->Once(Int) ~ Int;
		often := JitDynamicCallThreshold->Often(Int) ~ Int;

		total := 0;
		for(i := 0; i < 24; i += 1;) {
			total += Apply(refused, i);
		};
		if(total <> 552) {
			"FAIL: Refused through the site: {$total}, expected 552"->PrintLine();
			failures += 1;
		};

		value := Apply(once, 7);
		if(value <> 21) {
			"FAIL: Once through the site: {$value}, expected 21"->PrintLine();
			failures += 1;
		};

		total := 0;
		for(i := 0; i < 24; i += 1;) {
			total += Apply(often, i);
		};
		if(total <> 1380) {
			"FAIL: Often through the site: {$total}, expected 1380"->PrintLine();
			failures += 1;
		};

		# and Refused again, after the others
		value := Apply(refused, 9);
		if(value <> 18) {
			"FAIL: Refused again: {$value}, expected 18"->PrintLine();
			failures += 1;
		};

		if(failures > 0) {
			Runtime->Exit(1);
		};
		"PASS: calls through one dynamic site return the right values"->PrintLine();
	}
}
