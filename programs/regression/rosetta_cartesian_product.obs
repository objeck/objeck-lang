#~
# Rosetta Code: Cartesian product of two or more lists
# https://rosettacode.org/wiki/Cartesian_product_of_two_or_more_lists
#
# The product in row-major order, and the empty cases: a product involving an empty list is empty, while the product of NO lists has exactly one element, the empty tuple. Those two are the task's actual test.
#
# Expected values were computed with an independent oracle, not recalled.
~#


class RosettaCartesianProduct {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaCartesianProduct->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		a := [1, 2];
		b := [3, 4];
		Check("{1,2} x {3,4}", Product2(a, b), "(1,3) (1,4) (2,3) (2,4)");
		Check("{3,4} x {1,2}", Product2(b, a), "(3,1) (3,2) (4,1) (4,2)");

		# an empty operand gives an empty product, either side
		empty := Int->New[0];
		Check("{1,2} x {}", Product2(a, empty), "");
		Check("{} x {1,2}", Product2(empty, a), "");

		# three lists, row-major
		c := [5, 6];
		Check("three lists", Product3(a, b, c),
			"(1,3,5) (1,3,6) (1,4,5) (1,4,6) (2,3,5) (2,3,6) (2,4,5) (2,4,6)");
		CheckInt("2x2x2 has eight tuples", Product3(a, b, c)->Split(" ")->Size(), 8);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Product2(a : Int[], b : Int[]) ~ String {
		out := "";
		each(i : a) {
			each(j : b) {
				x := a[i];
				y := b[j];
				out += "({$x},{$y}) ";
			};
		};
		return out->Trim();
	}

	function : Product3(a : Int[], b : Int[], c : Int[]) ~ String {
		out := "";
		each(i : a) {
			each(j : b) {
				each(k : c) {
					x := a[i];
					y := b[j];
					z := c[k];
					out += "({$x},{$y},{$z}) ";
				};
			};
		};
		return out->Trim();
	}
}
