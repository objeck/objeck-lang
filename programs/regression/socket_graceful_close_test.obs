#~
# TCPSocket->CloseGracefully() must not lose the data it just wrote (#669).
#
# The shape this guards is the one every raw-socket server writes by instinct:
#
#     client->WriteString(response);
#     client->Close();
#
# On Windows over loopback that discards the response outright on a good fraction
# of connections. The reader gets a connection reset and ZERO bytes -- not a short
# read -- because the sender's teardown aborts a connection still carrying data the
# peer has not read, and the RST flushes the receiver's kernel buffer. Measured at
# 28, 30 and 25 responses lost out of 60 before Web.HTTP.Server stopped closing
# first, and reproduced here at 2 failures in 10 runs of thread_accept_exit_test,
# which used to hand-roll exactly that pattern.
#
# It is a platform behaviour and no socket option turns it off: seven candidate
# fixes were measured and none worked. See docs/windows_loopback_sockets.md. The
# only remedy is to stop being the side that closes first, which is what
# CloseGracefully() does -- it drains until the peer hangs up, then closes.
#
# So this test exercises the write-a-response-and-close shape as hard as it can and
# asserts the response always arrives. On Windows it is a real regression guard: the
# same loop with Close() in place of CloseGracefully() fails here. On Linux and over
# real network interfaces the defect does not exist, so it asserts what already held.
#
# The payload is 16KB rather than a short line on purpose. The race needs data
# sitting unread in the receiver's buffer at the moment of teardown, and a bigger
# response leaves more of it there for longer -- core_http_server lost a 16KB body
# 4 runs in 15 while shorter exchanges looked healthy.
~#

use System.Concurrency, System.IO.Net;

#~
Serves one 16KB response per connection and closes the connection itself, which
is the exposed direction. Ends when it is handed a connection that sends "bye".
~#
class ResponderServer from Thread {
	@port : Int;
	@ready : Bool;

	New(port : Int) {
		Parent("responder");
		@port := port;
		@ready := false;
	}

	method : public : IsReady() ~ Bool {
		return @ready;
	}

	method : public : Run(param : System.Base) ~ Nil {
		server := TCPSocketServer->New(@port);
		if(server->Listen(16) = false) {
			return;
		};
		@ready := true;

		running := true;
		while(running) {
			client := server->Accept();
			if(client = Nil) {
				running := false;
			}
			else {
				line := client->ReadLine();
				if(line <> Nil & line->StartsWith("bye")) {
					running := false;
					client->Close();
				}
				else {
					body := Byte->New[16384];
					each(i : body) {
						# A recognisable pattern, so a torn or partial response is
						# distinguishable from a merely short one.
						body[i] := (i % 251)->As(Byte);
					};
					client->WriteBuffer(0, body->Size(), body);

					# The assertion. Close() here loses the response on Windows
					# loopback; CloseGracefully() waits for the peer to read it and
					# hang up, so there is no teardown to race.
					client->CloseGracefully();
				};
			};
		};

		server->Close();
	}
}

class SocketGracefulCloseTest {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		# A per-run port, for the reason thread_accept_exit_test documents: Windows
		# SO_REUSEADDR permits binding a port that already has a LIVE listener, so a
		# leftover server from an earlier run and this one both bind, and the client
		# can be handed the stale one.
		port := 19995;
		if(args->Size() > 0) {
			port := args[0]->ToInt();
		};

		test := SocketGracefulCloseTest->New();
		test->Run(port);
	}

	New() {
		@failures := 0;
	}

	method : CheckTrue(what : String, cond : Bool) ~ Nil {
		if(cond) {
			"  ok: {$what}"->PrintLine();
		}
		else {
			"  FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run(port : Int) ~ Nil {
		server := ResponderServer->New(port);
		server->Execute(Nil);

		waited := 0;
		while(<>server->IsReady() & waited < 40) {
			Thread->Sleep(50);
			waited += 1;
		};
		CheckTrue("responder server listening", server->IsReady());

		if(server->IsReady()) {
			rounds := 30;
			lost := 0;
			short_reads := 0;
			corrupt := 0;

			for(i := 0; i < rounds; i += 1;) {
				sock := TCPSocket->New("127.0.0.1", port);
				if(<>sock->IsOpen()) {
					lost += 1;
				}
				else {
					sock->WriteString("get\r\n");
					sock->Flush();

					buffer := Byte->New[16384];
					read := sock->ReadBuffer(0, buffer->Size(), buffer);

					if(read <= 0) {
						# The #669 signature: a reset with nothing read at all, even
						# though every byte was sent and had arrived.
						lost += 1;
					}
					else if(read <> buffer->Size()) {
						short_reads += 1;
					}
					else if(buffer[0] <> 0 | buffer[250] <> 250 | buffer[251] <> 0 | buffer[16383] <> (16383 % 251)) {
						corrupt += 1;
					};

					# The client closes second on purpose. The server has already
					# closed by now, which is the safe direction.
					sock->Close();
				};
			};

			CheckTrue("all {$rounds} responses arrived (lost {$lost})", lost = 0);
			CheckTrue("no truncated responses (short {$short_reads})", short_reads = 0);
			CheckTrue("no corrupted responses (corrupt {$corrupt})", corrupt = 0);

			# Release the accept loop so the process does not sit on a live thread.
			closer := TCPSocket->New("127.0.0.1", port);
			if(closer->IsOpen()) {
				closer->WriteString("bye\r\n");
				closer->Flush();
				closer->Close();
			};
		};

		Thread->Sleep(200);

		if(@failures > 0) {
			failures := @failures;
			"{$failures} failed"->PrintLine();
			Runtime->Exit(1);
		};

		"PASS: CloseGracefully() delivers every response the server wrote"->PrintLine();
	}
}
