# The exit 139 this test reported on linux-arm64 in nightly run 35027973357 is recorded in docs/PLAN_2026_10_0_HARDENING.md ("Parked findings"): the empty response used to cascade into a Nil dereference below (fixed here), and on linux-arm64 the VM dumped core on that path where x64 and macOS printed the diagnostic and exited 1.
# EXTRA_LIBS: net,net_server
use Collection, System.IO.Filesystem, System.IO.Net, Web.HTTP.Server;
class HttpsPersistenceHandler from HttpsRequestHandler {
	New() { Parent(); }

	method : ProcessGet(request : Request, response : Response) ~ Bool {
		if(request->GetPath()->Equals("/client")) {
			"TLS stage: HttpsClient request reached handler"->ErrorLine();
		};
		# This virtual callback is JIT-compiled even when test auto-JIT is disabled;
		# routing by String->Equals is deliberate (issue #722 reported the ARM64 JIT
		# miscompiling it here) and this is the check.
		if(request->GetPath()->Equals("/empty")) {
			response->SetCode(200);
		}
		else if(request->GetPath()->Equals("/notmodified")) {
			# The body must not be sent: a 304 has none (see http_status_codes).
			response->SetHeader("ETag", "\"v1\"");
			response->SetCodeContent(304, "MUST-NOT-BE-SENT");
		}
		else if(request->GetPath()->Equals("/missing")) {
			response->SetCodeContent(404, "missing-body");
		}
		else {
			response->SetCodeContent(200, "ok");
		};
		return false;
	}

	method : ProcessPost(request : Request, response : Response) ~ Bool {
		response->SetCodeContent(200, "ok");
		return false;
	}
}

class HttpsPersistenceTest {
	@port : static : Int;
	@passed : static : Bool;

	function : Port() ~ Int { return @port; }

	function : Fail(message : String) ~ Nil {
		"  FAIL: {$message}"->PrintLine();
		@passed := false;
	}

	function : ReadResponse(socket : TCPSecureSocket) ~ Pair<String, Map<String, String>> {
		status := socket->ReadLine();
		headers := Map->New()<String, String>;
		if(status = Nil) {
			return Pair->New("", headers)<String, Map<String, String>>;
		};

		line := socket->ReadLine();
		while(line <> Nil & line->Size() > 0) {
			colon := line->Find(':');
			if(colon > 0) {
				name := line->SubString(colon);
				value := line->SubString(colon + 1, line->Size() - colon - 1);
				if(name <> Nil & value <> Nil) {
					name := name->ToLower();
					value := value->Trim();
					headers->Insert(name, value);
				}
				else {
					Fail("malformed TLS response header '{$line}'");
				};
			};
			line := socket->ReadLine();
		};

		length_text := headers->Find("content-length");
		if(length_text <> Nil & length_text->IsNumeric()) {
			remaining := length_text->ToInt();
			temp := Byte->New[256];
			while(remaining > 0) {
				amount := remaining;
				if(amount > temp->Size()) { amount := temp->Size(); };
				read := socket->ReadBuffer(0, amount, temp);
				if(read < 1) {
					Fail("response body ended before Content-Length");
					remaining := 0;
				}
				else {
					remaining -= read;
				};
			};
		};
		return Pair->New(status, headers)<String, Map<String, String>>;
	}

	function : Request(socket : TCPSecureSocket, text : String) ~ Pair<String, Map<String, String>> {
		socket->WriteString(text);
		return ReadResponse(socket);
	}

	function : Expect(response : Pair<String, Map<String, String>>, status : String,
			connection : String, context : String) ~ Nil {
		if(response->GetFirst()->Has(status) = false) {
			Fail("{$context}: status was '{$response->GetFirst()}'");
		};
		headers := response->GetSecond();
		length := headers->Find("content-length");
		if(length = Nil) {
			Fail("{$context}: missing Content-Length");
		};
		actual := headers->Find("connection");
		if(actual = Nil) {
			Fail("{$context}: missing Connection, expected '{$connection}'");
		}
		else if(actual->Equals(connection) = false) {
			Fail("{$context}: Connection was '{$actual}', expected '{$connection}'");
		};
	}

	function : Main(args : String[]) ~ Nil {
		@passed := true;
		# the server takes a port the system chooses (ServeSecure on port 0),
		# read back below once it listens, so two runs on one machine cannot
		# collide as they did on the fixed 18808
		@port := 0;
		cert := "https-persistence-{$Runtime->GetProcessId()}-cert.pem";
		key := "https-persistence-{$Runtime->GetProcessId()}-key.pem";
		File->Delete(cert);
		File->Delete(key);
		# Some Windows OpenSSL distributions have a build-time config path that
		# does not exist on the runner. This command needs no config sections.
		config := Runtime->GetPlatform()->Has("Windows") ? "-config NUL " : "";
		command := "openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 1 {$config}-subj \"/CN=localhost\" -addext \"subjectAltName=DNS:localhost,IP:127.0.0.1\" -keyout {$key} -out {$cert}";
		if(Runtime->Command(command) <> 0) {
			Fail("openssl could not create the localhost TLS fixture -- is openssl on PATH?");
			Runtime->Exit(1);
		};

		server_thread := System.Concurrency.Thread->New() {
			New() { Parent(); }
			method : public : Run(arg : System.Base) ~ Nil {
				WebServer->ServeSecure(HttpsPersistenceHandler->New()->GetClass(),
					HttpsPersistenceTest->Port(), "https-persistence-{$Runtime->GetProcessId()}-cert.pem",
					"https-persistence-{$Runtime->GetProcessId()}-key.pem", "", false);
			}
		};
		server_thread->Execute(Nil);
		waited := 0;
		while(WebServer->GetBoundPort() = 0 & waited < 10000) {
			System.Concurrency.Thread->Sleep(25);
			waited += 25;
		};
		@port := WebServer->GetBoundPort();
		if(@port = 0) {
			Fail("the TLS server never listened");
			Runtime->Exit(1);
		};
		"TLS stage: server listening on port {$@port}"->ErrorLine();

		# Exercise multiple HTTP requests over one TLS session.
		socket := TCPSecureSocket->New("localhost", @port, cert);
		"TLS stage: first connection returned"->ErrorLine();
		socket->SetNoDelay(true);
		socket->SetRecvTimeout(5000);
		socket->SetSendTimeout(5000);
		if(socket->IsOpen() = false) {
			Fail("could not establish trusted TLS connection");
		}
		else {
			empty := Request(socket, "GET /empty HTTP/1.1\r\nHost: localhost\r\n\r\n");
			Expect(empty, "200", "keep-alive", "empty TLS response");
			empty_headers := empty->GetSecond();
			# A truncated or empty response leaves the header absent, and Find
			# then returns Nil. Calling Equals on it ends the process instead of
			# failing the assertion: that is what turned a slow peer into an
			# 'Attempting to dereference a Nil memory instance in native JIT
			# code' abort (exit 139 with a core dump on linux-arm64) in nightly
			# run 35027973357, after the assertions above had already reported
			# the real problem.
			empty_length := empty_headers->Find("content-length");
			if(empty_length = Nil) {
				Fail("empty TLS response carried no Content-Length to frame it");
			}
			else if(empty_length->Equals("0") = false) {
				Fail("empty TLS response was not framed as zero length");
			};

			body := Request(socket, "GET /ok HTTP/1.1\r\nHost: localhost\r\nContent-Length: 4\r\n\r\ndata");
			Expect(body, "200", "keep-alive", "TLS GET with body");
			next := Request(socket, "GET /ok HTTP/1.1\r\nHost: localhost\r\n\r\n");
			Expect(next, "200", "keep-alive", "TLS request after body");
			# A 304 carries no Content-Length and no body; the handler's body would
			# otherwise be read as the next status line.
			not_modified := Request(socket, "GET /notmodified HTTP/1.1\r\nHost: localhost\r\n\r\n");
			if(not_modified->GetFirst()->Equals("HTTP/1.1 304 Not Modified") = false) {
				Fail("TLS 304: status was '{$not_modified->GetFirst()}'");
			};
			not_modified_headers := not_modified->GetSecond();
			if(not_modified_headers->Find("content-length") <> Nil) {
				Fail("TLS 304 carried a Content-Length");
			};
			not_modified_etag := not_modified_headers->Find("etag");
			if(not_modified_etag = Nil) {
				Fail("TLS 304 lost the handler's ETag");
			}
			else if(not_modified_etag->Equals("\"v1\"") = false) {
				Fail("TLS 304 ETag was '{$not_modified_etag}'");
			};
			after_304 := Request(socket, "GET /ok HTTP/1.1\r\nHost: localhost\r\n\r\n");
			Expect(after_304, "200", "keep-alive", "TLS request after 304");

			missing := Request(socket, "GET /missing HTTP/1.1\r\nHost: localhost\r\n\r\n");
			Expect(missing, "404", "keep-alive", "TLS 404 with body");
			missing_length := missing->GetSecond()->Find("content-length");
			if(missing_length = Nil) {
				Fail("TLS 404 carried no Content-Length");
			}
			else if(missing_length->Equals("12") = false) {
				Fail("TLS 404 body was dropped: Content-Length '{$missing_length}'");
			};

			unsupported := Request(socket, "OPTIONS /ok HTTP/1.1\r\nHost: localhost\r\n\r\n");
			Expect(unsupported, "405", "keep-alive", "TLS unsupported method");
			closing := Request(socket, "GET /ok HTTP/1.1\r\nHost: localhost\r\nConnection: close\r\n\r\n");
			Expect(closing, "200", "close", "TLS explicit close");
			socket->Close();
		};
		"TLS stage: persistence sequence complete"->ErrorLine();

		# Exercise HttpsClient itself with explicit trust in the test CA.
		client_url := Web.HTTP.Url->New("https://localhost:{$@port}/client");
		client := Web.HTTP.HttpsClient->New();
		"TLS stage: HttpsClient request starting"->ErrorLine();
		response := client->Get(client_url, "text/plain", cert);
		"TLS stage: HttpsClient request returned"->ErrorLine();
		if(response = Nil) {
			Fail("HttpsClient GET returned Nil through ServeSecure");
		}
		else {
			client_content := response->GetContent();
			if(response->GetCode() <> 200) {
				Fail("HttpsClient GET returned status {$response->GetCode()}");
			}
			else if(client_content = Nil) {
				Fail("HttpsClient GET returned no body through ServeSecure");
			}
			else if(client_content->ToString()->Equals("ok") = false) {
				Fail("HttpsClient GET body was '{$client_content->ToString()}'");
			};
		};

		# HttpsClient on a 304: it must not wait for a body. The server holds the
		# connection (the client asks for keep-alive), so a client that reads until
		# close sits out its whole receive timeout here.
		not_modified_client := Web.HTTP.HttpsClient->New();
		not_modified_timer := System.Time.Timer->New(true);
		not_modified_response := not_modified_client->Get(Web.HTTP.Url->New("https://localhost:{$@port}/notmodified"), "text/plain", cert);
		not_modified_timer->End();
		not_modified_seconds := not_modified_timer->GetElapsedTime();
		if(not_modified_seconds > 5.0) {
			Fail("HttpsClient 304 took {$not_modified_seconds} s -- waiting for a body that never comes?");
		};
		if(not_modified_response = Nil) {
			Fail("HttpsClient 304 returned Nil");
		}
		else if(not_modified_response->GetCode() <> 304) {
			Fail("HttpsClient 304 returned status {$not_modified_response->GetCode()}");
		};

		missing_client := Web.HTTP.HttpsClient->New();
		missing_response := missing_client->Get(Web.HTTP.Url->New("https://localhost:{$@port}/missing"), "text/plain", cert);
		if(missing_response = Nil) {
			Fail("HttpsClient 404 returned Nil");
		}
		else {
			missing_content := missing_response->GetContent();
			if(missing_response->GetCode() <> 404) {
				Fail("HttpsClient 404 returned status {$missing_response->GetCode()}");
			}
			else if(missing_content = Nil) {
				Fail("HttpsClient 404 returned no body");
			}
			else if(missing_content->ToString()->Equals("missing-body") = false) {
				Fail("HttpsClient 404 body was '{$missing_content->ToString()}'");
			};
		};

		File->Delete(cert);
		File->Delete(key);
		if(@passed) {
			"PASS: HTTPS persistence invariants"->PrintLine();
			# ServeSecure is blocked in accept on POSIX, and closing that descriptor
			# from this thread is not guaranteed to wake it. End the isolated test
			# process after all assertions and fixture cleanup.
			Runtime->Exit(0);
		}
		else {
			Runtime->Exit(1);
		};
	}
}
