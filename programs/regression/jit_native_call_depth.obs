# Recursion deeper than the call stack allows, through compiled-to-compiled
# native calls (the calling convention's phase 3): the fast path checks the
# depth and hands the call to the bridge, which reports the overflow and
# exits. The runner expects the runtime error.
# EXPECT_RUNTIME_ERROR
class NativeCallDepth {
  function : Down(n : Int) ~ Int {
    t := 0;
    for(i := 0; i < 2; i += 1;) { t += i; };
    if(n = 0) { return t; };
    return Down(n - 1) + t;
  }

  function : Main(args : String[]) ~ Nil {
    r := Down(100000);
    "unreachable {$r}"->PrintLine();
  }
}
