#~
JIT: storing a func-ref whose two words have different working-stack shapes.

A capturing lambda built in a compiled method reaches STOR_FUNC_VAR as
LOAD_INT_VAR (the closure memory: a frame slot or a register) under
LOAD_INT_LIT (the packed method id: an immediate). JitAmd64::ProcessStore and
JitArm64::ProcessStore picked the store from the FIRST word's shape and
assumed the second word had the same one: for an immediate first word they
wrote the second word's operand -- the closure slot's frame offset, e.g.
-120 = 0xffffffffffffff88 -- as the closure pointer. The lambda's first call
then read its capture through that address: an access violation, no garbage
collection involved (v2026.9.4, found by the heap verifier's
closure_capture_old_holder_g12.obs under --jit=1).

Local() stores and calls the closure in one method; Store() hands it to an
instance field and Holder:Call() calls it through @f. Both run often enough
to cross the default JIT threshold, so the test fails without flags.
~#
class JitFuncrefStoreMixedWords {
  function : Main(args : String[]) ~ Nil {
    bad := 0;
    for(i := 0; i < 64; i += 1;) {
      if(Local(i) <> i + 1) {
        bad += 1;
      };

      holder := Holder->New();
      Store(holder, Box->New(i * 7 + 1));
      box := holder->Call();
      if(box = Nil) {
        bad += 1;
      }
      else if(box->GetV() <> i * 7 + 1) {
        bad += 1;
      };
    };

    if(bad = 0) {
      "PASS: func-ref stores with mixed word shapes"->PrintLine();
    }
    else {
      "FAIL: func-ref stores with mixed word shapes ({$bad} bad)"->PrintLine();
      Runtime->Exit(1);
    };
  }

  function : Local(n : Int) ~ Int {
    b := n + 1;
    f := \() ~ Int : () => b;
    return f();
  }

  function : Store(holder : Holder, b : Box) ~ Nil {
    f := \() ~ Box : () => b;
    holder->Set(f);
  }
}

class Holder {
  @f : () ~ Box;

  New() {
  }

  method : public : Set(f : () ~ Box) ~ Nil {
    @f := f;
  }

  method : public : Call() ~ Box {
    return @f();
  }
}

class Box {
  @v : Int;
  @pad : Box;

  New(v : Int) {
    @v := v;
  }

  method : public : GetV() ~ Int {
    return @v;
  }
}
