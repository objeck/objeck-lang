#~
Primitive collections in Collection: IntVector, FloatVector, IntMap, IntSet and BitSet.
Covers empty containers, growth, removal, negative and Int64 extreme keys (0 and the
minimum Int are ordinary keys), deletes followed by reinserts in the open-addressed
tables, sorting against a reference, and BitSet word boundaries at 63, 64 and 65.
~#
use Collection;

class CollectPrimitive {
	function : Check(name : String, ok : Bool) ~ Int {
		if(ok) {
			return 0;
		};
		"  FAIL: {$name}"->PrintLine();
		return 1;
	}

	function : Main(args : String[]) ~ Nil {
		failures := 0;
		failures += IntVectors();
		failures += FloatVectors();
		failures += IntMaps();
		failures += IntSets();
		failures += BitSets();

		if(failures > 0) {
			"FAIL: collect_primitive, {$failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};

		"PASS: collect_primitive"->PrintLine();
	}

	function : IntVectors() ~ Int {
		failures := 0;

		v := IntVector->New();
		failures += Check("iv empty", v->IsEmpty() & v->Size() = 0);
		failures += Check("iv empty get", v->Get(0) = 0 & v->RemoveBack() = 0 & v->Remove(0) = 0);
		failures += Check("iv empty first/last", v->First() = 0 & v->Last() = 0);
		failures += Check("iv empty find", v->Find(1) = -1 & <>v->Has(1) & v->Sum() = 0);
		failures += Check("iv empty array", v->ToArray()->Size() = 0 & v->ToString()->Equals("[]"));
		v->Sort();

		for(i := 0; i < 100000; i += 1;) {
			v->AddBack(i);
		};
		failures += Check("iv growth", v->Size() = 100000 & v->Get(99999) = 99999 & v->Get(100000) = 0 & v->Get(-1) = 0);
		failures += Check("iv sum", v->Sum() = 4999950000);
		failures += Check("iv set", v->Set(-5, 10) & v->Get(10) = -5 & <>v->Set(1, 100000));
		failures += Check("iv find", v->Find(-5) = 10 & v->Has(99998) & <>v->Has(100000));
		failures += Check("iv remove", v->Remove(0) = 0 & v->Get(0) = 1 & v->Size() = 99999);
		failures += Check("iv remove back", v->RemoveBack() = 99999 & v->Size() = 99998 & v->Last() = 99998);
		failures += Check("iv first", v->First() = 1);
		v->Clear();
		failures += Check("iv clear", v->IsEmpty());
		v->AddBack(Int->MaxSize());
		v->AddBack(Int->MinSize());
		failures += Check("iv extremes", v->Get(0) = Int->MaxSize() & v->Get(1) = Int->MinSize());

		a := IntVector->New([3, 1, 2]);
		a->Sort();
		failures += Check("iv sort small", a->ToString()->Equals("[1,2,3]"));
		a->Empty();
		failures += Check("iv empty()", a->Size() = 0);

		# sort against a reference: pseudo-random values with duplicates and negatives
		count := 5000;
		r := IntVector->New(count);
		seed := 12345;
		for(i := 0; i < count; i += 1;) {
			seed := (seed * 1103515245 + 12345) % 2147483648;
			r->AddBack((seed % 2001) - 1000);
		};
		r->AddBack(Int->MinSize());
		r->AddBack(Int->MaxSize());
		before := r->Sum();
		r->Sort();
		sorted := true;
		for(i := 1; i < r->Size(); i += 1;) {
			if(r->Get(i - 1) > r->Get(i)) {
				sorted := false;
			};
		};
		failures += Check("iv sort order", sorted & r->First() = Int->MinSize() & r->Last() = Int->MaxSize());
		failures += Check("iv sort keeps values", r->Sum() = before & r->Size() = count + 2);

		negatives := IntRef->New(0);
		r->Each(\(x) => { if(x < 0) { negatives->Set(negatives->Get() + 1); }; });
		failures += Check("iv each", negatives->Get() > 0 & negatives->Get() < r->Size());
		copy := IntVector->New(r->ToArray());
		failures += Check("iv copy", copy->Size() = r->Size() & copy->Get(17) = r->Get(17));

		big := IntVector->New();
		big->Reserve(1000);
		failures += Check("iv reserve", big->Size() = 0);

		return failures;
	}

	function : FloatVectors() ~ Int {
		failures := 0;

		v := FloatVector->New();
		failures += Check("fv empty", v->IsEmpty() & v->Get(0) = 0.0 & v->RemoveBack() = 0.0 & v->Find(1.0) = -1);
		for(i := 0; i < 50000; i += 1;) {
			v->AddBack(i * 0.5);
		};
		failures += Check("fv growth", v->Size() = 50000 & v->Get(49999) = 24999.5);
		failures += Check("fv sum", v->Sum() = 624987500.0);
		failures += Check("fv set", v->Set(-1.25, 3) & v->Get(3) = -1.25 & v->Find(-1.25) = 3 & v->Has(0.5));
		failures += Check("fv remove", v->Remove(0) = 0.0 & v->Size() = 49999);

		s := FloatVector->New([2.5, -1.0, 0.0, 9.75, -3.5]);
		s->Sort();
		failures += Check("fv sort", s->Get(0) = -3.5 & s->Get(1) = -1.0 & s->Get(4) = 9.75);
		failures += Check("fv array", s->ToArray()->Size() = 5 & s->First() = -3.5 & s->Last() = 9.75);

		r := FloatVector->New();
		seed := 99;
		for(i := 0; i < 3000; i += 1;) {
			seed := (seed * 1103515245 + 12345) % 2147483648;
			r->AddBack((seed % 10000) / 7.0 - 700.0);
		};
		r->Sort();
		sorted := true;
		for(i := 1; i < r->Size(); i += 1;) {
			if(r->Get(i - 1) > r->Get(i)) {
				sorted := false;
			};
		};
		failures += Check("fv sort order", sorted & r->Size() = 3000);
		r->Clear();
		failures += Check("fv clear", r->IsEmpty());

		return failures;
	}

	function : IntMaps() ~ Int {
		failures := 0;

		m := IntMap->New();
		failures += Check("im empty", m->IsEmpty() & m->Find(0) = 0 & m->Find(0, -9) = -9 & <>m->Has(0) & <>m->Remove(0));
		failures += Check("im empty keys", m->GetKeys()->Size() = 0 & m->GetValues()->Size() = 0 & m->ToString()->Equals("[]"));

		m->Insert(0, 100);
		m->Insert(-1, 200);
		m->Insert(Int->MinSize(), 300);
		m->Insert(Int->MaxSize(), 400);
		failures += Check("im extremes", m->Size() = 4 & m->Find(0) = 100 & m->Find(-1) = 200 & m->Find(Int->MinSize()) = 300 & m->Find(Int->MaxSize()) = 400);
		failures += Check("im has zero", m->Has(0) & <>m->Has(1));
		m->Insert(0, 101);
		failures += Check("im overwrite", m->Size() = 4 & m->Find(0) = 101);
		failures += Check("im add", m->Add(7, 3) = 3 & m->Add(7, 4) = 7 & m->Find(7) = 7);
		failures += Check("im remove", m->Remove(Int->MinSize()) & <>m->Has(Int->MinSize()) & m->Size() = 4);

		keys := m->GetKeys();
		values := m->GetValues();
		same := keys->Size() = 4 & values->Size() = 4;
		each(i : keys) {
			if(m->Find(keys[i]) <> values[i]) {
				same := false;
			};
		};
		failures += Check("im keys and values in one order", same);

		total := IntRef->New(0);
		m->Each(\(k, v) => { total->Set(total->Get() + v); });
		failures += Check("im each", total->Get() = 101 + 200 + 400 + 7);

		# growth, then delete every third key and reinsert with new values
		g := IntMap->New();
		count := 300000;
		for(i := 0; i < count; i += 1;) {
			g->Insert(i * 3 - 450000, i);
		};
		failures += Check("im growth", g->Size() = count);
		bad := 0;
		for(i := 0; i < count; i += 1;) {
			if(g->Find(i * 3 - 450000, -1) <> i) {
				bad += 1;
			};
		};
		failures += Check("im growth finds", bad = 0 & <>g->Has(1));

		for(i := 0; i < count; i += 3;) {
			g->Remove(i * 3 - 450000);
		};
		failures += Check("im deletes", g->Size() = count - 100000);
		bad := 0;
		for(i := 0; i < count; i += 1;) {
			has := g->Has(i * 3 - 450000);
			if(i % 3 = 0 & has) {
				bad += 1;
			}
			else if(i % 3 <> 0 & <>has) {
				bad += 1;
			};
		};
		failures += Check("im deletes kept the rest", bad = 0);
		for(i := 0; i < count; i += 3;) {
			g->Insert(i * 3 - 450000, -i);
		};
		bad := 0;
		for(i := 0; i < count; i += 1;) {
			value := g->Find(i * 3 - 450000, 12345);
			if(i % 3 = 0 & value <> -i) {
				bad += 1;
			}
			else if(i % 3 <> 0 & value <> i) {
				bad += 1;
			};
		};
		failures += Check("im reinserted", bad = 0 & g->Size() = count);

		# patterned keys: multiples of 2^20
		p := IntMap->New(1000);
		for(i := 0; i < 20000; i += 1;) {
			p->Insert(i << 20, i);
		};
		failures += Check("im strided", p->Size() = 20000 & p->Find(19999 << 20) = 19999);
		p->Empty();
		failures += Check("im emptied", p->IsEmpty() & <>p->Has(0));

		return failures;
	}

	function : IntSets() ~ Int {
		failures := 0;

		s := IntSet->New();
		failures += Check("is empty", s->IsEmpty() & <>s->Has(0) & <>s->Remove(0) & s->ToArray()->Size() = 0 & s->ToString()->Equals("{}"));
		failures += Check("is add", s->Add(0) & s->Add(Int->MinSize()) & s->Add(Int->MaxSize()) & s->Add(-7) & <>s->Add(0));
		failures += Check("is has", s->Has(0) & s->Has(Int->MinSize()) & s->Has(Int->MaxSize()) & s->Has(-7) & <>s->Has(7));
		s->Insert(5);
		failures += Check("is size", s->Size() = 5 & s->ToArray()->Size() = 5);
		failures += Check("is remove", s->Remove(Int->MaxSize()) & <>s->Has(Int->MaxSize()) & s->Size() = 4);

		sum := IntRef->New(0);
		s->Each(\(v) => { if(v > -100) { sum->Set(sum->Get() + v); }; });
		failures += Check("is each", sum->Get() = 0 - 7 + 5);

		big := IntSet->New();
		for(i := 0; i < 200000; i += 1;) {
			big->Add(i * 7);
		};
		for(i := 0; i < 200000; i += 2;) {
			big->Remove(i * 7);
		};
		bad := 0;
		for(i := 0; i < 200000; i += 1;) {
			if(big->Has(i * 7) <> (i % 2 = 1)) {
				bad += 1;
			};
		};
		failures += Check("is growth and deletes", bad = 0 & big->Size() = 100000);
		for(i := 0; i < 200000; i += 2;) {
			big->Add(i * 7);
		};
		failures += Check("is reinserted", big->Size() = 200000 & big->Has(0) & big->Has(7 * 199998));
		big->Empty();
		failures += Check("is emptied", big->IsEmpty());

		return failures;
	}

	function : BitSets() ~ Int {
		failures := 0;

		e := BitSet->New();
		failures += Check("bs empty", e->Size() = 0 & e->Cardinality() = 0 & e->NextSetBit(0) = -1 & <>e->Get(0) & e->ToString()->Equals("{}"));

		b := BitSet->New(130);
		failures += Check("bs size", b->Size() = 130 & b->Cardinality() = 0);
		b->Set(63);
		b->Set(64);
		b->Set(65);
		failures += Check("bs boundaries", b->Get(63) & b->Get(64) & b->Get(65) & <>b->Get(62) & <>b->Get(66));
		failures += Check("bs cardinality", b->Cardinality() = 3);
		failures += Check("bs next", b->NextSetBit(0) = 63 & b->NextSetBit(64) = 64 & b->NextSetBit(65) = 65 & b->NextSetBit(66) = -1);
		failures += Check("bs string", b->ToString()->Equals("{63,64,65}"));
		b->Clear(64);
		failures += Check("bs clear", <>b->Get(64) & b->Get(63) & b->Get(65) & b->Cardinality() = 2);
		failures += Check("bs next skips", b->NextSetBit(64) = 65);
		b->Set(0);
		b->Set(127);
		failures += Check("bs word ends", b->Get(0) & b->Get(127) & b->NextSetBit(66) = 127 & b->Cardinality() = 4);
		b->Set(-1);
		failures += Check("bs negative ignored", b->Cardinality() = 4 & <>b->Get(-1));
		b->Set(5, true);
		b->Set(5, false);
		failures += Check("bs set flag", <>b->Get(5));

		# growth past the constructor size
		b->Set(1000);
		failures += Check("bs grows", b->Size() = 1001 & b->Get(1000) & b->NextSetBit(128) = 1000);

		# all 64 bits of one word, including the sign bit
		full := BitSet->New(64);
		for(i := 0; i < 64; i += 1;) {
			full->Set(i);
		};
		failures += Check("bs full word", full->Cardinality() = 64 & full->NextSetBit(63) = 63 & full->GetWords()[0] = -1);

		x := BitSet->New(70);
		x->Set(1); x->Set(63); x->Set(64); x->Set(69);
		y := BitSet->New(200);
		y->Set(63); y->Set(69); y->Set(150);

		and_set := x->Copy()->And(y);
		failures += Check("bs and", and_set->ToString()->Equals("{63,69}"));
		or_set := x->Copy()->Or(y);
		failures += Check("bs or", or_set->ToString()->Equals("{1,63,64,69,150}") & or_set->Size() = 200);
		xor_set := x->Copy()->Xor(y);
		failures += Check("bs xor", xor_set->ToString()->Equals("{1,64,150}"));
		and_not := x->Copy()->AndNot(y);
		failures += Check("bs and not", and_not->ToString()->Equals("{1,64}"));
		failures += Check("bs copy independent", x->Cardinality() = 4);
		failures += Check("bs and with shorter", y->Copy()->And(x)->ToString()->Equals("{63,69}"));
		failures += Check("bs and Nil", x->Copy()->And(Nil)->Cardinality() = 0 & x->Copy()->Or(Nil)->Cardinality() = 4);

		x->Empty();
		failures += Check("bs empty()", x->Cardinality() = 0 & x->Size() = 70);

		# count against a reference loop
		r := BitSet->New(10000);
		expected := 0;
		for(i := 0; i < 10000; i += 1;) {
			if(i % 3 = 0 | i % 7 = 0) {
				r->Set(i);
				expected += 1;
			};
		};
		walked := 0;
		i := r->NextSetBit(0);
		while(i > -1) {
			walked += 1;
			i := r->NextSetBit(i + 1);
		};
		failures += Check("bs reference count", r->Cardinality() = expected & walked = expected);

		return failures;
	}
}
