#~
# Rosetta Code: Metered concurrency
# https://rosettacode.org/wiki/Metered_concurrency
# Claimed in #1163
#
# EXTRA_LIBS: concurrent
#
# The library's counting semaphore, System.Concurrency.Semaphore, with the task's three operations -- Acquire, Release and the count (Available) -- guarding a set of workers that each acquire it, report, hold it for a while, and release. A waiting Acquire sleeps on a Condition rather than polling. (This test used to carry a hand-written, polled semaphore because the library had none, #1186.) The task's 2-second hold is scaled to a few milliseconds to keep the test fast.
#
# WHAT IS ASSERTED: an invariant, not a schedule. Every holder increments a "currently inside" count under a separate lock and records the largest value ever seen; that maximum must never exceed the meter's limit. 24 workers (deliberately more than any machine's cores) contend for a meter of 4, three rounds each, allocating while they hold it so collections land mid-contention. Also: the count returns to the limit when all are done, every acquire was matched, and the single-threaded semantics (count, a failing TryAcquire at zero, release restoring it) hold before any thread starts.
#
# CONTROL: run against a scratch concurrent.obl whose Semaphore->Acquire has its wait loop removed (it takes a permit unconditionally): FAILED -- the maximum number inside reached 24 against a limit of 4.
#
# No expected values to source: the oracle is the invariant itself.
~#

use System.Concurrency;

# The observer: how many workers are inside right now, and the most ever.
class Gauge {
	@mutex : ThreadMutex;
	@inside : Int;
	@most : Int;
	@entries : Int;

	New() {
		@mutex := ThreadMutex->New("gauge");
		@inside := 0;
		@most := 0;
		@entries := 0;
	}

	method : public : Enter() ~ Nil {
		critical(@mutex) {
			@inside += 1;
			@entries += 1;
			if(@inside > @most) { @most := @inside; };
		};
	}

	method : public : Exit() ~ Nil {
		critical(@mutex) { @inside -= 1; };
	}

	method : public : GetMost() ~ Int {
		v := 0;
		critical(@mutex) { v := @most; };
		return v;
	}

	method : public : GetInside() ~ Int {
		v := 0;
		critical(@mutex) { v := @inside; };
		return v;
	}

	method : public : GetEntries() ~ Int {
		v := 0;
		critical(@mutex) { v := @entries; };
		return v;
	}
}

class Unit from Thread {
	@id : Int;
	@rounds : Int;
	@meter : Semaphore;
	@gauge : Gauge;

	New(id : Int, rounds : Int, meter : Semaphore, gauge : Gauge) {
		Parent("unit-{$id}");
		@id := id;
		@rounds := rounds;
		@meter := meter;
		@gauge := gauge;
	}

	method : public : Run(param : System.Base) ~ Nil {
		for(r := 0; r < @rounds; r += 1;) {
			@meter->Acquire();
			@gauge->Enter();
			# the task's "report that it has acquired the semaphore", kept off
			# stdout so the output stays deterministic
			report := "unit {$@id} acquired the meter";
			# hold it: allocate so collections land while permits are held
			junk := IntRef->New(report->Size());
			for(i := 0; i < 200; i += 1;) {
				junk := IntRef->New(junk->Get() + i);
			};
			Thread->Sleep(3);
			@gauge->Exit();
			@meter->Release();
		};
	}
}

class RosettaMeteredConcurrency {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaMeteredConcurrency->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckBool(what : String, got : Bool, want : Bool) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		limit := 4;

		# ---- single-threaded semantics first ----
		solo := Semaphore->New(2);
		CheckInt("a new meter counts its permits", solo->Available(), 2);
		solo->Acquire();
		CheckInt("acquire takes one", solo->Available(), 1);
		CheckBool("the last permit can be taken", solo->TryAcquire(), true);
		CheckBool("an empty meter refuses", solo->TryAcquire(), false);
		CheckInt("and stays at zero", solo->Available(), 0);
		solo->Release();
		CheckInt("release gives one back", solo->Available(), 1);
		solo->Release();

		# ---- under contention ----
		units := 24;
		rounds := 3;
		meter := Semaphore->New(limit);
		gauge := Gauge->New();
		crew := Unit->New[units];
		for(i := 0; i < units; i += 1;) {
			crew[i] := Unit->New(i, rounds, meter, gauge);
		};
		for(i := 0; i < units; i += 1;) {
			crew[i]->Execute(Nil);
		};
		for(i := 0; i < units; i += 1;) {
			crew[i]->Join();
		};

		most := gauge->GetMost();
		CheckBool("never more than {$limit} inside at once (most was {$most})", most <= limit, true);
		CheckBool("at least one unit got in", most >= 1, true);
		CheckInt("every acquire was a unit entering", gauge->GetEntries(), units * rounds);
		CheckInt("nobody is left inside", gauge->GetInside(), 0);
		CheckInt("the count returns to the limit", meter->Available(), limit);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
