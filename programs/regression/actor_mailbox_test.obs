# EXTRA_LIBS: gen_collect,concurrent,actor
#~
System.Actor Mailbox: FIFO order, bounded queues with the three overflow policies (BLOCK with a
timeout, DROP_OLDEST, REJECT), arrival-order fairness for blocked senders and blocked receivers,
timed receive, TryReceive, Close (what it wakes, what stays receivable), SendUrgent, selective
receive and the discard of a call that a DROP_OLDEST mailbox evicts. Waits are for a state (a
blocked sender is counted by the mailbox), never for a time; the only timing checks are lower bounds.
~#
use System.Actor;
use System.Concurrency;
use Collection;

class SendJob from Thread {
  @box : Mailbox;
  @item : System.Base;
  @timeout : Int;
  @status : Mailbox->Status;

  New(box : Mailbox, item : System.Base, timeout : Int) {
    Parent("send");
    @box := box;
    @item := item;
    @timeout := timeout;
  }

  method : public : Run(param : System.Base) ~ Nil {
    @status := @box->Send(@item, @timeout);
  }

  method : public : GetStatus() ~ Mailbox->Status {
    return @status;
  }
}

class RecvJob from Thread {
  @box : Mailbox;
  @timeout : Int;
  @matcher : MailMatcher;
  @got : System.Base;

  New(box : Mailbox, timeout : Int, matcher : MailMatcher) {
    Parent("recv");
    @box := box;
    @timeout := timeout;
    @matcher := matcher;
  }

  method : public : Run(param : System.Base) ~ Nil {
    if(@matcher <> Nil) {
      @got := @box->ReceiveMatching(@matcher, @timeout);
    }
    else {
      @got := @box->Receive(@timeout);
    };
  }

  method : public : GetGot() ~ System.Base {
    return @got;
  }
}

class CallJob from Thread {
  @actor : Actor;
  @result : CallResult;

  New(actor : Actor) {
    Parent("call");
    @actor := actor;
  }

  method : public : Run(param : System.Base) ~ Nil {
    @result := @actor->Call(Nil, 20000);
  }

  method : public : GetResult() ~ CallResult {
    return @result;
  }
}

class EvenMatcher implements MailMatcher {
  New() {
  }

  method : public : Matches(item : System.Base) ~ Bool {
    return item->TypeOf(IntRef) & item->As(IntRef)->Get() % 2 = 0;
  }
}

class BigMatcher implements MailMatcher {
  New() {
  }

  method : public : Matches(item : System.Base) ~ Bool {
    return item->TypeOf(IntRef) & item->As(IntRef)->Get() > 100;
  }
}

class Sleepy implements ActorBehavior {
  New() {
  }

  method : public : Handle(me : Actor, mail : Mail) ~ Bool {
    return true;
  }
}

class MailboxTest {
  @failures : static : Int;

  function : Check(name : String, ok : Bool) ~ Nil {
    if(ok) {
      "  [PASS] {$name}"->PrintLine();
    }
    else {
      "  [FAIL] {$name}"->PrintLine();
      @failures += 1;
    };
  }

  # waits for a state, not a time; gives up after ten seconds so a bug fails instead of hanging
  function : AwaitSenders(box : Mailbox, n : Int) ~ Bool {
    deadline := ActorClock->Now() + 10000;
    while(box->GetWaitingSenders() < n & ActorClock->Now() < deadline) {
      Thread->Sleep(1);
    };
    return box->GetWaitingSenders() >= n;
  }

  function : AwaitReceivers(box : Mailbox, n : Int) ~ Bool {
    deadline := ActorClock->Now() + 10000;
    while(box->GetWaitingReceivers() < n & ActorClock->Now() < deadline) {
      Thread->Sleep(1);
    };
    return box->GetWaitingReceivers() >= n;
  }

  function : AwaitSize(box : Mailbox, n : Int) ~ Bool {
    deadline := ActorClock->Now() + 10000;
    while(box->Size() < n & ActorClock->Now() < deadline) {
      Thread->Sleep(1);
    };
    return box->Size() >= n;
  }

  function : Val(item : System.Base) ~ Int {
    if(item = Nil) {
      return -1;
    };
    return item->As(IntRef)->Get();
  }

  function : Fifo() ~ Nil {
    "FIFO and Nil:"->PrintLine();
    box := Mailbox->New();
    ok := true;
    each(i : 100) {
      if(box->Send(IntRef->New(i)) <> Mailbox->Status->OK) {
        ok := false;
      };
    };
    Check("100 sends accepted", ok);
    Check("size", box->Size() = 100);
    in_order := true;
    each(i : 100) {
      if(Val(box->Receive(0)) <> i) {
        in_order := false;
      };
    };
    Check("received in send order", in_order);
    Check("empty now", box->Size() = 0 & box->TryReceive() = Nil);
    Check("a Nil item is INVALID", box->Send(Nil) = Mailbox->Status->INVALID);
    Check("counters", box->GetSentCount() = 100 & box->GetReceivedCount() = 100);
    Check("unbounded", box->GetCapacity() = 0);
  }

  function : Reject() ~ Nil {
    "REJECT policy:"->PrintLine();
    box := Mailbox->New(2, Mailbox->Policy->REJECT);
    Check("first fits", box->Send(IntRef->New(1)) = Mailbox->Status->OK);
    Check("second fits", box->Send(IntRef->New(2)) = Mailbox->Status->OK);
    Check("third is FULL", box->Send(IntRef->New(3)) = Mailbox->Status->FULL);
    Check("one rejected", box->GetRejectedCount() = 1 & box->Size() = 2);
    Check("the queue kept 1 then 2", Val(box->Receive(0)) = 1 & Val(box->Receive(0)) = 2);
    Check("room again", box->Send(IntRef->New(4)) = Mailbox->Status->OK);
    Check("capacity and policy", box->GetCapacity() = 2 & box->GetPolicy() = Mailbox->Policy->REJECT);
  }

  function : DropOldest() ~ Nil {
    "DROP_OLDEST policy:"->PrintLine();
    box := Mailbox->New(2, Mailbox->Policy->DROP_OLDEST);
    box->Send(IntRef->New(1));
    box->Send(IntRef->New(2));
    Check("the third evicts the first", box->Send(IntRef->New(3)) = Mailbox->Status->DROPPED_OLDEST);
    Check("one dropped", box->GetDroppedCount() = 1 & box->Size() = 2);
    Check("the queue kept 2 then 3", Val(box->Receive(0)) = 2 & Val(box->Receive(0)) = 3);
  }

  function : BlockTimeout() ~ Nil {
    "BLOCK policy, timeouts:"->PrintLine();
    box := Mailbox->New(1, Mailbox->Policy->BLOCK);
    box->Send(IntRef->New(1));
    started := ActorClock->Now();
    status := box->Send(IntRef->New(2), 60);
    elapsed := ActorClock->Now() - started;
    Check("a full BLOCK mailbox times out", status = Mailbox->Status->TIMED_OUT);
    Check("it waited at least the timeout ({$elapsed} ms)", elapsed >= 55);
    Check("timeout 0 does not wait", box->Send(IntRef->New(3), 0) = Mailbox->Status->TIMED_OUT);
    Check("the queue is unchanged", box->Size() = 1 & Val(box->Receive(0)) = 1);
    Check("no sender is left waiting", box->GetWaitingSenders() = 0);
    Check("room again", box->Send(IntRef->New(4), 0) = Mailbox->Status->OK);
  }

  function : BlockUnblocks() ~ Nil {
    "BLOCK policy, backpressure:"->PrintLine();
    box := Mailbox->New(1, Mailbox->Policy->BLOCK);
    box->Send(IntRef->New(1));
    job := SendJob->New(box, IntRef->New(2), -1);
    job->Execute(Nil);
    Check("the sender blocked", AwaitSenders(box, 1));
    Check("the first item is still there", Val(box->Receive(0)) = 1);
    job->Join();
    Check("the blocked send went through", job->GetStatus() = Mailbox->Status->OK);
    Check("its item arrived", Val(box->Receive(1000)) = 2);

    # blocked senders go in arrival order
    box->Send(IntRef->New(0));
    jobs := Vector->New()<SendJob>;
    each(i : 4) {
      j := SendJob->New(box, IntRef->New(i + 1), -1);
      j->Execute(Nil);
      jobs->AddBack(j);
      Check("sender {$(i + 1)} is waiting", AwaitSenders(box, i + 1));
    };
    order := "";
    each(i : 5) {
      order += Val(box->Receive(10000))->ToString();
    };
    Check("served in arrival order ({$order})", order->Equals("01234"));
    each(i : jobs) {
      jobs->Get(i)->Join();
    };
  }

  function : ReceiverFairness() ~ Nil {
    "waiting receivers:"->PrintLine();
    box := Mailbox->New();
    r1 := RecvJob->New(box, -1, Nil);
    r1->Execute(Nil);
    Check("first receiver is waiting", AwaitReceivers(box, 1));
    r2 := RecvJob->New(box, -1, Nil);
    r2->Execute(Nil);
    Check("second receiver is waiting", AwaitReceivers(box, 2));
    box->Send(IntRef->New(10));
    box->Send(IntRef->New(20));
    r1->Join();
    r2->Join();
    Check("the first to wait got the first item", Val(r1->GetGot()) = 10);
    Check("the second got the second", Val(r2->GetGot()) = 20);
  }

  function : Timeouts() ~ Nil {
    "timed receive:"->PrintLine();
    box := Mailbox->New();
    started := ActorClock->Now();
    item := box->Receive(60);
    elapsed := ActorClock->Now() - started;
    Check("an empty mailbox times out with Nil", item = Nil);
    Check("it waited at least the timeout ({$elapsed} ms)", elapsed >= 55);
    Check("a timeout is not a close", box->IsDrained() = false & box->IsClosed() = false);
    Check("TryReceive on empty is Nil", box->TryReceive() = Nil);
    Check("nobody is left waiting", box->GetWaitingReceivers() = 0);
    box->Send(IntRef->New(5));
    Check("a ready item is returned at once", Val(box->Receive(0)) = 5);
  }

  function : Closing() ~ Nil {
    "Close:"->PrintLine();
    box := Mailbox->New(4, Mailbox->Policy->BLOCK);
    box->Send(IntRef->New(1));
    box->Send(IntRef->New(2));
    box->Close();
    Check("closed", box->IsClosed());
    Check("not drained yet", box->IsDrained() = false);
    Check("send after close is CLOSED", box->Send(IntRef->New(3)) = Mailbox->Status->CLOSED);
    Check("urgent send after close is CLOSED", box->SendUrgent(IntRef->New(3)) = Mailbox->Status->CLOSED);
    Check("queued items stay receivable", Val(box->Receive(0)) = 1 & Val(box->Receive(-1)) = 2);
    Check("then Receive returns Nil at once", box->Receive(-1) = Nil);
    Check("drained", box->IsDrained());

    # a blocked receiver wakes
    b2 := Mailbox->New();
    r := RecvJob->New(b2, -1, Nil);
    r->Execute(Nil);
    AwaitReceivers(b2, 1);
    b2->Close();
    r->Join();
    Check("Close wakes a blocked receiver with Nil", r->GetGot() = Nil & b2->IsDrained());

    # a blocked sender wakes
    b3 := Mailbox->New(1, Mailbox->Policy->BLOCK);
    b3->Send(IntRef->New(1));
    s := SendJob->New(b3, IntRef->New(2), -1);
    s->Execute(Nil);
    AwaitSenders(b3, 1);
    b3->Close();
    s->Join();
    Check("Close wakes a blocked sender with CLOSED", s->GetStatus() = Mailbox->Status->CLOSED);
    Check("the item that was queued survives", Val(b3->Receive(0)) = 1);
  }

  function : Urgent() ~ Nil {
    "SendUrgent:"->PrintLine();
    box := Mailbox->New(1, Mailbox->Policy->REJECT);
    box->Send(IntRef->New(1));
    Check("a normal send is refused", box->Send(IntRef->New(2)) = Mailbox->Status->FULL);
    Check("an urgent send goes through", box->SendUrgent(IntRef->New(3)) = Mailbox->Status->OK);
    Check("past the capacity", box->Size() = 2);
    Check("in order", Val(box->Receive(0)) = 1 & Val(box->Receive(0)) = 3);
  }

  function : Selective() ~ Nil {
    "selective receive:"->PrintLine();
    box := Mailbox->New();
    each(i : 6) {
      box->Send(IntRef->New(i + 1));
    };
    Check("takes the first even item", Val(box->ReceiveMatching(EvenMatcher->New(), 0)) = 2);
    Check("then the next", Val(box->ReceiveMatching(EvenMatcher->New(), 0)) = 4);
    Check("the others keep their order", Val(box->Receive(0)) = 1 & Val(box->Receive(0)) = 3 & Val(box->Receive(0)) = 5 & Val(box->Receive(0)) = 6);
    Check("no match, no wait: Nil", box->ReceiveMatching(EvenMatcher->New(), 0) = Nil);

    started := ActorClock->Now();
    got := box->ReceiveMatching(EvenMatcher->New(), 60);
    elapsed := ActorClock->Now() - started;
    Check("no match times out with Nil after the timeout ({$elapsed} ms)", got = Nil & elapsed >= 55);

    # a matching item that arrives later, among others that do not match
    r := RecvJob->New(box, -1, BigMatcher->New());
    r->Execute(Nil);
    box->Send(IntRef->New(1));
    box->Send(IntRef->New(2));
    box->Send(IntRef->New(500));
    box->Send(IntRef->New(3));
    r->Join();
    Check("it waited for the item it wanted", Val(r->GetGot()) = 500);
    Check("the rest stayed queued in order", Val(box->Receive(0)) = 1 & Val(box->Receive(0)) = 2 & Val(box->Receive(0)) = 3);

    # a closed mailbox with no match returns Nil
    box->Send(IntRef->New(7));
    box->Close();
    Check("closed, no match: Nil", box->ReceiveMatching(EvenMatcher->New(), -1) = Nil);
    Check("the odd item is still there", Val(box->Receive(0)) = 7);
  }

  function : EvictedCall() ~ Nil {
    "an evicted call fails at once:"->PrintLine();
    actor := Actor->New("unstarted", Sleepy->New(), Mailbox->New(1, Mailbox->Policy->DROP_OLDEST));
    job := CallJob->New(actor);
    job->Execute(Nil);
    Check("the call is queued", AwaitSize(actor->GetMailbox(), 1));
    actor->Send(IntRef->New(1));
    job->Join();
    result := job->GetResult();
    Check("the evicted call returned DEAD, not a timeout", result->GetStatus() = CallResult->Status->DEAD);
    actor->Kill();
    Check("an unstarted actor can be killed", actor->Join(5000)->GetKind() = ExitReason->Kind->KILLED);
  }

  function : Main(args : String[]) ~ Nil {
    Fifo();
    Reject();
    DropOldest();
    BlockTimeout();
    BlockUnblocks();
    ReceiverFairness();
    Timeouts();
    Closing();
    Urgent();
    Selective();
    EvictedCall();
    if(@failures > 0) {
      "{$@failures} failure(s)"->PrintLine();
      Runtime->Exit(1);
    };
    "all mailbox checks passed"->PrintLine();
  }
}
