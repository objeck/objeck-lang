#~
# API.Inference: tensor bookkeeping, error reporting, and the two wire formats.
#
# EXTRA_LIBS: models,inference,net,json,cipher,gen_collect
#
# API.Inference is the HTTP route to a model server -- the sibling of API.Onnx,
# which runs a model in-process. It exists because no in-process backend covers
# every platform Objeck ships on and because a server is the only GPU path today
# (docs/INFERENCE_ENGINES_PLAN.md).
#
# Everything here runs WITHOUT a server, which is the whole reason
# Client->DescribeRequest exists: it returns the body the client would send
# without sending it. The two protocols shape the same tensors very differently
# and a tensor nested to the wrong depth looks identical in Objeck, so the wire
# format is the part worth pinning down.
#
#   KServe v2 / Open Inference    flat "data", with "shape" and "datatype" stated
#   TF Serving v1                 "instances" NESTED to express the shape
#
# What is not covered here: Predict, IsReady and Metadata all need a live
# server. Their request construction is reached through DescribeRequest and
# their response parsing through EndPoint->ParseResponse, which are both tested;
# the socket call between them is not.
#
# Measured bodies, so nobody has to guess at the serializer:
#
#   v2, shape [4]     {"inputs":[{"data":[...],"datatype":"FP32","name":"input","shape":[4]}]}
#   v1, shape [4]     {"inputs":{"input":[1.0,2.0,3.0,4.0]}}
#   v1, shape [2,2]   {"inputs":{"input":[[1.0,2.0],[3.0,4.0]]}}
#
# The last two carry the same four numbers. Only the bracket depth tells them
# apart, and nothing on the Objeck side would show the difference -- which is
# why these assertions are worth having.
~#
use API.Inference;
use API.Models;
use Collection;

class InferenceClientTest {
	@ok : Bool;

	function : Main(args : String[]) ~ Nil {
		t := InferenceClientTest->New();
		t->Run();
	}

	New() {
		@ok := true;
	}

	method : Report(name : String, cond : Bool) ~ Nil {
		if(cond) {
			"PASS: {$name}"->PrintLine();
		}
		else {
			"FAIL: {$name}"->PrintLine();
			@ok := false;
		};
	}

	method : Run() ~ Nil {
		Tensors();
		Errors();
		OpenInferenceBody();
		TfServingBody();
		Refusals();

		if(<>@ok) {
			Runtime->Exit(1);
		};

		"reached the end"->PrintLine();
	}

	#~
	A tensor carries its shape beside flat data, so the two can disagree. They
	are checked here rather than by the server, whose rejection names neither.
	~#
	method : Tensors() ~ Nil {
		pixels := Float->New[12];
		image := Tensor->New("input", [1, 3, 2, 2], pixels);
		Report("a float tensor is FP32 by default", image->GetDatatype()->Equals("FP32"));
		Report("it holds floats", image->IsFloat());
		Report("its count is its data length", image->GetCount() = 12);
		Report("its shape product is 1*3*2*2", image->GetShapeProduct() = 12);
		Report("so it is consistent", image->IsConsistent());
		Report("and GetInts is Nil on a float tensor", image->GetInts() = Nil);

		# Token ids are the reason integers are carried separately: past 2^53 a
		# Float cannot hold them, so sending them as floats is wrong, not just
		# wasteful.
		ids := [101, 2003, 1037];
		tokens := Tensor->New("input_ids", [1, 3], ids);
		Report("an integer tensor is INT64 by default", tokens->GetDatatype()->Equals("INT64"));
		Report("it does not hold floats", <>tokens->IsFloat());
		Report("GetFloats is Nil on an integer tensor", tokens->GetFloats() = Nil);
		Report("its count comes from the integer data", tokens->GetCount() = 3);
		Report("and it is consistent", tokens->IsConsistent());

		ragged := Tensor->New("input", [2, 3], Float->New[4]);
		Report("four elements in a 2x3 is not consistent", <>ragged->IsConsistent());
		Report("and the mismatch is visible as a shape product", ragged->GetShapeProduct() = 6);

		named := Tensor->New("half", "FP16", [1, 2], Float->New[2]);
		Report("a datatype can be named explicitly", named->GetDatatype()->Equals("FP16"));

		shapeless := Tensor->New("x", Nil->As(Int[]), Float->New[1]);
		Report("an unset shape has product 0", shapeless->GetShapeProduct() = 0);
		Report("so a tensor without a shape is not consistent", <>shapeless->IsConsistent());

		text := image->ToString();
		Report("ToString names the tensor, its type and its dimensions",
			text->Has("input") & text->Has("FP32") & text->Has("1,3,2,2"));
	}

	#~
	Why a parse failure reports the body. Both protocols answer errors as JSON,
	so a body that will not parse means something else answered -- an HTML error
	page from a proxy, a truncated response -- and the body is the only useful
	thing to say about it.
	~#
	method : Errors() ~ Nil {
		Report("an empty body is refused", Wire->ParseResponse("") = Nil);
		Report("and says so", EndPoint->GetLastError()->Has("empty"));

		Report("a Nil body is refused", Wire->ParseResponse(Nil) = Nil);

		html := "<html><body>502 Bad Gateway</body></html>";
		Report("a non-JSON body is refused", Wire->ParseResponse(html) = Nil);
		Report("and the body itself is reported, since nothing else identifies it",
			EndPoint->GetLastError()->Has("502 Bad Gateway"));

		# the shape a server actually uses to report a bad request
		Report("a JSON error body is refused",
			Wire->ParseResponse("{\"error\": \"model not found\"}") = Nil);
		Report("and the server's own message is passed through",
			EndPoint->GetLastError()->Equals("model not found"));

		good := Wire->ParseResponse("{\"outputs\": []}");
		Report("a well-formed body parses", good <> Nil);
	}

	#~
	KServe v2 states the shape and keeps the data flat. A 1x3x224x224 image is
	150,528 numbers in one array; nesting it would cost a Vector per row for
	nothing, since the server wants it flat regardless.
	~#
	method : OpenInferenceBody() ~ Nil {
		client := Client->New("http://localhost:8000");
		Report("the default protocol is Open Inference",
			client->GetProtocol() = Client->Protocol->OPEN_INFERENCE);
		Report("the host is kept as given", client->GetHost()->Equals("http://localhost:8000"));

		inputs := Vector->New()<Tensor>;
		inputs->AddBack(Tensor->New("input", [1, 4], [1.0, 2.0, 3.0, 4.0]));

		body := client->DescribeRequest(inputs);
		Report("a v2 body is produced", body <> Nil);
		if(body = Nil) {
			return;
		};

		Report("it is keyed on 'inputs'", body->Has("\"inputs\""));
		Report("whose value is an ARRAY of entries -- v1 uses an object here",
			body->Has("\"inputs\":["));
		Report("it names the tensor", body->Has("\"input\""));
		Report("it states the datatype, which v2 requires", body->Has("\"datatype\""));
		Report("it states the shape separately from the data", body->Has("\"shape\""));
		Report("and the data stays flat -- no nested arrays",
			body->Has("\"data\"") & <>body->Has("[["));
	}

	#~
	TF Serving v1 has no shape field, so the nesting IS the shape. A [2,2] goes
	out as [[a,b],[c,d]] and a [4] as [a,b,c,d] -- the same four numbers, and the
	only thing distinguishing them is the bracket depth. That is exactly the
	mistake that is invisible on the Objeck side.
	~#
	method : TfServingBody() ~ Nil {
		client := Client->New("http://localhost:8501", Client->Protocol->TF_SERVING);
		Report("the protocol is TF Serving", client->GetProtocol() = Client->Protocol->TF_SERVING);

		flat := Vector->New()<Tensor>;
		flat->AddBack(Tensor->New("input", [4], [1.0, 2.0, 3.0, 4.0]));
		flat_body := client->DescribeRequest(flat);
		Report("a v1 body is produced", flat_body <> Nil);
		if(flat_body = Nil) {
			return;
		};

		# v1 :predict takes two forms -- the ROW form {"instances": [...]} and the
		# COLUMNAR form {"inputs": {name: ...}}. This client sends columnar, which
		# is the one that can name tensors; the row form cannot, so a multi-input
		# model has no way to say which array is which. (PredictTfServing reads
		# both reply shapes, "outputs" and "predictions", since a server may answer
		# either.) So BOTH protocols use the key "inputs" and the key is not what
		# distinguishes them -- the shape of its value is.
		Report("it is keyed on 'inputs', in v1's columnar form",
			flat_body->Has("\"inputs\""));
		Report("whose value is an OBJECT keyed by tensor name, where v2's is an ARRAY of entries",
			flat_body->Has("\"inputs\":{"));
		Report("and it states no shape -- in v1 the nesting IS the shape",
			<>flat_body->Has("\"shape\""));
		Report("it carries no datatype -- v1 has no field for one",
			<>flat_body->Has("\"datatype\""));
		Report("a rank-1 tensor is not nested further", <>flat_body->Has("[[["));

		# same data, different shape: the body must differ
		nested := Vector->New()<Tensor>;
		nested->AddBack(Tensor->New("input", [2, 2], [1.0, 2.0, 3.0, 4.0]));
		nested_body := client->DescribeRequest(nested);
		Report("a rank-2 body is produced", nested_body <> Nil);
		if(nested_body = Nil) {
			return;
		};

		Report("the rank-2 tensor nests one level deeper", nested_body->Has("[["));
		Report("and the four identical numbers give a DIFFERENT body than rank-1, which is the whole point",
			<>nested_body->Equals(flat_body));
	}

	#~ What both protocols refuse before anything is sent. ~#
	method : Refusals() ~ Nil {
		client := Client->New("http://localhost:8000");

		empty := Vector->New()<Tensor>;
		Report("no input tensors is refused", client->DescribeRequest(empty) = Nil);
		Report("and says so", EndPoint->GetLastError()->Has("no input tensors"));

		Report("a Nil vector is refused", client->DescribeRequest(Nil) = Nil);

		ragged := Vector->New()<Tensor>;
		ragged->AddBack(Tensor->New("bad", [2, 3], Float->New[4]));
		Report("a tensor that does not match its shape is refused",
			client->DescribeRequest(ragged) = Nil);
		Report("and the message names the tensor, which the server's would not",
			EndPoint->GetLastError()->Has("bad"));
	}
}
