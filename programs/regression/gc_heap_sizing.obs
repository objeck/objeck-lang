#~
The threshold for a major collection follows the live heap. After each major collection the
next one waits until the heap has grown to twice what survived (and never below the start
size), so the number of collections is proportional to what a program allocates, not to how
much it keeps.

It used to grow only after eight majors in a row freed nothing, and to shrink after 24 that freed
anything. A program that keeps a large data set while making temporaries -- a table, a model --
never met the first condition: once its live data passed the 8 MB start, every array it
allocated ran a full collection: building this test's data ran 121 majors.

A threshold given with --gc-threshold holds as given while the live heap fits well under it
(stress runs use a small one to force collections), and scales with the live heap while three
quarters of it or more survive a major collection: held fixed, a threshold below the live heap
ran a full collection on every allocation. Under one this test checks both halves.
~#
class GcHeapSizing {
	@failures : static : Int;

	function : Check(what : String, ok : Bool) ~ Nil {
		if(<>ok) {
			@failures += 1;
			"  FAIL: {$what}"->PrintLine();
		};
	}

	function : Majors() ~ Int {
		return Runtime->GetProperty("runtime.gc.major")->ToInt();
	}

	function : Threshold() ~ Int {
		return Runtime->GetProperty("runtime.memory.max")->ToInt();
	}

	function : Allocated() ~ Int {
		return Runtime->GetProperty("runtime.memory.allocated")->ToInt();
	}

	function : Main(args : String[]) ~ Nil {
		@failures := 0;

		# 8 MB unless --gc-threshold gave it, and then the test uses a few MB of data
		initial := Threshold();
		if(initial <> 8388608) {
			Given(initial);
		}
		else {
			Sized();
		};

		if(@failures = 0) {
			"PASS: the major-collection threshold follows the live heap"->PrintLine();
		}
		else {
			"FAIL: the major-collection threshold follows the live heap ({$@failures} checks)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Given(initial : Int) ~ Nil {
		Outgrow(initial);

		# with that data gone, 16 MB of 4 KB temporaries runs majors whose survivors fit
		# well under the given threshold, which then holds as given
		total := 0;
		each(i : 4000) {
			temp := Int->New[512];
			temp[0] := i;
			total += temp[0];
		};
		Check("the temporaries are intact", total = 4000 * 3999 / 2);
		now := Threshold();
		live := Allocated();
		Check("the given threshold returns once the live heap fits under it (threshold {$now}, live {$live})",
			now = initial);
	}

	# Its own method, so nothing in the caller's frame keeps the data alive afterwards
	function : Outgrow(initial : Int) ~ Nil {
		start := Majors();

		# 4 MB kept, in 512 pieces of 8 KB: a threshold of 2 MB or less is outgrown on the way
		pieces := Int[]->New[512];
		each(i : pieces) {
			pieces[i] := Int->New[1024];
			pieces[i][0] := i;
		};
		built := Majors() - start;
		Check("the kept data survives", pieces[0][0] = 0 & pieces[511][0] = 511);
		Check("the threshold is above the live heap", Threshold() > Allocated());
		if(initial <= 2097152) {
			Check("a threshold the live heap outgrew scales with it", Threshold() > initial);
			# one major per doubling of the live heap, not one per allocation (512)
			Check("building 4 MB runs a few majors, not one per allocation ({$built} ran)", built <= 16);
		};

		# Empty the container before returning. The collector reads some words
		# conservatively -- the temporary slots beside a compiled frame's locals,
		# the word at the operand stack's top -- and a stale copy of a reference
		# there can outlive this method. Once, on linux-arm64 with every method
		# compiled under --gc-threshold=1m, the threshold never came back after
		# this returned (run 40257179714): built then from one container of four
		# 1 MB arrays, a single such word could hold all 4 MB. (x64 never showed
		# it in 600 local runs.) Emptied, and in 8 KB pieces, one stale word
		# can keep at most 8 KB, under three quarters of the smallest threshold
		# this runs under (64 KB), so the given threshold must still return.
		each(i : pieces) {
			pieces[i] := Nil;
		};
	}

	function : Sized() ~ Nil {
		start := Majors();

		# about 64 MB kept alive for the whole run, well past the 8 MB start, built the way
		# real data is: with temporaries along the way, so every collection frees something
		kept := Int[]->New[64];
		each(i : kept) {
			kept[i] := Int->New[131072];
			kept[i][0] := i;
			each(j : 16) {
				scratch := Int->New[256];
				scratch[0] := j;
			};
		};

		# 4,000 short-lived arrays: 16 MB in all, a quarter of what is live
		before := Majors();
		total := 0;
		each(i : 4000) {
			temp := Int->New[512];
			temp[0] := i;
			total += temp[0];
		};
		ran := Majors() - before;
		all := Majors() - start;

		Check("the kept data survives", kept[63][0] = 63 & total = 4000 * 3999 / 2);
		# 64 MB built from an 8 MB start doubles about four times; the old policy ran 121
		Check("building the data runs a few majors, one per doubling ({$all} ran)", all <= 10);
		Check("temporaries a fraction of the live heap cause a few majors, not one each ({$ran} ran)", ran <= 3);
		Check("the threshold is above the live heap", Threshold() > Runtime->GetProperty("runtime.memory.allocated")->ToInt());
	}
}
