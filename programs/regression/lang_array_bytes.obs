#~
Raw conversion between numeric arrays and bytes, one memcpy each:
Int->ToBytes / Byte->ToInts and Float->ToBytes / Byte->ToFloats, with
whole-array and (offset, count) forms. 8 bytes per value, little-endian.
The ToBytes offset and count are in values; the ToInts/ToFloats offset is in
bytes and the count in values. A range that does not fit raises an
IndexError, and a whole-array read of a byte count that is not a multiple of
8 a RuntimeError, both recoverable with try/on.
~#
class LangArrayBytes {
	@failures : Int;

	New() {
		@failures := 0;
	}

	method : Check(what : String, ok : Bool) ~ Nil {
		if(ok) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	method : SameInts(a : Int[], b : Int[]) ~ Bool {
		if(a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(a[i] <> b[i]) {
				return false;
			};
		};
		return true;
	}

	method : SameFloats(a : Float[], b : Float[]) ~ Bool {
		if(a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(a[i] <> b[i]) {
				return false;
			};
		};
		return true;
	}

	method : Ints() ~ Nil {
		values := [0, 1, -1, 258, Int->MaxSize(), Int->MinSize(), 1234567890123];
		bytes := Int->ToBytes(values);
		Check("Int->ToBytes size", bytes->Size() = 56);
		Check("Int->ToInts round trip", SameInts(Byte->ToInts(bytes), values));

		# little-endian: 258 is 02 01 00 ...
		Check("little-endian layout", bytes[24] = 2 & bytes[25] = 1 & bytes[26] = 0 & bytes[31] = 0);
		Check("-1 is all ones", bytes[16] = 0xff & bytes[23] = 0xff & bytes[8] = 1);

		part := Int->ToBytes(values, 2, 3);
		Check("Int->ToBytes range", part->Size() = 24 & SameInts(Byte->ToInts(part), [-1, 258, Int->MaxSize()]));

		Check("Byte->ToInts from a byte offset", SameInts(Byte->ToInts(bytes, 8, 2), [1, -1]));

		# an unaligned byte offset reads the bytes as they lie
		padded := Byte->New[17];
		Runtime->Copy(padded, 1, Int->ToBytes([258, 7]), 0, 16);
		Check("Byte->ToInts at an odd offset", SameInts(Byte->ToInts(padded, 1, 2), [258, 7]));

		empty := Int->New[0];
		Check("empty Int[] to bytes", Int->ToBytes(empty)->Size() = 0);
		Check("empty bytes to Int[]", Byte->ToInts(Byte->New[0])->Size() = 0);
		Check("count 0 at the end", Byte->ToInts(bytes, 56, 0)->Size() = 0 & Int->ToBytes(values, 7, 0)->Size() = 0);
	}

	method : Floats() ~ Nil {
		values := [0.0, -0.0, 1.5, -2.25, 1.0e-300, 1.7976931348623157e308, Float->Pow(2.0, -1074.0), Float->Inf()];
		bytes := Float->ToBytes(values);
		Check("Float->ToBytes size", bytes->Size() = 64);
		back := Byte->ToFloats(bytes);
		Check("Byte->ToFloats round trip", SameFloats(back, values));
		Check("-0.0 keeps its sign", Float->ToString(back[1], 1)->Equals("-0.0"));

		# 1.5 is 0x3FF8000000000000: the last byte is 0x3f
		Check("little-endian float layout", bytes[16 + 7] = 0x3f & bytes[16 + 6] = 0xf8 & bytes[16] = 0);

		part := Float->ToBytes(values, 2, 2);
		Check("Float->ToBytes range", SameFloats(Byte->ToFloats(part), [1.5, -2.25]));
		Check("Byte->ToFloats from a byte offset", SameFloats(Byte->ToFloats(bytes, 16, 1), [1.5]));

		nan := Byte->ToFloats(Float->ToBytes([Float->NaN()]));
		Check("NaN survives", nan[0] <> nan[0]);

		# the bytes of an Int read as a Float are the same bits
		Check("Int bits as Float", Byte->ToFloats(Int->ToBytes([4609434218613702656]))[0] = 1.5);
	}

	method : Raises(what : String, kind : Int) ~ Nil {
		bytes := Byte->New[20];
		values := [1, 2, 3];
		floats := [1.0, 2.0];
		index := false;
		failed := false;
		try {
			if(kind = 0) {
				Int->ToBytes(values, 2, 2);
			}
			else if(kind = 1) {
				Int->ToBytes(values, -1, 1);
			}
			else if(kind = 2) {
				Int->ToBytes(values, 0, -1);
			}
			else if(kind = 3) {
				Byte->ToInts(bytes, 8, 2);
			}
			else if(kind = 4) {
				Byte->ToInts(bytes, -1, 1);
			}
			else if(kind = 5) {
				Byte->ToInts(bytes, 21, 0);
			}
			else if(kind = 6) {
				Byte->ToInts(bytes, 0, -3);
			}
			else if(kind = 7) {
				Byte->ToFloats(bytes, 0, Int->MaxSize());
			}
			else if(kind = 8) {
				Float->ToBytes(floats, 1, Int->MaxSize());
			}
			else if(kind = 9) {
				Byte->ToInts(bytes);
			};
		}
		on(e : IndexError) {
			index := true;
		}
		on(e : RuntimeError) {
			failed := true;
		};
		if(kind < 9) {
			Check("{$what} raises IndexError", index);
		}
		else {
			Check("{$what} raises RuntimeError", failed);
		};
	}

	method : Bounds() ~ Nil {
		Raises("Int->ToBytes past the end", 0);
		Raises("Int->ToBytes negative offset", 1);
		Raises("Int->ToBytes negative count", 2);
		Raises("Byte->ToInts past the end", 3);
		Raises("Byte->ToInts negative offset", 4);
		Raises("Byte->ToInts offset beyond size", 5);
		Raises("Byte->ToInts negative count", 6);
		Raises("Byte->ToFloats overflowing count", 7);
		Raises("Float->ToBytes overflowing count", 8);
		Raises("Byte->ToInts of 20 bytes", 9);

		raised := false;
		try {
			n : Int[];
			Int->ToBytes(n, 0, 0);
		}
		on(e : NilError) {
			raised := true;
		};
		Check("Nil array raises NilError", raised);
	}

	method : public : Run() ~ Nil {
		Ints();
		Floats();
		Bounds();

		if(@failures > 0) {
			"FAIL: {$@failures} check(s) failed"->PrintLine();
			Runtime->Exit(1);
		};
		"PASS: numeric arrays to and from bytes"->PrintLine();
	}
}

class Test {
	function : Main(args : String[]) ~ Nil {
		LangArrayBytes->New()->Run();
	}
}
