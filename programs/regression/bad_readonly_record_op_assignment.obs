# EXPECT_COMPILE_ERROR: Cannot assign to readonly record field outside constructor

record : readonly : Frozen {
    @x : Int;

    method : public : Bump() ~ Nil {
        @x += 1;
    }
}

class BadReadonlyRecordOpAssignment {
    function : Main(args : String[]) ~ Nil {
        Frozen->New(1)->Bump();
    }
}
