# EXTRA_LIBS: ml_vector,gen_collect
#~
System.ML.VectorSearch VectorIndex->Search over the whole index (k = the number of vectors, and
k larger than that) on 1 thread and on 64 threads: ids, scores and order must be identical, for
cosine, dot and L2, with copies of vectors under other ids so ties are decided by id. Each worker
scans one shard, so its heap is sized by the shard, not by k; with a large k the old sizing made
every one of 64 workers hold an n-sized heap.
~#
use System.ML.VectorSearch;
use Collection;

class MlVectorParallelFull {
	function : Row(flat : Float[], i : Int, dim : Int) ~ Float[] {
		v := Float->New[dim];
		Float->Copy(v, 0, flat, i * dim, dim);
		return v;
	}

	function : Describe(hits : Vector<VectorHit>) ~ String {
		out := "";
		each(i : hits) {
			out += "{$hits->Get(i)->GetId()}={$hits->Get(i)->GetScore()};";
		};
		return out;
	}

	function : Main(args : String[]) ~ Nil {
		dim := 16;
		n := 70000;
		vecs := Float->New[n * dim];
		state := 4242;
		each(i : n) {
			if(i % 50 = 49) {
				each(j : dim) { vecs[i * dim + j] := vecs[(i - 1) * dim + j]; };
			}
			else {
				each(j : dim) {
					state := (state * 1103515245 + 12345) and 2147483647;
					vecs[i * dim + j] := ((state / 65536) % 9 - 4)->As(Float);
				};
			};
		};

		queries := Float->New[2 * dim];
		total := 2 * dim;
		each(i : total) {
			state := (state * 1103515245 + 12345) and 2147483647;
			queries[i] := ((state / 65536) % 9 - 4)->As(Float);
		};

		metrics := [VectorMetric->COSINE, VectorMetric->DOT, VectorMetric->L2];
		names := ["cosine", "dot", "l2"];
		bad := 0;
		checks := 0;
		each(m : 3) {
			index := VectorIndex->New(dim, metrics[m]);
			each(i : n) {
				index->Add("id{$i}", Row(vecs, i, dim));
			};

			ks := [n, n + 1000];
			each(ki : 2) {
				each(q : 2) {
					index->SetThreads(1);
					hits1 := index->Search(Row(queries, q, dim), ks[ki]);
					index->SetThreads(64);
					hits64 := index->Search(Row(queries, q, dim), ks[ki]);
					checks += 1;
					if(hits1->Size() <> n | hits64->Size() <> n) {
						"FAIL: {$names[m]} k={$ks[ki]} q={$q}: sizes {$hits1->Size()} and {$hits64->Size()}, want {$n}"->PrintLine();
						bad += 1;
					}
					else if(<>Describe(hits1)->Equals(Describe(hits64))) {
						"FAIL: {$names[m]} k={$ks[ki]} q={$q}: 64 threads differ from 1"->PrintLine();
						bad += 1;
					};
				};
			};
		};

		if(bad > 0) {
			"FAIL: ml_vector_parallel_full, {$bad} failed"->PrintLine();
			Runtime->Exit(1);
		};
		"PASS: ml_vector_parallel_full ({$checks} checks)"->PrintLine();
	}
}
