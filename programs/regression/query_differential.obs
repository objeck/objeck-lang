# EXTRA_LIBS: net,regex,csv,misc,query
#~
Query.Structured differential test (docs/QUERY_DESIGN.md, "Testing"). Random tables (every
column type, empty cells, duplicate values, a column of mixed types) and random SQL queries
(select lists, distinct, where trees with and/or/parentheses/not, every operator, values of
every type, order by) run through the engine and through the simple row-at-a-time evaluator
below, which follows the rules the old engine used. The two must give the same rows in the
same order. A fixed set of seeds keeps the run repeatable.
~#
use Query.Structured, System.Time, Collection;

# one generated condition: a comparison, or 'and'/'or' over two
class Cond {
	@kind : Int;
	@column : String;
	@op : String;
	@negated : Bool;
	@value : Compare;
	@text : String;
	@left : Cond;
	@right : Cond;

	New(column : String, op : String, negated : Bool, value : Compare, text : String) {
		@kind := 0;
		@column := column;
		@op := op;
		@negated := negated;
		@value := value;
		@text := text;
	}

	New(kind : Int, left : Cond, right : Cond) {
		@kind := kind;
		@left := left;
		@right := right;
	}

	method : public : GetKind() ~ Int { return @kind; }
	method : public : GetColumn() ~ String { return @column; }
	method : public : GetOp() ~ String { return @op; }
	method : public : IsNegated() ~ Bool { return @negated; }
	method : public : GetValue() ~ Compare { return @value; }
	method : public : GetLeft() ~ Cond { return @left; }
	method : public : GetRight() ~ Cond { return @right; }

	method : public : ToSql() ~ String {
		if(@kind = 1) {
			return "(" + @left->ToSql() + " and " + @right->ToSql() + ")";
		}
		else if(@kind = 2) {
			return "(" + @left->ToSql() + " or " + @right->ToSql() + ")";
		};

		# a new string: '+=' appends in place, and @column is shared
		sql := String->New(@column);
		if(@negated) {
			sql += " not";
		};
		sql += " " + @op + " " + @text;
		return sql;
	}
}

class QueryDifferentialTest {
	@seed : static : Int;
	@failures : static : Int;
	@columns : static : String[];

	function : Next(bound : Int) ~ Int {
		@seed := (@seed * 6364136223846793005 + 1442695040888963407) and 0x7FFFFFFFFFFFFFFF;
		return (@seed >> 33) % bound;
	}

	function : Main(args : String[]) ~ Nil {
		@failures := 0;
		@columns := ["i", "f", "s", "o", "b", "d"];
		queries := 0;

		seeds := [7, 42, 1234, 99991];
		each(k : seeds) {
			@seed := seeds[k];
			table := BuildTable();
			each(q : 150) {
				sql := MakeQuery();
				if(sql <> Nil) {
					queries += 1;
					Compare(table, sql);
				};
			};
		};

		if(@failures = 0) {
			"PASS: query differential ({$queries} queries)"->PrintLine();
		}
		else {
			"FAIL: query differential ({$@failures} of {$queries} queries differ)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : BuildTable() ~ Table {
		table := Table->New("t", @columns);
		words := ["ant", "bee", "cat", "cow", "dog", "a_b", "a%c", "x.y"];
		rows := 30 + Next(30);
		each(r : rows) {
			row := table->Insert();
			if(Next(6) > 0) { row->Set("i", IntRef->New(Next(21) - 10)); };
			if(Next(6) > 0) { row->Set("f", FloatRef->New((Next(41) - 20)->As(Float) / 4.0)); };
			if(Next(6) > 0) { row->Set("s", words[Next(words->Size())]); };
			pick := Next(4);
			if(pick = 0) { row->Set("o", IntRef->New(Next(11) - 5)); }
			else if(pick = 1) { row->Set("o", words[Next(words->Size())]); }
			else if(pick = 2) { row->Set("o", FloatRef->New(Next(9)->As(Float) / 2.0)); };
			if(Next(6) > 0) { row->Set("b", BoolRef->New(Next(2) = 0)); };
			if(Next(6) > 0) { row->Set("d", Date->New(1 + Next(28), 1 + Next(12), 2018 + Next(4), 0, 0, 0, false)); };
		};

		# a few deletes, so the engine sees tombstones
		each(r : 3) {
			table->Delete(Next(rows));
		};

		return table;
	}

	function : MakeQuery() ~ String {
		sql := "select ";
		@pick_distinct := Next(8) = 0;
		if(@pick_distinct) {
			@distinct := @columns[Next(@columns->Size())];
			sql += "distinct " + @distinct;
		}
		else if(Next(2) = 0) {
			sql += "*";
			@select := Nil;
		}
		else {
			count := 1 + Next(3);
			@select := String->New[count];
			each(c : count) {
				@select[c] := @columns[Next(@columns->Size())];
				if(c > 0) {
					sql += ", ";
				};
				sql += @select[c];
			};
		};
		sql += " from t";

		@cond := Nil;
		if(Next(5) > 0) {
			@cond := MakeCond(0);
			sql += " where " + @cond->ToSql();
		};

		@order := Nil;
		if(Next(3) = 0) {
			@order := @columns[Next(@columns->Size())];
			sql += " order by " + @order;
		};

		return sql;
	}

	@pick_distinct : static : Bool;
	@distinct : static : String;
	@select : static : String[];
	@cond : static : Cond;
	@order : static : String;

	function : MakeCond(depth : Int) ~ Cond {
		if(depth < 3 & Next(3) = 0) {
			return Cond->New(1 + Next(2), MakeCond(depth + 1), MakeCond(depth + 1));
		};

		column := @columns[Next(@columns->Size())];
		ops := ["=", "<>", "<", "<=", ">", ">=", "like"];
		op := ops[Next(ops->Size())];
		negated := Next(5) = 0;

		value : Compare;
		text : String;
		kind := Next(6);
		if(op->Equals("like")) {
			patterns := ["a%", "%t", "_o_", "%", "a_b", "x.%", "%c%", "cat"];
			p := patterns[Next(patterns->Size())];
			value := p;
			text := "'" + p + "'";
		}
		else if(kind = 0) {
			v := Next(21) - 10;
			value := IntRef->New(v);
			text := v->ToString();
		}
		else if(kind = 1) {
			v := (Next(41) - 20)->As(Float) / 4.0;
			value := FloatRef->New(v);
			text := v->ToString();
			if(<>text->Has('.')) {
				text += ".0";
			};
		}
		else if(kind = 2) {
			words := ["ant", "cat", "dog", "zzz", "a_b"];
			w := words[Next(words->Size())];
			value := w;
			text := "'" + w + "'";
		}
		else if(kind = 3) {
			truth := Next(2) = 0;
			value := IntRef->New(truth ? 1 : 0);
			text := truth ? "true" : "false";
		}
		else {
			day := 1 + Next(28);
			month := 1 + Next(12);
			year := 2018 + Next(4);
			date := Date->New(day, month, year, 0, 0, 0, false);
			value := date;
			text := "#" + Pad(month) + "/" + Pad(day) + "/" + year->ToString() + "#";
		};

		return Cond->New(column, op, negated, value, text);
	}

	function : Pad(n : Int) ~ String {
		if(n < 10) {
			return "0" + n->ToString();
		};
		return n->ToString();
	}

	# --- the reference evaluator ---

	function : Compare(table : Table, sql : String) ~ Nil {
		got := table->Query(sql);
		want := Reference(table);
		got_text := "";
		if(got <> Nil) {
			got_text := Render(got);
		}
		else {
			got_text := "<error: ";
			got_text += table->GetError();
			got_text += ">";
		};
		if(<>got_text->Equals(want)) {
			@failures += 1;
			if(@failures <= 5) {
				"  DIFF: {$sql}"->PrintLine();
				"    engine:    {$got_text}"->PrintLine();
				"    reference: {$want}"->PrintLine();
			};
		};
	}

	function : Render(result : Table) ~ String {
		out := "";
		rows := result->GetAll();
		names := result->GetColumnNames();
		each(r : rows) {
			row := rows->Get(r);
			for(c := 1; c < names->Size(); c += 1;) {
				out += Text(row->Get(c));
				out += "|";
			};
			out += ";";
		};
		return out;
	}

	function : Text(value : Compare) ~ String {
		if(value = Nil) {
			return "-";
		}
		else if(value->TypeOf(IntRef)) {
			return value->As(IntRef)->Get()->ToString();
		}
		else if(value->TypeOf(FloatRef)) {
			return value->As(FloatRef)->Get()->ToString();
		}
		else if(value->TypeOf(BoolRef)) {
			return value->As(BoolRef)->Get() ? "T" : "F";
		}
		else if(value->TypeOf(Date)) {
			d := value->As(Date);
			return "{$(d->GetYear())}-{$(d->GetMonth())}-{$(d->GetDay())}";
		};
		return value->As(String);
	}

	function : Reference(table : Table) ~ String {
		rows := Vector->New()<Row>;
		all := table->GetAll();
		each(r : all) {
			row := all->Get(r);
			if(@cond = Nil | Holds(row, @cond)) {
				rows->AddBack(row);
			};
		};

		if(@pick_distinct) {
			kept := Vector->New()<Row>;
			each(r : rows) {
				value := rows->Get(r)->Get(@distinct);
				if(value <> Nil) {
					seen := false;
					each(k : kept) {
						if(<>seen & Same(kept->Get(k)->Get(@distinct), value)) {
							seen := true;
						};
					};
					if(<>seen) {
						kept->AddBack(rows->Get(r));
					};
				};
			};
			rows := kept;
		};

		if(@order <> Nil) {
			# a stable insertion sort
			size := rows->Size();
			sorted := Row->New[size];
			each(r : size) {
				row := rows->Get(r);
				at := r;
				# the element goes through a local: calling a method that returns an
				# interface type directly on an array element fails a cast at run time
				moving := true;
				while(at > 0 & moving) {
					before := sorted[at - 1];
					if(Order(before->Get(@order), row->Get(@order)) > 0) {
						sorted[at] := before;
						at -= 1;
					}
					else {
						moving := false;
					};
				};
				sorted[at] := row;
			};
			rows := Vector->New()<Row>;
			each(r : size) {
				rows->AddBack(sorted[r]);
			};
		};

		names := @select;
		if(@pick_distinct) {
			names := [@distinct];
		}
		else if(names = Nil) {
			names := @columns;
		};

		out := "";
		each(r : rows) {
			row := rows->Get(r);
			each(c : names) {
				out += Text(row->Get(names[c]));
				out += "|";
			};
			out += ";";
		};
		return out;
	}

	function : Same(a : Compare, b : Compare) ~ Bool {
		return Cmp(a, b) = 0;
	}

	function : Holds(row : Row, cond : Cond) ~ Bool {
		if(cond->GetKind() = 1) {
			return Holds(row, cond->GetLeft()) & Holds(row, cond->GetRight());
		}
		else if(cond->GetKind() = 2) {
			return Holds(row, cond->GetLeft()) | Holds(row, cond->GetRight());
		};

		cell := row->Get(cond->GetColumn());
		if(cell = Nil) {
			return false;
		};

		op := cond->GetOp();
		value := cond->GetValue();
		if(op->Equals("like")) {
			if(<>cell->TypeOf(String)) {
				return false;
			};
			matched := Like(cell->As(String), value->As(String));
			return cond->IsNegated() ? <>matched : matched;
		};

		if(cond->IsNegated()) {
			if(op->Equals("=")) { op := "<>"; }
			else if(op->Equals("<>")) { op := "="; }
			else if(op->Equals("<")) { op := ">="; }
			else if(op->Equals("<=")) { op := ">"; }
			else if(op->Equals(">")) { op := "<="; }
			else { op := "<"; };
		};

		result := Cmp(cell, value);
		if(result = 2) {
			return op->Equals("<>");
		};

		if(op->Equals("=")) { return result = 0; };
		if(op->Equals("<>")) { return result <> 0; };
		if(op->Equals("<")) { return result < 0; };
		if(op->Equals("<=")) { return result <= 0; };
		if(op->Equals(">")) { return result > 0; };
		return result >= 0;
	}

	# -1, 0, 1, or 2 when the two cannot be ordered against each other
	function : Cmp(a : Compare, b : Compare) ~ Int {
		if(a = Nil | b = Nil) {
			return 2;
		};

		if(IsNumber(a) & IsNumber(b)) {
			x := Number(a);
			y := Number(b);
			if(a->TypeOf(IntRef) & b->TypeOf(IntRef)) {
				i := a->As(IntRef)->Get();
				j := b->As(IntRef)->Get();
				return i < j ? -1 : (i > j ? 1 : 0);
			};
			return x < y ? -1 : (x > y ? 1 : 0);
		};

		# a Bool cell against the words true and false, which arrive as 1 and 0
		if(a->TypeOf(BoolRef) & b->TypeOf(IntRef)) {
			n := b->As(IntRef)->Get();
			if(n = 0 | n = 1) {
				m := a->As(BoolRef)->Get() ? 1 : 0;
				return m < n ? -1 : (m > n ? 1 : 0);
			};
			return 2;
		};

		if(a->TypeOf(String) & b->TypeOf(String)) {
			c := a->As(String)->Compare(b->As(String));
			return c < 0 ? -1 : (c > 0 ? 1 : 0);
		};

		if(a->TypeOf(Date) & b->TypeOf(Date)) {
			x := Stamp(a->As(Date));
			y := Stamp(b->As(Date));
			return x < y ? -1 : (x > y ? 1 : 0);
		};

		if(a->TypeOf(BoolRef) & b->TypeOf(BoolRef)) {
			x := a->As(BoolRef)->Get() ? 1 : 0;
			y := b->As(BoolRef)->Get() ? 1 : 0;
			return x < y ? -1 : (x > y ? 1 : 0);
		};

		return 2;
	}

	# a date's fields as one sortable number
	function : Stamp(d : Date) ~ Int {
		return ((((d->GetYear() * 13 + d->GetMonth()) * 32 + d->GetDay()) * 24 + d->GetHours()) * 60 + d->GetMinutes()) * 60 + d->GetSeconds();
	}

	function : IsNumber(v : Compare) ~ Bool {
		return v->TypeOf(IntRef) | v->TypeOf(FloatRef);
	}

	function : Number(v : Compare) ~ Float {
		if(v->TypeOf(IntRef)) {
			return v->As(IntRef)->Get()->As(Float);
		};
		return v->As(FloatRef)->Get();
	}

	# order by: numbers, then strings, then dates, then the rest, empty cells last
	function : Order(a : Compare, b : Compare) ~ Int {
		ra := Rank(a);
		rb := Rank(b);
		if(ra <> rb) {
			return ra < rb ? -1 : 1;
		};
		if(a = Nil) {
			return 0;
		};
		result := Cmp(a, b);
		return result = 2 ? 0 : result;
	}

	function : Rank(v : Compare) ~ Int {
		if(v = Nil) {
			return 4;
		}
		else if(IsNumber(v)) {
			return 0;
		}
		else if(v->TypeOf(String)) {
			return 1;
		}
		else if(v->TypeOf(Date)) {
			return 2;
		};
		return 3;
	}

	function : Like(s : String, p : String) ~ Bool {
		return LikeAt(s, 0, p, 0);
	}

	function : LikeAt(s : String, i : Int, p : String, j : Int) ~ Bool {
		if(j = p->Size()) {
			return i = s->Size();
		};

		c := p->Get(j);
		if(c = '%') {
			for(k := i; k <= s->Size(); k += 1;) {
				if(LikeAt(s, k, p, j + 1)) {
					return true;
				};
			};
			return false;
		};

		if(i < s->Size() & (c = '_' | c = s->Get(i))) {
			return LikeAt(s, i + 1, p, j + 1);
		};

		return false;
	}
}
