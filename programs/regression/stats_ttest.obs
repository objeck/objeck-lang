		ok := Near("big one-sample mu=5.3 ci high", r->GetCiHigh(), -0.17386567731982083, 1.0e-9) & ok;
		ok := Near("big one-sample mu=5.3 d", r->GetCohenD(), -0.10347277586304952, 1.0e-9) & ok;
		ok := Near("big one-sample mu=5.3 g", r->GetHedgesG(), -0.10343394849596099, 1.0e-9) & ok;
		pa := Float->New[2000];
		pb := Float->New[2000];
		each(i : 2000) { pa[i] := a[i]; pb[i] := b[i]; };
		r := TTest->Paired(pa, pb);
		ok := Near("big paired t", r->GetT(), -3.460393414858836, 1.0e-9) & ok;
		ok := Near("big paired df", r->GetDf(), 1999.0, 1.0e-9) & ok;
		ok := Near("big paired p", r->GetP(), 0.0005507089098610743, 1.0e-9) & ok;
		ok := Near("big paired diff", r->GetMeanDiff(), -0.3283611111111111, 1.0e-9) & ok;
		ok := Near("big paired ci low", r->GetCiLow(), -0.5144572516884128, 1.0e-9) & ok;
		ok := Near("big paired ci high", r->GetCiHigh(), -0.1422649705338094, 1.0e-9) & ok;
		ok := Near("big paired d_z", r->GetCohenD(), -0.07737674904516988, 1.0e-9) & ok;
		ok := Near("big paired mean1", r->GetMean1(), 4.99825, 1.0e-9) & ok;
		a := Seq(30, 31, 3, 17, 3.0);
		b := Seq(200, 47, 19, 89, 6.0);
		r := TTest->TwoSample(a, b, 0.95);
		ok := Report("unequal student level 0.95: valid", r->IsValid()) & ok;
		ok := Near("unequal student level 0.95 t", r->GetT(), -6.016511656197407, 1.0e-9) & ok;
		ok := Near("unequal student level 0.95 df", r->GetDf(), 228.0, 1.0e-9) & ok;
		ok := Near("unequal student level 0.95 p", r->GetP(), 7.038309073509876e-9, 1.0e-9) & ok;
		ok := Near("unequal student level 0.95 diff", r->GetMeanDiff(), -4.763611111111111, 1.0e-9) & ok;
		ok := Near("unequal student level 0.95 ci low", r->GetCiLow(), -6.323706122989642, 1.0e-9) & ok;
		ok := Near("unequal student level 0.95 ci high", r->GetCiHigh(), -3.203516099232581, 1.0e-9) & ok;
		ok := Near("unequal student level 0.95 cohen d", r->GetCohenD(), -1.1779668131365608, 1.0e-9) & ok;
		ok := Near("unequal student level 0.95 hedges g", r->GetHedgesG(), -1.1740869584140172, 1.0e-9) & ok;
		r := TTest->TwoSample(a, b, 0.99);
		ok := Report("unequal student level 0.99: valid", r->IsValid()) & ok;
		ok := Near("unequal student level 0.99 t", r->GetT(), -6.016511656197407, 1.0e-9) & ok;
		ok := Near("unequal student level 0.99 df", r->GetDf(), 228.0, 1.0e-9) & ok;
		ok := Near("unequal student level 0.99 p", r->GetP(), 7.038309073509876e-9, 1.0e-9) & ok;
		ok := Near("unequal student level 0.99 diff", r->GetMeanDiff(), -4.763611111111111, 1.0e-9) & ok;
		ok := Near("unequal student level 0.99 ci low", r->GetCiLow(), -6.82024888820313, 1.0e-9) & ok;
		ok := Near("unequal student level 0.99 ci high", r->GetCiHigh(), -2.706973334019093, 1.0e-9) & ok;
		ok := Near("unequal student level 0.99 cohen d", r->GetCohenD(), -1.1779668131365608, 1.0e-9) & ok;
		ok := Near("unequal student level 0.99 hedges g", r->GetHedgesG(), -1.1740869584140172, 1.0e-9) & ok;
		r := TTest->Welch(a, b, 0.95);
		ok := Report("unequal welch level 0.95: valid", r->IsValid()) & ok;
		ok := Near("unequal welch level 0.95 t", r->GetT(), -11.031785067801234, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.95 df", r->GetDf(), 98.6595215705155, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.95 p", r->GetP(), 6.508780328382508e-19, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.95 diff", r->GetMeanDiff(), -4.763611111111111, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.95 ci low", r->GetCiLow(), -5.620448096502083, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.95 ci high", r->GetCiHigh(), -3.906774125720139, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.95 cohen d", r->GetCohenD(), -1.1779668131365608, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.95 hedges g", r->GetHedgesG(), -1.1740869584140172, 1.0e-9) & ok;
		r := TTest->Welch(a, b, 0.99);
		ok := Report("unequal welch level 0.99: valid", r->IsValid()) & ok;
		ok := Near("unequal welch level 0.99 t", r->GetT(), -11.031785067801234, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.99 df", r->GetDf(), 98.6595215705155, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.99 p", r->GetP(), 6.508780328382508e-19, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.99 diff", r->GetMeanDiff(), -4.763611111111111, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.99 ci low", r->GetCiLow(), -5.897790291988786, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.99 ci high", r->GetCiHigh(), -3.6294319302334372, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.99 cohen d", r->GetCohenD(), -1.1779668131365608, 1.0e-9) & ok;
		ok := Near("unequal welch level 0.99 hedges g", r->GetHedgesG(), -1.1740869584140172, 1.0e-9) & ok;
		r := TTest->TwoSample(a, b);
		ok := Near("unequal student default level ci low", r->GetCiLow(), -6.323706122989641, 1.0e-9) & ok;
		ok := Report("unequal default level is 0.95 and sizes are kept", r->GetLevel() = 0.95 & r->GetN1() = 30 & r->GetN2() = 200) & ok;
		r := TTest->OneSample(a, 0.0);
		ok := Near("unequal one-sample mu=0.0 t", r->GetT(), 8.297919966052705, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=0.0 df", r->GetDf(), 29.0, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=0.0 p", r->GetP(), 3.792128917170306e-9, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=0.0 diff", r->GetMeanDiff(), 2.555555555555555, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=0.0 ci low", r->GetCiLow(), 1.925675055897584, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=0.0 ci high", r->GetCiHigh(), 3.185436055213526, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=0.0 d", r->GetCohenD(), 1.514985981926523, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=0.0 g", r->GetHedgesG(), 1.4754069498129463, 1.0e-9) & ok;
		r := TTest->OneSample(a, 2.9);
		ok := Near("unequal one-sample mu=2.9 t", r->GetT(), -1.1184152997723231, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=2.9 df", r->GetDf(), 29.0, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=2.9 p", r->GetP(), 0.27256890315102594, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=2.9 diff", r->GetMeanDiff(), -0.344444444444445, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=2.9 ci low", r->GetCiLow(), -0.974324944102416, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=2.9 ci high", r->GetCiHigh(), 0.285436055213526, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=2.9 d", r->GetCohenD(), -0.2041937627814013, 1.0e-9) & ok;
		ok := Near("unequal one-sample mu=2.9 g", r->GetHedgesG(), -0.19885919758348444, 1.0e-9) & ok;
		pa := Float->New[30];
		pb := Float->New[30];
		each(i : 30) { pa[i] := a[i]; pb[i] := b[i]; };
		r := TTest->Paired(pa, pb);
		ok := Near("unequal paired t", r->GetT(), -6.053528731355645, 1.0e-9) & ok;
		ok := Near("unequal paired df", r->GetDf(), 29.0, 1.0e-9) & ok;
		ok := Near("unequal paired p", r->GetP(), 1.3753842911076743e-6, 1.0e-9) & ok;
		ok := Near("unequal paired diff", r->GetMeanDiff(), -4.922222222222221, 1.0e-9) & ok;
		ok := Near("unequal paired ci low", r->GetCiLow(), -6.585231557902493, 1.0e-9) & ok;
		ok := Near("unequal paired ci high", r->GetCiHigh(), -3.259212886541948, 1.0e-9) & ok;
		ok := Near("unequal paired d_z", r->GetCohenD(), -1.1052180795563724, 1.0e-9) & ok;
		ok := Near("unequal paired mean1", r->GetMean1(), 2.555555555555555, 1.0e-9) & ok;
		a := Seq(8, 37, 11, 23, 4.0);
		ok := Near("mean", Stats->Mean(a), 2.78125, 1.0e-9) & ok;
		ok := Near("variance", Stats->Variance(a), 2.8828125, 1.0e-9) & ok;
		ok := Near("population variance", Stats->PopulationVariance(a), 2.5224609375, 1.0e-9) & ok;
		ok := Near("std dev", Stats->StdDev(a), 1.6978847134007655, 1.0e-9) & ok;
		ok := Near("std error", Stats->StdError(a), 0.6002928972593294, 1.0e-9) & ok;
		ok := Near("median", Stats->Median(a), 2.875, 1.0e-9) & ok;
		b := Seq(12, 29, 5, 31, 5.0);
		cb := Float->New[8];
		each(i : 8) { cb[i] := b[i]; };
		ok := Near("covariance", Stats->Covariance(a, cb), 0.6187499999999998, 1.0e-9) & ok;
		ok := Near("sum", Stats->Sum(a), 22.25, 1.0e-9) & ok;

		if(ok = false) {
			Runtime->Exit(1);
		};
		"stats_ttest: ok"->PrintLine();
	}

	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};
		return passed;
	}

	# relative tolerance, with a floor so an expected 0 can be matched
	function : Near(name : String, actual : Float, expected : Float, tol : Float) ~ Bool {
		diff := Float->Abs(actual - expected);
		limit := tol * Float->Abs(expected);
		if(limit < 1.0e-14) {
			limit := 1.0e-14;
		};
		good := diff <= limit;
		if(good = false) {
			"    {$name}: got {$actual}, expected {$expected}"->PrintLine();
		};
		return Report(name, good);
	}

	function : Seq(n : Int, a : Int, b : Int, m : Int, div : Float) ~ Float[] {
		out := Float->New[n];
		each(i : n) {
			out[i] := ((i * a + b) % m)->As(Float) / div;
		};
		return out;
	}
}
