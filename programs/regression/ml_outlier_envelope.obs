	function : FlaggedCounts() ~ Int[] {
		return [
			80, 200, 60];
	}

	function : FlaggedRows() ~ Int[] {
		return [
			356, 463, 611, 633, 720, 721, 722, 723, 724, 725, 726, 727, 729, 730, 731, 732,
			733, 734, 735, 736, 737, 738, 739, 740, 741, 742, 743, 744, 745, 746, 747, 748,
