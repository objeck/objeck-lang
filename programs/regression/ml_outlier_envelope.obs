		return [
			0.45493642311957283, 5.023886187314885, 1.3862943611198904, 7.377758908227866, 2.3659738843753395, 9.348403604496138,
			3.356693980033321, 11.14328678187779, 5.34812062744712, 14.449375335447915, 19.33742922942826, 34.169606902838325];
	}

	function : CaseSeeds() ~ Int[] {
		return [
			201, 301, 401];
	}

	function : CaseInliers() ~ Int[] {
		return [
			720, 1800, 540];
	}

	function : CaseOutliers() ~ Int[] {
		return [
			80, 200, 60];
	}

	function : CaseFeatures() ~ Int[] {
		return [
			3, 4, 8];
	}

	function : RawLogDets() ~ Float[] {
		return [
			-2.245992569958003, -2.616166445899447, -3.6892197286776063];
	}

