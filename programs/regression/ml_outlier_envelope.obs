		return [
			-0.013207752232460089, -0.1419468653679795, -0.07709352075079627, -0.028608455857842427, -0.011384970091333022, 0.046661818716796546,
			-0.01908143334782407, -0.05143792541558468, -0.07416100585927722, 0.008134308720711305, 0.014285207307511233, -0.05951099533106891,
