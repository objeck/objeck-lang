# EXTRA_LIBS: ml,gen_collect,csv
#~
System.ML EllipticEnvelope (FastMCD) against independent references.

* Chi-square quantiles against closed-form CDFs (1e-9).
* The MCD search on the larger-n paths -- 800 x 3 (subsets of 300 pooled on the
  full data), 2000 x 4 (pooled on 1500 rows, finished on the full data) and
  600 x 8 (the native matrix-product path), each 10% uniform outliers -- against a
  numpy MCD run from hundreds of random starts to convergence: within 0.005 of its
  log-determinant, reweighted location (0.05) and covariance (0.10), flagged rows
  at contamination 0.1 at most 2 apart. The 30-dataset n <= 500 comparison is
  ml_outlier_mcd.obs.
* The exact univariate MCD (sklearn's shortest-half algorithm) for one feature.
* Squared Mahalanobis distances against the native Matrix2D inverse.
Data is built by both sides from System.ML.Random with arithmetic only.
Regenerate with ml_outlier_ref/gen_fixtures.py.

Also: contamination and SetSensitivity, a constant feature, a singular
covariance refused with a reason, n <= p, NaN.
~#
use System.ML;

class MlOutlierEnvelope {
	function : Main(args : String[]) ~ Nil {
		ok := true;

		ok := ChiSquare() & ok;
		ok := Mcd() & ok;
		ok := Univariate() & ok;
		ok := Behaviour() & ok;
		ok := Edges() & ok;

		if(ok) {
			"PASS: ml_outlier_envelope"->PrintLine();
		}
		else {
			"FAIL: ml_outlier_envelope"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : ChiSquare() ~ Bool {
		dofs := [1, 2, 3, 4, 6, 20];
		expected := ExpectedChi2();
		passed := true;
		each(i : dofs) {
			med := EllipticEnvelope->ChiSquareQuantile(dofs[i], 0.5);
			hi := EllipticEnvelope->ChiSquareQuantile(dofs[i], 0.975);
			if(<>Near(med, expected[2 * i], 1.0e-9) | <>Near(hi, expected[2 * i + 1], 1.0e-9)) {
				"  chi2({$dofs[i]}): {$med} {$hi}"->PrintLine();
				passed := false;
			};
		};
		return Report("chi-square medians and 0.975 quantiles match closed forms (6 dof)", passed);
	}

	function : Mcd() ~ Bool {
		seeds := CaseSeeds();
		inliers := CaseInliers();
		outliers := CaseOutliers();
		features := CaseFeatures();
		logdets := RawLogDets();
		raw_loc := RawLocations();
		fin_loc := FinalLocations();
		fin_cov := FinalCovariances();
		counts := FlaggedCounts();
		flagged := FlaggedRows();

		loc_at := 0;
		cov_at := 0;
		flag_at := 0;
		optimal := 0;
		near_optimal := 0;
		final_close := 0;
		same_flags := 0;
		close_flags := 0;
		total := seeds->Size();
		each(c : seeds) {
			p := features[c];
			X := MakeData(seeds[c], inliers[c], outliers[c], p, 8.0);
			envelope := EllipticEnvelope->New(0.1, 0.0, 42);
			if(envelope->Fit(X)) {
				# FastMCD is a search heuristic and on Gaussian data many h-subsets are
				# near-ties, so it is held to within 0.005 of the many-start optimum's
				# log-determinant everywhere, and to the optimum itself on most of the
				# small datasets (sklearn's 30 random h-subsets reach it far less often)
				gap := LogDet(envelope->GetRawCovariance(), p) - logdets[c];
				if(gap <= 0.005) {
					near_optimal += 1;
				}
				else {
					"  seed {$seeds[c]}: log-determinant {$gap} above the reference"->PrintLine();
				};
				if(gap->Abs() <= 1.0e-9 & Matches(envelope->GetRawLocation(), raw_loc, loc_at, p, 1.0e-6)) {
					if(inliers[c] + outliers[c] <= 500) {
						optimal += 1;
					};
				}
				else {
					"  seed {$seeds[c]}: a near-tie optimum, log-determinant {$gap} from the reference"->PrintLine();
				};

				# the reweighted estimate, which is what scores rows
				if(Matches(envelope->GetLocation(), fin_loc, loc_at, p, 0.05) &
						Matches2(envelope->GetCovariance(), fin_cov, cov_at, p, 0.10)) {
					final_close += 1;
				}
				else {
					"  seed {$seeds[c]}: reweighted estimate differs from the reference"->PrintLine();
				};

				# the flagged rows at contamination 0.1
				labels := envelope->Predict(X);
				expected := Bool->New[labels->Size()];
				each(k : counts[c]) {
					expected[flagged[flag_at + k]] := true;
				};
				differ := 0;
				each(i : labels) {
					if(labels[i] <> expected[i]) {
						differ += 1;
					};
				};
				if(differ = 0) {
					same_flags += 1;
				}
				else {
					"  seed {$seeds[c]}: {$differ} rows flagged differently"->PrintLine();
				};
				if(differ <= 2) {
					close_flags += 1;
				};
			}
			else {
				"  seed {$seeds[c]}: fit failed"->PrintLine();
			};

			loc_at += p;
			cov_at += p * p;
			flag_at += counts[c];
		};

		passed := Report("the MCD search reaches within 0.005 of the optimum's log-determinant on {$near_optimal} of {$total}", near_optimal = total);
		passed := Report("reweighted location (0.05) and covariance (0.10) agree on {$final_close} of {$total}", final_close = total) & passed;
		passed := Report("the same rows are flagged on {$same_flags} of {$total}", same_flags >= total - 1) & passed;
		passed := Report("never more than 2 rows differ ({$close_flags} of {$total})", close_flags = total) & passed;
		return passed;
	}

	# log-determinant by Gaussian elimination with partial pivoting
	function : LogDet(m : Float[,], p : Int) ~ Float {
		a := Float->New[p, p];
		each(i : p) {
			each(j : p) {
				a[i, j] := m[i, j];
			};
		};
		total := 0.0;
		each(c : p) {
			pivot := c;
			for(r := c + 1; r < p; r += 1;) {
				if(a[r, c]->Abs() > a[pivot, c]->Abs()) {
					pivot := r;
				};
			};
			if(pivot <> c) {
				each(j : p) {
					tmp := a[c, j];
					a[c, j] := a[pivot, j];
					a[pivot, j] := tmp;
				};
			};
			total += Float->Log(a[c, c]->Abs());
			for(r := c + 1; r < p; r += 1;) {
				f := a[r, c] / a[c, c];
				for(j := c; j < p; j += 1;) {
					a[r, j] -= f * a[c, j];
				};
			};
		};
		return total;
	}

	function : Matches(got : Float[], expected : Float[], at : Int, p : Int, tol : Float) ~ Bool {
		each(j : p) {
			if(<>Near(got[j], expected[at + j], tol)) {
				return false;
			};
		};
		return true;
	}

	function : Matches2(got : Float[,], expected : Float[], at : Int, p : Int, tol : Float) ~ Bool {
		each(a : p) {
			each(b : p) {
				if(<>Near(got[a, b], expected[at + a * p + b], tol)) {
					return false;
				};
			};
		};
		return true;
	}

	function : Univariate() ~ Bool {
		X := MakeData(77, 90, 10, 1, 8.0);
		envelope := EllipticEnvelope->New(0.1, 0.0, 1);
		if(<>envelope->Fit(X)) {
			return Report("one feature fits", false);
		};

		passed := Report("univariate raw location is sklearn's shortest-half midpoint",
			Near(envelope->GetRawLocation()[0], UniRawLocation(), 1.0e-12));
		raw_cov := envelope->GetRawCovariance();
		passed := Report("univariate raw variance", Near(raw_cov[0, 0], UniRawVariance(), 1.0e-12)) & passed;
		passed := Report("univariate reweighted location", Near(envelope->GetLocation()[0], UniLocation(), 1.0e-12)) & passed;
		cov := envelope->GetCovariance();
		passed := Report("univariate reweighted variance", Near(cov[0, 0], UniVariance(), 1.0e-12)) & passed;
		passed := Report("univariate distances", Close(envelope->GetTrainingScores(), UniScores(), 1.0e-10)) & passed;
		return passed;
	}

	function : Behaviour() ~ Bool {
		X := MakeData(101, 180, 20, 3, 8.0);
		y := Labels(180, 20);
		envelope : OutlierDetector := EllipticEnvelope->New();
		flags := envelope->FitPredict(X);
		passed := Report("defaults fit (contamination 0.1)", flags <> Nil);
		if(flags = Nil) {
			return false;
		};

		n := Count(flags);
		passed := Report("contamination 0.1 flags 20 of 200 ({$n})", n = 20) & passed;
		auc := Metrics->AucRoc(envelope->GetTrainingScores(), y);
		passed := Report("distances feed AucRoc (AUC {$auc} > 0.95)", auc > 0.95) & passed;

		# squared Mahalanobis against an independent inverse (Eigen, native)
		e := envelope->As(EllipticEnvelope);
		mu := e->GetLocation();
		inverse := Matrix2D->Inverse(e->GetCovariance());
		scores := envelope->Score(X);
		mahal := true;
		each(i : 200) {
			d := 0.0;
			each(a : 3) {
				each(b : 3) {
					d += (X[i, a] - mu[a]) * inverse[a, b] * (X[i, b] - mu[b]);
				};
			};
			if(<>Near(scores[i], d, 1.0e-9)) {
				mahal := false;
			};
		};
		passed := Report("squared Mahalanobis distances match an independent inverse", mahal) & passed;

		# the sweep: contamination moves only the threshold
		counts := Int->New[3];
		settings := [0.01, 0.05, 0.10];
		each(s : settings) {
			envelope->SetSensitivity(settings[s]);
			counts[s] := Count(envelope->Predict(X));
		};
		passed := Report("0.01 < 0.05 < 0.10 in flags ({$counts[0]}, {$counts[1]}, {$counts[2]})",
			counts[0] < counts[1] & counts[1] < counts[2]) & passed;
		fresh := EllipticEnvelope->New(0.05, 0.0, 42);
		fresh->Fit(X);
		envelope->SetSensitivity(0.05);
		passed := Report("SetSensitivity equals a fresh fit", fresh->GetThreshold() = envelope->GetThreshold()) & passed;

		# determinism
		again := EllipticEnvelope->New(0.1, 0.0, 42);
		again->Fit(X);
		twice := EllipticEnvelope->New(0.1, 0.0, 42);
		twice->Fit(X);
		passed := Report("same seed, identical distances", Same(again->GetTrainingScores(), twice->GetTrainingScores())) & passed;

		fp := Fingerprint(scores);
		"  fingerprint: {$fp}"->PrintLine();

		dec := envelope->DecisionFunction(X);
		passed := Report("DecisionFunction is score - threshold", dec <> Nil & dec[0] = scores[0] - envelope->GetThreshold()) & passed;
		return passed;
	}

	function : Edges() ~ Bool {
		# a constant feature is left out: same distances as without it
		X := MakeData(102, 90, 10, 2, 8.0);
		W := Float->New[100, 3];
		each(i : 100) {
			W[i, 0] := X[i, 0];
			W[i, 1] := 7.0;
			W[i, 2] := X[i, 1];
		};
		plain := EllipticEnvelope->New(0.1, 0.0, 42);
		plain->Fit(X);
		wide := EllipticEnvelope->New(0.1, 0.0, 42);
		passed := Report("a constant feature fits", wide->Fit(W));
		passed := Report("and is left out of the distance", Close(wide->GetTrainingScores(), plain->GetTrainingScores(), 1.0e-12)) & passed;
		passed := Report("its location reports the constant", wide->GetLocation()[1] = 7.0) & passed;

		# collinear: column 2 = column 0 + column 1
		L := Float->New[100, 3];
		each(i : 100) {
			L[i, 0] := X[i, 0];
			L[i, 1] := X[i, 1];
			L[i, 2] := X[i, 0] + X[i, 1];
		};
		collinear := EllipticEnvelope->New();
		passed := Report("collinear features are refused", <>collinear->Fit(L)) & passed;
		passed := Report("with a reason that names singularity", collinear->GetError()->Has("singular")) & passed;

		# too few rows for the features
		few := EllipticEnvelope->New();
		passed := Report("n <= p is refused", <>few->Fit([[1.0, 2.0, 3.0], [2.0, 1.0, 0.0], [0.5, 0.5, 4.0]])) & passed;

		# most rows identical: the support is singular
		D := Float->New[60, 2];
		each(i : 60) {
			if(i < 45) {
				D[i, 0] := 1.0;
				D[i, 1] := 2.0;
			}
			else {
				D[i, 0] := i->As(Float);
				D[i, 1] := (i * i % 13)->As(Float);
			};
		};
		dup := EllipticEnvelope->New();
		passed := Report("75% duplicate rows are refused", <>dup->Fit(D) & dup->GetError()->Has("singular")) & passed;

		bad := MakeData(5, 30, 0, 2, 1.0);
		bad[3, 1] := Float->NaN();
		nan_fit := EllipticEnvelope->New();
		passed := Report("NaN is refused", <>nan_fit->Fit(bad) & nan_fit->GetError()->Has("row 3, column 1")) & passed;
		passed := Report("contamination 0 is refused", <>EllipticEnvelope->New(0.0, 0.0, 1)->Fit(X)) & passed;
		passed := Report("unfitted Score is Nil", EllipticEnvelope->New()->Score(X) = Nil) & passed;
		return passed;
	}

	function : Same(a : Float[], b : Float[]) ~ Bool {
		if(a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(a[i] <> b[i]) {
				return false;
			};
		};
		return true;
	}

	function : Count(flags : Bool[]) ~ Int {
		n := 0;
		each(i : flags) {
			if(flags[i]) {
				n += 1;
			};
		};
		return n;
	}

	function : Labels(n_in : Int, n_out : Int) ~ Bool[] {
		y := Bool->New[n_in + n_out];
		for(i := n_in; i < n_in + n_out; i += 1;) {
			y[i] := true;
		};
		return y;
	}

	function : Gauss(rng : System.ML.Random) ~ Float {
		acc := 0.0;
		each(k : 12) {
			acc += rng->NextReal();
		};
		return acc - 6.0;
	}

	function : MakeData(seed : Int, n_in : Int, n_out : Int, p : Int, spread : Float) ~ Float[,] {
		rng := System.ML.Random->New(seed);
		X := Float->New[n_in + n_out, p];
		z := Float->New[p];
		each(i : n_in) {
			each(j : p) {
				z[j] := Gauss(rng);
			};
			each(j : p) {
				v := z[j];
				if(j > 0) {
					v := v + 0.5 * z[j - 1];
				};
				X[i, j] := v;
			};
		};
		for(i := n_in; i < n_in + n_out; i += 1;) {
			each(j : p) {
				X[i, j] := rng->NextReal() * (2.0 * spread) - spread;
			};
		};
		return X;
	}

	function : Near(a : Float, b : Float, tol : Float) ~ Bool {
		scale := b->Abs();
		if(scale < 1.0) {
			scale := 1.0;
		};
		return (a - b)->Abs() <= tol * scale;
	}

	function : Close(a : Float[], b : Float[], tol : Float) ~ Bool {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(<>Near(a[i], b[i], tol)) {
				"  mismatch at {$i}: {$a[i]} vs {$b[i]}"->PrintLine();
				return false;
			};
		};
		return true;
	}

	# printed so runs under different -opt levels and JIT modes can be diffed: the
	# scores to 1e-12, folded into one integer
	function : Fingerprint(v : Float[]) ~ Int {
		total := 0;
		each(i : v) {
			total += (v[i] * 1000000000000.0)->As(Int) * (i % 7 + 1);
		};
		return total;
	}

	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};
		return passed;
	}

	# BEGIN GENERATED FIXTURE
	# by ml_outlier_ref/gen_fixtures.py; do not edit by hand
