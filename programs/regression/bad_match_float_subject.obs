# EXPECT_COMPILE_ERROR: (20,14): Expected integer or string expression
# EXPECT_ERROR_COUNT: 1
#~
The subject of a 'match' is what a 'select' takes: an Int, Char, Byte, enum or String.
~#
enum Color {
	Red,
	Green,
	Blue
}

enum Size {
	Small,
	Large
}

class BadMatchFloatSubject {
	function : Main(args : String[]) ~ Nil {
		f := 1.5;
		x := match f { 1 => "a", other => "b" };
		x->PrintLine();
	}
}
