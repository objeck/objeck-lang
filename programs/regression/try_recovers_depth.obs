#~
Try() -- and '?->', which is Try() on the chain -- recovers from a full call
stack, as it does from every other runtime error, interpreted or compiled.

It used to end the program even inside a guarded chain (#900): PushFrame's
overflow path was a bare exit(1). Recovery pops frames back to the handler's
depth, which is also what frees the call stack again after a runaway recursion.

The error is raised deep inside a called method rather than in the chain
expression itself, which is the case that matters: the handler is far below the
frame that fails.

Unguarded this still prints its message and exits 1; bad_runtime_stack.obs
covers the unguarded overflow.

Both ran interpreted only until the compiled call site tested the native stack
as well as the frame count (core/vm/call_stack.h): compiled recursion used to
overrun the native C stack before any frame-count guard could fire, and a
compiled call that found the frame array full printed and exited with no
status for a Try() to take. core_call_depth_max.obs covers the maximum itself.
~#

class Animal { New() {} }
class Dog from Animal { New() { Parent(); } }

class Holder {
	@animal : Animal;

	New(animal : Animal) {
		@animal := animal;
	}

	# runs the call stack out. The work after the call keeps the compiler's
	# tail-call pass from rewriting this into a loop, which would spin forever
	# instead of overflowing (the same trap bad_runtime_stack.obs names).
	method : public : Deep(n : Int) ~ Dog {
		deeper := Deep(n + 1);
		if(deeper = Nil) {
			return Nil;
		};

		return deeper;
	}
}

class TryRecoversDepth {
	function : Main(args : String[]) ~ Nil {
		ok := true;

		holder := Holder->New(Dog->New());

		deep := holder?->Deep(0);
		ok := Report("full call stack in a guarded chain yields Nil", deep = Nil) & ok;

		# the call stack is usable again
		again := holder?->Deep(0);
		ok := Report("the call stack is usable after recovery", again = Nil) & ok;

		if(<>ok) {
			Runtime->Exit(1);
		};
	}

	function : Report(name : String, ok : Bool) ~ Bool {
		if(ok) {
			"PASS: {$name}"->PrintLine();
			return true;
		};

		"FAIL: {$name}"->PrintLine();
		return false;
	}
}
