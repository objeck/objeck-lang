# EXPECT_COMPILE_ERROR: (27,3): Undefined variable: 't'
# EXPECT_ERROR_COUNT: 1
#~
The bound name belongs to the block of its 'if'.
~#
class Part {
	New() {
	}
}

class TextPart from Part {
	New() {
		Parent();
	}

	method : public : Size() ~ Int {
		return 4;
	}
}

class BadTypeTestNameAfterBlock {
	function : Main(args : String[]) ~ Nil {
		p : Part := TextPart->New();
		if(p is TextPart t) {
			t->Size()->PrintLine();
		};
		t->Size()->PrintLine();
	}
}
