# EXPECT_COMPILE_ERROR: (33,13): Cannot infer the type arguments of 'Either': its constructors make type parameter 'T' both 'System.String' and 'Widget'
# EXPECT_ERROR_COUNT: 1
#~
Two constructors take two arguments, and these arguments can be passed to
both: a String and a Widget are each a Base. The first makes T a String, the
second a Widget. Neither is preferred; the call is refused until the type
argument is written. (A constructor the arguments cannot be passed to is not
asked: generic_inference_viable_constructors.obs.)
~#
class Widget {
	New() {
	}
}

class Either<T> {
	@which : Int;

	New(left : T, right : Base) {
		@which := 1;
	}

	New(left : Base, right : T) {
		@which := 2;
	}

	method : public : Which() ~ Int {
		return @which;
	}
}

class BadGenericInferViableConflict {
	function : Main(args : String[]) ~ Nil {
		either := Either->New("left", Widget->New());
	}
}
