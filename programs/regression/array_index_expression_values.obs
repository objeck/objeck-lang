#~
One value is an index whatever kind of expression yields it, now that a whole
array is refused as an index for every kind (bad_index_whole_array_expression.obs).

The check that refuses `values[takeLeft ? left : right]` has to tell an array
from a value that came out of one: a '?:' whose branches are elements, an
element of a call's result or a call on an array; a 'match' value of elements;
the element or the value a '?->' call yields, with its '??' default; a call on
the array a '?:' chose. `values[k]` is `k * 10` here, so each check names the
element it should have read. Exits 1 on a mismatch.
~#
enum Slot {
	First,
	Second,
	Third
}

class Shelf {
	@idx : Int[];

	New() {
		@idx := Int->New[3];
		@idx[0] := 2;
		@idx[1] := 3;
		@idx[2] := 1;
	}

	method : public : Indices() ~ Int[] {
		return @idx;
	}

	method : public : One() ~ Int {
		return 1;
	}
}

class ArrayIndexExpressionValues {
	@fails : Int;

	function : Main(args : String[]) ~ Nil {
		test := ArrayIndexExpressionValues->New();
		test->Run();
	}

	New() {
		@fails := 0;
	}

	method : Check(name : String, got : Int, want : Int) ~ Nil {
		if(got <> want) {
			@fails += 1;
			"FAIL {$name}: {$got} (expected {$want})"->PrintLine();
		};
	}

	method : Run() ~ Nil {
		values := Int->New[6];
		each(i : 6) {
			values[i] := i * 10;
		};
		left := Int->New[2];
		left[0] := 4;
		left[1] := 5;
		right := Int->New[3];
		right[0] := 1;
		right[1] := 2;
		slots := Slot->New[2];
		slots[0] := Slot->Third;
		chars := Char->New[2];
		chars[0] := 3->As(Char);
		shelf := Shelf->New();
		none : Shelf;
		t := true;
		f := false;
		k := 1;

		Check("?: of elements, first", values[t ? left[0] : right[1]], 40);
		Check("?: of elements, second", values[f ? left[0] : right[1]], 20);
		Check("?: in parentheses", values[(f ? left[1] : right[0])], 10);
		Check("?: of a call's element and a literal", values[t ? shelf->Indices()[1] : 0], 30);
		Check("?: of an enum element and an item", values[t ? slots[0] : Slot->First], 20);
		Check("?: of a Char element and a literal", values[t ? chars[0] : 'a'], 30);
		Check("nested ?:", values[t ? (f ? left[0] : left[1]) : 0], 50);
		Check("Size() of the array a ?: chose", values[(t ? left : right)->Size()], 20);
		Check("Size() of the other", values[(f ? left : right)->Size()], 30);
		Check("match value of elements", values[match k { 0 => left[0], 1 => right[1], other => 0 }], 20);
		Check("match value of literals", values[match k { 1 => 5, other => 0 }], 50);
		Check("?-> element with a default", values[shelf?->Indices()[0] ?? 0], 20);
		Check("?-> element, Nil receiver", values[none?->Indices()[0] ?? 4], 40);
		Check("?-> value with a default", values[shelf?->One() ?? 0], 10);
		Check("?-> value, Nil receiver", values[none?->One() ?? 3], 30);
		Check("call index: ?: of elements", shelf->Indices()[t ? right[0] : right[1]], 3);
		Check("call index: match value", shelf->Indices()[match k { 1 => 2, other => 0 }], 1);

		if(@fails = 0) {
			"PASS: a value is an index whatever expression yields it"->PrintLine();
		}
		else {
			Runtime->Exit(1);
		};
	}
}
