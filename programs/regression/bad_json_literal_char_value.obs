# EXPECT_COMPILE_ERROR: (12,29): The value of a JSON member is a String, Int, Float, Bool, Nil, JsonElement, or a nested { } or [ ]; this one is Char
# EXPECT_ERROR_COUNT: 1
#~
A Char is not a JSON value: it is neither a string nor a number until the program says which.
~#
use Collection;
use Data.JSON;

class BadJsonLiteralCharValue {
	function : Main(args : String[]) ~ Nil {
		letter := 'q';
		request := json{"letter": letter};
		request->ToString()->PrintLine();
	}
}
