# EXTRA_LIBS: ml_timeseries,gen_collect
#~
System.ML.TimeSeries: edge cases and invariances.

Series shorter than the period, constant series, missing values (refused, then imputed), zeros under multiplicative
models, Nil and one-point inputs, and the properties any correct forecaster must have: adding a constant to the
series moves additive forecasts by that constant, scaling it scales them (and the intervals), fitting twice gives the
same answer, and a series with timestamps is the same as one without. The Nelder-Mead optimizer is checked on two
functions with known minima. Nothing here may end the program: every refusal is a return value. Deterministic and
offline. Run from programs/regression.
~#
use System.IO.Filesystem;
use Collection;
use System.ML.TimeSeries;

#~
Shared by the ml_timeseries_* tests: reads ml_timeseries_ref/expected.txt (written by gen_reference.py, which
uses statsmodels / scipy / hand-written numpy and never this library) and keeps the pass / fail tally.
~#
class TsRef {
	@m : Map<String, String>;
	@ok : Bool;
	@checks : Int;

	New() {
		@ok := true;
		@checks := 0;
		@m := Map->New()<String, String>;
		text := FileReader->ReadFile("ml_timeseries_ref/expected.txt");
		if(text = Nil) {
			"FAIL: ml_timeseries_ref/expected.txt is not readable (run from programs/regression)"->PrintLine();
			@ok := false;
			return;
		};

		lines := text->Split("\n");
		each(i : lines) {
			line := lines[i];
			if(line->Size() > 0 & line->Get(0) <> '#') {
				f := line->Split("|");
				if(f->Size() = 3) {
					@m->Insert("{$f[0]}|{$f[1]}", f[2]);
				}
				else if(f->Size() = 2) {
					@m->Insert("{$f[0]}|{$f[1]}", "");
				};
			};
		};
	}

	method : public : IsOk() ~ Bool {
		return @ok;
	}

	method : public : Checks() ~ Int {
		return @checks;
	}

	method : public : Check(name : String, cond : Bool) ~ Nil {
		@checks += 1;
		if(<>cond) {
			"FAIL: {$name}"->PrintLine();
			@ok := false;
		};
	}

	method : public : Get(name : String, key : String) ~ Float[] {
		k := "{$name}|{$key}";
		if(<>@m->Has(k)) {
			"FAIL: no reference value {$k}"->PrintLine();
			@ok := false;
			return Float->New[0];
		};

		text := @m->Find(k);
		if(text->Size() = 0) {
			return Float->New[0];
		};

		parts := text->Split(",");
		out := Float->New[parts->Size()];
		each(i : parts) {
			if(parts[i]->Equals("nan")) {
				out[i] := Float->NaN();
			}
			else {
				out[i] := parts[i]->ToFloat();
			};
		};

		return out;
	}

	method : public : One(name : String, key : String) ~ Float {
		v := Get(name, key);
		if(v->Size() = 0) {
			return Float->NaN();
		};

		return v[0];
	}

	# |a - b| <= tol * (1 + |b|); two NaNs are equal
	function : Near(a : Float, b : Float, tol : Float) ~ Bool {
		if(a <> a | b <> b) {
			return a <> a & b <> b;
		};

		d := a - b;
		if(d < 0.0) {
			d := -d;
		};

		return d <= tol * (1.0 + b->Abs());
	}

	# the largest |a[i] - b[i]| / (1 + |b[i]|), NaN positions must agree; 1e300 on a length mismatch
	function : MaxDiff(a : Float[], b : Float[]) ~ Float {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return 1.0e300;
		};

		worst := 0.0;
		each(i : b) {
			an := a[i] <> a[i];
			bn := b[i] <> b[i];
			if(an | bn) {
				if(an <> bn) {
					return 1.0e300;
				};
			}
			else {
				d := a[i] - b[i];
				if(d < 0.0) {
					d := -d;
				};
				d := d / (1.0 + b[i]->Abs());
				if(d > worst) {
					worst := d;
				};
			};
		};

		return worst;
	}

	# a named comparison of two arrays: passes when the largest relative difference is within tol
	method : public : Same(name : String, got : Float[], want : Float[], tol : Float) ~ Nil {
		d := MaxDiff(got, want);
		n := want->Size();
		ok := d <= tol;
		if(<>ok) {
			"FAIL: {$name}: {$n} values, max relative difference {$d} > {$tol}"->PrintLine();
		};
		Check(name, ok);
	}

	method : public : SameOne(name : String, got : Float, want : Float, tol : Float) ~ Nil {
		ok := Near(got, want, tol);
		if(<>ok) {
			"FAIL: {$name}: got {$got}, want {$want}"->PrintLine();
		};
		Check(name, ok);
	}

	# the first values of a series generated here must be the reference's (proves the generator is the same)
	method : public : Head(name : String, series : Float[]) ~ Nil {
		want := Get(name, "head");
		got := Float->New[want->Size()];
		each(i : got) {
			got[i] := series[i];
		};
		Same("series {$name}: generator matches the reference", got, want, 1.0e-12);
		Check("series {$name}: length", Near(series->Size()->As(Float), One(name, "n"), 0.0));
	}

	method : public : Finish(test : String) ~ Nil {
		c := @checks;
		if(@ok) {
			"{$test}: all {$c} checks passed"->PrintLine();
		}
		else {
			"FAIL: {$test}"->PrintLine();
			Runtime->Exit(1);
		};
	}
}

#~
The test series, generated by the library from fixed seeds. gen_reference.py generates the same ones.
~#
class TsData {
	@ar1 : Float[];
	@ar2 : Float[];
	@ma1 : Float[];
	@arma11 : Float[];
	@ts : Float[];
	@ms : Float[];
	@rw : Float[];

	New() {
		@ar1 := Simulate->Arma([0.7], Nil, 0.0, 1.0, 400, 11);
		@ma1 := Simulate->Arma(Nil, [0.6], 0.0, 1.0, 500, 12);
		@arma11 := Simulate->Arma([0.5], [0.4], 2.0, 1.0, 600, 13);
		@ar2 := Simulate->Arma([0.5, -0.3], Nil, 0.0, 1.0, 500, 14);
		@ts := Simulate->TrendSeasonal(120, 20.0, 0.3, 5.0, 12, 0.5, 15);
		@ms := Simulate->MultSeasonal(120, 40.0, 0.2, 0.25, 12, 0.02, 16);
		@rw := Simulate->RandomWalk(200, 0.3, 1.0, 17);
	}

	method : public : Get(name : String) ~ Float[] {
		if(name->Equals("ar1")) {
			return @ar1;
		};
		if(name->Equals("ar2")) {
			return @ar2;
		};
		if(name->Equals("ma1")) {
			return @ma1;
		};
		if(name->Equals("arma11")) {
			return @arma11;
		};
		if(name->Equals("ts")) {
			return @ts;
		};
		if(name->Equals("ms")) {
			return @ms;
		};

		return @rw;
	}

	method : public : Names() ~ String[] {
		return ["ar1", "ar2", "ma1", "arma11", "ts", "ms", "rw"];
	}
}


class Quadratic implements Objective {
	New() {
	}

	method : public : Evaluate(x : Float[]) ~ Float {
		a := x[0] - 3.0;
		b := x[1] + 1.5;
		return a * a + 2.0 * b * b + 4.0;
	}
}

class Rosenbrock implements Objective {
	New() {
	}

	method : public : Evaluate(x : Float[]) ~ Float {
		a := 1.0 - x[0];
		b := x[1] - x[0] * x[0];
		return a * a + 100.0 * b * b;
	}
}

class MlTimeseriesEdges {
	function : Main(args : String[]) ~ Nil {
		t := TsRef->New();
		if(t->IsOk()) {
			Optimizer(t);
			ShortSeries(t);
			ConstantSeries(t);
			MissingValues(t);
			ZeroValues(t);
			Invariances(t);
			NilInputs(t);
			LongHorizon(t);
		};
		t->Finish("ml_timeseries_edges");
	}

	function : Optimizer(t : TsRef) ~ Nil {
		nm := NelderMead->New();
		x := nm->Minimize(Quadratic->New(), [0.0, 0.0], 1.0, 2000, 1.0e-14);
		t->Check("quadratic minimum at (3, -1.5): ({$x[0]}, {$x[1]})", (x[0] - 3.0)->Abs() < 1.0e-5 & (x[1] + 1.5)->Abs() < 1.0e-5);
		t->SameOne("quadratic minimum value 4", nm->GetValue(), 4.0, 1.0e-9);
		ev1 := nm->GetEvaluations();
		t->Check("evaluations are counted and within budget ({$ev1})", ev1 > 10 & ev1 <= 2010);
		best1 := nm->GetBest();
		t->Check("GetBest is the returned point", best1[0] = x[0] & best1[1] = x[1]);

		r := nm->Minimize(Rosenbrock->New(), [-1.2, 1.0], 0.5, 5000, 1.0e-16);
		t->Check("Rosenbrock minimum at (1, 1): ({$r[0]}, {$r[1]})", (r[0] - 1.0)->Abs() < 1.0e-3 & (r[1] - 1.0)->Abs() < 1.0e-3);

		# deterministic
		nm2 := NelderMead->New();
		x2 := nm2->Minimize(Quadratic->New(), [0.0, 0.0], 1.0, 2000, 1.0e-14);
		t->Check("the same start gives bit-identical results", x[0] = x2[0] & x[1] = x2[1] & ev1 = nm2->GetEvaluations());

		# a budget of 5 evaluations stops early and still returns the best point seen
		short := NelderMead->New();
		s := short->Minimize(Quadratic->New(), [0.0, 0.0], 1.0, 5, 1.0e-14);
		t->Check("a tiny budget stops early", short->GetEvaluations() <= 8 & s <> Nil);
	}

	function : ShortSeries(t : TsRef) ~ Nil {
		five := TimeSeries->New([3.0, 5.0, 4.0, 6.0, 5.0]);

		hw := ExponentialSmoothing->HoltWinters(12, false);
		t->Check("Holt-Winters on 5 points (period 12) is refused", <>hw->Fit(five) & hw->GetError()->Find("two full periods") > -1);
		sn := BaselineForecaster->New(BaselineForecaster->Kind->SEASONAL_NAIVE, 12);
		t->Check("seasonal naive on 5 points is refused", <>sn->Fit(five));
		sam := ArimaModel->New(1, 0, 0, 1, 12);
		t->Check("seasonal ARIMA on 5 points is refused", <>sam->Fit(five));
		t->Check("decomposition with period 12 on 5 points is refused", <>SeriesTransform->Decompose([3.0, 5.0, 4.0, 6.0, 5.0], 12, false)->IsValid());
		t->Check("autocorrelation with too many lags is Nil", Acf->Compute([3.0, 5.0, 4.0, 6.0, 5.0], 5) = Nil);

		# the largest period that fits: exactly two periods
		two := TimeSeries->New([1.0, 2.0, 3.0, 4.0, 2.0, 3.0, 4.0, 5.0]);
		h4 := ExponentialSmoothing->HoltWinters(4, false);
		t->Check("two full periods are enough", h4->Fit(two) & h4->Forecast(4, 0.9)->IsValid());
		t->Check("the decomposition of exactly two periods works", SeriesTransform->Decompose([1.0, 2.0, 3.0, 4.0, 2.0, 3.0, 4.0, 5.0], 4, false)->IsValid());

		# tiny series: baselines and simple smoothing work with 2 points
		two_pt := TimeSeries->New([1.0, 3.0]);
		t->Check("naive on 2 points", BaselineForecaster->New(BaselineForecaster->Kind->NAIVE)->Fit(two_pt));
		t->Check("SES on 2 points", ExponentialSmoothing->Simple()->Fit(two_pt));
		t->Check("Holt needs 3", <>ExponentialSmoothing->Holt(false)->Fit(two_pt));
		t->Check("ARIMA(1,0,0) on 2 points is refused", <>ArimaModel->New(1, 0, 0)->Fit(two_pt));
		one := TimeSeries->New([1.0]);
		t->Check("one point is refused by every model", <>BaselineForecaster->New(BaselineForecaster->Kind->MEAN)->Fit(one) & <>ExponentialSmoothing->Simple()->Fit(one) & <>ArimaModel->New(0, 0, 0)->Fit(one));
		t->Check("Diff of a 1-point series is Nil, of 2 points has 1 value", SeriesTransform->Diff([1.0], 1, 1) = Nil & SeriesTransform->Diff([1.0, 2.0], 1, 1)->Size() = 1);

		a := AutoArima->New();
		t->Check("AutoArima on a short series is refused with a reason", <>a->Fit(five) & a->GetError()->Size() > 0 & a->GetBest() = Nil);
		t->Check("and forecasting from it is refused", <>a->Forecast(2, 0.9)->IsValid());
		e := AutoEts->New(12, SelectionCriterion->Kind->AICC);
		t->Check("AutoEts on 5 points still fits the non-seasonal candidates", e->Fit(five) & e->GetCandidates()->Size() = 3);
	}

	function : ConstantSeries(t : TsRef) ~ Nil {
		c := Float->New[48];
		each(i : 48) {
			c[i] := 7.0;
		};
		series := TimeSeries->New(c);

		kinds := 5;
		names := ["Naive", "SeasonalNaive(12)", "Drift", "Mean", "MovingAverage(3)"];
		each(i : kinds) {
			b : BaselineForecaster;
			if(i = 0) {
				b := BaselineForecaster->New(BaselineForecaster->Kind->NAIVE);
			}
			else if(i = 1) {
				b := BaselineForecaster->New(BaselineForecaster->Kind->SEASONAL_NAIVE, 12);
			}
			else if(i = 2) {
				b := BaselineForecaster->New(BaselineForecaster->Kind->DRIFT);
			}
			else if(i = 3) {
				b := BaselineForecaster->New(BaselineForecaster->Kind->MEAN);
			}
			else {
				b := BaselineForecaster->New(BaselineForecaster->Kind->MOVING_AVERAGE, 3);
			};

			t->Check("{$names[i]} fits a constant series", b->Fit(series));
			f := b->Forecast(3, 0.9);
			m := f->GetMean();
			lo := f->GetLower();
			hi := f->GetUpper();
			t->Check("{$names[i]} forecasts the constant with a zero-width interval", m[0] = 7.0 & m[2] = 7.0 & lo[0] = 7.0 & hi[2] = 7.0);
		};

		# simple, Holt and additive / multiplicative Holt-Winters all fit a constant exactly
		ses := ExponentialSmoothing->Simple();
		t->Check("SES fits a constant", ses->Fit(series) & ses->GetSse() < 1.0e-20);
		holt := ExponentialSmoothing->Holt(false);
		t->Check("Holt fits a constant with zero trend", holt->Fit(series) & holt->GetSse() < 1.0e-20);
		hf := holt->Forecast(5, 0.9)->GetMean();
		t->Check("and forecasts the constant ({$hf[4]})", (hf[4] - 7.0)->Abs() < 1.0e-9);
		hwa := ExponentialSmoothing->HoltWinters(12, false);
		t->Check("additive Holt-Winters fits a constant", hwa->Fit(series) & hwa->GetSse() < 1.0e-12);
		hwm := ExponentialSmoothing->HoltWinters(12, true);
		t->Check("multiplicative Holt-Winters fits a constant (all seasonal ratios 1)", hwm->Fit(series) & hwm->GetSse() < 1.0e-12);
		hmf := hwm->Forecast(12, 0.9)->GetMean();
		t->Check("and forecasts it", (hmf[11] - 7.0)->Abs() < 1.0e-6);

		# ARIMA refuses (the residual variance would be zero) but not by ending the program
		arima := ArimaModel->New(1, 0, 0);
		t->Check("ARIMA on a constant series is refused with a reason", <>arima->Fit(series) & arima->GetError()->Size() > 0);
		diff := ArimaModel->New(0, 1, 0);
		t->Check("so is a differenced one (the differences are all 0)", <>diff->Fit(series));

		# the helpers answer with Nil or NaN
		t->Check("ACF of a constant is Nil, PACF too", Acf->Compute(c, 3) = Nil & Acf->Partial(c, 3) = Nil);
		t->Check("Box-Cox lambda of a constant is NaN (no variance to maximize)", SeriesTransform->BoxCoxLambda(c) <> SeriesTransform->BoxCoxLambda(c));
		t->Check("rolling standard deviation of a constant is 0", SeriesTransform->RollingStd(c, 4)[10] = 0.0);
		dec := SeriesTransform->Decompose(c, 12, false);
		t->Check("decomposition of a constant is valid with a zero figure", dec->IsValid() & dec->GetFigure()[3] = 0.0);
		t->Check("its seasonal strength is undefined (NaN)", dec->SeasonalStrength() <> dec->SeasonalStrength());
		t->Check("SuggestDiff cannot test a constant series: -1", Stationarity->SuggestDiff(c, 2) = -1);

		auto := AutoArima->New(1, 1, 1, 1, SelectionCriterion->Kind->AICC);
		t->Check("AutoArima on a constant is refused", <>auto->Fit(series) & auto->GetError()->Size() > 0);
		ae := AutoEts->New();
		t->Check("AutoEts on a constant still returns a model", ae->Fit(series) & ae->Forecast(2, 0.9)->IsValid());
	}

	function : MissingValues(t : TsRef) ~ Nil {
		d := TsData->New();
		full := d->Get("ts");
		gappy := Float->Copy(full);
		gappy[20] := Float->NaN();
		gappy[21] := Float->NaN();
		gappy[77] := Float->NaN();
		series := TimeSeries->New(gappy);

		models := [ExponentialSmoothing->Simple()->As(Forecaster), BaselineForecaster->New(BaselineForecaster->Kind->NAIVE)->As(Forecaster), ArimaModel->New(1, 0, 0)->As(Forecaster), ExponentialSmoothing->HoltWinters(12, false)->As(Forecaster)];
		each(i : models) {
			m := models[i];
			ok := m->Fit(series);
			t->Check("{$m->GetName()} refuses a series with gaps and names the first one", <>ok & m->GetError()->Find("index 20") > -1 & <>m->IsFitted());
		};

		# after imputation the models fit, and the result is close to the one on the complete series
		fixed := series->Impute(TimeSeries->Missing->LINEAR);
		t->Check("the imputed series has no gaps", <>fixed->HasMissing() & fixed->Size() = 120);
		a := ExponentialSmoothing->HoltWinters(12, false);
		b := ExponentialSmoothing->HoltWinters(12, false);
		t->Check("Holt-Winters fits the imputed series", a->Fit(fixed) & b->Fit(TimeSeries->New(full)));
		fa := a->Forecast(12, 0.9)->GetMean();
		fb := b->Forecast(12, 0.9)->GetMean();
		worst := 0.0;
		each(i : 12) {
			dd := (fa[i] - fb[i])->Abs();
			if(dd > worst) {
				worst := dd;
			};
		};
		t->Check("forecasts from the imputed series are within 1.5 of the complete series' (worst {$worst}; noise sd is 0.5)", worst < 1.5);

		dropped := series->Impute(TimeSeries->Missing->DROP);
		t->Check("DROP shortens the series to 117 values", dropped->Size() = 117);
		arima := ArimaModel->New(1, 0, 0);
		t->Check("ARIMA fits a dropped series (the gap closes up)", arima->Fit(dropped));
		t->Check("ERROR policy cannot impute", series->Impute(TimeSeries->Missing->ERROR) = Nil);

		# Infinity is refused separately from NaN
		inf := Float->Copy(full);
		inf[5] := Float->Inf();
		ses := ExponentialSmoothing->Simple();
		t->Check("Infinity is refused ('non-finite')", <>ses->Fit(TimeSeries->New(inf)) & ses->GetError()->Find("non-finite") > -1);
		t->Check("the same value cannot be imputed away: Impute only handles NaN", TimeSeries->New(inf)->Impute(TimeSeries->Missing->LINEAR)->Check()->Size() > 0);
	}

	function : ZeroValues(t : TsRef) ~ Nil {
		x := Float->New[36];
		each(i : 36) {
			x[i] := 5.0 + (i % 12)->As(Float);
		};
		x[17] := 0.0;
		series := TimeSeries->New(x);

		hm := ExponentialSmoothing->HoltWinters(12, true);
		t->Check("a zero blocks multiplicative smoothing with a reason", <>hm->Fit(series) & hm->GetError()->Find("index 17") > -1);
		t->Check("and the multiplicative decomposition", <>SeriesTransform->Decompose(x, 12, true)->IsValid());
		t->Check("and Box-Cox and log", SeriesTransform->BoxCox(x, 0.5) = Nil & SeriesTransform->Log(x) = Nil);
		t->Check("but the additive Holt-Winters, additive decomposition and ARIMA are fine", ExponentialSmoothing->HoltWinters(12, false)->Fit(series) & SeriesTransform->Decompose(x, 12, false)->IsValid() & ArimaModel->New(1, 0, 0)->Fit(series));
		t->Check("a negative value blocks it too", <>ExponentialSmoothing->HoltWinters(12, true)->Fit(TimeSeries->New(NegAt(x, 3))));

		auto := AutoEts->New(12, SelectionCriterion->Kind->AICC);
		auto->Fit(series);
		t->Check("AutoEts leaves out the multiplicative candidates for a series with a zero (6 left)", auto->GetCandidates()->Size() = 6);

		# MAPE is undefined with a zero actual; sMAPE and MASE are not
		t->Check("MAPE is NaN with a zero actual, sMAPE is finite", ForecastMetrics->Mape(x, x) <> ForecastMetrics->Mape(x, x) & ForecastMetrics->Smape(x, x) = 0.0);
	}

	function : NegAt(x : Float[], i : Int) ~ Float[] {
		c := Float->Copy(x);
		c[i] := -2.0;

		return c;
	}

	function : Invariances(t : TsRef) ~ Nil {
		d := TsData->New();
		base := d->Get("ts");
		shifted := Float->New[base->Size()];
		scaled := Float->New[base->Size()];
		each(i : base) {
			shifted[i] := base[i] + 1000.0;
			scaled[i] := base[i] * 10.0;
		};

		# additive models are shift- and scale-equivariant
		names := ["SES", "Holt", "HoltWinters(add)", "ARIMA(1,0,0)D1", "ARIMA(2,1,0)"];
		each(i : names) {
			m0 := Model(i);
			m1 := Model(i);
			m2 := Model(i);
			t->Check("{$names[i]} fits all three", m0->Fit(TimeSeries->New(base)) & m1->Fit(TimeSeries->New(shifted)) & m2->Fit(TimeSeries->New(scaled)));
			f0 := m0->Forecast(10, 0.9);
			f1 := m1->Forecast(10, 0.9);
			f2 := m2->Forecast(10, 0.9);
			a0 := f0->GetMean();
			a1 := f1->GetMean();
			a2 := f2->GetMean();
			s0 := f0->GetSd();
			s1 := f1->GetSd();
			s2 := f2->GetSd();
			shift_ok := true;
			scale_ok := true;
			sd_ok := true;
			each(k : 10) {
				if(<>TsRef->Near(a1[k], a0[k] + 1000.0, 1.0e-6)) {
					shift_ok := false;
				};
				if(<>TsRef->Near(a2[k], a0[k] * 10.0, 1.0e-6)) {
					scale_ok := false;
				};
				if(<>TsRef->Near(s1[k], s0[k], 1.0e-4) | <>TsRef->Near(s2[k], s0[k] * 10.0, 1.0e-6)) {
					sd_ok := false;
				};
			};
			t->Check("{$names[i]}: forecasts move with a +1000 shift", shift_ok);
			t->Check("{$names[i]}: forecasts and intervals scale by 10", scale_ok & sd_ok);
		};

		# multiplicative Holt-Winters is scale-equivariant
		m := TimeSeries->New(d->Get("ms"));
		ms10 := Float->New[120];
		each(i : 120) {
			ms10[i] := d->Get("ms")[i] * 10.0;
		};
		h1 := ExponentialSmoothing->HoltWinters(12, true);
		h2 := ExponentialSmoothing->HoltWinters(12, true);
		t->Check("multiplicative Holt-Winters fits y and 10 y", h1->Fit(m) & h2->Fit(TimeSeries->New(ms10)));
		g1 := h1->Forecast(6, 0.9)->GetMean();
		g2 := h2->Forecast(6, 0.9)->GetMean();
		ok := true;
		each(k : 6) {
			if(<>TsRef->Near(g2[k], g1[k] * 10.0, 1.0e-5)) {
				ok := false;
			};
		};
		t->Check("multiplicative forecasts scale by 10", ok);

		# determinism and timestamps
		a := ArimaModel->New(1, 1, 1);
		b := ArimaModel->New(1, 1, 1);
		stamps := Int->New[base->Size()];
		each(i : base) {
			stamps[i] := 1700000000 + i * 86400;
		};
		t->Check("fits with and without timestamps", a->Fit(TimeSeries->New(base)) & b->Fit(TimeSeries->New(base, stamps)));
		t->Check("timestamps do not change the fit (bit-identical)", a->GetSse() = b->GetSse() & a->GetAr()[0] = b->GetAr()[0] & a->GetMa()[0] = b->GetMa()[0]);
		t->Check("the future timestamps of the series continue the day step", TimeSeries->New(base, stamps)->FutureTimestamps(2)[1] = 1700000000 + (base->Size() + 1) * 86400);

		# the input array is not modified by fitting
		copy := Float->Copy(base);
		ExponentialSmoothing->HoltWinters(12, false)->Fit(TimeSeries->New(base));
		same := true;
		each(i : base) {
			if(base[i] <> copy[i]) {
				same := false;
			};
		};
		t->Check("fitting leaves the caller's array alone", same);
	}

	function : Model(i : Int) ~ Forecaster {
		if(i = 0) {
			return ExponentialSmoothing->Simple();
		};
		if(i = 1) {
			return ExponentialSmoothing->Holt(false);
		};
		if(i = 2) {
			return ExponentialSmoothing->HoltWinters(12, false);
		};
		if(i = 3) {
			m := ArimaModel->New(1, 0, 0, 1, 12);
			m->SetIncludeMean(true);
			return m;
		};

		return ArimaModel->New(2, 1, 0);
	}

	function : NilInputs(t : TsRef) ~ Nil {
		models := [ExponentialSmoothing->Simple()->As(Forecaster), BaselineForecaster->New(BaselineForecaster->Kind->NAIVE)->As(Forecaster), ArimaModel->New(1, 0, 0)->As(Forecaster), AutoArima->New()->As(Forecaster), AutoEts->New()->As(Forecaster)];
		each(i : models) {
			m := models[i];
			t->Check("{$m->GetName()}: Fit(Nil) is refused", <>m->Fit(Nil) & m->GetError()->Size() > 0);
			t->Check("{$m->GetName()}: an empty series is refused", <>m->Fit(TimeSeries->New(Float->New[0])));
			t->Check("{$m->GetName()}: unfitted accessors are Nil or false", <>m->IsFitted() & m->GetFitted() = Nil);
		};

		t->Check("helpers on Nil return Nil / NaN, not a crash", SeriesTransform->Diff(Nil, 1, 1) = Nil & SeriesTransform->Log(Nil) = Nil & SeriesTransform->BoxCox(Nil, 0.5) = Nil & SeriesTransform->RollingMean(Nil, 2) = Nil & Acf->Compute(Nil, 1) = Nil & SeriesTransform->LagMatrix(Nil, 1) = Nil);
		t->Check("ForecastMetrics on Nil are NaN", ForecastMetrics->Mae(Nil, Nil) <> ForecastMetrics->Mae(Nil, Nil));
		t->Check("a Nil series in a TimeSeries->Slice stays safe", TimeSeries->New([1.0, 2.0])->Slice(-1, 1) = Nil);
	}

	function : LongHorizon(t : TsRef) ~ Nil {
		d := TsData->New();
		y := TimeSeries->New(d->Get("ts"));
		models := [ExponentialSmoothing->HoltWinters(12, false)->As(Forecaster), ArimaModel->New(1, 1, 1)->As(Forecaster), BaselineForecaster->New(BaselineForecaster->Kind->SEASONAL_NAIVE, 12)->As(Forecaster)];
		each(i : models) {
			m := models[i];
			m->Fit(y);
			f := m->Forecast(500, 0.95);
			mean := f->GetMean();
			sd := f->GetSd();
			lo := f->GetLower();
			hi := f->GetUpper();
			finite := f->Size() = 500;
			each(k : 500) {
				if(TsMath->IsBad(mean[k]) | TsMath->IsBad(sd[k]) | lo[k] > mean[k] | hi[k] < mean[k]) {
					finite := false;
				};
			};
			t->Check("{$m->GetName()}: 500-step forecast is finite with the mean inside its interval", finite);
		};
	}
}
