#~
Named arguments, phase 1 (#1244; docs/NAMED_ARGUMENTS_DESIGN.md).

`name: value` binds an argument to a parameter by name. Positional arguments
come first; named ones follow in any order. Any parameter that has a default
can be skipped, not only trailing ones.

A named call binds to a forwarder the compiler generates for its shape. The
forwarder takes the arguments in the order written, so they are evaluated
left to right as written. It assigns the skipped defaults in the callee, as
the default alternates do, and calls the original. Phase 1 covers the classes
of the program being compiled: functions, methods, constructors and Parent().
~#
class Point {
	@x : Int;
	@y : Int;

	New(x : Int, y : Int := 7) {
		@x := x;
		@y := y;
	}

	method : public : Show() ~ String {
		return "({$@x},{$@y})";
	}
}

class Shape {
	@w : Int;
	@h : Int;

	New(w : Int, h : Int := 1) {
		@w := w;
		@h := h;
	}

	method : public : Area(scale : Int := 1, offset : Int := 0) ~ Int {
		return @w * @h * scale + offset;
	}
}

class Box from Shape {
	New(w : Int, h : Int, d : Int := 2) {
		Parent(h: h, w: w);
	}
}

class Strings {
	function : Join(a : String, sep : String := ",", b : String := "?") ~ String {
		return "{$a}{$sep}{$b}";
	}
}

class NamedArguments {
	@failures : Int;
	@trace : String;

	New() {
		@failures := 0;
		@trace := "";
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: got '{$got}', want '{$want}'"->PrintLine();
			@failures += 1;
		};
	}

	function : Train(name : String, epochs : Int := 10, rate : Float := 0.5, verbose : Bool := false) ~ String {
		return "{$name} e={$epochs} r={$rate} v={$verbose}";
	}

	method : Mark(tag : String, v : Int) ~ Int {
		@trace += tag;
		return v;
	}

	method : Run() ~ Nil {
		# skipping defaults, not only trailing ones
		Check("all defaults", Train("a"), "a e=10 r=0.500000 v=false");
		Check("skip two to set the last", Train("b", verbose: true), "b e=10 r=0.500000 v=true");
		Check("named, out of order", Train("c", rate: 0.1, epochs: 50), "c e=50 r=0.100000 v=false");
		Check("every argument named", Train(name: "d", epochs: 3), "d e=3 r=0.500000 v=false");
		Check("a required parameter named last", Train(verbose: true, name: "e"), "e e=10 r=0.500000 v=true");

		# constructors, Parent(), instance methods, inherited methods, another class's functions
		Check("constructor, reordered", Point->New(y: 2, x: 1)->Show(), "(1,2)");
		Check("constructor, default kept", Point->New(x: 5)->Show(), "(5,7)");
		s := Shape->New(w: 3, h: 4);
		Check("instance method, skip the first", s->Area(offset: 5)->ToString(), "17");
		Check("instance method, reordered", s->Area(offset: 1, scale: 2)->ToString(), "25");
		Check("Parent() by name, inherited method", Box->New(2, 5)->Area(offset: 1)->ToString(), "11");
		Check("another class's function", Strings->Join("x", b: "y"), "x,y");
		Check("another class's function, reordered", Strings->Join(b: "z", a: "w", sep: "-"), "w-z");

		# arguments are evaluated in the order written, not the parameters' order
		@trace := "";
		Train("f", rate: Mark("1", 2)->ToFloat(), epochs: Mark("2", 1));
		Check("evaluated in written order", @trace, "12");

		# often enough for the JIT to compile callers and forwarders
		total := 0;
		for(i := 0; i < 2000; i += 1;) {
			total += s->Area(offset: i % 3, scale: 2);
		};
		Check("in a loop", total->ToString(), "49999");

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Main(args : String[]) ~ Nil {
		NamedArguments->New()->Run();
	}
}
