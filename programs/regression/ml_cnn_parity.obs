# EXTRA_LIBS: ml_cnn,ml,ml_lab,opencv,csv,gen_collect
#~
System.ML.Cnn against PyTorch.

data/cnn_parity/*.txt are written by tools/ml/cnn_parity.py from PyTorch (float32, CPU): for each
case an architecture, the weights and inputs, and what PyTorch computed from them. This test builds
the same architecture, loads the same weights and compares, for every case: the loss, the logits,
every parameter gradient, the gradient with respect to the input, and the output of each layer the
case lists. The cases cover each layer type alone (valid and "same" convolution, an even kernel,
stride 2, a 1x1 kernel, ReLU, max pooling with an odd size and with overlapping windows, dense,
dropout in evaluation mode) and the baseline network (three Conv 3x3 + ReLU + MaxPool blocks with
16, 32 and 64 filters, Dense 128, dropout, Dense 1) at 32 x 32.

train_baseline32 is the training comparison: identical initial weights, identical batches in
identical order, 20 Adam steps, and the loss of every step and the final weights compared.

Tolerance. Each comparison is max |ours - torch| divided by max |torch| over that tensor, so it
is relative to the tensor's scale and a gradient entry near zero does not dominate. Both sides
work in float32, but they sum in different orders (Eigen's blocked matrix multiply against
PyTorch's), which costs a few ulps (2e-7 each) per accumulation of up to 2304 products. A single
layer is allowed 2e-5 and the whole network 2e-4. The training loss curve is allowed 1e-3 per
step: Adam divides by sqrt(v), so a gradient entry that is tiny in both implementations can differ
in sign-level noise and move the weights by more than the gradient difference, and the error of
one step is the input of the next.
~#

use System.ML.Cnn;
use System.IO.Filesystem;
use Collection;

class MlCnnParity {
	@fail : static : Bool;

	function : Main(args : String[]) ~ Nil {
		names := ["conv3_valid", "conv3_same", "conv4_same_even", "conv5_stride2", "conv1x1", "relu",
			"maxpool2_odd", "maxpool3_stride2", "dense_stack", "dropout_eval", "baseline32"];
		tols := [2.0e-5, 2.0e-5, 2.0e-5, 2.0e-5, 2.0e-5, 2.0e-5, 2.0e-5, 2.0e-5, 2.0e-5, 2.0e-5, 2.0e-4];
		@fail := false;
		each(i : names) {
			Forward(names[i], tols[i]);
		};
		Train("train_baseline32", 1.0e-3, 1.0e-3);

		if(@fail) {
			Runtime->Exit(1);
		};
		"ml_cnn_parity: ok"->PrintLine();
	}

	function : Report(name : String, ok : Bool) ~ Nil {
		if(ok = false) {
			"  FAIL: {$name}"->PrintLine();
			@fail := true;
		};
	}

	# max |a - b| / max |b|, or 9.0 for arrays that are missing or differ in length
	function : Diff(a : Float[], b : Float[]) ~ Float {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return 9.0;
		};

		scale := 0.0;
		worst := 0.0;
		each(i : b) {
			scale := Float->Max(scale, Float->Abs(b[i]));
			worst := Float->Max(worst, Float->Abs(a[i] - b[i]));
		};

		return worst / Float->Max(scale, 1.0e-12);
	}

	# the file as tensors: name -> values, plus the architecture line and the optional `train` line
	function : Load(name : String, tensors : Hash<String, FloatArrayRef>, header : String[]) ~ Bool {
		path := "data/cnn_parity/{$name}.txt";
		if(<>File->Exists(path)) {
			"  FAIL: {$path} is missing"->PrintLine();
			return false;
		};

		lines := FileReader->ReadFile(path)->Split("\n");
		header[0] := lines[0];
		header[1] := "";
		i := 1;
		while(i < lines->Size()) {
			parts := lines[i]->SplitWhitespace();
			if(parts->Size() = 5 & parts[0]->Equals("train")) {
				header[1] := lines[i];
				i += 1;
			}
			else if(parts->Size() = 3 & parts[0]->Equals("tensor")) {
				count := parts[2]->ToInt();
				values := Float->New[count];
				each(k : count) {
					values[k] := lines[i + 1 + k]->ToFloat();
				};
				tensors->Insert(parts[1], FloatArrayRef->New(values));
				i += count + 1;
			}
			else {
				i += 1;
			};
		};

		return true;
	}

	# "arch C H W | conv F K S valid | relu | ..." -> a compiled model with those layers
	function : Build(arch : String, lr : Float) ~ CnnModel {
		parts := arch->Split("|");
		dims := parts[0]->SplitWhitespace();
		model := CnnModel->New(dims[1]->ToInt(), dims[2]->ToInt(), dims[3]->ToInt(), 1);
		ok := true;
		for(i := 1; i < parts->Size(); i += 1;) {
			t := parts[i]->SplitWhitespace();
			kind := t[0];
			if(kind->Equals("conv")) {
				padding := t[4]->Equals("same") ? Padding->SAME : Padding->VALID;
				ok := ok & model->AddConv(t[1]->ToInt(), t[2]->ToInt(), t[3]->ToInt(), padding);
			}
			else if(kind->Equals("relu")) {
				ok := ok & model->AddReLU();
			}
			else if(kind->Equals("maxpool")) {
				ok := ok & model->AddMaxPool(t[1]->ToInt(), t[2]->ToInt());
			}
			else if(kind->Equals("flatten")) {
				ok := ok & model->AddFlatten();
			}
			else if(kind->Equals("dense")) {
				ok := ok & model->AddDense(t[1]->ToInt());
			}
			else if(kind->Equals("dropout")) {
				ok := ok & model->AddDropout(t[1]->ToFloat());
			}
			else {
				ok := false;
			};
		};
		ok := ok & model->Compile(lr);
		if(ok = false) {
			"  FAIL: cannot build '{$arch}': {$model->GetError()}"->PrintLine();
			return Nil;
		};

		return model;
	}

	function : Forward(name : String, tol : Float) ~ Nil {
		tensors := Hash->New()<String, FloatArrayRef>;
		header := String->New[2];
		if(<>Load(name, tensors, header)) {
			@fail := true;
			return;
		};

		model := Build(header[0], 0.001);
		if(model = Nil) {
			@fail := true;
			return;
		};

		Report(name + ": weights fit", model->SetWeights(tensors->Find("weights")->Get()));
		x := tensors->Find("x")->Get();
		y := tensors->Find("y")->Get();
		loss := model->GradientsWithInput(x, y);
		expected := tensors->Find("loss")->Get()[0];
		loss_diff := Float->Abs(loss - expected) / Float->Max(Float->Abs(expected), 1.0e-12);
		grad_diff := Diff(model->GetGradients(), tensors->Find("grad")->Get());
		input_diff := Diff(model->GetInputGradient(), tensors->Find("ginput")->Get());

		worst_act := 0.0;
		layers := 0;
		for(i := 0; i < 32; i += 1;) {
			ref := tensors->Find("act{$i}");
			if(ref <> Nil) {
				worst_act := Float->Max(worst_act, Diff(model->GetActivation(i), ref->Get()));
				layers += 1;
			};
		};

		logits := model->PredictLogits(x);
		logit_diff := Diff(logits, tensors->Find("logits")->Get());

		"  {$name}: {$model->GetParameterCount()} params; relative differences in units of 1e-7: loss {$(loss_diff * 1.0e7)}, logits {$(logit_diff * 1.0e7)}, gradients {$(grad_diff * 1.0e7)}, input gradient {$(input_diff * 1.0e7)}, {$layers} layer outputs {$(worst_act * 1.0e7)}"->PrintLine();
		Report(name + ": loss", loss_diff < tol);
		Report(name + ": logits", logit_diff < tol);
		Report(name + ": parameter gradients", grad_diff < tol);
		Report(name + ": input gradient", input_diff < tol);
		Report(name + ": layer outputs", worst_act < tol);
		model->Close();
	}

	function : Train(name : String, loss_tol : Float, weight_tol : Float) ~ Nil {
		tensors := Hash->New()<String, FloatArrayRef>;
		header := String->New[2];
		if(<>Load(name, tensors, header)) {
			@fail := true;
			return;
		};

		spec := header[1]->SplitWhitespace();
		steps := spec[1]->ToInt();
		nbatches := spec[2]->ToInt();
		batch := spec[3]->ToInt();
		lr := spec[4]->ToFloat();
		model := Build(header[0], lr);
		if(model = Nil) {
			@fail := true;
			return;
		};

		Report(name + ": weights fit", model->SetWeights(tensors->Find("w0")->Get()));
		xs := tensors->Find("xs")->Get();
		ys := tensors->Find("ys")->Get();
		expected := tensors->Find("losses")->Get();
		per_image := xs->Size() / (nbatches * batch);
		worst := 0.0;
		worst_step := 0;
		ours := Float->New[steps];
		for(s := 0; s < steps; s += 1;) {
			b := s % nbatches;
			x := Float->New[batch * per_image];
			y := Float->New[batch];
			each(k : x) {
				x[k] := xs[b * batch * per_image + k];
			};
			each(k : y) {
				y[k] := ys[b * batch + k];
			};
			ours[s] := model->TrainBatch(x, y);
			d := Float->Abs(ours[s] - expected[s]) / Float->Max(Float->Abs(expected[s]), 1.0e-12);
			if(d > worst) {
				worst := d;
				worst_step := s;
			};
		};

		weight_diff := Diff(model->GetWeights(), tensors->Find("wfinal")->Get());
		"  {$name}: {$steps} Adam steps, loss {$expected[0]} -> {$expected[steps - 1]} (torch), {$ours[0]} -> {$ours[steps - 1]} (ours)"->PrintLine();
		"  {$name}: worst relative loss difference {$(worst * 1.0e7)}e-7 at step {$worst_step}, final weights {$(weight_diff * 1.0e7)}e-7"->PrintLine();
		Report(name + ": the loss fell", expected[steps - 1] < expected[0] & ours[steps - 1] < ours[0]);
		Report(name + ": loss curve", worst < loss_tol);
		Report(name + ": final weights", weight_diff < weight_tol);
		model->Close();
	}
}
