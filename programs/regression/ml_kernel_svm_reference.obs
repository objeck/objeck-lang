			[2.2390276229418733, -0.7555945308499725, 0.6975246536729713, -0.7218807657031852, 0.23384833090363347, -0.25056679772962237, -0.33975299999959596, -0.30243354255093025, -2.955847430438588, -1.279852555678197, -0.6095018800437231, 1.1281778594637433, -0.2992858472265377],
			[-0.43765989773352737, 0.7792963138169172, 0.21391093376920517, -0.9439732504205571, -1.4767747849970312, -0.7733527501638631, 0.5692956455524725, 0.4822953055179938, 0.5948961367832997, 0.30515672020716117, 0.9941473691855796, 0.21148594532637463, -0.5847438349007971],
			[0.9453795645776201, -0.07418213979340912, -0.6197475044848622, 0.989942099822247, 0.711785169527411, -0.1521330246658791, -1.1227615141476293, 0.8160661036394303, -0.2702210657256121, 0.18869932821558075, -0.2072869986036205, -0.3136668251165843, 0.9799549739315679],
			[0.7131363357944241, 1.2760161310962936, -0.10636291326825884, 0.07449128241190228, 0.20642336577029666, -0.19640565578520003, -0.721799102601006, -0.4933066275811924, -0.732617902078989, 1.031560039585594, -0.8782502574158413, 0.7803000307615381, -0.440790027878406],
			[-0.47863406759934474, 1.240117564903119, -1.3927388916198202, 1.0110927702023726, -1.4794424646210422, 2.0284730656584347, -0.03226677038370826, 0.03825569826751072, 0.4427423514497977, 1.5590133040582455, 0.8835656310430737, -0.5186557900077373, 0.05220206351145292]];
		expected := [-0.9996102233395145, -0.998841151572653, -1.0001360391408067, -0.9999119194672654, -0.999752055596312, -1.0009674315049923];
		return Check("sigmoid #15", x, labels, t, SvmKernel->SIGMOID, 0.1, 0.0015384615384615385, 4, 0.0, -0.19986030808584396, expected);
	}

	function : Check(name : String, x : Float[,], labels : Int[], t : Float[,], kernel : SvmKernel,
			c : Float, gamma : Float, degree : Int, coef0 : Float, objective : Float, expected : Float[]) ~ Bool {
		y := Bool->New[labels->Size()];
		each(i : labels) {
			y[i] := labels[i] = 1;
		};

		svm := KernelSVM->New(kernel, c, gamma, degree, coef0);
		svm->SetTolerance(0.000000001);
		if(<>svm->Fit(x, y)) {
			error := svm->GetLastError();
			"FAIL: {$name}: Fit failed: {$error}"->PrintLine();
			return false;
		};

		got := svm->GetObjective();
		scale := objective->Abs();
		if(scale < 1.0) {
			scale := 1.0;
		};
		if((got - objective)->Abs() > 0.000001 * scale) {
			"FAIL: {$name}: objective {$got}, reference {$objective}"->PrintLine();
			return false;
		};

		f := svm->DecisionFunction(t);
		diff := 0.0;
		want := 0.0;
		each(i : expected) {
			want := expected[i];
			diff := (f[i] - want)->Abs();
			if(diff > 0.00001 * (1.0 + want->Abs())) {
				have := f[i];
				"FAIL: {$name}: decision value {$i} is {$have}, reference {$want}"->PrintLine();
				return false;
			};
		};

		"PASS: {$name}: objective and decision values match the reference"->PrintLine();
		return true;
	}
}
