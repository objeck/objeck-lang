# EXTRA_LIBS: ml_cnn,ml,ml_lab,opencv,csv,gen_collect
#~
Finite-difference gradient checks of System.ML.Cnn: every layer type and whole networks.

The check runs on the float64 reference model (CnnModel->NewReference), the same code as the
float32 model compiled for double. In float32 a central difference cannot resolve a gradient
better than about 1e-3 (the loss itself is only good to 6 digits), so a float32 check would have to
be loose enough to hide a real bug; in float64, with step h = 1e-5, the truncation error is about
h^2 (1e-10) and the rounding error about 1e-15 / h (1e-10), and a correct backward pass agrees to better than 1e-7 (measured: the worst of
3,000 checked values is 9e-8).

For each parameter p (all of them in the small networks, a random sample of 400 in the baseline)
and for sampled input pixels the test computes (L(p + h) - L(p - h)) / 2h and compares it with the
gradient from backpropagation:

    error = |analytic - numeric| / max(|analytic| + |numeric|, 1e-4)

which is a relative error for gradients above 1e-4 and, for smaller ones, an absolute error (scaled
by 1e4): the numeric gradient of a loss near 1 carries an absolute rounding error of about 1e-10,
so a gradient of 1e-6 cannot be judged to better than 1e-4 relative. The bound is 1e-6, ten
times the worst error measured.

Dropout is checked in training mode: ResetDropout() before each evaluation replays the same mask, so
the loss is a deterministic function of the weights and the numeric gradient is that of the masked
network, which is what backward computes.
~#

use System.ML.Cnn;

class MlCnnGradCheck {
	@state : static : Int;
	@fail : static : Bool;

	function : Main(args : String[]) ~ Nil {
		@state := 12345;
		@fail := false;

		# each layer type alone, in a network that ends in Flatten + Dense(1)
		Case("conv 3x3 valid", 2, 7, 6, 3, ["conv 4 3 1 valid"], false, 0);
		Case("conv 3x3 same", 3, 6, 5, 2, ["conv 3 3 1 same"], false, 0);
		Case("conv 4x4 same (even kernel)", 1, 5, 6, 2, ["conv 2 4 1 same"], false, 0);
		Case("conv 5x5 stride 2", 3, 11, 10, 2, ["conv 3 5 2 valid"], false, 0);
		Case("conv 3x3 stride 2 same", 2, 9, 9, 2, ["conv 3 3 2 same"], false, 0);
		Case("conv 1x1", 3, 4, 5, 3, ["conv 4 1 1 valid"], false, 0);
		Case("conv + relu", 1, 6, 6, 4, ["conv 3 3 1 valid", "relu"], false, 0);
		Case("maxpool 2 (odd input)", 1, 7, 7, 3, ["conv 2 3 1 same", "maxpool 2 2"], false, 0);
		Case("maxpool 3 stride 2 (overlapping)", 2, 9, 8, 2, ["conv 2 3 1 same", "maxpool 3 2"], false, 0);
		Case("dense + relu", 3, 4, 4, 5, ["flatten", "dense 6", "relu"], false, 0);
		Case("dropout 0.5 (training mode)", 1, 4, 4, 3, ["flatten", "dense 8", "relu", "dropout 0.5"], true, 0);
		Case("batch of 1", 3, 8, 8, 1, ["conv 4 3 1 same", "relu", "maxpool 2 2"], false, 0);

		# a whole network: three conv blocks, Dense, dropout, Dense(1), at 24 x 24
		Case("baseline blocks (24x24, sampled)", 3, 24, 24, 2,
			["conv 16 3 1 valid", "relu", "maxpool 2 2", "conv 32 3 1 valid", "relu", "maxpool 2 2",
			 "conv 64 3 1 valid", "relu", "maxpool 2 2", "flatten", "dense 16", "relu", "dropout 0.1"], true, 400);

		# the same blocks in evaluation mode, so the input gradient is checked through the whole stack
		Case("baseline blocks, no dropout (24x24, sampled)", 3, 24, 24, 2,
			["conv 16 3 1 valid", "relu", "maxpool 2 2", "conv 32 3 1 valid", "relu", "maxpool 2 2",
			 "conv 64 3 1 valid", "relu", "maxpool 2 2", "flatten", "dense 16", "relu"], false, 300);

		if(@fail) {
			Runtime->Exit(1);
		};
		"ml_cnn_gradcheck: ok"->PrintLine();
	}

	# a uniform draw in [0, 1) from a small integer generator (the test must not depend on the VM's)
	function : Rand() ~ Float {
		@state := (@state * 1103515245 + 12345) % 2147483648;
		return @state->As(Float) / 2147483648.0;
	}

	function : Loss(model : CnnModel, x : Float[], y : Float[], training : Bool) ~ Float {
		if(training) {
			model->ResetDropout();
			return model->GradientsTraining(x, y);
		};

		return model->EvaluateBatch(x, y);
	}

	function : Err(analytic : Float, numeric : Float) ~ Float {
		return Float->Abs(analytic - numeric) / Float->Max(Float->Abs(analytic) + Float->Abs(numeric), 1.0e-4);
	}

	function : Case(name : String, c : Int, h : Int, w : Int, batch : Int, layers : String[], training : Bool, sample : Int) ~ Nil {
		model := CnnModel->NewReference(c, h, w, 7);
		ok := true;
		has_flatten := false;
		each(i : layers) {
			t := layers[i]->SplitWhitespace();
			if(t[0]->Equals("flatten")) {
				has_flatten := true;
			};
			if(t[0]->Equals("conv")) {
				ok := ok & model->AddConv(t[1]->ToInt(), t[2]->ToInt(), t[3]->ToInt(), t[4]->Equals("same") ? Padding->SAME : Padding->VALID);
			}
			else if(t[0]->Equals("relu")) {
				ok := ok & model->AddReLU();
			}
			else if(t[0]->Equals("maxpool")) {
				ok := ok & model->AddMaxPool(t[1]->ToInt(), t[2]->ToInt());
			}
			else if(t[0]->Equals("flatten")) {
				ok := ok & model->AddFlatten();
			}
			else if(t[0]->Equals("dense")) {
				ok := ok & model->AddDense(t[1]->ToInt());
			}
			else if(t[0]->Equals("dropout")) {
				ok := ok & model->AddDropout(t[1]->ToFloat());
			};
		};
		# every network ends in one logit
		if(has_flatten = false) {
			ok := ok & model->AddFlatten();
		};
		ok := ok & model->AddDense(1);
		ok := ok & model->Compile(0.001);
		if(ok = false) {
			"  FAIL: {$name}: cannot build: {$model->GetError()}"->PrintLine();
			@fail := true;
			return;
		};

		# random weights and biases (the initializer leaves biases at zero, which would hide a bias bug)
		weights := model->GetWeights();
		each(i : weights) {
			weights[i] := weights[i] + (Rand() - 0.5) * 0.2;
		};
		model->SetWeights(weights);

		x := Float->New[batch * c * h * w];
		each(i : x) {
			x[i] := Rand();
		};
		y := Float->New[batch];
		each(i : y) {
			y[i] := Rand() > 0.5 ? 1.0 : 0.0;
		};

		# analytic gradients (and the input gradient, in evaluation mode)
		loss := 0.0;
		if(training) {
			model->ResetDropout();
			loss := model->GradientsTraining(x, y);
		}
		else {
			loss := model->GradientsWithInput(x, y);
		};
		analytic := model->GetGradients();
		if(loss < 0.0 | analytic = Nil | analytic->Size() <> weights->Size()) {
			"  FAIL: {$name}: no gradients: {$model->GetError()}"->PrintLine();
			@fail := true;
			return;
		};

		h_step := 1.0e-5;
		count := weights->Size();
		checked := 0;
		worst := 0.0;
		worst_at := 0;
		picks := sample > 0 ? sample : count;
		for(n := 0; n < picks; n += 1;) {
			i := sample > 0 ? (Rand() * count->As(Float))->As(Int) % count : n;
			saved := weights[i];
			weights[i] := saved + h_step;
			model->SetWeights(weights);
			plus := Loss(model, x, y, training);
			weights[i] := saved - h_step;
			model->SetWeights(weights);
			minus := Loss(model, x, y, training);
			weights[i] := saved;
			numeric := (plus - minus) / (2.0 * h_step);
			e := Err(analytic[i], numeric);
			if(e > worst) {
				worst := e;
				worst_at := i;
			};
			checked += 1;
		};
		model->SetWeights(weights);

		# the input gradient (evaluation mode only: it comes from GradientsWithInput)
		input_worst := 0.0;
		input_checked := 0;
		if(training = false) {
			ginput : Float[] := Nil;
			if(model->GradientsWithInput(x, y) >= 0.0) {
				ginput := model->GetInputGradient();
			};
			if(ginput = Nil | ginput->Size() <> x->Size()) {
				"  FAIL: {$name}: no input gradient"->PrintLine();
				@fail := true;
				return;
			};
			stride := x->Size() > 400 ? x->Size() / 400 : 1;
			for(i := 0; i < x->Size(); i += stride;) {
				saved := x[i];
				x[i] := saved + h_step;
				plus := model->EvaluateBatch(x, y);
				x[i] := saved - h_step;
				minus := model->EvaluateBatch(x, y);
				x[i] := saved;
				e := Err(ginput[i], (plus - minus) / (2.0 * h_step));
				if(e > input_worst) {
					input_worst := e;
				};
				input_checked += 1;
			};
		};

		bound := 1.0e-6;
		passed := worst < bound & input_worst < bound;
		tag := passed ? "ok  " : "FAIL";
		"  {$tag} {$name}: {$count} parameters ({$checked} checked) worst error {$(worst * 1.0e9)}e-9, {$input_checked} input pixels checked, worst error {$(input_worst * 1.0e9)}e-9"->PrintLine();
		if(passed = false) {
			"       worst parameter index {$worst_at}: analytic {$analytic[worst_at]}"->PrintLine();
			@fail := true;
		};
		model->Close();
	}
}
