# EXPECT_COMPILE_ERROR: Integer literal with a leading zero: '010'
# EXPECT_ERROR_COUNT: 1
#~
A decimal-looking literal with a leading zero was read as octal, so '010'
compiled silently as 8. It is an error that suggests '0o10' or '10'.
~#

class BadLeadingZeroOctal {
	function : Main(args : String[]) ~ Nil {
		value := 010;
		value->PrintLine();
	}
}
