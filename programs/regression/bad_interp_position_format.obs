# EXPECT_COMPILE_ERROR: bad_interp_position_format.obs:(13,24): Undefined variable: 'gone'
# EXPECT_ERROR_COUNT: 3
#~
An interpolation with a format, "{$expression:5}", is read twice: once as written, to learn its
type, and once inside the call the compiler writes to apply the format. A mistake in the
expression is reported once, where it is written. It was reported at line 1 of the file, at a
column counted in the expression's text ("(1,5): Undefined variable: 'gone'").
~#
class BadInterpPositionFormat {
	function : Main(args : String[]) ~ Nil {
		n := 1;
		a := "plain {$n:5}";
		t := "x {$n} y {$n + gone:5} z";
		a->PrintLine();
		t->PrintLine();
	}
}
