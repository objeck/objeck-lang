# EXPECT_COMPILE_ERROR: (14,48): This map literal has the key 1 twice
# EXPECT_ERROR_COUNT: 1
#~
The same constant key twice, in a Hash keyed by number.
~#
use Collection;

class BadMapLiteralDuplicateIntKey {
	function : Take(m : Map<String, IntRef>) ~ Int {
		return m->Size();
	}

	function : Main(args : String[]) ~ Nil {
		m : Hash<IntRef, String> := {1: "a", 2: "b", 1: "c"};
		m->Size()->PrintLine();
	}
}
