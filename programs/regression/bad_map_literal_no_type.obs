# EXPECT_COMPILE_ERROR: (14,8): A map literal takes its type from the variable it is assigned to or the method it is returned from
# EXPECT_ERROR_COUNT: 1
#~
A map literal is typed by its target; an inferred variable gives it none.
~#
use Collection;

class BadMapLiteralNoType {
	function : Take(m : Map<String, IntRef>) ~ Int {
		return m->Size();
	}

	function : Main(args : String[]) ~ Nil {
		m := {"a": 1};
	}
}
