#~
Guards G13: the elements of a String[] literal must survive a minor GC.

A string-array literal is built by the CPY_CHAR_STR_ARYS trap: the array comes from
AllocateArray (always old-generation) and each element is a freshly allocated, young
String. The trap stored the Strings with no write barrier, so the array was never
recorded as dirty. When the array lives only on the operand stack or as a callee's
parameter, a minor GC neither repairs its elements (only dirty and promoted objects
are fixed up) nor, before the callee is entered, marks them at all -- so the elements
dangled once the nursery was recycled.

The literal is passed straight into Check, never assigned to a local in the caller,
and Check forces minor GCs before it reads any element.
~#
class GcMinorStrArrayLiteral {
	function : Main(args : String[]) ~ Nil {
		start := Minors();
		bad := 0;
		rounds := 8;
		for(round := 0; round < rounds; round += 1;) {
			bad += Check(["alpha", "bravo", "charlie", "delta", "echo", "foxtrot", "golf", "hotel"], round);
		};

		if(Minors() - start < rounds) {
			"FAIL: churn did not run a minor GC per round"->PrintLine();
			Runtime->Exit(1);
		};

		if(bad = 0) {
			"PASS: String[] literal elements survive minor GC"->PrintLine();
		}
		else {
			"FAIL: String[] literal elements lost by minor GC: bad="->Print();
			bad->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Check(words : String[], round : Int) ~ Int {
		Churn(1);

		bad := 0;
		if(words->Size() <> 8) {
			return 8;
		};

		expected := "alpha,bravo,charlie,delta,echo,foxtrot,golf,hotel"->Split(",");
		for(i := 0; i < 8; i += 1;) {
			word := words[i];
			if(word = Nil) {
				bad += 1;
			}
			else if(word->Size() <> expected[i]->Size()) {
				bad += 1;
			}
			else if(<>word->Equals(expected[i])) {
				bad += 1;
			};
		};

		return bad;
	}

	# allocates about 'n' nurseries' worth of short-lived objects: a Blob is
	# 288 bytes of nursery (32 fields, three header words, the size word), so
	# 520000 of them are about 150MB against the 128MB nursery
	function : Churn(n : Int) ~ Nil {
		for(j := 0; j < n * 520000; j += 1;) {
			tmp := Blob->New(j);
			if(tmp->Get() <> j) {
				"FAIL: churn object corrupted"->PrintLine();
				Runtime->Exit(1);
			};
		};
	}

	function : Minors() ~ Int {
		return Runtime->GetProperty("runtime.gc.minor")->ToInt();
	}
}

class Blob {
	@a0 : Int; @a1 : Int; @a2 : Int; @a3 : Int; @a4 : Int; @a5 : Int; @a6 : Int; @a7 : Int;
	@b0 : Int; @b1 : Int; @b2 : Int; @b3 : Int; @b4 : Int; @b5 : Int; @b6 : Int; @b7 : Int;
	@c0 : Int; @c1 : Int; @c2 : Int; @c3 : Int; @c4 : Int; @c5 : Int; @c6 : Int; @c7 : Int;
	@d0 : Int; @d1 : Int; @d2 : Int; @d3 : Int; @d4 : Int; @d5 : Int; @d6 : Int; @d7 : Int;

	New(v : Int) {
		@a0 := v;
		@d7 := v;
	}

	method : public : Get() ~ Int {
		return @d7;
	}
}
