#~
Fixture for run_vm_flag_tests.py section 16 (--call-depth and OBJECK_CALL_DEPTH).

With arguments, '<depth> [thread]': recurse <depth> frames deep, unguarded, on
the main thread or in a spawned one, then print "reached <depth> of <max>",
<max> being runtime.call.depth_max. The script runs it past and short of a
--call-depth it sets, and checks the diagnostic and the exit status.

'hold <depth>': every one of <depth> frames holds an object in a local across
the deeper call, and the deepest allocates enough to force collections while
all of them are live; each frame then checks its object on the way out. The
script runs it with a small nursery and the heap verifier, so the collector
marks and relocates through thousands of frames (256 at most before).

With none, as the regression runner runs it: 5,000 frames on each thread, which
the old 256-frame call stack refused. (It allocates nothing, so the nightly run
with a forced tiny heap threshold stays fast: with live data past that
threshold every allocation collects.)
~#
use System.Concurrency;

class Held {
	@value : Int;
	@pad : Int[];

	New(value : Int) {
		@value := value;
		@pad := Int->New[4];
		@pad[0] := value;
	}

	method : public : Intact(value : Int) ~ Bool {
		return @value = value & @pad[0] = value;
	}
}

class DepthThread from Thread {
	@depth : Int;
	@reached : Int;

	New(depth : Int) {
		Parent("depth-thread");
		@depth := depth;
		@reached := -1;
	}

	method : public : Run(param : System.Base) ~ Nil {
		@reached := VmCallDepthLimit->Down(@depth);
	}

	method : public : GetReached() ~ Int {
		return @reached;
	}
}

class VmCallDepthLimit {
	# non-tail, so the tail-call pass leaves it a recursion
	function : Down(n : Int) ~ Int {
		if(n <= 0) {
			return 0;
		};
		return Down(n - 1) + 1;
	}

	# frames holding objects across collections; the count of intact ones
	function : Hold(n : Int) ~ Int {
		held := Held->New(n);
		if(n <= 0) {
			for(i := 0; i < 50000; i += 1;) {
				garbage := Held->New(i);
			};
			if(held->Intact(n)) {
				return 1;
			};
			return 0;
		};

		intact := Hold(n - 1);
		if(held->Intact(n)) {
			intact += 1;
		};
		return intact;
	}

	function : InThread(depth : Int) ~ Int {
		t := DepthThread->New(depth);
		t->Execute(Nil);
		t->Join();
		return t->GetReached();
	}

	function : Main(args : String[]) ~ Nil {
		max := Runtime->GetProperty("runtime.call.depth_max");
		if(args->Size() > 1 & args[0]->Equals("hold")) {
			depth := args[1]->ToInt();
			intact := Hold(depth);
			minor := Runtime->GetProperty("runtime.gc.minor");
			"held {$intact} of {$depth} intact after {$minor} minor collection(s)"->PrintLine();
			return;
		};

		if(args->Size() > 0) {
			depth := args[0]->ToInt();
			reached := 0;
			if(args->Size() > 1 & args[1]->Equals("thread")) {
				reached := InThread(depth);
			}
			else {
				reached := Down(depth);
			};
			"reached {$reached} of {$max}"->PrintLine();
			return;
		};

		ok := Down(5000) = 5000;
		ok := InThread(5000) = 5000 & ok;
		if(ok) {
			"PASS: 5,000 frames deep on the main thread and in a spawned one (maximum {$max})"->PrintLine();
		}
		else {
			"FAIL: a 5,000-frame recursion did not complete"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
