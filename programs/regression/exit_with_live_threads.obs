#~
# Ending the process while other threads are still running must exit cleanly.
#
# Guards #877. A runtime error -- a Nil dereference, a divide by zero, an index
# out of bounds -- and Runtime->Exit all ended the process with exit(), which runs
# the process's teardown on the calling thread while every other thread keeps
# executing. Static destructors freed the collector's old-generation set under a
# thread that was allocating into it, and on Windows the C++ runtime freed its
# locale state under a thread formatting a number. The program's own message was
# printed and the process then died with SIGSEGV: exit 139 instead of 1 on Linux
# x64, Linux arm64 and Windows x64, in both JIT modes, whenever one other thread was
# busy. It first showed up as https_persistence_test exiting 139 with a core on
# linux-arm64 after a Nil dereference in a server thread.
#
# A negative test cannot guard it: the runner accepts any non-zero exit, so a
# crash after the error message passes. Runtime->Exit(0) takes the same exit path,
# and a crash there turns exit 0 into a failure. Two busy threads allocate objects,
# arrays and number-to-string conversions; a third thread calls Runtime->Exit(0)
# while they run and while Main is blocked joining it. A pre-fix obr crashed on
# every run of this test in both JIT modes on Windows x64.
~#

use System.Concurrency;

class LiveNode {
  @v : Int;
  @next : LiveNode;

  New(v : Int, next : LiveNode) { @v := v; @next := next; }
}

class LiveBusy from Thread {
  @spins : Int;

  New(spins : Int) {
    Parent("live-busy");
    @spins := spins;
  }

  method : public : Run(param : System.Base) ~ Nil {
    head : LiveNode := Nil;
    for(i := 0; i < @spins; i += 1;) {
      head := LiveNode->New(i, (i % 64 = 0) ? Nil : head);
      cells := Int->New[8];
      cells[i % 8] := i;
      text := i->ToString();
      ratio := i->As(Float) / 7.0;
      text := ratio->ToString();
    };
  }
}

class LiveExiter from Thread {
  New() {
    Parent("live-exiter");
  }

  method : public : Run(param : System.Base) ~ Nil {
    # let both busy threads get well into their loops first
    chars := 0;
    for(i := 0; i < 50000; i += 1;) {
      text := i->ToString();
      chars += text->Size();
    };
    "PASS: Runtime->Exit(0) with two busy threads running"->PrintLine();
    Runtime->Exit(0);
  }
}

class ExitWithLiveThreads {
  function : Main(args : String[]) ~ Nil {
    busy := LiveBusy->New[2];
    each(i : busy) {
      busy[i] := LiveBusy->New(200000000);
      busy[i]->Execute(Nil);
    };

    exiter := LiveExiter->New();
    exiter->Execute(Nil);
    exiter->Join();

    "FAIL: Runtime->Exit(0) returned to the program"->PrintLine();
    Runtime->Exit(1);
  }
}
