# EXPECT_COMPILE_ERROR: begins a declaration, which cannot appear inside a method body
# EXPECT_ERROR_COUNT: 1
#~
A method missing its closing '}' ran into the next 'function', reported as "Expected
expression, found keyword 'function'". It now says a declaration cannot start inside a body
and that a '}' is missing above, naming the block the indentation points at.
~#
class BadDeclInsideBody {
	function : First() ~ Nil {
		x := 1;
		if(x = 1) {
			"one"->PrintLine();
		}

	function : Main(args : String[]) ~ Nil {
		First();
	}
}
