#~
Byte[] compression round trips: zlib, gzip and raw deflate on empty, one-byte, short
and large inputs, and damaged or truncated input raising an error a 'try' recovers from.

CompressGzip failed on every small input: it sized its buffer with compressBound(), which
assumes zlib's 6-byte wrapper, while gzip's header and trailer take 18 bytes, so deflate
never finished and the trap ended the program. The decompressors also returned a partial
buffer as success when they hit the size limit, and leaked the inflate state on errors.
~#
class CompressRoundTrip {
	@failures : static : Int;

	function : Check(what : String, ok : Bool) ~ Nil {
		if(<>ok) {
			@failures += 1;
			"  FAIL: {$what}"->PrintLine();
		};
	}

	function : Same(a : Byte[], b : Byte[]) ~ Bool {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return false;
		};

		each(i : a) {
			if(a[i] <> b[i]) {
				return false;
			};
		};

		return true;
	}

	function : RoundTrip(text : String) ~ Nil {
		plain := text->ToByteArray();
		size := plain->Size();
		Check("gzip round trip of {$size} bytes", Same(plain, plain->CompressGzip()->UncompressGzip()));
		Check("zlib round trip of {$size} bytes", Same(plain, plain->CompressZlib()->UncompressZlib()));
		Check("deflate round trip of {$size} bytes", Same(plain, plain->CompressDeflate()->UncompressDeflate()));
	}

	function : Main(args : String[]) ~ Nil {
		@failures := 0;

		texts := ["", "a", "hello world hello", "abcdefghijklmnopqrstuvwxyz0123456789"];
		each(i : texts) {
			RoundTrip(texts[i]);
		};

		big := "";
		each(j : 20000) {
			big += "row,{$j},value\n";
		};
		RoundTrip(big);

		gz := "hello"->ToByteArray()->CompressGzip();
		Check("a gzip stream starts with the gzip magic", gz->Size() >= 18 & gz[0] = 0x1f & gz[1] = 0x8b);

		damaged := "this is not gzip data"->ToByteArray();
		failed := false;
		try {
			damaged->UncompressGzip();
		}
		on(e : Error) {
			failed := true;
		};
		Check("damaged gzip data raises", failed);

		whole := big->ToByteArray()->CompressGzip();
		cut := Byte->New[whole->Size() / 2];
		each(k : cut) {
			cut[k] := whole[k];
		};
		failed := false;
		try {
			cut->UncompressGzip();
		}
		on(e : Error) {
			failed := true;
		};
		Check("truncated gzip data raises rather than returning part of the text", failed);

		failed := false;
		try {
			damaged->UncompressDeflate();
		}
		on(e : Error) {
			failed := true;
		};
		Check("damaged deflate data raises", failed);

		if(@failures = 0) {
			"PASS: compression round trips"->PrintLine();
		}
		else {
			"FAIL: compression round trips ({$@failures} checks)"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
