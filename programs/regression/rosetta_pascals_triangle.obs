#~
# Rosetta Code: Pascal's triangle
# https://rosettacode.org/wiki/Pascal%27s_triangle
#
# Each entry is the sum of the two above. Checked against the binomial coefficient as well, so a row built by addition and a row computed directly have to agree.
#
# Expected values were computed with an independent oracle, not recalled.
~#


class RosettaPascalsTriangle {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaPascalsTriangle->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		Check("row 0", Row(0), "1");
		Check("row 1", Row(1), "1 1");
		Check("row 2", Row(2), "1 2 1");
		Check("row 3", Row(3), "1 3 3 1");
		Check("row 4", Row(4), "1 4 6 4 1");
		Check("row 5", Row(5), "1 5 10 10 5 1");

		# addition and the binomial form must agree
		bad := 0;
		for(r := 0; r <= 20; r += 1;) {
			built := Row(r)->Split(" ");
			for(k := 0; k < built->Size(); k += 1;) {
				if(built[k]->ToInt() <> Binomial(r, k)) { bad += 1; };
			};
		};
		CheckInt("rows 0..20 agree with the binomial form", bad, 0);
		# a row sums to a power of two
		sum := 0;
		parts := Row(10)->Split(" ");
		each(i : parts) { sum += parts[i]->ToInt(); };
		CheckInt("row 10 sums to 1024", sum, 1024);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Row(n : Int) ~ String {
		row := Int->New[n + 1];
		row[0] := 1;
		for(i := 1; i <= n; i += 1;) {
			# right to left, so each read happens before it is overwritten
			for(j := i; j > 0; j -= 1;) {
				row[j] := row[j] + row[j - 1];
			};
		};
		out := "";
		each(i : row) {
			out += row[i]->ToString();
			out += " ";
		};
		return out->Trim();
	}

	function : Binomial(n : Int, k : Int) ~ Int {
		if(k < 0 | k > n) { return 0; };
		if(k > n - k) { k := n - k; };
		r := 1;
		for(i := 0; i < k; i += 1;) {
			r := r * (n - i) / (i + 1);
		};
		return r;
	}
}
