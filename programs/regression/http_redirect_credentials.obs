#~
# Credentials do not follow a redirect to another origin (#1453)
#
# HttpClient and HttpsClient follow 3xx redirects. They used to re-send every
# header the caller set, and the whole cookie jar, on every hop -- so a
# redirect to another host or port received the caller's Authorization,
# Proxy-Authorization and cookies. Now, as curl and Python requests do, once a
# hop leaves the origin the caller addressed (scheme, host or port), those are
# dropped for the rest of the chain. Other headers still go.
#
# Two servers, A and B, on ports the system chose, for each client (plain
# HTTP, and TLS with a self-signed certificate pinned as the only trust
# anchor). B's port differs from A's, so B is another origin. /landing answers
# with which of the headers arrived:
#
#   A /landing             no redirect: everything arrives (the baseline)
#   A /same  -> A /landing a same-origin redirect keeps everything
#   A /cross -> B /landing credentials and cookies are dropped, X-Trace is kept
#   A /cross307 -> B       the same through 307, which re-sends a POST body
#   A /bounce -> B /back -> A /landing
#                          dropped for the rest of the chain, even back at A
#   cookie jar             a jar cookie goes on a same-origin redirect, not a
#                          cross-origin one
#
# Against the pre-fix net.obl the /cross, /cross307 and /bounce cases fail
# with auth=1 proxy=1 cookie=1.
# EXTRA_LIBS: net
~#

use Collection, System.Concurrency, System.IO.Filesystem, System.IO.Net, Web.HTTP;

# Reads one request and builds the reply. The paths are listed above.
class Landing {
	function : Handle(stream : System.IO.InputStream, scheme : String, peer : Int) ~ String {
		line : String;
		header : String;
		lower : String;
		body : Byte[];
		auth := 0;
		proxy := 0;
		cookie := 0;
		trace := 0;
		length := 0;
		read := 0;
		count := 0;

		line := stream->ReadLine();
		if(line = Nil) {
			return Nil;
		};

		do {
			header := stream->ReadLine();
			if(header <> Nil & header->Size() > 0) {
				lower := header->ToLower();
				if(lower->StartsWith("authorization:")) {
					auth := 1;
				}
				else if(lower->StartsWith("proxy-authorization:")) {
					proxy := 1;
				}
				else if(lower->StartsWith("cookie:")) {
					cookie := 1;
				}
				else if(lower->StartsWith("x-trace:")) {
					trace := 1;
				}
				else if(lower->StartsWith("content-length:")) {
					length := lower->SubString(15, lower->Size() - 15)->Trim()->ToInt();
				};
			};
		}
		while(header <> Nil & header->Size() > 0);

		# drain a POST body, so closing does not reset an unread connection
		if(length > 0) {
			body := Byte->New[length];
			while(read < length) {
				count := stream->ReadBuffer(read, length - read, body);
				if(count <= 0) {
					read := length;
				}
				else {
					read += count;
				};
			};
		};

		if(line->Has(" /landing ")) {
			text := "auth={$auth} proxy={$proxy} cookie={$cookie} trace={$trace}";
			size := text->Size();
			return "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: {$size}\r\nConnection: close\r\n\r\n{$text}";
		}
		else if(line->Has(" /same ")) {
			return Redirect("302 Found", "/landing");
		}
		else if(line->Has(" /cross307 ")) {
			return Redirect("307 Temporary Redirect", "{$scheme}://127.0.0.1:{$peer}/landing");
		}
		else if(line->Has(" /cross ")) {
			return Redirect("302 Found", "{$scheme}://127.0.0.1:{$peer}/landing");
		}
		else if(line->Has(" /bounce ")) {
			return Redirect("302 Found", "{$scheme}://127.0.0.1:{$peer}/back");
		}
		else if(line->Has(" /back ")) {
			return Redirect("302 Found", "{$scheme}://127.0.0.1:{$peer}/landing");
		};

		return "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
	}

	function : Redirect(status : String, location : String) ~ String {
		return "HTTP/1.1 {$status}\r\nLocation: {$location}\r\nContent-Length: 0\r\nConnection: close\r\n\r\n";
	}
}

# Serves plain HTTP until the program ends
class PlainServer from Thread {
	@server : TCPSocketServer;
	@peer : Int;

	New(server : TCPSocketServer, peer : Int) {
		Parent("redirect-plain");
		@server := server;
		@peer := peer;
	}

	method : public : Run(param : Base) ~ Nil {
		reply : String;
		while(true) {
			client := @server->Accept();
			if(client <> Nil & client->IsOpen()) {
				reply := Landing->Handle(client, "http", @peer);
				if(reply <> Nil) {
					client->WriteString(reply);
				};
				# Not Close(): let the client read the reply and hang up first (#669)
				client->CloseGracefully();
			};
		};
	}
}

# Serves HTTPS until the program ends
class TlsServer from Thread {
	@server : TCPSecureSocketServer;
	@peer : Int;

	New(server : TCPSecureSocketServer, peer : Int) {
		Parent("redirect-tls");
		@server := server;
		@peer := peer;
	}

	method : public : Run(param : Base) ~ Nil {
		reply : String;
		while(true) {
			client := @server->Accept();
			if(client <> Nil & client->IsOpen()) {
				reply := Landing->Handle(client, "https", @peer);
				if(reply <> Nil) {
					client->WriteString(reply);
				};
				client->CloseGracefully();
			};
		};
	}
}

class RedirectCredentialsTest {
	@passed : Int;
	@failed : Int;

	New() {
		@passed := 0;
		@failed := 0;
	}

	function : Main(args : String[]) ~ Nil {
		RedirectCredentialsTest->New()->Run();
	}

	method : Run() ~ Nil {
		"Testing credentials across redirects..."->PrintLine();

		passed : Int;
		failed : Int;

		PlainCases();
		TlsCases();

		passed := @passed;
		failed := @failed;
		if(failed > 0) {
			"---"->PrintLine();
			"{$passed} passed, {$failed} failed"->PrintLine();
			Runtime->Exit(1);
		};

		"PASS: {$passed} checks; credentials stay with their origin across redirects"->PrintLine();
	}

	method : PlainCases() ~ Nil {
		a : TCPSocketServer;
		b : TCPSocketServer;
		client : HttpClient;
		jar : HttpClient;
		base : String;
		a_port : Int;
		b_port : Int;

		a := TCPSocketServer->New("127.0.0.1", 0);
		b := TCPSocketServer->New("127.0.0.1", 0);
		if(<>a->Listen(8) | <>b->Listen(8)) {
			Fail("http: the test servers did not listen");
			return;
		};
		a_port := a->GetPort();
		b_port := b->GetPort();
		PlainServer->New(a, b_port)->Execute(Nil);
		PlainServer->New(b, a_port)->Execute(Nil);
		base := "http://127.0.0.1:{$a_port}";

		client := HttpClient->New();
		AddCredentials(client->GetRequestHeaders());
		Expect("http: no redirect", client->Get(Url->New(base + "/landing")), "auth=1 proxy=1 cookie=1 trace=1");
		Expect("http: same-origin 302", client->Get(Url->New(base + "/same")), "auth=1 proxy=1 cookie=1 trace=1");
		Expect("http: cross-origin 302", client->Get(Url->New(base + "/cross")), "auth=0 proxy=0 cookie=0 trace=1");
		Expect("http: cross-origin 307 POST", client->Post(Url->New(base + "/cross307"), "payload"->ToByteArray(), "text/plain"), "auth=0 proxy=0 cookie=0 trace=1");
		Expect("http: A -> B -> A stays stripped", client->Get(Url->New(base + "/bounce")), "auth=0 proxy=0 cookie=0 trace=1");
		Expect("http: credentials still go after a cross-origin chain", client->Get(Url->New(base + "/same")), "auth=1 proxy=1 cookie=1 trace=1");

		jar := HttpClient->New();
		jar->EnableCookies(true);
		jar->SetCookie(Cookie->New("session", "abc123"));
		Expect("http: jar cookie on a same-origin redirect", jar->Get(Url->New(base + "/same")), "auth=0 proxy=0 cookie=1 trace=0");
		Expect("http: no jar cookie on a cross-origin redirect", jar->Get(Url->New(base + "/cross")), "auth=0 proxy=0 cookie=0 trace=0");
	}

	method : TlsCases() ~ Nil {
		a : TCPSecureSocketServer;
		b : TCPSecureSocketServer;
		client : HttpsClient;
		jar : HttpsClient;
		name : String;
		pem : String;
		base : String;
		a_port : Int;
		b_port : Int;

		name := "redirect-credentials-{$Runtime->GetProcessId()}";
		if(<>MakeCert(name)) {
			Fail("https: openssl could not make the test certificate");
			return;
		};
		pem := "{$name}-cert.pem";

		a := TCPSecureSocketServer->New(pem, "{$name}-key.pem", "", "127.0.0.1", 0);
		b := TCPSecureSocketServer->New(pem, "{$name}-key.pem", "", "127.0.0.1", 0);
		if(<>a->Listen() | <>b->Listen()) {
			Fail("https: the test servers did not listen");
			return;
		};
		a_port := a->GetPort();
		b_port := b->GetPort();
		TlsServer->New(a, b_port)->Execute(Nil);
		TlsServer->New(b, a_port)->Execute(Nil);
		base := "https://127.0.0.1:{$a_port}";

		client := HttpsClient->New();
		AddCredentials(client->GetRequestHeaders());
		Expect("https: no redirect", client->Get(Url->New(base + "/landing"), "text/plain", pem), "auth=1 proxy=1 cookie=1 trace=1");
		Expect("https: same-origin 302", client->Get(Url->New(base + "/same"), "text/plain", pem), "auth=1 proxy=1 cookie=1 trace=1");
		Expect("https: cross-origin 302", client->Get(Url->New(base + "/cross"), "text/plain", pem), "auth=0 proxy=0 cookie=0 trace=1");
		Expect("https: cross-origin 307 POST", client->Post(Url->New(base + "/cross307"), "payload"->ToByteArray(), "text/plain", pem), "auth=0 proxy=0 cookie=0 trace=1");
		Expect("https: A -> B -> A stays stripped", client->Get(Url->New(base + "/bounce"), "text/plain", pem), "auth=0 proxy=0 cookie=0 trace=1");

		jar := HttpsClient->New();
		jar->EnableCookies(true);
		jar->SetCookie(Cookie->New("session", "abc123"));
		Expect("https: jar cookie on a same-origin redirect", jar->Get(Url->New(base + "/same"), "text/plain", pem), "auth=0 proxy=0 cookie=1 trace=0");
		Expect("https: no jar cookie on a cross-origin redirect", jar->Get(Url->New(base + "/cross"), "text/plain", pem), "auth=0 proxy=0 cookie=0 trace=0");

		File->Delete(pem);
		File->Delete("{$name}-key.pem");
	}

	# the headers a caller sets; AddHeader stores names lower-cased, as here
	method : AddCredentials(headers : Hash<String, String>) ~ Nil {
		headers->Insert("authorization", "Bearer secret-token");
		headers->Insert("proxy-authorization", "Basic cHJveHk6c2VjcmV0");
		headers->Insert("cookie", "header_cookie=1");
		headers->Insert("x-trace", "kept");
	}

	method : Expect(name : String, response : Web.HTTP.Response, want : String) ~ Nil {
		got : String;
		if(response = Nil | response->GetContent() = Nil) {
			got := "<no body>";
		}
		else {
			got := response->GetContent()->ToString();
		};

		if(got->Equals(want)) {
			@passed += 1;
		}
		else {
			Fail("{$name}: expected '{$want}', got '{$got}'");
		};
	}

	method : Fail(message : String) ~ Nil {
		"  FAIL: {$message}"->PrintLine();
		@failed += 1;
	}

	# a self-signed certificate naming IP:127.0.0.1, as tls_ip_san makes them
	function : MakeCert(name : String) ~ Bool {
		File->Delete("{$name}-cert.pem");
		File->Delete("{$name}-key.pem");
		config := Runtime->GetPlatform()->Has("Windows") ? "-config NUL " : "";
		command := "openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 1 {$config}-subj \"/CN=objeck-redirect-test\" -addext \"subjectAltName=IP:127.0.0.1\" -keyout {$name}-key.pem -out {$name}-cert.pem";
		return Runtime->Command(command) = 0;
	}
}
