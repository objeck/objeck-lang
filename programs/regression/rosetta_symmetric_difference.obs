#~
# Rosetta Code: Symmetric difference
# https://rosettacode.org/wiki/Symmetric_difference
# Claimed in #1149
#
# EXTRA_LIBS: gen_collect
#
# (A \ B) u (B \ A) over the task's two name sets, using the library's SymmetricDifference on both the tree-backed Collection.Set and the hash-backed Collection.SetHash, and also via the page's second formulation (A u B) \ (A n B) built from Union / Intersect / Difference. The page's note is pinned too: input lists with duplicates (Serena and Jim twice) must still yield just Serena and Jim.
#
# Expected values were computed with an independent oracle (Python sets), not recalled.
~#

use Collection;

class RosettaSymmetricDifference {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaSymmetricDifference->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		# the task's sets; the second pair is the page's note, with duplicates
		list_a := ["John", "Bob", "Mary", "Serena"];
		list_b := ["Jim", "Mary", "John", "Bob"];
		dup_a := ["John", "Serena", "Bob", "Mary", "Serena"];
		dup_b := ["Jim", "Mary", "John", "Jim", "Bob"];

		a := ToSet(list_a);
		b := ToSet(list_b);
		Check("A", Show(a), "Bob,John,Mary,Serena");
		Check("B", Show(b), "Bob,Jim,John,Mary");
		Check("A \\ B", Show(a->Difference(b)), "Serena");
		Check("B \\ A", Show(b->Difference(a)), "Jim");
		Check("symmetric difference", Show(a->SymmetricDifference(b)), "Jim,Serena");
		# bound in steps: a chained a->Union(b)->Difference(...) loses the type arguments
		both := a->Union(b);
		common := a->Intersect(b);
		Check("(A u B) \\ (A n B) agrees", Show(both->Difference(common)), "Jim,Serena");
		Check("it is symmetric", Show(b->SymmetricDifference(a)), "Jim,Serena");
		Check("A is untouched", Show(a), "Bob,John,Mary,Serena");

		da := ToSet(dup_a);
		db := ToSet(dup_b);
		Check("duplicate input collapses to 4 names", da->Size()->ToString(), "4");
		Check("symmetric difference of the duplicated lists", Show(da->SymmetricDifference(db)), "Jim,Serena");

		# a set with itself has an empty symmetric difference
		Check("A xor A is empty", Show(a->SymmetricDifference(a)), "");

		# the hash-backed set gives the same answer
		ha := SetHash->New()<String>;
		each(n in dup_a) { ha->Insert(n); };
		hb := SetHash->New()<String>;
		each(n in dup_b) { hb->Insert(n); };
		Check("SetHash sizes ignore duplicates", "{$ha->Size()} {$hb->Size()}", "4 4");
		hsym := ha->SymmetricDifference(hb);
		sym := Set->New()<String>;
		keys := hsym->GetKeys()<String>;
		each(k in keys) { sym->Insert(k); };
		Check("SetHash symmetric difference", Show(sym), "Jim,Serena");

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : ToSet(names : String[]) ~ Set<String> {
		s := Set->New()<String>;
		each(n in names) { s->Insert(n); };
		return s;
	}

	function : Show(s : Set<String>) ~ String {
		out := "";
		keys := s->GetKeys()<String>;
		each(i : keys) {
			if(i > 0) { out += ","; };
			out += keys->Get(i);
		};
		return out;
	}
}
