#~
# Rosetta Code: Symmetric difference
# https://rosettacode.org/wiki/Symmetric_difference
# Claimed in #1149
#
# EXTRA_LIBS: gen_collect
#
# (A \ B) u (B \ A) over the task's two name sets, computed both on the tree-backed Collection.Set and on the hash-backed Collection.SetHash, and also via the page's second formulation (A u B) \ (A n B). The page's note is pinned too: input lists with duplicates (Serena and Jim twice) must still yield just Serena and Jim.
#
# Expected values were computed with an independent oracle (Python sets), not recalled.
~#

use Collection;

class RosettaSymmetricDifference {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaSymmetricDifference->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		# the task's sets; the second pair is the page's note, with duplicates
		list_a := ["John", "Bob", "Mary", "Serena"];
		list_b := ["Jim", "Mary", "John", "Bob"];
		dup_a := ["John", "Serena", "Bob", "Mary", "Serena"];
		dup_b := ["Jim", "Mary", "John", "Jim", "Bob"];

		a := ToSet(list_a);
		b := ToSet(list_b);
		Check("A", Show(a), "Bob,John,Mary,Serena");
		Check("B", Show(b), "Bob,Jim,John,Mary");
		Check("A \\ B", Show(Minus(a, b)), "Serena");
		Check("B \\ A", Show(Minus(b, a)), "Jim");
		Check("symmetric difference", Show(Union(Minus(a, b), Minus(b, a))), "Jim,Serena");
		Check("(A u B) \\ (A n B) agrees", Show(Minus(Union(a, b), Intersect(a, b))), "Jim,Serena");
		Check("it is symmetric", Show(Union(Minus(b, a), Minus(a, b))), "Jim,Serena");
		Check("A is untouched", Show(a), "Bob,John,Mary,Serena");

		da := ToSet(dup_a);
		db := ToSet(dup_b);
		Check("duplicate input collapses to 4 names", da->Size()->ToString(), "4");
		Check("symmetric difference of the duplicated lists", Show(Union(Minus(da, db), Minus(db, da))), "Jim,Serena");

		# a set with itself has an empty symmetric difference
		Check("A xor A is empty", Show(Union(Minus(a, a), Minus(a, a))), "");

		# the hash-backed set gives the same answer
		ha := SetHash->New()<String>;
		each(n in dup_a) { ha->Insert(n); };
		hb := SetHash->New()<String>;
		each(n in dup_b) { hb->Insert(n); };
		Check("SetHash sizes ignore duplicates", "{$ha->Size()} {$hb->Size()}", "4 4");
		sym := Set->New()<String>;
		ka := ha->GetKeys()<String>;
		each(k in ka) {
			if(<>hb->Has(k)) { sym->Insert(k); };
		};
		kb := hb->GetKeys()<String>;
		each(k in kb) {
			if(<>ha->Has(k)) { sym->Insert(k); };
		};
		Check("SetHash symmetric difference", Show(sym), "Jim,Serena");

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : ToSet(names : String[]) ~ Set<String> {
		s := Set->New()<String>;
		each(n in names) { s->Insert(n); };
		return s;
	}

	function : Show(s : Set<String>) ~ String {
		out := "";
		keys := s->GetKeys()<String>;
		each(i : keys) {
			if(i > 0) { out += ","; };
			out += keys->Get(i);
		};
		return out;
	}

	function : Union(a : Set<String>, b : Set<String>) ~ Set<String> {
		r := Set->New()<String>;
		ak := a->GetKeys()<String>;
		each(k in ak) { r->Insert(k); };
		bk := b->GetKeys()<String>;
		each(k in bk) { r->Insert(k); };
		return r;
	}

	function : Intersect(a : Set<String>, b : Set<String>) ~ Set<String> {
		r := Set->New()<String>;
		ak := a->GetKeys()<String>;
		each(k in ak) {
			if(b->Has(k)) { r->Insert(k); };
		};
		return r;
	}

	function : Minus(a : Set<String>, b : Set<String>) ~ Set<String> {
		r := Set->New()<String>;
		ak := a->GetKeys()<String>;
		each(k in ak) {
			if(<>b->Has(k)) { r->Insert(k); };
		};
		return r;
	}
}
