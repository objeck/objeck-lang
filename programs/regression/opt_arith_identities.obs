    ys[19] := 1099511627776;
    ys[20] := (-1099511627776);
    ys[21] := 6;
    ys[22] := 4;
    ys[23] := 100;
    ys[24] := (-100);
    K := Int->New[32];
    K[0] := 0;
    K[1] := 1;
    K[2] := (-1);
    K[3] := 7;
    K[4] := 9223372036854775807;
