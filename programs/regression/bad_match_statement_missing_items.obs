# EXPECT_COMPILE_ERROR: (20,3): This 'match' does not cover every item of 'Color', missing: Green
# EXPECT_ERROR_COUNT: 1
#~
The statement form is checked as the value form is.
~#
enum Color {
	Red,
	Green,
	Blue
}

enum Size {
	Small,
	Large
}

class BadMatchStatementMissingItems {
	function : Main(args : String[]) ~ Nil {
		c := Color->Red;
		match c {
			Color->Red => { "r"->PrintLine(); }
			Color->Blue => { "b"->PrintLine(); }
		};
	}
}
