# EXTRA_LIBS: nlp_topics,json,plot,gen_collect
#~
System.NLP.Topics BsonReader against pymongo's bson package.

The bytes below were produced by bson.encode (pymongo 4.20.1) and the expected JSON by reading them back with
bson.decode_all and applying the documented BsonReader mapping; both are made by nlp_topics_bson_pymongo.py and
committed, so CI needs no Python. Four documents: one with every type pymongo can write (doubles including
-0.0, 5e-324, the largest double, infinities and NaN; UTF-8 with 2-, 3- and 4-byte characters; embedded
documents and arrays; binary subtypes 0, 4 and 128; ObjectId; Booleans; int32 extremes; int64 extremes; timestamp;
Decimal128 values; a regex; JavaScript; min and max key), one of datetimes (year 1, 1900, 1950, the epoch, a leap
day, year 9999), one nested 50 levels deep with arrays inside, and a tweet-shaped one. The reader decodes the
dump and every tree must match the expected one element by element; the document lengths and the byte position
after each must match what bson.encode wrote.
~#
use System.NLP.Topics;
use Data.JSON;
use Collection;

class NlpTopicsBsonPymongo {
	function : Main(args : String[]) ~ Nil {
		ok := Check();
		if(ok = false) {
			Runtime->Exit(1);
		};
		"nlp_topics_bson_pymongo: ok"->PrintLine();
	}

	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};
		return passed;
	}

	function : Nibble(c : Char) ~ Int {
		code := c->As(Int);
		if(code >= 97) {
			return code - 87;
		};
		return code - 48;
	}

	function : Unhex(text : String) ~ Byte[] {
		n := text->Size() / 2;
		out := Byte->New[n];
		for(i := 0; i < n; i += 1;) {
			out[i] := (Nibble(text->Get(2 * i)) * 16 + Nibble(text->Get(2 * i + 1)))->As(Byte);
		};
		return out;
	}

# BEGIN GENERATED (nlp_topics_bson_pymongo.py)
	function : DumpHex() ~ String { return ""; }
	function : ExpectedJson() ~ String { return "[{\"_id\":\"507f1f77bcf86cd799439011\",\"double\":3.14159,\"negzero\":-0.0,\"tiny\":5e-324,\"huge\":1.7976931348623157e+308,\"pinf\":\"Infinity\",\"ninf\":\"-Infinity\",\"nan\":\"NaN\",\"text\":\"h\\u00e9llo \\u2713 tweet \\ud83d\\ude00 \\u65e5\\u672c\\u8a9e\",\"empty\":\"\",\"quote\":\"say \\\"hi\\\"\\n\\ttab \\\\ slash\",\"doc\":{\"inner\":{\"deep\":7,\"list\":[1,2,{\"x\":null}]}},\"arr\":[1,\"two\",3.5,null,[true,false],{\"k\":\"v\"}],\"emptydoc\":{},\"emptyarr\":[],\"bin0\":{\"$binary\":\"0001ff\",\"$type\":0},\"bin4\":{\"$binary\":\"000102030405060708090a0b0c0d0e0f\",\"$type\":4},\"bin128\":{\"$binary\":\"616263\",\"$type\":128},\"yes\":true,\"no\":false,\"nul\":null,\"i32\":-123456,\"i32max\":2147483647,\"i32min\":-2147483648,\"i64\":9007199254740993,\"i64neg\":-9007199254740993,\"i64max\":9223372036854775807,\"i64min\":-9223372036854775808,\"ts\":{\"$timestamp\":{\"t\":1614834367,\"i\":5}},\"dec\":{\"$decimal128\":\"0f000000000000000000000000003e30\"},\"decneg\":{\"$decimal128\":\"1581e97df41022110000000000002eb0\"},\"decnan\":{\"$decimal128\":\"0000000000000000000000000000007c\"},\"re\":{\"$regex\":\"^a.*b$\",\"$options\":\"i\"},\"js\":\"x=1\",\"minkey\":{\"$minKey\":1},\"maxkey\":{\"$maxKey\":1}},{\"dt\":\"2021-03-04T05:06:07.089Z\",\"dt_old\":\"1950-12-31T23:59:59.999Z\",\"dt_epoch\":\"1970-01-01T00:00:00.000Z\",\"dt_leap\":\"2020-02-29T12:00:00.000Z\",\"dt_y1\":\"0001-01-01T00:00:00.000Z\",\"dt_y9999\":\"9999-12-31T23:59:59.999Z\",\"dt_1900\":\"1900-03-01T00:00:00.001Z\"},{\"nested\":{\"n49\":{\"n48\":{\"n47\":{\"n46\":{\"n45\":{\"n44\":{\"n43\":{\"n42\":{\"n41\":{\"n40\":{\"n39\":{\"n38\":{\"n37\":{\"n36\":{\"n35\":{\"n34\":{\"n33\":{\"n32\":{\"n31\":{\"n30\":{\"n29\":{\"n28\":{\"n27\":{\"n26\":{\"n25\":{\"n24\":{\"n23\":{\"n22\":{\"n21\":{\"n20\":{\"n19\":{\"n18\":{\"n17\":{\"n16\":{\"n15\":{\"n14\":{\"n13\":{\"n12\":{\"n11\":{\"n10\":{\"n9\":{\"n8\":{\"n7\":{\"n6\":{\"n5\":{\"n4\":{\"n3\":{\"n2\":{\"n1\":{\"n0\":{\"leaf\":1},\"tag\":\"level 0\",\"list\":[0,{\"i\":0}]},\"tag\":\"level 1\",\"list\":[1,{\"i\":1}]},\"tag\":\"level 2\",\"list\":[2,{\"i\":2}]},\"tag\":\"level 3\",\"list\":[3,{\"i\":3}]},\"tag\":\"level 4\",\"list\":[4,{\"i\":4}]},\"tag\":\"level 5\",\"list\":[5,{\"i\":5}]},\"tag\":\"level 6\",\"list\":[6,{\"i\":6}]},\"tag\":\"level 7\",\"list\":[7,{\"i\":7}]},\"tag\":\"level 8\",\"list\":[8,{\"i\":8}]},\"tag\":\"level 9\",\"list\":[9,{\"i\":9}]},\"tag\":\"level 10\",\"list\":[10,{\"i\":10}]},\"tag\":\"level 11\",\"list\":[11,{\"i\":11}]},\"tag\":\"level 12\",\"list\":[12,{\"i\":12}]},\"tag\":\"level 13\",\"list\":[13,{\"i\":13}]},\"tag\":\"level 14\",\"list\":[14,{\"i\":14}]},\"tag\":\"level 15\",\"list\":[15,{\"i\":15}]},\"tag\":\"level 16\",\"list\":[16,{\"i\":16}]},\"tag\":\"level 17\",\"list\":[17,{\"i\":17}]},\"tag\":\"level 18\",\"list\":[18,{\"i\":18}]},\"tag\":\"level 19\",\"list\":[19,{\"i\":19}]},\"tag\":\"level 20\",\"list\":[20,{\"i\":20}]},\"tag\":\"level 21\",\"list\":[21,{\"i\":21}]},\"tag\":\"level 22\",\"list\":[22,{\"i\":22}]},\"tag\":\"level 23\",\"list\":[23,{\"i\":23}]},\"tag\":\"level 24\",\"list\":[24,{\"i\":24}]},\"tag\":\"level 25\",\"list\":[25,{\"i\":25}]},\"tag\":\"level 26\",\"list\":[26,{\"i\":26}]},\"tag\":\"level 27\",\"list\":[27,{\"i\":27}]},\"tag\":\"level 28\",\"list\":[28,{\"i\":28}]},\"tag\":\"level 29\",\"list\":[29,{\"i\":29}]},\"tag\":\"level 30\",\"list\":[30,{\"i\":30}]},\"tag\":\"level 31\",\"list\":[31,{\"i\":31}]},\"tag\":\"level 32\",\"list\":[32,{\"i\":32}]},\"tag\":\"level 33\",\"list\":[33,{\"i\":33}]},\"tag\":\"level 34\",\"list\":[34,{\"i\":34}]},\"tag\":\"level 35\",\"list\":[35,{\"i\":35}]},\"tag\":\"level 36\",\"list\":[36,{\"i\":36}]},\"tag\":\"level 37\",\"list\":[37,{\"i\":37}]},\"tag\":\"level 38\",\"list\":[38,{\"i\":38}]},\"tag\":\"level 39\",\"list\":[39,{\"i\":39}]},\"tag\":\"level 40\",\"list\":[40,{\"i\":40}]},\"tag\":\"level 41\",\"list\":[41,{\"i\":41}]},\"tag\":\"level 42\",\"list\":[42,{\"i\":42}]},\"tag\":\"level 43\",\"list\":[43,{\"i\":43}]},\"tag\":\"level 44\",\"list\":[44,{\"i\":44}]},\"tag\":\"level 45\",\"list\":[45,{\"i\":45}]},\"tag\":\"level 46\",\"list\":[46,{\"i\":46}]},\"tag\":\"level 47\",\"list\":[47,{\"i\":47}]},\"tag\":\"level 48\",\"list\":[48,{\"i\":48}]},\"tag\":\"level 49\",\"list\":[49,{\"i\":49}]}},{\"_id\":\"000000000000000000000002\",\"user\":{\"name\":\"bob\",\"tags\":[\"a\",\"b\"]},\"text\":\"Patch your CVE-2021-44228 servers\",\"retweets\":12345678901234}]"; }
	function : Lengths() ~ Int[] { return [673, 118, 3058, 138]; }
# END GENERATED

	# the first difference between a decoded tree and the expected one, or "" when they match
	function : Diff(path : String, got : JsonElement, want : JsonElement) ~ String {
		if(got = Nil | want = Nil) {
			return path + ": missing";
		};

		if(got->GetType() <> want->GetType()) {
			return "{$path}: type differs, got {$got->ToString()} expected {$want->ToString()}";
		};

		kind := want->GetType();
		if(kind = JsonElement->JsonType->STRING) {
			if(got->GetString()->Equals(want->GetString()) = false) {
				return "{$path}: string differs, got '{$got->GetString()}' expected '{$want->GetString()}'";
			};
			return "";
		};

		if(kind = JsonElement->JsonType->NUMBER) {
			if(got->GetValue()->Equals(want->GetValue())) {
				return "";
			};

			a := got->GetFloat();
			b := want->GetFloat();
			if(Float->Abs(a - b) <= 0.000000000001 * Float->Abs(b) | (b = 0.0 & a = 0.0)) {
				return "";
			};
			return "{$path}: number differs, got {$got->GetValue()} expected {$want->GetValue()}";
		};

		if(kind = JsonElement->JsonType->OBJECT) {
			if(got->Size() <> want->Size()) {
				return "{$path}: {$got->Size()} fields, expected {$want->Size()}";
			};

			names := want->GetNames();
			each(i : names) {
				name := names->Get(i);
				if(got->Has(name) = false) {
					return "{$path}.{$name}: missing";
				};

				found := Diff(path + "." + name, got->Get(name), want->Get(name));
				if(found->Size() > 0) {
					return found;
				};
			};
			return "";
		};

		if(kind = JsonElement->JsonType->ARRAY) {
			if(got->Size() <> want->Size()) {
				return "{$path}: {$got->Size()} elements, expected {$want->Size()}";
			};

			for(i := 0; i < want->Size(); i += 1;) {
				found := Diff("{$path}[{$i}]", got->Get(i), want->Get(i));
				if(found->Size() > 0) {
					return found;
				};
			};
		};

		return "";
	}

	function : Check() ~ Bool {
		ok := true;
		bytes := Unhex(DumpHex());
		parser := JsonParser->New(ExpectedJson());
		ok := Report("the expected JSON parses", parser->Parse()) & ok;
		want := parser->GetRoot();
		lengths := Lengths();
		total := 0;
		each(i : lengths) {
			total += lengths[i];
		};
		ok := Report("the dump holds {$bytes->Size()} bytes, the sum of the document lengths", bytes->Size() = total) & ok;

		reader := BsonReader->New(bytes);
		at := 0;
		for(d := 0; d < lengths->Size(); d += 1;) {
			doc := reader->Next();
			at += lengths[d];
			if(doc = Nil) {
				ok := Report("document {$d} decodes: {$reader->GetError()}", false) & ok;
			}
			else {
				found := Diff("doc" + d->ToString(), doc, want->Get(d));
				if(found->Size() > 0) {
					"    {$found}"->PrintLine();
				};
				ok := Report("document {$d} equals what pymongo read, and the reader is at byte {$at}", found->Size() = 0 & reader->GetPosition() = at) & ok;
			};
		};

		first := BsonReader->New(bytes)->Next();
		ok := Report("control: the comparison does notice a different document", Diff("x", first, want->Get(1))->Size() > 0 & Diff("x", first, want->Get(3))->Size() > 0) & ok;
		ok := Report("no error and nothing left", reader->GetError()->Size() = 0 & reader->HasNext() = false) & ok;
		strings := BsonReader->New(bytes)->ExtractStrings("user.name");
		ok := Report("ExtractStrings reaches into pymongo's nested document", strings <> Nil & strings->Size() = 1 & strings->Get(0)->Equals("bob")) & ok;
		return ok;
	}
}
