			[3.8987200364382755, 1.518725848291945, 1.1005978446558293, 3.4515878273934515, 1.5912927083688375, 2.5427239254894927, 2.281680432789215, -2.924211201513123, 1.7852906219865075, 0.7506738038784748, -2.122573943229944, -1.466316129730008],
			[-0.25991697274529546, -1.0040446967921755, -1.2349534028801452, 0.32272683677181924, -3.65029811840106, -3.1451390070985887, 1.9475385401601528, -2.2253005818885967, -3.369122881831869, -2.416390196543108, 1.4727524699936865, 2.8381747109190494]];
		expected := [-0.008199668340914516, -0.0006995301625534723, 0.0017673220044522732, -0.0025581315165277892, -0.006663510445238681, -0.003646267776991644];
		return Check("sigmoid #15", x, t, SvmKernel->SIGMOID, 0.175, 0.0016666666666666668, 1, 0.0, 0.0024241223904556282, expected);
	}

	function : Check(name : String, x : Float[,], t : Float[,], kernel : SvmKernel,
			nu : Float, gamma : Float, degree : Int, coef0 : Float, objective : Float, expected : Float[]) ~ Bool {
		svm := OneClassSVM->New(kernel, nu, gamma, degree, coef0);
		svm->SetTolerance(0.000000001);
		if(<>svm->Fit(x)) {
			error := svm->GetLastError();
			"FAIL: {$name}: Fit failed: {$error}"->PrintLine();
			return false;
		};

		got := svm->GetObjective();
		scale := objective->Abs();
		if(scale < 1.0) {
			scale := 1.0;
		};
		if((got - objective)->Abs() > 0.000001 * scale) {
			"FAIL: {$name}: objective {$got}, reference {$objective}"->PrintLine();
			return false;
		};

		f := svm->DecisionFunction(t);
		diff := 0.0;
		want := 0.0;
		each(i : expected) {
			want := expected[i];
			diff := (f[i] - want)->Abs();
			if(diff > 0.00001 * (1.0 + want->Abs())) {
				have := f[i];
				"FAIL: {$name}: decision value {$i} is {$have}, reference {$want}"->PrintLine();
				return false;
			};
		};

		"PASS: {$name}: objective and decision values match the reference"->PrintLine();
		return true;
	}
}
