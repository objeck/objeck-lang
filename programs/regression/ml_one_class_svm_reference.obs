# EXTRA_LIBS: ml,gen_collect,csv
#~
OneClassSVM against an independent reference, without Python.

Generated by tools/ml/svm_reference/gen_reference_test.py: small random problems,
four per kernel, each solved by the exact KKT enumeration (n <= 7) or by a
plain first-order SMO run to 1e-10 -- neither shares code with the solver in
ml_svm.obs. OneClassSVM, fitted at tol 1e-9, must reach the reference's dual
objective to 1e-6 (relative, floor 1) and its decision values on six unseen
rows to 1e-5. The full comparison (hundreds of problems, support sets, KKT) is
svm_reference.py; this is the part CI can run.

Labels are Int literals converted to Bool, because Bool array literals are
unreliable in large methods; each problem is its own method for the same reason.
~#
use System.ML;

class MlOneClassSvmReference {
	function : Main(args : String[]) ~ Nil {
		ok := true;
		ok := Problem0() & ok;
		ok := Problem1() & ok;
		ok := Problem2() & ok;
		ok := Problem3() & ok;
		ok := Problem4() & ok;
		ok := Problem5() & ok;
		ok := Problem6() & ok;
		ok := Problem7() & ok;
		ok := Problem8() & ok;
		ok := Problem9() & ok;
		ok := Problem10() & ok;
		ok := Problem11() & ok;
		ok := Problem12() & ok;
		ok := Problem13() & ok;
		ok := Problem14() & ok;
		ok := Problem15() & ok;

		if(<>ok) {
			Runtime->Exit(1);
		};
	}

