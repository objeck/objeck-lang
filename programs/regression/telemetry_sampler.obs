# EXTRA_LIBS: telemetry,gen_collect,json
#~
System.Telemetry resource samplers and the energy estimator, with no GPU and no network:

- the nvidia-smi parser on canned output (one GPU, two GPUs, [N/A] fields, Windows line ends,
  a driver warning in front, garbage, a wrong field count),
- the GPU sampler through a real process that prints canned output (echo), and its graceful
  absence when the command does not exist or prints nothing usable,
- the runtime sampler (host memory, threads, collector counts and pauses are read from the
  runtime's own monitors),
- the energy estimator against traces with a known integral (constant, linear ramp, trapezoid,
  partial intervals, a gap, a bounded retention, refused samples),
- a sampler loop fed by a scripted sampler, on the calling thread and on its own thread,
- energy and GPU memory flowing from a loop into a profile.

Tolerances are absolute on floats; nothing compares printed doubles.
~#
use System.Telemetry;
use Collection;
use System.Concurrency;

# power and memory on a script: reading k is stamped k seconds, 100 W, 1234 MB
class ScriptedGpu implements ResourceSampler {
	@k : Int;
	@watts : Float;
	@clock : Bool;

	New(watts : Float, clock : Bool) {
		@k := 0;
		@watts := watts;
		@clock := clock;
	}

	method : public : GetName() ~ String {
		return "scripted";
	}

	method : public : IsAvailable() ~ Bool {
		return true;
	}

	method : public : Sample() ~ ResourceReading {
		t := @k * 1000;
		if(@clock) {
			t := Telemetry->NowMs();
		};
		@k += 1;
		return ResourceReading->New(GpuSampler->Names(), [10.0, 1234.0, @watts, 40.0], t);
	}
}

class TelemetrySamplerTest {
	@failures : static : Int;
	@fed : static : Int;

	function : SetFed(t : Int) ~ Nil {
		@fed := t;
	}

	function : Main(args : String[]) ~ Nil {
		@failures := 0;
		Parser();
		Process();
		RuntimeReadings();
		Energy();
		EqualTimes();
		Loop();
		Wiring();
		Concurrent();
		if(@failures > 0) {
			"telemetry_sampler: {$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
		"telemetry_sampler: ok"->PrintLine();
	}

	function : Parser() ~ Nil {
		v := GpuSampler->ParseLine("25, 2336, 37.90, 33.50");
		Check("one line: four values", v <> Nil & v->Size() = 4);
		Near("utilization 25", v[0], 25.0, 1.0e-12);
		Near("memory 2336", v[1], 2336.0, 1.0e-12);
		Near("power 37.9", v[2], 37.9, 1.0e-12);
		Near("temperature 33.5", v[3], 33.5, 1.0e-12);

		r := GpuSampler->Parse("25, 2336, 37.90, 33.50\n", 0, 42);
		Check("parse the whole output: a reading with names and a time", r <> Nil & r->GetTimeMs() = 42 & r->Size() = 4);
		Near("named: gpu_util_percent", r->Get("gpu_util_percent"), 25.0, 1.0e-12);
		Near("named: gpu_mem_used_mb", r->Get("gpu_mem_used_mb"), 2336.0, 1.0e-12);
		Near("named: gpu_power_w", r->Get("gpu_power_w"), 37.9, 1.0e-12);
		Near("named: gpu_temp_c", r->Get("gpu_temp_c"), 33.5, 1.0e-12);
		Check("an unknown name is NaN", r->Get("nope") <> r->Get("nope"));

		two := "10, 100, 20.00, 30\n90, 9000, 300.5, 71\n";
		Near("second GPU: utilization", GpuSampler->Parse(two, 1, 0)->Get("gpu_util_percent"), 90.0, 1.0e-12);
		Near("second GPU: power", GpuSampler->Parse(two, 1, 0)->Get("gpu_power_w"), 300.5, 1.0e-12);
		Check("a third GPU that is not there: Nil", GpuSampler->Parse(two, 2, 0) = Nil);
		Check("a negative index: Nil", GpuSampler->Parse(two, -1, 0) = Nil);

		na := GpuSampler->Parse("5, 1024, [N/A], [Not Supported]\n", 0, 0);
		Check("[N/A] fields are NaN, the rest read", na <> Nil & na->Get("gpu_power_w") <> na->Get("gpu_power_w") & na->Get("gpu_temp_c") <> na->Get("gpu_temp_c"));
		Near("the numeric fields beside them still read", na->Get("gpu_mem_used_mb"), 1024.0, 1.0e-12);

		win := GpuSampler->Parse("25, 2336, 37.90, 33.50\r\n", 0, 0);
		Check("Windows line ends", win <> Nil);
		Near("Windows line ends: temperature", win->Get("gpu_temp_c"), 33.5, 1.0e-12);

		warn := GpuSampler->Parse("WARNING: a driver notice\n25, 2336, 37.90, 33.50\n", 0, 0);
		Check("a warning line in front is skipped", warn <> Nil);
		Near("and the data after it is the first GPU", warn->Get("gpu_mem_used_mb"), 2336.0, 1.0e-12);

		Check("garbage is not a reading", GpuSampler->Parse("NVIDIA-SMI has failed because it couldn't communicate with the NVIDIA driver.\n", 0, 0) = Nil);
		Check("three fields is not a reading", GpuSampler->ParseLine("1, 2, 3") = Nil);
		Check("five fields is not a reading", GpuSampler->ParseLine("1, 2, 3, 4, 5") = Nil);
		Check("a word in a field is not a reading", GpuSampler->ParseLine("1, two, 3, 4") = Nil);
		Check("empty text is not a reading", GpuSampler->Parse("", 0, 0) = Nil);
		Check("Nil text is not a reading", GpuSampler->Parse(Nil, 0, 0) = Nil);
		Check("the query is the documented one", GpuSampler->Command()->Equals("nvidia-smi --query-gpu=utilization.gpu,memory.used,power.draw,temperature.gpu --format=csv,noheader,nounits"));
	}

	function : Process() ~ Nil {
		# a real process that prints a canned line: the spawn, status and parse path
		ok := GpuSampler->WithCommand("echo 25, 2336, 37.90, 33.50");
		Check("a command that prints a reading is available", ok->IsAvailable());
		r := ok->Sample();
		Check("and Sample returns it", r <> Nil);
		if(r <> Nil) {
			Near("through a process: power", r->Get("gpu_power_w"), 37.9, 1.0e-12);
			Check("through a process: stamped with the runtime clock", r->GetTimeMs() >= 0);
		};

		# no such binary: unavailable, no error, no second process
		gone := GpuSampler->WithCommand("objeck-no-such-binary-4f9a2c");
		Check("a missing command is unavailable, not an error", gone->IsAvailable() = false);
		Check("Sample is Nil", gone->Sample() = Nil);
		Check("and says why", gone->GetError()->Size() > 0);
		first_error := gone->GetError();
		Check("again Nil, the failure is remembered", gone->Sample() = Nil & gone->GetError()->Equals(first_error));

		# a command that works but prints nothing usable
		junk := GpuSampler->WithCommand("echo not a gpu");
		Check("a command with no GPU line is unavailable", junk->IsAvailable() = false & junk->Sample() = Nil & junk->GetError()->Has("no GPU line"));
		junk->Reset();
		Check("Reset clears the verdict", junk->GetError()->Size() = 0);

		# the real thing, whichever machine this is: either a reading or a graceful no
		real := GpuSampler->New();
		got := real->Sample();
		if(got <> Nil) {
			Check("this host has a GPU: utilization is a percentage", got->Get("gpu_util_percent") >= 0.0 & got->Get("gpu_util_percent") <= 100.0);
			Check("this host has a GPU: memory is positive", got->Get("gpu_mem_used_mb") > 0.0);
			"  info: nvidia-smi answered here: {$got->ToString()}"->ErrorLine();
		}
		else {
			Check("no GPU here: unavailable and a reason", real->IsAvailable() = false & real->GetError()->Size() > 0);
			"  info: no nvidia-smi here, the sampler stayed out of the way"->ErrorLine();
		};

		# powermetrics: the interface exists and says no
		pm := PowermetricsSampler->New();
		Check("powermetrics is interface only: unavailable, Nil", pm->IsAvailable() = false & pm->Sample() = Nil & pm->GetName()->Equals("powermetrics"));
	}

	function : RuntimeReadings() ~ Nil {
		rs := RuntimeSampler->New();
		Check("the runtime sampler is available", rs->IsAvailable());
		first := rs->Sample();
		Check("a reading", first <> Nil & first->Size() = RuntimeSampler->Names()->Size());
		Check("resident memory is a plausible byte count", first->Get("rss_bytes") > 1000000.0);
		Check("peak is at least the current", first->Get("rss_peak_bytes") >= first->Get("rss_bytes") * 0.5);
		Check("the main thread is counted", first->Get("threads_active") >= 1.0);
		Check("at least one CPU", first->Get("cpu_count") >= 1.0);
		Check("the first reading has no CPU percent", first->Get("cpu_percent") <> first->Get("cpu_percent"));
		Check("collector counts are numbers", first->Get("gc_minor_count") >= 0.0 & first->Get("gc_major_count") >= 0.0);
		Check("collector pause times are numbers", first->Get("gc_pause_last_us") >= 0.0 & first->Get("gc_pause_max_us") >= 0.0 & first->Get("gc_pause_avg_us") >= 0.0);
		Check("the pause total is derived from the average and the counts", first->Get("gc_pause_total_us") >= 0.0);

		# burn some CPU, allocate, and read again: the counters never go backwards
		keep := Vector->New()<Cell>;
		sum := 0;
		for(i := 0; i < 600000; i += 1;) {
			c := Cell->New(i);
			sum += c->Value();
			if(i % 1000 = 0) {
				keep->AddBack(c);
			};
		};
		second := rs->Sample();
		Check("second reading", second <> Nil);
		Check("CPU time and the collector counts do not go backwards", second->Get("cpu_time_ms") >= first->Get("cpu_time_ms") & second->Get("gc_minor_count") >= first->Get("gc_minor_count") & second->Get("gc_major_count") >= first->Get("gc_major_count"));
		pct := second->Get("cpu_percent");
		Check("the second reading has a CPU percent", pct = pct & pct >= 0.0);
		Check("readings are stamped in order", second->GetTimeMs() >= first->GetTimeMs());
		Check("the work was done", sum > 0 & keep->Size() > 0);
		# run-dependent numbers (memory, CPU time) go to stderr: the differential runner compares stdout only
		"  info: runtime sampler second reading: {$second->ToString()}"->ErrorLine();
	}

	function : Energy() ~ Nil {
		# constant 100 W for 10 s is 1000 J
		c := EnergyEstimator->New();
		for(t := 0; t <= 10; t += 1;) {
			c->AddSample(t->As(Float), 100.0);
		};
		Near("constant 100 W over 10 s: 1000 J", c->GetJoules(), 1000.0, 1.0e-9);
		Near("integrated seconds", c->GetIntegratedSeconds(), 10.0, 1.0e-12);
		Near("mean power 100 W", c->GetMeanWatts(), 100.0, 1.0e-9);
		Near("peak power 100 W", c->GetPeakWatts(), 100.0, 1.0e-12);
		Check("11 samples", c->GetCount() = 11);

		# a linear ramp is integrated exactly by the trapezoid rule: 10 t from 0 to 4 is 80 J
		ramp := EnergyEstimator->New();
		for(t := 0; t <= 4; t += 1;) {
			ramp->AddSample(t->As(Float), 10.0 * t->As(Float));
		};
		Near("ramp 0..40 W over 4 s: 80 J", ramp->GetJoules(), 80.0, 1.0e-9);

		# (0,0) (2,100) (4,100) (6,0): 100 + 200 + 100 = 400 J
		z := EnergyEstimator->New();
		z->AddSample(0.0, 0.0);
		z->AddSample(2.0, 100.0);
		z->AddSample(4.0, 100.0);
		z->AddSample(6.0, 0.0);
		Near("trapezoid: 400 J", z->GetJoules(), 400.0, 1.0e-9);
		Near("mean power 400/6", z->GetMeanWatts(), 400.0 / 6.0, 1.0e-9);
		Near("power at 1 s is interpolated to 50 W", z->PowerAt(1.0), 50.0, 1.0e-9);
		Near("power at 5 s is interpolated to 50 W", z->PowerAt(5.0), 50.0, 1.0e-9);
		Near("between 1 and 5 s: 75 + 200 + 75 = 350 J", z->JoulesBetween(1.0, 5.0), 350.0, 1.0e-9);
		Near("the whole span equals the total", z->JoulesBetween(0.0, 6.0), 400.0, 1.0e-9);
		Near("an interval inside one segment: 2.5 to 3.5 is 100 J", z->JoulesBetween(2.5, 3.5), 100.0, 1.0e-9);
		Near("a zero-length interval is 0 J", z->JoulesBetween(3.0, 3.0), 0.0, 1.0e-12);
		Near("past the last sample the last reading (0 W) is held: 5 to 7 is 25 J", z->JoulesBetween(5.0, 7.0), 25.0, 1.0e-9);
		Check("before the first sample there is nothing to say: NaN", z->JoulesBetween(-1.0, 1.0) <> z->JoulesBetween(-1.0, 1.0));
		Check("a backwards interval is NaN", z->JoulesBetween(4.0, 3.0) <> z->JoulesBetween(4.0, 3.0));

		# a held tail at constant power
		h := EnergyEstimator->New();
		h->AddSample(0.0, 100.0);
		h->AddSample(1.0, 100.0);
		Near("held tail: 0.5 to 1.5 at 100 W is 100 J", h->JoulesBetween(0.5, 1.5), 100.0, 1.0e-9);

		# a held tail is measured from the last sample, not from where the query starts: a reading
		# taken at t = 0 says nothing about 100 s later, however short the query window is
		stale := EnergyEstimator->New();
		stale->SetMaxGap(2.0);
		stale->AddSample(0.0, 10.0);
		Check("a 1 s window 100 s after the only sample has no estimate", stale->JoulesBetween(100.0, 101.0) <> stale->JoulesBetween(100.0, 101.0));
		Near("a window right after it is held: 10 W for 1 s", stale->JoulesBetween(0.5, 1.5), 10.0, 1.0e-9);
		Near("held up to the maximum gap: 10 W for 2 s", stale->JoulesBetween(1.0, 2.0), 10.0, 1.0e-9);
		Check("a window that ends past the maximum gap has no estimate", stale->JoulesBetween(1.0, 2.5) <> stale->JoulesBetween(1.0, 2.5));
		stale->AddSample(1.0, 10.0);
		Near("after a second sample the hold counts from it: 1 to 2.5", stale->JoulesBetween(1.0, 2.5), 15.0, 1.0e-9);
		Check("and not from the query's start: 50 to 51 is stale", stale->JoulesBetween(50.0, 51.0) <> stale->JoulesBetween(50.0, 51.0));

		# refused samples change nothing
		r := EnergyEstimator->New();
		r->AddSample(1.0, 50.0);
		Check("an earlier time is refused", r->AddSample(0.5, 50.0) = false);
		Check("negative power is refused", r->AddSample(2.0, -1.0) = false);
		Check("NaN power is refused", r->AddSample(2.0, Float->NaN()) = false);
		Check("NaN time is refused", r->AddSample(Float->NaN(), 5.0) = false);
		Check("only the first sample counted, no energy yet", r->GetCount() = 1 & r->GetJoules() = 0.0);
		Check("a repeated time is allowed (zero duration)", r->AddSample(1.0, 60.0));
		Check("no samples: mean power is NaN", EnergyEstimator->New()->GetMeanWatts() <> EnergyEstimator->New()->GetMeanWatts());

		# a gap longer than the maximum is not integrated
		g := EnergyEstimator->New();
		g->SetMaxGap(1.5);
		g->AddSample(0.0, 100.0);
		g->AddSample(1.0, 100.0);
		g->AddSample(5.0, 100.0);
		g->AddSample(6.0, 100.0);
		Near("the 4 s gap is skipped: 200 J", g->GetJoules(), 200.0, 1.0e-9);
		Near("and counted as skipped", g->GetSkippedSeconds(), 4.0, 1.0e-12);
		Check("an interval across the gap has no estimate", g->JoulesBetween(0.5, 5.5) <> g->JoulesBetween(0.5, 5.5));
		Near("an interval clear of the gap does", g->JoulesBetween(5.0, 6.0), 100.0, 1.0e-9);

		# only the last N samples are retained for JoulesBetween, the total stays exact
		b := EnergyEstimator->New(3);
		for(t := 0; t < 10; t += 1;) {
			b->AddSample(t->As(Float), 1.0);
		};
		Near("total over all 10 samples: 9 J", b->GetJoules(), 9.0, 1.0e-12);
		Near("retained span (7..9): 7.5 to 9 is 1.5 J", b->JoulesBetween(7.5, 9.0), 1.5, 1.0e-12);
		Check("before the retained span: NaN", b->JoulesBetween(2.0, 3.0) <> b->JoulesBetween(2.0, 3.0));
	}

	# Samples that share a time are a step in the power. An interval that starts on the step
	# starts at the power after it (the last sample at that time), one that ends on it ends at
	# the power before it (the first), and an interval across it gets both sides. JoulesBetween
	# started at the first sample of the step and ramped: 0 W then 100 W at 1 s, held to 2 s,
	# is 100 J in total and was 50 J for "1 to 2 s".
	function : EqualTimes() ~ Nil {
		# a step up in the middle
		up := EnergyEstimator->New();
		up->AddSample(0.0, 0.0);
		up->AddSample(1.0, 0.0);
		up->AddSample(1.0, 100.0);
		up->AddSample(2.0, 100.0);
		Near("step up at 1 s: the total is 100 J", up->GetJoules(), 100.0, 1.0e-9);
		Near("step up: 1 to 2 s is all of it, 100 J", up->JoulesBetween(1.0, 2.0), 100.0, 1.0e-9);
		Near("step up: 0 to 1 s is 0 J", up->JoulesBetween(0.0, 1.0), 0.0, 1.0e-9);
		Near("step up: 0 to 2 s is 100 J", up->JoulesBetween(0.0, 2.0), 100.0, 1.0e-9);
		Near("step up: 0.5 to 1.5 s is 50 J", up->JoulesBetween(0.5, 1.5), 50.0, 1.0e-9);
		Near("step up: 1 to 1.5 s is 50 J", up->JoulesBetween(1.0, 1.5), 50.0, 1.0e-9);
		Near("step up: 1.5 to 2 s is 50 J", up->JoulesBetween(1.5, 2.0), 50.0, 1.0e-9);
		Near("step up: 0 to 0.5 s is 0 J", up->JoulesBetween(0.0, 0.5), 0.0, 1.0e-9);
		Near("step up: 0.25 to 1 s, ending on the step, is 0 J", up->JoulesBetween(0.25, 1.0), 0.0, 1.0e-9);
		Near("step up: a zero-length interval on the step is 0 J", up->JoulesBetween(1.0, 1.0), 0.0, 1.0e-12);
		Near("step up: 1 to 3 s holds the last reading, 200 J", up->JoulesBetween(1.0, 3.0), 200.0, 1.0e-9);
		Near("step up: 2 to 3 s is the held tail, 100 J", up->JoulesBetween(2.0, 3.0), 100.0, 1.0e-9);
		Near("step up: the two halves add up to the total", up->JoulesBetween(0.0, 1.0) + up->JoulesBetween(1.0, 2.0), up->GetJoules(), 1.0e-9);
		Check("step up: before the first sample is still NaN", up->JoulesBetween(-1.0, 2.0) <> up->JoulesBetween(-1.0, 2.0));

		# a step down: the interval after it has no energy
		down := EnergyEstimator->New();
		down->AddSample(0.0, 100.0);
		down->AddSample(1.0, 100.0);
		down->AddSample(1.0, 0.0);
		down->AddSample(2.0, 0.0);
		Near("step down: 0 to 1 s is 100 J", down->JoulesBetween(0.0, 1.0), 100.0, 1.0e-9);
		Near("step down: 1 to 2 s is 0 J", down->JoulesBetween(1.0, 2.0), 0.0, 1.0e-9);
		Near("step down: 0.5 to 1.5 s is 50 J", down->JoulesBetween(0.5, 1.5), 50.0, 1.0e-9);
		Near("step down: 0 to 2 s is the total", down->JoulesBetween(0.0, 2.0), down->GetJoules(), 1.0e-9);

		# three samples at one time in the middle: the last one counts from there on
		three := EnergyEstimator->New();
		three->AddSample(0.0, 0.0);
		three->AddSample(1.0, 0.0);
		three->AddSample(1.0, 40.0);
		three->AddSample(1.0, 100.0);
		three->AddSample(2.0, 100.0);
		Near("three at 1 s: the total is 100 J", three->GetJoules(), 100.0, 1.0e-9);
		Near("three at 1 s: 1 to 2 s is 100 J", three->JoulesBetween(1.0, 2.0), 100.0, 1.0e-9);
		Near("three at 1 s: 0 to 1 s is 0 J", three->JoulesBetween(0.0, 1.0), 0.0, 1.0e-9);
		Near("three at 1 s: 0.5 to 2 s is 100 J", three->JoulesBetween(0.5, 2.0), 100.0, 1.0e-9);

		# equal times at the very start
		first := EnergyEstimator->New();
		first->AddSample(0.0, 5.0);
		first->AddSample(0.0, 7.0);
		first->AddSample(0.0, 10.0);
		first->AddSample(1.0, 10.0);
		Near("three at the start: the total is 10 J", first->GetJoules(), 10.0, 1.0e-9);
		Near("three at the start: 0 to 1 s is 10 J", first->JoulesBetween(0.0, 1.0), 10.0, 1.0e-9);
		Near("three at the start: 0 to 0.5 s is 5 J", first->JoulesBetween(0.0, 0.5), 5.0, 1.0e-9);
		Near("three at the start: 0.5 to 1 s is 5 J", first->JoulesBetween(0.5, 1.0), 5.0, 1.0e-9);

		# equal times at the very end: the held tail is the last reading
		last := EnergyEstimator->New();
		last->AddSample(0.0, 10.0);
		last->AddSample(1.0, 10.0);
		last->AddSample(1.0, 50.0);
		Near("two at the end: the total is 10 J", last->GetJoules(), 10.0, 1.0e-9);
		Near("two at the end: 0 to 1 s is 10 J", last->JoulesBetween(0.0, 1.0), 10.0, 1.0e-9);
		Near("two at the end: 1 to 2 s holds 50 W, 50 J", last->JoulesBetween(1.0, 2.0), 50.0, 1.0e-9);
		Near("two at the end: 0.5 to 2 s is 5 + 50 J", last->JoulesBetween(0.5, 2.0), 55.0, 1.0e-9);
		Near("two at the end: 1.5 to 2 s is 25 J", last->JoulesBetween(1.5, 2.0), 25.0, 1.0e-9);

		# a step, then a ramp: the start value is the one after the step, the rest interpolates
		ramp := EnergyEstimator->New();
		ramp->AddSample(0.0, 0.0);
		ramp->AddSample(1.0, 0.0);
		ramp->AddSample(1.0, 100.0);
		ramp->AddSample(3.0, 200.0);
		Near("step then ramp: 1 to 3 s is 300 J", ramp->JoulesBetween(1.0, 3.0), 300.0, 1.0e-9);
		Near("step then ramp: 1 to 2 s is 125 J", ramp->JoulesBetween(1.0, 2.0), 125.0, 1.0e-9);
		Near("step then ramp: 2 to 3 s is 175 J", ramp->JoulesBetween(2.0, 3.0), 175.0, 1.0e-9);

		# the step survives the ring wrapping: only the last four samples are kept
		ring := EnergyEstimator->New(4);
		for(t := 0; t < 10; t += 1;) {
			ring->AddSample(t->As(Float), 1.0);
		};
		ring->AddSample(10.0, 1.0);
		ring->AddSample(10.0, 9.0);
		ring->AddSample(11.0, 9.0);
		Near("wrapped ring: 10 to 11 s after the step is 9 J", ring->JoulesBetween(10.0, 11.0), 9.0, 1.0e-9);
		Near("wrapped ring: 9 to 10 s before it is 1 J", ring->JoulesBetween(9.0, 10.0), 1.0, 1.0e-9);
	}

	function : Loop() ~ Nil {
		# on the calling thread: reading k is at k seconds, 100 W
		est := EnergyEstimator->New();
		looper := SamplerLoop->New(ScriptedGpu->New(100.0, false), 10);
		looper->SetEnergy(est, "gpu_power_w");
		for(i := 0; i <= 5; i += 1;) {
			looper->SampleOnce();
		};
		Check("six readings were taken", looper->GetCount() = 6);
		Near("100 W over 5 s: 500 J", est->GetJoules(), 500.0, 1.0e-9);
		Near("the last reading is the 6th", looper->GetLast()->GetTimeMs()->As(Float), 5000.0, 1.0e-9);
		Near("the maximum of a value over the readings", looper->MaxOf("gpu_mem_used_mb"), 1234.0, 1.0e-9);
		Check("an unknown value has no maximum", looper->MaxOf("nope") <> looper->MaxOf("nope"));
		looper->Stop();

		# on its own thread: starts, samples, stops
		threaded := SamplerLoop->New(ScriptedGpu->New(80.0, true), 1);
		Check("it starts", threaded->Start());
		Check("a second Start is refused", threaded->Start() = false);
		waited := 0;
		while(threaded->GetCount() < 3 & waited < 5000) {
			Thread->Sleep(5);
			waited += 5;
		};
		threaded->Stop();
		n := threaded->GetCount();
		Check("the thread took readings", n >= 3);
		Thread->Sleep(30);
		Check("and stopped taking them after Stop", threaded->GetCount() = n);

		# an unavailable source: Start declines, nothing runs
		dead := SamplerLoop->New(GpuSampler->WithCommand("objeck-no-such-binary-4f9a2c"), 10);
		Check("an unavailable source does not start", dead->Start() = false);
		Check("and reads nothing", dead->GetLast() = Nil & dead->GetCount() = 0);
	}

	function : Wiring() ~ Nil {
		# power and GPU memory from a loop land in the profile: a clocked 100 W source, one reading
		# before the call, none after (the last reading is held across the call)
		est := EnergyEstimator->New();
		looper := SamplerLoop->New(ScriptedGpu->New(100.0, true), 1000);
		looper->SetEnergy(est, "gpu_power_w");
		looper->SampleOnce();
		rec := TimingRecorder->New();
		rec->AttachSampler(looper);
		probe := rec->Start("net", "cuda", 1, "");
		Thread->Sleep(20);
		ms := probe->Stop();
		p := rec->GetStore()->Predict("net", "cuda", 1);
		Check("the call was recorded", p <> Nil & p->GetCount() = 1);
		j := p->GetJoulesPerRun();
		# The measured joules and milliseconds are run-dependent: stderr, not the check's name.
		# The energy interval is read from the clock after the timer stops (Finish reads the host
		# memory first), so on a loaded machine it can run past the timed milliseconds by a
		# scheduling delay, not a fixed 3 ms: master CI run 45789463714 (macOS, every method
		# compiled) got 17.1 J for 167.96 ms, 4 ms over a 3 ms allowance. The bound is twice the
		# call plus 100 ms of slack, still far below an integral over the wrong span or in the
		# wrong units, which is what this check guards against.
		"  info: energy per run {$j} J for {$ms} ms"->ErrorLine();
		Check("energy per run: 100 W for the call's ~20 ms, between 1 J and about the call's milliseconds", j = j & j >= 1.0 & j <= 100.0 * (2.0 * ms + 100.0) / 1000.0);
		Near("GPU memory from the latest reading", p->GetGpuMemory(), 1234.0, 1.0e-9);

		# energy and memory fed by hand average per run
		store := ProfileStore->New();
		e := store->Entry("m", "d", 1, "");
		e->AddEnergy(5.0);
		e->AddEnergy(7.0);
		e->AddEnergy(Float->NaN());
		e->RecordGpuMemory(100.0);
		e->RecordGpuMemory(300.0);
		e->RecordGpuMemory(200.0);
		e->RecordHostMemory(5.0e8);
		store->Record("m", "d", 1, "", 4.0);
		q := store->Predict("m", "d", 1);
		Near("joules per run is the mean over runs with a reading: 6 J", q->GetJoulesPerRun(), 6.0, 1.0e-12);
		Near("GPU memory keeps the largest", q->GetGpuMemory(), 300.0, 1.0e-12);
		Near("host memory", q->GetHostMemory(), 5.0e8, 1.0);

		# energy and memory survive JSON
		back := ProfileStore->FromJsonString(store->ToJsonString());
		bq := back->Predict("m", "d", 1);
		Check("after JSON: energy, GPU and host memory", bq <> Nil & Float->Abs(bq->GetJoulesPerRun() - 6.0) < 1.0e-12 & bq->GetGpuMemory() = 300.0 & bq->GetHostMemory() = 5.0e8);
	}

	# A sampler thread adds samples while a call asks for its energy. A 1 W source sampled every
	# second, the ring full and wrapping: the energy of a window 100 samples back is 10 J, and a
	# window of retained samples is never NaN (the gap limit is 1.5 s, so a reader that saw the
	# ring half moved, two samples that are not neighbours, would answer NaN or something else).
	function : Concurrent() ~ Nil {
		est := EnergyEstimator->New(8192);
		est->SetMaxGap(1.5);
		for(t := 0; t < 8192; t += 1;) {
			est->AddSample(t->As(Float), 1.0);
		};
		@fed := 8191;
		writer := EnergyWriter->New(est, 8192, 400000);
		# readers that ask again the moment they are answered: a mutex that does not favor the waiting
		# writer (macOS, Linux) lets them keep it out, so the energy estimator has to stand them aside
		pressure := Vector->New()<EnergyReader>;
		for(r := 0; r < 3; r += 1;) {
			reader := EnergyReader->New(est);
			pressure->AddBack(reader);
			reader->Execute(Nil);
		};
		writer->Execute(Nil);
		bad := 0;
		reads := 0;
		stalled := false;
		last_fed := @fed;
		last_move := Telemetry->NowMs();
		while(@fed < 400000 - 1 & stalled = false) {
			# the sampler must keep moving: a hang is a failure with a message, not a timeout
			if(@fed <> last_fed) {
				last_fed := @fed;
				last_move := Telemetry->NowMs();
			}
			else if(Telemetry->NowMs() - last_move > 20000) {
				stalled := true;
			};
			head := @fed;
			j := est->JoulesBetween((head - 100)->As(Float), (head - 90)->As(Float));
			# a reader the machine held back while the writer lapped the ring asked about samples that
			# are gone, and NaN is the right answer then: only a window still retained counts
			if(@fed - head < 8000) {
				reads += 1;
				if(j <> j | Float->Abs(j - 10.0) > 1.0e-6) {
					bad += 1;
				};
			};
		};
		each(rd in pressure) {
			rd->Stop();
		};
		if(stalled) {
			"  FAIL: the sampler thread stopped adding samples for 20 s while the energy was read (starved by its readers)"->PrintLine();
			@failures += 1;
			return;
		};
		writer->Join();
		each(rd in pressure) {
			rd->Join();
		};
		"  info: {$reads} reads while the sampler wrote, {$bad} torn"->ErrorLine();
		Check("energy read while samples are added is never torn", bad = 0 & reads > 0);
		Near("and the total stayed exact", est->GetJoules(), 399999.0, 1.0e-6);
	}

	function : Near(name : String, got : Float, want : Float, tol : Float) ~ Nil {
		Check("{$name} (got {$got}, want {$want})", got = got & Float->Abs(got - want) <= tol);
	}

	function : Check(name : String, ok : Bool) ~ Nil {
		if(ok) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
			@failures += 1;
		};
	}
}

class EnergyWriter from Thread {
	@est : EnergyEstimator;
	@first : Int;
	@to : Int;

	New(est : EnergyEstimator, first : Int, to : Int) {
		Parent();
		@est := est;
		@first := first;
		@to := to;
	}

	method : public : Run(param : System.Base) ~ Nil {
		for(t := @first; t < @to; t += 1;) {
			@est->AddSample(t->As(Float), 1.0);
			TelemetrySamplerTest->SetFed(t);
		};
	}
}

class EnergyReader from Thread {
	@est : EnergyEstimator;
	@running : Bool;

	New(est : EnergyEstimator) {
		Parent();
		@est := est;
		@running := true;
	}

	method : public : Stop() ~ Nil {
		@running := false;
	}

	method : public : Run(param : System.Base) ~ Nil {
		while(@running) {
			@est->JoulesBetween(1000.0, 1050.0);
		};
	}
}

class Cell {
	@v : Int;

	New(v : Int) {
		@v := v;
	}

	method : public : Value() ~ Int {
		return @v;
	}
}
