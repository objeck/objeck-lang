# EXPECT_COMPILE_ERROR: (25,23): Variable already defined in this scope: 't'
# EXPECT_ERROR_COUNT: 1
#~
The bound name is declared in the block as `name : Type` is, so it cannot be a declared variable's name.
~#
class Part {
	New() {
	}
}

class TextPart from Part {
	New() {
		Parent();
	}

	method : public : Size() ~ Int {
		return 4;
	}
}

class BadTypeTestNameTaken {
	function : Main(args : String[]) ~ Nil {
		p : Part := TextPart->New();
		t : Int := 3;
		if(p is TextPart t) {
			t->Size()->PrintLine();
		};
	}
}
