# EXTRA_LIBS: openai,json,net,net_server,cipher,misc
#~
API.OpenAI response parsing, tested offline from recorded bodies that follow the
public API reference (no key, no network). Each Parse* function is the half of
an API call that turns the HTTP body into objects.

Defects this guards:
- Response->GetText() returned Nil for any reply with more than one output, so
  every reasoning-model reply (a 'reasoning' output, then the 'message') read as
  empty; and it dereferenced Nil on a function_call output (no 'content').
- A 'refusal' content part (it has no 'text') dereferenced Nil.
- An image item in b64_json form (gpt-image-1 always, DALL-E on request) has no
  'url' and dereferenced Nil.
- A Nil or non-JSON body, or a listing without 'data', dereferenced Nil.

Embedding and moderation fixtures avoid exponent notation (real bodies often
carry values such as -4.0583e-05); add such cases once the JSON lexer reads them.
~#

use Collection, API.OpenAI.Responses, API.OpenAI.Chat, API.OpenAI;

class OpenAIParseTest {
  @failures : static : Int;

  function : Check(name : String, ok : Bool) ~ Nil {
    if(ok) {
      "  [PASS] {$name}"->PrintLine();
    }
    else {
      "  [FAIL] {$name}"->PrintLine();
      @failures += 1;
    };
  }

  function : Near(a : Float, b : Float) ~ Bool {
    d := a - b;
    if(d < 0.0) {
      d := d * -1.0;
    };
    return d < 0.0000001;
  }

  function : Same(a : String, b : String) ~ Bool {
    return a <> Nil & a->Equals(b);
  }

  function : HasError(text : String) ~ Bool {
    err := EndPoint->GetLastError();
    return err <> Nil & err->Find(text) > -1;
  }

  function : Main(args : String[]) ~ Nil {
    @failures := 0;

    TestResponses();
    TestChat();
    TestEmbedding();
    TestImages();
    TestFiles();
    TestModeration();
    TestBatch();

    if(@failures > 0) {
      "FAIL: {$@failures} check(s) failed"->PrintLine();
      Runtime->Exit(1);
    };
    "PASS: OpenAI response parsing"->PrintLine();
  }

  function : ErrorBody() ~ String {
    return "{\"error\":{\"message\":\"Incorrect API key provided: sk-test. You can find your API key at https://platform.openai.com/account/api-keys.\",\"type\":\"invalid_request_error\",\"param\":null,\"code\":\"invalid_api_key\"}}";
  }

  function : TestResponses() ~ Nil {
    "Responses API"->PrintLine();

    # a plain reply; a success body carries "error": null, which is not an error
    body := "{\"id\":\"resp_67ccd2bed1ec8190b14f964abc0542670bb6a6b452d3795b\",\"object\":\"response\",\"created_at\":1741476542,\"status\":\"completed\",\"error\":null,\"incomplete_details\":null,\"instructions\":null,\"max_output_tokens\":null,\"model\":\"gpt-4.1-2025-04-14\",\"output\":[{\"type\":\"message\",\"id\":\"msg_67ccd2bf17f0819081ff3bb2cf6508e60bb6a6b452d3795b\",\"status\":\"completed\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"text\":\"In a peaceful grove beneath a silver moon, a unicorn named Lumina discovered a hidden pool.\",\"annotations\":[]}]}],\"parallel_tool_calls\":true,\"previous_response_id\":null,\"reasoning\":{\"effort\":null,\"summary\":null},\"store\":true,\"temperature\":1.0,\"text\":{\"format\":{\"type\":\"text\"}},\"tool_choice\":\"auto\",\"tools\":[],\"top_p\":1.0,\"truncation\":\"disabled\",\"usage\":{\"input_tokens\":36,\"input_tokens_details\":{\"cached_tokens\":0},\"output_tokens\":87,\"output_tokens_details\":{\"reasoning_tokens\":0},\"total_tokens\":123},\"user\":null,\"metadata\":{}}";
    resp := Response->ParseResponse(body);
    Check("a reply parses", resp <> Nil);
    if(resp <> Nil) {
      Check("id", Same(resp->GetId(), "resp_67ccd2bed1ec8190b14f964abc0542670bb6a6b452d3795b"));
      Check("object", Same(resp->GetObject(), "response"));
      Check("model", Same(resp->GetModel(), "gpt-4.1-2025-04-14"));
      Check("created_at", resp->GetCreatedAt() = 1741476542);
      Check("one output", resp->GetOutputs()->Size() = 1);
      Check("text", Same(resp->GetText(), "In a peaceful grove beneath a silver moon, a unicorn named Lumina discovered a hidden pool."));
      Check("output role", Same(resp->GetOutputs()->Get(0)->GetRole(), "assistant"));
      Check("ToString does not crash", resp->ToString() <> Nil);
    };

    # a reasoning model: a 'reasoning' output first, then the message
    body := "{\"id\":\"resp_6820f382ee1c8191bc096bee70894d040ac5ba57aafcbac7\",\"object\":\"response\",\"created_at\":1746989954,\"status\":\"completed\",\"error\":null,\"model\":\"o4-mini-2025-04-16\",\"output\":[{\"id\":\"rs_6820f383d7c08191846711c5df8233bc0ac5ba57aafcbac7\",\"type\":\"reasoning\",\"summary\":[{\"type\":\"summary_text\",\"text\":\"Comparing the two numbers.\"}]},{\"id\":\"msg_6820f3866bbc8191adf2bf6f5b3e3a0f0ac5ba57aafcbac7\",\"type\":\"message\",\"status\":\"completed\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"text\":\"9.11 is smaller than 9.9.\"}],\"role\":\"assistant\"}],\"usage\":{\"input_tokens\":20,\"output_tokens\":180,\"output_tokens_details\":{\"reasoning_tokens\":128},\"total_tokens\":200}}";
    resp := Response->ParseResponse(body);
    Check("a reasoning reply parses", resp <> Nil);
    if(resp <> Nil) {
      Check("two outputs", resp->GetOutputs()->Size() = 2);
      Check("reasoning reply text comes from the message output", Same(resp->GetText(), "9.11 is smaller than 9.9."));
      summaries := resp->GetOutputs()->Get(0)->GetSummaries();
      Check("reasoning summary", summaries <> Nil & summaries->Size() = 1 & Same(summaries->Get(0)->GetSecond(), "Comparing the two numbers."));
    };

    # a message split into two text parts reads as one text
    body := "{\"id\":\"resp_1\",\"object\":\"response\",\"created_at\":1746989954,\"error\":null,\"model\":\"gpt-4.1\",\"output\":[{\"id\":\"msg_1\",\"type\":\"message\",\"status\":\"completed\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"text\":\"Hello, \"},{\"type\":\"output_text\",\"annotations\":[],\"text\":\"world.\"}]}]}";
    resp := Response->ParseResponse(body);
    Check("parts concatenate", resp <> Nil & Same(resp->GetText(), "Hello, world."));

    # the text is decoded: GetText() returned the escapes as sent, and callers
    # had to JsonElement->Decode it
    body := "{\"id\":\"resp_e\",\"object\":\"response\",\"created_at\":1746989954,\"error\":null,\"model\":\"gpt-4.1\",\"output\":[{\"id\":\"msg_e\",\"type\":\"message\",\"status\":\"completed\",\"role\":\"assistant\",\"content\":[{\"type\":\"output_text\",\"annotations\":[],\"text\":\"Say \\\"hi\\\"\\nC:\\\\new \\u00e9 a\\/b\"}]}]}";
    resp := Response->ParseResponse(body);
    escaped_want := "Say \"hi\"\nC:\\new ";
    escaped_want->Append(0xE9->As(Char));
    escaped_want += " a/b";
    Check("reply text is decoded once", resp <> Nil & Same(resp->GetText(), escaped_want));

    # an error message is decoded once: a real backslash survives
    EndPoint->SetLastError(Nil);
    Response->ParseResponse("{\"error\":{\"message\":\"bad path C:\\\\new \\\"x\\\"\",\"type\":\"invalid_request_error\",\"param\":null,\"code\":null}}");
    Check("an error message is decoded once", Same(EndPoint->GetLastError(), "bad path C:\\new \"x\""));

    # a function call: no 'content', so no text
    body := "{\"id\":\"resp_2\",\"object\":\"response\",\"created_at\":1741294021,\"status\":\"completed\",\"error\":null,\"model\":\"gpt-4.1-2025-04-14\",\"output\":[{\"type\":\"function_call\",\"id\":\"fc_67ca09c6bedc8190a7abfec07b1a1332096610f474011cc0\",\"call_id\":\"call_unLAR8MvFNptuiZK6K6HCy5k\",\"name\":\"get_current_weather\",\"arguments\":\"{}\",\"status\":\"completed\"}]}";
    resp := Response->ParseResponse(body);
    Check("a function call reply parses", resp <> Nil);
    if(resp <> Nil) {
      Check("a function call has no text", resp->GetText() = Nil);
      Check("function call output type", Same(resp->GetOutputs()->Get(0)->GetType(), "function_call"));
      Check("function call ToString does not crash", resp->ToString() <> Nil);
    };

    # a refusal part carries 'refusal', not 'text'
    body := "{\"id\":\"resp_3\",\"object\":\"response\",\"created_at\":1741294021,\"error\":null,\"model\":\"gpt-4o\",\"output\":[{\"type\":\"message\",\"id\":\"msg_3\",\"status\":\"completed\",\"role\":\"assistant\",\"content\":[{\"type\":\"refusal\",\"refusal\":\"I am sorry, I cannot help with that.\"}]}]}";
    resp := Response->ParseResponse(body);
    Check("a refusal parses", resp <> Nil);
    if(resp <> Nil) {
      Check("a refusal is not reply text", resp->GetText() = Nil);
      part := resp->GetOutputs()->Get(0)->GetContents()->Get(0);
      Check("the refusal text is kept", Same(part->GetType(), "refusal") & Same(part->GetText(), "I am sorry, I cannot help with that."));
    };

    # error, non-JSON, empty
    EndPoint->SetLastError(Nil);
    Check("an error body yields Nil", Response->ParseResponse(ErrorBody()) = Nil);
    Check("an error body sets the last error", HasError("Incorrect API key provided"));
    EndPoint->SetLastError(Nil);
    Check("a non-JSON body yields Nil", Response->ParseResponse("<html><body>502 Bad Gateway</body></html>") = Nil);
    Check("a non-JSON body sets the last error", HasError("Unable to parse"));
    Check("a Nil body yields Nil", Response->ParseResponse(Nil) = Nil);
    resp := Response->ParseResponse("{\"id\":\"resp_4\",\"object\":\"response\"}");
    Check("a body without 'output' has no text", resp <> Nil & resp->GetText() = Nil & resp->GetOutputs()->Size() = 0);
  }

  function : TestChat() ~ Nil {
    "Chat completions"->PrintLine();

    body := "{\"id\":\"chatcmpl-B9MBs8CjcvOU2jLn4n570S5qMJKcT\",\"object\":\"chat.completion\",\"created\":1741569952,\"model\":\"gpt-4.1-2025-04-14\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":\"Hello! How can I assist you today?\",\"refusal\":null,\"annotations\":[]},\"logprobs\":null,\"finish_reason\":\"stop\"}],\"usage\":{\"prompt_tokens\":19,\"completion_tokens\":10,\"total_tokens\":29,\"prompt_tokens_details\":{\"cached_tokens\":0,\"audio_tokens\":0},\"completion_tokens_details\":{\"reasoning_tokens\":0,\"audio_tokens\":0,\"accepted_prediction_tokens\":0,\"rejected_prediction_tokens\":0}},\"service_tier\":\"default\",\"system_fingerprint\":null}";
    comp := Completion->ParseCompletion(body);
    Check("a completion parses", comp <> Nil);
    if(comp <> Nil) {
      Check("id", Same(comp->GetId(), "chatcmpl-B9MBs8CjcvOU2jLn4n570S5qMJKcT"));
      Check("object", Same(comp->GetObject(), "chat.completion"));
      Check("created", comp->GetCreatedAt() = 1741569952);
      choice := comp->GetFirstChoice();
      Check("first choice", choice <> Nil);
      if(choice <> Nil) {
        Check("role", Same(choice->GetMessage()->GetFirst(), "assistant"));
        Check("content", Same(choice->GetMessage()->GetSecond(), "Hello! How can I assist you today?"));
        Check("finish_reason", Same(choice->GetFinishReason(), "stop"));
        Check("index", choice->GetIndex() = 0);
      };
    };

    # a tool call: content is null
    body := "{\"id\":\"chatcmpl-abc123\",\"object\":\"chat.completion\",\"created\":1699896916,\"model\":\"gpt-4o-mini\",\"choices\":[{\"index\":0,\"message\":{\"role\":\"assistant\",\"content\":null,\"tool_calls\":[{\"id\":\"call_abc123\",\"type\":\"function\",\"function\":{\"name\":\"get_current_weather\",\"arguments\":\"{}\"}}]},\"logprobs\":null,\"finish_reason\":\"tool_calls\"}],\"usage\":{\"prompt_tokens\":82,\"completion_tokens\":17,\"total_tokens\":99}}";
    comp := Completion->ParseCompletion(body);
    Check("a tool call completion parses", comp <> Nil & comp->GetFirstChoice() <> Nil);
    if(comp <> Nil & comp->GetFirstChoice() <> Nil) {
      Check("a null content reads as empty", Same(comp->GetFirstChoice()->GetMessage()->GetSecond(), ""));
      Check("tool_calls finish reason", Same(comp->GetFirstChoice()->GetFinishReason(), "tool_calls"));
    };

    EndPoint->SetLastError(Nil);
    Check("an error body yields Nil", Completion->ParseCompletion(ErrorBody()) = Nil);
    Check("an error body sets the last error", HasError("Incorrect API key provided"));
    Check("a non-JSON body yields Nil", Completion->ParseCompletion("upstream connect error") = Nil);
    comp := Completion->ParseCompletion("{\"id\":\"chatcmpl-x\",\"object\":\"chat.completion\"}");
    Check("no choices yields no first choice", comp <> Nil & comp->GetFirstChoice() = Nil);
  }

  function : TestEmbedding() ~ Nil {
    "Embeddings"->PrintLine();

    body := "{\"object\":\"list\",\"data\":[{\"object\":\"embedding\",\"index\":0,\"embedding\":[0.0023064255,-0.009327292,0.015797347,-0.0077780345]}],\"model\":\"text-embedding-3-small\",\"usage\":{\"prompt_tokens\":8,\"total_tokens\":8}}";
    values := Embedding->ParseEmbedding(body);
    Check("an embedding parses", values <> Nil & values->Size() = 4);
    if(values <> Nil & values->Size() = 4) {
      Check("first value", Near(values[0], 0.0023064255));
      Check("negative value", Near(values[1], -0.009327292));
      Check("last value", Near(values[3], -0.0077780345));
    };

    EndPoint->SetLastError(Nil);
    Check("an error body yields Nil", Embedding->ParseEmbedding(ErrorBody()) = Nil);
    Check("an error body sets the last error", HasError("Incorrect API key provided"));
    EndPoint->SetLastError(Nil);
    Check("a body without data yields Nil", Embedding->ParseEmbedding("{\"object\":\"list\"}") = Nil);
    Check("a body without data sets the last error", HasError("no embedding"));
  }

  function : TestImages() ~ Nil {
    "Images"->PrintLine();

    body := "{\"created\":1713833628,\"data\":[{\"url\":\"https://example.com/img-1.png\",\"revised_prompt\":\"A cute baby sea otter\"},{\"url\":\"https://example.com/img-2.png\"}]}";
    image := API.OpenAI.Image->ParseImage(body);
    Check("a URL image result parses", image <> Nil);
    if(image <> Nil) {
      Check("created", image->GetCreatedAt() = 1713833628);
      urls := image->GetUrls();
      Check("two urls", urls->Size() = 2 & urls[0] <> Nil & urls[1] <> Nil);
    };

    # gpt-image-1 always returns b64_json
    body := "{\"created\":1713833628,\"data\":[{\"b64_json\":\"iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNkYPhfDwAChwGA60e6kgAAAABJRU5ErkJggg==\"}],\"usage\":{\"total_tokens\":100,\"input_tokens\":50,\"output_tokens\":50,\"input_tokens_details\":{\"text_tokens\":10,\"image_tokens\":40}}}";
    image := API.OpenAI.Image->ParseImage(body);
    Check("a b64_json image result parses", image <> Nil);
    if(image <> Nil) {
      Check("no url for a b64_json image", image->GetUrls()->Size() = 1 & image->GetUrls()[0] = Nil);
      data := image->GetBase64Images();
      Check("b64_json data", data->Size() = 1 & data[0] <> Nil & data[0]->StartsWith("iVBORw0KGgo"));
    };

    EndPoint->SetLastError(Nil);
    Check("an error body yields Nil", API.OpenAI.Image->ParseImage("{\"error\":{\"code\":\"content_policy_violation\",\"message\":\"Your request was rejected as a result of our safety system.\",\"param\":null,\"type\":\"invalid_request_error\"}}") = Nil);
    Check("an error body sets the last error", HasError("safety system"));
  }

  function : TestFiles() ~ Nil {
    "Files"->PrintLine();

    body := "{\"object\":\"list\",\"data\":[{\"id\":\"file-abc123\",\"object\":\"file\",\"bytes\":175,\"created_at\":1613677385,\"expires_at\":null,\"filename\":\"salesOverview.pdf\",\"purpose\":\"assistants\"},{\"id\":\"file-abc456\",\"object\":\"file\",\"bytes\":140,\"created_at\":1613779121,\"filename\":\"puppy.jsonl\",\"purpose\":\"fine-tune\"}],\"first_id\":\"file-abc123\",\"last_id\":\"file-abc456\",\"has_more\":false}";
    files := API.OpenAI.File->ParseFileList(body, "sk-test");
    Check("a file listing parses", files <> Nil & files->Size() = 2);
    if(files <> Nil & files->Size() = 2) {
      Check("file id", Same(files->Get(0)->GetId(), "file-abc123"));
      Check("file name", Same(files->Get(1)->GetFilename(), "puppy.jsonl"));
      Check("file purpose", Same(files->Get(1)->GetPurpose(), "fine-tune"));
    };

    EndPoint->SetLastError(Nil);
    Check("an error body yields Nil", API.OpenAI.File->ParseFileList(ErrorBody(), "sk-test") = Nil);
    Check("an error body sets the last error", HasError("Incorrect API key provided"));
    files := API.OpenAI.File->ParseFileList("{\"object\":\"list\"}", "sk-test");
    Check("a listing without data is empty", files <> Nil & files->Size() = 0);
  }

  function : TestModeration() ~ Nil {
    "Moderation"->PrintLine();

    body := "{\"id\":\"modr-0d9740456c391e43c445bf0f010940c7\",\"model\":\"omni-moderation-latest\",\"results\":[{\"flagged\":true,\"categories\":{\"harassment\":true,\"harassment/threatening\":true,\"sexual\":false,\"hate\":false,\"violence\":true},\"category_scores\":{\"harassment\":0.8189693396524255,\"harassment/threatening\":0.804985420696006,\"sexual\":0.000041,\"hate\":0.0016,\"violence\":0.9223163877047201},\"category_applied_input_types\":{\"harassment\":[\"text\"],\"violence\":[\"text\"]}}]}";
    result := Moderation->ParseModeration(body, "omni-moderation-latest");
    Check("a moderation result parses", result <> Nil);
    if(result <> Nil) {
      Check("flagged", result->IsFlagged());
      Check("id", Same(result->GetId(), "modr-0d9740456c391e43c445bf0f010940c7"));
      Check("violence flagged", result->GetCategory("violence"));
      Check("sexual not flagged", <>result->GetCategory("sexual"));
      Check("violence score", Near(result->GetScore("violence"), 0.9223163877047201));
    };

    EndPoint->SetLastError(Nil);
    Check("an error body yields Nil", Moderation->ParseModeration(ErrorBody(), "omni-moderation-latest") = Nil);
    Check("an error body sets the last error", HasError("Incorrect API key provided"));
  }

  function : TestBatch() ~ Nil {
    "Batch"->PrintLine();

    body := "{\"id\":\"batch_abc123\",\"object\":\"batch\",\"endpoint\":\"/v1/chat/completions\",\"errors\":null,\"input_file_id\":\"file-abc123\",\"completion_window\":\"24h\",\"status\":\"in_progress\",\"output_file_id\":null,\"error_file_id\":null,\"created_at\":1711471533,\"in_progress_at\":1711471538,\"expires_at\":1711557933,\"completed_at\":null,\"request_counts\":{\"total\":100,\"completed\":95,\"failed\":1},\"metadata\":{\"customer_id\":\"user_123456789\"}}";
    job := Batch->ParseBatchJob(body);
    Check("a batch parses", job <> Nil);
    if(job <> Nil) {
      Check("batch id", Same(job->GetId(), "batch_abc123"));
      Check("batch status", Same(job->GetStatus(), "in_progress") & <>job->IsComplete());
      Check("batch counts", job->GetTotal() = 100 & job->GetCompleted() = 95 & job->GetFailed() = 1);
      Check("batch created_at", job->GetCreatedAt() = 1711471533);
    };

    body := "{\"object\":\"list\",\"data\":[{\"id\":\"batch_abc123\",\"object\":\"batch\",\"endpoint\":\"/v1/chat/completions\",\"status\":\"completed\",\"input_file_id\":\"file-abc123\",\"output_file_id\":\"file-cvaTdG\",\"created_at\":1711471533,\"completed_at\":1711493133,\"request_counts\":{\"total\":100,\"completed\":100,\"failed\":0}}],\"first_id\":\"batch_abc123\",\"last_id\":\"batch_abc123\",\"has_more\":false}";
    jobs := Batch->ParseBatchList(body);
    Check("a batch listing parses", jobs <> Nil & jobs->Size() = 1);
    if(jobs <> Nil & jobs->Size() = 1) {
      Check("listed batch is complete", jobs->Get(0)->IsComplete() & Same(jobs->Get(0)->GetOutputFileId(), "file-cvaTdG"));
    };

    EndPoint->SetLastError(Nil);
    Check("an error body yields Nil", Batch->ParseBatchJob(ErrorBody()) = Nil);
    Check("an error body sets the last error", HasError("Incorrect API key provided"));
  }
}
