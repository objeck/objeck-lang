# EXPECT_RUNTIME_ERROR
# VM must not crash (segfault) on call stack overflow — exit 1 with message.
# NOTE: the recursion MUST stay non-tail (the "+ n" after the call) so the
# TCO compiler pass cannot rewrite it into a loop — otherwise it would never
# overflow the stack and would hang forever instead of erroring out.
# Interpreted, the frame count reaches the maximum (--call-depth, 16384 by
# default). Compiled, the frames are on the native stack, and the compiled call
# site tests both the frame count and the native stack (core/vm/call_stack.h),
# so the same message ends the program in every mode. Under the JIT it used to
# overrun the native C stack (SIGSEGV) before a guard fired, and the test ran
# interpreted only.
class BadRuntimeStack {
    function : Inf(n : Int) ~ Int {
        return Inf(n + 1) + n;
    }
    function : Main(args : String[]) ~ Nil {
        Inf(0)->PrintLine();
    }
}
