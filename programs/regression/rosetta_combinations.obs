#~
# Rosetta Code: Combinations
# https://rosettacode.org/wiki/Combinations
#
# The k-subsets of 0..n-1 in ascending order. Generated by advancing the last index that can still move, which is what keeps the output sorted without a sort -- and the count must equal the binomial coefficient.
#
# Expected values were computed with an independent oracle, not recalled.
~#


class RosettaCombinations {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaCombinations->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		Check("3 of 5", Combinations(5, 3),
			"012 013 014 023 024 034 123 124 134 234");
		CheckInt("there are C(5,3) = 10", Combinations(5, 3)->Split(" ")->Size(), 10);
		Check("1 of 3", Combinations(3, 1), "0 1 2");
		# choosing everything, and choosing nothing
		Check("3 of 3", Combinations(3, 3), "012");
		CheckInt("C(6,2) = 15", Combinations(6, 2)->Split(" ")->Size(), 15);
		CheckInt("C(10,5) = 252", Combinations(10, 5)->Split(" ")->Size(), 252);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Combinations(n : Int, k : Int) ~ String {
		if(k < 1 | k > n) { return ""; };
		idx := Int->New[k];
		for(i := 0; i < k; i += 1;) { idx[i] := i; };
		out := "";
		while(true) {
			for(i := 0; i < k; i += 1;) {
				out += idx[i]->ToString();
			};
			out += " ";

			# advance the last index that can still move
			i := k - 1;
			while(i >= 0 & idx[i] = i + n - k) {
				i -= 1;
			};
			if(i < 0) { break; };
			idx[i] += 1;
			for(j := i + 1; j < k; j += 1;) {
				idx[j] := idx[j - 1] + 1;
			};
		};
		return out->Trim();
	}
}
