# EXPECT_COMPILE_ERROR: (20,48): A method reference is not typed inside a collection literal: 'BadCollectionLiteralMethodRef->Upper' takes its type from a parameter, a declared variable or a return, not from its place in '[ ]'
# EXPECT_ERROR_COUNT: 1
#~
'Class->Function' is given its type by where it is used: a parameter, a declared variable
or a return. An element of a collection literal is none of those, so it is refused by
name, with the two ways to write it (AddBack, or the full reference).
~#
use Collection;

class BadCollectionLiteralMethodRef {
	function : Upper(s : String) ~ String {
		return s->ToUpper();
	}

	function : Twice(s : String) ~ String {
		return s + s;
	}

	function : Main(args : String[]) ~ Nil {
		steps : Vector<Func2Ref<String, String>> := [BadCollectionLiteralMethodRef->Upper, BadCollectionLiteralMethodRef->Twice];
		steps->Size()->PrintLine();
	}
}
