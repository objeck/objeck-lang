#~
The interpreter and the JIT must agree.

This program is run twice by run_vm_flag_tests.py -- once by default (methods
JIT after 10 calls) and once with --jit=off -- and the two outputs must be
byte-identical. It is the first automated check that the two execution paths
produce the same answers, which matters because the JIT's own header notes
latent miscompiles in chained float calls and string interpolation.

Everything here is chosen to be deterministic and to cross the call-count
threshold, so that by default most of it actually runs compiled.
~#

class Arith {
  function : Fib(n : Int) ~ Int {
    if(n < 2) {
      return n;
    };
    return Fib(n - 1) + Fib(n - 2);
  }

  function : Mix(x : Float) ~ Float {
    # chained transcendental calls: the shape the JIT header warns about
    return (x->Sin() * x->Cos())->Abs()->Sqrt() + (x + 1.0)->Log();
  }

  # A select with a default arm. JMP_TABLE keeps its default_ip in operand3,
  # the same slot PatchCallSites used to overwrite on any instruction whose
  # first two operands matched a compiled method's ids. The default arm must
  # keep working while methods around it are being compiled and patched.
  function : Classify(n : Int) ~ Int {
    select(n) {
      label 1: { return 10; }
      label 2: { return 20; }
      label 3: { return 30; }
      other: { return 99; }
    };
  }

  # A pending int temp on the working stack across a libc float call. Under
  # the SysV ABI pow() clobbers the register holding the 7; ARM64 spilled it,
  # AMD64 did not. The interpreter and the JIT must agree on the sum.
  function : PowPlus(x : Float) ~ Int {
    return 7 + (x->Pow(5.0))->As(Int) + Bump(x);
  }

  function : Bump(x : Float) ~ Int {
    return (x * 2.0)->As(Int);
  }

  # 64-bit immediates on the multiply path: mul_imm_reg was the one emitter
  # left without the imm32 guard, so a constant above 2^31 was sign-truncated.
  function : BigMul(n : Int) ~ Int {
    return n * 4294967311 + n * 3000000000 - n * 2147483648;
  }

  # constant divisors of every shape the JIT special-cases: small, negative,
  # above INT32, composite; the interpreter result is the reference
  function : ConstDiv(n : Int) ~ Int {
    # one division per statement: a single twelve-term expression exhausts the
    # AMD64 allocator's four registers, and the method silently falls back to
    # the interpreter (OBJECK_JIT_REPORT=1 says so) -- which would make this
    # probe compare the interpreter with itself
    acc := n / 3;
    acc += n % 3;
    acc += n / (0 - 7);
    acc -= n % (0 - 7);
    acc += n / 1000003;
    acc += n % 1000003;
    acc += n / 10;
    acc -= n % 10;
    acc += n / 2147483649;
    acc += n % 2147483649;
    acc += n / 6;
    acc += n % 6;
    acc += n / 2;
    acc += n % 2;
    acc += n / (0 - 4);
    acc -= n % (0 - 4);
    acc += n / 1024;
    acc += n % 1024;
    acc += n / 4294967311;
    acc += n % 4294967311;
    return acc;
  }

  # `>>` on negative values: arithmetic in the interpreter and on ARM64; the
  # AMD64 JIT emitted a logical shift until 2026-09-09
  function : Shr(n : Int, k : Int) ~ Int {
    return (n >> k) + (n >> 3) + (n >> 63) + (n >> 1);
  }

  # more than four live temporaries: this expression used to exhaust the
  # AMD64 pool and fall back to the interpreter (OBJECK_JIT_REPORT=1 showed
  # the fixture's own ConstDiv doing that); with eight registers it compiles
  function : Wide(a : Int, b : Int, c : Int, d : Int) ~ Int {
    return (a * b + c * d) * (a - b + c - d) + (a * c - b * d) * (a + d) - (b + c) * (a * d + b * c) + a * b * c * d;
  }

  function : SizeLoop(a : Int[]) ~ Int {
    acc := 0;
    for(i := 0; i < a->Size(); i += 1;) {
      acc += a[i] * (a->Size() - i);
    };
    return acc;
  }

  function : Digest(values : Int[]) ~ Int {
    total := 0;
    each(i : values) {
      total := (total * 31 + values[i]) % 1000003;
    };
    return total;
  }
}

class VmJitEquiv {
  function : Main(args : String[]) ~ Nil {
    # recursion, called far more than ten times
    fibs := Int->New[20];
    for(i := 0; i < 20; i += 1;) {
      fibs[i] := Arith->Fib(i);
    };
    "fib digest={$Arith->Digest(fibs)}"->PrintLine();

    # float math through a method called in a loop
    acc := 0.0;
    for(i := 1; i < 200; i += 1;) {
      acc += Arith->Mix(i->As(Float) * 0.37);
    };
    "float acc={$acc}"->PrintLine();

    # string interpolation and concatenation inside a hot loop
    text := "";
    for(i := 0; i < 50; i += 1;) {
      # an indexed expression is not allowed inside {$...}; bind it first
      f := fibs[i % 20];
      text += "[{$i}:{$f}]";
    };
    "text size={$text->Size()}"->PrintLine();
    text->PrintLine();

    # integer edge cases: negatives, division, modulus by non-trivial values
    signed := 0;
    for(i := -50; i < 50; i += 1;) {
      signed += (i * 7919) / 13 - (i % 11);
    };
    "signed={$signed}"->PrintLine();

    # select default arm, chained float call with a pending temp, 64-bit multiply
    sel := 0;
    for(i := 0; i < 60; i += 1;) {
      sel += Arith->Classify(i % 5);
    };
    "select={$sel}"->PrintLine();

    pw := 0;
    for(i := 1; i < 40; i += 1;) {
      pw += Arith->PowPlus(i->As(Float) * 0.5);
    };
    "powplus={$pw}"->PrintLine();

    bm := 0;
    for(i := 1; i < 40; i += 1;) {
      bm += Arith->BigMul(i) % 1000003;
    };
    "bigmul={$bm}"->PrintLine();

    # a->Size() in a loop condition and in the body (inlined by the JIT now)
    ary := Int->New[37];
    for(i := 0; i < ary->Size(); i += 1;) {
      ary[i] := i * 3 - 7;
    };
    asz := Arith->SizeLoop(ary);
    "arysize={$asz}"->PrintLine();
    # a multi-dimensional array: Size() is the first dimension (header word 2)
    grid := Int->New[3, 5];
    gsz := grid->Size();
    "dim2="->Print();
    gsz->PrintLine();
    cd := 0;
    for(i := -25; i < 25; i += 1;) {
      cd += Arith->ConstDiv(i * 104729 - 3);
    };
    cd += Arith->ConstDiv(4611686018427387904);
    cd += Arith->ConstDiv(0 - 4611686018427387904);
    cd += Arith->ConstDiv(9223372036854775807);
    cd += Arith->ConstDiv(0 - 9223372036854775807);
    "constdiv={$cd}"->PrintLine();

    sh := 0;
    for(i := -20; i < 20; i += 1;) {
      sh += Arith->Shr(i * 1000000007 - 5, i and 15);
    };
    "shr={$sh}"->PrintLine();

    wd := 0;
    for(i := 1; i < 30; i += 1;) {
      wd += Arith->Wide(i, i * 3 - 7, 11 - i, i * i) % 1000003;
    };
    "wide={$wd}"->PrintLine();
    nr := Narrow->Mix(500); "narrow={$nr}"->PrintLine();

    e8 := Loops->Eight(2000); "eight={$e8}"->PrintLine();
    bc := Loops->BreakContinue(500); "brk={$bc}"->PrintLine();
    ns := Loops->Nested(300); "nested={$ns}"->PrintLine();
    # F8: dense selects compile to a jump table; every shape the emitter produces
    sd := Selects->Dense(600); "sel dense={$sd}"->PrintLine();
    sg := Selects->Gaps(600); "sel gaps={$sg}"->PrintLine();
    sn := Selects->NegativeBase(500); "sel negbase={$sn}"->PrintLine();
    sc := Selects->Chars("the quick brown fox jumps over the lazy dog, 42 times!"); "sel chars={$sc}"->PrintLine();
    so := Selects->NoOther(400); "sel noother={$so}"->PrintLine();
    sx := Selects->Nested(300); "sel nested={$sx}"->PrintLine();
    sb := Selects->PinnedBreak(2000); "sel pinbreak={$sb}"->PrintLine();
    sm := Selects->CallValue(300); "sel callvalue={$sm}"->PrintLine();
    # F3 phase 4d: float loop locals pinned in XMM6-XMM9 (Windows), every shape
    fa := FloatPins->Accumulate(3000); "fpin acc={$fa}"->PrintLine();
    fn := FloatPins->NestedFloats(120); "fpin nested={$fn}"->PrintLine();
    fm := FloatPins->Mixed(2500); "fpin mixed={$fm}"->PrintLine();
    fw := FloatPins->ManyFloats(2000); "fpin many={$fw}"->PrintLine();
    fb := FloatPins->BreakOut(5000); "fpin break={$fb}"->PrintLine();
    fc := FloatPins->CallsInside(400); "fpin calls={$fc}"->PrintLine();
    dw := Loops->DoWhile(37); "dowhile={$dw}"->PrintLine();
    ca := Loops->CallsAndAllocs(400); "calls={$ca}"->PrintLine();
    er := Loops->EarlyReturn(1000); "early={$er}"->PrintLine();
    jf := Loops->JoinAndFloats(250, true) + Loops->JoinAndFloats(250, false); "join={$jf}"->PrintLine();
    gd := Loops->Gcd(1071, 462) + Loops->Gcd(9999991, 12345); "gcd={$gd}"->PrintLine();

    # F7 phase 1: a compiled caller reaches a virtual override through the
    # bridge's own resolution, a bound callee takes the direct entry, and a frame
    # the per-thread pool hands out is zeroed for the locals its method declares
    cv := Calls->VirtualMix(300); "calls virtual={$cv}"->PrintLine();
    cf := Calls->FreshLocals(300); "calls fresh={$cf}"->PrintLine();
    cdp := Calls->Deep(200); "calls deep={$cdp}"->PrintLine();
    ce := Calls->ElementsAfterCalls(120); "calls elems={$ce}"->PrintLine();

    "done"->PrintLine();
  }
}

# Loop shapes for the pinned-register allocator (F3): loop-carried scalars,
# break/continue, nested loops sharing locals, do/while, calls and allocations
# inside the loop, an early return, a loop after an if/else join with floats
# beside the integers, and a self-recursive tail call.
class Loops {
  function : Eight(n : Int) ~ Int {
    a := 1; b := 2; c := 3; d := 4; e := 5; f := 6; g := 7; h := 8;
    for(i := 0; i < n; i += 1;) {
      a += b; b += c; c += d; d += e; e += f; f += g; g += h; h += a;
      a := a % 1000003; h := h % 999983;
    };
    return a + b * 3 + c * 5 + d * 7 + e * 11 + f * 13 + g * 17 + h * 19;
  }

  function : BreakContinue(n : Int) ~ Int {
    s := 0; k := 0;
    for(i := 0; i < n; i += 1;) {
      if(i % 7 = 3) { continue; };
      k += 1;
      if(k > 40) { break; };
      s += i * k;
    };
    return s * 100 + k;
  }

  function : Nested(n : Int) ~ Int {
    t := 0; u := 1;
    for(i := 0; i < n; i += 1;) {
      for(j := 0; j < 5; j += 1;) {
        t += i * j + u;
        u := (u * 3 + j) % 101;
      };
      t := t % 1000003;
    };
    return t * 1000 + u;
  }

  function : DoWhile(n : Int) ~ Int {
    i := 0; s := 0;
    do {
      s += i * 2 + 1;
      i += 1;
    } while(i < n);
    return s * 10 + i;
  }

  function : CallsAndAllocs(n : Int) ~ Int {
    s := 0; last : Int[] := Nil;
    for(i := 0; i < n; i += 1;) {
      s += Helper(i, s);
      if(i % 16 = 0) { last := Int->New[8]; last[0] := i; };
      s := s % 1000003;
    };
    return s * 100 + last[0] % 100;
  }

  function : Helper(i : Int, s : Int) ~ Int {
    return (i * 7 + s) % 13;
  }

  function : EarlyReturn(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      acc += i * 3;
      if(acc > 5000) { return acc * 10 + i; };
    };
    return acc;
  }

  function : JoinAndFloats(n : Int, flag : Bool) ~ Int {
    x := 0; y := 1.5;
    if(flag) { x := 3; } else { x := 4; };
    for(i := 0; i < n; i += 1;) {
      x := (x * 5 + i) % 10007;
      y := y * 1.0001 + i;
    };
    return x * 1000 + (y->ToInt() % 1000);
  }

  function : Gcd(a : Int, b : Int) ~ Int {
    if(b = 0) { return a; };
    return Gcd(b, a % b);
  }
}

# Char and byte elements read and written with six live temporaries, so the
# element address and the value get handed R8-R11 on Windows (in the pool since
# batch 3). The 16-bit encoders emitted no REX prefix for those registers, so a
# char loaded through R8 was read from RAX: found when F3 pinning changed the
# allocation in the JSON scanner.
class Narrow {
  function : Mix(n : Int) ~ Int {
    cs := Char->New[16];
    bs := Byte->New[16];
    for(i := 0; i < 16; i += 1;) {
      cs[i] := (65 + i)->As(Char);
      bs[i] := (i * 7)->As(Byte);
    };
    a1 := 1; a2 := 2; a3 := 3; a4 := 4; a5 := 5; a6 := 6; acc := 0;
    for(i := 0; i < n; i += 1;) {
      k := (i * a1 + a2) % 16;
      c := cs[(k + a3) % 16];
      b := bs[(k + a4) % 16];
      cs[k] := (65 + ((c->As(Int) + a5) % 26))->As(Char);
      bs[k] := ((b->As(Int) + a6) % 100)->As(Byte);
      acc := (acc * 31 + c->As(Int) * a1 + b->As(Int) * a2 + a3 + a4 + a5 + a6 + k) % 1000003;
      # deep nesting keeps six values live, so the element address lands in R8+
      v := a1 * (a2 + a3 * (a4 + a5 * (a6 + cs[(k + 5) % 16]->As(Int))));
      cs[(k + 9) % 16] := (65 + (a1 * (a2 + a3 * (a4 + a5 * (a6 + i)))) % 26)->As(Char);
      w := a1 * (a2 + a3 * (a4 + a5 * (a6 + bs[(k + 7) % 16]->As(Int))));
      bs[(k + 11) % 16] := ((a1 * (a2 + a3 * (a4 + a5 * (a6 + i)))) % 100)->As(Byte);
      acc := (acc + v % 1009 + w % 1013) % 1000003;
      a1 += 1; a2 += 2; a3 += 3; a4 += 1; a5 += 2; a6 += 3;
    };
    return acc;
  }
}

# F8: `select` becomes a JMP_TABLE when its labels are dense, and no method
# holding one was compiled at all. Each probe is one shape the emitter produces;
# the values are chosen so every slot, the default and the out-of-range paths
# are all taken.
class Selects {
  function : Dense(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      select(i % 8) {
        label 0: { acc += 1; }
        label 1: { acc += i; }
        label 2: { acc -= 3; }
        label 3: { acc += i * 2; }
        label 4: { acc := acc * 3 % 100003; }
        label 5: { acc += 7; }
        label 6: { acc -= i; }
        label 7: { acc += 11; }
      };
    };
    return acc;
  }

  # labels 1,3,4,6,9 over a range of 9: four slots point at the default
  function : Gaps(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      select(i % 12) {
        label 1: { acc += 10; }
        label 3: { acc += 30; }
        label 4: { acc += 40; }
        label 6: { acc += 60; }
        label 9: { acc += 90; }
        other: { acc -= 1; }
      };
    };
    return acc;
  }

  function : NegativeBase(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      v := i % 9 - 4;
      select(v) {
        label -4: { acc += 4; }
        label -3: { acc += 3; }
        label -1: { acc += 1; }
        label 0: { acc += 100; }
        label 2: { acc += 2; }
        label 3: { acc += 33; }
        other: { acc -= 5; }
      };
    };
    return acc;
  }

  function : Chars(s : String) ~ Int {
    vowels := 0;
    spaces := 0;
    digits := 0;
    rest := 0;
    each(i : s) {
      select(s->Get(i)) {
        label 'a': { vowels += 1; }
        label 'e': { vowels += 2; }
        label 'i': { vowels += 3; }
        label 'o': { vowels += 4; }
        label 'u': { vowels += 5; }
        label ' ': { spaces += 1; }
        label '0': { digits += 1; }
        label '1': { digits += 1; }
        label '2': { digits += 1; }
        label '3': { digits += 1; }
        label '4': { digits += 1; }
        other: { rest += 1; }
      };
    };
    return vowels * 1000000 + spaces * 10000 + digits * 100 + rest;
  }

  # no `other`: the default is the end of the select
  function : NoOther(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      select(i % 6) {
        label 0: { acc += 5; }
        label 1: { acc += 6; }
        label 2: { acc += 7; }
        label 3: { acc += 8; }
      };
      acc += 1;
    };
    return acc;
  }

  function : Nested(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      select(i % 3) {
        label 0: {
          select(i % 4) {
            label 0: { acc += 1; }
            label 1: { acc += 2; }
            label 2: { acc += 3; }
            label 3: { acc += 4; }
          };
        }
        label 1: {
          select(i % 5) {
            label 0: { acc += 10; }
            label 2: { acc += 20; }
            label 4: { acc += 40; }
            other: { acc += 5; }
          };
        }
        other: { acc += 100; }
      };
    };
    return acc;
  }

  # hot integer locals (pinned on AMD64) around a select whose case breaks out
  function : PinnedBreak(n : Int) ~ Int {
    total := 0;
    hits := 0;
    i := 0;
    while(i < n) {
      k := i % 10;
      select(k) {
        label 0: { total += 2; }
        label 1: { total += 3; hits += 1; }
        label 2: { total += 5; }
        label 3: { total += 7; }
        label 4: { total += 11; }
        label 5: { total += 13; hits += 1; }
        label 6: { total += 17; }
        label 7: { total += 19; }
        label 8: { total += 23; }
        label 9: { if(total > 25000) { break; }; total += 29; }
      };
      i += 1;
    };
    return total * 10 + hits + i;
  }

  function : Kind(i : Int) ~ Int {
    return (i * 7 + 3) % 6;
  }

  function : CallValue(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      select(Kind(i)) {
        label 0: { acc += Kind(i + 1); }
        label 1: { acc += 2; }
        label 2: { acc += Kind(i * 2); }
        label 3: { acc += 4; }
        label 5: { acc += 6; }
        other: { acc += 1; }
      };
    };
    return acc;
  }
}

# F3 phase 4d: on Windows the hottest Float locals of a loop live in XMM6-XMM9
# across the whole loop, written back on every exit. Each probe is a shape the
# pinning must survive: several accumulators, a float carried through a nested
# loop, ints and floats pinned together, more floats than registers, a break
# out of the loop (an exit stub), and calls inside the loop (callee-saved is
# the safety argument). Values are checked by equivalence with the interpreter.
class FloatPins {
  function : Accumulate(n : Int) ~ Float {
    a := 0.0;
    b := 1.0;
    c := 0.5;
    d := 2.0;
    for(i := 0; i < n; i += 1;) {
      x := i->As(Float) * 0.001;
      a += x;
      b := b * 1.0001 + 0.25;
      c += x * x;
      d := d - x * 0.5;
    };
    return a * 1000.0 + b + c - d;
  }

  function : NestedFloats(n : Int) ~ Float {
    total := 0.0;
    scale := 1.0;
    for(i := 0; i < n; i += 1;) {
      row := 0.0;
      for(j := 0; j < 40; j += 1;) {
        cell := i * 40 + j;
        row += cell->As(Float) * scale;
        scale := scale * 0.9999;
      };
      denom := i + 1;
      total += row / denom->As(Float);
    };
    return total + scale;
  }

  function : Mixed(n : Int) ~ Float {
    count := 0;
    hits := 0;
    sum := 0.0;
    avg := 0.0;
    for(i := 0; i < n; i += 1;) {
      m := i % 97;
      v := m->As(Float) * 0.75;
      count += 1;
      if(v > 30.0) { hits += 1; };
      sum += v;
      avg := sum / count->As(Float);
    };
    return avg * 100.0 + hits->As(Float) + count->As(Float) * 0.001;
  }

  function : ManyFloats(n : Int) ~ Float {
    f0 := 0.0; f1 := 0.1; f2 := 0.2; f3 := 0.3; f4 := 0.4; f5 := 0.5; f6 := 0.6;
    for(i := 0; i < n; i += 1;) {
      k := i % 13;
      x := k->As(Float);
      f0 += x;
      f1 += x * 0.5;
      f2 := f2 * 1.001 + 0.001;
      f3 += f0 * 0.0001;
      f4 := f4 - x * 0.01;
      f5 += f1 * 0.0001;
      f6 := f6 * 0.999 + x;
    };
    return f0 + f1 + f2 + f3 + f4 + f5 + f6;
  }

  function : BreakOut(n : Int) ~ Float {
    acc := 0.0;
    step := 0.001;
    i := 0;
    while(i < n) {
      acc += step * i->As(Float);
      step := step * 1.0005;
      if(acc > 1500.0) { break; };
      i += 1;
    };
    return acc * 1000.0 + step + i->As(Float);
  }

  function : Weight(v : Float) ~ Float {
    return v * 0.5 + 1.0;
  }

  function : CallsInside(n : Int) ~ Float {
    acc := 0.0;
    norm := 1.0;
    for(i := 0; i < n; i += 1;) {
      acc += Weight(i->As(Float));
      norm := norm * 0.999 + Float->Sqrt(acc) * 0.001;
      if(i % 50 = 0) { tmp := Float->New[8]; tmp[0] := acc; acc := tmp[0]; };
    };
    return acc + norm * 1000.0;
  }
}

# F7 phase 1: calls between compiled methods. A `virtual` declaration reached
# from a compiled caller is resolved in the callback bridge (it used to re-enter
# the interpreter on every call); a callee bound at compile time takes the
# direct bridge entry; a frame from the per-thread pool is zeroed for exactly
# the locals its method declares, which is what a local that is declared but
# never assigned relies on to read as 0 or Nil.
class Shape {
  New() {}
  method : virtual : public : Area(x : Int) ~ Int;
  # bound, and it makes a virtual call on self: both paths in one callee
  method : public : Twice(x : Int) ~ Int { return Area(x) * 2; }
}

class Sq from Shape {
  @s : Int;
  New(s : Int) { Parent(); @s := s; }
  method : public : Area(x : Int) ~ Int { return @s * @s + x; }
}

class Rect from Shape {
  @w : Int; @h : Int;
  New(w : Int, h : Int) { Parent(); @w := w; @h := h; }
  method : public : Area(x : Int) ~ Int { return @w * @h - x; }
}

# an override inherited rather than defined on the receiver's class: the
# resolution walks one level up, and the cache entry lands on Tall
class Tall from Rect {
  New(w : Int, h : Int) { Parent(w, h); }
}

class Calls {
  function : VirtualMix(n : Int) ~ Int {
    shapes := Shape->New[3];
    shapes[0] := Sq->New(3);
    shapes[1] := Rect->New(2, 5);
    shapes[2] := Tall->New(4, 7);
    t := 0;
    for(i := 0; i < n; i += 1;) {
      s := shapes[i % 3];
      t += s->Area(i) + s->Twice(i % 7);
    };
    return t;
  }

  # twelve locals of mixed types, every one written: the frame this leaves dirty
  function : Dirty(i : Int) ~ Int {
    a := i; b := i + 1; c := i + 2; d := i + 3; e := i + 4; f := i + 5;
    x := i->As(Float); y := x * 2.0; z := y + 1.0;
    s := "dirty"; t := "frame"; ary := Int->New[3];
    ary[0] := a; ary[1] := b; ary[2] := c;
    return a + b + c + d + e + f + x->As(Int) + y->As(Int) + z->As(Int) + s->Size() + t->Size() + ary[2];
  }

  # declared, never assigned: each must read as 0 or Nil in a frame the pool
  # handed to Dirty a moment ago
  function : Fresh() ~ Int {
    a : Int; x : Float; s : String; ary : Int[];
    ok := 0;
    if(a = 0) { ok += 1; };
    if(x = 0.0) { ok += 10; };
    if(s = Nil) { ok += 100; };
    if(ary = Nil) { ok += 1000; };
    return ok;
  }

  function : FreshLocals(n : Int) ~ Int {
    t := 0;
    for(i := 0; i < n; i += 1;) {
      t += Dirty(i) % 7;
      t += Fresh();
    };
    return t;
  }

  # recursion past the pool's refill size, from a compiled caller
  function : Deep(n : Int) ~ Int {
    if(n = 0) { return 0; };
    return Deep(n - 1) + (n % 3);
  }
  # a constant character or byte stored into an array element right after a
  # call's result is popped: the result pop's allocation order puts the element
  # address in R8-R15, the path where the char store released its register
  # twice (the free pool then handed one register to two owners)
  function : Tag(i : Int) ~ Int {
    return i * 31 + 7;
  }

  function : ElementsAfterCalls(n : Int) ~ Int {
    chars := Char->New[8];
    bytes := Byte->New[8];
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      t := Tag(i);
      chars[0] := 'H';
      chars[t % 7 + 1] := 'i';
      u := Tag(t);
      bytes[0] := 3;
      bytes[u % 7 + 1] := 9;
      v := Tag(u);
      if(chars[0] = 'H') { acc += 1; };
      if(chars[t % 7 + 1] = 'i') { acc += 10; };
      if(bytes[0] = 3) { acc += 100; };
      if(bytes[u % 7 + 1] = 9) { acc += 1000; };
      acc += v % 5;
    };
    return acc;
  }
}
