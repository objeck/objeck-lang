#~
The interpreter and the JIT must agree.

This program is run twice by run_vm_flag_tests.py -- once by default (methods
JIT after 10 calls) and once with --jit=off -- and the two outputs must be
byte-identical. It is the first automated check that the two execution paths
produce the same answers, which matters because the JIT's own header notes
latent miscompiles in chained float calls and string interpolation.

Everything here is chosen to be deterministic and to cross the call-count
threshold, so that by default most of it actually runs compiled.
~#

class Arith {
  function : Fib(n : Int) ~ Int {
    if(n < 2) {
      return n;
    };
    return Fib(n - 1) + Fib(n - 2);
  }

  function : Mix(x : Float) ~ Float {
    # chained transcendental calls: the shape the JIT header warns about
    return (x->Sin() * x->Cos())->Abs()->Sqrt() + (x + 1.0)->Log();
  }

  # A select with a default arm. JMP_TABLE keeps its default_ip in operand3,
  # the same slot PatchCallSites used to overwrite on any instruction whose
  # first two operands matched a compiled method's ids. The default arm must
  # keep working while methods around it are being compiled and patched.
  function : Classify(n : Int) ~ Int {
    select(n) {
      label 1: { return 10; }
      label 2: { return 20; }
      label 3: { return 30; }
      other: { return 99; }
    };
  }

  # A pending int temp on the working stack across a libc float call. Under
  # the SysV ABI pow() clobbers the register holding the 7; ARM64 spilled it,
  # AMD64 did not. The interpreter and the JIT must agree on the sum.
  function : PowPlus(x : Float) ~ Int {
    return 7 + (x->Pow(5.0))->As(Int) + Bump(x);
  }

  function : Bump(x : Float) ~ Int {
    return (x * 2.0)->As(Int);
  }

  # 64-bit immediates on the multiply path: mul_imm_reg was the one emitter
  # left without the imm32 guard, so a constant above 2^31 was sign-truncated.
  function : BigMul(n : Int) ~ Int {
    return n * 4294967311 + n * 3000000000 - n * 2147483648;
  }

  # constant divisors of every shape the JIT special-cases: small, negative,
  # above INT32, composite; the interpreter result is the reference
  function : ConstDiv(n : Int) ~ Int {
    # one division per statement: a single twelve-term expression exhausts the
    # AMD64 allocator's four registers, and the method silently falls back to
    # the interpreter (OBJECK_JIT_REPORT=1 says so) -- which would make this
    # probe compare the interpreter with itself
    acc := n / 3;
    acc += n % 3;
    acc += n / (0 - 7);
    acc -= n % (0 - 7);
    acc += n / 1000003;
    acc += n % 1000003;
    acc += n / 10;
    acc -= n % 10;
    acc += n / 2147483649;
    acc += n % 2147483649;
    acc += n / 6;
    acc += n % 6;
    acc += n / 2;
    acc += n % 2;
    acc += n / (0 - 4);
    acc -= n % (0 - 4);
    acc += n / 1024;
    acc += n % 1024;
    acc += n / 4294967311;
    acc += n % 4294967311;
    return acc;
  }

  # `>>` on negative values: arithmetic in the interpreter and on ARM64; the
  # AMD64 JIT emitted a logical shift until 2026-09-09
  function : Shr(n : Int, k : Int) ~ Int {
    return (n >> k) + (n >> 3) + (n >> 63) + (n >> 1);
  }

  # more than four live temporaries: this expression used to exhaust the
  # AMD64 pool and fall back to the interpreter (OBJECK_JIT_REPORT=1 showed
  # the fixture's own ConstDiv doing that); with eight registers it compiles
  function : Wide(a : Int, b : Int, c : Int, d : Int) ~ Int {
    return (a * b + c * d) * (a - b + c - d) + (a * c - b * d) * (a + d) - (b + c) * (a * d + b * c) + a * b * c * d;
  }

  function : SizeLoop(a : Int[]) ~ Int {
    acc := 0;
    for(i := 0; i < a->Size(); i += 1;) {
      acc += a[i] * (a->Size() - i);
    };
    return acc;
  }

  function : Digest(values : Int[]) ~ Int {
    total := 0;
    each(i : values) {
      total := (total * 31 + values[i]) % 1000003;
    };
    return total;
  }
}

class VmJitEquiv {
  function : Main(args : String[]) ~ Nil {
    # recursion, called far more than ten times
    fibs := Int->New[20];
    for(i := 0; i < 20; i += 1;) {
      fibs[i] := Arith->Fib(i);
    };
    "fib digest={$Arith->Digest(fibs)}"->PrintLine();

    # float math through a method called in a loop
    acc := 0.0;
    for(i := 1; i < 200; i += 1;) {
      acc += Arith->Mix(i->As(Float) * 0.37);
    };
    "float acc={$acc}"->PrintLine();

    # string interpolation and concatenation inside a hot loop
    text := "";
    for(i := 0; i < 50; i += 1;) {
      # an indexed expression is not allowed inside {$...}; bind it first
      f := fibs[i % 20];
      text += "[{$i}:{$f}]";
    };
    "text size={$text->Size()}"->PrintLine();
    text->PrintLine();

    # integer edge cases: negatives, division, modulus by non-trivial values
    signed := 0;
    for(i := -50; i < 50; i += 1;) {
      signed += (i * 7919) / 13 - (i % 11);
    };
    "signed={$signed}"->PrintLine();

    # select default arm, chained float call with a pending temp, 64-bit multiply
    sel := 0;
    for(i := 0; i < 60; i += 1;) {
      sel += Arith->Classify(i % 5);
    };
    "select={$sel}"->PrintLine();

    pw := 0;
    for(i := 1; i < 40; i += 1;) {
      pw += Arith->PowPlus(i->As(Float) * 0.5);
    };
    "powplus={$pw}"->PrintLine();

    bm := 0;
    for(i := 1; i < 40; i += 1;) {
      bm += Arith->BigMul(i) % 1000003;
    };
    "bigmul={$bm}"->PrintLine();

    # a->Size() in a loop condition and in the body (inlined by the JIT now)
    ary := Int->New[37];
    for(i := 0; i < ary->Size(); i += 1;) {
      ary[i] := i * 3 - 7;
    };
    asz := Arith->SizeLoop(ary);
    "arysize={$asz}"->PrintLine();
    # a multi-dimensional array: Size() is the first dimension (header word 2)
    grid := Int->New[3, 5];
    gsz := grid->Size();
    "dim2="->Print();
    gsz->PrintLine();
    cd := 0;
    for(i := -25; i < 25; i += 1;) {
      cd += Arith->ConstDiv(i * 104729 - 3);
    };
    cd += Arith->ConstDiv(4611686018427387904);
    cd += Arith->ConstDiv(0 - 4611686018427387904);
    cd += Arith->ConstDiv(9223372036854775807);
    cd += Arith->ConstDiv(0 - 9223372036854775807);
    "constdiv={$cd}"->PrintLine();

    sh := 0;
    for(i := -20; i < 20; i += 1;) {
      sh += Arith->Shr(i * 1000000007 - 5, i and 15);
    };
    "shr={$sh}"->PrintLine();

    wd := 0;
    for(i := 1; i < 30; i += 1;) {
      wd += Arith->Wide(i, i * 3 - 7, 11 - i, i * i) % 1000003;
    };
    "wide={$wd}"->PrintLine();

    "done"->PrintLine();
  }
}
