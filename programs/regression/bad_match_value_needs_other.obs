# EXPECT_COMPILE_ERROR: (20,8): A 'match' used as a value needs an 'other' arm, unless it is on an enum and names every item
# EXPECT_ERROR_COUNT: 1
#~
A 'match' used as a value yields one for every subject: on an Int that takes an 'other' arm.
~#
enum Color {
	Red,
	Green,
	Blue
}

enum Size {
	Small,
	Large
}

class BadMatchValueNeedsOther {
	function : Main(args : String[]) ~ Nil {
		n := 3;
		x := match n { 1 => "a", 2 => "b" };
		x->PrintLine();
	}
}
