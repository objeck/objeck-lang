#~
A collection leaves an Int alone even when its value is an object's address (#1452, #1473).

Runtime->TestAddressOf(o) hands back an object's address as an Int; the VM
returns 0 for it unless OBJECK_GC_TEST_HOOKS=1, so only run_vm_flag_tests.py
runs this file, with the variable set. Run() keeps such an Int pending on the
operand stack while Churn() allocates enough to collect, and compares it with
the same value kept in a typed Int local, which a collection never touches. A
collector that treats a stack word equal to a moved object's old address as a
reference rewrites the pending one, and the two disagree.

With --nursery=64k about one comparison in eight changes when the collector
guesses (OBJECK_GC_ROOTS=conservative), so the test has a negative control: it
must FAIL there and PASS where the reference maps type the stack.
~#

class Box {
  @v : Int;

  New(v : Int) {
    @v := v;
  }

  method : public : Get() ~ Int {
    return @v;
  }
}

class GcAddressIntPending {
  function : Main(args : String[]) ~ Nil {
    probe := Box->New(1);
    if(Runtime->TestAddressOf(probe) = 0) {
      "FAIL: Runtime->TestAddressOf returned 0; run with OBJECK_GC_TEST_HOOKS=1"->PrintLine();
      Runtime->Exit(2);
    };

    bad := Run();
    if(bad = 0) {
      "PASS: no pending address-valued Int was rewritten by a collection"->PrintLine();
    }
    else {
      "FAIL: {$bad} pending address-valued Int(s) changed by a collection"->PrintLine();
      Runtime->Exit(1);
    };
  }

  function : Run() ~ Int {
    bad := 0;
    for(i := 0; i < 2000; i += 1;) {
      o := Box->New(i);
      before := Runtime->TestAddressOf(o);
      # the address is pending on the operand stack while Churn allocates
      if(Same(Runtime->TestAddressOf(o), Churn(i), before) = false) {
        bad += 1;
      };
    };
    return bad;
  }

  function : Same(a : Int, c : Int, b : Int) ~ Bool {
    return a = b;
  }

  function : Churn(n : Int) ~ Int {
    s := 0;
    for(j := 0; j < 200; j += 1;) {
      b := Box->New(j);
      s += b->Get();
    };
    return s;
  }
}
