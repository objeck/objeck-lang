# EXPECT_COMPILE_ERROR: (12,4): A 'spawn' block does not return a value
# EXPECT_ERROR_COUNT: 1
#~
The block of a 'spawn' is a thread's body. 'return;' ends the thread; a value
has nowhere to go, and is refused on its own line rather than as a cast error
that names the lambda the block is compiled to.
~#
class BadSpawnReturnValue {
	function : Main(args : String[]) ~ Nil {
		limit := 3;
		worker := spawn {
			return limit + 1;
		};
		worker->Join();
	}
}
