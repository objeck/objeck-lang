	method : public : F1(x : Int) ~ Int { return x + 3701; }
	method : public : F2(x : Int) ~ Int { return x + 3702; }
	method : public : F3(x : Int) ~ Int { return x + 3703; }
	method : public : F4(x : Int) ~ Int { return x + 3704; }
	method : public : F5(x : Int) ~ Int { return x + 3705; }
	method : public : F6(x : Int) ~ Int { return x + 3706; }
	method : public : F7(x : Int) ~ Int { return x + 3707; }
}

class S38 from Shape {
	New() { Parent(); }
	method : public : F0(x : Int) ~ Int { return x + 3800; }
	method : public : F1(x : Int) ~ Int { return x + 3801; }
	method : public : F2(x : Int) ~ Int { return x + 3802; }
	method : public : F3(x : Int) ~ Int { return x + 3803; }
	method : public : F4(x : Int) ~ Int { return x + 3804; }
	method : public : F5(x : Int) ~ Int { return x + 3805; }
	method : public : F6(x : Int) ~ Int { return x + 3806; }
	method : public : F7(x : Int) ~ Int { return x + 3807; }
}

class S39 from Shape {
