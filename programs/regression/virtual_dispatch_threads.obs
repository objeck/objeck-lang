}

class Gate {
	@open : Bool;
	@ready : Int;
	@mutex : ThreadMutex;

	New() {
		@mutex := ThreadMutex->New("gate");
	}

	method : public : Arrive() ~ Nil {
		critical(@mutex) {
			@ready += 1;
		};
	}

	method : public : Ready() ~ Int {
		count : Int;
		critical(@mutex) {
			count := @ready;
		};
		return count;
	}

	method : public : Open() ~ Nil {
		@open := true;
	}

	method : public : IsOpen() ~ Bool {
		return @open;
	}
}

class Caller from Thread {
	@shapes : Shape[];
	@total : Int;

	New(shapes : Shape[]) {
		Parent("caller");
		@shapes := shapes;
	}

	method : public : GetTotal() ~ Int {
		return @total;
	}

	method : public : Run(param : System.Base) ~ Nil {
		gate := param->As(Gate);
		gate->Arrive();
		# spin, so every thread is running when the gate opens
		while(<>gate->IsOpen()) {
		};

		total := 0;
		each(i : @shapes) {
			shape := @shapes[i];
			total += shape->F0(1);
			total += shape->F1(1);
			total += shape->F2(1);
			total += shape->F3(1);
			total += shape->F4(1);
			total += shape->F5(1);
			total += shape->F6(1);
			total += shape->F7(1);
		};
		@total := total;
	}
}

class VirtualDispatchThreads {
	function : Main(args : String[]) ~ Nil {
		shapes := Shape->New[40];
		shapes[0] := S0->New();
		shapes[1] := S1->New();
		shapes[2] := S2->New();
		shapes[3] := S3->New();
		shapes[4] := S4->New();
		shapes[5] := S5->New();
		shapes[6] := S6->New();
		shapes[7] := S7->New();
		shapes[8] := S8->New();
		shapes[9] := S9->New();
		shapes[10] := S10->New();
		shapes[11] := S11->New();
		shapes[12] := S12->New();
		shapes[13] := S13->New();
		shapes[14] := S14->New();
		shapes[15] := S15->New();
		shapes[16] := S16->New();
		shapes[17] := S17->New();
		shapes[18] := S18->New();
		shapes[19] := S19->New();
		shapes[20] := S20->New();
		shapes[21] := S21->New();
		shapes[22] := S22->New();
		shapes[23] := S23->New();
		shapes[24] := S24->New();
		shapes[25] := S25->New();
		shapes[26] := S26->New();
		shapes[27] := S27->New();
		shapes[28] := S28->New();
		shapes[29] := S29->New();
		shapes[30] := S30->New();
		shapes[31] := S31->New();
		shapes[32] := S32->New();
		shapes[33] := S33->New();
		shapes[34] := S34->New();
		shapes[35] := S35->New();
		shapes[36] := S36->New();
		shapes[37] := S37->New();
		shapes[38] := S38->New();
		shapes[39] := S39->New();

		gate := Gate->New();
		callers := Caller->New[8];
		each(i : callers) {
			callers[i] := Caller->New(shapes);
			callers[i]->Execute(gate);
		};

		waited := 0;
		while(gate->Ready() < callers->Size() & waited < 20000) {
			Thread->Sleep(1);
			waited += 1;
		};
		gate->Open();

		failed := 0;
		each(i : callers) {
			callers[i]->Join();
			total := callers[i]->GetTotal();
			if(total <> 625440) {
				"  FAIL: thread {$i} computed {$total}, expected 625440"->PrintLine();
				failed += 1;
			};
		};

		if(failed = 0) {
			"PASS: virtual calls from 8 threads"->PrintLine();
		}
		else {
			"FAIL: {$failed} thread(s) reached a wrong override"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
