# EXTRA_LIBS: mcp,net,net_server,cipher,misc
#~
The streamable HTTP transport with sessions off (McpService->SetSessions(false)): no client can cancel,
or take the place of, another client's call, and the server says that it does not cancel (API.MCP).
Loopback only, port 0.

A request id is unique within one client. With sessions the session is the connection, and ids, in-use
checks and cancellations belong to it. With sessions off every message arrived under no connection at
all, so all clients shared one set of ids: with two clients each waiting for a call numbered 1, the second
call took the first one's place among the calls in progress, and the first client's
notifications/cancelled for "1" cancelled the second client's call.

Without a session nothing reliable names a client: a cancellation is a POST of its own, from another
port than the call it names, and an address is shared by every program on a machine (every client in
this test is 127.0.0.1) and every client behind a proxy. A sessionless server therefore does not guess.
Each message is a connection by itself, a notifications/cancelled is answered 202 and ignored, and the
initialize result carries "org.objeck/cancellation" under _meta, a text that begins "unsupported", so
that a client can know. Cancellation is keyed by the session (mcp_stdio_test.py covers two sessions
with the same request id).

The cases: the note in the initialize result; two clients with a call numbered 1 each and a cancellation
for 1 (neither is cancelled, both are answered); one call at work and a cancellation for it (it is not
cancelled either: that the server never guesses is the point); the id free afterwards.
~#
use API.MCP, Data.JSON, Collection, System.Concurrency;

class Poster from Thread {
	@url : String;
	@tag : String;
	@id : Int;

	New(url : String, tag : String, id : Int) {
		Parent();
		@url := url;
		@tag := tag;
		@id := id;
	}

	method : public : Run(arg : System.Base) ~ Nil {
		body := "{\"jsonrpc\":\"2.0\",\"id\":{$@id},\"method\":\"tools/call\",\"params\":{\"name\":\"hold\",\"arguments\":{\"tag\":\"{$@tag}\"}}}";
		client := Web.HTTP.HttpClient->New();
		client->AddHeader("Accept", "application/json, text/event-stream");
		response := client->Post(Web.HTTP.Url->New(@url), body->ToByteArray(), "application/json");
		code := 0;
		text := "";
		if(response <> Nil) {
			code := response->GetCode();
			if(response->GetContent() <> Nil) {
				text := String->New(response->GetContent());
			};
		};
		McpHttpSessionlessCancelTest->Answered(@tag, code, text);
	}
}

class McpHttpSessionlessCancelTest {
	@pass : static : Int;
	@fail : static : Int;
	@service : static : McpService;
	@lock : static : ThreadMutex;
	@started_a : static : Bool;
	@started_b : static : Bool;
	@cancelled_a : static : Bool;
	@cancelled_b : static : Bool;
	@code_a : static : Int;
	@code_b : static : Int;
	@text_a : static : String;
	@text_b : static : String;

	function : Check(what : String, ok : Bool) ~ Nil {
		if(ok) {
			@pass += 1;
		}
		else {
			@fail += 1;
			"  FAIL: {$what}"->PrintLine();
		};
	}

	function : Service() ~ McpService {
		return @service;
	}

	function : Answered(tag : String, code : Int, text : String) ~ Nil {
		critical(@lock) {
			if(tag->Equals("a")) {
				@code_a := code;
				@text_a := text;
			}
			else {
				@code_b := code;
				@text_b := text;
			};
		};
	}

	# works for a second and a half unless the client cancels
	function : Hold(call : McpCall) ~ McpToolResult {
		tag := call->GetString("tag");
		first := tag->Equals("a");
		if(first) {
			@started_a := true;
		}
		else {
			@started_b := true;
		};

		waited := 0;
		while(<>call->IsCancelled() & waited < 1500) {
			Thread->Sleep(10);
			waited += 10;
		};

		if(call->IsCancelled()) {
			if(first) {
				@cancelled_a := true;
			}
			else {
				@cancelled_b := true;
			};
			return McpToolResult->Text("cancelled {$tag}");
		};
		return McpToolResult->Text("finished {$tag}");
	}

	function : Reset() ~ Nil {
		@started_a := false;
		@started_b := false;
		@cancelled_a := false;
		@cancelled_b := false;
		@code_a := 0;
		@code_b := 0;
		@text_a := "";
		@text_b := "";
	}

	# POSTs notifications/cancelled for a request id, as a client does on a connection of its own
	function : Cancel(url : String, id : Int) ~ Int {
		client := Web.HTTP.HttpClient->New();
		response := client->Post(Web.HTTP.Url->New(url), "{\"jsonrpc\":\"2.0\",\"method\":\"notifications/cancelled\",\"params\":{\"requestId\":{$id}}}"->ToByteArray(), "application/json");
		if(response = Nil) {
			return 0;
		};
		return response->GetCode();
	}

	function : Wait(which : Int) ~ Bool {
		waited := 0;
		done := false;
		while(<>done & waited < 20000) {
			if(which = 0) {
				done := @started_a;
			}
			else {
				done := @started_b;
			};
			if(<>done) {
				Thread->Sleep(5);
				waited += 5;
			};
		};
		return done;
	}

	function : Main(args : String[]) ~ Nil {
		@lock := ThreadMutex->New("sessionless_test");
		@text_a := "";
		@text_b := "";
		@service := McpService->New("sessionless-test", "1.0");
		@service->SetSessions(false);
		@service->AddTool("hold", "Works until cancelled", "{\"type\":\"object\",\"properties\":{\"tag\":{\"type\":\"string\"}},\"required\":[\"tag\"]}", Func2Ref->New(McpHttpSessionlessCancelTest->Hold(McpCall) ~ McpToolResult)<McpCall, McpToolResult>);

		thread := Thread->New() {
			New() { Parent() }
			method : public : Run(arg : System.Base) ~ Nil {
				McpHttpSessionlessCancelTest->Service()->ServeHttp(0);
			}
		};
		thread->Execute(Nil);

		waited := 0;
		while(@service->GetBoundPort() = 0 & waited < 10000) {
			Thread->Sleep(25);
			waited += 25;
		};
		port := @service->GetBoundPort();
		Check("the HTTP transport listens", port > 0);
		if(port <= 0) {
			"FAIL: MCP sessionless HTTP, the server did not start"->PrintLine();
			Runtime->Exit(1);
		};
		url := "http://127.0.0.1:{$port}/mcp";

		# no session is asked for
		raw := Web.HTTP.HttpClient->New();
		raw->AddHeader("Accept", "application/json, text/event-stream");
		response := raw->Post(Web.HTTP.Url->New(url), "{\"jsonrpc\":\"2.0\",\"id\":5,\"method\":\"tools/list\"}"->ToByteArray(), "application/json");
		Check("a request with no session is answered when sessions are off", response <> Nil & response->GetCode() = 200 & String->New(response->GetContent())->Has("hold"));

		# the server says what it does not do
		init := Web.HTTP.HttpClient->New();
		response := init->Post(Web.HTTP.Url->New(url), "{\"jsonrpc\":\"2.0\",\"id\":0,\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"t\",\"version\":\"1\"}}}"->ToByteArray(), "application/json");
		note : String;
		if(response <> Nil & response->GetCode() = 200) {
			answer := JsonParser->TextToElement(String->New(response->GetContent()));
			if(answer <> Nil & answer->Has("result") & answer->Get("result")->Has("_meta") & answer->Get("result")->Get("_meta")->Has("org.objeck/cancellation")) {
				note := answer->Get("result")->Get("_meta")->Get("org.objeck/cancellation")->GetString();
			};
		};
		Check("the initialize result says that cancellation is not supported without sessions", note <> Nil & note->StartsWith("unsupported"));
		headers := init->GetResponseHeaders();
		Check("and hands out no session", headers = Nil | headers->Find("mcp-session-id") = Nil);

		# two clients, each with a call numbered 1 at work
		Reset();
		first := Poster->New(url, "a", 1);
		first->Execute(Nil);
		Check("the first client's call is at work", Wait(0));
		second := Poster->New(url, "b", 1);
		second->Execute(Nil);
		Check("the second client's call, under the same id, is at work too", Wait(1));

		# the first client gives up on "1"
		Check("the cancellation is accepted with 202", Cancel(url, 1) = 202);
		first->Join();
		second->Join();
		Check("the second client's call was not cancelled by the first client's notification", <>@cancelled_b);
		Check("nor was the first client's: nothing says which of the two is meant", <>@cancelled_a);
		Check("the first client was answered", @code_a = 200 & @text_a->Has("finished a"));
		Check("the second client was answered", @code_b = 200 & @text_b->Has("finished b"));

		# one call at work and a cancellation for it: the server does not guess whose it is
		Reset();
		first := Poster->New(url, "a", 1);
		first->Execute(Nil);
		Check("a single call is at work", Wait(0));
		Check("a cancellation for it is accepted with 202", Cancel(url, 1) = 202);
		Check("and so is one for an id that is not at work", Cancel(url, 3) = 202);
		first->Join();
		Check("the call is not cancelled: without a session the server cannot know the sender is its owner", <>@cancelled_a);
		Check("and it is answered", @code_a = 200 & @text_a->Has("finished a"));

		# the same id again, one call after the other, as a single client does
		Reset();
		again := Poster->New(url, "a", 1);
		again->Execute(Nil);
		again->Join();
		Check("the id is free for the next call", @code_a = 200 & @text_a->Has("finished a"));

		Web.HTTP.Server.WebServer->Stop();

		pass := @pass;
		fail := @fail;
		if(fail = 0) {
			"PASS: MCP sessionless HTTP, {$pass} checks"->PrintLine();
		}
		else {
			"FAIL: MCP sessionless HTTP, {$fail} of {$pass + fail} checks failed"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
