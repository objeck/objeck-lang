# EXPECT_COMPILE_ERROR: (13,53): A constructor call in an entry of a map literal is not given the map's value type, so its type arguments cannot be left out
# EXPECT_ERROR_COUNT: 1
#~
An entry of a map literal is an argument of Insert, and a constructor call that is an
argument is not given a type to infer from: 'Vector->New()' as a value is refused at the
value, with what to write ('Vector->New()<IntRef>', or a declared variable). The entry
whose type arguments are written is accepted.
~#
use Collection;

class BadMapLiteralConstructorValue {
	function : Main(args : String[]) ~ Nil {
		groups : Map<String, Vector<IntRef>> := {"evens": Vector->New(), "odds": Vector->New()<IntRef>};
		groups->Size()->PrintLine();
	}
}
