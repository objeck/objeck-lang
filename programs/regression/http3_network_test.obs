# EXTRA_LIBS: net,net_quic,cipher
# JIT_DISABLE
#~
HTTP/3 client test.

This runs in the GATING suite (run_regression.sh runs every .obs here), so it
must never redden the build for an upstream outage. It follows the same rule as
the other network-touching tests: anything that could be the network is
reported and skipped, and only a genuine protocol violation is a FAIL.

The one hard failure is a silent downgrade -- a host that does not speak
HTTP/3 reporting SUCCESS. That is a real bug on any platform and cannot be
caused by network conditions. On Windows the WinHTTP backend treats HTTP/3 as
a *preference* and falls back transparently, so it asserts
WINHTTP_OPTION_HTTP_PROTOCOL_USED; an Http3Client that quietly spoke HTTP/2
would be exactly the false promise this feature was fixing.

Gating on runtime.feature.http3 is the reason that property exists: the trap
handlers compile unconditionally, so without it this test could not tell "this
build has no HTTP/3 engine" from "the request failed".
~#
use Web.HTTP;
use System;

class Http3NetworkTest {
	function : Main(args : String[]) ~ Nil {
		if(System.Runtime->GetProperty("runtime.feature.http3")->Equals("0")) {
			"SKIP: HTTP/3 not compiled into this build"->PrintLine();
			return;
		};

		pass := true;

		# --- positive: a real HTTP/3 host round-trips ----------------------
		# Never fatal: an outage or a blocked UDP 443 must not fail the build.
		client := Http3Client->New("cloudflare-quic.com");
		if(client->IsConnected() = false) {
			"  SKIP: could not establish an HTTP/3 connection (network?)"->PrintLine();
		}
		else {
			resp := client->Get("/");
			if(resp = Nil) {
				"  SKIP: HTTP/3 GET failed (network?)"->PrintLine();
			}
			else {
				code := resp->GetCode();
				body := resp->GetContent();
				size := 0;
				if(body <> Nil) { size := body->Size(); };
				"  info: GET status={$code} bytes={$size}"->PrintLine();
			};
		};
		client->Close();

		# --- negative: no silent downgrade (the real assertion) ------------
		# example.com serves HTTP/1.1 only. Reaching it and reporting success
		# means the client accepted a non-HTTP/3 connection -- a genuine bug,
		# not a network condition, so this one IS fatal.
		plain := Http3Client->New("example.com");
		if(plain->IsConnected()) {
			down := plain->Get("/");
			if(down <> Nil) {
				dc := down->GetCode();
				pass := false;
				"  FAIL: non-HTTP/3 host silently succeeded (status={$dc})"->PrintLine();
			}
			else {
				"  info: non-HTTP/3 host correctly refused"->PrintLine();
			};
		}
		else {
			"  info: non-HTTP/3 host refused at connect"->PrintLine();
		};
		plain->Close();

		if(pass) {
			"PASS: HTTP/3 network tests"->PrintLine();
		}
		else {
			"FAIL: HTTP/3 network tests"->PrintLine();
		};
	}
}
