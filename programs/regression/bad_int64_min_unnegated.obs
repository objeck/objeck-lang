# EXPECT_COMPILE_ERROR: Integer literal out of range: '9223372036854775808'
# EXPECT_ERROR_COUNT: 1
#~
9223372036854775808 is Int's minimum only when negated
(int64_min_literal). On its own, or as the right operand of a binary minus,
it is past Int's maximum and stays an error, as in Java.
~#
class BadInt64MinUnnegated {
	function : Main(args : String[]) ~ Nil {
		x := 5 - 9223372036854775808;
		x->PrintLine();
	}
}
