#~
# CsvRow->Median and CsvColumn->Median return the exact median.
#
# Both used to box every value into a FloatRef, add it to a CompareVector and sort
# that; they now copy the values into a Float[] and sort it in place with
# System.ArraySort, about 12x faster on 20,000 values. No test covered either
# method before this one, so it checks the result rather than the speed: odd and
# even counts (the mean of the two middle values), a single value, negatives and
# fractions, input that is not already sorted, and duplicates. The table is left
# unchanged, so each check also confirms the median was taken from a copy.
# EXTRA_LIBS: csv,gen_collect
~#

use Data.CSV;

class CsvMedian {
  function : Main(args : String[]) ~ Nil {
    failures := 0;

    # a column of an odd count, out of order
    odd := CsvTable->New("v,t\r\n9,a\r\n1,b\r\n5,c\r\n3,d\r\n7,e");
    failures += Check("column, odd count", odd->ColumnValues("v")->Median(), 5.0);

    # an even count takes the mean of the two middle values
    even := CsvTable->New("v,t\r\n4,a\r\n1,b\r\n3,c\r\n2,d");
    failures += Check("column, even count", even->ColumnValues("v")->Median(), 2.5);

    # negatives, fractions and duplicates
    mixed := CsvTable->New("v,t\r\n-2.5,a\r\n10,b\r\n-2.5,c\r\n0.5,d\r\n3,e\r\n-7,f");
    failures += Check("column, negatives and duplicates", mixed->ColumnValues("v")->Median(), -1.0);

    # a single value
    one := CsvTable->New("v,t\r\n42,a");
    failures += Check("column, single value", one->ColumnValues("v")->Median(), 42.0);

    # a row, out of order and even
    row := CsvTable->New("a,b,c,d\r\n7,1,5,3")->Get(1);
    failures += Check("row, even count", row->Median(), 4.0);

    # the table itself is not reordered by taking a median
    col := odd->ColumnValues("v");
    col->Median();
    if(col->Get(0)->ToFloat() <> 9.0 | col->Get(4)->ToFloat() <> 7.0) {
      "FAIL: Median reordered the column it was called on"->PrintLine();
      failures += 1;
    }
    else {
      "PASS: Median leaves the column in its original order"->PrintLine();
    };

    if(failures > 0) {
      Runtime->Exit(1);
    };
  }

  function : Check(what : String, actual : Float, expected : Float) ~ Int {
    if(actual <> expected) {
      "FAIL: {$what}: expected {$expected}, got {$actual}"->PrintLine();
      return 1;
    };
    "PASS: {$what} = {$actual}"->PrintLine();
    return 0;
  }
}
