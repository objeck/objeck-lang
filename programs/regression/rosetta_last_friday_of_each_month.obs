#~
# Rosetta Code: Last Friday of each month
# https://rosettacode.org/wiki/Last_Friday_of_each_month
# Claimed in #1155
#
# The last Friday of every month of a year, with the Date class doing the calendar work: step back one day from the first of the next month (AddDays(-1), which must cross month, leap-day and year boundaries), then back to Friday. 2012 and 2024 are leap years; 2100 is a century year that is not.
#
# Expected values: 2012 is the task page's own output; the other years were computed with an independent oracle (Python's calendar module), not recalled.
~#

use System.Time;

class RosettaLastFridayOfEachMonth {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaLastFridayOfEachMonth->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		Check("2012 (the task's example)", LastFridays(2012),
			"2012-01-27 2012-02-24 2012-03-30 2012-04-27 2012-05-25 2012-06-29 2012-07-27 2012-08-31 2012-09-28 2012-10-26 2012-11-30 2012-12-28");
		Check("2024, a leap year", LastFridays(2024),
			"2024-01-26 2024-02-23 2024-03-29 2024-04-26 2024-05-31 2024-06-28 2024-07-26 2024-08-30 2024-09-27 2024-10-25 2024-11-29 2024-12-27");
		Check("2021, where April and December end on a Friday", LastFridays(2021),
			"2021-01-29 2021-02-26 2021-03-26 2021-04-30 2021-05-28 2021-06-25 2021-07-30 2021-08-27 2021-09-24 2021-10-29 2021-11-26 2021-12-31");
		Check("2100, not a leap year", LastFridays(2100),
			"2100-01-29 2100-02-26 2100-03-26 2100-04-30 2100-05-28 2100-06-25 2100-07-30 2100-08-27 2100-09-24 2100-10-29 2100-11-26 2100-12-31");

		# the month-end steps on their own
		CheckInt("Mar 1 2012 minus a day is Feb 29", LastDay(2, 2012)->GetDay(), 29);
		CheckInt("Mar 1 2100 minus a day is Feb 28", LastDay(2, 2100)->GetDay(), 28);
		jan := LastDay(12, 2012);
		Check("Jan 1 2013 minus a day", "{$jan->GetYear()}-{$jan->GetMonth()}-{$jan->GetDay()}", "2012-12-31");

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	# the last day of the month: one day before the first of the next month
	function : LastDay(month : Int, year : Int) ~ Date {
		next_month := month + 1;
		next_year := year;
		if(next_month > 12) {
			next_month := 1;
			next_year += 1;
		};
		# AddDays recomputes the weekday; the date-only constructor alone leaves it at 0
		d := Date->New(1, next_month, next_year, true);
		d->AddDays(-1);
		return d;
	}

	function : LastFridays(year : Int) ~ String {
		out := "";
		for(m := 1; m <= 12; m += 1;) {
			d := LastDay(m, year);
			# Friday is 5; step back (weekday - 5) mod 7 days
			back := (d->GetWeekDay() - 5 + 7) % 7;
			d->AddDays(-1 * back);

			if(out->Size() > 0) {
				out->Append(' ');
			};
			out->Append(Iso(d));
		};
		return out;
	}

	function : Iso(d : Date) ~ String {
		out := "";
		out->Append(d->GetYear());
		out->Append('-');
		out->Append(TwoDigits(d->GetMonth()));
		out->Append('-');
		out->Append(TwoDigits(d->GetDay()));
		return out;
	}

	function : TwoDigits(n : Int) ~ String {
		if(n < 10) {
			return "0{$n}";
		};
		return n->ToString();
	}
}
