# EXPECT_COMPILE_ERROR: Helper has no method named
# EXPECT_ERROR_COUNT: 1
#~
The second line of the same report: the class that has no such method is the one the call was
made on, not the class the call stands in.
~#
class Helper {
	function : Add(a : Int, b : Int) ~ Int {
		return a + b;
	}
}

class BadCallReceiverNoMethod {
	function : Main(args : String[]) ~ Nil {
		Helper->Nope(1);
	}
}
