			0.521365057231138, 1.2793668188581915, 1.5978723513877473, 1.494383981538669, 1.2862715110332457, 0.6719359121587395,
			0.6108345899402442, 0.28730637513723006, 0.6749658220218775, 1.1624500664405426, 0.9572047869998096, 1.089256793166345,
