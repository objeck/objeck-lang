# EXTRA_LIBS: ml,gen_collect,csv
#~
System.ML ZScoreDetector against an independent reference.

The expected scores are numpy's (scipy.stats.zscore semantics: population
standard deviation) for the same 66 rows -- 60 correlated near-Gaussian inliers
and 6 uniform outliers in [-8, 8]^4 -- built by both sides from System.ML.Random
with arithmetic only, so the data is bit-identical. Regenerate the fixture with
ml_outlier_ref/gen_fixtures.py.

Also: the three combination rules, threshold semantics (strict >), the
sensitivity sweep is monotone, a constant feature, NaN and shape refusal.
~#
use System.ML;

class MlOutlierZScore {
	function : Main(args : String[]) ~ Nil {
		ok := true;
		X := MakeData(7, 60, 6, 4, 8.0);
		y := Labels(60, 6);

		detector : OutlierDetector := ZScoreDetector->New();
		ok := Report("unfitted before Fit", <>detector->IsFitted()) & ok;
		ok := Report("default threshold is 3.0", detector->GetThreshold() = 3.0) & ok;
		ok := Report("sensitivity is named threshold", detector->GetSensitivityName()->Equals("threshold")) & ok;

		flags := detector->FitPredict(X);
		ok := Report("FitPredict returns a label per row", flags <> Nil & flags->Size() = 66) & ok;

		scores := detector->GetTrainingScores();
		ok := Report("max-|z| scores match numpy to 1e-12", Close(scores, ExpectedMax(), 1.0e-12)) & ok;

		z := detector->As(ZScoreDetector);
		ok := Report("means match numpy", Close(z->GetMeans(), ExpectedMeans(), 1.0e-12)) & ok;
		ok := Report("population sds match numpy", Close(z->GetStdDevs(), ExpectedSds(), 1.0e-12)) & ok;

		# labels are strictly above the threshold
		agree := true;
		each(i : scores) {
			if(flags[i] <> (scores[i] > 3.0)) {
				agree := false;
			};
		};
		ok := Report("labels are score > threshold", agree) & ok;

		# Predict on the training rows equals FitPredict
		again := detector->Predict(X);
		same := again <> Nil;
		if(same) {
			each(i : flags) {
				if(again[i] <> flags[i]) {
					same := false;
				};
			};
		};
		ok := Report("Predict on the training rows equals FitPredict", same) & ok;

		decision := detector->DecisionFunction(X);
		dec_ok := decision <> Nil;
		if(dec_ok) {
			each(i : decision) {
				if((decision[i] - (scores[i] - 3.0))->Abs() > 1.0e-15) {
					dec_ok := false;
				};
			};
		};
		ok := Report("DecisionFunction is score - threshold", dec_ok) & ok;

		auc := Metrics->AucRoc(scores, y);
		ok := Report("scores feed AucRoc directly (AUC {$auc} > 0.95)", auc > 0.95) & ok;

		# the other two rules
		mean_rule := ZScoreDetector->New(1.0, ZScoreDetector->Rule->MEAN);
		mean_rule->Fit(X);
		ok := Report("mean-|z| scores match numpy", Close(mean_rule->GetTrainingScores(), ExpectedMean(), 1.0e-12)) & ok;
		rms_rule := ZScoreDetector->New(1.0, ZScoreDetector->Rule->RMS);
		rms_rule->Fit(X);
		ok := Report("rms-z scores match numpy", Close(rms_rule->GetTrainingScores(), ExpectedRms(), 1.0e-12)) & ok;

		# the lab's sweep on 630 rows: 3.0, 2.5, 2.0 flags more each time, without
		# refitting (on any data the count cannot fall; here it strictly grows)
		big := MakeData(8, 600, 30, 4, 8.0);
		sweep := ZScoreDetector->New();
		sweep->Fit(big);
		counts := Int->New[3];
		settings := [3.0, 2.5, 2.0];
		each(s : settings) {
			sweep->SetSensitivity(settings[s]);
			counts[s] := Count(sweep->Predict(big));
		};
		ok := Report("sensitivity stays fitted", sweep->IsFitted()) & ok;
		ok := Report("flags grow as the threshold falls ({$counts[0]}, {$counts[1]}, {$counts[2]})",
			counts[0] < counts[1] & counts[1] < counts[2]) & ok;
		ok := Report("a zero threshold is rejected", <>sweep->SetSensitivity(0.0)) & ok;
		ok := Report("a rejected setting changes nothing", sweep->GetSensitivity() = 2.0) & ok;

		# outliers are caught at the default threshold
		detector->SetSensitivity(3.0);
		caught := 0;
		flags := detector->Predict(X);
		for(i := 60; i < 66; i += 1;) {
			if(flags[i]) {
				caught += 1;
			};
		};
		ok := Report("at least 5 of 6 injected outliers flagged ({$caught})", caught >= 5) & ok;

		# a constant feature: |z| 0 at the constant, +Inf off it
		C := [[1.0, 5.0], [2.0, 5.0], [3.0, 5.0], [4.0, 5.0]];
		constant := ZScoreDetector->New();
		ok := Report("a constant feature fits", constant->Fit(C)) & ok;
		cs := constant->GetTrainingScores();
		ok := Report("the constant feature adds nothing in training", Near(cs[0], 1.3416407864998738, 1.0e-12)) & ok;
		off := constant->Score([[2.5, 6.0]]);
		ok := Report("a value off the constant scores +Inf", off <> Nil & off[0] = Float->Inf()) & ok;
		ok := Report("and is flagged", constant->Predict([[2.5, 6.0]])[0]) & ok;

		# refusals
		bad := [[1.0, 2.0], [3.0, 0.0], [4.0, 5.0]];
		bad[1, 1] := Float->NaN();
		nan_row := Float->New[1, 4];
		nan_row[0, 1] := Float->NaN();
		fresh := ZScoreDetector->New();
		ok := Report("NaN refuses Fit", <>fresh->Fit(bad)) & ok;
		ok := Report("the error names row 1, column 1", fresh->GetError()->Has("row 1, column 1")) & ok;
		ok := Report("NaN refuses Score", detector->Score(nan_row) = Nil) & ok;
		ok := Report("a column mismatch refuses Predict", detector->Predict([[0.0, 1.0]]) = Nil) & ok;
		ok := Report("and says why", detector->GetError()->Has("columns")) & ok;
		ok := Report("Nil refuses Fit", <>fresh->Fit(Nil)) & ok;
		ok := Report("unfitted Score is Nil", ZScoreDetector->New()->Score(X) = Nil) & ok;

		if(ok) {
			"PASS: ml_outlier_zscore"->PrintLine();
		}
		else {
			"FAIL: ml_outlier_zscore"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Count(flags : Bool[]) ~ Int {
		n := 0;
		each(i : flags) {
			if(flags[i]) {
				n += 1;
			};
		};
		return n;
	}

	function : Labels(n_in : Int, n_out : Int) ~ Bool[] {
		y := Bool->New[n_in + n_out];
		for(i := n_in; i < n_in + n_out; i += 1;) {
			y[i] := true;
		};
		return y;
	}

	function : Gauss(rng : System.ML.Random) ~ Float {
		acc := 0.0;
		each(k : 12) {
			acc += rng->NextReal();
		};
		return acc - 6.0;
	}

	function : MakeData(seed : Int, n_in : Int, n_out : Int, p : Int, spread : Float) ~ Float[,] {
		rng := System.ML.Random->New(seed);
		X := Float->New[n_in + n_out, p];
		z := Float->New[p];
		each(i : n_in) {
			each(j : p) {
				z[j] := Gauss(rng);
			};
			each(j : p) {
				v := z[j];
				if(j > 0) {
					v := v + 0.5 * z[j - 1];
				};
				X[i, j] := v;
			};
		};
		for(i := n_in; i < n_in + n_out; i += 1;) {
			each(j : p) {
				X[i, j] := rng->NextReal() * (2.0 * spread) - spread;
			};
		};
		return X;
	}

	function : Near(a : Float, b : Float, tol : Float) ~ Bool {
		scale := b->Abs();
		if(scale < 1.0) {
			scale := 1.0;
		};
		return (a - b)->Abs() <= tol * scale;
	}

	function : Close(a : Float[], b : Float[], tol : Float) ~ Bool {
		if(a = Nil | b = Nil | a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(<>Near(a[i], b[i], tol)) {
				"  mismatch at {$i}: {$a[i]} vs {$b[i]}"->PrintLine();
				return false;
			};
		};
		return true;
	}

	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};
		return passed;
	}

	# BEGIN GENERATED FIXTURE
	# by ml_outlier_ref/gen_fixtures.py; do not edit by hand
