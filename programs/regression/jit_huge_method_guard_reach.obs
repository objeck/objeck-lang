class JitHugeMethodGuardReach {
	function : Main(args : String[]) ~ Nil {
		failures := 0;
		h := Huge->New();
		a := Int->New[4];
		a[0] := 3;
		a[1] := 5;
		a[2] := 7;
		a[3] := 11;

		# a[1] + 30000 * a[2] + a[1]
		expected := 5 + 30000 * 7 + 5;
		wrong := 0;
		for(n := 0; n < 200; n += 1;) {
			if(h->Big(a, 1, 2)->Get() <> expected) {
				wrong += 1;
			};
		};
		if(wrong = 0) {
			"PASS: 200 calls returned {$expected}"->PrintLine();
		}
		else {
			"FAIL: {$wrong} of 200 calls returned the wrong sum"->PrintLine();
			failures += 1;
		};

		# out of bounds at the first read: the guard furthest from its fault path
		r := h?->Big(a, 9, 2);
		if(r = Nil & Runtime->GetLastError()->TypeOf(IndexError)) {
			"PASS: an index past the end at the first read is an IndexError"->PrintLine();
		}
		else {
			"FAIL: an index past the end at the first read was not recovered as an IndexError"->PrintLine();
			failures += 1;
		};

		r := h?->Big(a, -1, 2);
		if(r = Nil & Runtime->GetLastError()->TypeOf(IndexError)) {
			"PASS: a negative index at the first read is an IndexError"->PrintLine();
		}
		else {
			"FAIL: a negative index at the first read was not recovered as an IndexError"->PrintLine();
			failures += 1;
		};

		# in the generated middle
		r := h?->Big(a, 1, 4);
		if(r = Nil & Runtime->GetLastError()->TypeOf(IndexError)) {
			"PASS: an index past the end in the middle is an IndexError"->PrintLine();
		}
		else {
			"FAIL: an index past the end in the middle was not recovered as an IndexError"->PrintLine();
			failures += 1;
		};

		# a Nil array: the Nil guard of the first read
		none : Int[];
		r := h?->Big(none, 1, 2);
		if(r = Nil & Runtime->GetLastError()->TypeOf(NilError)) {
			"PASS: a Nil array at the first read is a NilError"->PrintLine();
		}
		else {
			"FAIL: a Nil array at the first read was not recovered as a NilError"->PrintLine();
			failures += 1;
		};

		# and the method still works afterwards
		if(h->Big(a, 0, 3)->Get() = 3 + 30000 * 11 + 3) {
			"PASS: the method still returns the right sum"->PrintLine();
		}
		else {
			"FAIL: the wrong sum after the recovered errors"->PrintLine();
			failures += 1;
		};

		if(failures > 0) {
			"{$failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
		"jit_huge_method_guard_reach: all checks passed"->PrintLine();
	}
}
