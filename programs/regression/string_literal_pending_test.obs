#~
# A String array literal as the innermost argument of nested calls.
#
# GENERATED by gen_string_literal_pending_test.py (the calls are long): change a
# shape there, not a call here.
#
# The arguments of a call wait on the operand stack while the later ones are
# evaluated: in 'Pass(1, .., 31, Pass(1, .., 31, <literal>))' the inner literal is
# built on top of 62 Ints. A method has room for 1,000 words there, and the loader
# refuses one that holds more. A String literal of up to 512 elements was built on
# that stack too, every element pushed before one trap copied them, so sixteen
# levels of a helper that takes 31 Ints and a String[] (496 words waiting) around a
# literal of 512 strings compiled and then would not load:
#
#   >>> Invalid bytecode: ...:Deep496Lit512:, instruction 4014: the operand stack
#   grows to 1001 words past the arguments, more than a call's room <<<
#
# A literal of more than 6 strings is now built an element at a time in a hidden
# local whatever is waiting under it, so it adds three words, not one for each
# string. Each function below returns its literal through the calls; every element
# is compared with the text its position spells, and every Int of every level is
# summed by the callee, so a waiting operand that was overwritten shows as well:
#
#   Deep496Lit512    the case reported: 496 words wait, 512 strings
#   Deep496Lit100    496 wait, 100 strings
#   Deep620Lit400    620 wait, 400 strings: 1,022 words the old way, inside the stack's 1,024 and past the verifier's 1,000
#   Deep775Lit300    775 wait, 300 strings
#   Deep961Lit512    961 wait, 512 strings
#   Deep961Lit20     961 wait, 20 strings
#   Deep992Lit40     992 wait, the most this helper leaves under the limit, 40 strings
#   Deep31Lit600     31 wait, 600 strings (already built an element at a time)
#
# What waits on the stack is still bounded: thirty-three such levels with no
# literal at all (1,023 Ints) are refused by the loader, as they must be -- the
# stack has 1,024 words.
~#

class StringLiteralPendingTest {
  @sum : static : Int;
  @failed : static : Bool;

  function : Fail(what : String) ~ Nil {
    @failed := true;
    "  FAIL: {$what}"->PrintLine();
  }

  function : Pass(p0 : Int, p1 : Int, p2 : Int, p3 : Int, p4 : Int, p5 : Int, p6 : Int, p7 : Int, p8 : Int, p9 : Int, p10 : Int, p11 : Int, p12 : Int, p13 : Int, p14 : Int, p15 : Int, p16 : Int, p17 : Int, p18 : Int, p19 : Int, p20 : Int, p21 : Int, p22 : Int, p23 : Int, p24 : Int, p25 : Int, p26 : Int, p27 : Int, p28 : Int, p29 : Int, p30 : Int, a : String[]) ~ String[] {
    @sum += p0 + p1 + p2 + p3 + p4 + p5 + p6 + p7 + p8 + p9 + p10 + p11 + p12 + p13 + p14 + p15 + p16 + p17 + p18 + p19 + p20 + p21 + p22 + p23 + p24 + p25 + p26 + p27 + p28 + p29 + p30;
    return a;
  }

  # the literal's elements are prefix + their index; the levels' Ints add up to 'sum'
  function : Check(name : String, a : String[], prefix : String, size : Int, sum : Int) ~ Nil {
    if(a = Nil | a->Size() <> size) {
      Fail("{$name}: not {$size} elements");
      return;
    };
    wrong := 0;
    each(i : a) {
      e := String->New(prefix);
      e += i;
      if(a[i] = Nil | <>a[i]->Equals(e)) {
        wrong += 1;
      };
    };
    if(wrong <> 0) {
      Fail("{$name}: {$wrong} elements are not where they were written");
    };
    if(@sum <> sum) {
      got := @sum;
      Fail("{$name}: the levels' arguments add up to {$got}, not {$sum}");
    };
  }

  # the case reported: 496 words wait, 512 strings
