#~
Loop-invariant code motion on the control-flow graph: what moves and what must not.

LICM moves a statement like `t := a * b` in front of a loop when nothing can tell
it now runs earlier or more often. It decides that from the method's control-flow
graph (core/compiler/cfg.h): the store to t may move only when t is not live at the
loop's header, that is, no path from the header reads t before the loop's own store
writes it. Every function below has the answer the unoptimized program (-opt s0)
gives, worked out by hand in the comments; a wrong move changes it. The shapes are
the ones the old pass, which looked for a backward jump to an earlier label, could
not see or got wrong: a store behind an `if`, a store after a `continue`, a store in
the inner loop of a nest, a loop that runs zero times, a do/while whose back edge is
a conditional jump, a loop with a try region and a handler that reads the slot, a
loop with an early return or a break, a select in the body, and a null array whose
length is read only in a body that never runs.

Also see opt_licm_store_hoist.obs. Exits 1 on a failure.
~#
class OptLicmCfg {
  @fails : static : Int;

  function : Main(args : String[]) ~ Nil {
    @fails := 0;

    # --- stores that must stay put ---
    # t is stored only when i > lim, and read after the loop
    Expect(ConditionalStore(3, 5, 100) = 10, "conditional store that never runs");
    Expect(ConditionalStore(3, 5, 4) = 15010, "conditional store that sometimes runs");
    # the store follows a `continue`: it ran on the odd iterations only, and t is read after the loop
    Expect(AfterContinue(3, 5) = 75015, "store after a continue, t read after the loop");
    # the same, with t used only inside the loop: moving it is allowed, the answer is the same
    Expect(AfterContinueLocalUse(3, 5) = 75, "store after a continue, t used only in the loop");
    # a break leaves before the store on one iteration; t is read after the loop
    Expect(BreakBeforeStore(3, 5) = 75015, "store after a break test, t read after the loop");
    # a loop that runs zero times leaves t alone
    Expect(ZeroTrip(3, 5, 0) = 100, "zero-trip for loop");
    Expect(ZeroTrip(3, 5, 3) = 15, "three-trip for loop");
    Expect(ZeroTripWhile(3, 5, 0) = 100, "zero-trip while loop");
    # a do/while runs its body once whatever the test says; its back edge is a conditional jump
    Expect(DoWhileOnce(3, 5, 0) = 15, "do/while with a false test runs once");
    Expect(DoWhileOnce(3, 5, 7) = 15, "do/while that loops");
    Expect(DoWhileReadFirst(3, 5) = 60, "do/while reads t before storing it");
    # an early return from before the store: t is read at the return
    Expect(EarlyReturnReadsT(3, 5, 0) = 0, "early return before the store, first iteration");
    Expect(EarlyReturnReadsT(3, 5, 2) = 30015, "early return before the store, third iteration");
    Expect(EarlyReturnAfterStore(3, 5, 3) = 45015, "early return after the store");
    Expect(EarlyReturnAfterStore(3, 5, 99) = 150, "no early return");
    # a select in the body: the store is in one case, a read of t in another
    Expect(SelectTable(3, 5) = 17015, "select (jump table) in a loop, read of t before its store");
    Expect(SelectSparse(3, 5) = 5015, "select (compares) in a loop");

    # --- a try region in the loop ---
    # the handler reads t: the first iteration's store never ran when the handler took it
    Expect(TryHandlerSeesOldT(3, 5, 0) = 7030, "handler reads t before the loop's store ran");
    Expect(TryHandlerSeesOldT(3, 5, 1) = 45, "no error raised");
    Expect(TryStoreThenRaise(3, 5, 0) = 1545015, "store, then an error the handler reads t after");
    Expect(TryStoreThenRaise(3, 5, 1) = 60015, "store, no error");

    # --- a nest: what is invariant in the inner loop but not the outer ---
    Expect(InnerLoopNest(3, 5) = 202, "invariant in the inner loop, not the outer");
    Expect(InnerLoopStoreRead(3, 5) = 60, "inner-loop store read after the inner loop, which runs zero times first");

    # --- the case the pass is for: these still give the same answer when they move ---
    Expect(StillHoistable(3, 5) = 514500, "an invariant store used only in the loop");
    Expect(ChainedInvariants(3, 5) = 6550, "a chain of invariant stores");
    Expect(FloatInvariant() = 12.0, "an invariant Float store");
    Expect(StoreOutsideAlso(3, 5) = 4 * 15, "a slot stored before the loop and again in it");

    # --- an array's length ---
    Expect(ArraySizeInHeader() = 10, "the length read in the loop test");
    Expect(NilArrayZeroTrip() = 0, "a length read in a body that never runs, on a Nil array");
    Expect(NilArrayHeaderTraps() = -1, "a length read in the loop test, on a Nil array");

    if(@fails > 0) {
      Runtime->Exit(1);
    };
    "PASS: LICM on the control-flow graph keeps every observable result"->PrintLine();
  }

  function : Expect(ok : Bool, what : String) ~ Nil {
    if(<>ok) {
      "FAIL: {$what}"->PrintLine();
      @fails += 1;
    };
  }

  # i = 0..9: t := a * b when i > lim; n counts the iterations. Returns t * 1000 + n
  function : ConditionalStore(a : Int, b : Int, lim : Int) ~ Int {
    t : Int; n := 0;
    for(i := 0; i < 10; i += 1;) {
      if(i > lim) { t := a * b; };
      n += 1;
    };
    return t * 1000 + n;
  }

  # odd i (1, 3, 5, 7, 9): five stores of a * b, s = 5 * 15 = 75, t = 15
  function : AfterContinue(a : Int, b : Int) ~ Int {
    t : Int; s := 0;
    for(i := 0; i < 10; i += 1;) {
      if(i % 2 = 0) { continue; };
      t := a * b;
      s += t;
    };
    return s * 1000 + t;
  }

  function : AfterContinueLocalUse(a : Int, b : Int) ~ Int {
    s := 0;
    for(i := 0; i < 10; i += 1;) {
      if(i % 2 = 0) { continue; };
      t := a * b;
      s += t;
    };
    return s;
  }

  # i = 0..4 store and add (s = 75, t = 15); i = 5 breaks before the store
  function : BreakBeforeStore(a : Int, b : Int) ~ Int {
    t : Int; s := 0;
    for(i := 0; i < 10; i += 1;) {
      if(i = 5) { break; };
      t := a * b;
      s += t;
    };
    return s * 1000 + t;
  }

  function : ZeroTrip(a : Int, b : Int, n : Int) ~ Int {
    t := 100;
    for(i := 0; i < n; i += 1;) {
      t := a * b;
    };
    return t;
  }

  function : ZeroTripWhile(a : Int, b : Int, n : Int) ~ Int {
    t := 100; i := 0;
    while(i < n) {
      t := a * b;
      i += 1;
    };
    return t;
  }

  function : DoWhileOnce(a : Int, b : Int, n : Int) ~ Int {
    t := 100; i := 0;
    do {
      t := a * b;
      i += 1;
    }
    while(i < n);
    return t;
  }

  # reads t before the store: 0 + 15 + 15 + 15 + 15 = 60 over five passes (the first adds the zero it started as)
  function : DoWhileReadFirst(a : Int, b : Int) ~ Int {
    t : Int; s := 0; i := 0;
    do {
      s += t;
      t := a * b;
      i += 1;
    }
    while(i < 5);
    return s;
  }

  # returns at i = lim before the store; s counts the stores before it (15 each), t is 0 or 15
  function : EarlyReturnReadsT(a : Int, b : Int, lim : Int) ~ Int {
    t : Int; s := 0;
    for(i := 0; i < 10; i += 1;) {
      if(i = lim) { return s * 1000 + t; };
      t := a * b;
      s += t;
    };
    return s;
  }

  # returns at i = lim after k := a * b ran 4 times (lim = 3: s = 45, k = 15)
  function : EarlyReturnAfterStore(a : Int, b : Int, lim : Int) ~ Int {
    s := 0;
    for(i := 0; i < 10; i += 1;) {
      k := a * b;
      if(i = lim) { return s * 1000 + k; };
      s += k;
    };
    return s;
  }

  # i % 3: 0 reads t, 1 stores it, 2 adds one. i = 0: +0, 1: t = 15, 2: +1, 3: +15, 4: t = 15, 5: +1 -> s = 17
  function : SelectTable(a : Int, b : Int) ~ Int {
    t : Int; s := 0;
    for(i := 0; i < 6; i += 1;) {
      select(i % 3) {
        label 0: { s += t; }
        label 1: { t := a * b; }
        other: { s += 1; }
      };
    };
    return s * 1000 + t;
  }

  # i = 0..5 with sparse labels (compares, not a table): i = 1 stores t = 15, label 40 never hits, the other five add 1 -> 5015
  function : SelectSparse(a : Int, b : Int) ~ Int {
    t : Int; s := 0;
    for(i := 0; i < 6; i += 1;) {
      select(i) {
        label 1: { t := a * b; }
        label 40: { s += t; }
        other: { s += 1; }
      };
    };
    return s * 1000 + t;
  }

  # i = 0 raises before the store (the handler sees t = 7: s = 7000); i = 1, 2 store and add 15
  function : TryHandlerSeesOldT(a : Int, b : Int, z : Int) ~ Int {
    t := 7; s := 0;
    for(i := 0; i < 3; i += 1;) {
      try {
        if(i = 0) { w := 1 / z; if(w < 0) { s += 1; }; };
        t := a * b;
        s += t;
      }
      on(e : Error) {
        s += t * 1000;
      };
    };
    return s;
  }

  # z = 0: i = 2 stores t = 15 then raises; s = 15 * 3 + 1500 = 1545. Returns s * 1000 + t
  function : TryStoreThenRaise(a : Int, b : Int, z : Int) ~ Int {
    t := 5; s := 0;
    for(i := 0; i < 4; i += 1;) {
      try {
        t := a * b;
        if(i = 2) { w := 1 / z; if(w < 0) { s += 1; }; };
        s += t;
      }
      on(e : Error) {
        s += t * 100;
      };
    };
    return s * 1000 + t;
  }

  # k = a * b + i is invariant in the j loop only; m = a - b in both. Sum over i of (3 * (15 + i) + 3 - 2) = 202
  function : InnerLoopNest(a : Int, b : Int) ~ Int {
    s := 0;
    for(i := 0; i < 4; i += 1;) {
      for(j := 0; j < 3; j += 1;) {
        k := a * b + i;
        s += k + j;
      };
      m := a - b;
      s += m;
    };
    return s;
  }

  # t is stored in the inner loop and read after it. At i = 0 the inner loop runs zero times and t is 0;
  # at i = 1..4 it runs and t = 15: s = 0 + 15 + 15 + 15 + 15 = 60
  function : InnerLoopStoreRead(a : Int, b : Int) ~ Int {
    t : Int; s := 0;
    for(i := 0; i < 5; i += 1;) {
      for(j := 0; j < i; j += 1;) {
        t := a * b;
      };
      s += t;
    };
    return s;
  }

  function : StillHoistable(a : Int, b : Int) ~ Int {
    s := 0;
    for(i := 0; i < 1000; i += 1;) {
      k := a * b;
      s += k + i;
    };
    return s;
  }

  # k = 15, m = 16: 100 * 16 + (0 + .. + 99) = 6550
  function : ChainedInvariants(a : Int, b : Int) ~ Int {
    s := 0;
    for(i := 0; i < 100; i += 1;) {
      k := a * b;
      m := k + 1;
      s += m + i;
    };
    return s;
  }

  function : FloatInvariant() ~ Float {
    x := 1.5; y := 2.0; s := 0.0;
    for(i := 0; i < 4; i += 1;) {
      f := x * y;
      s += f;
    };
    return s;
  }

  # t is set before the loop and again in it; the loop runs 4 times and then t is read
  function : StoreOutsideAlso(a : Int, b : Int) ~ Int {
    t := 1; s := 0;
    for(i := 0; i < 4; i += 1;) {
      t := a * b;
      s += t;
    };
    return s;
  }

  function : ArraySizeInHeader() ~ Int {
    arr := Int->New[10];
    n := 0;
    for(i := 0; i < arr->Size(); i += 1;) {
      n += 1;
    };
    return n;
  }

  # the body never runs, so a Nil array's length is never read
  function : NilArrayZeroTrip() ~ Int {
    arr : Int[]; s := 0; n := 0;
    while(n < 0) {
      s += arr->Size();
      n += 1;
    };
    return s;
  }

  # the loop test reads the length of a Nil array: it raises, here and at -opt s0
  function : NilArrayHeaderTraps() ~ Int {
    arr : Int[];
    try {
      for(i := 0; i < arr->Size(); i += 1;) {
      };
    }
    on(e : Error) {
      return -1;
    };
    return 1;
  }
}
