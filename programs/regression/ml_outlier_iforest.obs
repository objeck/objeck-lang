# EXTRA_LIBS: ml,gen_collect,csv
#~
System.ML IsolationForest.

The average path length c(n) is checked exactly against the formula. A forest is
random, so its scores cannot match a reference value for value; instead an
independent numpy forest (its own generator, 2000 trees) scored the same 315 rows
-- 300 correlated near-Gaussian inliers and 15 uniform outliers, built by both
sides from System.ML.Random with arithmetic only -- and the Spearman rank
correlation with this forest's scores must exceed 0.99. Regenerate the fixture
with ml_outlier_ref/gen_fixtures.py.

Also: seeded determinism, the "auto" and contamination thresholds, the flagged
fraction, SetSensitivity equal to a fresh fit, max_samples capping, a constant
feature, a single row, injected-outlier detection and refusals.
~#
use System.ML;

class MlOutlierIForest {
	function : Main(args : String[]) ~ Nil {
		ok := true;

		# c(n), exactly
		ns := [1, 2, 3, 4, 5, 10, 100, 256, 1000, 100000];
		expected_c := ExpectedC();
		c_ok := true;
		each(i : ns) {
			if(IsolationForest->AveragePathLength(ns[i]) <> expected_c[i]) {
				c_ok := false;
				"  c({$ns[i]}) mismatch"->PrintLine();
			};
		};
		ok := Report("c(n) matches the formula exactly for 10 sizes", c_ok) & ok;

		X := MakeData(21, 300, 15, 4, 8.0);
		y := Labels(300, 15);

		forest := IsolationForest->New(1000, 0, 0.0, 7);
		ok := Report("fits", forest->Fit(X)) & ok;
		ok := Report("max_samples defaults to min(256, n)", forest->GetSampleSize() = 256) & ok;
		ok := Report("1000 trees", forest->GetTreeCount() = 1000) & ok;
		scores := forest->GetTrainingScores();
		rho := Spearman(scores, ReferenceScores());
		ok := Report("rank correlation with the numpy forest is {$rho} > 0.99", rho > 0.99) & ok;
		reference := ReferenceScores();
		gap := 0.0;
		worst := 0.0;
		each(i : scores) {
			d := (scores[i] - reference[i])->Abs();
			gap += d;
			if(d > worst) {
				worst := d;
			};
		};
		gap := gap / scores->Size()->As(Float);
		ok := Report("score values agree too: mean |diff| {$gap} < 0.005, max {$worst} < 0.03", gap < 0.005 & worst < 0.03) & ok;

		in_range := true;
		each(i : scores) {
			if(scores[i] <= 0.0 | scores[i] > 1.0) {
				in_range := false;
			};
		};
		ok := Report("scores lie in (0, 1]", in_range) & ok;

		auc := Metrics->AucRoc(scores, y);
		ok := Report("scores feed AucRoc (AUC {$auc} > 0.97)", auc > 0.97) & ok;

		# defaults: 100 trees, auto contamination
		default_forest : OutlierDetector := IsolationForest->New();
		flags := default_forest->FitPredict(X);
		ok := Report("auto contamination thresholds at 0.5", default_forest->GetThreshold() = 0.5) & ok;
		rho100 := Spearman(default_forest->GetTrainingScores(), ReferenceScores());
		ok := Report("100 trees still correlate {$rho100} > 0.95", rho100 > 0.95) & ok;
		caught := 0;
		for(i := 300; i < 315; i += 1;) {
			if(flags[i]) {
				caught += 1;
			};
		};
		ok := Report("auto flags at least 12 of 15 injected outliers ({$caught})", caught >= 12) & ok;

		fp := Fingerprint(default_forest->GetTrainingScores());
		"  fingerprint: {$fp}"->PrintLine();

		# determinism
		again := IsolationForest->New(100, 0, 0.0, 42);
		again->Fit(X);
		ok := Report("same seed, identical scores", Same(again->GetTrainingScores(), default_forest->GetTrainingScores())) & ok;
		reseeded := IsolationForest->New(100, 0, 0.0, 43);
		reseeded->Fit(X);
		ok := Report("another seed, different scores", <>Same(reseeded->GetTrainingScores(), default_forest->GetTrainingScores())) & ok;

		# contamination sets the training flagged fraction; 0.05 of 315 rows: the
		# threshold interpolates between the 15th and 16th highest scores
		c05 := IsolationForest->New(100, 0, 0.05, 42);
		f05 := c05->FitPredict(X);
		n05 := Count(f05);
		ok := Report("contamination 0.05 flags 16 of 315 ({$n05})", n05 = 16) & ok;
		c10 := IsolationForest->New(100, 0, 0.10, 42);
		n10 := Count(c10->FitPredict(X));
		c01 := IsolationForest->New(100, 0, 0.01, 42);
		n01 := Count(c01->FitPredict(X));
		ok := Report("0.01 < 0.05 < 0.10 in flags ({$n01}, {$n05}, {$n10})", n01 < n05 & n05 < n10) & ok;

		# SetSensitivity keeps the trees: same threshold and labels as a fresh fit
		c05->SetSensitivity(0.10);
		ok := Report("SetSensitivity equals a fresh fit", c05->GetThreshold() = c10->GetThreshold() & c05->IsFitted()) & ok;
		ok := Report("contamination 0.7 is rejected", <>c05->SetSensitivity(0.7)) & ok;

		# new rows: an outlier and an inlier
		probe := [[0.1, 0.0, -0.1, 0.05], [7.5, -7.5, 7.5, -7.5]];
		ps := default_forest->Score(probe);
		ok := Report("a far row outscores a central one", ps <> Nil & ps[1] > ps[0]) & ok;
		pd := default_forest->DecisionFunction(probe);
		ok := Report("DecisionFunction is score - 0.5", pd <> Nil & pd[1] = ps[1] - 0.5) & ok;

		# max_samples is capped at n; a constant feature never splits
		C := Float->New[50, 3];
		each(i : 50) {
			C[i, 0] := i->As(Float);
			C[i, 1] := 4.0;
			C[i, 2] := (i % 7)->As(Float);
		};
		capped := IsolationForest->New(20, 500, 0.0, 1);
		ok := Report("a constant feature fits", capped->Fit(C)) & ok;
		ok := Report("max_samples 500 is capped at 50", capped->GetSampleSize() = 50) & ok;
		cs := capped->Score([[25.0, 4.0, 3.0], [25.0, 900.0, 3.0]]);
		ok := Report("the constant feature never splits (score ignores it)", cs <> Nil & cs[0] = cs[1]) & ok;

		single := IsolationForest->New();
		ok := Report("a single row fits", single->Fit([[1.0, 2.0]])) & ok;
		ok := Report("and scores 1, as sklearn", single->GetTrainingScores()[0] = 1.0) & ok;

		# refusals
		bad := MakeData(5, 20, 0, 3, 1.0);
		bad[19, 2] := Float->NaN();
		r := IsolationForest->New();
		ok := Report("NaN is refused", <>r->Fit(bad) & r->GetError()->Has("row 19, column 2")) & ok;
		ok := Report("0 trees are refused", <>IsolationForest->New(0, 0, 0.0, 1)->Fit(X)) & ok;
		ok := Report("unfitted Score is Nil", IsolationForest->New()->Score(X) = Nil) & ok;
		ok := Report("a column mismatch is refused", default_forest->Score([[1.0]]) = Nil) & ok;

		if(ok) {
			"PASS: ml_outlier_iforest"->PrintLine();
		}
		else {
			"FAIL: ml_outlier_iforest"->PrintLine();
			Runtime->Exit(1);
		};
	}

	# Spearman: Pearson correlation of the ranks (average ranks for ties)
	function : Spearman(a : Float[], b : Float[]) ~ Float {
		ra := Ranks(a);
		rb := Ranks(b);
		n := a->Size()->As(Float);
		ma := 0.0;
		mb := 0.0;
		each(i : ra) {
			ma += ra[i];
			mb += rb[i];
		};
		ma := ma / n;
		mb := mb / n;
		sab := 0.0;
		saa := 0.0;
		sbb := 0.0;
		each(i : ra) {
			da := ra[i] - ma;
			db := rb[i] - mb;
			sab += da * db;
			saa += da * da;
			sbb += db * db;
		};
		return sab / Float->Sqrt(saa * sbb);
	}

	function : Ranks(v : Float[]) ~ Float[] {
		n := v->Size();
		ranks := Float->New[n];
		each(i : n) {
			less := 0;
			equal := 0;
			each(j : n) {
				if(v[j] < v[i]) {
					less += 1;
				}
				else if(v[j] = v[i]) {
					equal += 1;
				};
			};
			ranks[i] := less->As(Float) + (equal + 1)->As(Float) / 2.0;
		};
		return ranks;
	}

	function : Same(a : Float[], b : Float[]) ~ Bool {
		if(a->Size() <> b->Size()) {
			return false;
		};
		each(i : a) {
			if(a[i] <> b[i]) {
				return false;
			};
		};
		return true;
	}

	function : Count(flags : Bool[]) ~ Int {
		n := 0;
		each(i : flags) {
			if(flags[i]) {
				n += 1;
			};
		};
		return n;
	}

	function : Labels(n_in : Int, n_out : Int) ~ Bool[] {
		y := Bool->New[n_in + n_out];
		for(i := n_in; i < n_in + n_out; i += 1;) {
			y[i] := true;
		};
		return y;
	}

	function : Gauss(rng : System.ML.Random) ~ Float {
		acc := 0.0;
		each(k : 12) {
			acc += rng->NextReal();
		};
		return acc - 6.0;
	}

	function : MakeData(seed : Int, n_in : Int, n_out : Int, p : Int, spread : Float) ~ Float[,] {
		rng := System.ML.Random->New(seed);
		X := Float->New[n_in + n_out, p];
		z := Float->New[p];
		each(i : n_in) {
			each(j : p) {
				z[j] := Gauss(rng);
			};
			each(j : p) {
				v := z[j];
				if(j > 0) {
					v := v + 0.5 * z[j - 1];
				};
				X[i, j] := v;
			};
		};
		for(i := n_in; i < n_in + n_out; i += 1;) {
			each(j : p) {
				X[i, j] := rng->NextReal() * (2.0 * spread) - spread;
			};
		};
		return X;
	}

	# printed so runs under different -opt levels and JIT modes can be diffed: the
	# scores to 1e-12, folded into one integer
	function : Fingerprint(v : Float[]) ~ Int {
		total := 0;
		each(i : v) {
			total += (v[i] * 1000000000000.0)->As(Int) * (i % 7 + 1);
		};
		return total;
	}

	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};
		return passed;
	}

