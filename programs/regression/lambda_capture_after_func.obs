#~
Regression: a lambda capture that follows a captured function value.

Found by the Rosetta batch-3 closure tasks (Currying, Function composition,
Partial function application). A closure's captures are numbered by WORD, and a
function value takes two words: closure_space allocated two for it and the
garbage collector scanned two, but EmitLambda numbered the ids one per capture.
So in

    \(Int) ~ Int : (x) => f(x) + k

with f captured first, k was stored over f's second word. Calling f then
crashed, in every execution mode. Capture order is the order of first
reference, so `k + f(x)` worked and `f(x) + k` did not -- and FEATURES.md's
Compose example, which composes closures, crashed for most argument pairs.

The object case matters for the collector: an object captured after a function
value sat in the word the collector scanned as part of the function, so it was
never marked from the closure.

Found while writing this test: the result of a call through a function value
never got its own cast. `h(4)->As(Float)` and the I2F of `h(4) * 2.0` were
dropped, so the Int's bits were read as a Float (4.9e-323 for 10); only calls
chained after it were cast.
~#

class Box {
	@v : Int;

	New(v : Int) {
		@v := v;
	}

	method : public : Get() ~ Int {
		return @v;
	}
}

class LambdaCaptureAfterFunc {
	@failures : Int;

	New() {
		@failures := 0;
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	function : MakeAdder(n : Int) ~ (Int) ~ Int {
		return \(Int) ~ Int : (x) => x + n;
	}

	function : Twice(x : Int) ~ Int {
		return x * 2;
	}

	# f is referenced first, so it is captured first; k follows it
	function : Wrap(f : (Int) ~ Int, k : Int) ~ (Int) ~ Int {
		return \(Int) ~ Int : (x) => f(x) + k;
	}

	function : Compose(f : (Int) ~ Int, g : (Int) ~ Int) ~ (Int) ~ Int {
		return \(Int) ~ Int : (x) => f(g(x));
	}

	# a function value, then an object, then a Float
	function : Scale(f : (Int) ~ Int, b : Box, w : Float) ~ (Int) ~ Int {
		return \(Int) ~ Int : (x) => (f(x) * b->Get()->As(Float) * w)->As(Int);
	}

	method : Run() ~ Nil {
		inc := MakeAdder(1);
		a3 := MakeAdder(3);
		a100 := MakeAdder(100);
		twice := Twice(Int) ~ Int;

		w1 := Wrap(inc, 10);
		CheckInt("f(x) + k", w1(0), 11);
		tt := Wrap(Wrap(inc, 10), 100);
		CheckInt("wrapped twice", tt(0), 111);
		k1 := Compose(a3, a100);
		CheckInt("compose two closures", k1(1), 104);
		k2 := Compose(twice, a100);
		CheckInt("compose function then closure", k2(1), 202);
		k3 := Compose(a3, twice);
		CheckInt("compose closure then function", k3(1), 5);
		k4 := Compose(twice, twice);
		CheckInt("compose two functions", k4(1), 4);

		# two composers live at once stay independent
		c1 := Compose(a3, a100);
		c2 := Compose(twice, a3);
		CheckInt("first composer", c1(0), 103);
		CheckInt("second composer", c2(0), 6);
		CheckInt("first composer again", c1(1), 104);

		# a cast on the result of a call through a function value
		h := Twice(Int) ~ Int;
		f1 := h(4)->As(Float);
		CheckInt("function value result As(Float)", (f1 * 2.0)->As(Int), 16);
		CheckInt("closure result promoted in Int * Float", (inc(4) * 2.0)->As(Int), 10);
		CheckInt("function value result promoted", (h(4) * 0.5)->As(Int), 4);

		# an object captured after a function value survives collections
		s := Scale(inc, Box->New(3), 2.0);
		sum := 0;
		for(i := 0; i < 20000; i += 1;) {
			junk := Box->New(i);
			sum += junk->Get() % 2;
			if(i % 5000 = 0) {
				sum += s(i % 7) - s(i % 7);
			};
		};
		CheckInt("object capture after collections", s(4), 30);
		CheckInt("loop ran", sum, 10000);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Main(args : String[]) ~ Nil {
		LambdaCaptureAfterFunc->New()->Run();
	}
}
