# EXPECT_COMPILE_ERROR: (10,15): Variable already defined in this scope: 'x'
# EXPECT_ERROR_COUNT: 1
#~
A block may hide a name of an enclosing block, but within one block a name is declared once.
~#
class BadLocalRedeclaredInBlock {
	function : Twice(n : Int) ~ Int {
		if(n > 0) {
			x : Int := 1;
			x : String := "two";
			return x->Size();
		};
		return n;
	}

	function : Main(args : String[]) ~ Nil {
		Twice(1)->PrintLine();
	}
}
