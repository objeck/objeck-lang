# EXPECT_COMPILE_ERROR: Called as Shape->Grow(String)
# EXPECT_ERROR_COUNT: 1
#~
The same for a method called on an object: the report names the class of the object, and lists
the method of that name the class does have.
~#
class Shape {
	@size : Int;

	New() {
		@size := 1;
	}

	method : public : Grow(by : Int) ~ Nil {
		@size += by;
	}
}

class BadCallReceiverInstance {
	function : Main(args : String[]) ~ Nil {
		shape := Shape->New();
		shape->Grow("a lot");
	}
}
