#~
# Rosetta Code: Hex dump
# https://rosettacode.org/wiki/Hex_dump
# Claimed in #1158
#
# hexdump -C's canonical format, with an optional start offset and length, plus the xxd-style binary mode from the stretch goal. The task's string is encoded to UTF-16LE with a byte order mark, written to a temp file as bytes and read back with ReadBinaryFile, so the dump also proves bytes 0x80-0xff survive a binary write and read. The emoji is one Char on Linux (UTF-32) but a surrogate pair on Windows (UTF-16 wchar_t); the encoder handles both.
#
# Expected values: the full canonical and binary dumps are the task page's own output; the offset/length dumps were computed with an independent oracle (a Python implementation checked against the page's canonical dump), not recalled.
~#

use System.IO.Filesystem;

class RosettaHexDump {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaHexDump->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		encoded := Utf16Le("Rosetta Code is a programming chrestomathy site 😀.");
		CheckInt("UTF-16 with BOM is 104 bytes", encoded->Size(), 104);

		# used as returned: on POSIX the name is created by mkstemp, so a suffixed copy would leak it
		name := File->GetTempName();
		FileWriter->WriteFile(name, encoded);
		CheckInt("file size on disk", File->Size(name), 104);
		data := FileReader->ReadBinaryFile(name);
		File->Delete(name);
		CheckInt("bytes read back", data->Size(), 104);

		canonical := Lines([
			"00000000  ff fe 52 00 6f 00 73 00  65 00 74 00 74 00 61 00  |..R.o.s.e.t.t.a.|",
			"00000010  20 00 43 00 6f 00 64 00  65 00 20 00 69 00 73 00  | .C.o.d.e. .i.s.|",
			"00000020  20 00 61 00 20 00 70 00  72 00 6f 00 67 00 72 00  | .a. .p.r.o.g.r.|",
			"00000030  61 00 6d 00 6d 00 69 00  6e 00 67 00 20 00 63 00  |a.m.m.i.n.g. .c.|",
			"00000040  68 00 72 00 65 00 73 00  74 00 6f 00 6d 00 61 00  |h.r.e.s.t.o.m.a.|",
			"00000050  74 00 68 00 79 00 20 00  73 00 69 00 74 00 65 00  |t.h.y. .s.i.t.e.|",
			"00000060  20 00 3d d8 00 de 2e 00                           | .=.....|",
			"00000068"]);
		Check("canonical dump (the task's)", HexDump(data, 0, -1), canonical);

		Check("offset 0x14, length 0x1c", HexDump(data, 20, 28), Lines([
			"00000014  6f 00 64 00 65 00 20 00  69 00 73 00 20 00 61 00  |o.d.e. .i.s. .a.|",
			"00000024  20 00 70 00 72 00 6f 00  67 00 72 00              | .p.r.o.g.r.|",
			"00000030"]));
		Check("offset 0x60, to the end", HexDump(data, 96, -1), Lines([
			"00000060  20 00 3d d8 00 de 2e 00                           | .=.....|",
			"00000068"]));
		Check("offset past the end", HexDump(data, 112, -1), "00000068");

		binary := Lines([
			"00000000  11111111 11111110 01010010 00000000 01101111 00000000  |..R.o.|",
			"00000006  01110011 00000000 01100101 00000000 01110100 00000000  |s.e.t.|",
			"0000000c  01110100 00000000 01100001 00000000 00100000 00000000  |t.a. .|",
			"00000012  01000011 00000000 01101111 00000000 01100100 00000000  |C.o.d.|",
			"00000018  01100101 00000000 00100000 00000000 01101001 00000000  |e. .i.|",
			"0000001e  01110011 00000000 00100000 00000000 01100001 00000000  |s. .a.|",
			"00000024  00100000 00000000 01110000 00000000 01110010 00000000  | .p.r.|",
			"0000002a  01101111 00000000 01100111 00000000 01110010 00000000  |o.g.r.|",
			"00000030  01100001 00000000 01101101 00000000 01101101 00000000  |a.m.m.|",
			"00000036  01101001 00000000 01101110 00000000 01100111 00000000  |i.n.g.|",
			"0000003c  00100000 00000000 01100011 00000000 01101000 00000000  | .c.h.|",
			"00000042  01110010 00000000 01100101 00000000 01110011 00000000  |r.e.s.|",
			"00000048  01110100 00000000 01101111 00000000 01101101 00000000  |t.o.m.|",
			"0000004e  01100001 00000000 01110100 00000000 01101000 00000000  |a.t.h.|",
			"00000054  01111001 00000000 00100000 00000000 01110011 00000000  |y. .s.|",
			"0000005a  01101001 00000000 01110100 00000000 01100101 00000000  |i.t.e.|",
			"00000060  00100000 00000000 00111101 11011000 00000000 11011110  | .=...|",
			"00000066  00101110 00000000                                      |..|",
			"00000068"]);
		Check("binary dump (the task's)", BinaryDump(data), binary);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	# UTF-16LE with a byte order mark; a Char above 0xffff (UTF-32 platforms)
	# becomes a surrogate pair, a Char already in surrogate range passes through
	function : Utf16Le(text : String) ~ Byte[] {
		units := Int->New[text->Size() * 2 + 1];
		count := 0;
		units[count] := 65279;
		count += 1;
		for(i := 0; i < text->Size(); i += 1;) {
			c := text->Get(i)->As(Int);
			if(c > 65535) {
				c -= 65536;
				units[count] := 55296 + (c >> 10);
				units[count + 1] := 56320 + (c and 1023);
				count += 2;
			}
			else {
				units[count] := c;
				count += 1;
			};
		};

		bytes := Byte->New[count * 2];
		for(i := 0; i < count; i += 1;) {
			bytes[i * 2] := units[i] and 255;
			bytes[i * 2 + 1] := units[i] >> 8;
		};
		return bytes;
	}

	# canonical hexdump -C; length -1 means to the end
	function : HexDump(data : Byte[], start : Int, length : Int) ~ String {
		last := data->Size();
		if(length > -1 & start + length < last) {
			last := start + length;
		};

		out := "";
		pos := start;
		while(pos < last) {
			out->Append(Hex(pos, 8));
			out->Append("  ");
			ascii := "";
			for(i := 0; i < 16; i += 1;) {
				if(pos + i < last) {
					b := data[pos + i]->As(Int);
					out->Append(Hex(b, 2));
					out->Append(' ');
					ascii->Append(Printable(b));
				}
				else {
					out->Append("   ");
				};
				if(i = 7) {
					out->Append(' ');
				};
			};
			out->Append(" |{$ascii}|");
			out->Append('\n');
			pos += 16;
		};
		# the final line is the offset the dump stopped at
		out->Append(Hex(last, 8));
		return out;
	}

	# xxd -b style: six bytes a line, each as eight bits
	function : BinaryDump(data : Byte[]) ~ String {
		out := "";
		pos := 0;
		while(pos < data->Size()) {
			out->Append(Hex(pos, 8));
			out->Append("  ");
			ascii := "";
			for(i := 0; i < 6; i += 1;) {
				if(pos + i < data->Size()) {
					b := data[pos + i];
					out->Append(b->ToBinaryString()->PadTo(8, '0', true));
					out->Append(' ');
					ascii->Append(Printable(b->As(Int)));
				}
				else {
					out->Append("         ");
				};
			};
			out->Append(" |{$ascii}|");
			out->Append('\n');
			pos += 6;
		};
		out->Append(Hex(data->Size(), 8));
		return out;
	}

	function : Printable(b : Int) ~ Char {
		if(b >= 32 & b < 127) {
			return b->As(Char);
		};
		return '.';
	}

	# lower-case hex, zero-padded to width
	function : Hex(value : Int, width : Int) ~ String {
		digits := "0123456789abcdef";
		out := "";
		v := value;
		for(i := 0; i < width; i += 1;) {
			out->Append(digits->Get(v and 15));
			v := v >> 4;
		};
		return out->Reverse();
	}

	function : Lines(lines : String[]) ~ String {
		out := "";
		for(i := 0; i < lines->Size(); i += 1;) {
			if(i > 0) {
				out->Append('\n');
			};
			out->Append(lines[i]);
		};
		return out;
	}
}
