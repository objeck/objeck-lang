# EXPECT_COMPILE_ERROR: (24,19): Expected a name for the value after its type: 'if(value is Type name)'
# EXPECT_ERROR_COUNT: 1
#~
The binding type test names the value it binds; without a name it is `value->TypeOf(Type)`.
~#
class Part {
	New() {
	}
}

class TextPart from Part {
	New() {
		Parent();
	}

	method : public : Size() ~ Int {
		return 4;
	}
}

class BadTypeTestNoName {
	function : Main(args : String[]) ~ Nil {
		p : Part := TextPart->New();
		if(p is TextPart) {
			"text"->PrintLine();
		};
	}
}
