# EXPECT_COMPILE_ERROR: Integer label in a select on a string
# EXPECT_ERROR_COUNT: 1
#~
An integer label in a select on a string compared the hash of the string with the
integer: it compiled and could only match by accident.
~#
class BadSelectLabelIntegerOnString {
	function : Main(args : String[]) ~ Nil {
		v := "b";
		n := 2;
		r := "other";
		select(v) {
			label 98 { r := "integer"; }
			label "c" { r := "c"; }
			other { r := "other"; }
		};
		r->PrintLine();
	}
}
