# EXTRA_LIBS: ml_boost,ml,gen_collect,csv
# DIFF_TIMEOUT: 600
# reason: the --jit=off configurations take about 25 s on an idle 16-core desktop and 100-140 s on a loaded hosted Windows runner (nightly run 45775388385: 36 + 55 + 15 s for the three fits alone); the 180 s default leaves no room
#~
System.ML.Boost performance guard: 10,000 rows x 20 features.

Fits depth-4 trees (learning rate 0.1) on the first 8,000 rows and scores the other 2,000:
15 stages with the exact search, 50 with the histogram search. The data come from
boost_ref.py's make_large (the same MINSTD recipe); scikit-learn 1.9.1 needs 0.6 s for the
15-stage fit, and its test mse and XGBoost's are the REF_* numbers below.

Time guard: a wall-clock bound ("within 20 s") is not a fact about the code. The same fit
takes about 1 s with the JIT and 12 s with --jit=off on the development PC, and 36-55 s
with --jit=off on a loaded hosted runner (nightly run 45775388385), so a fixed limit flipped
the verdict between configurations and between runs. What a regression to quadratic work
changes is the SCALING, which does not depend on the machine, the load or the JIT: the same
fit on a quarter of the rows must cost about a quarter of the time (linear 4x, n log n about
4.6x, quadratic 16x). The test times 3 stages on 2,000 and on 8,000 rows (best of two, so one
slow moment does not decide it) and requires the ratio to stay under 10. The seconds go to
stderr and stdout never holds a time, so the differential runner compares the same lines in
every configuration. A hang is caught by the runners' own per-run limits.
~#
use System.ML;
use System.ML.Boost;

class MlBoostPerf {
	function : Main(args : String[]) ~ Nil {
		ok := true;
		n := 10000;
		p := 20;
		X := Float->New[n, p];
		y := Float->New[n];
		r := System.ML.Random->New(14);
		each(i : n) {
			each(j : p) {
				X[i, j] := 2.0 * r->NextReal() - 1.0;
			};

			y[i] := (2.0 * X[i, 0])->Sin() + X[i, 1] * X[i, 2] + 0.5 * X[i, 3] - X[i, 4] * X[i, 4] + 0.3 * (r->NextReal() - 0.5);
		};

		trx := Float->New[8000, p];
		tr := Float->New[8000];
		tex := Float->New[2000, p];
		te := Float->New[2000];
		each(i : n) {
			if(i < 8000) {
				each(j : p) {
					trx[i, j] := X[i, j];
				};

				tr[i] := y[i];
			}
			else {
				each(j : p) {
					tex[i - 8000, j] := X[i, j];
				};

				te[i - 8000] := y[i];
			};
		};

		REF_XGB_EXACT_MSE := 0.19376000359206005;
		REF_SK_MSE := 0.19376000591527126;
		REF_XGB_HIST_MSE := 0.12389363974295965;

		exact := GradientBoostingRegressor->New(15, 0.1, 4, 1);
		ok := Report("exact fit", exact->Fit(trx, tr)) & ok;
		exact_s := exact->GetFitSeconds();
		exact_mse := exact->Score(tex, te);
		# wall-clock seconds go to stderr: the differential runner compares stdout only
		"  exact search: {$exact_s} s"->ErrorLine();
		"  exact search: test mse {$exact_mse}"->PrintLine();
		ok := Report("exact test mse {$exact_mse} within 1% of XGBoost exact {$REF_XGB_EXACT_MSE}", Float->Abs(exact_mse - REF_XGB_EXACT_MSE) / REF_XGB_EXACT_MSE < 0.01) & ok;
		ok := Report("exact test mse within 2% of scikit-learn {$REF_SK_MSE}", Float->Abs(exact_mse - REF_SK_MSE) / REF_SK_MSE < 0.02) & ok;

		hist := GradientBoostingRegressor->New(50, 0.1, 4, 1);
		hist->SetHistogram(255);
		ok := Report("histogram fit", hist->Fit(trx, tr)) & ok;
		hist_s := hist->GetFitSeconds();
		hist_mse := hist->Score(tex, te);
		"  histogram search: {$hist_s} s"->ErrorLine();
		"  histogram search: test mse {$hist_mse}"->PrintLine();
		ok := Report("histogram test mse {$hist_mse} within 3% of XGBoost hist {$REF_XGB_HIST_MSE}", Float->Abs(hist_mse - REF_XGB_HIST_MSE) / REF_XGB_HIST_MSE < 0.03) & ok;

		# a 3-class problem of the same size runs three trees per stage
		labels := Int->New[8000];
		each(i : 8000) {
			if(tr[i] > 0.4) {
				labels[i] := 2;
			}
			else if(tr[i] > -0.4) {
				labels[i] := 1;
			};
		};

		multi := GradientBoostingClassifier->New(8, 0.1, 4, 1);
		multi->SetHistogram(255);
		ok := Report("multiclass histogram fit", multi->Fit(trx, labels)) & ok;
		"  3-class histogram, 8 stages: {$multi->GetFitSeconds()} s"->ErrorLine();
		"  3-class histogram, 8 stages: training accuracy {$multi->Score(trx, labels)}"->PrintLine();
		ok := Report("multiclass fit learns", multi->Score(trx, labels) > 0.75) & ok;

		# cost grows with the data about linearly, not quadratically (see the header)
		ok := Report("exact search cost scales sub-quadratically with the rows", Scales(trx, tr, p, false)) & ok;
		ok := Report("histogram search cost scales sub-quadratically with the rows", Scales(trx, tr, p, true)) & ok;

		if(ok = false) {
			Runtime->Exit(1);
		};

		"ml_boost_perf: ok"->PrintLine();
	}

	# Best-of-two fit time of 3 stages on the first `rows` rows.
	function : FitSeconds(trx : Float[,], tr : Float[], p : Int, rows : Int, histogram : Bool) ~ Float {
		x := Float->New[rows, p];
		t := Float->New[rows];
		each(i : rows) {
			each(j : p) {
				x[i, j] := trx[i, j];
			};

			t[i] := tr[i];
		};

		best := 1.0e9;
		each(rep : 2) {
			model := GradientBoostingRegressor->New(3, 0.1, 4, 1);
			if(histogram) {
				model->SetHistogram(255);
			};

			if(model->Fit(x, t) = false) {
				return 1.0e9;
			};

			if(model->GetFitSeconds() < best) {
				best := model->GetFitSeconds();
			};
		};

		return best;
	}

	# True when 4x the rows costs under 10x the time (linear is 4x, quadratic 16x).
	function : Scales(trx : Float[,], tr : Float[], p : Int, histogram : Bool) ~ Bool {
		small := FitSeconds(trx, tr, p, 2000, histogram);
		large := FitSeconds(trx, tr, p, 8000, histogram);
		if(small < 0.001) {
			small := 0.001;
		};

		ratio := large / small;
		"  scaling ({$histogram}): 2000 rows {$small} s, 8000 rows {$large} s, ratio {$ratio}"->ErrorLine();
		return ratio < 10.0;
	}

	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};

		return passed;
	}
}
