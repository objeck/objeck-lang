# EXTRA_LIBS: ml,gen_collect,csv
#~
RandomForest->PredictScore (votes_true / ntrees) and AUC against hand-computed values.

ml_score_metrics covers the main example, a perfect ranking and all-tied scores.
This adds what it leaves out: an inverted classifier, ties that span both classes,
the ROC and PR rows of a tied example, and a pairwise (Mann-Whitney) cross-check
on a larger set with many ties. AUC is the share of positive/negative pairs the
scores rank correctly, a tied pair counting one half; every value below is worked
out by counting pairs, not recorded from a run.

  inverted     scores 0.1 0.2 0.8 0.9, actuals T T F F: no positive outranks a
               negative, 0 of 4 pairs, AUC 0.0
  tied middle  scores 0.9 0.5 0.5 0.1, actuals T T F F: positives 0.9 and 0.5,
               negatives 0.5 and 0.1; pairs 1, 1, 0.5, 1 = 3.5 of 4, AUC 0.875
  tied levels  scores 0.8 0.8 0.6 0.6 0.4 0.4, actuals T F T T F F: positives
               0.8, 0.6, 0.6, negatives 0.8, 0.4, 0.4; 0.8 gives 0.5+1+1 = 2.5,
               each 0.6 gives 0+1+1 = 2, total 6.5 of 9, AUC 13/18
~#
use System.ML;

class MlForestScoreAuc {
	@ok : static : Bool;

	function : Main(args : String[]) ~ Nil {
		@ok := true;
		Auc();
		Curves();
		Pairwise();
		Forest();

		if(<>@ok) {
			Runtime->Exit(1);
		};
	}

	function : Auc() ~ Nil {
		Check("an inverted classifier has AUC 0.0",
			Near(Metrics->AucRoc([0.1, 0.2, 0.8, 0.9], [true, true, false, false]), 0.0));
		Check("a perfect classifier has AUC 1.0",
			Near(Metrics->AucRoc([0.9, 0.8, 0.2, 0.1], [true, true, false, false]), 1.0));
		Check("a tie across the classes counts one half: 0.875",
			Near(Metrics->AucRoc([0.9, 0.5, 0.5, 0.1], [true, true, false, false]), 0.875));
		Check("ties at every level: 13/18",
			Near(Metrics->AucRoc([0.8, 0.8, 0.6, 0.6, 0.4, 0.4], [true, false, true, true, false, false]), 13.0 / 18.0));
		Check("one positive above one negative is 1.0",
			Near(Metrics->AucRoc([2.0, 1.0], [true, false]), 1.0));
		Check("one positive below one negative is 0.0",
			Near(Metrics->AucRoc([1.0, 2.0], [true, false]), 0.0));
		Check("one positive tied with one negative is 0.5",
			Near(Metrics->AucRoc([1.0, 1.0], [true, false]), 0.5));
		Check("the inverse of a ranking has AUC 1 - AUC",
			Near(Metrics->AucRoc([-0.9, -0.5, -0.5, -0.1], [true, true, false, false]), 1.0 - 0.875));
	}

	# scores 0.9 0.5 0.5 0.1, actuals T T F F: operating points
	#   0.9: 0 false positives, 1 true positive;  0.5: 1 and 2;  0.1: 2 and 2
	function : Curves() ~ Nil {
		scores := [0.9, 0.5, 0.5, 0.1];
		actuals := [true, true, false, false];

		roc := Metrics->RocCurve(scores, actuals);
		Check("RocCurve has the origin and one row per distinct score", roc <> Nil & roc->Size()[0] = 4);
		if(roc <> Nil & roc->Size()[0] = 4) {
			Check("ROC row 1 is (fpr 0, tpr 0.5) at 0.9", Near(roc[1, 0], 0.9) & Near(roc[1, 1], 0.0) & Near(roc[1, 2], 0.5));
			Check("ROC row 2 is (fpr 0.5, tpr 1) at 0.5, the tied pair in one step",
				Near(roc[2, 0], 0.5) & Near(roc[2, 1], 0.5) & Near(roc[2, 2], 1.0));
			Check("ROC row 3 is (fpr 1, tpr 1) at 0.1", Near(roc[3, 0], 0.1) & Near(roc[3, 1], 1.0) & Near(roc[3, 2], 1.0));
		};

		pr := Metrics->PrCurve(scores, actuals);
		Check("PrCurve has one row per distinct score", pr <> Nil & pr->Size()[0] = 3);
		if(pr <> Nil & pr->Size()[0] = 3) {
			Check("PR row 0 is (recall 0.5, precision 1) at 0.9", Near(pr[0, 1], 0.5) & Near(pr[0, 2], 1.0));
			Check("PR row 1 is (recall 1, precision 2/3) at 0.5", Near(pr[1, 1], 1.0) & Near(pr[1, 2], 2.0 / 3.0));
			Check("PR row 2 is (recall 1, precision 1/2) at 0.1", Near(pr[2, 1], 1.0) & Near(pr[2, 2], 0.5));
		};

		# 0.5 recall is free; the second positive costs one of the two negatives
		Check("recall at 0% FPR is 0.5", Near(Metrics->RecallAtFpr(scores, actuals, 0.0), 0.5));
		Check("recall at 49% FPR is still 0.5", Near(Metrics->RecallAtFpr(scores, actuals, 0.49), 0.5));
		Check("recall at 50% FPR is 1.0", Near(Metrics->RecallAtFpr(scores, actuals, 0.5), 1.0));
		Check("threshold at 50% FPR is 0.5", Near(Metrics->ThresholdAtFpr(scores, actuals, 0.5), 0.5));

		# 0.5 * 1 + 0.5 * (2/3) + 0 * 1/2
		Check("average precision is 5/6", Near(Metrics->AveragePrecision(scores, actuals), 5.0 / 6.0));

		Check("an inverted classifier recalls nothing at 0% FPR",
			Near(Metrics->RecallAtFpr([0.1, 0.2, 0.8, 0.9], [true, true, false, false], 0.0), 0.0));
	}

	# 60 instances whose scores take only 7 values, so most pairs tie. The pairwise
	# count is the definition of AUC, done the slow way.
	function : Pairwise() ~ Nil {
		n := 60;
		scores := Float->New[n];
		actuals := Bool->New[n];
		each(i : n) {
			scores[i] := ((i * 7 + i / 3) % 7)->As(Float);
			actuals[i] := (i * 5 + i / 4) % 3 = 0;
		};

		wins := 0.0;
		pairs := 0.0;
		each(i : n) {
			if(actuals[i]) {
				each(j : n) {
					if(<>actuals[j]) {
						pairs += 1.0;
						if(scores[i] > scores[j]) {
							wins += 1.0;
						}
						else if(scores[i] = scores[j]) {
							wins += 0.5;
						};
					};
				};
			};
		};

		Check("the set has both classes", pairs > 0.0);
		Check("AUC equals the pairwise count with ties at one half", Near(Metrics->AucRoc(scores, actuals), wins / pairs));
	}

	# 8 rows, 3 features and a label column; the label is the first feature
	function : Data() ~ Bool[,] {
		data := Bool->New[16, 4];
		each(i : 16) {
			data[i, 0] := i % 2 = 0;
			data[i, 1] := (i / 2) % 2 = 0;
			data[i, 2] := (i / 4) % 2 = 0;
			data[i, 3] := data[i, 0];
		};

		return data;
	}

	function : Forest() ~ Nil {
		data := Data();
		labels := Bool->New[16];
		each(i : 16) {
			labels[i] := data[i, 3];
		};

		forest := RandomForest->New(4, 4, 1, 7);
		Check("an unfitted forest has no score", forest->PredictScore(data) = Nil);
		forest->Fit(data);
		scores := forest->PredictScore(data);
		Check("PredictScore gives one score per row", scores <> Nil & scores->Size() = 16);
		if(scores = Nil | scores->Size() <> 16) {
			return;
		};

		# votes_true / 4 can only be 0, 0.25, 0.5, 0.75 or 1
		quarters := true;
		in_range := true;
		each(i : 16) {
			steps := scores[i] * 4.0;
			if(Float->Abs(steps - Float->Round(steps)) > 0.000001) {
				quarters := false;
			};
			if(scores[i] < 0.0 | scores[i] > 1.0) {
				in_range := false;
			};
		};
		Check("every score is a vote count over 4 trees", quarters & in_range);

		# Predict is the score thresholded at 0.5, ties to true
		labels_out := forest->Predict(data);
		same := true;
		each(i : 16) {
			if(labels_out[i] <> (scores[i] >= 0.5)) {
				same := false;
			};
		};
		Check("Predict is PredictScore >= 0.5", same);

		# the label is a feature, so the trees find it and the ranking is perfect
		Check("the forest ranks the label perfectly", Near(Metrics->AucRoc(scores, labels), 1.0));
		Check("so recall is 1.0 at 0% FPR", Near(Metrics->RecallAtFpr(scores, labels, 0.0), 1.0));

		# a forest of one tree votes 0 or 1
		single := RandomForest->New(1, 4, 1, 7);
		single->Fit(data);
		one := single->PredictScore(data);
		binary := true;
		each(i : 16) {
			if(one[i] <> 0.0 & one[i] <> 1.0) {
				binary := false;
			};
		};
		Check("one tree scores 0.0 or 1.0", binary);

		Check("a matrix of the wrong width has no score", forest->PredictScore(Bool->New[3, 9]) = Nil);
		Check("an empty matrix has no score", forest->PredictScore(Bool->New[0, 4]) = Nil);
		none : Bool[,] := Nil;
		Check("a Nil matrix has no score", forest->PredictScore(none) = Nil);

		# without the label column the features alone are scored the same way
		features := Bool->New[16, 3];
		each(i : 16) {
			each(j : 3) {
				features[i, j] := data[i, j];
			};
		};
		without := forest->PredictScore(features);
		Check("a matrix without the label column is scored", without <> Nil & without->Size() = 16);
	}

	function : Near(a : Float, b : Float) ~ Bool {
		return Float->Abs(a - b) < 0.000001;
	}

	function : Check(text : String, passed : Bool) ~ Nil {
		if(passed) {
			"PASS: {$text}"->PrintLine();
		}
		else {
			"FAIL: {$text}"->PrintLine();
			@ok := false;
		};
	}
}
