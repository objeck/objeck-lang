# EXTRA_LIBS: regex
#
# Query.RegEx: the lazily built DFA that finds where a match ends. Covers a pattern that needs more
# states than the DFA allows (it must fall back to the NFA and still be right), characters above 255,
# one RegEx reused over many inputs (the cached transitions), '^' and '$' in the DFA, \b patterns that
# never use it, empty matches, and capture groups over many matches.
use Query.RegEx;

class RegexLazyDfa {
	@ok : Int;
	@bad : Int;

	New() {
		@ok := 0;
		@bad := 0;
	}

	function : Main(args : String[]) ~ Nil {
		t := RegexLazyDfa->New();
		t->Run();
	}

	method : Run() ~ Nil {
		StateBlowup();
		WideChars();
		Reuse();
		Anchors();
		Boundaries();
		Empty();
		Groups();
		Repeats();

		if(@bad > 0) {
			"FAIL: regex_lazy_dfa, {$@bad} failed, {$@ok} passed"->PrintLine();
			Runtime->Exit(1);
		};
		"PASS: regex_lazy_dfa ({$@ok} checks)"->PrintLine();
	}

	method : Check(what : String, cond : Bool) ~ Nil {
		if(cond) {
			@ok += 1;
		}
		else {
			"FAIL: {$what}"->PrintLine();
			@bad += 1;
		};
	}

	method : Same(what : String, got : String, want : String) ~ Nil {
		if(got = Nil | <>got->Equals(want)) {
			"FAIL: {$what}: got '{$got}', want '{$want}'"->PrintLine();
			@bad += 1;
		}
		else {
			@ok += 1;
		};
	}

	# (a|b)*a(a|b){12} matches exactly when the 13th character from the end is 'a'. A DFA needs one
	# state per 13-character window, 8192 of them, which is past the limit, so this has to fall back.
	method : StateBlowup() ~ Nil {
		re := RegEx->New("(a|b)*a(a|b){12}");
		state := 7;
		wrong := 0;
		each(n : 60) {
			s := "";
			len := 20 + n * 7;
			each(i : len) {
				state := (state * 1103515245 + 12345) and 2147483647;
				if((state / 65536) % 2 = 0) {
					s += "a";
				}
				else {
					s += "b";
				};
			};

			want := s->Get(len - 13) = 'a';
			if(re->MatchExact(s) <> want) {
				wrong += 1;
			};
		};
		Check("state blow-up falls back and stays correct ({$wrong} wrong)", wrong = 0);
	}

	method : WideChars() ~ Nil {
		zhong := "中";
		re := RegEx->New("{$zhong}+");
		Check("wide literal", re->MatchExact("{$zhong}{$zhong}{$zhong}"));
		Check("wide literal rejects other", <>re->MatchExact("{$zhong}x"));

		neg := RegEx->New("[^a]+");
		Check("negated class takes a wide char", neg->MatchExact("x{$zhong}y"));
		Same("wide in the middle of a find", RegEx->New("a.b")->FindFirst("xxa{$zhong}bxx")->GetValue(), "a{$zhong}b");
		Same("replace around wide", RegEx->New("a+")->ReplaceAll("{$zhong}aa{$zhong}a", "-"), "{$zhong}-{$zhong}-");
	}

	# the same RegEx over many inputs: transitions cached on the first input serve the rest
	method : Reuse() ~ Nil {
		re := RegEx->New("[a-c]+[0-9]{2}");
		inputs := ["a12", "abc99", "ab1", "zzz", "cba00x", "", "a1b22c333", "abcabc12"];
		want := [true, true, false, false, false, false, false, true];
		each(round : 3) {
			each(i : inputs) {
				if(re->MatchExact(inputs[i]) <> want[i]) {
					Check("reuse round {$round} input {$i}", false);
				}
				else {
					@ok += 1;
				};
			};
		};
		Check("reuse find count", re->Find("a12 bc34 d56 ab7 c89")<Result>->Size() = 3);
	}

	method : Anchors() ~ Nil {
		Check("^ab at start", RegEx->New("^ab")->FindFirst("abab") <> Nil);
		Check("^ab not later", RegEx->New("^ab")->FindFirst("xab") = Nil);
		Check("ab$ at end", RegEx->New("ab$")->FindFirst("xxab") <> Nil);
		Check("ab$ not earlier", RegEx->New("ab$")->FindFirst("abx") = Nil);
		Check("a*$ at end", RegEx->New("a*$")->FindFirst("bbaa") <> Nil);
		Check("^$ empty", RegEx->New("^$")->MatchExact(""));
		Same("find with ^ skips later", RegEx->New("^a")->ReplaceAll("aaa", "b"), "baa");
		Same("find with $ takes the last", RegEx->New("a$")->ReplaceAll("aaa", "b"), "aab");
	}

	method : Boundaries() ~ Nil {
		Check("word boundary", RegEx->New("\\bcat\\b")->FindFirst("a cat sat") <> Nil);
		Check("no boundary inside a word", RegEx->New("\\bcat\\b")->FindFirst("concatenate") = Nil);
		Check("not a boundary", RegEx->New("\\Bcat")->FindFirst("concat") <> Nil);
	}

	method : Empty() ~ Nil {
		Check("a* matches empty", RegEx->New("a*")->MatchExact(""));
		Check("a* first on b is empty at 0", RegEx->New("a*")->FindFirst("b")->GetLength() = 0);
		Check("find skips empty matches", RegEx->New("a*")->Find("baab")<Result>->Size() = 1);
		Check("empty at the end", RegEx->New("x*")->FindFirst("")->GetStart() = 0);
	}

	# {n} used to be read as {n,}, so a{2} matched aaa
	method : Repeats() ~ Nil {
		exact := RegEx->New("a{2}");
		Check("{2} matches aa", exact->MatchExact("aa"));
		Check("{2} rejects aaa", <>exact->MatchExact("aaa"));
		Check("{2} rejects a", <>exact->MatchExact("a"));
		Check("{2} find takes pairs", exact->Find("aaaaa")<Result>->Size() = 2);

		open := RegEx->New("a{2,}");
		Check("{2,} matches aaaa", open->MatchExact("aaaa"));
		Check("{2,} rejects a", <>open->MatchExact("a"));

		range := RegEx->New("a{1,3}");
		Check("{1,3} matches aaa", range->MatchExact("aaa"));
		Check("{1,3} rejects aaaa", <>range->MatchExact("aaaa"));

		Check("{2,1} is an error", <>RegEx->New("a{2,1}")->IsOk());
		Check("group {3}", RegEx->New("(ab){3}")->MatchExact("ababab"));
		Check("group {3} rejects four", <>RegEx->New("(ab){3}")->MatchExact("abababab"));
	}

	method : Groups() ~ Nil {
		re := RegEx->New("([a-z]+)-([0-9]+)");
		text := "";
		each(i : 200) {
			text += "pkg-{$i} ";
		};
		all := re->Find(text)<Result>;
		Check("group matches found", all->Size() = 200);
		Same("group 1 of the first", all->Get(10)->GetGroup(1), "pkg");
		Same("group 2 of one in the middle", all->Get(150)->GetGroup(2), "150");
	}
}
