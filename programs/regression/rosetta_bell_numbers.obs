#~
# Rosetta Code: Bell numbers
# https://rosettacode.org/wiki/Bell_numbers
#
# The number of ways to partition a set, read off the left edge of the Bell triangle. Each row starts with the previous row's LAST entry, which is the step that makes the triangle work.
#
# Expected values were computed with an independent oracle, not recalled.
~#


class RosettaBellNumbers {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaBellNumbers->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		n := 15;
		row := Int->New[n];
		next := Int->New[n];
		row[0] := 1;
		len := 1;
		out := "1 ";
		for(i := 1; i < n; i += 1;) {
			# a row begins with the previous row's last value
			next[0] := row[len - 1];
			for(j := 0; j < len; j += 1;) {
				next[j + 1] := next[j] + row[j];
			};
			len += 1;
			for(j := 0; j < len; j += 1;) {
				row[j] := next[j];
			};
			out += row[0]->ToString();
			out += " ";
		};
		Check("bell 0..14", out->Trim(),
			"1 1 2 5 15 52 203 877 4140 21147 115975 678570 4213597 27644437 190899322");

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

}
