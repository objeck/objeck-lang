# EXTRA_LIBS: net,regex,csv,misc,query
#~
Query.Structured: expressions in JOIN ... ON (docs/QUERY_DESIGN.md, "Expressions in every clause",
stage 3). Before, ON took only 'a.col = b.col'; anything else was a syntax error, and a join
whose ON did not compare a column of each side was refused. Covered, each against a
hand-computed answer, with its plan: the old column join unchanged; a key computed from an
expression on either side, and from two earlier tables; a non-equality (every pair); a key
plus other tests; a second key equality, matched as join keys are (text against a number);
OR and a constant in ON; LEFT JOIN with a test on the joined table (filters before matching)
and on the left table (keeps the row with empty cells); WHERE and ON together; placeholders;
and the refusals with their exact messages.
~#
use Query.Structured, Collection;

class QueryExprJoin {
	@failures : static : Int;
	@checks : static : Int;

	function : Check(what : String, ok : Bool) ~ Nil {
		@checks += 1;
		if(<>ok) {
			@failures += 1;
			"  FAIL: {$what}"->PrintLine();
		};
	}

	function : Csv(rs : Table) ~ String {
		if(rs = Nil) {
			return "<nil>";
		};
		return rs->ToCsv()->ReplaceAll("\r\n", "|")->ReplaceAll("\n", "|");
	}

	function : Same(what : String, c : Catalog, sql : String, expected : String, plan : String) ~ Nil {
		got := Csv(c->Query(sql));
		if(got->Equals("<nil>")) {
			got := "<nil: {$(c->GetError())}>";
		};
		ok := got->Equals(expected);
		if(<>ok) {
			"    {$sql}"->PrintLine();
			"    got:      {$got}"->PrintLine();
			"    expected: {$expected}"->PrintLine();
		};
		Check(what, ok);

		if(plan <> Nil) {
			explained := c->Explain(sql);
			ok := explained <> Nil & explained->Equals(plan);
			if(<>ok) {
				shown := explained <> Nil ? explained : "<nil>";
				"    plan: '{$shown}', wanted '{$plan}'"->PrintLine();
			};
			Check("plan: {$what}", ok);
		};
	}

	function : Refused(what : String, c : Catalog, sql : String, reason : String) ~ Nil {
		rs := c->Query(sql);
		error := c->GetError();
		ok := rs = Nil & error <> Nil & error->Equals(reason);
		if(<>ok) {
			shown := error <> Nil ? error : "no error";
			"    {$sql}: '{$shown}', wanted '{$reason}'"->PrintLine();
		};
		Check("refused: {$what}", ok);
	}

	function : Main(args : String[]) ~ Nil {
		t := Table->New("t", ["id", "k", "n"]);
		ks := ["a", "b", "a", "c", "b"];
		each(i : 5) {
			r := t->Insert();
			r->Set("id", IntRef->New(i + 1));
			r->Set("k", ks[i]);
			if(i < 4) {
				r->Set("n", IntRef->New(i + 1));
			};
		};

		u := Table->New("u", ["k", "w", "lo", "hi", "kid"]);
		uk := ["a", "b", "d"];
		uw := [2, 3, 10];
		ulo := [0, 2, 3];
		uhi := [1, 3, 9];
		ukid := ["1", "2", "9"];
		each(i : 3) {
			r := u->Insert();
			r->Set("k", uk[i]);
			r->Set("w", IntRef->New(uw[i]));
			r->Set("lo", IntRef->New(ulo[i]));
			r->Set("hi", IntRef->New(uhi[i]));
			r->Set("kid", ukid[i]);
		};

		v := Table->New("v", ["total", "tag"]);
		each(i : 4) {
			r := v->Insert();
			r->Set("total", IntRef->New(3 + i * 2));
			r->Set("tag", "v{$i}");
		};

		c := Catalog->New();
		c->Add(t);
		c->Add(u);
		c->Add(v);

		# the old form, planned as it always was
		Same("a column join", c, "select t.id, u.w from t join u on t.k = u.k order by t.id", "id,w|1,2|2,3|3,2|5,3|", "read t: every row; read u: every row");

		# keys computed from expressions
		Same("a key computed on the left", c, "select t.id, u.k from t join u on t.n + 1 = u.w", "id,k|1,a|2,b|", "read t: every row; read u: every row; join u: key computed from t.n + 1");
		Same("a key computed on the right", c, "select t.id, u.k from t join u on t.n = u.w - 1", "id,k|1,a|2,b|", "read t: every row; read u: every row; join u: key computed from u.w - 1");
		Same("a key over two earlier tables", c, "select t.id, u.k, v.tag from t join u on t.k = u.k join v on t.n + u.w = v.total", "id,k,tag|1,a,v0|2,b,v1|3,a,v1|", Nil);

		# every pair
		Same("a range join", c, "select t.id, u.k from t join u on t.n between u.lo and u.hi", "id,k|1,a|2,b|3,b|3,d|4,d|", "read t: every row; read u: every row; join u: every pair");
		Same("OR in ON", c, "select t.id, u.k from t join u on t.k = u.k or t.n = u.w", "id,k|1,a|2,a|2,b|3,a|3,b|5,b|", Nil);
		Same("a constant ON", c, "select count(*) as n from t join u on 1 = 1", "n|15|", Nil);

		# a key and other tests
		Same("a key and a comparison", c, "select t.id, u.k from t join u on t.k = u.k and t.n > u.lo", "id,k|1,a|3,a|", Nil);
		Same("a second key equality matches as keys do", c, "select t.id, u.k from t join u on t.k = u.k and t.id = u.kid", "id,k|1,a|2,b|", Nil);

		# LEFT JOIN
		Same("LEFT JOIN, a test on the joined table", c, "select t.id, u.w from t left join u on t.k = u.k and u.w > 2 order by t.id", "id,w|1,|2,3|3,|4,|5,3|", "read t: every row; where u: scan");
		Same("LEFT JOIN, a test on the left table", c, "select t.id, u.w from t left join u on t.k = u.k and t.n > 2 order by t.id", "id,w|1,|2,|3,2|4,|5,|", Nil);
		Same("LEFT JOIN, every pair", c, "select t.id, u.k from t left join u on t.n > u.hi order by t.id, u.k", "id,k|1,|2,a|3,a|4,a|4,b|5,|", Nil);

		# WHERE and ON together, and placeholders
		Same("WHERE and ON", c, "select t.id, u.k from t join u on t.n * 2 = u.w * 2 - 2 where u.k <> 'b'", "id,k|1,a|", Nil);
		s := c->Prepare("select t.id from t join u on t.n + ? = u.w where u.w > ?");
		s->Bind(1, 1);
		s->Bind(2, 2);
		got := Csv(s->Execute());
		Check("a prepared join", got->Equals("id|2|"));
		if(<>got->Equals("id|2|")) {
			"    {$got} {$(s->GetError())}"->PrintLine();
		};

		# refusals
		Refused("an aggregate in ON", c, "select t.id from t join u on sum(t.n) = u.w", "aggregates are not allowed in ON: 'sum(t.n)'");
		Refused("ON naming a later table", c, "select t.id from t join u on t.n = v.total join v on u.w = v.total", "the ON condition of the join with 'u' names a table joined after it");
		Refused("an unknown column in ON", c, "select t.id from t join u on t.zz + 1 = u.w", "unknown column 't.zz'");

		if(@failures = 0) {
			"PASS: query_expr_join ({$@checks} checks)"->PrintLine();
		}
		else {
			"FAIL: query_expr_join: {$@failures} of {$@checks} checks failed"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
