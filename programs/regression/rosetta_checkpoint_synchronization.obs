#~
# Rosetta Code: Checkpoint synchronization
# https://rosettacode.org/wiki/Checkpoint_synchronization
# Claimed in #1162
#
# EXTRA_LIBS: concurrent
#
# A reusable checkpoint for workers that assemble parts in rounds, with workers leaving part way through, as the task invites: the library's cyclic barrier, System.Concurrency.Barrier, with Await at each checkpoint and Leave when a worker is done. (This test used to build its own checkpoint from a mutex and a polled generation number, because the library had no barrier or condition variable, #1186.) The barrier counts rounds by generation, which is the whole fix for the race the task describes: a worker waits for the round it arrived in to END, not for "everyone has arrived", so a fast worker that has already reset and re-arrived cannot strand a slow one, and cannot be counted twice in one round. A waiting worker sleeps on a Condition.
#
# WHAT IS ASSERTED: an invariant, not a schedule. Every worker records its arrival at checkpoint c in a ledger (its own lock) BEFORE waiting, and on passing checkpoint c checks that every worker still in the workshop has arrived at c. A worker that passes early -- the "counted twice" bug, or no barrier at all -- sees a lagging worker and records a violation. 32 workers (deliberately more than any machine's cores) run 40 rounds; a quarter of them leave after round 10, so the barrier must also shrink correctly. Each worker allocates in its loop so collections land while threads are parked in the barrier.
#
# CONTROL: run against a scratch concurrent.obl whose Barrier->Await has its wait loop removed (arrive, then return at once): FAILED, with 13,510 premature-pass observations and 65 trips instead of 40.
#
# No expected values to source: the oracle is the invariant itself.
~#

use System.Concurrency;

# The observer: who has arrived where, under its own lock.
class Ledger {
	@mutex : ThreadMutex;
	@arrivals : Int[];
	@left : Bool[];
	@violations : Int;
	@passes : Int;

	New(workers : Int) {
		@mutex := ThreadMutex->New("ledger");
		@arrivals := Int->New[workers];
		@left := Bool->New[workers];
		@violations := 0;
		@passes := 0;
	}

	method : public : Arrive(w : Int, round : Int) ~ Nil {
		critical(@mutex) { @arrivals[w] := round; };
	}

	method : public : Leave(w : Int) ~ Nil {
		critical(@mutex) { @left[w] := true; };
	}

	# on passing checkpoint 'round': every worker still present must have
	# arrived at it
	method : public : Passed(round : Int) ~ Nil {
		critical(@mutex) {
			@passes += 1;
			for(i := 0; i < @arrivals->Size(); i += 1;) {
				if(<>@left[i] & @arrivals[i] < round) {
					@violations += 1;
				};
			};
		};
	}

	method : public : GetViolations() ~ Int {
		v := 0;
		critical(@mutex) { v := @violations; };
		return v;
	}

	method : public : GetPasses() ~ Int {
		v := 0;
		critical(@mutex) { v := @passes; };
		return v;
	}
}

class Worker from Thread {
	@id : Int;
	@rounds : Int;
	@checkpoint : Barrier;
	@ledger : Ledger;
	@completed : Int;

	New(id : Int, rounds : Int, checkpoint : Barrier, ledger : Ledger) {
		Parent("worker-{$id}");
		@id := id;
		@rounds := rounds;
		@checkpoint := checkpoint;
		@ledger := ledger;
		@completed := 0;
	}

	method : public : GetCompleted() ~ Int { return @completed; }

	method : public : Run(param : System.Base) ~ Nil {
		state := @id * 7919 + 1;
		for(round := 1; round <= @rounds; round += 1;) {
			# assemble a part: uneven work, so arrival order varies by round
			state := (state * 1103515245 + 12345) and 0x7FFFFFFF;
			spin := state % 2000;
			parts := IntRef->New(0);
			for(i := 0; i < spin; i += 1;) {
				parts := IntRef->New(parts->Get() + 1);
			};

			@ledger->Arrive(@id, round);
			@checkpoint->Await();
			@ledger->Passed(round);
			@completed += 1;
		};
		# record the departure before the barrier stops counting this worker
		@ledger->Leave(@id);
		@checkpoint->Leave();
	}
}

class RosettaCheckpointSynchronization {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaCheckpointSynchronization->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		workers := 32;
		rounds := 40;
		early := 10;
		leavers := workers / 4;

		checkpoint := Barrier->New(workers);
		ledger := Ledger->New(workers);
		crew := Worker->New[workers];
		expected_passes := 0;
		for(i := 0; i < workers; i += 1;) {
			r := rounds;
			if(i < leavers) { r := early; };
			expected_passes += r;
			crew[i] := Worker->New(i, r, checkpoint, ledger);
		};

		for(i := 0; i < workers; i += 1;) {
			crew[i]->Execute(Nil);
		};
		for(i := 0; i < workers; i += 1;) {
			crew[i]->Join();
		};

		CheckInt("no worker passed a checkpoint before every member reached it", ledger->GetViolations(), 0);
		CheckInt("every worker passed every checkpoint it signed up for", ledger->GetPasses(), expected_passes);
		CheckInt("the checkpoint tripped once per round", checkpoint->GetRounds(), rounds);
		finished := 0;
		for(i := 0; i < workers; i += 1;) {
			if(i < leavers) {
				if(crew[i]->GetCompleted() = early) { finished += 1; };
			}
			else {
				if(crew[i]->GetCompleted() = rounds) { finished += 1; };
			};
		};
		CheckInt("each worker completed exactly its own rounds", finished, workers);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
