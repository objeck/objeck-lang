#~
try / on / finally blocks (#1247, phases 2 and 3; docs/ERROR_HANDLING_DESIGN.md).

  try { ... }
  on(e : ParseError) { ... }      # tested in order; e is the error, typed
  on(e : Error) { ... }
  finally { ... };                # runs on every way out

An error no 'on' clause takes is raised again after 'finally', so a typed try
never swallows what it did not name. An error raised in a handler also runs
'finally' first. 'return', 'break' and 'continue' out of a try body or a handler
close its region and run 'finally' on the way. 'try', 'on' and 'finally' are
contextual: a variable or parameter may still be named 'on' (the standard
library has one).

Also here: a returned string literal no longer pairs with the first string
literal of a 'leaving' (or 'finally') block. The emitter's literal counter
carried over, swapped the two, and the method returned its leaving block's
literal while printing its return value.
~#
class ParseError from Error {
	@line : Int;

	New(message : String, line : Int) {
		Parent(message);
		@line := line;
	}

	method : public : GetLine() ~ Int {
		return @line;
	}
}

class Parser {
	New() {}

	method : public : Parse(s : String, line : Int) ~ Int {
		if(s->Size() = 0) {
			Runtime->Raise(ParseError->New("empty", line));
		};
		return s->ToInt();
	}

	# raises two frames down
	method : public : ParseAll(rows : String[]) ~ Int {
		total := 0;
		each(i : rows) {
			total += Parse(rows[i], i);
		};
		return total;
	}
}

class TryBlocks {
	@failures : Int;
	@trace : String;

	New() {
		@failures := 0;
		@trace := "";
	}

	method : Check(what : String, ok : Bool) ~ Nil {
		if(ok) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	method : Mark(t : String) ~ Nil {
		@trace += t;
	}

	# the handler that matches returns, with finally on the way
	method : Classify(s : String) ~ String {
		p := Parser->New();
		try {
			v := p->Parse(s, 1);
			z := 0;
			if(v = 7) {
				w := 1 / z;
			};
			return "ok {$v}";
		}
		on(e : ParseError) {
			return "parse at {$(e->GetLine())}";
		}
		on(e : DivideByZeroError) {
			return "div";
		}
		finally {
			Mark("f");
		};
	}

	# a parameter named 'on', locals named 'try' and 'finally'
	method : Contextual(on : Bool) ~ Int {
		try := 2;
		finally := 3;
		if(on) {
			return try + finally;
		};
		return 0;
	}

	method : NoHandlerReraises() ~ Nil {
		try {
			Runtime->Raise(ParseError->New("inner", 9));
		}
		finally {
			Mark("i");
		};
	}

	method : HandlerRaises() ~ Nil {
		try {
			Runtime->Raise(ParseError->New("first", 1));
		}
		on(e : ParseError) {
			Runtime->Raise(Error->New("second"));
		}
		finally {
			Mark("h");
		};
	}

	method : Rethrows() ~ Nil {
		try {
			Runtime->Raise(ParseError->New("passed on", 4));
		}
		on(e : ParseError) {
			Mark("r");
			Runtime->Raise(e);
		};
	}

	method : Run() ~ Nil {
		# each handler, and the success path, all through finally
		@trace := "";
		Check("success returns its value", Classify("12")->Equals("ok 12"));
		Check("the first handler matches", Classify("")->Equals("parse at 1"));
		Check("a later handler matches a runtime error", Classify("7")->Equals("div"));
		Check("finally ran on all three", @trace->Equals("fff"));

		# a raise two frames down
		p := Parser->New();
		line := -1;
		try {
			p->ParseAll(["1", "2", "", "4"]);
		}
		on(e : ParseError) {
			line := e->GetLine();
		};
		Check("raised two frames down", line = 2);

		# no handler: finally, then the outer one takes it
		@trace := "";
		got := "";
		try {
			NoHandlerReraises();
		}
		on(e : ParseError) {
			got := e->GetMessage();
		};
		Check("an unhandled error goes on after finally", got->Equals("inner") & @trace->Equals("i"));

		# a typed try does not take what it does not name
		got := "";
		try {
			try {
				a := Int->New[2];
				b := a[5];
			}
			on(e : ParseError) {
				got := "wrong";
			};
		}
		on(e : IndexError) {
			got := "index";
		};
		Check("an unnamed error reaches the outer try", got->Equals("index"));

		# a handler's own error: finally first, then the outer one
		@trace := "";
		got := "";
		try {
			HandlerRaises();
		}
		on(e : Error) {
			got := e->GetMessage();
		};
		Check("a handler's error goes on after finally", got->Equals("second") & @trace->Equals("h"));

		# re-raised: the same object
		@trace := "";
		line := -1;
		try {
			Rethrows();
		}
		on(e : ParseError) {
			line := e->GetLine();
		};
		Check("re-raised from a handler", line = 4 & @trace->Equals("r"));

		# break and continue through finally
		@trace := "";
		for(i := 0; i < 5; i += 1;) {
			try {
				if(i = 1) {
					continue;
				};
				if(i = 3) {
					break;
				};
				Mark("b");
			}
			finally {
				Mark("{$i}");
			};
		};
		Check("continue and break run finally", @trace->Equals("b01b23"));

		# a try inside a handler, and nested regions under a loop for the JIT
		caught := 0;
		for(i := 0; i < 3000; i += 1;) {
			try {
				if(i % 3 = 0) {
					p->Parse("", i);
				}
				else if(i % 3 = 1) {
					z := 0;
					v := i / z;
				};
			}
			on(e : ParseError) {
				try {
					x := e->As(ParseError)->GetLine() / 0;
				}
				on(f : DivideByZeroError) {
					caught += 1;
				};
			}
			on(e : DivideByZeroError) {
				caught += 1;
			};
		};
		Check("handled in a loop ({$caught})", caught = 2000);

		# contextual words
		Check("'on', 'try' and 'finally' as names", Contextual(true) = 5);

		# leaving with a returned literal
		Check("a returned literal survives a leaving block", Leaving()->Equals("value") & @trace->Equals("left"));

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	method : Leaving() ~ String {
		@trace := "";
		leaving {
			Mark("left");
		}
		return "value";
	}

	function : Main(args : String[]) ~ Nil {
		TryBlocks->New()->Run();
	}
}
