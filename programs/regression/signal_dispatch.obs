#~
Signal handlers registered with Runtime->SetSignal run on a VM thread, not inside the
operating system's signal handler.

Driven by run_vm_flag_tests.py (check_signal_dispatch), POSIX only. A handler that
runs an Objeck method from inside the signal handler allocates, takes the collector's
locks and starts an interpreter in a context where any of that can deadlock the thread
it interrupted: signalled often enough while the program allocates, the old VM hung.
Now the OS handler only records the signal and a dispatcher thread, a registered
mutator, runs the method.

  (no argument)  register both handlers and print PASS, so the regression runner can
                 run this file
  storm <file>   write <file> once both handlers are registered, then allocate hard
                 for a few seconds while the driver sends SIGINT and SIGTERM as fast
                 as it can; handlers allocate too. Exits 0 with the counts printed.
  raise          Runtime->RaiseSignal is synchronous, and its handler must have run
                 by the time RaiseSignal returns, as before.
  race <file>    eight threads register their first SIGINT and SIGTERM handlers at the
                 same moment, then <file> is written and the program waits to be looked
                 at: the driver counts the wake-up pipes and threads it has. Two threads
                 that both found the dispatcher missing each started one, and the first
                 pipe and its thread were left behind.

With OBJECK_SIGNAL_TEST_FAULT=wake or =thread the dispatcher cannot be started (its
wake-up cannot be made, its thread cannot start): SetSignal for SIGINT or SIGTERM must
then fail, saying so, rather than install a handler that would run the method inside
the operating system's signal handler.
~#
use System.Concurrency, System.IO.Filesystem;

class Registrar from Thread {
  @go : static : Bool;
  @which : Int;

  New(which : Int) {
    Parent("registrar");
    @which := which;
  }

  function : Go() ~ Nil {
    @go := true;
  }

  method : public : Run(param : Base) ~ Nil {
    # spin, so that every thread is running when the flag is set
    while(<>@go) {
    };
    if(@which % 2 = 0) {
      Runtime->SetSignal(Runtime->Signal->SIGINT, SignalDispatch->Handler(Int) ~ Nil);
    }
    else {
      Runtime->SetSignal(Runtime->Signal->SIGTERM, SignalDispatch->Handler(Int) ~ Nil);
    };
  }
}

class SignalDispatch {
  @interrupts : static : Int;
  @terminations : static : Int;
  @bytes : static : Int;

  function : Main(args : String[]) ~ Nil {
    if(args->Size() = 2 & args[0]->Equals("race")) {
      Race(args[1]);
      return;
    };

    Runtime->SetSignal(Runtime->Signal->SIGINT, Handler(Int) ~ Nil);
    Runtime->SetSignal(Runtime->Signal->SIGTERM, Handler(Int) ~ Nil);

    if(args->Size() = 0) {
      "PASS: signal_dispatch"->PrintLine();
      return;
    };

    if(args[0]->Equals("raise")) {
      Runtime->RaiseSignal(Runtime->Signal->SIGTERM);
      "raised terminations={$@terminations}"->PrintLine();
      Runtime->RaiseSignal(Runtime->Signal->SIGINT);
      "raised interrupts={$@interrupts}"->PrintLine();
      return;
    };

    writer := FileWriter->New(args[1]);
    writer->WriteString("ready");
    writer->Close();

    chars := 0;
    held : Int[] := Nil;
    for(i := 0; i < 6000000; i += 1;) {
      text := i->ToString();
      chars += text->Size();
      if(i % 100 = 0) {
        held := Int->New[64];
        held[0] := i;
      };
    };
    "done chars={$chars}"->PrintLine();
    seen := @interrupts + @terminations;
    "seen={$seen}"->PrintLine();
    "PASS: signal_dispatch storm"->PrintLine();
  }

  function : Race(ready : String) ~ Nil {
    registrars := Registrar->New[8];
    each(i : registrars) {
      registrars[i] := Registrar->New(i);
      registrars[i]->Execute(Nil);
    };
    Thread->Sleep(200);
    Registrar->Go();
    each(i : registrars) {
      registrars[i]->Join();
    };

    writer := FileWriter->New(ready);
    writer->WriteString("ready");
    writer->Close();
    # until the driver has looked and removed the file
    waited := 0;
    while(File->Exists(ready) & waited < 20000) {
      Thread->Sleep(20);
      waited += 20;
    };
    "PASS: signal_dispatch race"->PrintLine();
  }

  function : Handler(id : Int) ~ Nil {
    # allocate, as a handler that logs would
    text := id->ToString();
    @bytes += text->Size();
    if(id = Runtime->Signal->SIGINT) {
      @interrupts += 1;
    }
    else if(id = Runtime->Signal->SIGTERM) {
      @terminations += 1;
    };
  }
}
