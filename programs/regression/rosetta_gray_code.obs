#~
# Rosetta Code: Gray code
# https://rosettacode.org/wiki/Gray_code
#
# Encode with n XOR (n >> 1) and decode by XOR-ing the shifted accumulator. The round trip is the real assertion: an encoder alone can look right while the decoder disagrees.
#
# Expected values were computed with an independent oracle, not recalled.
~#


class RosettaGrayCode {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		t := RosettaGrayCode->New();
		t->Run();
	}

	New() {
		@failures := 0;
	}

	method : Check(what : String, got : String, want : String) ~ Nil {
		if(got->Equals(want)) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : CheckInt(what : String, got : Int, want : Int) ~ Nil {
		if(got = want) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}: expected {$want}, got {$got}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		out := "";
		for(n := 0; n < 32; n += 1;) {
			out += Encode(n)->ToString();
			out += " ";
		};
		Check("gray codes 0..31", out->Trim(),
			"0 1 3 2 6 7 5 4 12 13 15 14 10 11 9 8 24 25 27 26 30 31 29 28 20 21 " +
			"23 22 18 19 17 16");

		# the round trip must be the identity, and successive codes differ by one bit
		bad := 0;
		multi := 0;
		for(n := 0; n < 1000; n += 1;) {
			if(Decode(Encode(n)) <> n) { bad += 1; };
			if(n > 0) {
				if(PopCount(Encode(n) and 0xFFFF) - 0 <> 0) { };
				diff := Encode(n) xor Encode(n - 1);
				if(PopCount(diff) <> 1) { multi += 1; };
			};
		};
		CheckInt("decode undoes encode", bad, 0);
		CheckInt("successive codes differ by one bit", multi, 0);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Encode(n : Int) ~ Int {
		return n xor (n >> 1);
	}

	function : Decode(g : Int) ~ Int {
		n := g;
		shift := 1;
		while((g >> shift) <> 0) {
			n := n xor (g >> shift);
			shift += 1;
		};
		return n;
	}

	function : PopCount(n : Int) ~ Int {
		c := 0;
		while(n > 0) {
			c += n % 2;
			n := n / 2;
		};
		return c;
	}
}
