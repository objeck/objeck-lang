# EXTRA_LIBS: llm_util_clients,llm_util,regex,anthropic,openai,gemini,ollama,net,net_server,misc
#~
The llm_util_clients adapters, checked offline: how a conversation is split and turned
into each client's own message type (Anthropic, OpenAI, Gemini, Ollama), the Gemini
reply reader on recorded bodies, and the refusals an adapter makes before any request
is sent. Nothing here contacts a server or needs a key; the requests themselves are
covered by the clients' own tests.
~#

use API.LlmUtil;
use API.LlmUtil.Clients;
use Data.JSON;
use Collection;

class LlmUtilClientsTest {
  @failures : static : Int;

  function : Check(name : String, ok : Bool) ~ Nil {
    if(ok) {
      "  [PASS] {$name}"->PrintLine();
    }
    else {
      "  [FAIL] {$name}"->PrintLine();
      @failures += 1;
    };
  }

  function : Same(a : String, b : String) ~ Bool {
    if(a = Nil | b = Nil) {
      return a = Nil & b = Nil;
    };
    return a->Equals(b);
  }

  function : Turns() ~ Vector<PromptTurn> {
    turns := Vector->New()<PromptTurn>;
    turns->AddBack(PromptTurn->New("system", "Be brief."));
    turns->AddBack(PromptTurn->New("user", "Name a colour."));
    turns->AddBack(PromptTurn->New("assistant", "Blue."));
    turns->AddBack(PromptTurn->New("system", "Use one word."));
    turns->AddBack(PromptTurn->New("user", "Another."));
    return turns;
  }

  function : Main(args : String[]) ~ Nil {
    TestSplit();
    TestOpenAI();
    TestGemini();
    TestGeminiReply();
    TestAnthropic();
    TestOllama();
    TestRefusals();
    TestCounter();

    if(@failures > 0) {
      "FAIL: {$@failures} check(s) failed"->PrintLine();
      Runtime->Exit(1);
    };
    "PASS"->PrintLine();
  }

  function : TestSplit() ~ Nil {
    "-- splitting a conversation"->PrintLine();
    split := TurnSplit->New(Turns());
    Check("system turns are joined with a blank line", Same(split->GetSystem(), "Be brief.\n\nUse one word."));
    Check("the other turns keep their order", split->GetTurns()->Size() = 3 & split->GetTurns()->Get(0)->GetText()->Equals("Name a colour.") & split->GetTurns()->Get(2)->GetText()->Equals("Another."));
    Check("a sendable conversation has no problem", split->Problem() = Nil);

    none := TurnSplit->New(Vector->New()<PromptTurn>);
    Check("an empty conversation is refused", Same(none->Problem(), "the conversation has no user turn") & none->GetSystem() = Nil);
    Check("Nil turns are an empty conversation", Same(TurnSplit->New(Nil)->Problem(), "the conversation has no user turn"));

    ends_assistant := Vector->New()<PromptTurn>;
    ends_assistant->AddBack(PromptTurn->New("user", "hi"));
    ends_assistant->AddBack(PromptTurn->New("assistant", "hello"));
    Check("a conversation ending on an assistant turn is refused", Same(TurnSplit->New(ends_assistant)->Problem(), "the conversation must end with a user turn"));

    only_system := Vector->New()<PromptTurn>;
    only_system->AddBack(PromptTurn->New("system", "s"));
    Check("system turns alone are refused", TurnSplit->New(only_system)->Problem() <> Nil);
  }

  function : TestOpenAI() ~ Nil {
    "-- OpenAI messages"->PrintLine();
    pairs := PromptAdapters->OpenAIMessages(Turns());
    Check("role and text pairs in order, system turns as they are", pairs->Size() = 5 & pairs->Get(0)->GetFirst()->Equals("system") & pairs->Get(0)->GetSecond()->Equals("Be brief.") & pairs->Get(2)->GetFirst()->Equals("assistant") & pairs->Get(4)->GetSecond()->Equals("Another."));
    Check("Nil gives an empty list", PromptAdapters->OpenAIMessages(Nil)->Size() = 0);

    builder := PromptBuilder->New()->System("S")->User("U");
    from_builder := builder->ToPairs();
    Check("the builder's own ToPairs gives the same shape", from_builder->Size() = 2 & from_builder->Get(0)->GetFirst()->Equals("system"));
  }

  function : TestGemini() ~ Nil {
    "-- Gemini request pieces"->PrintLine();
    contents := PromptAdapters->GeminiContents(Turns());
    Check("system turns are left out of the contents", contents->Size() = 3);
    Check("user stays user", contents->Get(0)->Get("role")->GetString()->Equals("user") & contents->Get(2)->Get("role")->GetString()->Equals("user"));
    Check("assistant becomes model", contents->Get(1)->Get("role")->GetString()->Equals("model"));
    Check("the text is in a parts array", contents->Get(1)->Get("parts")->Get(0)->Get("text")->GetString()->Equals("Blue."));

    system := PromptAdapters->GeminiSystem(Turns());
    Check("the system instruction joins the system turns", system->Get("parts")->Get(0)->Get("text")->GetString()->Equals("Be brief.\n\nUse one word."));
    only_user := Vector->New()<PromptTurn>;
    only_user->AddBack(PromptTurn->New("user", "hi"));
    Check("no system turn, no instruction", PromptAdapters->GeminiSystem(only_user) = Nil);
    Check("Nil contents are an empty array", PromptAdapters->GeminiContents(Nil)->Size() = 0);
  }

  function : TestGeminiReply() ~ Nil {
    "-- Gemini reply reader"->PrintLine();
    chat := GeminiChatFn->New("models/gemini-2.0-flash", "unused-key");
    ok := "{\"candidates\":[{\"content\":{\"role\":\"model\",\"parts\":[{\"text\":\"Hello\"},{\"text\":\" there\"}]},\"finishReason\":\"STOP\"}]}";
    Check("text parts are joined", Same(chat->ReplyText(ok), "Hello there") & chat->GetError() = Nil);

    Check("an error body", chat->ReplyText("{\"error\":{\"code\":400,\"message\":\"API key not valid\",\"status\":\"INVALID_ARGUMENT\"}}") = Nil & Same(chat->GetError(), "API key not valid"));
    Check("no candidates (a blocked prompt)", chat->ReplyText("{\"promptFeedback\":{\"blockReason\":\"SAFETY\"}}") = Nil & chat->GetError()->StartsWith("Gemini returned no candidates"));
    Check("a candidate with no content", chat->ReplyText("{\"candidates\":[{\"finishReason\":\"SAFETY\"}]}") = Nil & Same(chat->GetError(), "the Gemini candidate has no content"));
    Check("a body that is not JSON", chat->ReplyText("<html>502</html>") = Nil & chat->GetError() <> Nil);
    Check("a Nil body", chat->ReplyText(Nil) = Nil & chat->GetError() <> Nil);
    Check("a part with no text is skipped", Same(chat->ReplyText("{\"candidates\":[{\"content\":{\"parts\":[{\"inlineData\":{}},{\"text\":\"x\"}]}}]}"), "x"));
    Check("the error clears on success", chat->ReplyText(ok) <> Nil & chat->GetError() = Nil);
  }

  function : TestAnthropic() ~ Nil {
    "-- Anthropic chat"->PrintLine();
    builder := PromptBuilder->New()->System("Be brief.")->User("Name a colour.")->Assistant("Blue.")->User("Another.");
    chat := PromptAdapters->FillAnthropic(builder, API.Anthropic.Chat->New("claude-sonnet-5-5", "unused-key"));
    messages := chat->GetMessages();
    Check("the turns are in the chat history", messages->Size() = 3 & messages->Get(0)->Get("role")->GetString()->Equals("user") & messages->Get(1)->Get("role")->GetString()->Equals("assistant"));
    Check("the text is kept", messages->Get(2)->Get("content")->GetString()->Equals("Another.") | messages->Get(2)->Get("content")->ToString()->Contains("Another."));
    Check("FillAnthropic returns the chat it was given", chat <> Nil);

    fn := AnthropicChatFn->New("claude-sonnet-5-5", "unused-key")->SetMaxTokens(100);
    Check("usage starts at zero", fn->GetLastInputTokens() = 0 & fn->GetLastOutputTokens() = 0);
  }

  function : TestOllama() ~ Nil {
    "-- Ollama chat"->PrintLine();
    builder := PromptBuilder->New()->System("Be brief.")->User("Name a colour.")->Assistant("Blue.")->User("Another.");
    chat := PromptAdapters->FillOllama(builder, API.Ollama.Chat->New("llama3"));
    messages := chat->GetMessages();
    Check("the system prompt comes first as a system message", messages->Size() = 4 & messages->Get(0)->Get("role")->GetString()->Equals("system") & messages->Get(0)->Get("content")->GetString()->Equals("Be brief."));
    Check("then the turns in order", messages->Get(2)->Get("role")->GetString()->Equals("assistant") & messages->Get(3)->Get("content")->GetString()->Equals("Another."));
  }

  function : TestRefusals() ~ Nil {
    "-- adapters refuse an unsendable conversation before any request"->PrintLine();
    empty := Vector->New()<PromptTurn>;
    ends_assistant := Vector->New()<PromptTurn>;
    ends_assistant->AddBack(PromptTurn->New("user", "hi"));
    ends_assistant->AddBack(PromptTurn->New("assistant", "hello"));

    anthropic := AnthropicChatFn->New("claude-sonnet-5-5", "unused-key");
    Check("Anthropic: empty", anthropic->Complete(empty) = Nil & Same(anthropic->GetError(), "the conversation has no user turn"));
    Check("Anthropic: ends on assistant", anthropic->Complete(ends_assistant) = Nil & Same(anthropic->GetError(), "the conversation must end with a user turn"));

    openai := OpenAIChatFn->New("gpt-4o-mini", "unused-key");
    Check("OpenAI: empty", openai->Complete(empty) = Nil & Same(openai->GetError(), "the conversation has no user turn"));
    Check("OpenAI: ends on assistant", openai->Complete(ends_assistant) = Nil & openai->GetError() <> Nil);

    gemini := GeminiChatFn->New("models/gemini-2.0-flash", "unused-key");
    Check("Gemini: empty", gemini->Complete(empty) = Nil & Same(gemini->GetError(), "the conversation has no user turn"));

    ollama := OllamaChatFn->New("llama3");
    Check("Ollama: empty", ollama->Complete(empty) = Nil & Same(ollama->GetError(), "the conversation has no user turn"));
    Check("Ollama: ends on assistant", ollama->Complete(ends_assistant) = Nil & ollama->GetError() <> Nil);

    # the adapters are ChatFn, so StructuredCall takes them
    schema := JsonParser->TextToElement("{\"type\":\"object\"}");
    outcome := StructuredCall->New(ollama, schema)->Ask(PromptBuilder->New());
    Check("StructuredCall reports an adapter's refusal", <>outcome->IsOk() & outcome->GetError()->StartsWith("the chat backend failed: "));
  }

  function : TestCounter() ~ Nil {
    "-- Gemini token counter"->PrintLine();
    counter := GeminiTokenCounter->New("models/gemini-2.0-flash", "unused-key");
    Check("empty text is exactly 0 with no request", counter->Count("") = 0 & counter->IsExact() & counter->Count(Nil) = 0);
    as_counter : TokenCounter := counter;
    Check("it is a TokenCounter, so a ContextWindow takes it", ContextWindow->New(10, as_counter)->Measure(PromptBuilder->New()) = 0);
  }
}
