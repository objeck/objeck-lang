#~
# TCPSecureSocket->WriteByte and DTLSSocket->WriteByte say whether they wrote
#
# Both are documented "@return true if byte was written, false otherwise" but
# answered true whatever happened: the platform write helpers returned
# nothing, and the traps pushed 1. They now return the write's outcome, and a
# failed write is recorded for GetLastError like any other TLS failure.
#
# Each server reads one byte and hangs up (the DTLS one closes its port as
# well), so the client's first write works and a later one fails: the TLS one
# on the reset, the DTLS one on the server's close_notify (or, if that was
# lost, the network's refusal of a datagram to the closed port), which
# GetLastError names.
#
# The client waits for the hang-up thread to finish before it expects a write
# to fail: a write can only fail once the peer HAS closed, and the three
# seconds of writes that follow are for the network to tell the client so (on
# Windows loopback the second or third send after the peer's close fails).
# Without the join the test assumed the server thread had accepted, read and
# closed within those three seconds, which it had not on a Windows ARM64 box
# in a full regression pass (every one of the 300 writes succeeded, no error;
# 10 of 10 alone), nor once on x64 Windows under load. How long the hang-up
# took is printed, so a slow server thread is visible rather than hidden.
# EXTRA_LIBS: net
~#

use System.Concurrency, System.IO.Filesystem, System.IO.Net;

class TlsHangUp from Thread {
	@server : TCPSecureSocketServer;

	New(server : TCPSecureSocketServer) {
		Parent("tls-hang-up");
		@server := server;
	}

	method : public : Run(param : Base) ~ Nil {
		client := @server->Accept();
		if(client <> Nil) {
			client->ReadByte();
			client->Close();
		};
		@server->Close();
	}
}

class DtlsHangUp from Thread {
	@server : DTLSSocketServer;

	New(server : DTLSSocketServer) {
		Parent("dtls-hang-up");
		@server := server;
	}

	method : public : Run(param : Base) ~ Nil {
		client := @server->Accept();
		if(client <> Nil) {
			client->ReadByte();
			client->Close();
		};
		@server->Close();
	}
}

class TlsWriteByteResult {
	@failed : static : Int;
	# the certificate and key carry the process id, as the other TLS tests' fixtures do, so
	# two copies of this test in one directory do not delete each other's (#1372)
	@cert : static : String;
	@key : static : String;

	function : Main(args : String[]) ~ Nil {
		@failed := 0;
		@cert := "tls-write-cert-{$(Runtime->GetProcessId())}.pem";
		@key := "tls-write-key-{$(Runtime->GetProcessId())}.pem";

		File->Delete(@cert);
		File->Delete(@key);
		config := Runtime->GetPlatform()->Has("Windows") ? "-config NUL " : "";
		command := "openssl req -x509 -newkey rsa:2048 -sha256 -nodes -days 1 {$config}-subj \"/CN=localhost\" -addext \"subjectAltName=DNS:localhost,IP:127.0.0.1\" -keyout {$@key} -out {$@cert}";
		if(Runtime->Command(command) <> 0) {
			"FAIL: openssl could not create the certificate -- is openssl on PATH?"->PrintLine();
			Runtime->Exit(1);
		};

		"stage: tls"->ErrorLine();
		CheckTls();
		"stage: dtls"->ErrorLine();
		CheckDtls();

		File->Delete(@cert);
		File->Delete(@key);

		if(@failed > 0) {
			"FAIL: {$@failed} WriteByte check(s) failed"->PrintLine();
			Runtime->Exit(1);
		};
		"PASS: TLS and DTLS WriteByte report whether the byte was written"->PrintLine();
	}

	# waits for a hang-up thread to end, and says how long that took
	function : HangUp(thread : Thread) ~ Int {
		timer := System.Time.Timer->New();
		timer->Start();
		thread->Join();
		timer->End();
		return (timer->GetElapsedTime() * 1000.0)->As(Int);
	}

	function : Check(name : String, ok : Bool) ~ Nil {
		if(ok) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
			@failed += 1;
		};
	}

	# the session is over: the server's close_notify is waiting to be read
	# ("SSL - The peer notified us that the connection is going to be closed"),
	# or, when that datagram was lost, the network refused one sent to the
	# closed port ("NET - Connection was reset by peer: Connection refused")
	function : PeerGone(reason : String) ~ Bool {
		if(reason = Nil) {
			return false;
		};
		lower := reason->ToLower();
		return lower->Has("connection is going to be closed") |
			(lower->Has("net - ") & (lower->Has("refused") | lower->Has("forcibly closed")));
	}

	function : CheckTls() ~ Nil {
		# port 0: the system picks a free one, and GetPort() says which
		port := 0;
		server := TCPSecureSocketServer->New(@cert, @key, "", 0);
		if(server->Listen()) {
			port := server->GetPort();
		};
		Check("tls: the server listens", port > 0);
		if(port = 0) {
			return;
		};
		hang_up := TlsHangUp->New(server);
		hang_up->Execute(Nil);

		socket := TCPSecureSocket->New("127.0.0.1", port, @cert);
		Check("tls: the client connects", socket->IsOpen());
		if(<>socket->IsOpen()) {
			"  reason: '{$(TCPSecureSocket->GetLastError())}'"->PrintLine();
			return;
		};

		Check("tls: a write that works answers true", socket->WriteByte('a'));
		reason := TCPSecureSocket->GetLastError();
		Check("tls: and leaves no error ('{$reason}')", reason = Nil);

		# the peer has read the byte and closed before a write is expected to fail
		"tls: the server hung up after {$(HangUp(hang_up))} ms"->PrintLine();

		written := true;
		for(i := 0; written & i < 300; i += 1;) {
			Thread->Sleep(10);
			written := socket->WriteByte('b');
		};
		Check("tls: a write after the peer hung up answers false", <>written);
		reason := TCPSecureSocket->GetLastError();
		Check("tls: and GetLastError says why ('{$reason}')", reason <> Nil & reason->Size() > 0);
		socket->Close();

		Check("tls: a closed socket's write answers false", <>socket->WriteByte('c'));
	}

	function : CheckDtls() ~ Nil {
		port := 0;
		server := DTLSSocketServer->New(@cert, @key, "", 0);
		if(server->Listen()) {
			port := server->GetPort();
		};
		Check("dtls: the server listens", port > 0);
		if(port = 0) {
			return;
		};
		hang_up := DtlsHangUp->New(server);
		hang_up->Execute(Nil);

		socket := DTLSSocket->New("127.0.0.1", port, @cert);
		Check("dtls: the client connects", socket->IsOpen());
		if(<>socket->IsOpen()) {
			"  reason: '{$(DTLSSocket->GetLastError())}'"->PrintLine();
			return;
		};

		Check("dtls: a write that works answers true", socket->WriteByte('a'));
		reason := DTLSSocket->GetLastError();
		Check("dtls: and leaves no error ('{$reason}')", reason = Nil);

		# the peer has read the byte and closed its session and port before a
		# write is expected to fail
		"dtls: the server hung up after {$(HangUp(hang_up))} ms"->PrintLine();

		# The server reads that byte, then closes its session (close_notify) and
		# its port. The next write finds the session over and fails; if the
		# close_notify was lost, a datagram to the closed port draws a refusal,
		# and the write after it fails. On Windows a DTLS write answered true for
		# ever: a send never fails there, and the refusal waits behind the
		# close_notify for a read.
		written := true;
		for(i := 0; written & i < 300; i += 1;) {
			Thread->Sleep(10);
			written := socket->WriteByte('b');
		};
		Check("dtls: a write after the server closed its port answers false", <>written);
		reason := DTLSSocket->GetLastError();
		Check("dtls: and GetLastError says the session is over ('{$reason}')", PeerGone(reason));

		sent := 0;
		buffer := "more"->ToByteArray();
		for(i := 0; sent >= 0 & i < 300; i += 1;) {
			Thread->Sleep(10);
			sent := socket->WriteBuffer(0, buffer->Size(), buffer);
		};
		Check("dtls: a buffer write after it answers -1 ({$sent})", sent < 0);
		reason := DTLSSocket->GetLastError();
		Check("dtls: and GetLastError says why ('{$reason}')", PeerGone(reason));
		socket->Close();

		Check("dtls: a closed socket's write answers false", <>socket->WriteByte('c'));
	}
}
