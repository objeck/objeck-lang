# EXTRA_LIBS: net,regex,csv,misc,query
#~
Query.Structured: expressions in WHERE and ORDER BY (docs/QUERY_DESIGN.md, "Expressions in every
clause", stage 1). Before, an expression in a condition failed to parse ('where price * qty >
100': expected a comparison, found '*') and ORDER BY took only names, positions and aggregates.
Covered, each against a hand-computed answer: comparisons between expressions on either side,
two columns, a constant on the left, a bare word that is a column or text, AND, OR, NOT and
parentheses (a grouped condition and a parenthesised expression), IN and BETWEEN with
expression operands, IS NULL, LIKE on an expression, constant tests, Int overflow, the
smallest Int, '% -1' and zero divisors as empty values, NaN; ORDER BY an expression, an alias
inside one, with DISTINCT, LIMIT and SELECT *; UPDATE and DELETE with expression conditions;
placeholders anywhere, re-bound; the plans (a reduced test reads through its index, an
expression scans); and the refusals with their exact messages.
~#
use Query.Structured, Collection;

class QueryExprWhere {
	@failures : static : Int;
	@checks : static : Int;

	function : Check(what : String, ok : Bool) ~ Nil {
		@checks += 1;
		if(<>ok) {
			@failures += 1;
			"  FAIL: {$what}"->PrintLine();
		};
	}

	# the result's cells, a row per line and '|' between cells, '-' for an empty cell
	function : Rows(rs : Table) ~ String {
		if(rs = Nil) {
			return "<nil>";
		};

		out := "";
		rows := rs->GetAll();
		names := rs->GetColumnNames();
		each(r : rows) {
			row := rows->Get(r);
			for(c := 1; c < names->Size(); c += 1;) {
				if(c > 1) {
					out += "|";
				};
				value := row->Get(c);
				if(value = Nil) {
					out += "-";
				}
				else if(value->TypeOf(IntRef)) {
					out += value->As(IntRef)->Get()->ToString();
				}
				else if(value->TypeOf(FloatRef)) {
					out += value->As(FloatRef)->Get()->ToShortString();
				}
				else if(value->TypeOf(BoolRef)) {
					out += value->As(BoolRef)->Get() ? "T" : "F";
				}
				else if(value->TypeOf(String)) {
					out += value->As(String);
				}
				else {
					out += "?";
				};
			};
			out += ";";
		};
		return out;
	}

	function : Same(what : String, t : Table, sql : String, expected : String) ~ Nil {
		got := Rows(t->Query(sql));
		if(got->Equals("<nil>")) {
			got := "<nil: {$(t->GetError())}>";
		};
		ok := got->Equals(expected);
		if(<>ok) {
			"    {$sql}"->PrintLine();
			"    got:      {$got}"->PrintLine();
			"    expected: {$expected}"->PrintLine();
		};
		Check(what, ok);
	}

	function : Refused(what : String, t : Table, sql : String, reason : String) ~ Nil {
		rs := t->Query(sql);
		error := t->GetError();
		ok := rs = Nil & error <> Nil & error->Equals(reason);
		if(<>ok) {
			shown := error <> Nil ? error : "no error";
			"    {$sql}: '{$shown}', wanted '{$reason}'"->PrintLine();
		};
		Check("refused: {$what}", ok);
	}

	function : Plan(what : String, t : Table, sql : String, expected : String) ~ Nil {
		plan := t->Explain(sql);
		ok := plan <> Nil & plan->Equals(expected);
		if(<>ok) {
			shown := plan <> Nil ? plan : "<nil: {$(t->GetError())}>";
			"    {$sql}: '{$shown}', wanted '{$expected}'"->PrintLine();
		};
		Check("plan: {$what}", ok);
	}

	function : Main(args : String[]) ~ Nil {
		wide := 9223372036854775807;
		smallest := -9223372036854775807 - 1;
		t := Table->New("t", ["id", "price", "qty", "name", "a", "b", "c", "flag"]);
		prices := [2.5, 10.0, 100.0, Float->NaN(), 0.0, 4.0, -3.0, 1.5];
		qtys := [10, 20, 2, 5, 3, 0, wide, smallest];
		names := ["apple", "pear", "fig", "kiwi", "lime", "", "b", "apple"];
		each(i : 8) {
			r := t->Insert();
			r->Set("id", IntRef->New(i + 1));
			# row 5 has no price, row 6 no qty and no name
			if(i <> 4) {
				r->Set("price", FloatRef->New(prices[i]));
			};
			if(i <> 5) {
				r->Set("qty", IntRef->New(qtys[i]));
				r->Set("name", names[i]);
			};
			r->Set("a", IntRef->New(i));
			r->Set("b", IntRef->New(2 * i));
			r->Set("c", IntRef->New(i % 3 = 0 ? 3 * i : i));
			if(i < 6) {
				r->Set("flag", BoolRef->New(i % 2 = 0));
			};
		};

		# comparisons between expressions
		Same("price * qty > 100", t, "select id from t where price * qty > 100", "2;3;");
		Same("a + b = c", t, "select id from t where a + b = c", "1;4;7;");
		Same("an expression on each side", t, "select id from t where qty * 2 = qty + qty", "1;2;3;4;5;");
		Same("two columns", t, "select id from t where b > c", "2;3;5;6;8;");
		Same("a constant on the left", t, "select id from t where 100 <= price", "3;");
		Same("a constant on the left, flipped", t, "select id from t where 3 > qty", "3;8;");
		Same("parenthesised arithmetic", t, "select id from t where (qty + 1) * 2 > 10", "1;2;4;");
		Same("a grouped condition", t, "select id from t where (qty > 5 or qty < 3) and id < 5", "1;2;3;");
		Same("a parenthesised column", t, "select id from t where (qty) = 5", "4;");
		Same("NOT before an expression test", t, "select id from t where not price * 2 > 10", "1;4;5;6;7;8;");
		Same("IS NULL of an expression", t, "select id from t where price / (qty - 10) is null", "1;5;6;8;");
		Same("IS NOT NULL of an expression", t, "select id from t where qty - a is not null", "1;2;3;4;5;7;");
		Same("BETWEEN expressions", t, "select id from t where qty between id * 2 and id * 10", "1;2;");
		Same("NOT BETWEEN", t, "select id from t where qty not between id * 2 and id * 10", "3;4;5;6;7;8;");
		Same("IN expressions", t, "select id from t where qty in (id * 10, id + 1)", "1;2;4;");
		Same("LIKE on an expression matches no number", t, "select id from t where qty + 1 like '1%'", "");
		Same("NOT LIKE on an expression matches no number", t, "select id from t where qty + 1 not like '1%'", "");
		Same("a minus number after a name subtracts", t, "select id from t where qty -1 = 4", "4;");

		# a bare word in a value position: a column when one has the name, otherwise text
		Same("a bare word that is text", t, "select id from t where name = apple", "1;8;");
		# b is an INT column, so this compares text with numbers: no row, where the text 'b' matched row 7
		Same("a bare word that is a column", t, "select id from t where name = b", "");
		Same("a quoted word is text", t, "select id from t where name = 'b'", "7;");

		# tests that read no column
		Same("a test that is never true", t, "select id from t where 1 = 0", "");
		Same("a test that is always true", t, "select count(*) from t where 2 * 3 = 6", "8;");
		Same("a NULL test", t, "select id from t where null is null and id = 1", "1;");

		# Int arithmetic that does not fit in 64 bits is empty, as is a zero divisor
		Same("overflow is empty", t, "select id, qty + 1 from t where id = 7", "7|-;");
		Same("the smallest Int negated is empty", t, "select id, -qty, qty * -1 from t where id = 8", "8|-|-;");
		Same("the smallest Int % -1 is 0", t, "select id, qty % -1 from t where id = 8", "8|0;");
		Same("an overflowed operand matches nothing", t, "select id from t where qty * 2 < 0", "");
		Same("a zero divisor is empty", t, "select id, a / qty, a % qty from t where id = 6", "6|-|-;");
		Same("NaN satisfies only <>", t, "select id from t where price + 0 <> price + 0", "4;");

		# ORDER BY an expression
		Same("ORDER BY an expression", t, "select id from t where qty < 1000 order by qty * -1", "2;1;4;5;3;8;");
		Same("ORDER BY an expression, descending", t, "select id from t where id < 7 order by price * qty desc", "4;2;3;1;5;6;");
		Same("ORDER BY an alias inside an expression", t, "select id, b * 10 as tens from t where id < 4 order by tens * -1", "3|40;2|20;1|0;");
		Same("ORDER BY an expression with SELECT *", t, "select id from t where id < 4 order by 0 - a", "3;2;1;");
		Same("ORDER BY an expression and a column", t, "select id from t where id < 7 order by a % 2, id desc", "5;3;1;6;4;2;");
		Same("ORDER BY an expression, DISTINCT and LIMIT", t, "select distinct a % 3 as m from t order by m * -1 limit 2", "2;1;");
		Same("ORDER BY a position still", t, "select id, a from t where id < 3 order by 1 desc", "2|1;1|0;");
		Same("ORDER BY an expression, SELECT *", t, "select * from t order by a * -1 limit 1", "8|1.5|-9223372036854775808|apple|7|14|7|-;");
		Check("SELECT * leaves out ORDER BY's computed column", t->Query("select * from t order by a * -1 limit 1")->GetColumnNames()->Size() = 9);

		# placeholders anywhere, re-bound
		s := t->Prepare("select id from t where price > ? * 2 and qty + ? > 4 order by qty * ?");
		s->Bind(1, 2.0);
		s->Bind(2, 1);
		s->Bind(3, -1);
		first := Rows(s->Execute());
		s->Bind(1, 1.0);
		s->Bind(3, 1);
		second := Rows(s->Execute());
		Check("a prepared statement, run twice", first->Equals("2;") & second->Equals("1;2;"));
		if(<>(first->Equals("2;") & second->Equals("1;2;"))) {
			"    {$first} / {$second}"->PrintLine();
		};
		s := t->Prepare("select id from t where qty + ? > 4");
		s->Bind(1, "x");
		Check("a non-number in arithmetic is empty", Rows(s->Execute())->Equals(""));
		s := t->Prepare("select id from t where qty * 2 > ?");
		Check("an unbound placeholder is refused", s->Execute() = Nil & s->GetError()->Equals("no value bound for placeholder 1"));

		# UPDATE and DELETE with expression conditions
		u := Table->New("u", ["n", "m"]);
		each(i : 6) {
			r := u->Insert();
			r->Set("n", IntRef->New(i));
			r->Set("m", IntRef->New(10 - i));
		};
		Check("UPDATE with an expression", u->Execute("update u set m = 0 where n * 2 > m") = 2);
		Check("DELETE with an expression", u->Execute("delete from u where n + m < 5") = 1);
		Same("after UPDATE and DELETE", u, "select n, m from u order by n", "0|10;1|9;2|8;3|7;5|0;");

		# reduced tests read through indexes; expression tests scan
		t->CreateIndex("price", IndexKind->SORTED);
		t->CreateIndex("qty", IndexKind->HASH);
		Plan("a constant on the left", t, "select * from t where 100 < price", "where t: SORTED index t_price on price (>)");
		Plan("a folded constant", t, "select * from t where qty = 2 * 5", "where t: HASH index t_qty on qty (=)");
		Plan("an expression", t, "select * from t where price * qty > 100", "where t: scan");
		Plan("an expression beside an indexed test", t, "select * from t where price > 50 and price * qty > 100", "where t: SORTED index t_price on price (>)");
		Same("an expression beside an indexed test", t, "select id from t where price > 50 and price * qty > 100", "3;");
		p := t->Prepare("select * from t where price > ? * 2");
		p->Bind(1, 20);
		Check("a placeholder in a reduced test reads the index", p->Explain()->Equals("where t: SORTED index t_price on price (>)"));
		Check("and gives its rows", Rows(p->Execute())->Equals("3|100.0|2|fig|2|4|2|T;"));

		# refusals
		Refused("an unknown column", t, "select id from t where zz + 1 > 0", "unknown column 'zz'");
		Refused("an aggregate in WHERE", t, "select id from t where qty + sum(a) > 1", "syntax error at position 29: expected a column name (aggregates belong in HAVING, not WHERE), found 'sum'");
		Refused("an unknown column in ORDER BY", t, "select id from t order by zz + 1", "unknown column 'zz' in ORDER BY 'zz + 1'");
		Refused("a chained comparison", t, "select id from t where a < b < c", "syntax error at position 29: expected the end of the statement, found '<'");
		# grouped queries take expressions too (query_expr_grouped)
		Same("ORDER BY an expression in a grouped query", t, "select a, count(*) from t group by a order by 0 - a limit 3", "7|1;6|1;5|1;");
		Same("an expression in HAVING", t, "select a, count(*) from t group by a having count(*) + a > 6", "6|1;7|1;");
		Refused("an unclosed parenthesis", t, "select id from t where (a + 1 > 2", "syntax error at position 33: expected ')', found the end of the statement");

		if(@failures = 0) {
			"PASS: query_expr_where ({$@checks} checks)"->PrintLine();
		}
		else {
			"FAIL: query_expr_where: {$@failures} of {$@checks} checks failed"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
