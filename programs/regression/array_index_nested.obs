#~
An array index that is itself a subscript. Every index was analyzed twice by the compiler, so
'a[a[a[...]]]' took twice as long for each level of nesting: 20 levels 1.7 s, 30 about half an
hour, and a program with 40 never finished compiling. The 40 levels below compile at once, and
every check compares against the value the subscripts must select.
~#
class ArrayIndexNested {
  @failures : static : Int;
  @calls : static : Int;

  function : Check(name : String, got : Int, expected : Int) ~ Nil {
    if(got = expected) {
      "  [PASS] {$name}"->PrintLine();
    }
    else {
      "  [FAIL] {$name}: got {$got}, expected {$expected}"->PrintLine();
      @failures += 1;
    };
  }

  function : Next() ~ Int {
    @calls += 1;
    return @calls;
  }

  function : Main(args : String[]) ~ Nil {
    # a permutation: a[i] is the next index in a cycle of 5
    a := [1, 2, 3, 4, 0];
    Check("one level", a[0], 1);
    Check("two levels", a[a[0]], 2);
    Check("five levels come back to the start", a[a[a[a[a[0]]]]], 0);
    Check("forty levels", a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[0]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]], 0);
    Check("forty-two levels", a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[a[0]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]]], 2);

    # nested subscripts as an assignment target and with arithmetic between the levels
    b := [0, 0, 0, 0, 0];
    b[a[a[1]]] := 7;
    Check("as an assignment target", b[3], 7);
    Check("arithmetic between levels", a[a[a[0] + 1] - 1], 3);
    b[a[0]] += a[a[a[0]]];
    Check("with an operation assignment", b[1], 3);

    # two dimensions, each index a subscript
    m := Int->New[2, 3];
    m[a[4], a[0]] := 5;
    m[a[0], a[a[0]]] := 9;
    Check("two dimensions, read", m[0, 1] + m[1, 2], 14);
    Check("two dimensions, nested read", m[a[4], a[a[4]]], 5);

    # an index with a side effect is still evaluated once
    @calls := 0;
    c := [10, 20, 30, 40, 50];
    Check("a call as an index", c[Next()], 20);
    Check("a call inside a nested index", c[a[Next()]], 40);
    Check("the calls were made once each", @calls, 2);

    # other things an index can be
    text := "abc";
    i := 1;
    Check("a method call as an index", c[text->Size()], 40);
    Check("an interpolated string's size as an index", c["{$i}{$i}"->Size()], 30);
    Check("a conditional as an index", c[(i > 0 ? 4 : 0)], 50);
    Check("a Char as an index", c['\u0002'], 30);

    if(@failures > 0) {
      "FAIL: {$@failures} check(s) failed"->PrintLine();
      Runtime->Exit(1);
    };
    "PASS"->PrintLine();
  }
}
