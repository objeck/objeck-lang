# EXTRA_LIBS: ml,gen_collect,csv
#~
System.ML EllipticEnvelope's MCD search against an independent reference, on 30
contaminated near-Gaussian datasets of 200 rows x 3 features (180 inliers, 20
uniform outliers in [-8, 8]^3; the n <= 500 search). The reference is a numpy MCD
run from 300 random h-subsets and 300 random (p+1)-subsets, each to convergence.

FastMCD is a heuristic and Gaussian data has many near-tie h-subsets, so: within
0.005 of the reference optimum's log-determinant on every dataset and exactly on it
on at least 24; the reweighted location (0.05) and covariance (0.10) on every
dataset; the same rows flagged at contamination 0.1 on at least 28, never more than
2 rows apart. Data is built by both sides from System.ML.Random with arithmetic
only. Regenerate with ml_outlier_ref/gen_fixtures.py. The larger-n search paths are
in ml_outlier_envelope.obs.
~#
use System.ML;

class MlOutlierMcd {
	function : Main(args : String[]) ~ Nil {
		if(Mcd()) {
			"PASS: ml_outlier_mcd"->PrintLine();
		}
		else {
			"FAIL: ml_outlier_mcd"->PrintLine();
			Runtime->Exit(1);
		};
	}

	function : Mcd() ~ Bool {
		seeds := CaseSeeds();
		inliers := CaseInliers();
		outliers := CaseOutliers();
		features := CaseFeatures();
		logdets := RawLogDets();
		raw_loc := RawLocations();
		fin_loc := FinalLocations();
		fin_cov := FinalCovariances();
		counts := FlaggedCounts();
		flagged := FlaggedRows();

		loc_at := 0;
		cov_at := 0;
		flag_at := 0;
		optimal := 0;
		near_optimal := 0;
		final_close := 0;
		same_flags := 0;
		close_flags := 0;
		total := seeds->Size();
		each(c : seeds) {
			p := features[c];
			X := MakeData(seeds[c], inliers[c], outliers[c], p, 8.0);
			envelope := EllipticEnvelope->New(0.1, 0.0, 42);
			if(envelope->Fit(X)) {
				# FastMCD is a search heuristic and on Gaussian data many h-subsets are
				# near-ties, so it is held to within 0.005 of the many-start optimum's
				# log-determinant everywhere, and to the optimum itself on most of the
				# small datasets (sklearn's 30 random h-subsets reach it far less often)
				gap := LogDet(envelope->GetRawCovariance(), p) - logdets[c];
				if(gap <= 0.005) {
					near_optimal += 1;
				}
				else {
					"  seed {$seeds[c]}: log-determinant {$gap} above the reference"->PrintLine();
				};
				if(gap->Abs() <= 1.0e-9 & Matches(envelope->GetRawLocation(), raw_loc, loc_at, p, 1.0e-6)) {
					if(inliers[c] + outliers[c] <= 500) {
						optimal += 1;
					};
				}
				else {
					"  seed {$seeds[c]}: a near-tie optimum, log-determinant {$gap} from the reference"->PrintLine();
				};

				# the reweighted estimate, which is what scores rows
				if(Matches(envelope->GetLocation(), fin_loc, loc_at, p, 0.05) &
						Matches2(envelope->GetCovariance(), fin_cov, cov_at, p, 0.10)) {
					final_close += 1;
				}
				else {
					"  seed {$seeds[c]}: reweighted estimate differs from the reference"->PrintLine();
				};

				# the flagged rows at contamination 0.1
				labels := envelope->Predict(X);
				expected := Bool->New[labels->Size()];
				each(k : counts[c]) {
					expected[flagged[flag_at + k]] := true;
				};
				differ := 0;
				each(i : labels) {
					if(labels[i] <> expected[i]) {
						differ += 1;
					};
				};
				if(differ = 0) {
					same_flags += 1;
				}
				else {
					"  seed {$seeds[c]}: {$differ} rows flagged differently"->PrintLine();
				};
				if(differ <= 2) {
					close_flags += 1;
				};
			}
			else {
				"  seed {$seeds[c]}: fit failed"->PrintLine();
			};

			loc_at += p;
			cov_at += p * p;
			flag_at += counts[c];
		};

		passed := Report("the MCD search reaches within 0.005 of the optimum's log-determinant on {$near_optimal} of {$total}", near_optimal = total);
		passed := Report("and lands exactly on it on {$optimal} of {$total} (at least 24)", optimal >= 24) & passed;
		passed := Report("reweighted location (0.05) and covariance (0.10) agree on {$final_close} of {$total}", final_close = total) & passed;
		passed := Report("the same rows are flagged on {$same_flags} of {$total} (at least 28)", same_flags >= 28) & passed;
		passed := Report("never more than 2 rows differ ({$close_flags} of {$total})", close_flags = total) & passed;
		return passed;
	}
	# log-determinant by Gaussian elimination with partial pivoting
	function : LogDet(m : Float[,], p : Int) ~ Float {
		a := Float->New[p, p];
		each(i : p) {
			each(j : p) {
				a[i, j] := m[i, j];
			};
		};
		total := 0.0;
		each(c : p) {
			pivot := c;
			for(r := c + 1; r < p; r += 1;) {
				if(a[r, c]->Abs() > a[pivot, c]->Abs()) {
					pivot := r;
				};
			};
			if(pivot <> c) {
				each(j : p) {
					tmp := a[c, j];
					a[c, j] := a[pivot, j];
					a[pivot, j] := tmp;
				};
			};
			total += Float->Log(a[c, c]->Abs());
			for(r := c + 1; r < p; r += 1;) {
				f := a[r, c] / a[c, c];
				for(j := c; j < p; j += 1;) {
					a[r, j] -= f * a[c, j];
				};
			};
		};
		return total;
	}
	function : Matches(got : Float[], expected : Float[], at : Int, p : Int, tol : Float) ~ Bool {
		each(j : p) {
			if(<>Near(got[j], expected[at + j], tol)) {
				return false;
			};
		};
		return true;
	}
	function : Matches2(got : Float[,], expected : Float[], at : Int, p : Int, tol : Float) ~ Bool {
		each(a : p) {
			each(b : p) {
				if(<>Near(got[a, b], expected[at + a * p + b], tol)) {
					return false;
				};
			};
		};
		return true;
	}
	function : Gauss(rng : System.ML.Random) ~ Float {
		acc := 0.0;
		each(k : 12) {
			acc += rng->NextReal();
		};
		return acc - 6.0;
	}
	function : MakeData(seed : Int, n_in : Int, n_out : Int, p : Int, spread : Float) ~ Float[,] {
		rng := System.ML.Random->New(seed);
		X := Float->New[n_in + n_out, p];
		z := Float->New[p];
		each(i : n_in) {
			each(j : p) {
				z[j] := Gauss(rng);
			};
			each(j : p) {
				v := z[j];
				if(j > 0) {
					v := v + 0.5 * z[j - 1];
				};
				X[i, j] := v;
			};
		};
		for(i := n_in; i < n_in + n_out; i += 1;) {
			each(j : p) {
				X[i, j] := rng->NextReal() * (2.0 * spread) - spread;
			};
		};
		return X;
	}
	function : Near(a : Float, b : Float, tol : Float) ~ Bool {
		scale := b->Abs();
		if(scale < 1.0) {
			scale := 1.0;
		};
		return (a - b)->Abs() <= tol * scale;
	}
	function : Report(name : String, passed : Bool) ~ Bool {
		if(passed) {
			"  ok: {$name}"->PrintLine();
		}
		else {
			"  FAIL: {$name}"->PrintLine();
		};
		return passed;
	}
	# BEGIN GENERATED FIXTURE
	# by ml_outlier_ref/gen_fixtures.py; do not edit by hand
	function : CaseSeeds() ~ Int[] {
		return [
			101, 102, 103, 104, 105, 106, 107, 108, 109, 110, 111, 112, 113, 114, 115, 116,
			117, 118, 119, 120, 121, 122, 123, 124, 125, 126, 127, 128, 129, 130];
	}

	function : CaseInliers() ~ Int[] {
		return [
			180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180,
			180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180, 180];
	}

	function : CaseOutliers() ~ Int[] {
		return [
			20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20,
			20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20, 20];
	}

	function : CaseFeatures() ~ Int[] {
		return [
			3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3,
			3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3, 3];
	}

