#~
# Rosetta Code: Exceptions/Catch an exception thrown in a nested call
# https://rosettacode.org/wiki/Exceptions/Catch_an_exception_thrown_in_a_nested_call
# Claimed in #1124
#
# foo calls bar twice, bar calls baz, and baz raises U0 on its first call and U1
# on its second; foo must catch U0 only. U0 and U1 are exception types of their
# own (subclasses of System.Error); baz throws them with Runtime->Raise, and
# foo's try catches U0 with 'on(e : U0)'. U1 is not named there, so it goes on
# out of foo.
#
# What happens when it runs: U0 is caught in foo and foo continues to its second
# call; U1 escapes foo. Unguarded, that ends the program with "Unhandled U1: ..."
# and exit status 1, as the task describes. Here Main catches it instead, so the
# escape is observed rather than fatal.
#
# This used to need a note in a shared array and two different runtime errors
# raised on purpose to tell U0 from U1 (#1247).
~#

class U0 from Error {
	New(message : String) {
		Parent(message);
	}
}

class U1 from Error {
	New(message : String) {
		Parent(message);
	}
}

class Nested {
	@baz_calls : Int;
	@caught : Int;
	@completed : Int;

	New() {
		@baz_calls := 0;
		@caught := 0;
		@completed := 0;
	}

	# raises U0 on the first call, U1 on the second
	method : public : Baz(call : Int) ~ Nil {
		@baz_calls += 1;
		if(call = 0) {
			Runtime->Raise(U0->New("baz, call 1"));
		};
		Runtime->Raise(U1->New("baz, call 2"));
	}

	method : public : Bar(call : Int) ~ Nil {
		Baz(call);
	}

	# catches U0 only
	method : public : Foo() ~ Nil {
		for(call := 0; call < 2; call += 1;) {
			try {
				Bar(call);
			}
			on(e : U0) {
				@caught += 1;
			};
			# reached only after a handled U0, on the first call
			@completed := call + 1;
		};
	}

	method : public : GetBazCalls() ~ Int {
		return @baz_calls;
	}

	method : public : GetCaught() ~ Int {
		return @caught;
	}

	method : public : GetCompleted() ~ Int {
		return @completed;
	}
}

class RosettaExceptionsCatchAnExceptionThrownInANestedCall {
	@failures : Int;

	function : Main(args : String[]) ~ Nil {
		RosettaExceptionsCatchAnExceptionThrownInANestedCall->New()->Run();
	}

	New() {
		@failures := 0;
	}

	method : CheckTrue(what : String, ok : Bool) ~ Nil {
		if(ok) {
			"PASS: {$what}"->PrintLine();
		}
		else {
			"FAIL: {$what}"->PrintLine();
			@failures += 1;
		};
	}

	method : Run() ~ Nil {
		n := Nested->New();
		escaped := "";
		try {
			n->Foo();
		}
		on(e : U1) {
			escaped := e->GetMessage();
		};

		CheckTrue("U1 escapes foo", escaped->Equals("baz, call 2"));
		CheckTrue("foo caught exactly one exception, U0", n->GetCaught() = 1);
		CheckTrue("baz was called twice", n->GetBazCalls() = 2);
		CheckTrue("foo carried on after U0 to make its second call", n->GetCompleted() = 1);

		# a second, independent run behaves the same way
		again := Nested->New();
		escaped_again := false;
		try {
			again->Foo();
		}
		on(e : U1) {
			escaped_again := true;
		};
		CheckTrue("a second run also lets U1 escape", escaped_again & again->GetCaught() = 1);

		if(@failures > 0) {
			"{$@failures} failure(s)"->PrintLine();
			Runtime->Exit(1);
		};
	}
}
