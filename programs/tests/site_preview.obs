use System.IO.Net, System.IO.Filesystem, Collection, Web.HTTP.Server;

#~
# A stopgap static-file server for previewing a folder of pages locally, such as docs/.
# It is not the hosting solution: no caching, no ETag, no compression, no TLS. The server
# library has already refused anything that climbs out of the root (".." in any spelling,
# encoded separators, NUL) before a request gets here, and Range requests are answered
# by the library, so a video seeks.
#
#   obc -src site_preview.obs -lib net,net_server,json,cipher -dest site_preview.obe
#   obr site_preview.obe docs 8100          # then browse http://127.0.0.1:8100
~#
class SiteHandler from HttpRequestHandler {
	New() { Parent(); }

	method : ProcessGet(request : Request, response : Response) ~ Bool {
		SitePreview->Serve(request->GetPath(), response);
		return false;
	}

	method : ProcessPost(request : Request, response : Response) ~ Bool {
		response->SetCodeContent(405, "Method Not Allowed");
		return false;
	}
}

# The same site over TLS: obr site_preview.obe docs 8443 cert.pem key.pem key_password
class SiteSecureHandler from HttpsRequestHandler {
	New() { Parent(); }

	method : ProcessGet(request : Request, response : Response) ~ Bool {
		SitePreview->Serve(request->GetPath(), response);
		return false;
	}

	method : ProcessPost(request : Request, response : Response) ~ Bool {
		response->SetCodeContent(405, "Method Not Allowed");
		return false;
	}
}

class SitePreview {
	@root : static : String;
	@types : static : Map<String, String>;

	function : Types() ~ Map<String, String> {
		if(@types = Nil) {
			@types := Map->New()<String, String>;
			@types->Insert(".html", "text/html; charset=utf-8");
			@types->Insert(".htm", "text/html; charset=utf-8");
			@types->Insert(".css", "text/css; charset=utf-8");
			@types->Insert(".js", "text/javascript; charset=utf-8");
			@types->Insert(".json", "application/json");
			@types->Insert(".txt", "text/plain; charset=utf-8");
			@types->Insert(".md", "text/plain; charset=utf-8");
			@types->Insert(".xml", "application/xml");
			@types->Insert(".svg", "image/svg+xml");
			@types->Insert(".png", "image/png");
			@types->Insert(".jpg", "image/jpeg");
			@types->Insert(".jpeg", "image/jpeg");
			@types->Insert(".gif", "image/gif");
			@types->Insert(".ico", "image/x-icon");
			@types->Insert(".icns", "image/icns");
			@types->Insert(".mp4", "video/mp4");
			@types->Insert(".webm", "video/webm");
			@types->Insert(".zip", "application/zip");
			@types->Insert(".pdf", "application/pdf");
			@types->Insert(".woff2", "font/woff2");
		};

		return @types;
	}

	function : ContentType(path : String) ~ String {
		dot := path->FindLast('.');
		if(dot > -1) {
			extension := path->SubString(dot, path->Size() - dot);
			if(extension <> Nil) {
				type := Types()->Find(extension->ToLower());
				if(type <> Nil) {
					return type;
				};
			};
		};

		return "application/octet-stream";
	}

	function : Serve(path : String, response : Response) ~ Nil {
		target := path;
		if(target->EndsWith('/')) {
			target += "index.html";
		};

		file := "{$@root}{$target}";
		if(Directory->Exists(file)) {
			file += "/index.html";
		};

		if(<>File->Exists(file)) {
			response->SetCodeTypeContent(404, "text/plain", "Not found");
			return;
		};

		bytes := FileReader->ReadBinaryFile(file);
		if(bytes = Nil) {
			response->SetCodeTypeContent(404, "text/plain", "Not found");
			return;
		};

		response->SetCodeTypeContent(200, ContentType(file), bytes);
	}

	function : Main(args : String[]) ~ Nil {
		@root := "docs";
		port := 8100;
		if(args->Size() > 0) {
			@root := args[0];
		};
		if(args->Size() > 1) {
			port := args[1]->ToInt();
		};
		while(@root->Size() > 1 & @root->EndsWith('/')) {
			@root := @root->SubString(@root->Size() - 1);
		};

		if(args->Size() > 4) {
			"Serving '{$@root}' on https://0.0.0.0:{$port}"->PrintLine();
			WebServer->ServeSecure(SiteSecureHandler->New()->GetClass(), port, args[2], args[3], args[4]);
		}
		else {
			"Serving '{$@root}' on http://127.0.0.1:{$port}"->PrintLine();
			WebServer->Serve(SiteHandler->New()->GetClass(), port, false);
		};
	}
}
