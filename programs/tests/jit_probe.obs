#~
# JIT code-generation probe: six kernels, each one hot loop, timed once with
# the JIT off and once with it on. The numbers live in
# docs/JIT_CODEGEN_ASSESSMENT_2026_09.md.
#
# Do NOT declare these kernels `native`. `native` forces compilation through a
# path that neither `--jit=off` nor OBJECK_JIT_DISABLE=1 reaches (those switch
# off AUTO-JIT only), so a `native` kernel timed "interpreted" is a second JIT
# run. That is how this file, as first committed, reported IntLoop at 1.2x on
# ARM64: 0.0209s against 0.0177s, both compiled. With plain functions the same
# kernel measures 0.5595s against 0.0183s, 30.6x (assessment section 5b).
#
#   obc -src jit_probe.obs -dest jit_probe.obe
#   obr --jit=off jit_probe.obe      # the interpreter
#   obr jit_probe.obe                # the JIT: a once-called method with a loop
#                                    # is compiled on its first call
~#

use System.Time;

class Probe {
  function : IntLoop(n : Int) ~ Int {
    sum := 0;
    for(i := 0; i < n; i += 1;) {
      sum := sum + (i * 7) % 13 - (i / 3);
    };
    return sum;
  }

  function : ArraySum(a : Int[], reps : Int) ~ Int {
    total := 0;
    for(r := 0; r < reps; r += 1;) {
      for(i := 0; i < a->Size(); i += 1;) {
        total += a[i];
      };
    };
    return total;
  }

  function : FloatDot(a : Float[], b : Float[], reps : Int) ~ Float {
    acc := 0.0;
    for(r := 0; r < reps; r += 1;) {
      for(i := 0; i < a->Size(); i += 1;) {
        acc += a[i] * b[i];
      };
    };
    return acc;
  }

  function : Small(x : Int, y : Int) ~ Int {
    return x * 3 + y;
  }

  function : CallLoop(n : Int) ~ Int {
    acc := 0;
    for(i := 0; i < n; i += 1;) {
      acc := Small(acc, i) and 0xFFFFF;
    };
    return acc;
  }

  function : Branchy(n : Int) ~ Int {
    hits := 0;
    for(i := 0; i < n; i += 1;) {
      if(i % 3 = 0 & i % 5 <> 0) { hits += 2; }
      else if(i % 7 = 0) { hits += 1; }
      else if(i > n / 2) { hits -= 1; };
    };
    return hits;
  }

  function : Locals(n : Int) ~ Int {
    a := 1; b := 2; c := 3; d := 4; e := 5; f := 6; g := 7; h := 8;
    for(i := 0; i < n; i += 1;) {
      a := b + c; b := c + d; c := d + e; d := e + f; e := f + g; f := g + h; g := h + a; h := (a + i) and 0xFFFF;
    };
    return a + b + c + d + e + f + g + h;
  }

  function : Main(args : String[]) ~ Nil {
    n := 20000000;
    ints := Int->New[1000]; fa := Float->New[1000]; fb := Float->New[1000];
    for(i := 0; i < 1000; i += 1;) { ints[i] := i; fa[i] := i * 0.5; fb[i] := 1000.0 - i; };

    t := Timer->New(true); r1 := IntLoop(n); t->End(); "IntLoop    {$r1}  {$t->GetElapsedTime()}s"->PrintLine();
    t := Timer->New(true); r2 := ArraySum(ints, n / 1000); t->End(); "ArraySum   {$r2}  {$t->GetElapsedTime()}s"->PrintLine();
    t := Timer->New(true); r3 := FloatDot(fa, fb, n / 1000); t->End(); "FloatDot   {$r3}  {$t->GetElapsedTime()}s"->PrintLine();
    t := Timer->New(true); r4 := CallLoop(n); t->End(); "CallLoop   {$r4}  {$t->GetElapsedTime()}s"->PrintLine();
    t := Timer->New(true); r5 := Branchy(n); t->End(); "Branchy    {$r5}  {$t->GetElapsedTime()}s"->PrintLine();
    t := Timer->New(true); r6 := Locals(n); t->End(); "Locals     {$r6}  {$t->GetElapsedTime()}s"->PrintLine();
  }
}
