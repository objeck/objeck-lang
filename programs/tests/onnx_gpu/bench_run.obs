#~
Times an ONNX model per run, in several ways, and prints one machine-readable
line per way.

  bench_run.obe <model.onnx> <ep> <batch> <iters> <modes> [key=value ...]

  modes (comma separated):
    run             Session->Run(Vector<Tensor>): the normal path. Inputs are
                    converted and copied to the device, outputs copied back and
                    split into Tensors, on every call.
    run_raw         Session->RunTensors: the same without splitting the outputs.
    bound_copy      IO binding, but the host data still travels every iteration:
                    Upload every input, Run, Download every output into buffers
                    allocated once. The like-for-like comparison with `run`.
    bound_resident  IO binding with the data resident on the device: Run only.
                    Preallocated outputs. What a pipeline whose input is produced
                    on the GPU and whose output is consumed there pays.
    bound_dynout    As bound_resident, but ONNX Runtime allocates every output.

  Each key=value after the modes goes to the session's config map, e.g.
  device_id=0 or cudnn_conv_algo_search=HEURISTIC; ep is passed as given.

Output, one line per mode:

  RESULT|model|batch|ep|mode|iters|median_ms|p95_ms|min_ms|per_second

per_second is batch / median. The first `warmup` runs (10) are not timed. Dynamic
dimensions are filled in with the batch size (the first one) and 128 (the rest).
The input is a deterministic ramp, so every provider sees the same numbers.

The CHECK line compares the first output of `run` with the first output of
`bound_copy` and reports the largest absolute difference: for one provider it
must be exactly 0.
~#

use API.Onnx;
use API.Models;
use Collection;
use System.Time;

class BenchRun {
	@session : Session;
	@info : ModelInfo;
	@batch : Int;
	@iters : Int;
	@warmup : Int;
	@model : String;
	@ep : String;
	@copied : Float[];

	function : Main(args : String[]) ~ Nil {
		if(args->Size() < 5) {
			"usage: bench_run.obe <model.onnx> <ep> <batch> <iters> <modes> [key=value ...]"->ErrorLine();
			Runtime->Exit(2);
		};

		config := Map->New()<String, String>;
		config->Insert("ep", args[1]);
		for(i := 5; i < args->Size(); i += 1;) {
			pair := args[i];
			eq := pair->Find("=");
			if(eq > 0) {
				config->Insert(pair->SubString(eq), pair->SubString(eq + 1, pair->Size() - eq - 1));
			};
		};

		bench := BenchRun->New(args[0], args[1], args[2]->ToInt(), args[3]->ToInt(), config);
		bench->Go(args[4]);
	}

	New(model : String, ep : String, batch : Int, iters : Int, config : Map<String, String>) {
		@model := model;
		@ep := ep;
		@batch := batch;
		@iters := iters;
		@warmup := 10;
		@session := Session->New(model, config);
		if(<>@session->IsOpen()) {
			"the session did not open"->ErrorLine();
			Runtime->Exit(3);
		};
		@info := @session->GetModelInfo();
	}

	method : Go(modes : String) ~ Nil {
		mode_list := modes->Split(",");
		for(m := 0; m < mode_list->Size(); m += 1;) {
			mode := mode_list[m];
			times : Float[];
			if(mode->Equals("run")) {
				times := TimeRun(false);
			}
			else if(mode->Equals("run_raw")) {
				times := TimeRun(true);
			}
			else if(mode->Equals("bound_copy")) {
				times := TimeBound(true, false);
			}
			else if(mode->Equals("bound_resident")) {
				times := TimeBound(false, false);
			}
			else if(mode->Equals("bound_dynout")) {
				times := TimeBound(false, true);
			}
			else {
				">>> unknown mode '{$mode}' <<<"->ErrorLine();
				Runtime->Exit(2);
			};

			Report(mode, times);
		};

		if(modes->Find("run") >= 0 & modes->Find("bound_copy") >= 0) {
			Check();
		};
		@session->Close();
	}

	method : Report(mode : String, times : Float[]) ~ Nil {
		n := times->Size();
		sorted := Float->Sort(times);
		median := sorted[n / 2];
		p95_at := ((n - 1)->ToFloat() * 0.95 + 0.5)->ToInt();
		p95 := sorted[p95_at];
		fastest := sorted[0];
		rate := @batch->ToFloat() * 1000.0 / median;
		"RESULT|{$@model}|{$@batch}|{$@ep}|{$mode}|{$n}|{$median}|{$p95}|{$fastest}|{$rate}"->PrintLine();
	}

	# ---- inputs and outputs ------------------------------------------------

	method : Resolve(spec : TensorSpec) ~ Int[] {
		declared := spec->GetShape();
		shape := Int->New[declared->Size()];
		first := true;
		for(i := 0; i < declared->Size(); i += 1;) {
			shape[i] := declared[i];
			if(declared[i] < 0) {
				if(first) {
					shape[i] := @batch;
					first := false;
				}
				else {
					shape[i] := 128;
				};
			};
		};

		return shape;
	}

	method : Count(shape : Int[]) ~ Int {
		count := 1;
		for(i := 0; i < shape->Size(); i += 1;) {
			count *= shape[i];
		};

		return count;
	}

	method : MakeValues(spec : TensorSpec, count : Int) ~ Float[] {
		type := spec->GetDatatype();
		integer := type->StartsWith("INT") | type->StartsWith("UINT") | type->StartsWith("BOOL");
		values := Float->New[count];
		for(i := 0; i < count; i += 1;) {
			if(integer) {
				values[i] := ((i * 31) % 97)->ToFloat();
			}
			else {
				values[i] := ((i * 7919) % 1000)->ToFloat() / 1000.0;
			};
		};

		return values;
	}

	method : MakeInputs() ~ Vector<Tensor> {
		inputs := Vector->New()<Tensor>;
		specs := @info->GetInputs();
		each(spec in specs) {
			shape := Resolve(spec);
			values := MakeValues(spec, Count(shape));
			inputs->AddBack(Tensor->New(spec->GetName(), spec->GetDatatype(), shape, values));
		};

		return inputs;
	}

	# ---- modes -------------------------------------------------------------

	method : TimeRun(raw : Bool) ~ Float[] {
		inputs := MakeInputs();
		names := String->New[0];
		times := Float->New[@iters];
		timer := Timer->New();

		for(i := 0; i < @warmup + @iters; i += 1;) {
			timer->Start();
			if(raw) {
				result := @session->RunTensors(inputs, names);
			}
			else {
				result := @session->Run(inputs);
			};
			timer->End();

			if(i >= @warmup) {
				times[i - @warmup] := timer->GetElapsedTime() * 1000.0;
			};
		};

		return times;
	}

	method : TimeBound(copy : Bool, dynamic_outputs : Bool) ~ Float[] {
		bound := BoundSession->New(@session);
		if(<>bound->IsOpen()) {
			"the IO binding did not open"->ErrorLine();
			Runtime->Exit(3);
		};

		in_specs := @info->GetInputs();
		out_specs := @info->GetOutputs();
		in_tensors := Vector->New()<DeviceTensor>;
		in_values := Vector->New()<Buf>;
		out_tensors := Vector->New()<DeviceTensor>;
		out_hosts := Vector->New()<Buf>;

		each(spec in in_specs) {
			shape := Resolve(spec);
			tensor := DeviceTensor->ForInput(@session, spec->GetName(), shape);
			values := MakeValues(spec, Count(shape));
			tensor->Upload(values);
			bound->BindInput(spec->GetName(), tensor);
			in_tensors->AddBack(tensor);
			in_values->AddBack(Buf->New(values));
		};

		each(spec in out_specs) {
			shape := Resolve(spec);
			if(dynamic_outputs) {
				bound->BindOutputToDevice(spec->GetName());
			}
			else {
				tensor := DeviceTensor->ForOutput(@session, spec->GetName(), shape);
				bound->BindOutput(spec->GetName(), tensor);
				out_tensors->AddBack(tensor);
				out_hosts->AddBack(Buf->New(Float->New[Count(shape)]));
			};
		};

		times := Float->New[@iters];
		timer := Timer->New();
		for(i := 0; i < @warmup + @iters; i += 1;) {
			timer->Start();
			if(copy) {
				for(k := 0; k < in_tensors->Size(); k += 1;) {
					in_tensors->Get(k)->Upload(in_values->Get(k)->Get());
				};
			};

			if(<>bound->Run()) {
				"run failed"->ErrorLine();
				Runtime->Exit(4);
			};

			if(copy) {
				for(k := 0; k < out_tensors->Size(); k += 1;) {
					out_tensors->Get(k)->Download(out_hosts->Get(k)->Get());
				};
			};
			timer->End();

			if(i >= @warmup) {
				times[i - @warmup] := timer->GetElapsedTime() * 1000.0;
			};
		};

		if(copy & out_hosts->Size() > 0) {
			@copied := out_hosts->Get(0)->Get();
		};

		bound->Close();
		each(t in in_tensors) { t->Close(); };
		each(t in out_tensors) { t->Close(); };
		return times;
	}


	# the first output of Run against the first output of the bound run
	method : Check() ~ Nil {
		inputs := MakeInputs();
		outputs := @session->Run(inputs);
		if(outputs = Nil | @copied = Nil) {
			"CHECK|skipped"->PrintLine();
			return;
		};

		reference := outputs->Get(0)->GetFloats();
		if(reference->Size() <> @copied->Size()) {
			"CHECK|size mismatch"->PrintLine();
			return;
		};

		worst := 0.0;
		for(i := 0; i < reference->Size(); i += 1;) {
			d := (reference[i] - @copied[i])->Abs();
			if(d > worst) {
				worst := d;
			};
		};

		"CHECK|max_abs_diff_run_vs_bound|{$worst}"->PrintLine();
	}
}

# a Float[] cannot be a generic argument, so vectors of arrays hold these
class Buf {
	@values : Float[];

	New(values : Float[]) {
		@values := values;
	}

	method : public : Get() ~ Float[] {
		return @values;
	}
}
