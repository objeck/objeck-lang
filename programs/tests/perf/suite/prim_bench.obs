#~
Cost of the primitives the JSON parser and the collections are made of: prim_bench <test> <n>.
Each test repeats one small operation n times; under an instruction counter (callgrind, or
perf stat) the difference between two values of n divided by the difference in n is the cost of one
operation in instructions. Used to attribute a per-element cost to its parts when the profiler sees
compiled code only as addresses.

Every loop is in a 'native' function, so it is compiled code calling the operation (with --jit=off,
the interpreter). 'main_loop' is the exception: the same empty loop inside Main, which is entered
once and therefore always interpreted.
~#
use Collection, Data.JSON;

class Holder {
	@v : Int;
	@s : String;

	New(v : Int) {
		@v := v;
	}

	New(v : Int, s : String) {
		@v := v;
		@s := s;
	}

	method : public : Get() ~ Int {
		return @v;
	}

	method : public : virtual : Kind() ~ Int;
}

class HolderA from Holder {
	New(v : Int) {
		Parent(v);
	}

	method : public : Kind() ~ Int {
		return 1;
	}
}

class PrimBench {
	function : native : ArraySize(n : Int, chars : Char[]) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += chars->Size();
		};
		return check;
	}

	function : native : ArrayGet(n : Int, chars : Char[]) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += chars[i and 7] and 1;
		};
		return check;
	}

	function : native : CallFunction(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += Twice(i) and 1;
		};
		return check;
	}

	function : native : Twice(v : Int) ~ Int {
		if(v > 5) {
			return v + v;
		};
		return v;
	}

	function : native : IntToString(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += i->ToString()->Size();
		};
		return check;
	}

	function : native : EmptyLoop(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += i and 1;
		};
		return check;
	}

	function : native : CallMethod(n : Int, h : Holder) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += h->Get();
		};
		return check;
	}

	function : native : CallVirtual(n : Int, h : Holder) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += h->Kind();
		};
		return check;
	}

	function : native : NewObject(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += HolderA->New(i)->Get() and 1;
		};
		return check;
	}

	function : native : NewCharArray(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += Char->New[8]->Size();
		};
		return check;
	}

	function : native : StringLiteral(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += "true"->Size();
		};
		return check;
	}

	function : native : StringNew(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += String->New()->Size();
		};
		return check;
	}

	function : native : StringFromChars(n : Int, chars : Char[]) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += String->New(chars, 6, 5)->Size();
		};
		return check;
	}

	function : native : StringSize(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += key->Size();
		};
		return check;
	}

	function : native : StringGet(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += key->Get(1) and 1;
		};
		return check;
	}

	function : native : StringEquals(n : Int, key : String, same : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			if(key->Equals(same)) {
				check += 1;
			};
		};
		return check;
	}

	function : native : StringCompare(n : Int, key : String, same : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += key->Compare(same) + 1;
		};
		return check;
	}

	function : native : StringHash(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += key->HashID() and 1;
		};
		return check;
	}

	function : native : StringAppendChar(n : Int) ~ Int {
		s := String->New();
		for(i := 0; i < n; i += 1;) {
			s->Append('x');
		};
		return s->Size();
	}

	function : native : StringAppendStr4(n : Int, key : String) ~ Int {
		s := String->New();
		for(i := 0; i < n; i += 1;) {
			s->Append(key);
		};
		return s->Size();
	}

	function : native : StringToCharArray(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += key->ToCharArray()->Size();
		};
		return check;
	}

	function : native : IntRefCompare(n : Int, a : IntRef, b : IntRef) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += a->Compare(b) + 1;
		};
		return check;
	}

	function : native : ClassId(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += key->GetClassID() and 1;
		};
		return check;
	}

	function : native : Cast(n : Int, base : Base) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += base->As(String)->Size();
		};
		return check;
	}

	function : native : InterfaceCall(n : Int, cmp : Compare, same : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += cmp->Compare(same) + 1;
		};
		return check;
	}

	function : native : IsDigit(n : Int, chars : Char[]) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			if(chars[i and 7]->IsDigit()) {
				check += 1;
			};
		};
		return check;
	}

	function : native : VectorNew(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += Vector->New()<String>->Size() + 1;
		};
		return check;
	}

	function : native : VectorAdd1(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			v := Vector->New()<String>;
			v->AddBack(key);
			check += v->Size();
		};
		return check;
	}

	function : native : VectorAdd8(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			v := Vector->New()<String>;
			for(j := 0; j < 8; j += 1;) {
				v->AddBack(key);
			};
			check += v->Size();
		};
		return check;
	}

	function : native : VectorGet(n : Int, key : String) ~ Int {
		v := Vector->New()<String>;
		v->AddBack(key);
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += v->Get(0)->Size();
		};
		return check;
	}

	function : native : MapNew(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += Map->New()<String, String>->Size() + 1;
		};
		return check;
	}

	function : native : MapInsert1(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			m := Map->New()<String, String>;
			m->Insert(key, key);
			check += m->Size();
		};
		return check;
	}

	function : native : MapInsert8(n : Int, keys : String[]) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			m := Map->New()<String, String>;
			for(j := 0; j < 8; j += 1;) {
				m->Insert(keys[j], keys[j]);
			};
			check += m->Size();
		};
		return check;
	}

	function : native : MapFind8(n : Int, keys : String[]) ~ Int {
		m := Map->New()<String, String>;
		for(j := 0; j < 8; j += 1;) {
			m->Insert(keys[j], keys[j]);
		};
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += m->Find(keys[i and 7])->Size() and 1;
		};
		return check;
	}

	function : native : MapKeyValues8(n : Int, keys : String[]) ~ Int {
		m := Map->New()<String, String>;
		for(j := 0; j < 8; j += 1;) {
			m->Insert(keys[j], keys[j]);
		};
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += m->GetKeyValues()->Size() and 1;
		};
		return check;
	}

	function : native : HashInsert8(n : Int, keys : String[]) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			m := Hash->New()<String, String>;
			for(j := 0; j < 8; j += 1;) {
				m->Insert(keys[j], keys[j]);
			};
			check += m->Size();
		};
		return check;
	}

	function : native : HashFind8(n : Int, keys : String[]) ~ Int {
		m := Hash->New()<String, String>;
		for(j := 0; j < 8; j += 1;) {
			m->Insert(keys[j], keys[j]);
		};
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += m->Find(keys[i and 7])->Size() and 1;
		};
		return check;
	}

	function : native : JsonElemTrue(n : Int) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += JsonElement->New(JsonElement->JsonType->TRUE)->Size() + 1;
		};
		return check;
	}

	function : native : JsonElemString(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += JsonElement->New(key)->Size() + 1;
		};
		return check;
	}

	function : native : JsonParserNew(n : Int, text : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			if(JsonParser->New(text) <> Nil) {
				check += 1;
			};
		};
		return check;
	}

	function : native : JsonParse(n : Int, text : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += JsonParser->TextToElement(text)->Size() + 1;
		};
		return check;
	}

	function : native : JsonToString(n : Int, text : String) ~ Int {
		root := JsonParser->TextToElement(text);
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += root->ToString()->Size() and 1;
		};
		return check;
	}

	function : native : JsonEncode(n : Int, key : String) ~ Int {
		check := 0;
		for(i := 0; i < n; i += 1;) {
			check += JsonElement->Encode(key)->Size();
		};
		return check;
	}

	function : Main(args : String[]) ~ Nil {
		test := args[0];
		n := args[1]->ToInt();
		check := 0;
		chars := "hello world, this is text"->ToCharArray();
		h := HolderA->New(3);
		key := "name";
		same := "name";
		keys := ["jsonrpc", "id", "method", "params", "name", "arguments", "limit", "since"];
		request := "{\"jsonrpc\":\"2.0\",\"id\":17,\"method\":\"tools/call\",\"params\":{\"name\":\"search_orders\",\"arguments\":{\"customer\":\"ACME-0042\",\"limit\":25,\"open_only\":true,\"since\":\"2026-11-01\"},\"_meta\":{\"progressToken\":\"p-17\"}}}";

		if(test->Equals("main_loop")) {
			for(i := 0; i < n; i += 1;) {
				check += i and 1;
			};
		}
		else if(test->Equals("empty_loop")) { check := EmptyLoop(n); }
		else if(test->Equals("array_size")) { check := ArraySize(n, chars); }
		else if(test->Equals("array_get")) { check := ArrayGet(n, chars); }
		else if(test->Equals("call_function")) { check := CallFunction(n); }
		else if(test->Equals("int_to_string")) { check := IntToString(n); }
		else if(test->Equals("call_method")) { check := CallMethod(n, h); }
		else if(test->Equals("call_virtual")) { check := CallVirtual(n, h); }
		else if(test->Equals("new_object")) { check := NewObject(n); }
		else if(test->Equals("new_char_array")) { check := NewCharArray(n); }
		else if(test->Equals("string_literal")) { check := StringLiteral(n); }
		else if(test->Equals("string_new")) { check := StringNew(n); }
		else if(test->Equals("string_from_chars")) { check := StringFromChars(n, chars); }
		else if(test->Equals("string_size")) { check := StringSize(n, key); }
		else if(test->Equals("string_get")) { check := StringGet(n, key); }
		else if(test->Equals("string_equals")) { check := StringEquals(n, key, same); }
		else if(test->Equals("string_compare")) { check := StringCompare(n, key, same); }
		else if(test->Equals("string_hash")) { check := StringHash(n, key); }
		else if(test->Equals("string_append_char")) { check := StringAppendChar(n); }
		else if(test->Equals("string_append_str4")) { check := StringAppendStr4(n, key); }
		else if(test->Equals("string_to_chars")) { check := StringToCharArray(n, key); }
		else if(test->Equals("intref_compare")) { check := IntRefCompare(n, IntRef->New(7), IntRef->New(7)); }
		else if(test->Equals("class_id")) { check := ClassId(n, key); }
		else if(test->Equals("cast")) { check := Cast(n, key); }
		else if(test->Equals("interface_call")) { check := InterfaceCall(n, key, same); }
		else if(test->Equals("is_digit")) { check := IsDigit(n, chars); }
		else if(test->Equals("vector_new")) { check := VectorNew(n); }
		else if(test->Equals("vector_add_1")) { check := VectorAdd1(n, key); }
		else if(test->Equals("vector_add_8")) { check := VectorAdd8(n, key); }
		else if(test->Equals("vector_get")) { check := VectorGet(n, key); }
		else if(test->Equals("map_new")) { check := MapNew(n); }
		else if(test->Equals("map_insert_1")) { check := MapInsert1(n, key); }
		else if(test->Equals("map_insert_8")) { check := MapInsert8(n, keys); }
		else if(test->Equals("map_find_8")) { check := MapFind8(n, keys); }
		else if(test->Equals("map_keyvalues_8")) { check := MapKeyValues8(n, keys); }
		else if(test->Equals("hash_insert_8")) { check := HashInsert8(n, keys); }
		else if(test->Equals("hash_find_8")) { check := HashFind8(n, keys); }
		else if(test->Equals("json_elem_true")) { check := JsonElemTrue(n); }
		else if(test->Equals("json_elem_string")) { check := JsonElemString(n, key); }
		else if(test->Equals("json_parser_new")) { check := JsonParserNew(n, "true"); }
		else if(test->Equals("json_parse_true")) { check := JsonParse(n, "true"); }
		else if(test->Equals("json_parse_obj1")) { check := JsonParse(n, "{\"a\":1}"); }
		else if(test->Equals("json_parse_arr3")) { check := JsonParse(n, "[1,2,3]"); }
		else if(test->Equals("json_parse_request")) { check := JsonParse(n, request); }
		else if(test->Equals("json_tostring_request")) { check := JsonToString(n, request); }
		else if(test->Equals("json_encode")) { check := JsonEncode(n, key); }
		else {
			"unknown test"->ErrorLine();
			Runtime->Exit(2);
		};

		"check={$check}"->PrintLine();
	}
}
