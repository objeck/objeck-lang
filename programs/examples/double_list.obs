class Traverse {
	function : Main(args : String[]) ~ Nil {
		list := Collection.List->New()<IntRef>;
		list->Insert(100);
		list->Insert(50);
		list->Insert(25);
		list->Insert(10);
		list->Insert(5);

		"-- forward --"->PrintLine();
		list->Rewind();
		while(list->More()) {
			list->Get()->PrintLine();
			list->Next();
		};

		"-- backward --"->PrintLine();
		list->Forward();
		while(list->More()) {
			list->Get()->PrintLine();
			list->Previous();
		};
	}
}
