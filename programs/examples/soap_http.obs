use Web.HTTP;
use Data.XML;
use Collection;

bundle Default {
  class HttpPostTest {
    function : Main(args : String[]) ~ Nil {
      url := Url->New("https://www.mobilefish.com/services/web_service/countries.php");
      type := "text/xml";
      client := HttpsClient->New();
      # make POST request
      response := client->Post(url,
        "<?xml version='1.0' encoding='UTF-8' standalone='no'?><SOAP-ENV:Envelope xmlns:SOAP-ENV='http://schemas.xmlsoap.org/soap/envelope/' xmlns:wsdl='http://schemas.xmlsoap.org/wsdl/' xmlns:soap='http://schemas.xmlsoap.org/wsdl/soap/' xmlns:tns='urn:countries.webservice.mobilefish.com' xmlns:xsd='http://www.w3.org/2001/XMLSchema' xmlns:SOAP-ENC='http://schemas.xmlsoap.org/soap/encoding/' xmlns:xsi='http://www.w3.org/2001/XMLSchema-instance' ><SOAP-ENV:Body><mns:countryInfoByIana xmlns:mns='http://schemas.xmlsoap.org/soap/envelope/' SOAP-ENV:encodingStyle='http://schemas.xmlsoap.org/soap/encoding/'><ianacode xsi:type='xsd:string'>zw</ianacode></mns:countryInfoByIana></SOAP-ENV:Body></SOAP-ENV:Envelope>"->ToByteArray(), type);
      if(response = Nil | response->GetContent() = Nil) {
        return;
      };
      # read response
      xml := response->GetContent()->ToString();
      # parse XML
xml->PrintLine();
      parser := XmlParser->New(xml);
        if(parser->Parse()) {
          results := parser->FindElements("/SOAP-ENV:Envelope/SOAP-ENV:Body/SOAP-ENV:countryInfoByIanaResponse/return/countryname");
        if(results->Size() > 0) {
          results->Get(0)->GetContent()->PrintLine();
        };
      };
    }
  }
}
