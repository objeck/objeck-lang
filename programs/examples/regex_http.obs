use Web.HTTP;
use Query.RegEx;

class RegExUrls {
	function : Main(args : String[]) ~ Nil {
		if(args->Size() <> 1) { return; };

		url := Url->New(args[0]);
		response : Response;
		if(url->GetScheme()->Equals("https")) {
			response := HttpsClient->QuickGet(url);
		}
		else {
			response := HttpClient->QuickGet(url);
		};

		if(response = Nil | response->GetContent() = Nil) { return; };
		input := response->GetContent()->ToString();

		input->PrintLine();
		expr := "(href|HREF|src|SRC)=(\"|')(http://|https://|/)?((\\w|\\d|-|_)+(\\.|/)?)+(\\?(\\w|\\d|-|_)+=(\\w|\\d|-|_)+)?(&(\\w|\\d|-|_)+=(\\w|\\d|-|_)+)?(\"|')";

		found := RegEx->New(expr)->Find(input);
		"---"->PrintLine();
		each(i : found) {
			found->Get(i)->GetValue()->PrintLine();
		};
	}
}
