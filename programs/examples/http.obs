use Web.HTTP;

class HttpTest {
	function : Main(args : String[]) ~ Nil {
		# enable cookies
		client := HttpClient->New(true);

		# request creates a cookie
		response := client->Get(Url->New("http://httpbin.org/cookies/set?flavor=oatmeal"));
		if(response <> Nil & response->GetContent() <> Nil) {
			response->GetContent()->ToString()->PrintLine();
		};

		# request sends back cookie
		response := client->Get(Url->New("http://httpbin.org/cookies"));
		if(response <> Nil & response->GetContent() <> Nil) {
			response->GetContent()->ToString()->PrintLine();
		};
	}
}
