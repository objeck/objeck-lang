use Data.JSON;
use Web.HTTP;

bundle Default {
	class JsonWeb {
		function : Main(args : String[]) ~ Nil {
			Run();
		}
		function : native : Run() ~ Nil {
			url := "http://api.geonames.org/citiesJson?north=44.1&south=-9.9&east=-22.4&west=55.2&lang=de&username=demo";
			response := HttpClient->QuickGet(Url->New(url));
			if(response = Nil | response->GetContent() = Nil) {
				return;
			};
			document := response->GetContent()->ToString();

document->PrintLine();
			
			parser := JsonParser->New(document);
			root := parser->Parse() ? parser->GetRoot() : Nil;
			if(root <> Nil & root->GetType() = JsonElement->JsonType->OBJECT) {
				geonames := root->Get("geonames");
				if(geonames <> Nil & geonames->GetType() = JsonElement->JsonType->ARRAY) {
					each(i : geonames) {
						geoname := geonames->Get(i);
						if(geoname <> Nil & geoname->GetType() = JsonElement->JsonType->OBJECT) {
							toponymName := geoname->Get("toponymName");
							lng := geoname->Get("lng");
							lat := geoname->Get("lat");								
							if(toponymName <> Nil & lng <> Nil & lat <> Nil) {
								toponymName->GetValue()->PrintLine();
								"name={$toponymName}, lat={$lat}, lon={$lng}"->PrintLine();									
							};
							"-------------"->PrintLine();
						};
					};
				};						
			}
			else {
				document->PrintLine();
			};
		}
	}
}
