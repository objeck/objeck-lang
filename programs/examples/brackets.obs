class Balanced {
	function : IsBalanced(text : String) ~ Bool {
		level := 0;
		each(character in text) {
			if(character = ']') {
				if(level = 0) {
					return false;
				};
				level -= 1;
			};

			if(character = '[') {
				level += 1;
			};
		};

		return level = 0;
	}

	function : Main(args : String[]) ~ Nil {
		IsBalanced("")->PrintLine();
		IsBalanced("[]")->PrintLine();
		IsBalanced("[][]")->PrintLine();
		IsBalanced("[[][]]")->PrintLine();
		IsBalanced("][")->PrintLine();
		IsBalanced("][][")->PrintLine();
		IsBalanced("[]][[]")->PrintLine();
	}
}

