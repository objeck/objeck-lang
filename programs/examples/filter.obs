use Collection;

class Evens {
	function : Main(args : String[]) ~ Nil {
		values := Vector->New()<IntRef>;
		each(v in [1, 2, 3, 4, 5]) {
			values->AddBack(v);
		};
		f := Filter(IntRef) ~ Bool;
		evens := values->Filter(f);

		each(i : evens) {
			evens->Get(i)->PrintLine();
		};
	}

	function : Filter(v : IntRef) ~ Bool {
		return v % 2 = 0;	
	}
}
