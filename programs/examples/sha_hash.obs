class ShaHash {
	function : Main(args : String[]) ~ Nil {
		hash:= Cipher.Hash->SHA256("Rosetta code"->ToByteArray());
		out := "";
		each(b in hash) {
			out += b->ToHexDigits(2);
		};
		out->PrintLine();
		out->Equals("764faf5c61ac315f1497f9dfa542713965b785e5cc2f707d6468d7d1124cdfcf")->PrintLine();
	}
}
