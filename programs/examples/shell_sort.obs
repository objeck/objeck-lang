bundle Default {
	class SubString {
		function : Main(args : String[]) ~ Nil {
			values := [5, -1, 101, -4, 0, 1, 8, 6,  2, 3 ];
			"----------"->PrintLine();
			CocktailSort(values);
			each(i : values) {
				values[i]->PrintLine();
			};
		}
    	
		function : CocktailSort(a : Int[]) ~ Nil {
			swapped : Bool;
			do {
				swapped := false;
				keep_going := true;
				for (i := 0; i <= a->Size()  - 2 & keep_going; i += 1;) {
					if(a[i] > a[i + 1]) {
						temp := a[i];
						a[i] := a[i+1];
						a[i+1] := temp;
						swapped := true;
					};
				};
								
				if(swapped <> true) {
					keep_going := false;
				};
				
				swapped := false;
				for(i := a->Size() - 2; i >= 0; i -= 1;){
					if(a[i] > a[i + 1]) {
						temp := a[i];
						a[i] := a[i+1];
						a[i + 1] := temp;
						swapped := true;
					};
				};
			} 
			while (swapped);
		}
		
		
	}
}
