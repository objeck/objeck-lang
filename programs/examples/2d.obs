use System.IO;

class TwoDee {
	function : Main(args : String[]) ~ Nil {
		DoIt();
	}

	function : native : DoIt() ~ Nil {
		Console->Print("Enter x: ");
		x := Console->ReadLine()->ToInt();

		Console->Print("Enter y: ");
		y := Console->ReadLine()->ToInt();

		if(x > 0 & y > 0) {
			array : Int[,] := Int->New[x, y];
			array[0, 0] := 2;
			array[0, 0]->PrintLine();
		};	
	}
}


