#~
# compile: obc -src checkers_engine.obs,checkers_game.obs,checkers_ai.obs,checkers_logic.obs,checkers_draw.obs,checkers_chars.obs,checkers_fx.obs,checkers_music.obs,checkers_audio.obs,checkers.obs -lib sdl2,sdl_game,ai,json,collect -dest checkers.obe
# run:     obr checkers.obe
#
# Checkers (English draughts) against a computer that thinks at ten levels, or
# watch the computer play itself. Click a piece, then click where it goes (or
# use the arrow keys and Enter). Jumping is compulsory, as in the real game, and
# a piece that reaches the far row is crowned a king. Press H for a hint, U to
# take a move back, N for a new game, F to turn the board around, Esc for the
# menu and Q to quit. Your choices (piece set, level, colour) are remembered in
# a small JSON file, .checkers.json, in your home folder.
#
# Eight piece sets are drawn with SDL2 shapes, so there is no artwork to license:
# Classic, Glossy, Engraved and Modern discs, and four crazy sets of little
# creatures (Critters, Monsters, Snacks, Space). The music is made up while you
# play, in a hip-hop or a modern-beats style, from formulas: no sound files.
# S turns the sound on and off, E saves the music so far as a .mid file, B throws
# a party.
#
# How it works, in the order you would read the files:
#   checkers_engine.obs  the rules: the board as numbers (bitboards), legal moves
#   checkers_game.obs    a whole game: history, undo, wins and draws
#   checkers_ai.obs      the computer: evaluation, alpha-beta search, the 10 levels
#   checkers_logic.obs   clicks and keys turned into moves (no graphics)
#   checkers_draw.obs    the pictures: board, plain pieces, crowns, buttons
#   checkers_chars.obs   the creature pieces and their faces
#   checkers_fx.obs      particles, pop-up words, the opponent's face
#   checkers_music.obs   the generated music: styles, Markov chains, MIDI, synthesizer
#   checkers_audio.obs   playing it, and exporting the song
#   checkers.obs         this file: the window, the 60 frames a second loop
#
# The computer thinks on its own thread, so the window never freezes: the
# pieces keep moving while a deep search runs. For the games it has learned
# from, see checkers_train.obs; for proof that level N beats level N-1, see
# checkers_tournament.obs. There is a README.md next to this file.
#
# For pictures instead of play: --screenshot out.png [--scene start|play|capture|king|over]
# [--set 0-7] [--level 1-10] saves one frame and exits; --demo [out_dir] lets
# the computer play itself for a few seconds (and saves frames to out_dir).
#
# output: a window titled "Checkers" (1040 x 700): a menu to pick the piece
# set, level and colour, then an 8 x 8 board with a side panel showing whose
# move it is, the pieces captured, the moves so far and the buttons.
~#

use System.IO.Filesystem;
use Game.SDL2;
use Game.Framework;

class CheckersApp {
  # the window
  @fw : GameFramework;
  @r : Renderer;
  @text : CkText;
  @event : Event;
  @quit : Bool;
  @now : Int;            # milliseconds of game time (60 frames = 1000 ms)
  @frame : Int;

  # the game
  @settings : CkSettings;
  @settings_path : String;
  @game : CkGame;
  @ctl : CkController;
  @hand : CkEval;
  @learned : CkEval;
  @ai : CkPlayer[];      # the computer player for each side (Nil for a human)
  @hint_player : CkPlayer;
  @screen : Int;         # 0 menu, 1 playing
  @generation : Int;     # bumped by every new game / undo; stale thoughts are dropped

  # thinking
  @thinker : CkThinker;
  @think_start : Int;
  @hint_thinker : CkThinker;
  @hint_move : CkMove;

  # moving pieces
  @anim_on : Bool;
  @anim_pos : CkPos;
  @anim_move : CkMove;
  @anim_t0 : Int;
  @anim_dur : Int;
  @anim_side : Int;
  @last_move : CkMove;
  @pause_until : Int;

  # fun mode
  @fun_event : CkEvent;
  @fun_t0 : Int;
  @fun_applied : Bool;
  @fun_seed : Int;

  # the mouse and the messages
  @mx : Int;
  @my : Int;
  @kbd : Bool;           # the keyboard cursor is showing
  @msg : String;
  @msg_until : Int;
  @rects : Int[];        # buttons drawn this frame: id, x, y, w, h, ...
  @nrects : Int;
  @click_rects : Int[];  # the buttons of the previous frame, which clicks use
  @click_n : Int;

  # command line
  @shot_file : String;
  @shot_frame : Int;
  @scene : String;
  @demo : Bool;
  @demo_dir : String;
  @over_frame : Int;
  @lay : CkLayout;       # where the panels go, from the window size
  @mlay : CkMenuLayout;  # where the menu's cards, levels and settings go
  @win_w : Int;
  @win_h : Int;
  @combo : Int;         # pieces taken so far in the move on show
  @last_input : Int;    # when the person last did anything
  @antic_sq : Int;
  @antic_kind : Int;
  @antic_t0 : Int;
  @antic_next : Int;
  @egg : Int;
  @cheer : Bool;        # the piece that just landed captured something
  @t_start : Int;
  @work_ms : Int;

  # the playful layer: particles, words, the opponent's face, shaking
  @fx : CkParticles;
  @pop : CkPopups;
  @mood : Int;
  @mood_until : Int;
  @quip : String;
  @quip_until : Int;
  @think_quip : Bool;
  @land_sq : Int;
  @land_t0 : Int;
  @crown_sq : Int;
  @crown_t0 : Int;
  @poofed : Int;
  @over_seen : Bool;
  @over_t0 : Int;
  @shake : Int;
  @shake_until : Int;
  @shake_x : Int;
  @shake_y : Int;
  @flash : Int;
  @audio : CkAudio;     # music and sound effects; silent when there is no sound card
  @silent : Bool;
  @ev_pos : CkPos;

  function : Main(args : String[]) ~ Nil {
    app := CheckersApp->New();
    app->Run(args);
  }

  New() {
    @settings := CkSettings->New();
    @rects := Int->New[400];
    @click_rects := Int->New[400];
    @ai := CkPlayer->New[2];
    @shot_frame := -1;
    @fx := CkParticles->New();
    @pop := CkPopups->New();
    @land_sq := -1;
    @crown_sq := -1;
    @antic_sq := -1;
  }

  # ---- layout ----

  method : Width() ~ Int {
    return @lay->W();
  }


  method : Height() ~ Int {
    return @lay->H();
  }


  method : BoardLeft() ~ Int {
    return @lay->BoardLeft();
  }


  method : BoardTop() ~ Int {
    return @lay->BoardTop();
  }


  method : Size() ~ Int {
    return @lay->Square();
  }

  # the size of text that fits in width pixels: size, or the next sizes down
  method : Fit(text : String, width : Int, size : Int) ~ Int {
    s := size;
    while(s > 0 & @text->Width(text, s) > width) {
      s -= 1;
    };
    return s;
  }

  # draw text left-aligned (align 0), centred (1) or right-aligned (2) at x, shrinking
  # the font and then cutting the text so it never runs out of its box of width pixels
  method : Say(text : String, x : Int, y : Int, width : Int, size : Int, red : Int, green : Int, blue : Int, align : Int) ~ Nil {
    s := Fit(text, width, size);
    shown := text;
    if(@text->Width(shown, s) > width) {
      limit := width / 6;
      shown := text->Truncate(limit, "...");
    };
    @text->Draw(shown, x, y, s, red, green, blue, align);
  }


  # ---- start up ----

  method : Run(args : String[]) ~ Nil {
    ParseArgs(args);
    if(@win_w <= 0) {
      @win_w := 1040;
      @win_h := 700;
    };
    @lay := CkLayout->New(@win_w, @win_h);
    @mlay := CkMenuLayout->New(@lay->W(), @lay->H(), CkChars->SetCount(), 10);

    @fw := GameFramework->New(Width(), Height(), "Checkers");
    @r := @fw->GetRenderer();
    # SDL_mixer fails to start when there is no sound device; the game does not
    # need sound, so carry on silently as long as the window and renderer exist
    if(@r = Nil | @r->IsNull()) {
      "Unable to start SDL2"->ErrorLine();
      return;
    };
    @event := Event->New();
    @r->SetDrawBlendMode(BlendMode->SDL_BLENDMODE_BLEND);
    font_path := Runtime->GetProperty("lib_dir");
    if(font_path = Nil) {
      "Unable to find the lib folder (fonts)"->ErrorLine();
      return;
    };
    font_path += "/sdl/fonts/lato.ttf";
    @text := CkText->New(@r, font_path);
    if(<>@text->IsOk()) {
      "Unable to load the font"->ErrorLine();
      return;
    };

    @hand := CkEval->New();
    @learned := CkEval->Trained();
    # no sound while taking pictures, and none with --silent
    if(@shot_file = Nil & <>@silent) {
      @audio := CkAudio->New(@fun_seed, @settings->MusicStyle());
    };
    if(@learned->FromJson(FileReader->ReadFile("checkers_weights.json"))) {
      "Loaded checkers_weights.json"->PrintLine();
    };

    @settings_path := Runtime->GetUserDir() + Directory->GetSlash() + ".checkers.json";
    if(@shot_file = Nil & <>@demo) {
      @settings->Load(@settings_path);
    };

    @game := CkGame->New();
    @ctl := CkController->New(@game, @settings->Human(), false);
    @screen := 0;
    @fun_seed := 20260101;
    @msg := "";

    if(@demo) {
      @settings->SetHuman(2);
      StartGame();
    }
    else if(@scene <> Nil) {
      SetupScene(@scene);
    };

    while(<>@quit) {
      @fw->FrameStart();
      work0 := Timer->GetTicks();
      HandleEvents();
      Update();
      UpdateSound();
      Draw();
      if(@demo & @frame >= 100 & @frame < 500) {
        @work_ms += Timer->GetTicks() - work0;
      };
      if(@shot_file <> Nil & @frame = @shot_frame) {
        ok := @r->SavePNG(@shot_file);
        if(ok) {
          "wrote {$@shot_file}"->PrintLine();
        }
        else {
          "could not write {$@shot_file}"->ErrorLine();
        };
        @quit := true;
      };
      @fw->Show();
      if(@demo & @screen = 1) {
        if(@game->IsOver() & @over_frame = 0) {
          @over_frame := @frame;
        };
        if(@frame > 1500 | (@over_frame > 0 & @frame > @over_frame + 120)) {
          @quit := true;
        };
      };
      if(@demo & @demo_dir <> Nil & @frame % 45 = 0 & @screen = 1) {
        name := @demo_dir + "/demo_{$(@frame / 45)}.png";
        @r->SavePNG(name);
      };
      if(@demo & @frame = 150 & @audio <> Nil) {
        "audio engine: {$@audio->Engine()}, {$@audio->Queued()} bytes queued"->PrintLine();
      };
      if(@demo & @frame = 100) {
        @t_start := Timer->GetTicks();
      };
      if(@demo & @frame = 500) {
        ms := Timer->GetTicks() - @t_start;
        "400 frames took {$ms} ms; update and drawing took {$@work_ms} ms in all, {$(@work_ms / 400)} ms a frame (the 60 fps budget is 16 ms)"->PrintLine();
      };
      @frame += 1;
      @now += 16;
      @fw->FrameEnd();
    };

    if(@shot_file = Nil & <>@demo) {
      @settings->Save(@settings_path);
    };
    if(@audio <> Nil) {
      @audio->Close();
    };
    @fw->Quit();
  }

  method : ParseArgs(args : String[]) ~ Nil {
    each(i : args) {
      a := args[i];
      has_next := i + 1 < args->Size();
      if(a->Equals("--screenshot") & has_next) {
        @shot_file := args[i + 1];
        @shot_frame := 40;
      }
      else if(a->Equals("--scene") & has_next) {
        @scene := args[i + 1];
      }
      else if(a->Equals("--set") & has_next) {
        @settings->SetPieceSet(args[i + 1]->ToInt());
      }
      else if(a->Equals("--level") & has_next) {
        @settings->SetLevel(args[i + 1]->ToInt());
      }
      else if(a->Equals("--frame") & has_next) {
        @shot_frame := args[i + 1]->ToInt();
      }
      else if(a->Equals("--size") & has_next) {
        dims := args[i + 1]->Split('x');
        if(dims->Size() = 2) {
          @win_w := dims[0]->ToInt();
          @win_h := dims[1]->ToInt();
        };
      }
      else if(a->Equals("--silent")) {
        @silent := true;
      }
      else if(a->Equals("--demo")) {
        @demo := true;
        if(has_next & <>args[i + 1]->StartsWith("--")) {
          @demo_dir := args[i + 1];
        };
      };
    };
  }

  # Put the window in a particular state for --screenshot. The scenes are the
  # moments the README shows.
  method : SetupScene(scene : String) ~ Nil {
    if(scene->Equals("start")) {
      return;
    };

    @settings->SetHuman(0);
    @settings->SetLevel(@settings->Level());
    StartGame();
    @anim_on := false;

    if(scene->Equals("play")) {
      @game->SetPosition(CkPos->FromText("r:a1,c1,e1,g1,b2,d2,f2,h2,c3,e3,g3,f4 w:b6,d6,f6,h6,a7,c7,e7,g7,b8,d8,f8,d4 /0"));
      @ctl->SetFlipped(false);
      @ctl->ClickSquare(CkBits->Parse("c3"));
      @last_move := CkMove->New(CkBits->Parse("c5"), CkBits->Parse("d4"), 0, 0, 0);
      @ctl->SetCursor(CkBits->Parse("d4"));
      @kbd := true;
    }
    else if(scene->Equals("capture")) {
      @game->SetPosition(CkPos->FromText("r:c3,e1,g1,h2 w:d4,f6,b6,e7 /0"));
      idx := @game->Legal()->Find(CkBits->Parse("c3"), CkBits->Parse("g7"));
      if(idx >= 0) {
        PlayAndAnimate(idx);
        @shot_frame := 12;
      };
    }
    else if(scene->Equals("king")) {
      @game->SetPosition(CkPos->FromText("r:a7,e1,g3 R:d4 w:c7,f6,h8 W:a3 /0"));
      idx := @game->Legal()->Find(CkBits->Parse("a7"), CkBits->Parse("b8"));
      if(idx >= 0) {
        PlayAndAnimate(idx);
        @shot_frame := 70;
      };
    }
    else if(scene->Equals("over")) {
      @game->SetPosition(CkPos->FromText("r:d4,f4,a1 R:c7 /1"));
      @msg := "";
      @shot_frame := 60;
    }
    else if(scene->Equals("ev_announce")) {
      EventScene(1, 90);
    }
    else if(scene->Equals("ev_gift")) {
      EventScene(0, 135);
    }
    else if(scene->Equals("ev_zap")) {
      EventScene(1, 125);
    }
    else if(scene->Equals("ev_quake")) {
      EventScene(2, 130);
    }
    else if(scene->Equals("ev_wind")) {
      EventScene(3, 132);
    };
  }

  # the computer captures a piece and fun mode answers with the given kind of event
  method : EventScene(kind : Int, frame : Int) ~ Nil {
    pos := CkPos->FromText("r:d4,a1 w:e5,c7,g7,h6,b8 /1");
    e5 := CkBits->Parse("e5");
    c3 := CkBits->Parse("c3");
    seed := 1;
    found := false;
    while(<>found & seed < 600) {
      g := CkGame->New();
      g->SetPosition(pos);
      g->SetFun(true, 0, seed, 12, 2, 1);
      g->Play(g->Legal()->Find(e5, c3));
      ev := g->PendingEvent();
      if(ev <> Nil & ev->Kind() = kind) {
        found := true;
      }
      else {
        seed += 1;
      };
    };
    @settings->SetFun(2);
    @game->SetPosition(pos);
    @game->SetFun(true, 0, seed, 12, 2, 1);
    PlayAndAnimate(@game->Legal()->Find(e5, c3));
    @shot_frame := frame;
  }

  # ---- games ----

  method : StartGame() ~ Nil {
    @generation += 1;
    @game->Reset();
    human := @settings->Human();
    @ctl->SetHuman(human);
    flip := @settings->Flip();
    if(human = 1) {
      flip := <>flip;
    };
    @ctl->SetFlipped(flip);
    @ctl->Clear();
    @thinker := Nil;
    @hint_thinker := Nil;
    @hint_move := Nil;
    @last_move := Nil;
    @anim_on := false;
    @fun_event := Nil;
    @screen := 1;
    level := @settings->Level();

    @ai[0] := Nil;
    @ai[1] := Nil;
    seed := @fun_seed + @generation;
    if(human <> 0) {
      @ai[0] := CkPlayer->New(level, @hand, @learned, seed);
    };
    if(human <> 1) {
      @ai[1] := CkPlayer->New(level, @hand, @learned, seed + 7);
    };
    @hint_player := CkPlayer->New(8, @hand, @learned, seed + 13);

    @game->SetFun(@settings->FunActive(level) & human < 2, human, seed, 12, 2, 3);
    @msg := "";
    @pause_until := @now + 300;

    @fx->Clear();
    @pop->Clear();
    @antic_sq := -1;
    @last_input := @now;
    @land_sq := -1;
    @crown_sq := -1;
    @over_seen := false;
    @over_t0 := 0;
    @flash := 0;
    @shake := 0;
    @think_quip := false;
    @mood := CkChar->Idle();
    @mood_until := 0;
    @quip := Nil;
    if(human < 2) {
      SetMood(CkChar->Idle(), 3000, true);
    };
    # the tenth level is a boss, and says so
    if(level = 10 & human < 2) {
      @quip := "BOSS FIGHT! I have been waiting for you.";
      @quip_until := @now + 4500;
      @pop->Add("BOSS FIGHT!", BoardLeft() + Size() * 4, BoardTop() + 3 * Size(), 4, 255, 90, 70);
    };
  }


  # play legal move idx and start showing it
  method : PlayAndAnimate(idx : Int) ~ Nil {
    mover := @game->Side();
    if(@game->Play(idx)) {
      ShowLastMove(mover);
    };
  }

  # show the move just played by mover: pieces slide across the board
  method : ShowLastMove(mover : Int) ~ Nil {
    last := @game->Entries() - 1;
    @anim_pos := @game->EntryPos(last);
    @anim_move := @game->EntryMove(last);
    @last_move := @anim_move;
    @anim_side := mover;
    @hint_move := Nil;
    @poofed := 0;
    @combo := 0;
    PlaySound(0);
    @think_quip := false;
    @ctl->Clear();
    if(@mood = CkChar->Thinking()) {
      @mood_until := @now;
    };
    if(@settings->Anim()) {
      hops := @anim_move->Hops();
      if(hops < 1) {
        hops := 1;
      };
      @anim_dur := AnimTotal(@anim_move->Hops());
      @anim_t0 := @now;
      @anim_on := true;
    }
    else {
      @anim_on := false;
      AfterMove();
    };
  }


  # called when a move has been shown: look for a fun event, then the end of the game
  method : AfterMove() ~ Nil {
    mv := @anim_move;
    human := @ctl->Human();
    captured := mv->Caps() <> 0;

    if(Fx()) {
      # the piece lands with a squash
      @land_sq := mv->To();
      @land_t0 := @now;
      @cheer := captured;

      # a man that became a king dances and wears a crown that pops on
      was := @anim_pos->At(mv->From());
      now_is := @game->Pos()->At(mv->To());
      if((was = 1 | was = 3) & (now_is = 2 | now_is = 4)) {
        @crown_sq := mv->To();
        @crown_t0 := @now;
        PlaySound(4);
        @fx->Sparkle(CenterX(mv->To()), CenterY(mv->To()), 26, 255, 214, 70);
        @pop->Add("KING ME!", CenterX(mv->To()), CenterY(mv->To()) - 40, 3, 255, 220, 80);
        if(mv->Hops() >= 2) {
          @fx->Confetti(Width(), 90);
        };
      };
    };

    # the opponent reacts to a capture
    if(human < 2 & captured) {
      if(@anim_side = human) {
        SetMood(CkChar->Surprised(), 2200, false);
      }
      else {
        SetMood(CkChar->Smug(), 2200, false);
      };
    };

    ev := @game->PendingEvent();
    if(ev <> Nil) {
      @fun_event := ev;
      @fun_t0 := @now;
      @fun_applied := false;
      SetMood(CkChar->Surprised(), 2400, true);
    };
    @pause_until := @now + 180;
  }


  method : Update() ~ Nil {
    StepFx();
    AnticStep();
    if(@screen <> 1) {
      return;
    };

    # the game just ended: celebrate (or console)
    if(@game->IsOver() & <>@over_seen & <>@anim_on & @fun_event = Nil) {
      @over_seen := true;
      @over_t0 := @now;
      GameEnded();
    };

    # a move on its way across the board
    if(@anim_on) {
      if(@now - @anim_t0 >= @anim_dur) {
        @anim_on := false;
        AfterMove();
      };
      return;
    };

    # a fun-mode event: announce it, then make it happen, then let it play out
    if(@fun_event <> Nil) {
      if(<>@fun_applied & @now - @fun_t0 >= 1500) {
        @ev_pos := @game->Pos()->Copy();
        @game->ApplyEvent(@fun_event);
        @fun_applied := true;
        @fun_t0 := @now;
        StartEventFx(@fun_event);
      }
      else if(@fun_applied & @now - @fun_t0 >= 1000) {
        @fun_event := Nil;
        @pause_until := @now + 200;
      };
      return;
    };

    if(@game->IsOver() | @now < @pause_until) {
      return;
    };

    # the computer's turn
    side := @game->Side();
    player := @ai[side];
    if(player <> Nil) {
      if(@thinker = Nil) {
        StartThinking(player);
      }
      else if(@thinker->IsDone() & @now - @think_start >= 350) {
        mv := @thinker->Move();
        stale := @thinker->Tag() <> @generation;
        @thinker := Nil;
        if(<>stale & mv >= 0) {
          # how it feels about the position shows on its face
          score := player->Score();
          if(score > 150.0) {
            SetMood(CkChar->Smug(), 1800, false);
          }
          else if(score < -150.0) {
            SetMood(CkChar->Sad(), 1800, false);
          };
          PlayAndAnimate(mv);
        };
      }
      else if(@now - @think_start > 1400 & @mood <> CkChar->Thinking() & <>@think_quip) {
        # thinking for a while: say so
        @think_quip := true;
        SetMood(CkChar->Thinking(), 600000, true);
      };
    };

    # a hint the person asked for
    if(@hint_thinker <> Nil & @hint_thinker->IsDone()) {
      mv := @hint_thinker->Move();
      stale := @hint_thinker->Tag() <> @generation;
      @hint_thinker := Nil;
      if(<>stale & mv >= 0 & @game->Side() = @ctl->Human()) {
        @hint_move := @game->Legal()->Get(mv);
        @msg := "Hint: " + @hint_move->ToString();
        @msg_until := @now + 3500;
      };
    };
  }


  method : StartThinking(player : CkPlayer) ~ Nil {
    keys := Int->New[@game->Entries() + 1];
    each(i : @game->Entries()) {
      keys[i] := @game->EntryKey(i);
    };
    @thinker := CkThinker->New(player, @game->Pos()->Copy(), keys, @game->Entries(), @generation);
    @think_start := @now;
    @thinker->Execute(Nil);
  }

  method : AskForHint() ~ Nil {
    if(@hint_thinker <> Nil | @screen <> 1 | @game->IsOver() | @ctl->Human() > 1 | @game->Side() <> @ctl->Human()) {
      return;
    };
    keys := Int->New[@game->Entries() + 1];
    each(i : @game->Entries()) {
      keys[i] := @game->EntryKey(i);
    };
    @hint_thinker := CkThinker->New(@hint_player, @game->Pos()->Copy(), keys, @game->Entries(), @generation);
    @hint_thinker->Execute(Nil);
    @msg := "Thinking about a hint...";
    @msg_until := @now + 4000;
  }

  # ---- input ----

  method : HandleEvents() ~ Nil {
    while(@event->Poll() <> 0) {
      type := @event->GetType();
      if(type = EventType->SDL_MOUSEMOTION | type = EventType->SDL_MOUSEBUTTONDOWN | type = EventType->SDL_KEYDOWN) {
        @last_input := @now;
      };
      if(type = EventType->SDL_QUIT) {
        @quit := true;
      }
      else if(type = EventType->SDL_MOUSEMOTION) {
        m := @event->GetMouseMotion();
        @mx := m->GetX();
        @my := m->GetY();
        @kbd := false;
      }
      else if(type = EventType->SDL_MOUSEBUTTONDOWN) {
        b := @event->GetMouseButton();
        @mx := b->GetX();
        @my := b->GetY();
        @kbd := false;
        if(b->GetButton() = 1) {
          Click(@mx, @my);
        };
      }
      else if(type = EventType->SDL_KEYDOWN) {
        if(@event->GetKey()->GetRepeat() = 0) {
          Key(@event->GetKey()->GetKeysym()->GetScancode());
        };
      };
    };
  }

  # the button under a point: its id, or -1
  method : ButtonAt(x : Int, y : Int) ~ Int {
    found := -1;
    each(i : @click_n) {
      at := i * 5;
      if(x >= @click_rects[at + 1] & x < @click_rects[at + 1] + @click_rects[at + 3] &
          y >= @click_rects[at + 2] & y < @click_rects[at + 2] + @click_rects[at + 4]) {
        found := @click_rects[at];
      };
    };
    return found;
  }

  method : Click(x : Int, y : Int) ~ Nil {
    id := ButtonAt(x, y);
    if(id >= 0) {
      Action(id);
      return;
    };
    # the opponent's face is a button too, if a silly one
    if(@screen = 1 & x >= 704 & x < 704 + 96 & y >= 28 & y < 124) {
      EasterEgg();
      return;
    };

    if(@screen = 1) {
      sq := CkController->SquareAt(x, y, BoardLeft(), BoardTop(), Size(), @ctl->Flipped());
      if(sq >= 0) {
        BoardClick(sq);
      };
    };
  }

  method : BoardClick(sq : Int) ~ Nil {
    if(@anim_on | @fun_event <> Nil) {
      return;
    };
    mover := @game->Side();
    answer := @ctl->ClickSquare(sq);
    if(answer = CkController->Moved()) {
      # the controller has played it; now show it
      ShowLastMove(mover);
    }
    else if(answer = CkController->Selected()) {
      PlaySound(1);
    }
    else if(answer = CkController->MustCapture()) {
      @msg := "You must jump when you can";
      @msg_until := @now + 2200;
      PlaySound(3);
    };
  }

  method : Key(code : Int) ~ Nil {
    if(code = Scancode->SDL_SCANCODE_Q) {
      @quit := true;
      return;
    };
    if(@screen = 0) {
      if(code = Scancode->SDL_SCANCODE_ESCAPE) {
        @quit := true;
      }
      else if(code = Scancode->SDL_SCANCODE_RETURN | code = Scancode->SDL_SCANCODE_SPACE) {
        StartGame();
      };
      return;
    };

    if(code = Scancode->SDL_SCANCODE_ESCAPE | code = Scancode->SDL_SCANCODE_M) {
      @screen := 0;
    }
    else if(code = Scancode->SDL_SCANCODE_S) {
      Action(9);
    }
    else if(code = Scancode->SDL_SCANCODE_E) {
      SaveSong();
    }
    else if(code = Scancode->SDL_SCANCODE_B) {
      @pop->Add("PARTY TIME!", BoardLeft() + Size() * 4, BoardTop() + 150, 4, 255, 120, 220);
      @fx->Confetti(Width(), 160);
      PlaySound(5);
    }
    else if(code = Scancode->SDL_SCANCODE_N) {
      StartGame();
    }
    else if(code = Scancode->SDL_SCANCODE_U) {
      Undo();
    }
    else if(code = Scancode->SDL_SCANCODE_H) {
      AskForHint();
    }
    else if(code = Scancode->SDL_SCANCODE_F) {
      Flip();
    }
    else if(code = Scancode->SDL_SCANCODE_LEFT) {
      @kbd := true;
      @ctl->MoveCursor(0, -1);
    }
    else if(code = Scancode->SDL_SCANCODE_RIGHT) {
      @kbd := true;
      @ctl->MoveCursor(0, 1);
    }
    else if(code = Scancode->SDL_SCANCODE_UP) {
      @kbd := true;
      @ctl->MoveCursor(-1, 0);
    }
    else if(code = Scancode->SDL_SCANCODE_DOWN) {
      @kbd := true;
      @ctl->MoveCursor(1, 0);
    }
    else if(code = Scancode->SDL_SCANCODE_RETURN | code = Scancode->SDL_SCANCODE_SPACE) {
      @kbd := true;
      BoardClick(@ctl->Cursor());
    };
  }

  method : Flip() ~ Nil {
    @ctl->SetFlipped(<>@ctl->Flipped());
    @settings->SetFlip(<>@settings->Flip());
  }

  method : Undo() ~ Nil {
    if(@screen <> 1 | @ctl->Human() > 1 | @anim_on | @fun_event <> Nil) {
      return;
    };
    if(@game->UndoTurn(@ctl->Human())) {
      @generation += 1;
      @thinker := Nil;
      @hint_thinker := Nil;
      @hint_move := Nil;
      @ctl->Clear();
      @last_move := @game->LastMove();
      @msg := "Move taken back";
      @msg_until := @now + 1500;
    };
  }

  # what each button does
  method : Action(id : Int) ~ Nil {
    if(id >= 100 & id < 108) {
      @settings->SetPieceSet(id - 100);
    }
    else if(id >= 200 & id < 211) {
      @settings->SetLevel(id - 200);
    }
    else if(id >= 300 & id < 303) {
      @settings->SetHuman(id - 300);
    }
    else if(id = 303) {
      @settings->SetHuman((@settings->Human() + 1) % 3);
    }
    else if(id = 310) {
      @settings->SetFlip(<>@settings->Flip());
    }
    else if(id = 311) {
      @settings->SetFun((@settings->Fun() + 1) % 3);
    }
    else if(id = 312) {
      @settings->SetAnim(<>@settings->Anim());
    }
    else if(id = 313) {
      @settings->SetReduced(<>@settings->Reduced());
    }
    else if(id = 314 | id = 9) {
      @settings->SetSound(<>@settings->Sound());
      if(@settings->Sound()) {
        PlaySound(1);
      };
    }
    else if(id = 318) {
      @settings->SetShake(<>@settings->Shake());
    }
    else if(id = 316) {
      @settings->SetMusicStyle((@settings->MusicStyle() + 1) % CkStyle->Count());
    }
    else if(id = 317) {
      SaveSong();
    }
    else if(id = 315 | id = 10) {
      # volume goes 0, 20 ... 100 and round again
      v := (@settings->Volume() / 20 + 1) * 20;
      if(v > 100) {
        v := 0;
      };
      @settings->SetVolume(v);
      if(v > 0) {
        @settings->SetSound(true);
        PlaySound(1);
      };
    }
    else if(id = 320 | id = 1) {
      StartGame();
    }
    else if(id = 321 | id = 6) {
      @quit := true;
    }
    else if(id = 2) {
      Undo();
    }
    else if(id = 3) {
      AskForHint();
    }
    else if(id = 4) {
      Flip();
    }
    else if(id = 5) {
      @screen := 0;
    }
    else if(id = 7) {
      @settings->SetLevel(@settings->Level() - 1);
      StartGame();
    }
    else if(id = 8) {
      @settings->SetLevel(@settings->Level() + 1);
      StartGame();
    };
  }

  # ---- drawing ----

  method : Draw() ~ Nil {
    set := @settings->PieceSet();
    t := CkDraw->Theme(set);
    @r->SetDrawColor(t[9], t[10], t[11], 255);
    @r->Clear();
    @nrects := 0;

    if(@screen = 0) {
      DrawMenu();
    }
    else {
      DrawBoard();
      DrawPanel();
      DrawBanner();
    };

    # the buttons seen this frame are the ones the next click can hit
    total := @nrects * 5;
    each(i : total) {
      @click_rects[i] := @rects[i];
    };
    @click_n := @nrects;
  }

  # draw a button and remember where it is
  method : Btn(id : Int, caption : String, x : Int, y : Int, w : Int, h : Int, active : Bool) ~ Nil {
    if(@nrects < 80) {
      at := @nrects * 5;
      @rects[at] := id;
      @rects[at + 1] := x;
      @rects[at + 2] := y;
      @rects[at + 3] := w;
      @rects[at + 4] := h;
      @nrects += 1;
    };
    hover := @mx >= x & @mx < x + w & @my >= y & @my < y + h & <>@kbd;
    CkDraw->Button(@r, @text, caption, x, y, w, h, @settings->PieceSet(), hover, active, true);
  }

  method : OnOff(title : String, on : Bool) ~ String {
    if(on) {
      return title + ": on";
    };
    return title + ": off";
  }

  method : DrawMenu() ~ Nil {
    set := @settings->PieceSet();
    t := CkDraw->Theme(set);
    ar := t[18];
    ag := t[19];
    ab := t[20];
    m := @mlay;
    w := Width();
    compact := Height() < 640;

    if(compact) {
      @text->Draw("CHECKERS", w / 2, 6, 3, ar, ag, ab, 1);
      @text->Draw("English draughts, ten levels of computer opponent", w / 2, 42, 1, t[12], t[13], t[14], 1);
    }
    else {
      @text->Draw("CHECKERS", w / 2, 10, 4, ar, ag, ab, 1);
      @text->Draw("English draughts, with ten levels of computer opponent", w / 2, 68, 2, t[12], t[13], t[14], 1);
    };

    # the piece sets, each on its own board colours
    @text->Draw("Piece set", m->GridX(), m->GridY() - 24, 2, 235, 235, 235, 0);
    count := CkChars->SetCount();
    each(i : count) {
      DrawSetCard(i, m->CardX(i), m->CardY(i), m->CardW(), m->CardH(), i = set);
      Hit(100 + i, m->CardX(i), m->CardY(i), m->CardW(), m->CardH());
    };

    # the ten levels
    @text->Draw("Level", m->GridX(), m->LevelLabelY(), 2, 235, 235, 235, 0);
    each(i : 10) {
      Btn(201 + i, "{$(i + 1)}", m->LevelX(i), m->LevelY(), m->LevelW(), m->LevelH(), i + 1 = @settings->Level());
    };
    lvl := @settings->Level();
    Say("{$CkLevels->Name(lvl)}: {$CkLevels->Tagline(lvl)}", m->GridX(), m->InfoY(), m->RowX() - 36 - m->GridX(), 2, ar, ag, ab, 0);

    # the settings, one per row
    @text->Draw("Settings", m->RowX(), m->GridY() - 24, 2, 235, 235, 235, 0);
    who := String->New[3];
    first := CkDraw->SideName(set, 0);
    second := CkDraw->SideName(set, 1);
    who[0] := "You play: {$first} (first)";
    who[1] := "You play: {$second}";
    who[2] := "Watch the computer play";
    fun := ["Fun mode: off", "Fun mode: levels 1-3", "Fun mode: all levels"];
    rx := m->RowX();
    rw := m->RowW();
    rh := m->RowH();
    Btn(303, who[@settings->Human()], rx, m->RowY(0), rw, rh, @settings->Human() < 2);
    Btn(310, OnOff("Flip board", @settings->Flip()), rx, m->RowY(1), rw, rh, @settings->Flip());
    Btn(311, fun[@settings->Fun()], rx, m->RowY(2), rw, rh, @settings->Fun() > 0);
    Btn(312, OnOff("Animations", @settings->Anim()), rx, m->RowY(3), rw, rh, @settings->Anim());
    Btn(313, OnOff("Reduced motion", @settings->Reduced()), rx, m->RowY(4), rw, rh, @settings->Reduced());
    Btn(318, OnOff("Screen shake", @settings->Shake()), rx, m->RowY(5), rw, rh, @settings->Shake());
    Btn(314, OnOff("Sound", @settings->Sound()), rx, m->RowY(6), rw, rh, @settings->Sound());
    Btn(315, "Volume {$@settings->Volume()}%", rx, m->RowY(7), rw, rh, false);
    Btn(316, "Music: " + CkStyle->Name(@settings->MusicStyle()), rx, m->RowY(8), rw, rh, @settings->MusicStyle() < 2);
    Btn(317, "Save song (.mid)", rx, m->RowY(9), rw, rh, false);

    Btn(320, "Play", m->PlayX(), m->PlayY(), m->PlayW(), m->PlayH(), true);
    Btn(321, "Quit", 18, m->PlayY(), 120, m->PlayH(), false);
    @text->Draw("Enter starts a game, Esc quits", w / 2, m->PlayY() + m->PlayH() + 2, 0, t[12], t[13], t[14], 1);
  }

  # a clickable area that is not drawn as a button (the piece set cards)
  method : Hit(id : Int, x : Int, y : Int, w : Int, h : Int) ~ Nil {
    if(@nrects < 80) {
      at := @nrects * 5;
      @rects[at] := id;
      @rects[at + 1] := x;
      @rects[at + 2] := y;
      @rects[at + 3] := w;
      @rects[at + 4] := h;
      @nrects += 1;
    };
  }


  # a small board with a man and a king of one set, as a button face
  # a small board with a man and a king of one set, as a button face; the name of the
  # set is written under it, inside the card's rectangle
  method : DrawSetCard(set : Int, x : Int, y : Int, w : Int, h : Int, chosen : Bool) ~ Nil {
    t := CkDraw->Theme(set);
    @r->RoundedBoxColor(x, y, x + w - 1, y + h - 1, 10, Color->New(t[6], t[7], t[8], 255));
    if(chosen) {
      each(i : 3) {
        @r->RoundedRectangleColor(x - i, y - i, x + w - 1 + i, y + h - 1 + i, 10, Color->New(t[18], t[19], t[20], 255));
      };
    };
    pad := 5;
    cw := (w - 2 * pad) / 3;
    face_h := h - 20 - pad;
    ch := face_h / 2;
    each(i : 3) {
      each(j : 2) {
        px := x + pad + i * cw;
        py := y + pad + j * ch;
        if((i + j) % 2 = 0) {
          @r->BoxColor(px, py, px + cw - 1, py + ch - 1, Color->New(t[0], t[1], t[2], 255));
        }
        else {
          @r->BoxColor(px, py, px + cw - 1, py + ch - 1, Color->New(t[3], t[4], t[5], 255));
        };
      };
    };
    rad := Int->Min(cw, ch) * 36 / 100;
    f := 0;
    if(Fx() & @screen = 0) {
      f := @frame + 1;
    };
    x0 := x + pad;
    y0 := y + pad;
    CkDraw->PieceX(@r, set, x0 + cw / 2, y0 + ch + ch / 2, rad, 0, false, 1.0, 1.0, 0, 255, 1.0, 0, f, set);
    CkDraw->PieceX(@r, set, x0 + cw + cw / 2, y0 + ch / 2, rad, 1, false, 1.0, 1.0, 0, 255, 1.0, 0, f, set + 1);
    CkDraw->PieceX(@r, set, x0 + 2 * cw + cw / 2, y0 + ch / 2, rad, 0, true, 1.0, 1.0, 0, 255, 1.0, 0, f, set + 2);
    CkDraw->PieceX(@r, set, x0 + 2 * cw + cw / 2, y0 + ch + ch / 2, rad, 1, true, 1.0, 1.0, 0, 255, 1.0, 0, f, set + 3);
    Say(CkDraw->SetName(set), x + w / 2, y + h - 18, w - 8, 1, 245, 245, 245, 1);
  }


  # centre of a board square on the screen
  method : CenterX(sq : Int) ~ Int {
    return BoardLeft() + @shake_x + CkController->ScreenCol(sq, @ctl->Flipped()) * Size() + Size() / 2;
  }


  method : CenterY(sq : Int) ~ Int {
    return BoardTop() + @shake_y + CkController->ScreenRow(sq, @ctl->Flipped()) * Size() + Size() / 2;
  }


  method : DrawBoard() ~ Nil {
    set := @settings->PieceSet();
    t := CkDraw->Theme(set);
    left := BoardLeft() + @shake_x;
    top := BoardTop() + @shake_y;
    size := Size();
    flip := @ctl->Flipped();
    CkDraw->Frame(@r, set, left, top, size);
    CkDraw->Squares(@r, set, left, top, size);

    # coordinates around the edge
    each(i : 8) {
      file := "abcdefgh"->SubString(i, 1);
      rank := "{$(8 - i)}";
      if(flip) {
        file := "abcdefgh"->SubString(7 - i, 1);
        rank := "{$(i + 1)}";
      };
      @text->Draw(file, left + i * size + size / 2, top + 8 * size + 4, 1, t[12], t[13], t[14], 1);
      @text->Draw(rank, left - 16, top + i * size + size / 2 - 9, 1, t[12], t[13], t[14], 1);
    };

    # the last move, the picked-up piece, where it may go
    if(@last_move <> Nil) {
      TintSquare(@last_move->From(), 255, 226, 80, 70);
      TintSquare(@last_move->To(), 255, 226, 80, 90);
    };
    movable := 0;
    if(@ctl->HumanToMove() & <>@anim_on & @fun_event = Nil) {
      movable := @ctl->Movable();
    };
    selected := @ctl->Selection();
    if(selected >= 0) {
      TintSquare(selected, 90, 220, 120, 120);
    };
    if(@hint_move <> Nil) {
      TintSquare(@hint_move->From(), 90, 170, 255, 110);
      TintSquare(@hint_move->To(), 90, 170, 255, 150);
    };

    # forced jump: the pieces that must move glow orange
    if(movable <> 0 & @ctl->JumpIsForced() & selected < 0) {
      pulse := 120 + (60.0 * (@now->As(Float) / 180.0)->Sin())->As(Int);
      each(sq : 64) {
        if((movable and (1 << sq)) <> 0) {
          CkDraw->Outline(@r, left, top, size, CkController->ScreenRow(sq, flip), CkController->ScreenCol(sq, flip), 3, 255, 150, 40, pulse);
        };
      };
    };

    DrawPieces();

    # destinations of the picked-up piece
    if(selected >= 0) {
      dest := @ctl->Destinations(selected);
      each(sq : 64) {
        if((dest and (1 << sq)) <> 0) {
          cx := CenterX(sq);
          cy := CenterY(sq);
          if(@game->Legal()->Caps(0) <> 0) {
            @r->FilledCircleColor(cx, cy, size / 6, Color->New(220, 60, 50, 170));
            @r->AACircleColor(cx, cy, size / 6, Color->New(120, 20, 20, 220));
          }
          else {
            @r->FilledCircleColor(cx, cy, size / 8, Color->New(40, 40, 40, 120));
          };
        };
      };
    };

    if(@kbd & @screen = 1) {
      sq := @ctl->Cursor();
      CkDraw->Outline(@r, left, top, size, CkController->ScreenRow(sq, flip), CkController->ScreenCol(sq, flip), 3, 255, 255, 255, 200);
    };
  }

  method : TintSquare(sq : Int, red : Int, green : Int, blue : Int, alpha : Int) ~ Nil {
    CkDraw->Tint(@r, BoardLeft() + @shake_x, BoardTop() + @shake_y, Size(), CkController->ScreenRow(sq, @ctl->Flipped()), CkController->ScreenCol(sq, @ctl->Flipped()), red, green, blue, alpha);
  }

  # pieces, from the top of the screen down so lower pieces overlap higher ones
  method : DrawPieces() ~ Nil {
    set := @settings->PieceSet();
    pos := @game->Pos();
    skip := -1;
    removed := 0;
    progress := 0.0;
    if(@anim_on) {
      pos := @anim_pos;
      skip := @anim_move->From();
      progress := AnimProgress(@now - @anim_t0);
      removed := CapturedSoFar(progress);
      PoofNewlyCaptured(removed);
    };

    # an event that takes a piece away is played from the position before it
    ev_sq := -1;
    ev_t := 0;
    ev_kind := -1;
    if(@fun_event <> Nil & @fun_applied) {
      ev_sq := @fun_event->Square();
      ev_t := @now - @fun_t0;
      ev_kind := @fun_event->Kind();
      if(ev_kind > 0 & @ev_pos <> Nil) {
        pos := @ev_pos;
      };
    };

    rad := Size() * 38 / 100;

    # pieces the side to move could capture right now: the character sets look worried
    threat := 0;
    if(set >= 4 & <>@game->IsOver()) {
      legal := @game->Legal();
      if(legal->Count() > 0 & legal->Caps(0) <> 0) {
        each(i : legal->Count()) {
          threat := threat or legal->Caps(i);
        };
      };
    };
    hover := -1;
    if(@kbd) {
      hover := @ctl->Cursor();
    }
    else {
      hover := CkController->SquareAt(@mx, @my, BoardLeft(), BoardTop(), Size(), @ctl->Flipped());
    };
    each(sr : 8) {
      each(sc : 8) {
        sq := CkController->ScreenToSquare(sr, sc, @ctl->Flipped());
        kind := pos->At(sq);
        if(kind > 0 & sq <> skip & (removed and (1 << sq)) = 0) {
          side := 0;
          if(kind > 2) {
            side := 1;
          };
          king := kind % 2 = 0;
          sx := 1.0;
          sy := 1.0;
          lift := 0;
          alpha := 255;
          crown := 1.0;
          cx := CenterX(sq);
          cy := CenterY(sq);
          eyes := false;
          blink := false;

          if(Fx()) {
            # the piece that has just landed squashes and wobbles back
            age := @now - @land_t0;
            if(sq = @land_sq & age >= 0 & age < 450) {
              a := 0.2 * (-1.0 * age->As(Float) / 110.0)->Exp() * (age->As(Float) / 26.0)->Cos();
              sx := 1.0 + a;
              sy := 1.0 - a;
            };

            # a new king hops and its crown pops on
            cage := @now - @crown_t0;
            if(sq = @crown_sq & cage >= 0 & cage < 900) {
              decay := (-1.0 * cage->As(Float) / 350.0)->Exp();
              lift := (18.0 * decay * (cage->As(Float) / 95.0)->Sin()->Abs())->As(Int);
              grow := cage->As(Float) / 420.0;
              if(grow > 1.0) {
                grow := 1.0;
              };
              crown := grow * 1.0 + 0.5 * (1.0 - grow) * 0.0 + 0.45 * decay * (cage->As(Float) / 70.0)->Sin();
              if(crown < 0.05) {
                crown := 0.05;
              };
            };

            # the picked-up piece wobbles, looks around, and blinks
            if(sq = @ctl->Selection()) {
              wob := (@now->As(Float) / 85.0)->Sin() * 0.05;
              sx := 1.0 + wob;
              sy := 1.0 - wob;
              lift := 6;
              eyes := true;
            }
            else if(sq = hover & (@ctl->Movable() and (1 << sq)) <> 0 & @ctl->HumanToMove() & <>@anim_on) {
              eyes := true;
            };
            blink := (@now / 16) % 150 < 6;

            # the end of the game: the winner dances, the loser sinks
            if(@over_seen & @over_t0 > 0) {
              status := @game->Status();
              if(status = 1 | status = 2) {
                if(side = status - 1) {
                  lift := (9.0 * ((@now - @over_t0)->As(Float) / 130.0 + sq->As(Float))->Sin()->Abs())->As(Int);
                }
                else {
                  sy := 0.9;
                  sx := 1.05;
                };
              };
            };
          };

          # idle antics: one piece waves, yawns, sneezes (and nudges its neighbours) or peeks
          if(@antic_sq >= 0 & Fx()) {
            at := (@now - @antic_t0)->As(Float);
            near := sq = @antic_sq;
            if(near & @antic_kind = 0) {
              lift := (7.0 * (at / 90.0)->Sin()->Abs())->As(Int);
              sx := 1.0 + 0.06 * (at / 60.0)->Sin();
            }
            else if(near & @antic_kind = 1) {
              sy := 1.0 + 0.18 * (at / 380.0)->Sin()->Abs();
              sx := 1.0 - 0.08 * (at / 380.0)->Sin()->Abs();
            }
            else if(near & @antic_kind = 2) {
              if(at > 700.0 & at < 900.0) {
                sx := 1.2;
                sy := 0.8;
              };
            }
            else if(near & @antic_kind = 3) {
              cx := cx + (9.0 * (at / 300.0)->Sin())->As(Int);
              eyes := true;
            };
            # a sneeze blows the neighbours a little way off
            if(<>near & @antic_kind = 2 & at > 700.0 & at < 1100.0) {
              dr := sq / 8 - @antic_sq / 8;
              dc := sq % 8 - @antic_sq % 8;
              if(Int->Abs(dr) <= 1 & Int->Abs(dc) <= 1) {
                cx := cx + dc * 6;
                cy := cy + dr * 4;
              };
            };
          };

          # events: a gift drops in, a disaster takes the piece away
          if(sq = ev_sq & ev_t >= 0 & ev_t < 1000) {
            if(ev_kind = 0) {
              if(ev_t < 450) {
                f := ev_t->As(Float) / 450.0;
                lift := (230.0 * (1.0 - f * f))->As(Int);
              }
              else {
                bt := (ev_t - 450)->As(Float);
                lift := (22.0 * (-1.0 * bt / 180.0)->Exp() * (bt / 70.0)->Sin()->Abs())->As(Int);
                if(bt < 120.0) {
                  sx := 1.0 + 0.18 * (-1.0 * bt / 60.0)->Exp();
                  sy := 1.0 - 0.18 * (-1.0 * bt / 60.0)->Exp();
                };
              };
            }
            else if(ev_kind = 1) {
              alpha := 255 - ev_t * 255 / 500;
              if(alpha < 0) {
                alpha := 0;
              };
              sx := 1.0 + 0.2 * (ev_t->As(Float) / 25.0)->Sin();
            }
            else if(ev_kind = 2) {
              f := ev_t->As(Float) / 700.0;
              if(f > 1.0) {
                f := 1.0;
              };
              sx := 1.0 + 0.4 * f;
              sy := 1.0 - 0.7 * f;
              cy := cy + (f * 20.0)->As(Int);
              alpha := 255 - (f * 255.0)->As(Int);
            }
            else {
              dir := 1;
              if(CkController->ScreenCol(sq, @ctl->Flipped()) < 4) {
                dir := -1;
              };
              cx := cx + dir * (ev_t->As(Float) * 0.45)->As(Int);
              cy := cy - (ev_t->As(Float) * 0.12)->As(Int);
              sx := (ev_t->As(Float) / 55.0)->Cos();
              alpha := 255 - ev_t * 255 / 900;
              if(alpha < 0) {
                alpha := 0;
              };
            };
          };

          # the creatures' faces: worried when they could be captured, cheering after a
          # capture, dizzy while being captured, winking at a gift, shaken by a disaster
          mood := 0;
          if(set >= 4) {
            if((threat and (1 << sq)) <> 0 & <>@anim_on) {
              mood := 1;
            };
            if(sq = @land_sq & @now - @land_t0 < 1400 & @cheer) {
              mood := 2;
            };
            if(@anim_on & (@anim_move->Caps() and (1 << sq)) <> 0) {
              mood := 3;
            };
            if(sq = ev_sq & ev_kind = 0 & ev_t > 450) {
              mood := 4;
            };
            if(ev_kind > 0 & ev_t >= 0 & ev_t < 1000) {
              mood := 5;
            };
          };
          idle := 0;
          if(Fx()) {
            idle := @frame + 1;
          };
          if(alpha > 0) {
            CkDraw->PieceX(@r, set, cx, cy, rad, side, king, sx, sy, lift, alpha, crown, mood, idle, sq);
            if(eyes) {
              DrawEyes(cx, cy - lift, rad, king, blink);
            };
          };
        };
      };
    };

    # the piece in flight, drawn last so it passes over the others
    if(@anim_on) {
      DrawFlying(progress, rad);
    };
  }

  # googly eyes for the piece that is picked up or pointed at
  method : DrawEyes(cx : Int, cy : Int, rad : Int, king : Bool, blink : Bool) ~ Nil {
    oy := cy - rad / 8;
    if(king) {
      oy := cy + rad / 4;
    };
    dx := (@mx - cx)->As(Float);
    dy := (@my - oy)->As(Float);
    d := (dx * dx + dy * dy)->Sqrt();
    lx := 0;
    ly := 0;
    if(d > 1.0 & <>@kbd) {
      lx := (dx / d * 2.0)->As(Int);
      ly := (dy / d * 2.0)->As(Int);
    };
    each(side : 2) {
      ex := cx - rad / 3;
      if(side = 1) {
        ex := cx + rad / 3;
      };
      if(blink) {
        @r->ThickLineColor(ex - 4, oy, ex + 4, oy, 2, Color->New(30, 30, 30, 255));
      }
      else {
        @r->FilledEllipseColor(ex, oy, 5, 6, Color->New(255, 255, 255, 255));
        @r->AAEllipseColor(ex, oy, 5, 6, Color->New(40, 40, 40, 255));
        @r->FilledCircleColor(ex + lx, oy + ly, 2, Color->New(20, 20, 20, 255));
      };
    };
  }

  # a puff of smoke and a comic word wherever a captured piece has just gone
  # a puff of smoke and a word wherever a captured piece has just gone; a chain
  # of jumps counts up (Double! Triple! ...) with a bigger shake each time
  method : PoofNewlyCaptured(removed : Int) ~ Nil {
    fresh := removed and (@poofed xor 0x7FFFFFFFFFFFFFFF);
    if(fresh = 0) {
      return;
    };
    @poofed := @poofed or removed;
    if(<>Fx()) {
      return;
    };
    words := CkFxTable->CaptureWords();
    combos := CkFxTable->ComboWords();
    each(sq : 64) {
      if((fresh and (1 << sq)) <> 0) {
        side := 1 - @anim_side;
        red := 240;
        green := 90;
        blue := 80;
        if(side = 1) {
          red := 235;
          green := 230;
          blue := 215;
        };
        @combo += 1;
        PlaySound(2);
        @fx->Poof(CenterX(sq), CenterY(sq), red, green, blue);
        if(@combo >= 2) {
          w := @combo - 2;
          if(w >= combos->Size()) {
            w := combos->Size() - 1;
          };
          @pop->Add(combos[w], CenterX(sq), CenterY(sq) - 26, 3 + Int->Min(@combo - 2, 1), 255, 150 - w * 25, 70);
          @fx->Sparkle(CenterX(sq), CenterY(sq), 8 * @combo, 255, 200, 80);
          @shake := 3 + 2 * @combo;
        }
        else {
          w := (@game->Entries() * 7 + sq) % words->Size();
          @pop->Add(words[w], CenterX(sq), CenterY(sq) - 24, 3, 255, 235, 120);
          @shake := 4;
        };
        if(@settings->Shake()) {
          @shake_until := @now + 200;
        }
        else {
          @shake_until := 0;
        };
      };
    };
  }



  # the squares of captured pieces the moving piece has already passed over
  method : CapturedSoFar(progress : Float) ~ Int {
    hops := @anim_move->Hops();
    if(hops < 1) {
      return 0;
    };
    gone := 0;
    each(k : hops) {
      a := @anim_move->Landing(k);
      b := @anim_move->Landing(k + 1);
      u := progress * hops->As(Float) - k->As(Float);
      if(u > 0.5) {
        mid := ((a / 8 + b / 8) / 2) * 8 + (a % 8 + b % 8) / 2;
        gone := gone or (1 << mid);
      };
    };
    return gone;
  }

  method : DrawFlying(progress : Float, rad : Int) ~ Nil {
    set := @settings->PieceSet();
    mv := @anim_move;
    hops := mv->Hops();
    segs := hops;
    if(segs < 1) {
      segs := 1;
    };
    u := progress * segs->As(Float);
    k := u->As(Int);
    if(k >= segs) {
      k := segs - 1;
    };
    v := u - k->As(Float);
    # ease in and out within each hop
    e := v * v * (3.0 - 2.0 * v);
    if(<>Fx()) {
      e := v;
    };
    a := mv->Landing(k);
    b := mv->Landing(k + 1);
    if(hops = 0) {
      a := mv->From();
      b := mv->To();
    };
    x := CenterX(a) + ((CenterX(b) - CenterX(a))->As(Float) * e)->As(Int);
    y := CenterY(a) + ((CenterY(b) - CenterY(a))->As(Float) * e)->As(Int);
    lift := 4;
    sx := 1.0;
    sy := 1.0;
    if(Fx()) {
      s := (e * 3.14159)->Sin();
      lift := (24.0 * s)->As(Int) + 4;
      # squash and stretch: crouch before the jump, stretch in the air
      sy := 1.0 + 0.14 * s;
      sx := 1.0 - 0.09 * s;
      if(v < 0.18) {
        q := 1.0 - v / 0.18;
        sy := sy - 0.2 * q;
        sx := sx + 0.14 * q;
      };
    };
    kind := @anim_pos->At(mv->From());
    side := 0;
    if(kind > 2) {
      side := 1;
    };
    idle := 0;
    if(Fx()) {
      idle := @frame + 1;
    };
    CkDraw->PieceX(@r, set, x, y, rad, side, kind % 2 = 0, sx, sy, lift, 255, 1.0, 2, idle, mv->From());
  }


  method : DrawPanel() ~ Nil {
    set := @settings->PieceSet();
    t := CkDraw->Theme(set);
    human := @ctl->Human();
    level := @settings->Level();
    l := @lay;

    # the opponent: a face that follows the pointer, and its name
    cx := l->X(CkLayout->Card());
    cy := l->Y(CkLayout->Card());
    cw := l->PW(CkLayout->Card());
    ch := l->PH(CkLayout->Card());
    CkDraw->Panel(@r, cx, cy, cw, ch, set);
    ring := ch / 2 - 10;
    if(ring > 41) {
      ring := 41;
    };
    fx := cx + 14 + ring;
    fy := cy + 14 + ring;
    @r->FilledCircleColor(fx, fy, ring, Color->New(t[18], t[19], t[20], 255));
    @r->FilledCircleColor(fx, fy, ring - 3, Color->New(t[15] + 10, t[16] + 10, t[17] + 10, 255));
    CkChar->Face(@r, level, fx, fy + 5, ring * 66 / 100, CurrentMood(), @frame, @mx, @my, Fx());
    name := CkLevels->Name(level);
    if(human = 2) {
      name := "Computer duel";
    };
    tx := fx + ring + 14;
    tw := cx + cw - tx - 10;
    Say(name, tx, cy + 10, tw, 3, 245, 245, 245, 0);
    Say(CkLevels->Tagline(level), tx, cy + 10 + 34, tw, 1, t[12], t[13], t[14], 0);
    by := cy + ch - 34;
    Btn(7, "-", tx, by, 34, 26, false);
    Btn(8, "+", tx + 40, by, 34, 26, false);
    Say("level {$level}", tx + 82, by + 4, tw - 82, 1, t[12], t[13], t[14], 0);

    # speech bubble
    DrawBubble(set);

    # whose turn
    tnx := l->X(CkLayout->Turn());
    tny := l->Y(CkLayout->Turn());
    tnw := l->PW(CkLayout->Turn());
    tnh := l->PH(CkLayout->Turn());
    CkDraw->Panel(@r, tnx, tny, tnw, tnh, set);
    side := @game->Side();
    status := @game->Status();
    line := "";
    if(status = 0) {
      if(human > 1) {
        line := CkDraw->SideName(set, side) + " is thinking...";
      }
      else if(side = human) {
        line := "Your move";
        if(@ctl->JumpIsForced()) {
          line := "Your move: you must jump";
        };
      }
      else {
        dots := (@now / 300) % 4;
        line := "Thinking" + ".........."->SubString(dots);
      };
      if(@anim_on) {
        line := CkDraw->SideName(set, @anim_side) + " moves";
      };
    }
    else {
      line := ResultText(status);
    };
    shown := side;
    if(@anim_on) {
      shown := @anim_side;
    };
    icon := tnh / 2 - 8;
    CkDraw->Piece(@r, set, tnx + 14 + icon, tny + tnh / 2, icon, shown, false, 1.0, 1.0, 0, 255, 1.0);
    Say(line, tnx + 28 + icon * 2, tny + tnh / 2 - 11, tnw - 40 - icon * 2, 2, 245, 245, 245, 0);

    # pieces lost: a tray for each side
    rx := l->X(CkLayout->Trays());
    ry := l->Y(CkLayout->Trays());
    rw := l->PW(CkLayout->Trays());
    rh := l->PH(CkLayout->Trays());
    CkDraw->Panel(@r, rx, ry, rw, rh, set);
    @text->Draw("Captured", rx + 14, ry + 4, 0, t[12], t[13], t[14], 0);
    pip := rh / 2 - 9;
    if(pip > 11) {
      pip := 11;
    };
    each(s : 2) {
      lost := @game->Lost(1 - s);
      base := rx + 14 + s * (rw / 2);
      CkDraw->Piece(@r, set, base + pip, ry + rh - pip - 8, pip, s, false, 1.0, 1.0, 0, 255, 1.0);
      @text->Draw("{$lost}", base + pip * 2 + 8, ry + rh - 8 - pip - 11, 2, 245, 245, 245, 0);
    };

    # the moves so far
    mx := l->X(CkLayout->Moves());
    my := l->Y(CkLayout->Moves());
    mw := l->PW(CkLayout->Moves());
    mh := l->PH(CkLayout->Moves());
    CkDraw->Panel(@r, mx, my, mw, mh, set);
    @text->Draw("Moves", mx + 14, my + 4, 0, t[12], t[13], t[14], 0);
    DrawMoveList(mx + 14, my + 22, mw - 28, (mh - 28) / 20);

    # the buttons: two columns, four rows
    bx := l->X(CkLayout->Buttons());
    byy := l->Y(CkLayout->Buttons());
    bww := l->PW(CkLayout->Buttons());
    bhh := (l->PH(CkLayout->Buttons()) - 18) / 4;
    bw := (bww - 6) / 2;
    Btn(1, "New game", bx, byy, bw, bhh, false);
    Btn(2, "Undo", bx + bw + 6, byy, bw, bhh, false);
    Btn(3, "Hint", bx, byy + (bhh + 6), bw, bhh, false);
    Btn(4, "Flip board", bx + bw + 6, byy + (bhh + 6), bw, bhh, false);
    Btn(9, OnOff("Sound", @settings->Sound()), bx, byy + (bhh + 6) * 2, bw, bhh, false);
    Btn(10, "Volume {$@settings->Volume()}%", bx + bw + 6, byy + (bhh + 6) * 2, bw, bhh, false);
    Btn(5, "Menu", bx, byy + (bhh + 6) * 3, bw, bhh, false);
    Btn(6, "Quit", bx + bw + 6, byy + (bhh + 6) * 3, bw, bhh, false);
  }


  # the opponent's speech bubble, two lines at most
  # the opponent's speech bubble: two lines at most, in its own reserved rectangle
  method : DrawBubble(set : Int) ~ Nil {
    if(@quip = Nil | @now > @quip_until) {
      return;
    };
    l := @lay;
    x := l->X(CkLayout->Bubble());
    y := l->Y(CkLayout->Bubble());
    w := l->PW(CkLayout->Bubble());
    h := l->PH(CkLayout->Bubble());
    chars := (w - 24) / 7;
    lines := @quip->WrapLines(chars);
    n := lines->Size();
    maxl := (h - 10) / 18;
    if(n > maxl) {
      n := maxl;
    };
    @r->RoundedBoxColor(x, y + 6, x + w - 1, y + h - 1, 10, Color->New(250, 248, 240, 245));
    @r->FilledTrigonColor(x + 30, y + 6, x + 52, y + 6, x + 38, y, Color->New(250, 248, 240, 245));
    each(i : n) {
      @text->Draw(lines[i], x + 12, y + 10 + i * 18, 1, 40, 36, 30, 0);
    };
  }


  # the mood the face shows right now
  method : CurrentMood() ~ Int {
    if(@game->IsOver() & @over_seen) {
      status := @game->Status();
      human := @ctl->Human();
      if(human < 2 & (status = 1 | status = 2)) {
        if(status - 1 = human) {
          return CkChar->Sad();
        };
        return CkChar->Happy();
      };
      return CkChar->Idle();
    };
    if(@now < @mood_until) {
      return @mood;
    };
    if(@thinker <> Nil & @now - @think_start > 500) {
      return CkChar->Thinking();
    };
    return CkChar->Idle();
  }

  # the face takes on a mood for a while, and may say something about it
  method : SetMood(mood : Int, millis : Int, speak : Bool) ~ Nil {
    @mood := mood;
    @mood_until := @now + millis;
    if(Fx() | speak) {
      @quip := CkChar->Line(@settings->Level(), mood);
      @quip_until := @now + 4200;
    };
  }


  method : ResultText(status : Int) ~ String {
    human := @ctl->Human();
    if(status = 3) {
      return "Draw: position repeated";
    };
    if(status = 4) {
      return "Draw: 40 moves, no capture";
    };
    winner := status - 1;
    if(human > 1) {
      return CkDraw->SideName(@settings->PieceSet(), winner) + " wins";
    };
    if(winner = human) {
      return "You win!";
    };
    return "You lose";
  }

  # the last twelve lines of the game: "3. c3-d4  b6-a5"
  # the last lines of the game: "3. c3-d4  b6-a5"; show as many as fit (rows)
  method : DrawMoveList(x : Int, y : Int, w : Int, rows : Int) ~ Nil {
    set := @settings->PieceSet();
    t := CkDraw->Theme(set);
    lines := String->New[400];
    n := 0;
    number := 0;
    each(i : @game->Entries()) {
      mv := @game->EntryMove(i);
      if(mv = Nil) {
        lines[n] := @game->EntryText(i);
        n += 1;
      }
      else if(@game->EntrySide(i) = 0 | n = 0 | lines[n - 1] = Nil) {
        number += 1;
        lines[n] := "{$number}. " + @game->EntryText(i);
        n += 1;
      }
      else {
        lines[n - 1]->Append("   ");
        lines[n - 1]->Append(@game->EntryText(i));
      };
      if(n >= 399) {
        break;
      };
    };

    first := n - rows;
    if(first < 0) {
      first := 0;
    };
    chars := w / 7;
    row := 0;
    for(i := first; i < n; i += 1;) {
      if(@settings->Fun() > 0 & lines[i]->StartsWith("*")) {
        @text->Draw(lines[i]->Truncate(chars), x, y + row * 20, 1, t[18], t[19], t[20], 0);
      }
      else {
        @text->Draw(lines[i]->Truncate(chars), x, y + row * 20, 1, 225, 225, 225, 0);
      };
      row += 1;
    };
  }


  # messages over the board: the compulsory-jump reminder, hints, results, events
  method : DrawBanner() ~ Nil {
    set := @settings->PieceSet();
    t := CkDraw->Theme(set);
    mid := BoardLeft() + Size() * 4;

    if(@fun_event <> Nil) {
      DrawEventBanner(mid);
    }
    else if(@msg->Size() > 0 & @now < @msg_until) {
      w := @text->Width(@msg, 2) + 36;
      @r->RoundedBoxColor(mid - w / 2, BoardTop() + 4, mid + w / 2, BoardTop() + 40, 10, Color->New(20, 20, 24, 215));
      @text->Draw(@msg, mid, BoardTop() + 10, 2, 255, 255, 255, 1);
    }
    else if(@ctl->HumanToMove() & @ctl->JumpIsForced() & @ctl->Selection() < 0 & <>@anim_on) {
      msg := "A jump is compulsory";
      w := @text->Width(msg, 2) + 36;
      @r->RoundedBoxColor(mid - w / 2, BoardTop() + 4, mid + w / 2, BoardTop() + 40, 10, Color->New(120, 50, 10, 210));
      @text->Draw(msg, mid, BoardTop() + 10, 2, 255, 220, 160, 1);
    };

    status := @game->Status();
    if(status <> 0 & <>@anim_on & @fun_event = Nil) {
      text := ResultText(status);
      bounce := 0;
      if(Fx()) {
        bounce := (5.0 * ((@now - @over_t0)->As(Float) / 160.0)->Sin())->As(Int);
      };
      top := BoardTop() + 4 * Size() - 54 + bounce;
      @r->RoundedBoxColor(mid - 190, top, mid + 190, top + 108, 18, Color->New(16, 16, 20, 225));
      @r->RoundedRectangleColor(mid - 190, top, mid + 190, top + 108, 18, Color->New(t[18], t[19], t[20], 255));
      @text->Draw(text, mid, top + 18, 3, t[18], t[19], t[20], 1);
      if(Fx() & @ctl->Human() < 2 & status - 1 = @ctl->Human()) {
        Trophy(mid - 130, top + 74);
      };
      @text->Draw("N: new game   Esc: menu", mid, top + 66, 1, 220, 220, 220, 1);
    };

    # sparkles, puffs and pop-up words go on top of everything on the board
    if(Fx()) {
      @fx->Draw(@r);
      @pop->Draw(@text);
      if(@flash > 0) {
        @r->BoxColor(0, 0, Width(), Height(), Color->New(255, 255, 255, @flash));
      };
    };
  }


  method : DrawEventBanner(mid : Int) ~ Nil {
    ev := @fun_event;
    text := ev->Text();
    w := @text->Width(text, 2) + 50;
    y := BoardTop() + 4;
    @r->RoundedBoxColor(mid - w / 2, y, mid + w / 2, y + 44, 12, Color->New(60, 20, 90, 230));
    @r->RoundedRectangleColor(mid - w / 2, y, mid + w / 2, y + 44, 12, Color->New(255, 210, 90, 255));
    @text->Draw(text, mid, y + 11, 2, 255, 240, 200, 1);

    sq := ev->Square();
    sr := CkController->ScreenRow(sq, @ctl->Flipped());
    sc := CkController->ScreenCol(sq, @ctl->Flipped());
    if(<>@fun_applied) {
      # announced: the square it will happen on pulses
      pulse := 120 + (100.0 * ((@now - @fun_t0)->As(Float) / 90.0)->Sin())->As(Int);
      CkDraw->Outline(@r, BoardLeft(), BoardTop(), Size(), sr, sc, 4, 255, 215, 90, pulse);
    }
    else {
      DrawEventFx(ev, @now - @fun_t0);
    };
  }

  # what the event looks like, in the second after it happens
  method : DrawEventFx(ev : CkEvent, t : Int) ~ Nil {
    if(<>Fx()) {
      return;
    };
    sq := ev->Square();
    cx := CenterX(sq);
    cy := CenterY(sq);
    kind := ev->Kind();
    if(kind = 1) {
      # a jagged bolt from the top of the board
      if(t < 350) {
        x := cx + 14;
        y := BoardTop();
        alpha := 255 - t * 255 / 350;
        steps := 7;
        each(i : steps) {
          nx := x - 20 + ((i * 37 + sq) % 41);
          ny := BoardTop() + (cy - BoardTop()) * (i + 1) / steps;
          if(i = steps - 1) {
            nx := cx;
          };
          @r->ThickLineColor(x, y, nx, ny, 6, Color->New(255, 240, 140, alpha / 2));
          @r->ThickLineColor(x, y, nx, ny, 3, Color->New(255, 255, 255, alpha));
          x := nx;
          y := ny;
        };
      };
      # a scorch mark where the piece stood
      mark := 170 - t * 170 / 1000;
      if(mark > 0) {
        @r->FilledEllipseColor(cx, cy + 4, Size() / 3, Size() / 5, Color->New(20, 18, 16, mark));
      };
    }
    else if(kind = 2) {
      # cracks spreading from the square
      reach := t * Size() / 500;
      if(reach > Size() * 3 / 4) {
        reach := Size() * 3 / 4;
      };
      each(i : 6) {
        a := i->As(Float) * 1.05 + 0.3;
        ex := cx + (a->Cos() * reach->As(Float))->As(Int);
        ey := cy + (a->Sin() * reach->As(Float))->As(Int);
        mx := (cx + ex) / 2 + ((i * 7) % 9) - 4;
        my := (cy + ey) / 2 + ((i * 5) % 9) - 4;
        @r->ThickLineColor(cx, cy, mx, my, 3, Color->New(30, 24, 20, 230));
        @r->ThickLineColor(mx, my, ex, ey, 2, Color->New(30, 24, 20, 230));
      };
    };
  }

  # the effects of an event that has just been applied
  method : StartEventFx(ev : CkEvent) ~ Nil {
    if(<>Fx()) {
      return;
    };
    sq := ev->Square();
    cx := CenterX(sq);
    cy := CenterY(sq);
    kind := ev->Kind();
    snd := kind + 6;
    if(kind = 0) {
      snd := 10;
    };
    PlaySound(snd);
    if(kind = 0) {
      @fx->Sparkle(cx, cy, 30, 255, 120, 190);
      @pop->Add("A GIFT!", cx, cy - 50, 3, 255, 150, 210);
    }
    else if(kind = 1) {
      @flash := 220;
      @shake := 6;
      @shake_until := @now + 400;
      @fx->Poof(cx, cy, 255, 230, 90);
      @pop->Add("ZAP!", cx, cy - 40, 4, 255, 240, 120);
    }
    else if(kind = 2) {
      @shake := 9;
      @shake_until := @now + 900;
      @fx->Poof(cx, cy, 160, 130, 100);
      @pop->Add("RUMBLE!", cx, cy - 40, 3, 230, 200, 150);
    }
    else {
      dir := 1;
      if(CkController->ScreenCol(sq, @ctl->Flipped()) < 4) {
        dir := -1;
      };
      @fx->Gust(cx, cy, dir);
      @pop->Add("WHOOOSH!", cx, cy - 40, 3, 210, 235, 255);
    };
  }


  # one frame of the effects: particles move, words float, the screen shakes
  method : StepFx() ~ Nil {
    if(<>Fx()) {
      @shake_x := 0;
      @shake_y := 0;
      return;
    };
    @fx->Update();
    @pop->Update();
    if(<>@settings->Shake()) {
      @shake := 0;
    };
    if(@flash > 0) {
      @flash := @flash - 14;
      if(@flash < 0) {
        @flash := 0;
      };
    };
    if(@now < @shake_until & @shake > 0) {
      left := (@shake_until - @now)->As(Float) / 400.0;
      if(left > 1.0) {
        left := 1.0;
      };
      mag := @shake->As(Float) * left;
      @shake_x := (mag * (@now->As(Float) / 17.0)->Sin())->As(Int);
      @shake_y := (mag * (@now->As(Float) / 13.0)->Cos())->As(Int);
    }
    else {
      @shake_x := 0;
      @shake_y := 0;
    };
    # a thinking face now and then sweats
    if(@screen = 1 & CurrentMood() = CkChar->Thinking() & @frame % 38 = 0) {
      @fx->Drop(704 + 52 + 22, 82 - 14);
    };
  }

  # are the lively effects on? Animations must be on and reduced motion off.
  method : Fx() ~ Bool {
    return @settings->Lively();
  }

  # the game has just ended: confetti for a win, a sigh for a loss
  method : GameEnded() ~ Nil {
    status := @game->Status();
    human := @ctl->Human();
    mid := BoardLeft() + Size() * 4;
    if(human < 2 & (status = 1 | status = 2)) {
      if(status - 1 = human) {
        PlaySound(5);
        if(Fx()) {
          @fx->Confetti(Width(), 160);
          @pop->Add("YOU WIN!", mid, BoardTop() + 120, 4, 255, 230, 90);
        };
        SetMood(CkChar->Sad(), 600000, true);
      }
      else {
        PlaySound(6);
        if(Fx()) {
          @pop->Add("Oh no...", mid, BoardTop() + 120, 4, 180, 200, 255);
        };
        SetMood(CkChar->Happy(), 600000, true);
      };
    }
    else if(status = 3 | status = 4) {
      @quip := "A draw! Shall we go again?";
      @quip_until := @now + 6000;
    };
  }


  # export the music so far as a Standard MIDI File in the home folder
  method : SaveSong() ~ Nil {
    path := Runtime->GetUserDir() + Directory->GetSlash() + "checkers_song.mid";
    if(@audio <> Nil & @audio->ExportMidi(path)) {
      @msg := "Song saved: " + path;
    }
    else {
      @msg := "Nothing to save yet: play a few bars first";
    };
    @msg_until := @now + 4000;
  }

  # play sound effect number kind (see CkSfx->Make), if there is sound
  method : PlaySound(kind : Int) ~ Nil {
    if(@audio <> Nil & @settings->Sound()) {
      @audio->Play(kind);
    };
  }

  # Once a frame: tell the music how the game feels, and keep the sound card fed.
  # Calm (major, slow) when the position is quiet and even; tense (minor, faster)
  # when a jump is waiting or one side is well ahead; a fanfare for a win and a
  # sad tune for a loss.
  method : UpdateSound() ~ Nil {
    if(@audio = Nil) {
      return;
    };
    @audio->SetVolume(@settings->Volume());
    @audio->SetStyle(@settings->MusicStyle());
    @audio->SetMusic(@settings->Sound());
    mood := 0;
    intensity := 0.2;
    if(@screen = 1) {
      lost := @game->Lost(0) + @game->Lost(1);
      intensity := 0.25 + 0.025 * lost->As(Float);
      diff := CkBits->Pop(@game->Pos()->Pieces(0)) - CkBits->Pop(@game->Pos()->Pieces(1));
      if(diff < 0) {
        diff := 0 - diff;
      };
      if(@game->Legal()->Count() > 0 & @game->Legal()->Caps(0) <> 0) {
        mood := 1;
        intensity += 0.3;
      }
      else if(diff >= 2) {
        mood := 1;
      };
      status := @game->Status();
      human := @ctl->Human();
      if(status = 1 | status = 2) {
        mood := 2;
        intensity := 0.8;
        if(human < 2 & status - 1 <> human) {
          mood := 3;
          intensity := 0.2;
        };
      };
    };
    if(intensity > 1.0) {
      intensity := 1.0;
    };
    @audio->SetMood(mood, intensity);
    @audio->Pump();
  }

  # how long hop k of a move with n hops takes: a quick 200 ms each, but the last
  # jump of a chain is shown in slow motion (360 ms)
  method : HopMs(k : Int, n : Int) ~ Int {
    if(n >= 2 & k = n - 1) {
      return 360;
    };
    if(n = 0) {
      return 280;
    };
    return 200;
  }


  method : AnimTotal(n : Int) ~ Int {
    segs := n;
    if(segs < 1) {
      segs := 1;
    };
    total := 0;
    each(k : segs) {
      total += HopMs(k, n);
    };
    return total + 60;
  }


  # the animation clock turned into "how far through the hops": the whole number
  # is the hop, the fraction how far along it, divided by the number of hops so
  # that 1.0 is the end. This is what makes the last jump of a chain slow.
  method : AnimProgress(elapsed : Int) ~ Float {
    n := @anim_move->Hops();
    segs := n;
    if(segs < 1) {
      segs := 1;
    };
    left := elapsed;
    each(k : segs) {
      d := HopMs(k, n);
      if(left < d) {
        return (k->As(Float) + left->As(Float) / d->As(Float)) / segs->As(Float);
      };
      left -= d;
    };
    return 1.0;
  }


  # Idle antics: when the person has not done anything for a while, one piece
  # does something silly. Seeded by the frame counter, never blocks input: it is
  # only an offset applied while drawing.
  method : AnticStep() ~ Nil {
    if(<>Fx() | @screen <> 1 | @anim_on | @fun_event <> Nil | @game->IsOver()) {
      @antic_sq := -1;
      return;
    };
    quiet := @now - @last_input;
    if(@antic_sq >= 0) {
      if(@now - @antic_t0 > 1500 | @now - @last_input < 500) {
        @antic_sq := -1;
        @antic_next := @now + 5000;
      };
      return;
    };
    if(quiet > 6000 & @now > @antic_next) {
      rand := CkRand->New(@frame * 31 + @game->Entries());
      pos := @game->Pos();
      count := 0;
      each(sq : 64) {
        if(pos->At(sq) > 0) {
          count += 1;
        };
      };
      if(count > 0) {
        pick := rand->NextInt(count);
        each(sq : 64) {
          if(pos->At(sq) > 0) {
            if(pick = 0) {
              @antic_sq := sq;
            };
            pick -= 1;
          };
        };
        @antic_kind := rand->NextInt(4);
        @antic_t0 := @now;
        words := CkFxTable->AnticWords();
        @pop->Add(words[@antic_kind], CenterX(@antic_sq), CenterY(@antic_sq) - 34, 2, 235, 235, 255);
      };
      @antic_next := @now + 7000;
    };
  }


  # a golden cup that bounces on the board when the person wins
  method : Trophy(mid : Int, top : Int) ~ Nil {
    age := (@now - @over_t0)->As(Float);
    bounce := (18.0 * (age / 220.0)->Sin()->Abs() * (-1.0 * age / 1800.0)->Exp())->As(Int);
    y := top - bounce;
    gold := Color->New(255, 205, 50, 255);
    dark := Color->New(150, 100, 10, 255);
    vx := [mid - 40, mid + 40, mid + 26, mid - 26];
    vy := [y - 56, y - 56, y - 14, y - 14];
    @r->FilledPolygonColor(vx, vy, gold);
    @r->AAPolygonColor(vx, vy, dark);
    @r->ThickLineColor(mid - 40, y - 48, mid - 54, y - 40, 4, gold);
    @r->ThickLineColor(mid + 40, y - 48, mid + 54, y - 40, 4, gold);
    @r->BoxColor(mid - 6, y - 14, mid + 6, y - 2, gold);
    @r->BoxColor(mid - 24, y - 2, mid + 24, y + 8, dark);
    @r->FilledCircleColor(mid - 12, y - 40, 5, Color->New(255, 250, 200, 200));
  }


  # clicking the opponent's face: it says something silly and the hat bounces
  method : EasterEgg() ~ Nil {
    @egg += 1;
    lines := CkFxTable->EggLines();
    @quip := lines[@egg % lines->Size()];
    @quip_until := @now + 3500;
    @mood := CkChar->Surprised();
    @mood_until := @now + 1500;
    if(Fx()) {
      @fx->Sparkle(704 + 52, 76, 14, 255, 230, 120);
      @pop->Add("Hey!", 704 + 120, 60, 2, 255, 240, 160);
    };
    PlaySound(1);
  }

}
