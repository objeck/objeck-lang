#~
# Checkers: everything the window does that is not drawing. Mouse clicks and key
# presses are turned into intents here (select a piece, move it, change a
# setting) with no SDL involved, so the regression test can exercise exactly the
# logic the window uses. Needs checkers_engine.obs, checkers_game.obs and the
# json library.
~#

use Data.JSON;
use System.IO.Filesystem;

# The choices that are remembered between runs, in a small JSON file in the
# home folder (.checkers.json).
class CkSettings {
  @piece_set : Int;     # 0 classic, 1 glossy, 2 engraved, 3 modern, 4 critters, 5 monsters, 6 snacks, 7 space
  @level : Int;         # 1 .. 10
  @human : Int;         # 0 plays Red, 1 plays White, 2 watches the computer play itself
  @flip : Bool;         # board turned around
  @fun : Int;           # fun mode: 0 off, 1 levels 1-3, 2 every level
  @anim : Bool;         # animations on
  @reduced : Bool;      # reduced motion: no shaking, bouncing or flashing
  @sound : Bool;
  @volume : Int;        # 0 .. 100
  @music : Int;         # music style: 0 hip-hop, 1 modern beats, 2 off
  @shake : Bool;        # screen shake on
  @view : Int;          # camera: 0 flat, 1 slanted (see CkView)

  New() {
    @piece_set := 0;
    @level := 4;
    @human := 0;
    @flip := false;
    @fun := 0;
    @anim := true;
    @reduced := false;
    @sound := true;
    @volume := 70;
    @music := 0;
    @shake := true;
    @view := 1;
  }

  function : SetNames() ~ String[] {
    return ["Classic", "Glossy", "Engraved", "Modern", "Critters", "Monsters", "Snacks", "Space"];
  }

  method : public : PieceSet() ~ Int {
    return @piece_set;
  }

  method : public : SetPieceSet(v : Int) ~ Nil {
    @piece_set := Clamp(v, 0, 7);
  }

  method : public : Level() ~ Int {
    return @level;
  }

  method : public : SetLevel(v : Int) ~ Nil {
    @level := Clamp(v, 1, 10);
  }

  method : public : Human() ~ Int {
    return @human;
  }

  method : public : SetHuman(v : Int) ~ Nil {
    @human := Clamp(v, 0, 2);
  }

  method : public : Flip() ~ Bool {
    return @flip;
  }

  method : public : SetFlip(v : Bool) ~ Nil {
    @flip := v;
  }

  method : public : Fun() ~ Int {
    return @fun;
  }

  method : public : SetFun(v : Int) ~ Nil {
    @fun := Clamp(v, 0, 2);
  }

  method : public : Anim() ~ Bool {
    return @anim;
  }

  method : public : SetAnim(v : Bool) ~ Nil {
    @anim := v;
  }

  method : public : Reduced() ~ Bool {
    return @reduced;
  }

  method : public : SetReduced(v : Bool) ~ Nil {
    @reduced := v;
  }

  method : public : Sound() ~ Bool {
    return @sound;
  }

  method : public : SetSound(v : Bool) ~ Nil {
    @sound := v;
  }

  method : public : Volume() ~ Int {
    return @volume;
  }

  method : public : View() ~ Int {
    return @view;
  }

  method : public : SetView(v : Int) ~ Nil {
    @view := Clamp(v, 0, 1);
  }

  method : public : Shake() ~ Bool {
    return @shake;
  }

  method : public : SetShake(v : Bool) ~ Nil {
    @shake := v;
  }

  method : public : MusicStyle() ~ Int {
    return @music;
  }

  method : public : SetMusicStyle(v : Int) ~ Nil {
    @music := Clamp(v, 0, 2);
  }

  method : public : SetVolume(v : Int) ~ Nil {
    @volume := Clamp(v, 0, 100);
  }

  function : Clamp(v : Int, lo : Int, hi : Int) ~ Int {
    if(v < lo) {
      return lo;
    };
    if(v > hi) {
      return hi;
    };
    return v;
  }

  # is fun mode in force at this level? Mode 1 is the "early levels" reading of
  # "early on": only levels 1 to 3. Mode 2 applies at every level.
  method : public : FunActive(level : Int) ~ Bool {
    if(@fun = 2) {
      return true;
    };
    return @fun = 1 & level <= 3;
  }

  # animations are used unless they are off or reduced motion is asked for
  method : public : Lively() ~ Bool {
    return @anim & <>@reduced;
  }

  method : public : ToJson() ~ String {
    text := "{\n";
    text += "  \"piece_set\": {$@piece_set},\n";
    text += "  \"level\": {$@level},\n";
    text += "  \"human\": {$@human},\n";
    text += "  \"flip\": {$@flip},\n";
    text += "  \"fun\": {$@fun},\n";
    text += "  \"anim\": {$@anim},\n";
    text += "  \"reduced_motion\": {$@reduced},\n";
    text += "  \"sound\": {$@sound},\n";
    text += "  \"volume\": {$@volume},\n";
    text += "  \"music_style\": {$@music},\n";
    text += "  \"shake\": {$@shake},\n";
    text += "  \"view\": {$@view}\n";
    text += "}\n";
    return text;
  }

  # read the JSON written by ToJson; a missing or damaged field keeps its
  # current value, and anything out of range is clamped
  method : public : FromJson(text : String) ~ Bool {
    if(text = Nil) {
      return false;
    };
    parser := JsonParser->New(text);
    if(<>parser->Parse() | parser->GetRoot() = Nil) {
      return false;
    };
    root := parser->GetRoot();
    if(root->GetType() <> JsonElement->JsonType->OBJECT) {
      return false;
    };
    SetPieceSet(ReadInt(root, "piece_set", @piece_set));
    SetLevel(ReadInt(root, "level", @level));
    SetHuman(ReadInt(root, "human", @human));
    SetFun(ReadInt(root, "fun", @fun));
    SetVolume(ReadInt(root, "volume", @volume));
    SetMusicStyle(ReadInt(root, "music_style", @music));
    SetView(ReadInt(root, "view", @view));
    @flip := ReadBool(root, "flip", @flip);
    @shake := ReadBool(root, "shake", @shake);
    @anim := ReadBool(root, "anim", @anim);
    @reduced := ReadBool(root, "reduced_motion", @reduced);
    @sound := ReadBool(root, "sound", @sound);
    return true;
  }

  function : ReadInt(root : JsonElement, name : String, fallback : Int) ~ Int {
    v := root->Get(name);
    if(v <> Nil & v->GetType() = JsonElement->JsonType->NUMBER) {
      return v->GetInt();
    };
    return fallback;
  }

  function : ReadBool(root : JsonElement, name : String, fallback : Bool) ~ Bool {
    v := root->Get(name);
    if(v <> Nil & v->GetType() = JsonElement->JsonType->TRUE) {
      return true;
    };
    if(v <> Nil & v->GetType() = JsonElement->JsonType->FALSE) {
      return false;
    };
    return fallback;
  }

  method : public : Load(path : String) ~ Bool {
    return FromJson(FileReader->ReadFile(path));
  }

  method : public : Save(path : String) ~ Bool {
    return FileWriter->WriteFile(path, ToJson());
  }
}

# The ten levels as people see them: a name, and one line saying how it plays.
class CkLevels {
  function : Name(level : Int) ~ String {
    names := ["Dozy Dave", "Clumsy Clara", "Wobbly Walt", "Careful Kit", "Sly Sam",
      "Professor Pawn", "Captain Crown", "Madame Minimax", "Deep Thinker", "Grandmaster Gizmo"];
    return names[Index(level) - 1];
  }

  function : Index(level : Int) ~ Int {
    if(level < 1) {
      return 1;
    };
    if(level > 10) {
      return 10;
    };
    return level;
  }

  function : Tagline(level : Int) ~ String {
    lines := ["random legal moves", "greedy, 1 ply ahead", "2 plies ahead",
      "Minimax, 3 plies", "Minimax, 4 plies", "Minimax, 6 plies", "alpha-beta, 7 plies",
      "alpha-beta, 9 plies", "learned eval, deep", "learned eval, deepest"];
    return lines[Index(level) - 1];
  }
}

# What a click or a key press means, and the state the window needs to show it:
# which piece is picked up, where it may go, which pieces must move.
class CkController {
  @game : CkGame;
  @human : Int;        # 0 or 1, or 2 when watching
  @flip : Bool;        # the screen shows White at the bottom
  @selected : Int;     # picked-up square, or -1
  @cursor : Int;       # keyboard cursor square (screen position is derived)

  # what ClickSquare and friends answer
  function : None() ~ Int {
    return 0;
  }

  function : Selected() ~ Int {
    return 1;
  }

  function : Deselected() ~ Int {
    return 2;
  }

  function : Moved() ~ Int {
    return 3;
  }

  function : MustCapture() ~ Int {
    return 4;
  }

  New(game : CkGame, human : Int, flip : Bool) {
    @game := game;
    @human := human;
    @flip := flip;
    @selected := -1;
    @cursor := 5 * 8 + 2;
  }

  method : public : Game() ~ CkGame {
    return @game;
  }

  method : public : Human() ~ Int {
    return @human;
  }

  method : public : SetHuman(human : Int) ~ Nil {
    @human := human;
    @selected := -1;
  }

  method : public : Flipped() ~ Bool {
    return @flip;
  }

  method : public : SetFlipped(flip : Bool) ~ Nil {
    @flip := flip;
  }

  method : public : Selection() ~ Int {
    return @selected;
  }

  method : public : Clear() ~ Nil {
    @selected := -1;
  }

  method : public : Cursor() ~ Int {
    return @cursor;
  }

  # may the person move right now?
  method : public : HumanToMove() ~ Bool {
    return @human < 2 & @game->Side() = @human & <>@game->IsOver();
  }

  # the pieces of the side to move that have a legal move: when a jump is
  # compulsory these are exactly the pieces that can jump
  method : public : Movable() ~ Int {
    mask := 0;
    legal := @game->Legal();
    each(i : legal->Count()) {
      mask := mask or (1 << legal->From(i));
    };
    return mask;
  }

  # where the piece on sq may land
  method : public : Destinations(sq : Int) ~ Int {
    mask := 0;
    legal := @game->Legal();
    each(i : legal->Count()) {
      if(legal->From(i) = sq) {
        mask := mask or (1 << legal->To(i));
      };
    };
    return mask;
  }

  # is the next move for the side to move a compulsory jump?
  method : public : JumpIsForced() ~ Bool {
    legal := @game->Legal();
    return legal->Count() > 0 & legal->Caps(0) <> 0;
  }

  # The person clicked square sq. Answers one of None, Selected, Deselected,
  # Moved (the move was played) or MustCapture (the piece cannot move because a
  # jump is compulsory elsewhere).
  method : public : ClickSquare(sq : Int) ~ Int {
    if(sq < 0 | sq > 63 | <>HumanToMove()) {
      return None();
    };

    movable := Movable();
    bit := 1 << sq;
    if(@selected >= 0) {
      if(sq = @selected) {
        @selected := -1;
        return Deselected();
      };
      if((Destinations(@selected) and bit) <> 0) {
        idx := @game->Legal()->Find(@selected, sq);
        @selected := -1;
        if(@game->Play(idx)) {
          return Moved();
        };
        return None();
      };
      if((movable and bit) <> 0) {
        @selected := sq;
        return Selected();
      };
      @selected := -1;
      return Deselected();
    };

    if((movable and bit) <> 0) {
      @selected := sq;
      return Selected();
    };
    if(((@game->Pos()->Pieces(@human) and bit) <> 0) & JumpIsForced()) {
      return MustCapture();
    };
    return None();
  }

  # ---- the screen <-> board mapping ----

  # the board square under pixel (x, y) of a board whose top-left corner is
  # (left, top) with squares of the given size, or -1 outside the board
  function : SquareAt(x : Int, y : Int, left : Int, top : Int, size : Int, flip : Bool) ~ Int {
    if(x < left | y < top) {
      return -1;
    };
    sc := (x - left) / size;
    sr := (y - top) / size;
    if(sc > 7 | sr > 7) {
      return -1;
    };
    return ScreenToSquare(sr, sc, flip);
  }

  function : ScreenToSquare(sr : Int, sc : Int, flip : Bool) ~ Int {
    if(flip) {
      return (7 - sr) * 8 + (7 - sc);
    };
    return sr * 8 + sc;
  }

  # the screen row (0 = top) and column of a board square
  function : ScreenRow(sq : Int, flip : Bool) ~ Int {
    if(flip) {
      return 7 - sq / 8;
    };
    return sq / 8;
  }

  function : ScreenCol(sq : Int, flip : Bool) ~ Int {
    if(flip) {
      return 7 - sq % 8;
    };
    return sq % 8;
  }

  # ---- keyboard ----

  # move the keyboard cursor by rows and columns of the SCREEN, staying on the board
  method : public : MoveCursor(drow : Int, dcol : Int) ~ Nil {
    sr := ScreenRow(@cursor, @flip) + drow;
    sc := ScreenCol(@cursor, @flip) + dcol;
    if(sr < 0) {
      sr := 0;
    };
    if(sr > 7) {
      sr := 7;
    };
    if(sc < 0) {
      sc := 0;
    };
    if(sc > 7) {
      sc := 7;
    };
    @cursor := ScreenToSquare(sr, sc, @flip);
  }

  method : public : SetCursor(sq : Int) ~ Nil {
    if(sq >= 0 & sq < 64) {
      @cursor := sq;
    };
  }

  # Enter or Space: the same as clicking the cursor square
  method : public : Activate() ~ Int {
    return ClickSquare(@cursor);
  }
}

# A computer player thinking on its own thread, so the window keeps drawing
# (and the pieces keep wobbling) while a deep search runs. Start it with
# Execute(Nil); poll IsDone; then read Move.
class CkThinker from System.Concurrency.Thread {
  @player : CkPlayer;
  @pos : CkPos;
  @keys : Int[];
  @kn : Int;
  @move : Int;
  @done : Bool;
  @tag : Int;

  New(player : CkPlayer, pos : CkPos, keys : Int[], kn : Int, tag : Int) {
    Parent("checkers thinker");
    @player := player;
    @pos := pos;
    @keys := keys;
    @kn := kn;
    @tag := tag;
    @move := -1;
  }

  method : public : Run(param : System.Base) ~ Nil {
    @move := @player->ChoosePos(@pos, @keys, @kn);
    @done := true;
  }

  method : public : IsDone() ~ Bool {
    return @done;
  }

  # the number of the chosen move in the position's legal list
  method : public : Move() ~ Int {
    return @move;
  }

  # whatever the caller stamped on the request (which game it belonged to)
  method : public : Tag() ~ Int {
    return @tag;
  }

  method : public : Nodes() ~ Int {
    return @player->Nodes();
  }
}

# Where everything goes, worked out in ONE place from the window size so that no two
# panels can overlap (the old window hard-coded each position and the speech bubble
# ended up on top of the "your move" panel). Every rectangle is x, y, width, height.
# This class has no graphics in it, so the regression test checks that, at several
# window sizes, no two panels overlap and all of them stay inside the window.
class CkLayout {
  @w : Int;
  @h : Int;
  @sq : Int;           # side of one board square in pixels
  @bx : Int;           # top-left corner of the board squares
  @by : Int;
  @rects : Int[];      # frame, card, bubble, turn, trays, moves, buttons: 4 numbers each

  # the parts of the game screen
  function : Frame() ~ Int {
    return 0;
  }

  function : Card() ~ Int {
    return 1;
  }

  function : Bubble() ~ Int {
    return 2;
  }

  function : Turn() ~ Int {
    return 3;
  }

  function : Trays() ~ Int {
    return 4;
  }

  function : Moves() ~ Int {
    return 5;
  }

  function : Buttons() ~ Int {
    return 6;
  }

  function : Parts() ~ Int {
    return 7;
  }

  # the smallest window the layout is designed for
  function : MinWidth() ~ Int {
    return 800;
  }

  function : MinHeight() ~ Int {
    return 560;
  }

  New(w : Int, h : Int) {
    if(w < MinWidth()) {
      w := MinWidth();
    };
    if(h < MinHeight()) {
      h := MinHeight();
    };
    @w := w;
    @h := h;
    @rects := Int->New[28];

    # the board takes the height it can, but leaves 290 pixels for the panel column
    margin := 14;
    pad := 24;
    sq := (h - 2 * margin - 2 * pad) / 8;
    by_width := (w - 290 - 3 * margin - 2 * pad) / 8;
    if(by_width < sq) {
      sq := by_width;
    };
    @sq := sq;
    side := 8 * sq + 2 * pad;
    fy := (h - side) / 2;
    Set(Frame(), margin, fy, side, side);
    @bx := margin + pad;
    @by := fy + pad;

    # the panel column fills the rest of the width
    px := margin + side + margin;
    pw := w - px - margin;
    gap := 8;
    card := 112;
    bubble := 52;
    turn := 54;
    trays := 54;
    rows := 4;
    bh := 36;
    if(h < 640) {
      card := 92;
      bubble := 46;
      turn := 44;
      trays := 46;
      bh := 30;
    };
    buttons := rows * bh + (rows - 1) * 6;
    y := margin;
    Set(Card(), px, y, pw, card);
    y += card + gap;
    Set(Bubble(), px, y, pw, bubble);
    y += bubble + gap;
    Set(Turn(), px, y, pw, turn);
    y += turn + gap;
    Set(Trays(), px, y, pw, trays);
    y += trays + gap;
    moves := h - margin - buttons - gap - y;
    Set(Moves(), px, y, pw, moves);
    y += moves + gap;
    Set(Buttons(), px, y, pw, buttons);
  }

  method : Set(part : Int, x : Int, y : Int, w : Int, h : Int) ~ Nil {
    @rects[part * 4] := x;
    @rects[part * 4 + 1] := y;
    @rects[part * 4 + 2] := w;
    @rects[part * 4 + 3] := h;
  }

  method : public : W() ~ Int {
    return @w;
  }

  method : public : H() ~ Int {
    return @h;
  }

  method : public : Square() ~ Int {
    return @sq;
  }

  method : public : BoardLeft() ~ Int {
    return @bx;
  }

  method : public : BoardTop() ~ Int {
    return @by;
  }

  method : public : X(part : Int) ~ Int {
    return @rects[part * 4];
  }

  method : public : Y(part : Int) ~ Int {
    return @rects[part * 4 + 1];
  }

  method : public : PW(part : Int) ~ Int {
    return @rects[part * 4 + 2];
  }

  method : public : PH(part : Int) ~ Int {
    return @rects[part * 4 + 3];
  }

  # do two rectangles (x, y, w, h each, at offsets a and b of list) overlap?
  function : Overlap(list : Int[], a : Int, b : Int) ~ Bool {
    return list[a] < list[b] + list[b + 2] & list[b] < list[a] + list[a + 2] &
      list[a + 1] < list[b + 1] + list[b + 3] & list[b + 1] < list[a + 1] + list[a + 3];
  }

  # how many pairs of rectangles in list (4 numbers each) overlap
  function : CountOverlaps(list : Int[]) ~ Int {
    n := list->Size() / 4;
    found := 0;
    each(i : n) {
      for(j := i + 1; j < n; j += 1;) {
        if(Overlap(list, i * 4, j * 4)) {
          found += 1;
        };
      };
    };
    return found;
  }

  # how many rectangles in list are not entirely inside a w x h window, or too small to use
  function : CountOutside(list : Int[], w : Int, h : Int) ~ Int {
    n := list->Size() / 4;
    found := 0;
    each(i : n) {
      at := i * 4;
      if(list[at] < 0 | list[at + 1] < 0 | list[at] + list[at + 2] > w | list[at + 1] + list[at + 3] > h |
          list[at + 2] < 8 | list[at + 3] < 8) {
        found += 1;
      };
    };
    return found;
  }

  # every part of the game screen as one list
  method : public : All() ~ Int[] {
    return @rects;
  }
}

# The menu screen's rectangles: a grid of piece-set cards and the level buttons on the
# left, a column of setting rows on the right, then Play and Quit. Like CkLayout it is
# plain arithmetic from the window size, and the regression test checks that nothing
# overlaps and everything fits at several window sizes.
class CkMenuLayout {
  @w : Int;
  @h : Int;
  @cards : Int;
  @rows : Int;
  @all : Int[];        # every rectangle: cards, levels, rows, play, quit, level info
  @cols : Int;
  @card_w : Int;
  @card_h : Int;
  @gx : Int;           # left edge of the card grid
  @gy : Int;
  @gap : Int;
  @lvl_y : Int;
  @lvl_w : Int;
  @lvl_h : Int;
  @row_x : Int;
  @row_y : Int;
  @row_w : Int;
  @row_h : Int;
  @row_gap : Int;
  @play_x : Int;
  @play_y : Int;
  @play_w : Int;
  @play_h : Int;
  @info_y : Int;

  New(w : Int, h : Int, cards : Int, rows : Int) {
    if(w < CkLayout->MinWidth()) {
      w := CkLayout->MinWidth();
    };
    if(h < CkLayout->MinHeight()) {
      h := CkLayout->MinHeight();
    };
    @w := w;
    @h := h;
    @cards := cards;
    @rows := rows;
    margin := 18;
    @gap := 10;
    compact := h < 640;
    top := 92;
    lab := 24;
    if(compact) {
      top := 66;
      lab := 20;
    };

    # the right column of settings is a third of the window, at least 300 wide
    right_w := w * 36 / 100;
    if(right_w < 300) {
      right_w := 300;
    };
    left_w := w - right_w - 3 * margin;
    @row_x := margin + left_w + margin;
    @row_w := right_w;
    @gx := margin;
    @gy := top + lab;

    # cards: four to a row
    @cols := 4;
    grid_rows := (cards + @cols - 1) / @cols;
    @card_w := (left_w - (@cols - 1) * @gap) / @cols;
    @card_h := @card_w * 70 / 100 + 20;
    if(compact) {
      @card_h := @card_w * 56 / 100 + 18;
    };

    # levels sit under the cards
    grid_h := grid_rows * @card_h + (grid_rows - 1) * @gap;
    ly := @gy + grid_h + 16;
    @lvl_y := ly + lab;
    @lvl_h := 38;
    if(compact) {
      @lvl_h := 30;
    };
    @lvl_w := (left_w - 9 * 6) / 10;
    @info_y := @lvl_y + @lvl_h + 8;

    # settings rows fill the right column down to the Play button
    @row_y := top + lab;
    @play_h := 52;
    if(compact) {
      @play_h := 42;
    };
    @play_y := h - margin - @play_h - 18;
    @play_w := 300;
    @play_x := (w - @play_w) / 2;
    avail := @play_y - 14 - @row_y;
    @row_gap := 6;
    @row_h := (avail - (rows - 1) * @row_gap) / rows;
    if(@row_h > 40) {
      @row_h := 40;
    };
    BuildAll();
  }

  method : BuildAll() ~ Nil {
    n := @cards + 10 + @rows + 3;
    @all := Int->New[n * 4];
    at := 0;
    each(i : @cards) {
      Put(at, CardX(i), CardY(i), @card_w, @card_h);
      at += 4;
    };
    each(i : 10) {
      Put(at, LevelX(i), @lvl_y, @lvl_w, @lvl_h);
      at += 4;
    };
    each(i : @rows) {
      Put(at, @row_x, RowY(i), @row_w, @row_h);
      at += 4;
    };
    Put(at, @play_x, @play_y, @play_w, @play_h);
    at += 4;
    # Quit sits at the left of the Play button row
    Put(at, 18, @play_y, 120, @play_h);
    at += 4;
    # the one-line description of the chosen level
    Put(at, @gx, @info_y, @row_x - 36 - @gx, 24);
  }

  method : Put(at : Int, x : Int, y : Int, w : Int, h : Int) ~ Nil {
    @all[at] := x;
    @all[at + 1] := y;
    @all[at + 2] := w;
    @all[at + 3] := h;
  }

  method : public : CardX(i : Int) ~ Int {
    return @gx + (i % @cols) * (@card_w + @gap);
  }

  method : public : CardY(i : Int) ~ Int {
    return @gy + (i / @cols) * (@card_h + @gap);
  }

  method : public : CardW() ~ Int {
    return @card_w;
  }

  method : public : CardH() ~ Int {
    return @card_h;
  }

  method : public : LevelX(i : Int) ~ Int {
    return @gx + i * (@lvl_w + 6);
  }

  method : public : LevelY() ~ Int {
    return @lvl_y;
  }

  method : public : LevelW() ~ Int {
    return @lvl_w;
  }

  method : public : LevelH() ~ Int {
    return @lvl_h;
  }

  method : public : InfoY() ~ Int {
    return @info_y;
  }

  method : public : RowX() ~ Int {
    return @row_x;
  }

  method : public : RowY(i : Int) ~ Int {
    return @row_y + i * (@row_h + @row_gap);
  }

  method : public : RowW() ~ Int {
    return @row_w;
  }

  method : public : RowH() ~ Int {
    return @row_h;
  }

  method : public : PlayX() ~ Int {
    return @play_x;
  }

  method : public : PlayY() ~ Int {
    return @play_y;
  }

  method : public : PlayW() ~ Int {
    return @play_w;
  }

  method : public : PlayH() ~ Int {
    return @play_h;
  }

  method : public : GridY() ~ Int {
    return @gy;
  }

  method : public : GridX() ~ Int {
    return @gx;
  }

  method : public : LabelY(i : Int) ~ Int {
    return 0;
  }

  # y of the "Level" heading, just above the level buttons
  method : public : LevelLabelY() ~ Int {
    return @lvl_y - 24;
  }

  method : public : All() ~ Int[] {
    return @all;
  }
}

# The camera. The board is drawn as a flat 8 x 8 grid (mode 0) or as if seen from the
# near edge at a slant (mode 1): the far rows shrink and crowd together, the near
# rows grow, like a real board on a table in front of you. It is a plain pinhole
# camera over a plane tilted by an angle about the horizontal axis:
#
#   depth of a point at row offset w from the middle (positive = nearer the player):
#       z = D - w sin(tilt)         the nearer, the smaller z
#   screen:  x = cx + S * u * (D / z)         u = column offset from the middle
#            y = cy + S * w * cos(tilt) * (D / z)
#
# With tilt 0 that is just a grid of squares S pixels wide. Because the projection
# is one formula in one place, drawing (squares, pieces, effects) and mouse picking
# (Project and Unproject are exact inverses) cannot disagree about where a square is.
# Board coordinates are those of the SCREEN grid: u is the column 0..8 from the left,
# v the row 0..8 from the top (the far edge); flipping the board is done before
# (CkController->ScreenToSquare), so this class never needs to know about it.
class CkView {
  @mode : Int;
  @tilt : Float;
  @sin : Float;
  @cos : Float;
  @dist : Float;
  @cx : Float;
  @cy : Float;
  @s : Float;
  @size : Int;
  @sx : Int;
  @sy : Int;

  # mode 0 flat, 1 slanted; the board fills the area at (left, top) of 8 x 8 squares of size pixels
  New(mode : Int, left : Int, top : Int, size : Int) {
    @mode := mode;
    @size := size;
    @dist := 13.0;
    @tilt := 0.0;
    @sin := 0.0;
    @cos := 1.0;
    @s := size->As(Float);
    @cx := (left + 4 * size)->As(Float);
    @cy := (top + 4 * size)->As(Float);
    if(mode = 1) {
      @tilt := 0.80;
      @sin := @tilt->Sin();
      @cos := @tilt->Cos();
      k_near := @dist / (@dist - 4.0 * @sin);
      k_far := @dist / (@dist + 4.0 * @sin);
      # the near edge, with its frame, is about as wide as the flat board and frame
      @s := size->As(Float) * 0.88 / k_near;
      # and the whole slanted board sits in the middle of the board area
      y_far := 0.0 - 4.0 * @s * @cos * k_far;
      y_near := 4.0 * @s * @cos * k_near;
      @cy := (top + 4 * size)->As(Float) - (y_far + y_near) / 2.0;
    };
  }

  method : public : Mode() ~ Int {
    return @mode;
  }

  method : public : Tilted() ~ Bool {
    return @mode = 1;
  }

  # shift the whole picture a few pixels (the screen shake)
  method : public : SetShift(dx : Int, dy : Int) ~ Nil {
    @sx := dx;
    @sy := dy;
  }

  # how much nearer a point at row v is than the middle row: 1.0 in the middle
  method : public : K(v : Float) ~ Float {
    w := v - 4.0;
    return 1.0 / (1.0 - w * @sin / @dist);
  }

  method : public : FX(u : Float, v : Float) ~ Float {
    return @cx + @s * (u - 4.0) * K(v) + @sx->As(Float);
  }

  method : public : FY(u : Float, v : Float) ~ Float {
    w := v - 4.0;
    return @cy + @s * w * @cos * K(v) + @sy->As(Float);
  }

  # the pixel of board point (u, v)
  method : public : X(u : Float, v : Float) ~ Int {
    return (FX(u, v) + 0.5)->Floor()->As(Int);
  }

  method : public : Y(u : Float, v : Float) ~ Int {
    return (FY(u, v) + 0.5)->Floor()->As(Int);
  }

  # the size of things standing on row v, compared with the flat board (1.0)
  method : public : Ratio(v : Float) ~ Float {
    return @s * K(v) / @size->As(Float);
  }

  # how far a standing piece of radius rad is lifted off the squares so it reads as a
  # solid body (the flat board draws it flat on the square)
  method : public : Raise(rad : Int) ~ Int {
    if(@mode = 0) {
      return 0;
    };
    return rad * 3 / 10;
  }

  # the thickness in pixels of the slab the board is cut from, at row v
  method : public : Thick(v : Float) ~ Int {
    if(@mode = 0) {
      return 0;
    };
    return (@s * K(v) * 0.22)->As(Int) + 2;
  }

  # the board point (u, v) under a pixel: the exact inverse of X and Y
  method : public : UnV(x : Int, y : Int) ~ Float {
    ys := (y - @sy)->As(Float) - @cy;
    w := ys / (@s * @cos + ys * @sin / @dist);
    return w + 4.0;
  }

  method : public : UnU(x : Int, y : Int) ~ Float {
    v := UnV(x, y);
    k := K(v);
    return ((x - @sx)->As(Float) - @cx) / (@s * k) + 4.0;
  }

  # the screen square (row * 8 + column, counted from the top-left) under a pixel, or -1
  method : public : CellAt(x : Int, y : Int) ~ Int {
    v := UnV(x, y);
    u := UnU(x, y);
    if(u < 0.0 | u >= 8.0 | v < 0.0 | v >= 8.0) {
      return -1;
    };
    return v->Floor()->As(Int) * 8 + u->Floor()->As(Int);
  }
}
