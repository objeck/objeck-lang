#~
# Checkers: the character piece sets. Four crazy sets on top of the four standard
# ones, every piece a little creature drawn from SDL2 shapes:
#
#   4  Critters         cats (cream, pointy ears, whiskers) against dogs (brown, floppy ears)
#   5  Monsters/Robots  one-eyed purple monsters (horns, fangs) against square steel robots (antenna)
#   6  Snacks           pizzas (round, pepperoni) against burgers (stacked layers)
#   7  Space            suns (rays) against moons (craters)
#
# Each side differs in colour AND outline (round and pointy against square, round
# against stacked, rays against craters), and the two colours of a pair differ
# strongly in lightness, so the sides stay apart for people who cannot tell
# colours apart and at the smallest board size.
#
# A piece has a mood: 0 calm, 1 worried (it can be captured), 2 cheering (it just
# captured), 3 dizzy (it is being captured), 4 winking (a gift), 5 shaken (a
# disaster). Calm pieces blink and bob, ears and antennae sway; with animations
# off, frame is 0 and the faces are still. A king is the same creature in a
# cape and a crown.
#
# The recipes are data: a row of numbers per side in Recipe(). Needs sdl2 and
# checkers_draw.obs.
~#

use Game.SDL2;

class CkChars {
  function : First() ~ Int {
    return 4;
  }

  function : SetCount() ~ Int {
    return 8;
  }

  # name of a character set, and its two sides
  function : SetName(set : Int) ~ String {
    names := ["Classic", "Glossy", "Engraved", "Modern", "Critters", "Monsters", "Snacks", "Space"];
    return names[set];
  }

  function : SideName(set : Int, side : Int) ~ String {
    names := ["Cats", "Dogs", "Monsters", "Robots", "Pizzas", "Burgers", "Suns", "Moons"];
    return names[(set - 4) * 2 + side];
  }

  # The recipe of a creature: body colour (3), outline colour (3), accent colour
  # (3), the shape number, and the eye style (0 two round eyes, 1 one big eye,
  # 2 square visor eyes).
  function : Recipe(set : Int, side : Int) ~ Int[] {
    rows := [
      245, 228, 196,   110, 70, 40,   244, 140, 160,   0, 0,
      124, 78, 48,     50, 30, 18,    226, 190, 140,   1, 0,
      150, 80, 205,    60, 30, 90,    190, 240, 90,    2, 1,
      205, 214, 226,   50, 62, 80,    80, 230, 240,    3, 2,
      252, 200, 80,    170, 100, 40,  200, 50, 44,     4, 0,
      226, 160, 84,    90, 50, 24,    90, 190, 70,     5, 0,
      255, 220, 60,    220, 130, 20,  255, 160, 40,    6, 0,
      214, 222, 240,   40, 50, 100,   150, 160, 190,   7, 0
    ];
    out := Int->New[11];
    at := ((set - 4) * 2 + side) * 11;
    each(i : 11) {
      out[i] := rows[at + i];
    };
    return out;
  }

  function : Col(r : Int, g : Int, b : Int, a : Int) ~ Color {
    return Color->New(r, g, b, a);
  }

  # Draw one piece. (cx, cy) is its centre, rad its radius; sx, sy squash it, lift
  # raises it, alpha fades it, crown scales the crown of a king; mood and frame
  # drive the face and the idle motion (frame 0 = still); seed varies the idle
  # motion between pieces.
  function : Piece(r : Renderer, set : Int, cx : Int, cy : Int, rad : Int, side : Int, king : Bool,
      sx : Float, sy : Float, lift : Int, alpha : Int, crown : Float, mood : Int, frame : Int, seed : Int) ~ Nil {
    rc := Recipe(set, side);
    shape := rc[9];
    t := frame->As(Float);
    bob := 0;
    wig := 0.0;
    blink := false;
    if(frame > 0) {
      if(mood = 0) {
        bob := (2.5 * (t / 16.0 + seed->As(Float) * 0.7)->Sin()->Abs())->As(Int);
        blink := (frame + seed * 37) % 190 < 6;
      };
      wig := (t / 11.0 + seed->As(Float))->Sin();
      if(mood = 3) {
        wig := (t / 3.0)->Sin() * 1.5;
      };
      if(mood = 5) {
        wig := (t / 2.0)->Sin() * 2.0;
      };
    };
    top := cy - lift - bob;
    rx := (rad->As(Float) * sx)->As(Int);
    ry := (rad->As(Float) * sy)->As(Int);

    # the shadow stays on the board
    shade := 70 * alpha / 255 - lift;
    if(shade < 14) {
      shade := 14;
    };
    r->FilledEllipseColor(cx + 2, cy + rad * 7 / 10 + 4, rx, ry * 45 / 100, Col(0, 0, 0, shade));

    # a king's cape hangs behind
    if(king) {
      cr := 200;
      cg := 40;
      cb := 60;
      if(side = 1) {
        cr := 50;
        cg := 90;
        cb := 210;
      };
      vx := [cx - rx * 6 / 10, cx + rx * 6 / 10, cx + rx * 11 / 10, cx - rx * 11 / 10];
      vy := [top + ry / 4, top + ry / 4, top + ry * 11 / 10, top + ry * 11 / 10];
      r->FilledPolygonColor(vx, vy, Col(cr, cg, cb, alpha));
      r->AAPolygonColor(vx, vy, Col(60, 10, 20, alpha));
    };

    if(shape = 0) {
      Cat(r, rc, cx, top, rx, ry, alpha, wig);
    }
    else if(shape = 1) {
      Dog(r, rc, cx, top, rx, ry, alpha, wig, mood);
    }
    else if(shape = 2) {
      Monster(r, rc, cx, top, rx, ry, alpha, wig);
    }
    else if(shape = 3) {
      Robot(r, rc, cx, top, rx, ry, alpha, wig);
    }
    else if(shape = 4) {
      Pizza(r, rc, cx, top, rx, ry, alpha);
    }
    else if(shape = 5) {
      Burger(r, rc, cx, top, rx, ry, alpha);
    }
    else if(shape = 6) {
      Sun(r, rc, cx, top, rx, ry, alpha, t);
    }
    else {
      Moon(r, rc, cx, top, rx, ry, alpha);
    };

    # the face goes on top of the body
    Face(r, rc, shape, cx, top, rx, ry, mood, blink, alpha, wig);

    if(king) {
      CkDraw->Crown(r, 0, cx, top - ry * 8 / 10, rad * 7 / 10, side, sx, sy, alpha, crown);
    };
  }

  # ---- the bodies ----

  function : Cat(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int, wig : Float) ~ Nil {
    ear := (wig * rx->As(Float) * 0.12)->As(Int);
    # ears: pointy triangles, pink inside
    each(s : 2) {
      d := -1;
      if(s = 1) {
        d := 1;
      };
      ex := cx + d * rx * 6 / 10;
      r->FilledTrigonColor(ex - rx * 3 / 10, cy - ry * 5 / 10, ex + rx * 3 / 10, cy - ry * 5 / 10, ex + d * rx / 10 + ear * d, cy - ry * 14 / 10, Col(rc[0], rc[1], rc[2], alpha));
      r->AAtrigonColor(ex - rx * 3 / 10, cy - ry * 5 / 10, ex + rx * 3 / 10, cy - ry * 5 / 10, ex + d * rx / 10 + ear * d, cy - ry * 14 / 10, Col(rc[3], rc[4], rc[5], alpha));
      r->FilledTrigonColor(ex - rx / 7, cy - ry * 55 / 100, ex + rx / 7, cy - ry * 55 / 100, ex + d * rx / 12 + ear * d, cy - ry * 105 / 100, Col(rc[6], rc[7], rc[8], alpha));
    };
    r->FilledEllipseColor(cx, cy, rx, ry * 92 / 100, Col(rc[0], rc[1], rc[2], alpha));
    r->AAEllipseColor(cx, cy, rx, ry * 92 / 100, Col(rc[3], rc[4], rc[5], alpha));
    # forehead stripes and whiskers
    each(i : 3) {
      x := cx + (i - 1) * rx / 5;
      r->ThickLineColor(x, cy - ry * 85 / 100, x, cy - ry * 55 / 100, 2, Col(rc[3], rc[4], rc[5], alpha * 7 / 10));
    };
    each(s : 2) {
      d := -1;
      if(s = 1) {
        d := 1;
      };
      each(i : 2) {
        r->LineColor(cx + d * rx * 4 / 10, cy + ry * 22 / 100 + i * 5, cx + d * rx * 13 / 10, cy + ry * 10 / 100 + i * 14, Col(rc[3], rc[4], rc[5], alpha));
      };
    };
  }

  function : Dog(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int, wig : Float, mood : Int) ~ Nil {
    # floppy ears hang down the sides and flap a little
    flap := (wig * rx->As(Float) * 0.08)->As(Int);
    each(s : 2) {
      d := -1;
      if(s = 1) {
        d := 1;
      };
      r->FilledEllipseColor(cx + d * rx * 9 / 10 + flap * d, cy - ry / 8 + flap, rx * 3 / 10, ry * 6 / 10, Col(rc[3] + 30, rc[4] + 20, rc[5] + 10, alpha));
      r->AAEllipseColor(cx + d * rx * 9 / 10 + flap * d, cy - ry / 8 + flap, rx * 3 / 10, ry * 6 / 10, Col(rc[3], rc[4], rc[5], alpha));
    };
    r->FilledEllipseColor(cx, cy, rx * 92 / 100, ry * 95 / 100, Col(rc[0], rc[1], rc[2], alpha));
    r->AAEllipseColor(cx, cy, rx * 92 / 100, ry * 95 / 100, Col(rc[3], rc[4], rc[5], alpha));
    # a pale snout, a patch round one eye
    r->FilledEllipseColor(cx, cy + ry * 35 / 100, rx * 45 / 100, ry * 36 / 100, Col(rc[6], rc[7], rc[8], alpha));
    r->FilledCircleColor(cx + rx * 36 / 100, cy - ry * 12 / 100, rx * 24 / 100, Col(rc[3] + 20, rc[4] + 12, rc[5] + 6, alpha * 8 / 10));
    r->FilledEllipseColor(cx, cy + ry * 18 / 100, rx / 8, ry / 12, Col(20, 14, 12, alpha));
    if(mood = 2) {
      r->FilledEllipseColor(cx, cy + ry * 62 / 100, rx / 9, ry / 8, Col(240, 110, 130, alpha));
    };
  }

  function : Monster(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int, wig : Float) ~ Nil {
    horn := (wig * rx->As(Float) * 0.1)->As(Int);
    each(s : 2) {
      d := -1;
      if(s = 1) {
        d := 1;
      };
      hx := cx + d * rx * 5 / 10;
      r->FilledTrigonColor(hx - rx / 6, cy - ry * 6 / 10, hx + rx / 6, cy - ry * 6 / 10, hx + d * rx / 8 + horn, cy - ry * 14 / 10, Col(rc[6], rc[7], rc[8], alpha));
      r->AAtrigonColor(hx - rx / 6, cy - ry * 6 / 10, hx + rx / 6, cy - ry * 6 / 10, hx + d * rx / 8 + horn, cy - ry * 14 / 10, Col(rc[3], rc[4], rc[5], alpha));
    };
    r->FilledCircleColor(cx, cy, Int->Min(rx, ry), Col(rc[0], rc[1], rc[2], alpha));
    r->AACircleColor(cx, cy, Int->Min(rx, ry), Col(rc[3], rc[4], rc[5], alpha));
    # spots
    r->FilledCircleColor(cx - rx * 5 / 10, cy + ry * 3 / 10, rx / 9, Col(rc[0] - 30, rc[1] - 20, rc[2] - 20, alpha));
    r->FilledCircleColor(cx + rx * 55 / 100, cy + ry * 20 / 100, rx / 11, Col(rc[0] - 30, rc[1] - 20, rc[2] - 20, alpha));
    r->FilledCircleColor(cx + rx * 20 / 100, cy + ry * 65 / 100, rx / 12, Col(rc[0] - 30, rc[1] - 20, rc[2] - 20, alpha));
  }

  function : Robot(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int, wig : Float) ~ Nil {
    # an antenna with a bobbing ball
    sway := (wig * rx->As(Float) * 0.15)->As(Int);
    r->ThickLineColor(cx, cy - ry * 8 / 10, cx + sway, cy - ry * 13 / 10, 2, Col(rc[3], rc[4], rc[5], alpha));
    r->FilledCircleColor(cx + sway, cy - ry * 13 / 10, rx / 6 + 1, Col(rc[6], rc[7], rc[8], alpha));
    r->RoundedBoxColor(cx - rx * 9 / 10, cy - ry * 8 / 10, cx + rx * 9 / 10, cy + ry * 8 / 10, rx / 4, Col(rc[0], rc[1], rc[2], alpha));
    r->RoundedRectangleColor(cx - rx * 9 / 10, cy - ry * 8 / 10, cx + rx * 9 / 10, cy + ry * 8 / 10, rx / 4, Col(rc[3], rc[4], rc[5], alpha));
    # rivets in the corners and a dark visor behind the eyes
    each(i : 4) {
      px := cx - rx * 7 / 10;
      if(i % 2 = 1) {
        px := cx + rx * 7 / 10;
      };
      py := cy - ry * 6 / 10;
      if(i >= 2) {
        py := cy + ry * 6 / 10;
      };
      r->FilledCircleColor(px, py, 2, Col(rc[3], rc[4], rc[5], alpha));
    };
    r->RoundedBoxColor(cx - rx * 7 / 10, cy - ry * 32 / 100, cx + rx * 7 / 10, cy + ry * 6 / 100, 4, Col(30, 36, 52, alpha));
  }

  function : Pizza(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int) ~ Nil {
    r->FilledEllipseColor(cx, cy, rx, ry, Col(rc[3] + 40, rc[4] + 30, rc[5] + 10, alpha));
    r->FilledEllipseColor(cx, cy, rx * 86 / 100, ry * 86 / 100, Col(rc[0], rc[1], rc[2], alpha));
    r->AAEllipseColor(cx, cy, rx, ry, Col(rc[3], rc[4], rc[5], alpha));
    # pepperoni
    r->FilledCircleColor(cx - rx * 5 / 10, cy - ry * 4 / 10, rx / 6, Col(rc[6], rc[7], rc[8], alpha));
    r->FilledCircleColor(cx + rx * 5 / 10, cy - ry * 3 / 10, rx / 6, Col(rc[6], rc[7], rc[8], alpha));
    r->FilledCircleColor(cx + rx * 3 / 10, cy + ry * 6 / 10, rx / 6, Col(rc[6], rc[7], rc[8], alpha));
    r->FilledCircleColor(cx - rx * 45 / 100, cy + ry * 55 / 100, rx / 7, Col(rc[6], rc[7], rc[8], alpha));
    r->FilledCircleColor(cx, cy - ry * 68 / 100, rx / 9, Col(80, 150, 60, alpha));
  }

  function : Burger(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int) ~ Nil {
    # bottom bun, patty, lettuce, then the domed top bun with seeds
    r->RoundedBoxColor(cx - rx * 9 / 10, cy + ry * 45 / 100, cx + rx * 9 / 10, cy + ry * 95 / 100, 8, Col(rc[0] - 20, rc[1] - 15, rc[2] - 10, alpha));
    r->RoundedBoxColor(cx - rx * 100 / 100, cy + ry * 10 / 100, cx + rx * 100 / 100, cy + ry * 50 / 100, 8, Col(110, 62, 34, alpha));
    each(i : 6) {
      lx := cx - rx * 9 / 10 + i * rx * 36 / 100;
      r->FilledEllipseColor(lx, cy + ry * 5 / 100, rx * 22 / 100, ry * 12 / 100, Col(rc[6], rc[7], rc[8], alpha));
    };
    r->FilledEllipseColor(cx, cy - ry * 25 / 100, rx * 95 / 100, ry * 70 / 100, Col(rc[0], rc[1], rc[2], alpha));
    r->BoxColor(cx - rx, cy + ry * 5 / 100, cx + rx, cy + ry * 12 / 100, Col(rc[6], rc[7], rc[8], alpha));
    r->AAEllipseColor(cx, cy - ry * 25 / 100, rx * 95 / 100, ry * 70 / 100, Col(rc[3], rc[4], rc[5], alpha));
    each(i : 4) {
      r->FilledEllipseColor(cx - rx * 45 / 100 + i * rx * 30 / 100, cy - ry * (62 - (i % 2) * 14) / 100, 2, 1, Col(255, 245, 210, alpha));
    };
  }

  function : Sun(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int, t : Float) ~ Nil {
    # eight rays that turn slowly
    each(i : 8) {
      a := i->As(Float) * 0.7854 + t * 0.012;
      x1 := cx + (a->Cos() * rx->As(Float) * 0.8)->As(Int);
      y1 := cy + (a->Sin() * ry->As(Float) * 0.8)->As(Int);
      x2 := cx + (a->Cos() * rx->As(Float) * 1.35)->As(Int);
      y2 := cy + (a->Sin() * ry->As(Float) * 1.35)->As(Int);
      b := a + 0.28;
      x3 := cx + (b->Cos() * rx->As(Float) * 0.8)->As(Int);
      y3 := cy + (b->Sin() * ry->As(Float) * 0.8)->As(Int);
      r->FilledTrigonColor(x1, y1, x2, y2, x3, y3, Col(rc[6], rc[7], rc[8], alpha));
    };
    r->FilledEllipseColor(cx, cy, rx * 88 / 100, ry * 88 / 100, Col(rc[0], rc[1], rc[2], alpha));
    r->AAEllipseColor(cx, cy, rx * 88 / 100, ry * 88 / 100, Col(rc[3], rc[4], rc[5], alpha));
  }

  function : Moon(r : Renderer, rc : Int[], cx : Int, cy : Int, rx : Int, ry : Int, alpha : Int) ~ Nil {
    r->FilledEllipseColor(cx, cy, rx * 92 / 100, ry * 92 / 100, Col(rc[0], rc[1], rc[2], alpha));
    r->AAEllipseColor(cx, cy, rx * 92 / 100, ry * 92 / 100, Col(rc[3], rc[4], rc[5], alpha));
    r->FilledCircleColor(cx - rx * 5 / 10, cy - ry * 3 / 10, rx / 7, Col(rc[6], rc[7], rc[8], alpha));
    r->FilledCircleColor(cx + rx * 5 / 10, cy + ry * 2 / 10, rx / 6, Col(rc[6], rc[7], rc[8], alpha));
    r->FilledCircleColor(cx + rx * 1 / 10, cy + ry * 6 / 10, rx / 9, Col(rc[6], rc[7], rc[8], alpha));
    # a little stocking cap with a star on it, so the moons look sleepy
    r->FilledTrigonColor(cx - rx * 7 / 10, cy - ry * 55 / 100, cx + rx * 7 / 10, cy - ry * 55 / 100, cx + rx * 6 / 10, cy - ry * 120 / 100, Col(rc[3] + 40, rc[4] + 40, rc[5] + 80, alpha));
    r->FilledCircleColor(cx + rx * 6 / 10, cy - ry * 120 / 100, rx / 9, Col(255, 240, 150, alpha));
  }

  # ---- the faces ----

  # eyes and mouth for a mood. shape picks where the eyes sit and how they look.
  function : Face(r : Renderer, rc : Int[], shape : Int, cx : Int, cy : Int, rx : Int, ry : Int, mood : Int, blink : Bool, alpha : Int, wig : Float) ~ Nil {
    eyes := rc[10];
    ey := cy - ry / 10;
    ex := rx * 32 / 100;
    ew := rx / 6 + 1;
    eh := ry / 5 + 1;
    my := cy + ry * 42 / 100;
    if(shape = 5) {
      ey := cy - ry * 45 / 100;
      my := cy + ry * 24 / 100;
    }
    else if(shape = 4) {
      ey := cy - ry * 8 / 100;
      my := cy + ry * 40 / 100;
    }
    else if(shape = 3) {
      ey := cy - ry * 13 / 100;
    }
    else if(shape = 1) {
      ey := cy - ry * 14 / 100;
      my := cy + ry * 58 / 100;
    };
    dark := Col(24, 20, 24, alpha);

    if(eyes = 1) {
      # one big eye
      ew := rx * 3 / 10;
      eh := ry * 3 / 10;
      Eye(r, cx, ey, ew, eh, mood, blink, alpha, true, true);
    }
    else if(eyes = 2) {
      # square glowing eyes behind the visor: they squint, widen or cross like the mood
      vc := Col(rc[6], rc[7], rc[8], alpha);
      each(s : 2) {
        d := -1;
        if(s = 1) {
          d := 1;
        };
        x := cx + d * rx * 28 / 100;
        if(mood = 2 | (mood = 4 & s = 1)) {
          r->ThickLineColor(x - rx / 8, ey + 3, x, ey - 3, 3, vc);
          r->ThickLineColor(x, ey - 3, x + rx / 8, ey + 3, 3, vc);
        }
        else if(blink | (mood = 4 & s = 0 & false)) {
          r->ThickLineColor(x - rx / 8, ey, x + rx / 8, ey, 3, vc);
        }
        else if(mood = 3) {
          r->ThickLineColor(x - rx / 8, ey - 4, x + rx / 8, ey + 4, 3, vc);
          r->ThickLineColor(x - rx / 8, ey + 4, x + rx / 8, ey - 4, 3, vc);
        }
        else {
          h := ry / 7 + 2;
          if(mood = 5 | mood = 1) {
            h := ry / 5 + 3;
          };
          r->BoxColor(x - rx / 8, ey - h, x + rx / 8, ey + h, vc);
        };
      };
    }
    else {
      each(s : 2) {
        d := -1;
        if(s = 1) {
          d := 1;
        };
        Eye(r, cx + d * ex, ey, ew, eh, mood, blink, alpha, s = 0, false);
      };
    };

    # eyebrows for worry and shock
    if(mood = 1 | mood = 5) {
      each(s : 2) {
        d := -1;
        if(s = 1) {
          d := 1;
        };
        x := cx + d * ex;
        if(eyes = 1) {
          x := cx;
        };
        r->ThickLineColor(x - d * ew, ey - eh * 18 / 10 + 3, x + d * ew, ey - eh * 18 / 10 - 3, 2, dark);
      };
    };

    # the mouth
    if(eyes <> 2 | mood <> 0) {
      Mouth(r, cx, my, rx, ry, mood, alpha, dark);
    }
    else {
      each(i : 4) {
        r->LineColor(cx - rx * 3 / 10 + i * rx * 2 / 10, my - 2, cx - rx * 3 / 10 + i * rx * 2 / 10, my + 4, Col(rc[3], rc[4], rc[5], alpha));
      };
    };

    # worry sweats, a dizzy one sees stars
    if(mood = 1) {
      r->FilledCircleColor(cx + rx * 85 / 100, ey - eh, 3, Col(120, 190, 255, alpha));
      r->FilledTrigonColor(cx + rx * 85 / 100 - 3, ey - eh, cx + rx * 85 / 100 + 3, ey - eh, cx + rx * 85 / 100, ey - eh - 7, Col(120, 190, 255, alpha));
    }
    else if(mood = 3) {
      each(i : 3) {
        a := wig + i->As(Float) * 2.1;
        r->FilledCircleColor(cx + (a->Cos() * rx->As(Float) * 0.9)->As(Int), cy - ry * 9 / 10 + (a->Sin() * 4.0)->As(Int), 3, Col(255, 230, 90, alpha));
      };
    };
  }

  # one eye: round, with a pupil that looks around; mood changes its shape
  function : Eye(r : Renderer, x : Int, y : Int, ew : Int, eh : Int, mood : Int, blink : Bool, alpha : Int, left : Bool, big : Bool) ~ Nil {
    dark := Col(24, 20, 24, alpha);
    if(mood = 2 | (mood = 4 & <>left)) {
      # a happy arc (or the wink)
      r->ThickLineColor(x - ew, y + 2, x, y - eh / 2 - 1, 3, dark);
      r->ThickLineColor(x, y - eh / 2 - 1, x + ew, y + 2, 3, dark);
      return;
    };
    if(blink) {
      r->ThickLineColor(x - ew, y, x + ew, y, 2, dark);
      return;
    };
    r->FilledEllipseColor(x, y, ew, eh, Col(255, 255, 255, alpha));
    r->AAEllipseColor(x, y, ew, eh, dark);
    if(mood = 3) {
      # dizzy: a spiral
      r->AACircleColor(x, y, eh * 7 / 10, dark);
      r->AACircleColor(x, y, eh * 3 / 10, dark);
      return;
    };
    pr := ew * 55 / 100;
    py := y;
    if(mood = 1) {
      py := y - eh / 3;
    };
    if(mood = 5) {
      pr := ew * 3 / 10 + 1;
    };
    r->FilledCircleColor(x, py, pr, dark);
    r->FilledCircleColor(x - pr / 3, py - pr / 3, Int->Max(pr / 4, 1), Col(255, 255, 255, alpha));
  }

  function : Mouth(r : Renderer, cx : Int, my : Int, rx : Int, ry : Int, mood : Int, alpha : Int, dark : Color) ~ Nil {
    w := rx * 22 / 100 + 2;
    if(mood = 2) {
      # a big open grin
      r->FilledEllipseColor(cx, my, w, ry / 6 + 3, Col(120, 30, 40, alpha));
      r->FilledEllipseColor(cx, my - ry / 12, w - 1, ry / 11 + 1, Col(250, 250, 250, alpha));
    }
    else if(mood = 5 | mood = 3) {
      r->FilledEllipseColor(cx, my + 1, w / 2 + 1, ry / 8 + 2, dark);
    }
    else if(mood = 1) {
      r->ThickLineColor(cx - w, my + 3, cx - w / 2, my - 1, 2, dark);
      r->ThickLineColor(cx - w / 2, my - 1, cx + w / 2, my + 2, 2, dark);
      r->ThickLineColor(cx + w / 2, my + 2, cx + w, my - 2, 2, dark);
    }
    else {
      # a smile, wider when winking
      d := 3;
      if(mood = 4) {
        d := 5;
      };
      r->ThickLineColor(cx - w, my - 1, cx - w / 2, my + d / 2, 2, dark);
      r->ThickLineColor(cx - w / 2, my + d / 2, cx + w / 2, my + d / 2, 2, dark);
      r->ThickLineColor(cx + w / 2, my + d / 2, cx + w, my - 1, 2, dark);
    };
  }
}
