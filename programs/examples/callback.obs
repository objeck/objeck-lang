use Collection;

class Test {
	function : Main(args : String[]) ~ Nil {
		Run();
	}

	function : native : Run() ~ Nil {
		"Print roots..."->PrintLine();
		values := CompareVector->New()<IntRef>;
		each(v in [1, 2, 3, 4, 5, 100]) {
			values->AddBack(v);
		};
		squares := values->Map(Square(IntRef) ~ IntRef);
		each(i : squares) {
		  squares->Get(i)->PrintLine();
	  };
	}
	
	function : Square(value : IntRef) ~ IntRef {
		return value * value;
	}
}

