use Web.HTTP, Data.JSON, Collection;

#~
Rosetta Code "Count examples": lists each programming task with the number of
language solutions on its page. An optional argument limits how many tasks are
counted.
~#
class RosettaCount {
	function : Main(args : String[]) ~ Nil {
		limit := -1;
		if(args->Size() > 0) {
			limit := args[0]->ToInt();
		};

		tasks := GetTasks(limit);
		total := 0;
		each(task in tasks) {
			# a title is plain text ('100 doors'); encode it for the query string
			url := "https://rosettacode.org/w/index.php?action=raw&title=" + Url->Encode(task);
			response := HttpsClient->QuickGet(Url->New(url));
			if(response <> Nil & response->GetContent() <> Nil) {
				count := response->GetContent()->ToString()->FindAll("=={{header|")->Size();
				"{$task}: {$count}"->PrintLine();
				total += count;
			};
		};
		"Total: {$total}"->PrintLine();
	}

	function : GetTasks(limit : Int) ~ Vector<String> {
		tasks := Vector->New()<String>;
		base_url := "https://rosettacode.org/w/api.php?action=query&list=categorymembers&cmtitle=Category:Programming_Tasks&cmlimit=500&format=json";

		next := "";
		while(next <> Nil) {
			url := base_url;
			if(next->Size() > 0) {
				url += "&cmcontinue=" + Url->Encode(next);
			};
			next := Nil;

			response := HttpsClient->QuickGet(Url->New(url), "application/json");
			if(response <> Nil & response->GetContent() <> Nil) {
				json := JsonParser->TextToElement(response->GetContent()->ToString());
				if(json <> Nil) {
					members := json->FindElements("query/categorymembers");
					if(members <> Nil) {
						each(member in members) {
							if(limit < 0 | tasks->Size() < limit) {
								tasks->AddBack(member->Get("title")->GetString());
							};
						};
					};

					cont := json->FindElements("continue/cmcontinue");
					if(cont <> Nil & (limit < 0 | tasks->Size() < limit)) {
						next := cont->GetString();
					};
				};
			};
		};

		return tasks;
	}
}
