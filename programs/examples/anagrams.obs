use Web.HTTP;
use Collection;

class Anagrams {
	function : Main(args : String[]) ~ Nil {
		response := HttpsClient->QuickGet(Url->New("https://web.archive.org/web/20180611003215id_/http://www.puzzlers.org/pub/wordlists/unixdict.txt"));
		anagrams := Map->New()<String, Vector<String> >;
		count := 0;
		if(response <> Nil & response->GetContent() <> Nil) {
			line := response->GetContent()->ToString();
			words := line->Split("\n");
			each(i : words) {
				word := words[i]->Trim();
				key := String->New(word->ToCharArray()->Sort());
				list := anagrams->Find(key);
				if(list = Nil) {
					list := Vector->New()<String>;
					anagrams->Insert(key, list);
				};
				list->AddBack(word);
				count := count->Max(list->Size());
			};

			lists := anagrams->GetValues();
			each(i : lists) {
				list := lists->Get(i);
				if(list->Size() >= count) {
					'['->Print();
					each(j : list) {
						list->Get(j)->Print();
						if(j + 1 < list->Size()) {
							','->Print();
						};
					};
					']'->PrintLine();
				};
			};
		};
	}
}
