ARGS=-O3 -flto=auto -Wall -Wno-unused-function -std=c++20 -mavx2 -MMD -MP

AR=ar
SRC=logger.o sys.o
LIB=sys.a

# `all`, not $(LIB), is the default goal: the copies below must happen on every
# invocation. Hung off $(LIB)'s recipe they ran only when the archive was out of
# date, so a consumer whose own copy had been deleted got "sys.a is up to date"
# and no copy -- and under -j it depended on which branch arrived first.
all: $(LIB)
	cp $(LIB) ../compiler/$(LIB)
	cp $(LIB) ../vm/$(LIB)

.PHONY: all clean

$(LIB): $(SRC)
	rm -f $(LIB).tmp; $(AR) -cvq $(LIB).tmp $(SRC) && mv -f $(LIB).tmp $(LIB)
	
%.o: %.cpp
	$(CXX) -m64 $(ARGS) -c $< 

# Auto-generated header dependencies (see -MMD -MP in ARGS). Without these make
# never learned that the objects include ../shared/version.h and friends, so a
# header edit silently relinked stale .o files -- 'make clean' was mandatory.
-include $(wildcard *.d)

clean:
	rm -f *.o *.d *~ $(LIB) ../compiler/$(LIB) ../vm/$(LIB)
