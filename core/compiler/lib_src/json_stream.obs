#~
Streaming JSON parser for processing large documents without loading the full tree into memory. Reads tokens sequentially via a cursor-based API. Compile with -lib json.
~#
bundle Data.JSON.Stream {
	#~
	Event driven stream JSON parser
	
	```
stream := FileReader->New(filename);
if(stream->IsOpen()) {
  parser := StreamParser->New(stream);

  found := false;
  do {
    if(parser->FindElement("Value", 4)) {
      parser->Next();
      if(parser->GetTypeValue()->Equals("{d4db6850-5385-11d0-89e9-00a0c90a90ac}")) {
        found := true;
      };
    };
  }
  while(<>found & parser->Next());

  parser->GetTypeValue()->PrintLine();
};

stream->Close();
	```
  ~#
	class StreamParser {
		@input : InputStream;

		@stream : Char[];
		@stream_offset : Int;
		@stream_line : Int;
		@cur_char : Char;

		@level : Int;
		@skip_next : Bool;

		@is_delim : Bool;
		@type : StreamParser->Type;
		@value : String;

		@is_debug : Bool;
		@has_error : Bool;

		#~
		Stream JSON type
		~#
		enum Type {
			OBJECT,
			OBJECT_END,
			ARRAY,
			ARRAY_END,
			LABEL,
			STRING,
			NUMBER,
			NULL,
			TRUE,
			FALSE
		}

		#~
		Constructor
		@param input input stream
		```
		stream := FileReader->New("data.json");
		if(stream->IsOpen()) {
		  parser := Data.JSON.Stream.StreamParser->New(stream);
		  parser->Next();
		  stream->Close();
		};
		```
		~#
		New(input : InputStream) {
			@input := input;

			# @is_debug := true;

			stream_str := @input->ReadLine();
			if(stream_str <> Nil) {
				@stream_line += 1;
				@stream := stream_str->ToCharArray();
				@stream_offset := 0;
				if(@stream->Size() > 0) {
					@cur_char := @stream[@stream_offset];
				};
			}
			else {
				@cur_char := '\0';
			};
		}

		#~
		Find element by name
		@param name element by name
		@return true if found, false otherwise
		```
		stream := FileReader->New("config.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		if(parser->FindElement("version")) { # seek to "version" label
		  parser->Next();
		  parser->GetTypeValue()->PrintLine(); # print the value
		};
		stream->Close();
		```
		~#
		method : public : FindElement(name : String) ~ Bool {
			while(Next()) {
				if(@type = StreamParser->Type->LABEL & GetTypeValue()->Equals(name)) {
					return true;
				};
			};

			return false;
		}

		#~
		Find element by name
		@param name element by name
		@param level element level
		@return true if found, false otherwise
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		# find "id" only at nesting depth 2
		if(parser->FindElement("id", 2)) {
		  parser->Next();
		  parser->GetTypeValue()->PrintLine();
		};
		stream->Close();
		```
		~#
		method : public : FindElement(name : String, level : Int) ~ Bool {
			while(Next()) {
				if(level = @level & @type = StreamParser->Type->LABEL & GetTypeValue()->Equals(name)) {
					return true;
				};
			};

			return false;
		}

		#~
		Find element by type
		@param type element by type
		@return true if found, false otherwise
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		# advance to the first array token
		if(parser->FindElement(Data.JSON.Stream.StreamParser->Type->ARRAY)) {
		  parser->GetTypeValue()->PrintLine(); # prints "["
		};
		stream->Close();
		```
		~#
		method : public : FindElement(type : StreamParser->Type) ~ Bool {
			while(Next()) {
				if(@type = type) {
					return true;
				};
			};

			return false;
		}

		#~
		Find element by type
		@param type element by type
		@param level element level
		@return true if found, false otherwise
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		# find a number token at depth 1
		if(parser->FindElement(Data.JSON.Stream.StreamParser->Type->NUMBER, 1)) {
		  parser->GetTypeValue()->PrintLine();
		};
		stream->Close();
		```
		~#
		method : public : FindElement(type : StreamParser->Type, level : Int) ~ Bool {
			while(Next()) {
				if(level = @level & @type = type) {
					return true;
				};
			};

			return false;
		}

		method : native : Transition() ~ Nil {
			string_buffer : String;
			num_buffer : String;		

			if(@level < 0) {
				SetError("invalid json");
			};

			while(@cur_char <> '\0' & <>@is_delim) {
				Whitespace();

				if(@cur_char = '{' ) {
					@type := StreamParser->Type->OBJECT;
					@level += 1;
					@is_delim := true;
				}
				else if(@cur_char = '[') {
					@type := StreamParser->Type->ARRAY;
					@level += 1;
					@is_delim := true;				
				}
				else if(@cur_char = '}' ) {
					if(num_buffer <> Nil) {
						EndNumber(num_buffer);
						num_buffer := Nil;

						@skip_next := true;
					}
					else {
						if(@level > 0) {
							@level -= 1;
						};
						@type := StreamParser->Type->OBJECT_END;
						@is_delim := true;
					};
				}
				else if(@cur_char = ']') {
					if(num_buffer <> Nil) {
						EndNumber(num_buffer);
						num_buffer := Nil;

						@skip_next := true;
					}
					else {
						if(@level > 0) {
							@level -= 1;
						};
						@type := StreamParser->Type->ARRAY_END;
						@is_delim := true;
					};
				}	
				else if(@cur_char = '"') {
					if(string_buffer = Nil) {
						string_buffer := String->New();

						# Decoded as read, the same as JsonParser (RFC 8259 section 7). The
						# loop appended each character before looking at the next, so the
						# letter of every escape was appended twice ("a\nb" read as a,
						# newline, n, b), an escaped quote ended the string, an escape at
						# the start was kept raw, and \b and \f produced 0x10 and 0x14.
						NextChar();
						while(@cur_char <> '\0' & @cur_char <> '"') {
							if(@cur_char = '\\') {
								NextChar();
								ReadEscape(string_buffer);
							}
							else {
								string_buffer->Append(@cur_char);
								NextChar();
							};
						};

						if(@has_error) {
							return;
						};

						if(@cur_char <> '"') {
							SetError("unterminated string");
							return;
						};
						NextChar();

						@skip_next := true;
						Whitespace();

						if(@cur_char = ':') {
							@type := StreamParser->Type->LABEL;
							@is_delim := true;
						}
						else {
							@type := StreamParser->Type->STRING;
							@is_delim := true;
						};
						@value := String->New(string_buffer);

						string_buffer := Nil;
					};
				}
				else if(@cur_char->IsDigit() | @cur_char = '-' | @cur_char = '.' | (num_buffer <> Nil & (@cur_char = 'e' | @cur_char = 'E' | @cur_char = '+'))) {
					if(string_buffer = Nil) {
						if(num_buffer = Nil) {
							num_buffer := String->New();
						}
						num_buffer->Append(@cur_char);
					}
					else {
						string_buffer->Append(@cur_char);
					};
				}
				else if(string_buffer = Nil & num_buffer = Nil) {
					if(@cur_char = 'n') {
						if(<>Match("null")) {
							SetError("expected 'null'")
						}
						else {						
							@type := StreamParser->Type->NULL;
							@is_delim := true;
						};
					}
					else if(@cur_char = 't') {
						if(<>Match("true")) {
							SetError("expected 'true'")
						}
						else {						
							@type := StreamParser->Type->TRUE;
							@is_delim := true;
						};
					}
					else if(@cur_char = 'f') {
						if(<>Match("false")) {
							SetError("expected 'false'")
						}
						else {						
							@type := StreamParser->Type->FALSE;
							@is_delim := true;
						};
					}
					else {
						if(@cur_char <> ',' & @cur_char <> ':') {
							SetError("expected : [':' or ',' or '\"']")
						};	
					};	
				}
				else {
					if(num_buffer <> Nil) {
						EndNumber(num_buffer);
						num_buffer := Nil;
					};
				};
				
				if(@skip_next) {
					@skip_next := false;
				}
				else {
					NextChar();
				};
			};
		}

		#~
		Get JSON type
		@return JSON type
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		while(parser->Next()) {
		  type := parser->GetType(); # get enum type of current token
		  parser->GetTypeName()->PrintLine();
		};
		stream->Close();
		```
		~#
		method : public : GetType() ~ StreamParser->Type {
			return @type;
		}

		#~
		Get JSON type name
		@return JSON type name
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		while(parser->Next()) {
		  parser->GetTypeName()->PrintLine(); # e.g. "label", "string", "number"
		};
		stream->Close();
		```
		~#
		method : public : GetTypeName() ~ String {
			select(@type) {
				label StreamParser->Type->OBJECT {
					return "(+) object-start";
				}

				label StreamParser->Type->OBJECT_END {
					return "(-) object-end";
				}
				
				label StreamParser->Type->ARRAY {
					return "(+) array-start";
				}

				label StreamParser->Type->ARRAY_END {
					return "(+) array-end";
				}

				label StreamParser->Type->LABEL {
					return "label";
				}

				label StreamParser->Type->STRING {
					return "string";
				}

				label StreamParser->Type->NUMBER {
					return "number";
				}

				label StreamParser->Type->NULL {
					return "null";
				}

				label StreamParser->Type->TRUE {
					return "true";
				}

				label StreamParser->Type->FALSE {
					return "false";
				}
			};

			return ">>> unknown <<<";
		}

		#~
		Get JSON values
		@return JSON value if it exists, blank string otherwise
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		while(parser->Next()) {
		  value := parser->GetTypeValue(); # get string form of token
		  value->PrintLine();
		};
		stream->Close();
		```
		~#
		method : public : GetTypeValue() ~ String {
			select(@type) {
				label StreamParser->Type->OBJECT {
					return "{";
				}

				label StreamParser->Type->OBJECT_END {
					return "}";
				}
				
				label StreamParser->Type->ARRAY {
					return "[";
				}

				label StreamParser->Type->ARRAY_END {
					return "]";
				}

				label StreamParser->Type->LABEL
				label StreamParser->Type->STRING
				label StreamParser->Type->NUMBER {
					return @value;
				}
	 
				label StreamParser->Type->NULL {
					return "null";
				}

				label StreamParser->Type->TRUE {
					return "true";
				}

				label StreamParser->Type->FALSE {
					return "false";
				}
			};

			return "";
		}

		#~
		Get JSON parse level. Level increase as objects and arrays are parsed.
		@return JSON parse level
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		while(parser->Next()) {
		  level := parser->GetLevel(); # depth: 0=top, 1=first object, etc.
		  "{$level}: {$parser->GetTypeValue()}"->PrintLine();
		};
		stream->Close();
		```
		~#
		method : public : GetLevel() ~ Int {
			return @level;
		}

		#~
		Checks the current parse level
		@param level parse level
		@return current parse level
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		while(parser->Next()) {
		  if(parser->AtLevel(1)) { # only process tokens at depth 1
		    parser->GetTypeValue()->PrintLine();
		  };
		};
		stream->Close();
		```
		~#
		method : public : AtLevel(level : Int) ~ Bool {
			return @level = level & @type <> StreamParser->Type->OBJECT_END & @type <> StreamParser->Type->ARRAY_END;
		}

		#~
		Checks if a parsing error occurred
		@return true if error, false otherwise
		```
		stream := FileReader->New("broken.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		while(parser->Next()) { };
		if(parser->HasError()) { # true if malformed JSON was encountered
		  "Parse failed"->ErrorLine();
		};
		stream->Close();
		```
		~#
		method : public : HasError() ~ Bool {
			return @has_error;
		}

		#~
		Checks for the next JSON token
		@return true if next token exists, false otherwise
		```
		stream := FileReader->New("data.json");
		parser := Data.JSON.Stream.StreamParser->New(stream);
		while(parser->Next()) { # iterate all tokens
		  parser->GetTypeName()->Print();
		  " => "->Print();
		  parser->GetTypeValue()->PrintLine();
		};
		stream->Close();
		```
		~#
		method : public : Next() ~ Bool {
			if(@cur_char = '\0') {
				return false;
			};

			@is_delim := false;
			Transition();

			if(@is_debug) {
				"stream_line={$@stream_line}, stream_offset={$@stream_offset}, cur_char='{$@cur_char}'"->PrintLine();
				debug_str := @stream->ToString()->Trim();
				"[{$debug_str}]"->PrintLine();
				"---"->PrintLine();
			};

			return @cur_char <> '\0';
		}

		method : SetError(message : String) ~ Nil {
			">>> ({$@stream_line},{$@stream_offset}) {$message} <<<"->PrintLine();
			@cur_char := '\0';
			@skip_next := true;
			@has_error := true;
		}

		# Ends a number token. The scanner collects any run of digits, '-', '+',
		# '.', 'e' and 'E', so "1-2", "01" and "1." reached the caller as numbers;
		# check the text against the RFC 8259 grammar before handing it out.
		method : EndNumber(num_buffer : String) ~ Nil {
			if(IsNumber(num_buffer)) {
				@type := StreamParser->Type->NUMBER;
				@value := String->New(num_buffer);
				@is_delim := true;
			}
			else {
				SetError("invalid number '{$num_buffer}'");
			};
		}

		# Decodes one escape into 'buffer'; @cur_char is the character after the
		# backslash, and is left on the character after the escape. An escape RFC
		# 8259 does not allow is an error. An unpaired surrogate becomes U+FFFD, as
		# in JsonParser.
		method : ReadEscape(buffer : String) ~ Nil {
			c := @cur_char;
			if(c = '"' | c = '\\' | c = '/') {
				buffer->Append(c);
				NextChar();
			}
			else if(c = 'b') {
				buffer->Append(0x08->As(Char));
				NextChar();
			}
			else if(c = 'f') {
				buffer->Append(0x0C->As(Char));
				NextChar();
			}
			else if(c = 'n') {
				buffer->Append('\n');
				NextChar();
			}
			else if(c = 'r') {
				buffer->Append('\r');
				NextChar();
			}
			else if(c = 't') {
				buffer->Append('\t');
				NextChar();
			}
			else if(c = 'u') {
				code := ReadHex4();
				while(code >= 0) {
					if(code >= 0xD800 & code <= 0xDBFF) {
						# a high surrogate: one character with the low one that follows
						if(@cur_char = '\\') {
							NextChar();
							if(@cur_char = 'u') {
								low := ReadHex4();
								if(low >= 0xDC00 & low <= 0xDFFF) {
									buffer->Append((0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00))->As(Char));
									code := -1;
								}
								else {
									buffer->Append(0xFFFD->As(Char));
									# the second escape stands on its own (or was bad)
									code := low;
								};
							}
							else {
								buffer->Append(0xFFFD->As(Char));
								ReadEscape(buffer);
								code := -1;
							};
						}
						else {
							buffer->Append(0xFFFD->As(Char));
							code := -1;
						};
					}
					else if(code >= 0xDC00 & code <= 0xDFFF) {
						buffer->Append(0xFFFD->As(Char));
						code := -1;
					}
					else {
						buffer->Append(code->As(Char));
						code := -1;
					};
				};
			}
			else if(c = '\0') {
				SetError("unterminated string");
			}
			else {
				SetError("invalid escape '\\{$c}'");
			};
		}

		# reads the four hex digits after a 'u' (@cur_char) and moves past them;
		# -1, and an error, if there are not four
		method : ReadHex4() ~ Int {
			value := 0;
			for(i := 0; i < 4; i += 1;) {
				NextChar();
				c := @cur_char->As(Int);
				digit : Int;
				if(c >= 0x30 & c <= 0x39) {
					# 0-9
					digit := c - 0x30;
				}
				else if(c >= 0x61 & c <= 0x66) {
					# a-f
					digit := c - 0x61 + 10;
				}
				else if(c >= 0x41 & c <= 0x46) {
					# A-F
					digit := c - 0x41 + 10;
				}
				else {
					if(<>@has_error) {
						SetError("invalid \\u escape: four hex digits expected");
					};
					return -1;
				};
				value := (value << 4) + digit;
			};
			NextChar();

			return value;
		}

		# RFC 8259: -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
		function : IsNumber(str : String) ~ Bool {
			size := str->Size();
			i := 0;

			if(i < size & str->Get(i) = '-') {
				i += 1;
			};

			if(i < size & str->Get(i) = '0') {
				i += 1;
			}
			else if(i < size & str->Get(i)->IsDigit()) {
				while(i < size & str->Get(i)->IsDigit()) {
					i += 1;
				};
			}
			else {
				return false;
			};

			if(i < size & str->Get(i) = '.') {
				i += 1;
				if(i >= size | <>str->Get(i)->IsDigit()) {
					return false;
				};
				while(i < size & str->Get(i)->IsDigit()) {
					i += 1;
				};
			};

			if(i < size & (str->Get(i) = 'e' | str->Get(i) = 'E')) {
				i += 1;
				if(i < size & (str->Get(i) = '+' | str->Get(i) = '-')) {
					i += 1;
				};
				if(i >= size | <>str->Get(i)->IsDigit()) {
					return false;
				};
				while(i < size & str->Get(i)->IsDigit()) {
					i += 1;
				};
			};

			return i = size;
		}

		method : Whitespace() ~ Nil {
			while(@cur_char = ' ' | @cur_char = '\t' | @cur_char = '\r' | @cur_char = '\n') {
				NextChar();
			};
		}

		method : native : NextChar() ~ Nil {
			if(@stream_offset < @stream->Size()) {
				@cur_char := @stream[@stream_offset];
			}
			else {
				stream_str := @input->ReadLine();
				if(stream_str <> Nil) {
					@stream_line += 1;
					@stream := stream_str->ToCharArray();
					@stream_offset := 0;
					if(@stream->Size() > 0) {
						@cur_char := @stream[@stream_offset];
					};
				}
				else {
					@cur_char := '\0';
				};
			};

			@stream_offset += 1;
		}

		method : native : Match(string : String) ~ Bool {
			each(c in string) {
				if(@cur_char = '\0' | c <> @cur_char) {
					return false;
				};
				NextChar();
			};

			return true;
		}
	}
}