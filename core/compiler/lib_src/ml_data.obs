use Collection;
use Data.CSV;

#~
Data preparation and evaluation: FeatureScaler, Metrics, CrossValidation and PCA decomposition. Compile with -lib ml.
~#
bundle System.ML {
	#~
	Principal component analysis via power iteration with deflation on the
	sample covariance matrix. Deterministic (fixed initialization vector).
	Components are unit-length rows of a k x d matrix; sign is arbitrary.

```
pca := PCA->New(1);
pca->Fit(X);
reduced := pca->Transform(X);          # n x 1
ratios := pca->GetExplainedVarianceRatio();
```
	~#
	class PCA {
		@num_components : Int;
		@mean : Float[];
		@components : Float[,];
		@eigenvalues : Float[];
		@total_variance : Float;
		@is_fitted : Bool;

		#~
		Constructor
		@param num_components number of principal components to keep
		~#
		New(num_components : Int) {
			@num_components := num_components;
			@is_fitted := false;
		}

		New : private (num_components : Int, mean : Float[], components : Float[,], eigenvalues : Float[], total_variance : Float) {
			@num_components := num_components;
			@mean := mean;
			@components := components;
			@eigenvalues := eigenvalues;
			@total_variance := total_variance;
			@is_fitted := true;
		}

		#~
		Fits the decomposition: centers the data, builds the sample covariance
		matrix and extracts the top components by power iteration + deflation.
		@param X data matrix (rows=samples, cols=features)
		@return true if fitting succeeded
		~#
		method : public : Fit(X : Float[,]) ~ Bool {
			if(X = Nil) {
				return false;
			};

			x_dims := X->Size();
			rows := x_dims[0];
			cols := x_dims[1];
			if(rows < 2 | cols = 0 | @num_components < 1 | @num_components > cols) {
				return false;
			};

			n := rows->As(Float);

			# center the data
			@mean := Float->New[cols];
			each(j : cols) {
				sum := 0.0;
				each(i : rows) {
					sum += X[i,j];
				};
				@mean[j] := sum / n;
			};

			centered := Float->New[rows, cols];
			each(i : rows) {
				each(j : cols) {
					centered[i,j] := X[i,j] - @mean[j];
				};
			};

			# sample covariance: C = X'X / (n - 1)
			cov := Float->New[cols, cols];
			each(a : cols) {
				each(b : cols) {
					sum := 0.0;
					each(i : rows) {
						sum += centered[i,a] * centered[i,b];
					};
					cov[a,b] := sum / (n - 1.0);
				};
			};

			@total_variance := 0.0;
			each(j : cols) {
				@total_variance += cov[j,j];
			};

			# power iteration with deflation for the top components
			@components := Float->New[@num_components, cols];
			@eigenvalues := Float->New[@num_components];

			each(c : @num_components) {
				# deterministic non-degenerate initialization
				v := Float->New[cols];
				each(j : cols) {
					v[j] := 1.0 / (j + 1)->As(Float);
				};
				Normalize(v);

				each(iter : 1000) {
					next := Float->New[cols];
					each(a : cols) {
						sum := 0.0;
						each(b : cols) {
							sum += cov[a,b] * v[b];
						};
						next[a] := sum;
					};

					# re-orthogonalize against the components already found so
					# residual deflation error cannot accumulate across
					# components (keeps the basis orthonormal to machine
					# precision, which full-rank reconstruction relies on)
					for(p := 0; p < c; p += 1;) {
						proj := 0.0;
						each(j : cols) {
							proj += next[j] * @components[p,j];
						};
						each(j : cols) {
							next[j] -= proj * @components[p,j];
						};
					};

					norm := Normalize(next);
					if(norm = 0.0) {
						# no remaining variance in this direction
						each(j : cols) {
							next[j] := v[j];
						};
					};

					# converged when the direction stops moving (sign-agnostic)
					dot := 0.0;
					each(j : cols) {
						dot += next[j] * v[j];
					};
					v := next;
					if(Float->Abs(dot) > 0.999999999999) {
						break;
					};
				};

				# Rayleigh quotient gives the eigenvalue for the unit vector
				lambda := 0.0;
				each(a : cols) {
					row_sum := 0.0;
					each(b : cols) {
						row_sum += cov[a,b] * v[b];
					};
					lambda += v[a] * row_sum;
				};

				@eigenvalues[c] := lambda;
				each(j : cols) {
					@components[c,j] := v[j];
				};

				# deflate: C -= lambda * v v'
				each(a : cols) {
					each(b : cols) {
						cov[a,b] -= lambda * v[a] * v[b];
					};
				};
			};

			@is_fitted := true;
			return true;
		}

		method : Normalize(v : Float[]) ~ Float {
			norm := 0.0;
			each(j : v) {
				norm += v[j] * v[j];
			};
			norm := norm->Sqrt();

			if(norm > 0.0) {
				each(j : v) {
					v[j] := v[j] / norm;
				};
			};

			return norm;
		}

		#~
		Projects data onto the fitted components.
		@param X data matrix (rows=samples, cols=features)
		@return projected matrix (rows x num_components), or Nil if not fitted
		~#
		method : public : Transform(X : Float[,]) ~ Float[,] {
			if(<>@is_fitted | X = Nil) {
				return Nil;
			};

			x_dims := X->Size();
			rows := x_dims[0];
			cols := x_dims[1];

			result := Float->New[rows, @num_components];
			each(i : rows) {
				each(c : @num_components) {
					sum := 0.0;
					each(j : cols) {
						sum += (X[i,j] - @mean[j]) * @components[c,j];
					};
					result[i,c] := sum;
				};
			};

			return result;
		}

		#~
		Maps projected data back into the original feature space.
		@param Z projected matrix (rows x num_components)
		@return reconstruction (rows x features), or Nil if not fitted
		~#
		method : public : InverseTransform(Z : Float[,]) ~ Float[,] {
			if(<>@is_fitted | Z = Nil) {
				return Nil;
			};

			z_dims := Z->Size();
			rows := z_dims[0];
			comp_dims := @components->Size();
			cols := comp_dims[1];

			result := Float->New[rows, cols];
			each(i : rows) {
				each(j : cols) {
					sum := @mean[j];
					each(c : @num_components) {
						sum += Z[i,c] * @components[c,j];
					};
					result[i,j] := sum;
				};
			};

			return result;
		}

		#~
		Gets the fitted components (num_components x features; unit rows).
		@return component matrix, or Nil if not fitted
		~#
		method : public : GetComponents() ~ Float[,] {
			return @components;
		}

		#~
		Gets the variance explained by each component (eigenvalues).
		@return explained variance array, or Nil if not fitted
		~#
		method : public : GetExplainedVariance() ~ Float[] {
			return @eigenvalues;
		}

		#~
		Gets the fraction of total variance explained by each component.
		@return ratio array, or Nil if not fitted
		~#
		method : public : GetExplainedVarianceRatio() ~ Float[] {
			if(<>@is_fitted) {
				return Nil;
			};

			ratios := Float->New[@num_components];
			if(@total_variance > 0.0) {
				each(c : @num_components) {
					ratios[c] := @eigenvalues[c] / @total_variance;
				};
			};

			return ratios;
		}

		#~
		Gets the per-feature means used for centering.
		@return mean array, or Nil if not fitted
		~#
		method : public : GetMean() ~ Float[] {
			return @mean;
		}

		#~
		Whether the decomposition has been fitted.
		@return true if fitted
		~#
		method : public : IsFitted() ~ Bool {
			return @is_fitted;
		}

		#~
		Saves the fitted decomposition to a file.
		@param filename file to store to
		@return true if successful, false otherwise
		~#
		method : public : Store(filename : String) ~ Bool {
			if(<>@is_fitted) {
				return false;
			};

			serializer := System.IO.Serializer->New();
			serializer->Write(@num_components);

			cols := @mean->Size();
			serializer->Write(cols);
			each(j : cols) {
				serializer->Write(@mean[j]);
			};

			each(c : @num_components) {
				each(j : cols) {
					serializer->Write(@components[c,j]);
				};
			};

			each(c : @num_components) {
				serializer->Write(@eigenvalues[c]);
			};

			serializer->Write(@total_variance);

			return System.IO.Filesystem.FileWriter->WriteFile(filename, serializer->Serialize());
		}

		#~
		Loads a fitted decomposition from a file.
		@param filename file to load from
		@return fitted decomposition, or Nil on failure
		~#
		function : Load(filename : String) ~ PCA {
			data := System.IO.Filesystem.FileReader->ReadBinaryFile(filename);
			if(data = Nil) {
				return Nil;
			};

			deserializer := System.IO.Deserializer->New(data);
			num_components := deserializer->ReadInt();
			cols := deserializer->ReadInt();
			if(num_components < 1 | cols < 1) {
				return Nil;
			};

			mean := Float->New[cols];
			each(j : cols) {
				mean[j] := deserializer->ReadFloat();
			};

			components := Float->New[num_components, cols];
			each(c : num_components) {
				each(j : cols) {
					components[c,j] := deserializer->ReadFloat();
				};
			};

			eigenvalues := Float->New[num_components];
			each(c : num_components) {
				eigenvalues[c] := deserializer->ReadFloat();
			};

			total_variance := deserializer->ReadFloat();

			return PCA->New(num_components, mean, components, eigenvalues, total_variance);
		}
	}

	#~
	Feature scaling and normalization utilities
	~#
	class FeatureScaler {
		@means : Float[];
		@stds : Float[];
		@fitted : Bool;

		#~
		Constructor for a scaler that learns its statistics once and reapplies them.

		The static functions below standardize whatever matrix they are handed, which
		makes them unusable for train/test work: scaling test data by its own mean and
		deviation leaks test statistics into the evaluation, and the two halves end up
		on different scales besides. Fit on the training split, Transform both.
		~#
		New() {
			@fitted := false;
		}

		#~
		Learns each column's mean and standard deviation from this matrix.
		@param X matrix to learn from, normally the training split only
		@return true when the statistics were learned, false for empty input

```
scaler := FeatureScaler->New();
scaler->Fit(train);
train_z := scaler->Transform(train);
test_z := scaler->Transform(test);
```
		~#
		method : public : Fit(X : Float[,]) ~ Bool {
			if(X = Nil) {
				return false;
			};

			dims := X->Size();
			rows := dims[0];
			cols := dims[1];
			if(rows < 1 | cols < 1) {
				return false;
			};

			@means := Float->New[cols];
			@stds := Float->New[cols];

			each(col : cols) {
				sum := 0.0;
				each(row : rows) {
					sum += X[row, col];
				};
				mean := sum / rows->As(Float);

				sum_sq := 0.0;
				each(row : rows) {
					diff := X[row, col] - mean;
					sum_sq += diff * diff;
				};

				@means[col] := mean;
				# Population deviation, matching the static StandardScaler above. The
				# two must agree: a caller comparing one against the other on the same
				# matrix should not see different numbers.
				@stds[col] := Float->Sqrt(sum_sq / rows->As(Float));
			};

			@fitted := true;

			return true;
		}

		#~
		Applies the learned statistics to a matrix.
		@param X matrix to transform, with the same column count Fit saw
		@return standardized matrix, or Nil if this scaler is unfitted or the column count differs

```
test_z := scaler->Transform(test);
if(test_z = Nil) {
  "unfitted, or wrong column count"->PrintLine();
};
```
		~#
		method : public : Transform(X : Float[,]) ~ Float[,] {
			if(<>@fitted | X = Nil) {
				return Nil;
			};

			dims := X->Size();
			rows := dims[0];
			cols := dims[1];

			# A column-count mismatch means this is not the same feature space the
			# scaler was fitted on. Say so rather than standardize by the wrong column.
			if(cols <> @means->Size()) {
				return Nil;
			};

			result := Float->New[rows, cols];
			each(col : cols) {
				mean := @means[col];
				std := @stds[col];
				each(row : rows) {
					if(std > 0.0) {
						result[row, col] := (X[row, col] - mean) / std;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Fits on this matrix and transforms it in one call. For the training split only.
		@param X matrix to fit and transform
		@return standardized matrix, or Nil if the input could not be fitted
		~#
		method : public : FitTransform(X : Float[,]) ~ Float[,] {
			if(<>Fit(X)) {
				return Nil;
			};

			return Transform(X);
		}

		#~
		Whether Fit has been called successfully.
		@return true when this scaler holds statistics
		~#
		method : public : IsFitted() ~ Bool {
			return @fitted;
		}

		#~
		The learned per-column means.
		@return means, or Nil when unfitted
		~#
		method : public : GetMeans() ~ Float[] {
			return @means;
		}

		#~
		The learned per-column standard deviations.
		@return deviations, or Nil when unfitted
		~#
		method : public : GetStandardDeviations() ~ Float[] {
			return @stds;
		}

		#~
		Standardizes features by removing mean and scaling to unit variance (Z-score normalization)
		@param data input matrix
		@return standardized matrix with mean=0 and std=1
		~#
		function : native : StandardScaler(data : Float[,]) ~ Float[,] {
			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			result := Float->New[rows, cols];

			# Standardize each column
			each(col : cols) {
				# Calculate mean
				sum := 0.0;
				each(row : rows) {
					sum += data[row, col];
				};
				mean := sum / rows->As(Float);

				# Calculate standard deviation
				sum_sq := 0.0;
				each(row : rows) {
					diff := data[row, col] - mean;
					sum_sq += diff * diff;
				};
				std := Float->Sqrt(sum_sq / rows->As(Float));

				# Standardize
				each(row : rows) {
					if(std > 0.0) {
						result[row, col] := (data[row, col] - mean) / std;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Scales features to a [0, 1] range (Min-Max normalization)
		@param data input matrix
		@return scaled matrix with values in [0, 1]
		~#
		function : native : MinMaxScaler(data : Float[,]) ~ Float[,] {
			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			result := Float->New[rows, cols];

			# Scale each column
			each(col : cols) {
				# Find min and max
				min_val := data[0, col];
				max_val := data[0, col];

				each(row : rows) {
					if(data[row, col] < min_val) {
						min_val := data[row, col];
					};
					if(data[row, col] > max_val) {
						max_val := data[row, col];
					};
				};

				# Scale to [0, 1]
				range := max_val - min_val;
				each(row : rows) {
					if(range > 0.0) {
						result[row, col] := (data[row, col] - min_val) / range;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Normalizes each row to unit norm (L2 normalization)
		@param data input matrix
		@return normalized matrix where each row has L2 norm = 1
		~#
		function : native : Normalize(data : Float[,]) ~ Float[,] {
			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			result := Float->New[rows, cols];

			# Normalize each row
			each(row : rows) {
				# Calculate L2 norm
				sum_sq := 0.0;
				each(col : cols) {
					sum_sq += data[row, col] * data[row, col];
				};
				norm := Float->Sqrt(sum_sq);

				# Normalize
				each(col : cols) {
					if(norm > 0.0) {
						result[row, col] := data[row, col] / norm;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}
	}

	#~
	Turns a CsvTable into the numeric matrix a model can train on, learning its
	encoding once so the same encoding can be reapplied to other tables.

	MatrixReader already loads a CSV, but only one that is numeric throughout, and
	it reads the header row as another record whose non-numeric cells become 0.0.
	Real tabular data is mixed: NSL-KDD's protocol, service and flag columns are
	strings among thirty-eight numeric ones. This skips the header, one-hot encodes
	the string columns and passes the numeric ones through.

	The vocabulary is fixed at Fit. Transform reuses it, so a training table and a
	test table produce the same columns in the same order even when the test split
	never contains some category, and a category that appears only in test encodes
	as all-zeros rather than silently shifting every column after it.

```
enc := TableEncoder->New("class");
train_x := enc->FitTransform(train);
train_y := enc->TransformLabelsBinary(train, "normal");
test_x := enc->Transform(test);
```
	~#
	class TableEncoder {
		@label_col : String;
		@source : Int[];
		@numeric : Bool[];
		@offset : Int[];
		@onehot : Hash<String, IntRef>;
		@names : Vector<String>;
		@classes : Vector<String>;
		@width : Int;
		@fitted : Bool;

		#~
		Constructor for a table with no label column: every column is a feature.
		~#
		New() {
			@label_col := "";
			@fitted := false;
		}

		#~
		Constructor
		@param label_col name of the label column, which is excluded from the features
		~#
		New(label_col : String) {
			@label_col := label_col;
			@fitted := false;
		}

		#~
		Learns the feature layout: which columns are numeric, and the value
		vocabulary of each column that is not.

		A column counts as numeric only when every data value in it parses as a
		number. One non-numeric value makes the whole column categorical, which is
		the safe direction: encoding a number as a category costs columns, while
		reading a category as a number invents an ordering that is not there.
		@param table table to learn from, normally the training split only
		@return true when the layout was learned, false for an unparsed or empty table
		~#
		method : public : Fit(table : CsvTable) ~ Bool {
			if(table = Nil | <>table->IsParsed()) {
				return false;
			};

			# Row 0 is the header; rows 1 and up are data.
			rows := table->Size();
			if(rows < 2) {
				return false;
			};

			headers := table->GetHeaders();
			if(headers = Nil) {
				return false;
			};

			cols := headers->Size();
			feature_count := 0;
			each(c : cols) {
				if(<>headers->Get(c)->Equals(@label_col)) {
					feature_count += 1;
				};
			};
			if(feature_count < 1) {
				return false;
			};

			@source := Int->New[feature_count];
			@numeric := Bool->New[feature_count];
			@offset := Int->New[feature_count];
			@onehot := Hash->New()<String, IntRef>;
			@names := Vector->New()<String>;
			@classes := Vector->New()<String>;

			f := 0;
			each(c : cols) {
				if(<>headers->Get(c)->Equals(@label_col)) {
					@source[f] := c;
					@numeric[f] := IsNumericColumn(table, c, rows);
					f += 1;
				};
			};

			# Assign output columns: one per numeric feature, one per distinct value
			# of each categorical feature, in first-seen row order so the layout is
			# reproducible from the same training file.
			@width := 0;
			each(i : feature_count) {
				@offset[i] := @width;
				if(@numeric[i]) {
					@names->AddBack(headers->Get(@source[i]));
					@width += 1;
				}
				else {
					for(r := 1; r < rows; r += 1;) {
						row := table->Get(r);
						if(row <> Nil) {
							value := row->Get(@source[i]);
							if(value <> Nil) {
								key := Key(i, value);
								if(<>@onehot->Has(key)) {
									@onehot->Insert(key, IntRef->New(@width));
									@names->AddBack(headers->Get(@source[i]) + "=" + value);
									@width += 1;
								};
							};
						};
					};
				};
			};

			# The label's own classes, in first-seen order, for TransformLabels.
			if(@label_col->Size() > 0) {
				li := table->GetRowId(@label_col);
				if(li > -1) {
					for(r := 1; r < rows; r += 1;) {
						row := table->Get(r);
						if(row <> Nil) {
							value := row->Get(li);
							if(value <> Nil & <>HasClass(value)) {
								@classes->AddBack(value);
							};
						};
					};
				};
			};

			@fitted := true;

			return true;
		}

		method : IsNumericColumn(table : CsvTable, c : Int, rows : Int) ~ Bool {
			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				if(row <> Nil) {
					value := row->Get(c);
					if(value = Nil) {
						return false;
					};

					if(<>value->IsInt() & <>value->IsFloat()) {
						return false;
					};
				};
			};

			return true;
		}

		method : Key(feature : Int, value : String) ~ String {
			# A separator that cannot occur in a CSV field, so "a=" + "b" and
			# "a" + "=b" cannot collide into the same vocabulary entry.
			return feature->ToString() + "\r" + value;
		}

		method : HasClass(value : String) ~ Bool {
			each(i : @classes) {
				if(@classes->Get(i)->Equals(value)) {
					return true;
				};
			};

			return false;
		}

		#~
		Encodes a table using the layout learned by Fit.
		@param table table to encode; its header row is skipped
		@return matrix of (data rows) x (encoded width), or Nil when unfitted or the table cannot be read

```
test_x := enc->Transform(test);
if(test_x = Nil) {
  "unfitted, or the table did not parse"->PrintLine();
};
```
		~#
		method : public : Transform(table : CsvTable) ~ Float[,] {
			if(<>@fitted | table = Nil | <>table->IsParsed()) {
				return Nil;
			};

			rows := table->Size();
			if(rows < 2) {
				return Nil;
			};

			features := @source->Size();
			result := Float->New[rows - 1, @width];

			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				if(row <> Nil) {
					each(i : features) {
						value := row->Get(@source[i]);
						if(value <> Nil) {
							if(@numeric[i]) {
								result[r - 1, @offset[i]] := value->ToFloat();
							}
							else {
								found := @onehot->Find(Key(i, value));
								# A value Fit never saw leaves this group all zeros.
								# Dropping the row or adding a column instead would
								# change the feature space between train and test.
								if(found <> Nil) {
									result[r - 1, found->Get()] := 1.0;
								};
							};
						};
					};
				};
			};

			return result;
		}

		#~
		Fits on this table and encodes it. For the training split only.
		@param table table to fit and encode
		@return encoded matrix, or Nil when the table could not be fitted
		~#
		method : public : FitTransform(table : CsvTable) ~ Float[,] {
			if(<>Fit(table)) {
				return Nil;
			};

			return Transform(table);
		}

		#~
		Encodes the label column as class indices, using the classes seen at Fit.
		@param table table to read labels from
		@return one index per data row; a class unseen at Fit becomes -1.0
		~#
		method : public : TransformLabels(table : CsvTable) ~ Float[] {
			if(<>@fitted | table = Nil | <>table->IsParsed() | @label_col->Size() = 0) {
				return Nil;
			};

			li := table->GetRowId(@label_col);
			if(li < 0) {
				return Nil;
			};

			rows := table->Size();
			if(rows < 2) {
				return Nil;
			};

			result := Float->New[rows - 1];
			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				result[r - 1] := -1.0;
				if(row <> Nil) {
					value := row->Get(li);
					if(value <> Nil) {
						each(i : @classes) {
							if(@classes->Get(i)->Equals(value)) {
								result[r - 1] := i->As(Float);
							};
						};
					};
				};
			};

			return result;
		}

		#~
		Encodes the label column as a two-class target: 0.0 for the named value,
		1.0 for everything else. Intrusion detection labels are usually one benign
		value against many attack names, and this avoids enumerating the attacks.
		@param table table to read labels from
		@param negative the label value that maps to 0.0
		@return one value per data row, or Nil when unfitted or the label is missing
		~#
		method : public : TransformLabelsBinary(table : CsvTable, negative : String) ~ Float[] {
			if(<>@fitted | table = Nil | <>table->IsParsed() | @label_col->Size() = 0) {
				return Nil;
			};

			li := table->GetRowId(@label_col);
			if(li < 0) {
				return Nil;
			};

			rows := table->Size();
			if(rows < 2) {
				return Nil;
			};

			result := Float->New[rows - 1];
			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				result[r - 1] := 1.0;
				if(row <> Nil) {
					value := row->Get(li);
					if(value <> Nil & value->Equals(negative)) {
						result[r - 1] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Whether Fit has been called successfully.
		@return true when this encoder holds a layout
		~#
		method : public : IsFitted() ~ Bool {
			return @fitted;
		}

		#~
		The number of columns Transform produces.
		@return encoded width, or 0 when unfitted
		~#
		method : public : GetWidth() ~ Int {
			if(<>@fitted) {
				return 0;
			};

			return @width;
		}

		#~
		The name of each encoded column: the source column for a numeric feature,
		and "column=value" for each one-hot column.
		@return names in output order, or Nil when unfitted
		~#
		method : public : GetFeatureNames() ~ String[] {
			if(<>@fitted) {
				return Nil;
			};

			result := String->New[@names->Size()];
			each(i : @names) {
				result[i] := @names->Get(i);
			};

			return result;
		}

		#~
		The label classes seen at Fit, in the order TransformLabels indexes them.
		@return class values, or Nil when unfitted
		~#
		method : public : GetLabelClasses() ~ String[] {
			if(<>@fitted) {
				return Nil;
			};

			result := String->New[@classes->Size()];
			each(i : @classes) {
				result[i] := @classes->Get(i);
			};

			return result;
		}
	}

	#~
	Model evaluation metrics for classification tasks
	~#
	class Metrics {
		#~
		Calculates accuracy: (TP + TN) / Total
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return accuracy score between 0.0 and 1.0
		~#
		function : native : Accuracy(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			correct := 0;
			each(i : predictions) {
				if(predictions[i] = actuals[i]) {
					correct += 1;
				};
			};

			return correct->As(Float) / predictions->Size()->As(Float);
		}

		#~
		Calculates precision: TP / (TP + FP)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return precision score between 0.0 and 1.0
		~#
		function : native : Precision(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			tp := 0; # True Positives
			fp := 0; # False Positives

			each(i : predictions) {
				if(predictions[i] & actuals[i]) {
					tp += 1;
				}
				else if(predictions[i] & <>actuals[i]) {
					fp += 1;
				};
			};

			if(tp + fp = 0) {
				return 0.0;
			};

			return tp->As(Float) / (tp + fp)->As(Float);
		}

		#~
		Calculates recall (sensitivity): TP / (TP + FN)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return recall score between 0.0 and 1.0
		~#
		function : native : Recall(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			tp := 0; # True Positives
			fn := 0; # False Negatives

			each(i : predictions) {
				if(predictions[i] & actuals[i]) {
					tp += 1;
				}
				else if(<>predictions[i] & actuals[i]) {
					fn += 1;
				};
			};

			if(tp + fn = 0) {
				return 0.0;
			};

			return tp->As(Float) / (tp + fn)->As(Float);
		}

		#~
		Calculates F1 score: 2 * (Precision * Recall) / (Precision + Recall)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return F1 score between 0.0 and 1.0
		~#
		function : native : F1Score(predictions : Bool[], actuals : Bool[]) ~ Float {
			precision := Precision(predictions, actuals);
			recall := Recall(predictions, actuals);

			if(precision + recall = 0.0) {
				return 0.0;
			};

			return 2.0 * (precision * recall) / (precision + recall);
		}

		#~
		Creates a confusion matrix
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return 2x2 confusion matrix [[TN, FP], [FN, TP]]
		~#
		function : native : ConfusionMatrix(predictions : Bool[], actuals : Bool[]) ~ Int[,] {
			matrix := Int->New[2, 2];

			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return matrix;
			};

			each(i : predictions) {
				# TN (0,0), FP (0,1), FN (1,0), TP (1,1)
				pred_idx := predictions[i] ? 1 : 0;
				actual_idx := actuals[i] ? 1 : 0;
				matrix[actual_idx, pred_idx] += 1;
			};

			return matrix;
		}

		#~
		Calculates Matthews Correlation Coefficient (MCC)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return MCC score between -1.0 and 1.0
		~#
		function : native : MCC(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			tp := 0; tn := 0; fp := 0; fn := 0;

			each(i : predictions) {
				if(predictions[i] & actuals[i]) {
					tp += 1;
				}
				else if(<>predictions[i] & <>actuals[i]) {
					tn += 1;
				}
				else if(predictions[i] & <>actuals[i]) {
					fp += 1;
				}
				else {
					fn += 1;
				};
			};

			numerator := (tp * tn - fp * fn)->As(Float);
			denominator := Float->Sqrt((tp + fp)->As(Float) * (tp + fn)->As(Float) *
			                           (tn + fp)->As(Float) * (tn + fn)->As(Float));

			if(denominator = 0.0) {
				return 0.0;
			};

			return numerator / denominator;
		}

		#~
		Prints a formatted confusion matrix
		@param matrix 2x2 confusion matrix
		~#
		function : native : PrintConfusionMatrix(matrix : Int[,]) ~ Nil {
			tn := matrix[0,0];
			fp := matrix[0,1];
			fn := matrix[1,0];
			tp := matrix[1,1];

			"Confusion Matrix:"->PrintLine();
			"                Predicted"->PrintLine();
			"              Negative  Positive"->PrintLine();
			"Actual Neg  |   {$tn}   |   {$fp}   |"->PrintLine();
			"Actual Pos  |   {$fn}   |   {$tp}   |"->PrintLine();
		}

		#~
		Operating points of a scored classifier, one row per distinct score, from
		the highest score down: [threshold, false positives, true positives].

		Every metric below is a walk over this. It exists because the functions
		above take already-thresholded Bool predictions, which throw away exactly
		what these questions need: a single Bool array fixes one operating point,
		and cannot answer what the recall would be at a different false-alarm rate.

		Instances that share a score share an operating point. Splitting them would
		invent an ordering the scores do not express and let a metric read better
		than the model earned.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@return points x 3 matrix, or Nil when the inputs do not line up
		~#
		function : OperatingPoints(scores : Float[], actuals : Bool[]) ~ Float[,] {
			if(scores = Nil | actuals = Nil) {
				return Nil;
			};

			n := scores->Size();
			if(n = 0 | actuals->Size() <> n) {
				return Nil;
			};

			order := SortDescending(scores);

			# First pass: how many distinct scores, so the result can be sized.
			points := 0;
			each(i : n) {
				if(i = 0 | scores[order[i]] <> scores[order[i - 1]]) {
					points += 1;
				};
			};

			result := Float->New[points, 3];
			tp := 0;
			fp := 0;
			p := 0;

			each(i : n) {
				# Emit the previous run before starting a new score.
				if(i > 0 & scores[order[i]] <> scores[order[i - 1]]) {
					result[p, 0] := scores[order[i - 1]];
					result[p, 1] := fp->As(Float);
					result[p, 2] := tp->As(Float);
					p += 1;
				};

				if(actuals[order[i]]) {
					tp += 1;
				}
				else {
					fp += 1;
				};
			};

			result[p, 0] := scores[order[n - 1]];
			result[p, 1] := fp->As(Float);
			result[p, 2] := tp->As(Float);

			return result;
		}

		function : SortDescending(scores : Float[]) ~ Int[] {
			n := scores->Size();
			idx := Int->New[n];
			each(i : n) {
				idx[i] := i;
			};

			# Merge sort rather than anything simpler: a quadratic sort on the
			# 125,973 rows of a benchmark like NSL-KDD would dominate every metric.
			buffer := Int->New[n];
			MergeRange(scores, idx, buffer, 0, n - 1);

			return idx;
		}

		function : MergeRange(scores : Float[], idx : Int[], buffer : Int[], lo : Int, hi : Int) ~ Nil {
			if(lo >= hi) {
				return;
			};

			mid := (lo + hi) / 2;
			MergeRange(scores, idx, buffer, lo, mid);
			MergeRange(scores, idx, buffer, mid + 1, hi);

			i := lo;
			j := mid + 1;
			p := lo;

			while(i <= mid & j <= hi) {
				# >= keeps equal scores in index order, so the result is stable and
				# the same input always produces the same points.
				if(scores[idx[i]] >= scores[idx[j]]) {
					buffer[p] := idx[i];
					i += 1;
				}
				else {
					buffer[p] := idx[j];
					j += 1;
				};
				p += 1;
			};

			while(i <= mid) {
				buffer[p] := idx[i];
				i += 1;
				p += 1;
			};

			while(j <= hi) {
				buffer[p] := idx[j];
				j += 1;
				p += 1;
			};

			for(q := lo; q <= hi; q += 1;) {
				idx[q] := buffer[q];
			};
		}

		#~
		The highest recall reachable without exceeding a false-positive rate.

		This is the number an analyst actually cares about: alerts arrive against a
		fixed budget, so "how many attacks do we catch while raising no more than
		one false alarm in a thousand" is the question, not accuracy.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@param max_fpr the false-positive rate that must not be exceeded, 0.0 to 1.0
		@return recall at the best qualifying operating point, or -1.0 on bad input

```
r := Metrics->RecallAtFpr(scores, actuals, 0.001);
"recall at 0.1% FPR: {$r}"->PrintLine();
```
		~#
		function : RecallAtFpr(scores : Float[], actuals : Bool[], max_fpr : Float) ~ Float {
			points := OperatingPoints(scores, actuals);
			if(points = Nil | max_fpr < 0.0 | max_fpr > 1.0) {
				return -1.0;
			};

			positives := CountPositives(actuals);
			negatives := actuals->Size() - positives;
			if(positives = 0 | negatives = 0) {
				return -1.0;
			};

			dims := points->Size();
			best := 0.0;
			each(i : dims[0]) {
				fpr := points[i, 1] / negatives->As(Float);
				if(fpr <= max_fpr) {
					tpr := points[i, 2] / positives->As(Float);
					if(tpr > best) {
						best := tpr;
					};
				};
			};

			return best;
		}

		#~
		The score threshold of the operating point RecallAtFpr selects.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@param max_fpr the false-positive rate that must not be exceeded
		@return the threshold to classify at, or 0.0 on bad input
		~#
		function : ThresholdAtFpr(scores : Float[], actuals : Bool[], max_fpr : Float) ~ Float {
			points := OperatingPoints(scores, actuals);
			if(points = Nil | max_fpr < 0.0 | max_fpr > 1.0) {
				return 0.0;
			};

			positives := CountPositives(actuals);
			negatives := actuals->Size() - positives;
			if(positives = 0 | negatives = 0) {
				return 0.0;
			};

			dims := points->Size();
			best := 0.0;
			threshold := 0.0;
			each(i : dims[0]) {
				fpr := points[i, 1] / negatives->As(Float);
				if(fpr <= max_fpr) {
					tpr := points[i, 2] / positives->As(Float);
					if(tpr > best) {
						best := tpr;
						threshold := points[i, 0];
					};
				};
			};

			return threshold;
		}

		#~
		Area under the ROC curve, by trapezoid over the operating points.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@return AUC in 0.0 to 1.0, or -1.0 on bad input
		~#
		function : AucRoc(scores : Float[], actuals : Bool[]) ~ Float {
			points := OperatingPoints(scores, actuals);
			if(points = Nil) {
				return -1.0;
			};

			positives := CountPositives(actuals);
			negatives := actuals->Size() - positives;
			if(positives = 0 | negatives = 0) {
				return -1.0;
			};

			dims := points->Size();
			area := 0.0;
			prev_fpr := 0.0;
			prev_tpr := 0.0;

			each(i : dims[0]) {
				fpr := points[i, 1] / negatives->As(Float);
				tpr := points[i, 2] / positives->As(Float);
				area += (fpr - prev_fpr) * (tpr + prev_tpr) / 2.0;
				prev_fpr := fpr;
				prev_tpr := tpr;
			};

			return area;
		}

		#~
		Average precision: the precision-recall curve summarised as the sum of
		precision at each point weighted by the recall it gained. Preferred over
		AUC-ROC when positives are rare, because it does not credit a model for
		the vast number of true negatives.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@return average precision in 0.0 to 1.0, or -1.0 on bad input
		~#
		function : AveragePrecision(scores : Float[], actuals : Bool[]) ~ Float {
			points := OperatingPoints(scores, actuals);
			if(points = Nil) {
				return -1.0;
			};

			positives := CountPositives(actuals);
			if(positives = 0) {
				return -1.0;
			};

			dims := points->Size();
			total := 0.0;
			prev_recall := 0.0;

			each(i : dims[0]) {
				tp := points[i, 2];
				fp := points[i, 1];
				recall := tp / positives->As(Float);
				precision := 0.0;
				if(tp + fp > 0.0) {
					precision := tp / (tp + fp);
				};
				total += (recall - prev_recall) * precision;
				prev_recall := recall;
			};

			return total;
		}

		#~
		The ROC curve as [threshold, false-positive rate, true-positive rate] rows,
		with the origin included so it can be plotted directly.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@return (points + 1) x 3 matrix, or Nil on bad input
		~#
		function : RocCurve(scores : Float[], actuals : Bool[]) ~ Float[,] {
			points := OperatingPoints(scores, actuals);
			if(points = Nil) {
				return Nil;
			};

			positives := CountPositives(actuals);
			negatives := actuals->Size() - positives;
			if(positives = 0 | negatives = 0) {
				return Nil;
			};

			dims := points->Size();
			rows := dims[0];
			result := Float->New[rows + 1, 3];

			# Row 0 is the origin: classify nothing as positive.
			result[0, 0] := points[0, 0];
			result[0, 1] := 0.0;
			result[0, 2] := 0.0;

			each(i : rows) {
				result[i + 1, 0] := points[i, 0];
				result[i + 1, 1] := points[i, 1] / negatives->As(Float);
				result[i + 1, 2] := points[i, 2] / positives->As(Float);
			};

			return result;
		}

		#~
		The precision-recall curve as [threshold, recall, precision] rows.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@return points x 3 matrix, or Nil on bad input
		~#
		function : PrCurve(scores : Float[], actuals : Bool[]) ~ Float[,] {
			points := OperatingPoints(scores, actuals);
			if(points = Nil) {
				return Nil;
			};

			positives := CountPositives(actuals);
			if(positives = 0) {
				return Nil;
			};

			dims := points->Size();
			rows := dims[0];
			result := Float->New[rows, 3];

			each(i : rows) {
				tp := points[i, 2];
				fp := points[i, 1];
				result[i, 0] := points[i, 0];
				result[i, 1] := tp / positives->As(Float);
				result[i, 2] := 0.0;
				if(tp + fp > 0.0) {
					result[i, 2] := tp / (tp + fp);
				};
			};

			return result;
		}

		function : CountPositives(actuals : Bool[]) ~ Int {
			count := 0;
			each(i : actuals) {
				if(actuals[i]) {
					count += 1;
				};
			};

			return count;
		}

		#~
		Recall, false-positive rate and precision at ONE given threshold.

		The counterpart to RecallAtFpr. That one searches for the operating point
		fitting a false-alarm budget; this one is handed a threshold and reports what
		it actually does. Both are needed to answer whether a threshold chosen on one
		set still honours its budget on another: the budget is intended, the rate
		reported here is what happened.

		An instance counts as predicted positive when its score is >= threshold. That
		matches OperatingPoints, which accumulates from the highest score down and
		lets instances sharing a score share an operating point, so a threshold from
		ThresholdAtFpr can be passed straight here.

		Every rate is guarded. A float division by zero raises in Objeck and would
		take the program down, and the degenerate cases are ordinary: a threshold
		above every score predicts nothing positive, leaving precision with no
		denominator.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@param threshold the cutoff to apply
		@return the counts and rates, or Nil when the inputs do not line up
		~#
		function : AtThreshold(scores : Float[], actuals : Bool[], threshold : Float) ~ ThresholdResult {
			if(scores = Nil | actuals = Nil) {
				return Nil;
			};
			if(scores->Size() <> actuals->Size() | scores->Size() = 0) {
				return Nil;
			};

			tp := 0;
			fp := 0;
			fn := 0;
			tn := 0;
			each(i : scores) {
				if(scores[i] >= threshold) {
					if(actuals[i]) {
						tp += 1;
					}
					else {
						fp += 1;
					};
				}
				else {
					if(actuals[i]) {
						fn += 1;
					}
					else {
						tn += 1;
					};
				};
			};

			return ThresholdResult->New(threshold, tp, fp, fn, tn);
		}

		#~
		A percentile of a set of values, by linear interpolation.

		Used for bootstrap intervals, and exposed because a caller resampling a
		statistic this bundle does not implement still needs the interval.

		p is clamped rather than rejected: 0.0 gives the minimum and 1.0 the maximum,
		which is what a caller asking for them wants.
		@param values the sample; not modified
		@param p the percentile in [0,1]
		@return the percentile, or 0.0 for an empty sample
		~#
		function : Percentile(values : Float[], p : Float) ~ Float {
			if(values = Nil | values->Size() = 0) {
				return 0.0;
			};

			n := values->Size();
			if(n = 1) {
				return values[0];
			};

			q := p;
			if(q < 0.0) {
				q := 0.0;
			};
			if(q > 1.0) {
				q := 1.0;
			};

			# SortDescending returns indexes, so the ascending k-th value sits at
			# order[n-1-k]. Reusing it avoids a second sort implementation.
			order := SortDescending(values);
			if(order = Nil) {
				return 0.0;
			};

			pos := q * (n - 1)->As(Float);
			lo_k := pos->As(Int);
			if(lo_k >= n - 1) {
				return values[order[0]];
			};

			frac := pos - lo_k->As(Float);
			a := values[order[n - 1 - lo_k]];
			b := values[order[n - 2 - lo_k]];

			return a + frac * (b - a);
		}

		#~
		A bootstrap percentile confidence interval for a metric.

		Resamples the scored instances WITH REPLACEMENT reps times, recomputes the
		metric on each resample, and takes percentiles of that distribution. The point
		estimate is the metric on the original sample, not the mean of the resamples.

		Resampling pairs, not scores: a resample draws (score, label) together, so the
		class balance moves between resamples the way it would between samples. That
		is the variability being estimated, and it matters most where it is largest --
		a false-alarm budget of 0.001 on a 10,000-row test set is about ten false
		positives, and ten is a count whose uncertainty is not negligible.

		A resample can contain only one class, which leaves AUC undefined. The metrics
		here report that as a NEGATIVE value rather than a real score, so those
		resamples are discarded rather than averaged in -- folding a sentinel into the
		distribution would drag the interval toward it. The number that survived is
		reported, because an interval built from a small fraction of the requested
		resamples is not the interval that was asked for.
		@param metric the statistic to resample
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@param reps how many resamples to draw
		@param seed seeds the resampling, so a run can be repeated
		@param level the interval width, e.g. 0.95
		@return the interval, or Nil on bad input or fewer than two usable resamples
		~#
		function : Bootstrap(metric : ScoreMetric, scores : Float[], actuals : Bool[], reps : Int, seed : Int, level : Float) ~ ConfInterval {
			if(metric = Nil | scores = Nil | actuals = Nil) {
				return Nil;
			};
			if(scores->Size() <> actuals->Size() | scores->Size() = 0) {
				return Nil;
			};
			if(reps < 2 | level <= 0.0 | level >= 1.0) {
				return Nil;
			};

			n := scores->Size();
			draws := Float->New[reps];
			bs := Float->New[n];
			by := Bool->New[n];
			rnd := Random->New(seed);
			usable := 0;
			j : Int;
			v : Float;

			each(r : reps) {
				each(i : n) {
					j := rnd->NextInt(n);
					bs[i] := scores[j];
					by[i] := actuals[j];
				};
				v := metric->Compute(bs, by);
				if(v >= 0.0) {
					draws[usable] := v;
					usable += 1;
				};
			};

			if(usable < 2) {
				return Nil;
			};

			# percentiles over the usable prefix only
			kept := Float->New[usable];
			each(i : usable) {
				kept[i] := draws[i];
			};

			tail := (1.0 - level) / 2.0;
			lo := Percentile(kept, tail);
			hi := Percentile(kept, 1.0 - tail);
			point := metric->Compute(scores, actuals);

			return ConfInterval->New(point, lo, hi, level, reps, usable);
		}

		#~
		A bootstrap interval at the conventional 95% level.
		@param metric the statistic to resample
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@param reps how many resamples to draw
		@param seed seeds the resampling
		@return the interval, or Nil on bad input
		~#
		function : Bootstrap(metric : ScoreMetric, scores : Float[], actuals : Bool[], reps : Int, seed : Int) ~ ConfInterval {
			return Bootstrap(metric, scores, actuals, reps, seed, 0.95);
		}
	}

	#~
	Cross-validation utilities for model evaluation
	~#
	class CrossValidation {
		#~
		Splits data into K folds for cross-validation
		@param data input matrix
		@param k number of folds
		@return array of K fold indices
		~#
		function : native : KFold(data : Float[,], k : Int) ~ Vector[]<IntRef> {
			dims := data->Size();
			rows := dims[0];

			if(k <= 0 | k > rows) {
				return Nil;
			};

			fold_size := rows / k;
			indices := Int->New[rows];
			each(i : rows) {
				indices[i] := i;
			};

			# Shuffle indices
			each(i : rows) {
				j := (rows - 1)->Random();
				temp := indices[i];
				indices[i] := indices[j];
				indices[j] := temp;
			};

			# Create folds
			folds := Vector->New[k]<IntRef>;
			each(fold : k) {
				fold_indices := Vector->New()<IntRef>;
				start := fold * fold_size;
				ending := fold = k - 1 ? rows : (fold + 1) * fold_size;

				for(i := start; i < ending; i += 1;) {
					fold_indices->AddBack(indices[i]);
				};

				folds[fold] := fold_indices;
			};

			return folds;
		}

		#~
		Splits row indices into K folds that each keep the class ratio of the whole,
		shuffled from a caller-supplied seed so the same seed gives the same folds.

		KFold above shuffles with the global generator and ignores labels. Both hurt
		on imbalanced data: an unseeded split cannot be reproduced, and an unstratified
		split lets the rare class land unevenly, so a fold may hold too few positives
		to measure anything at a low false-positive rate. Intrusion-detection sets are
		exactly that shape.

		Classes are taken from the label values as they first appear. Each class is
		shuffled independently and dealt round-robin across the folds, continuing from
		where the previous class stopped, so a remainder cannot pile into fold 0.
		@param labels one label per row; only the labels are needed to stratify
		@param k number of folds, at least 2
		@param seed shuffle seed; the same seed reproduces the same folds
		@return k vectors of row indices, or Nil on bad input

```
folds := CrossValidation->StratifiedKFold(y, 5, 42);
each(f : folds) {
  test_rows := folds[f];
};
```
		~#
		function : StratifiedKFold(labels : Float[], k : Int, seed : Int) ~ Vector[]<IntRef> {
			if(labels = Nil) {
				return Nil;
			};

			rows := labels->Size();
			if(k < 2 | k > rows) {
				return Nil;
			};

			# Hoisted: a local declared inside a nested block and read outside it is
			# a known way to fault in this compiler.
			found : Int;
			n : Int;
			p : Int;
			t : Int;
			j : Int;
			idx : Int[];

			# Distinct class values, in first-seen order, and each row's class.
			class_values := Float->New[rows];
			class_of := Int->New[rows];
			class_count := 0;

			each(i : rows) {
				found := -1;
				each(c : class_count) {
					if(class_values[c] = labels[i]) {
						found := c;
					};
				};

				if(found < 0) {
					class_values[class_count] := labels[i];
					found := class_count;
					class_count += 1;
				};

				class_of[i] := found;
			};

			folds := Vector->New[k]<IntRef>;
			each(f : k) {
				folds[f] := Vector->New()<IntRef>;
			};

			state := seed;
			next_fold := 0;

			each(c : class_count) {
				n := 0;
				each(i : rows) {
					if(class_of[i] = c) {
						n += 1;
					};
				};

				idx := Int->New[n];
				p := 0;
				each(i : rows) {
					if(class_of[i] = c) {
						idx[p] := i;
						p += 1;
					};
				};

				# Fisher-Yates from the seed. A local generator rather than the global
				# one, because the point of the seed is that another machine, and a
				# later run, produce the same folds.
				for(i := n - 1; i > 0; i -= 1;) {
					state := (state * 1103515245 + 12345) and 2147483647;
					j := state % (i + 1);
					t := idx[i];
					idx[i] := idx[j];
					idx[j] := t;
				};

				each(i : n) {
					folds[next_fold]->AddBack(idx[i]);
					next_fold := (next_fold + 1) % k;
				};
			};

			return folds;
		}

		#~
		Splits data into training and test sets
		@param data input matrix
		@param test_ratio percentage of data for testing (0.0 to 1.0)
		@return array with [training_data, test_data]
		~#
		function : native : TrainTestSplit(data : Float[,], test_ratio : Float) ~ FloatMatrixRef[] {
			if(test_ratio <= 0.0 | test_ratio >= 1.0) {
				return Nil;
			};

			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			test_size := (rows->As(Float) * test_ratio)->As(Int);
			train_size := rows - test_size;

			# Shuffle indices
			indices := Int->New[rows];
			each(i : rows) {
				indices[i] := i;
			};

			each(i : rows) {
				j := (rows - 1)->Random();
				temp := indices[i];
				indices[i] := indices[j];
				indices[j] := temp;
			};

			# Split data
			train_data := Float->New[train_size, cols];
			test_data := Float->New[test_size, cols];

			each(i : train_size) {
				idx := indices[i];
				each(j : cols) {
					train_data[i, j] := data[idx, j];
				};
			};

			for(i := train_size; i < rows; i += 1;) {
				idx := indices[i];
				each(j : cols) {
					test_data[i - train_size, j] := data[idx, j];
				};
			};

			result := FloatMatrixRef->New[2];
			result[0] := FloatMatrixRef->New(train_data);
			result[1] := FloatMatrixRef->New(test_data);

			return result;
		}

		#~
		Converts scored labels to the Bool[] the classifiers and Metrics take.

		TableEncoder hands back Float[] and StratifiedKFold wants that form, but
		every classifier Fit and every Metrics function takes Bool[]. Without
		this, each caller keeps both representations alive and writes the same
		conversion loop.
		@param labels one value per row; anything above 0.5 is the positive class
		@return one Bool per row, or Nil for Nil input
		~#
		function : ToBool(labels : Float[]) ~ Bool[] {
			if(labels = Nil) {
				return Nil;
			};

			result := Bool->New[labels->Size()];
			each(i : labels) {
				result[i] := labels[i] > 0.5;
			};

			return result;
		}

		#~
		Converts Bool labels to the Float[] StratifiedKFold takes.
		@param labels one label per row
		@return 1.0 for true and 0.0 for false, or Nil for Nil input
		~#
		function : ToFloat(labels : Bool[]) ~ Float[] {
			if(labels = Nil) {
				return Nil;
			};

			result := Float->New[labels->Size()];
			each(i : labels) {
				if(labels[i]) {
					result[i] := 1.0;
				};
			};

			return result;
		}

		#~
		Builds the train/test matrices for one fold.

		StratifiedKFold returns row indexes; turning those into matrices is about
		twenty lines of copying that every experiment otherwise rewrites, and
		getting it subtly wrong shifts labels against features without any
		error.
		Takes ONE fold's row indexes rather than the whole array plus an index:
		a `Vector[]<T>` parameter compiles inside a library but does not resolve
		across a library boundary, so the caller passes `folds[i]`.
		@param X rows x features
		@param y one label per row
		@param test_rows row indexes for the test split, i.e. folds[i]
		@return the split, or Nil on bad input
		~#
		function : Split(X : Float[,], y : Bool[], test_rows : Vector<IntRef>) ~ FoldSplit {
			if(X = Nil | y = Nil | test_rows = Nil) {
				return Nil;
			};

			dims := X->Size();
			rows := dims[0];
			cols := dims[1];
			if(rows < 1 | cols < 1 | y->Size() <> rows) {
				return Nil;
			};

			test_idx := test_rows;
			n_test := test_idx->Size();
			n_train := rows - n_test;
			if(n_test < 1 | n_train < 1) {
				return Nil;
			};

			in_test := Bool->New[rows];
			row : Int;
			each(f : n_test) {
				row := test_idx->Get(f)->Get();
				if(row < 0 | row >= rows) {
					return Nil;
				};
				in_test[row] := true;
			};

			train_x := Float->New[n_train, cols];
			train_y := Bool->New[n_train];
			test_x := Float->New[n_test, cols];
			test_y := Bool->New[n_test];
			# recorded as the matrix is filled, so the mapping is exact rather than
			# reconstructed by a caller who has to know this loop walks in order
			test_map := Int->New[n_test];
			ti := 0;
			si := 0;
			each(i : rows) {
				if(in_test[i]) {
					each(c : cols) {
						test_x[si, c] := X[i, c];
					};
					test_y[si] := y[i];
					test_map[si] := i;
					si += 1;
				}
				else {
					each(c : cols) {
						train_x[ti, c] := X[i, c];
					};
					train_y[ti] := y[i];
					ti += 1;
				};
			};

			return FoldSplit->New(train_x, train_y, test_x, test_y, test_map);
		}

		#~
		Runs stratified k-fold cross-validation and reports per-fold scores.

		The model is refitted on each fold's training split, so it is left
		holding the last fold's fit. Standardization, when asked for, fits the
		scaler on the TRAINING split only and reapplies it to the test split --
		scaling test data by its own statistics leaks the test distribution and
		flatters any model measured at a fixed false-alarm rate.
		@param model anything that fits on Bool labels and scores rows
		@param X rows x features
		@param y one label per row
		@param k folds
		@param seed seeds the fold assignment, so a run can be repeated
		@param max_fpr the false-alarm budget recall is measured at
		@param standardize fit a FeatureScaler on each training split
		@return per-fold and averaged scores, or Nil on bad input
		~#
		function : Evaluate(model : ScoreModel, X : Float[,], y : Bool[], k : Int, seed : Int, max_fpr : Float, standardize : Bool) ~ CrossValResult {
			if(y = Nil) {
				return Nil;
			};

			return Evaluate(model, X, y, k, seed, max_fpr, standardize, ToFloat(y));
		}

		#~
		Cross-validation whose folds are stratified by a key of your choosing.
		
		The overload above stratifies by the binary label, which keeps the
		positive rate steady across folds but says nothing about what the
		positives are made of. When the positive class is a union of rare
		sub-populations -- attack families, fault types, device models -- a fold
		can be balanced on the label and still hold none of a sub-population that
		only has a few dozen members. Pass those category codes as strata and
		each fold keeps their proportions too.
		
		strata is a fold-assignment key only. The model still fits and scores
		against y, so the metrics are unchanged.
		@param model anything that fits on Bool labels and scores rows
		@param X rows x features
		@param y one label per row
		@param k folds
		@param seed seeds the fold assignment, so a run can be repeated
		@param max_fpr the false-alarm budget recall is measured at
		@param standardize fit a FeatureScaler on each training split
		@param strata one code per row; folds preserve its distribution
		@return per-fold scores, averages and pooled out-of-fold scores, or Nil
		on bad input
		~#
		function : Evaluate(model : ScoreModel, X : Float[,], y : Bool[], k : Int, seed : Int, max_fpr : Float, standardize : Bool, strata : Float[]) ~ CrossValResult {
			if(model = Nil | X = Nil | y = Nil | strata = Nil | k < 2) {
				return Nil;
			};

			dims := X->Size();
			rows := dims[0];
			if(rows < k | y->Size() <> rows | strata->Size() <> rows) {
				return Nil;
			};

			folds := StratifiedKFold(strata, k, seed);
			if(folds = Nil) {
				return Nil;
			};

			aucs := Float->New[k];
			recalls := Float->New[k];
			aps := Float->New[k];
			oof := Float->New[rows];

			split : FoldSplit;
			test_rows : Int[];
			train_x : Float[,];
			test_x : Float[,];
			scaler : FeatureScaler;
			scores : Float[];

			each(f : k) {
				split := Split(X, y, folds[f]);
				if(split = Nil) {
					return Nil;
				};

				train_x := split->GetTrainX();
				test_x := split->GetTestX();

				if(standardize) {
					scaler := FeatureScaler->New();
					if(<>scaler->Fit(train_x)) {
						return Nil;
					};
					train_x := scaler->Transform(train_x);
					test_x := scaler->Transform(test_x);
					if(train_x = Nil | test_x = Nil) {
						return Nil;
					};
				};

				if(<>model->Fit(train_x, split->GetTrainY())) {
					return Nil;
				};

				scores := model->PredictScore(test_x);
				if(scores = Nil) {
					return Nil;
				};

				aucs[f] := Metrics->AucRoc(scores, split->GetTestY());
				recalls[f] := Metrics->RecallAtFpr(scores, split->GetTestY(), max_fpr);
				aps[f] := Metrics->AveragePrecision(scores, split->GetTestY());

				# scatter this fold's scores back to the rows they belong to. Split
				# reports the mapping, so this does not depend on the order
				# StratifiedKFold happened to return the fold in.
				test_rows := split->GetTestRows();
				if(test_rows = Nil | test_rows->Size() <> scores->Size()) {
					return Nil;
				};
				each(t : test_rows) {
					oof[test_rows[t]] := scores[t];
				};
			};

			return CrossValResult->New(aucs, recalls, aps, oof);
		}

		#~
		Cross-validation with standardization on, which is the usual case.
		@param model anything that fits on Bool labels and scores rows
		@param X rows x features
		@param y one label per row
		@param k folds
		@param seed seeds the fold assignment
		@param max_fpr the false-alarm budget recall is measured at
		@return per-fold and averaged scores, or Nil on bad input
		~#
		function : Evaluate(model : ScoreModel, X : Float[,], y : Bool[], k : Int, seed : Int, max_fpr : Float) ~ CrossValResult {
			return Evaluate(model, X, y, k, seed, max_fpr, true);
		}
	}

	#~
	Anything that fits on binary labels and scores rows.

	DecisionTreeClassifier, RandomForestClassifier and GradientBoostedClassifier
	all implement it, so CrossValidation->Evaluate takes any of them without
	knowing which.

	Scoring rather than predicting is the point: a Bool prediction fixes one
	operating point and cannot answer what recall would be at another, which is
	the whole question when alerts arrive against a fixed false-alarm budget.
	~#
	interface ScoreModel {
		#~
		Fits the model.
		@param X rows x features
		@param y one label per row, true for the positive class
		@return true when the fit succeeded
		~#
		method : virtual : public : Fit(X : Float[,], y : Bool[]) ~ Bool;

		#~
		Scores each row; higher means more positive.
		@param X rows x features
		@return one score per row, or Nil when unfitted
		~#
		method : virtual : public : PredictScore(X : Float[,]) ~ Float[];
	}

	#~
	The train and test matrices for one cross-validation fold.
	~#
	class FoldSplit {
		@train_x : Float[,];
		@train_y : Bool[];
		@test_x : Float[,];
		@test_y : Bool[];
		@test_rows : Int[];

		New(train_x : Float[,], train_y : Bool[], test_x : Float[,], test_y : Bool[]) {
			@train_x := train_x;
			@train_y := train_y;
			@test_x := test_x;
			@test_y := test_y;
		}

		New(train_x : Float[,], train_y : Bool[], test_x : Float[,], test_y : Bool[], test_rows : Int[]) {
			@train_x := train_x;
			@train_y := train_y;
			@test_x := test_x;
			@test_y := test_y;
			@test_rows := test_rows;
		}

		method : public : GetTrainX() ~ Float[,] { return @train_x; }
		method : public : GetTrainY() ~ Bool[] { return @train_y; }
		method : public : GetTestX() ~ Float[,] { return @test_x; }
		method : public : GetTestY() ~ Bool[] { return @test_y; }

		#~
		The original row index of each row of the test split, in the order the
		test matrix holds them.
		
		Needed to map a fold score back to the record it belongs to, which is how
		an out-of-fold score vector is assembled. Split builds the test matrix by
		walking rows 0..n against a membership mask, so these come back ASCENDING
		and NOT in the order StratifiedKFold returned -- that order is shuffled.
		Without this accessor the obvious caller code pairs scores[k] with the
		k'th index of the fold vector, which silently scrambles them: measured on
		a 3000-row set, a pooled AUC of 0.997 read 0.539 -- chance -- while every
		per-fold AUC still read 0.99, so nothing looked wrong.
		@return one original row index per test row, or Nil from the 4-argument
		constructor
		~#
		method : public : GetTestRows() ~ Int[] { return @test_rows; }

		#~
		Rows in the training split.
		@return training row count
		~#
		method : public : GetTrainSize() ~ Int {
			if(@train_y = Nil) {
				return 0;
			};

			return @train_y->Size();
		}

		#~
		Rows in the test split.
		@return test row count
		~#
		method : public : GetTestSize() ~ Int {
			if(@test_y = Nil) {
				return 0;
			};

			return @test_y->Size();
		}
	}

	#~
	Cross-validation scores, per fold and averaged.

	The averages are the numbers to report. A single fold's AUC is extremely
	noisy when the positive class is rare -- on a 200-row set with 10% positives
	a fold holds about four positives, and shuffled labels have produced a
	single-fold AUC of 0.68 by chance alone. The spread is given alongside the
	mean so that noise is visible rather than implied.
	~#

	#~
	What a threshold actually did: the four confusion counts and the rates read
	off them.

	A separate type rather than a bare array because these numbers are only
	meaningful together. Recall without the false-positive rate says nothing
	about cost, and a rate without the count behind it hides how few instances it
	rests on -- a recall of 1.0 over two positives is not the same claim as a
	recall of 1.0 over two thousand.
	~#
	class ThresholdResult {
		@threshold : Float;
		@tp : Int;
		@fp : Int;
		@fn : Int;
		@tn : Int;

		New(threshold : Float, tp : Int, fp : Int, fn : Int, tn : Int) {
			@threshold := threshold;
			@tp := tp;
			@fp := fp;
			@fn := fn;
			@tn := tn;
		}

		method : public : GetThreshold() ~ Float { return @threshold; }
		method : public : GetTruePositives() ~ Int { return @tp; }
		method : public : GetFalsePositives() ~ Int { return @fp; }
		method : public : GetFalseNegatives() ~ Int { return @fn; }
		method : public : GetTrueNegatives() ~ Int { return @tn; }

		#~
		Detected positives over all real positives, also the true-positive rate.
		@return the recall, or 0.0 when there are no real positives
		~#
		method : public : GetRecall() ~ Float {
			den := @tp + @fn;
			if(den = 0) {
				return 0.0;
			};

			return @tp->As(Float) / den->As(Float);
		}

		#~
		Real negatives wrongly flagged, over all real negatives.
		
		The number to compare against an intended budget. A threshold picked to
		hold a budget on one sample has no obligation to hold it on another, and
		this is how far it drifted.
		@return the false-positive rate, or 0.0 when there are no real negatives
		~#
		method : public : GetFpr() ~ Float {
			den := @fp + @tn;
			if(den = 0) {
				return 0.0;
			};

			return @fp->As(Float) / den->As(Float);
		}

		#~
		Alerts that were real, over all alerts raised.
		
		Measured on this sample, so it carries this sample's class balance. When
		the deployment balance differs -- and for rare events it usually does --
		the precision an operator would see is different, and follows from the
		recall and false-positive rate rather than from this number.
		@return the precision, or 0.0 when nothing was flagged
		~#
		method : public : GetPrecision() ~ Float {
			den := @tp + @fp;
			if(den = 0) {
				return 0.0;
			};

			return @tp->As(Float) / den->As(Float);
		}

		#~
		Correct decisions over all decisions.
		
		Included for completeness and deliberately not the number to report when
		one class dominates: predicting the majority for everything scores well
		here while detecting nothing.
		@return the accuracy, or 0.0 for an empty sample
		~#
		method : public : GetAccuracy() ~ Float {
			den := @tp + @fp + @fn + @tn;
			if(den = 0) {
				return 0.0;
			};

			return (@tp + @tn)->As(Float) / den->As(Float);
		}

		method : public : ToString() ~ String {
			r := GetRecall();
			f := GetFpr();
			p := GetPrecision();
			return "threshold={$@threshold} recall={$r} fpr={$f} precision={$p} tp={$@tp} fp={$@fp} fn={$@fn} tn={$@tn}";
		}
	}

	#~
	A statistic over scored instances, so it can be resampled without Bootstrap
	knowing which one it is.

	An interface rather than a function reference, matching ScoreModel and
	Compare elsewhere in the bundle.

	A metric MUST return a negative value when the sample cannot support it --
	AUC over a resample that drew only one class, for example. Bootstrap discards
	those rather than averaging them in. Returning 0.0 instead would be read as a
	real score of zero and pull the interval down.
	~#
	interface ScoreMetric {
		#~
		Computes the statistic.
		@param scores one score per instance; higher means more positive
		@param actuals true where the instance really is positive
		@return the value, or a negative number when the sample cannot support it
		~#
		method : virtual : public : Compute(scores : Float[], actuals : Bool[]) ~ Float;
	}

	#~
	Area under the ROC curve, as a resampleable metric.
	~#
	class AucMetric implements ScoreMetric {
		New() {
		}

		method : public : Compute(scores : Float[], actuals : Bool[]) ~ Float {
			return Metrics->AucRoc(scores, actuals);
		}
	}

	#~
	Recall at a fixed false-alarm budget, as a resampleable metric.

	The budget is fixed at construction so Bootstrap can resample it without
	knowing the metric takes a parameter.
	~#
	class RecallAtFprMetric implements ScoreMetric {
		@max_fpr : Float;

		New(max_fpr : Float) {
			@max_fpr := max_fpr;
		}

		method : public : Compute(scores : Float[], actuals : Bool[]) ~ Float {
			if(scores = Nil | actuals = Nil) {
				return -1.0;
			};

			# RecallAtFpr answers 0.0 for a sample with one class, which is a real
			# recall value; the resample has to be rejected instead
			positives := Metrics->CountPositives(actuals);
			if(positives = 0 | positives = actuals->Size()) {
				return -1.0;
			};

			return Metrics->RecallAtFpr(scores, actuals, @max_fpr);
		}
	}

	#~
	Average precision, as a resampleable metric.
	~#
	class AveragePrecisionMetric implements ScoreMetric {
		New() {
		}

		method : public : Compute(scores : Float[], actuals : Bool[]) ~ Float {
			if(scores = Nil | actuals = Nil) {
				return -1.0;
			};

			positives := Metrics->CountPositives(actuals);
			if(positives = 0 | positives = actuals->Size()) {
				return -1.0;
			};

			return Metrics->AveragePrecision(scores, actuals);
		}
	}

	#~
	A bootstrap percentile interval.

	Carries the requested and usable resample counts alongside the bounds. When
	those differ, the interval was built from fewer draws than asked for, because
	some resamples drew only one class and could not support the metric. An
	interval from a small fraction of the request is not the interval that was
	requested, and the only way to notice is for the number to travel with it.
	~#
	class ConfInterval {
		@point : Float;
		@low : Float;
		@high : Float;
		@level : Float;
		@reps : Int;
		@usable : Int;

		New(point : Float, low : Float, high : Float, level : Float, reps : Int, usable : Int) {
			@point := point;
			@low := low;
			@high := high;
			@level := level;
			@reps := reps;
			@usable := usable;
		}

		#~
		The metric on the original sample, not the mean of the resamples.
		@return the point estimate
		~#
		method : public : GetPoint() ~ Float { return @point; }

		method : public : GetLow() ~ Float { return @low; }
		method : public : GetHigh() ~ Float { return @high; }
		method : public : GetLevel() ~ Float { return @level; }

		#~
		Resamples requested.
		@return the requested count
		~#
		method : public : GetReps() ~ Int { return @reps; }

		#~
		Resamples the metric could actually be computed on.
		
		Below GetReps when some resample drew a single class. Worth checking on
		rare positives: at a few dozen positives in a large sample, a noticeable
		share of resamples can miss them entirely.
		@return the usable count
		~#
		method : public : GetUsableReps() ~ Int { return @usable; }

		#~
		Width of the interval.
		@return high minus low
		~#
		method : public : GetWidth() ~ Float { return @high - @low; }

		method : public : ToString() ~ String {
			pct := (@level * 100.0)->As(Int);
			return "{$@point} ({$pct}% CI [{$@low}, {$@high}], {$@usable}/{$@reps} resamples)";
		}
	}

	class CrossValResult {
		@aucs : Float[];
		@recalls : Float[];
		@aps : Float[];
		@oof : Float[];

		New(aucs : Float[], recalls : Float[], aps : Float[]) {
			@aucs := aucs;
			@recalls := recalls;
			@aps := aps;
		}

		New(aucs : Float[], recalls : Float[], aps : Float[], oof : Float[]) {
			@aucs := aucs;
			@recalls := recalls;
			@aps := aps;
			@oof := oof;
		}

		method : public : GetFoldAucs() ~ Float[] { return @aucs; }
		method : public : GetFoldRecalls() ~ Float[] { return @recalls; }
		method : public : GetFoldAveragePrecisions() ~ Float[] { return @aps; }

		#~
		One out-of-fold score per input row, in input row order.
		
		Each score comes from the fold model that did NOT train on that row, so
		the vector can be thresholded as a whole without leaking a row into its
		own score. That is what makes it the right input for choosing an
		operating point: ThresholdAtFpr over these scores picks a threshold
		honestly, and it can then be applied unchanged to held-out data.
		
		Reported separately from the per-fold means because they answer different
		questions. The fold means say how much the estimate moves between folds;
		the pooled vector gives one curve over every row, which is what a single
		threshold has to be chosen from.
		@return the pooled scores, or Nil from the 3-argument constructor
		~#
		method : public : GetOofScores() ~ Float[] { return @oof; }

		#~
		How many folds were run.
		@return fold count
		~#
		method : public : GetFolds() ~ Int {
			if(@aucs = Nil) {
				return 0;
			};

			return @aucs->Size();
		}

		method : public : GetMeanAuc() ~ Float { return Mean(@aucs); }
		method : public : GetMeanRecall() ~ Float { return Mean(@recalls); }
		method : public : GetMeanAveragePrecision() ~ Float { return Mean(@aps); }

		#~
		Spread of the per-fold AUCs, as a sample standard deviation.

		Sample rather than population, unlike FeatureScaler: these are k
		observations of a quantity whose variability is being estimated, not a
		whole population being standardized. With one fold it is undefined and
		0.0 is returned rather than dividing by k-1 = 0, which Objeck raises on.
		@return the spread, or 0.0 for fewer than two folds
		~#
		method : public : GetStdAuc() ~ Float { return Spread(@aucs); }

		#~
		Spread of the per-fold recalls.
		@return the spread, or 0.0 for fewer than two folds
		~#
		method : public : GetStdRecall() ~ Float { return Spread(@recalls); }

		method : Mean(values : Float[]) ~ Float {
			if(values = Nil | values->Size() = 0) {
				return 0.0;
			};

			total := 0.0;
			each(i : values) {
				total += values[i];
			};

			return total / values->Size()->As(Float);
		}

		method : Spread(values : Float[]) ~ Float {
			if(values = Nil | values->Size() < 2) {
				return 0.0;
			};

			avg := Mean(values);
			sum_sq := 0.0;
			each(i : values) {
				diff := values[i] - avg;
				sum_sq += diff * diff;
			};

			return Float->Sqrt(sum_sq / (values->Size() - 1)->As(Float));
		}

		#~
		A one-line summary in the form the write-up wants.
		@return e.g. "AUC 0.941 +/- 0.023 over 5 folds"
		~#
		method : public : ToString() ~ String {
			n := GetFolds();
			if(n = 0) {
				return "no folds";
			};

			a := GetMeanAuc();
			s := GetStdAuc();

			return "AUC {$a} +/- {$s} over {$n} folds";
		}
	}
}
