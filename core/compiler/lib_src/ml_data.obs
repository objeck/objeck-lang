use Collection;
use Data.CSV;

#~
Data preparation and evaluation: FeatureScaler, Metrics, CrossValidation and PCA decomposition. Compile with -lib ml.
~#
bundle System.ML {
	#~
	Principal component analysis via power iteration with deflation on the
	sample covariance matrix. Deterministic (fixed initialization vector).
	Components are unit-length rows of a k x d matrix; sign is arbitrary.

```
pca := PCA->New(1);
pca->Fit(X);
reduced := pca->Transform(X);          # n x 1
ratios := pca->GetExplainedVarianceRatio();
```
	~#
	class PCA {
		@num_components : Int;
		@mean : Float[];
		@components : Float[,];
		@eigenvalues : Float[];
		@total_variance : Float;
		@is_fitted : Bool;

		#~
		Constructor
		@param num_components number of principal components to keep
		~#
		New(num_components : Int) {
			@num_components := num_components;
			@is_fitted := false;
		}

		New : private (num_components : Int, mean : Float[], components : Float[,], eigenvalues : Float[], total_variance : Float) {
			@num_components := num_components;
			@mean := mean;
			@components := components;
			@eigenvalues := eigenvalues;
			@total_variance := total_variance;
			@is_fitted := true;
		}

		#~
		Fits the decomposition: centers the data, builds the sample covariance
		matrix and extracts the top components by power iteration + deflation.
		@param X data matrix (rows=samples, cols=features)
		@return true if fitting succeeded
		~#
		method : public : Fit(X : Float[,]) ~ Bool {
			if(X = Nil) {
				return false;
			};

			x_dims := X->Size();
			rows := x_dims[0];
			cols := x_dims[1];
			if(rows < 2 | cols = 0 | @num_components < 1 | @num_components > cols) {
				return false;
			};

			n := rows->As(Float);

			# center the data
			@mean := Float->New[cols];
			each(j : cols) {
				sum := 0.0;
				each(i : rows) {
					sum += X[i,j];
				};
				@mean[j] := sum / n;
			};

			centered := Float->New[rows, cols];
			each(i : rows) {
				each(j : cols) {
					centered[i,j] := X[i,j] - @mean[j];
				};
			};

			# sample covariance: C = X'X / (n - 1)
			cov := Float->New[cols, cols];
			each(a : cols) {
				each(b : cols) {
					sum := 0.0;
					each(i : rows) {
						sum += centered[i,a] * centered[i,b];
					};
					cov[a,b] := sum / (n - 1.0);
				};
			};

			@total_variance := 0.0;
			each(j : cols) {
				@total_variance += cov[j,j];
			};

			# power iteration with deflation for the top components
			@components := Float->New[@num_components, cols];
			@eigenvalues := Float->New[@num_components];

			each(c : @num_components) {
				# deterministic non-degenerate initialization
				v := Float->New[cols];
				each(j : cols) {
					v[j] := 1.0 / (j + 1)->As(Float);
				};
				Normalize(v);

				each(iter : 1000) {
					next := Float->New[cols];
					each(a : cols) {
						sum := 0.0;
						each(b : cols) {
							sum += cov[a,b] * v[b];
						};
						next[a] := sum;
					};

					# re-orthogonalize against the components already found so
					# residual deflation error cannot accumulate across
					# components (keeps the basis orthonormal to machine
					# precision, which full-rank reconstruction relies on)
					for(p := 0; p < c; p += 1;) {
						proj := 0.0;
						each(j : cols) {
							proj += next[j] * @components[p,j];
						};
						each(j : cols) {
							next[j] -= proj * @components[p,j];
						};
					};

					norm := Normalize(next);
					if(norm = 0.0) {
						# no remaining variance in this direction
						each(j : cols) {
							next[j] := v[j];
						};
					};

					# converged when the direction stops moving (sign-agnostic)
					dot := 0.0;
					each(j : cols) {
						dot += next[j] * v[j];
					};
					v := next;
					if(Float->Abs(dot) > 0.999999999999) {
						break;
					};
				};

				# Rayleigh quotient gives the eigenvalue for the unit vector
				lambda := 0.0;
				each(a : cols) {
					row_sum := 0.0;
					each(b : cols) {
						row_sum += cov[a,b] * v[b];
					};
					lambda += v[a] * row_sum;
				};

				@eigenvalues[c] := lambda;
				each(j : cols) {
					@components[c,j] := v[j];
				};

				# deflate: C -= lambda * v v'
				each(a : cols) {
					each(b : cols) {
						cov[a,b] -= lambda * v[a] * v[b];
					};
				};
			};

			@is_fitted := true;
			return true;
		}

		method : Normalize(v : Float[]) ~ Float {
			norm := 0.0;
			each(j : v) {
				norm += v[j] * v[j];
			};
			norm := norm->Sqrt();

			if(norm > 0.0) {
				each(j : v) {
					v[j] := v[j] / norm;
				};
			};

			return norm;
		}

		#~
		Projects data onto the fitted components.
		@param X data matrix (rows=samples, cols=features)
		@return projected matrix (rows x num_components), or Nil if not fitted
		~#
		method : public : Transform(X : Float[,]) ~ Float[,] {
			if(<>@is_fitted | X = Nil) {
				return Nil;
			};

			x_dims := X->Size();
			rows := x_dims[0];
			cols := x_dims[1];

			result := Float->New[rows, @num_components];
			each(i : rows) {
				each(c : @num_components) {
					sum := 0.0;
					each(j : cols) {
						sum += (X[i,j] - @mean[j]) * @components[c,j];
					};
					result[i,c] := sum;
				};
			};

			return result;
		}

		#~
		Maps projected data back into the original feature space.
		@param Z projected matrix (rows x num_components)
		@return reconstruction (rows x features), or Nil if not fitted
		~#
		method : public : InverseTransform(Z : Float[,]) ~ Float[,] {
			if(<>@is_fitted | Z = Nil) {
				return Nil;
			};

			z_dims := Z->Size();
			rows := z_dims[0];
			comp_dims := @components->Size();
			cols := comp_dims[1];

			result := Float->New[rows, cols];
			each(i : rows) {
				each(j : cols) {
					sum := @mean[j];
					each(c : @num_components) {
						sum += Z[i,c] * @components[c,j];
					};
					result[i,j] := sum;
				};
			};

			return result;
		}

		#~
		Gets the fitted components (num_components x features; unit rows).
		@return component matrix, or Nil if not fitted
		~#
		method : public : GetComponents() ~ Float[,] {
			return @components;
		}

		#~
		Gets the variance explained by each component (eigenvalues).
		@return explained variance array, or Nil if not fitted
		~#
		method : public : GetExplainedVariance() ~ Float[] {
			return @eigenvalues;
		}

		#~
		Gets the fraction of total variance explained by each component.
		@return ratio array, or Nil if not fitted
		~#
		method : public : GetExplainedVarianceRatio() ~ Float[] {
			if(<>@is_fitted) {
				return Nil;
			};

			ratios := Float->New[@num_components];
			if(@total_variance > 0.0) {
				each(c : @num_components) {
					ratios[c] := @eigenvalues[c] / @total_variance;
				};
			};

			return ratios;
		}

		#~
		Gets the per-feature means used for centering.
		@return mean array, or Nil if not fitted
		~#
		method : public : GetMean() ~ Float[] {
			return @mean;
		}

		#~
		Whether the decomposition has been fitted.
		@return true if fitted
		~#
		method : public : IsFitted() ~ Bool {
			return @is_fitted;
		}

		#~
		Saves the fitted decomposition to a file.
		@param filename file to store to
		@return true if successful, false otherwise
		~#
		method : public : Store(filename : String) ~ Bool {
			if(<>@is_fitted) {
				return false;
			};

			serializer := System.IO.Serializer->New();
			serializer->Write(@num_components);

			cols := @mean->Size();
			serializer->Write(cols);
			each(j : cols) {
				serializer->Write(@mean[j]);
			};

			each(c : @num_components) {
				each(j : cols) {
					serializer->Write(@components[c,j]);
				};
			};

			each(c : @num_components) {
				serializer->Write(@eigenvalues[c]);
			};

			serializer->Write(@total_variance);

			return System.IO.Filesystem.FileWriter->WriteFile(filename, serializer->Serialize());
		}

		#~
		Loads a fitted decomposition from a file.
		@param filename file to load from
		@return fitted decomposition, or Nil on failure
		~#
		function : Load(filename : String) ~ PCA {
			data := System.IO.Filesystem.FileReader->ReadBinaryFile(filename);
			if(data = Nil) {
				return Nil;
			};

			deserializer := System.IO.Deserializer->New(data);
			num_components := deserializer->ReadInt();
			cols := deserializer->ReadInt();
			if(num_components < 1 | cols < 1) {
				return Nil;
			};

			mean := Float->New[cols];
			each(j : cols) {
				mean[j] := deserializer->ReadFloat();
			};

			components := Float->New[num_components, cols];
			each(c : num_components) {
				each(j : cols) {
					components[c,j] := deserializer->ReadFloat();
				};
			};

			eigenvalues := Float->New[num_components];
			each(c : num_components) {
				eigenvalues[c] := deserializer->ReadFloat();
			};

			total_variance := deserializer->ReadFloat();

			return PCA->New(num_components, mean, components, eigenvalues, total_variance);
		}
	}

	#~
	Feature scaling and normalization utilities
	~#
	class FeatureScaler {
		@means : Float[];
		@stds : Float[];
		@fitted : Bool;

		#~
		Constructor for a scaler that learns its statistics once and reapplies them.

		The static functions below standardize whatever matrix they are handed, which
		makes them unusable for train/test work: scaling test data by its own mean and
		deviation leaks test statistics into the evaluation, and the two halves end up
		on different scales besides. Fit on the training split, Transform both.
		~#
		New() {
			@fitted := false;
		}

		#~
		Learns each column's mean and standard deviation from this matrix.
		@param X matrix to learn from, normally the training split only
		@return true when the statistics were learned, false for empty input

```
scaler := FeatureScaler->New();
scaler->Fit(train);
train_z := scaler->Transform(train);
test_z := scaler->Transform(test);
```
		~#
		method : public : Fit(X : Float[,]) ~ Bool {
			if(X = Nil) {
				return false;
			};

			dims := X->Size();
			rows := dims[0];
			cols := dims[1];
			if(rows < 1 | cols < 1) {
				return false;
			};

			@means := Float->New[cols];
			@stds := Float->New[cols];

			each(col : cols) {
				sum := 0.0;
				each(row : rows) {
					sum += X[row, col];
				};
				mean := sum / rows->As(Float);

				sum_sq := 0.0;
				each(row : rows) {
					diff := X[row, col] - mean;
					sum_sq += diff * diff;
				};

				@means[col] := mean;
				# Population deviation, matching the static StandardScaler above. The
				# two must agree: a caller comparing one against the other on the same
				# matrix should not see different numbers.
				@stds[col] := Float->Sqrt(sum_sq / rows->As(Float));
			};

			@fitted := true;

			return true;
		}

		#~
		Applies the learned statistics to a matrix.
		@param X matrix to transform, with the same column count Fit saw
		@return standardized matrix, or Nil if this scaler is unfitted or the column count differs

```
test_z := scaler->Transform(test);
if(test_z = Nil) {
  "unfitted, or wrong column count"->PrintLine();
};
```
		~#
		method : public : Transform(X : Float[,]) ~ Float[,] {
			if(<>@fitted | X = Nil) {
				return Nil;
			};

			dims := X->Size();
			rows := dims[0];
			cols := dims[1];

			# A column-count mismatch means this is not the same feature space the
			# scaler was fitted on. Say so rather than standardize by the wrong column.
			if(cols <> @means->Size()) {
				return Nil;
			};

			result := Float->New[rows, cols];
			each(col : cols) {
				mean := @means[col];
				std := @stds[col];
				each(row : rows) {
					if(std > 0.0) {
						result[row, col] := (X[row, col] - mean) / std;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Fits on this matrix and transforms it in one call. For the training split only.
		@param X matrix to fit and transform
		@return standardized matrix, or Nil if the input could not be fitted
		~#
		method : public : FitTransform(X : Float[,]) ~ Float[,] {
			if(<>Fit(X)) {
				return Nil;
			};

			return Transform(X);
		}

		#~
		Whether Fit has been called successfully.
		@return true when this scaler holds statistics
		~#
		method : public : IsFitted() ~ Bool {
			return @fitted;
		}

		#~
		The learned per-column means.
		@return means, or Nil when unfitted
		~#
		method : public : GetMeans() ~ Float[] {
			return @means;
		}

		#~
		The learned per-column standard deviations.
		@return deviations, or Nil when unfitted
		~#
		method : public : GetStandardDeviations() ~ Float[] {
			return @stds;
		}

		#~
		Standardizes features by removing mean and scaling to unit variance (Z-score normalization)
		@param data input matrix
		@return standardized matrix with mean=0 and std=1
		~#
		function : native : StandardScaler(data : Float[,]) ~ Float[,] {
			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			result := Float->New[rows, cols];

			# Standardize each column
			each(col : cols) {
				# Calculate mean
				sum := 0.0;
				each(row : rows) {
					sum += data[row, col];
				};
				mean := sum / rows->As(Float);

				# Calculate standard deviation
				sum_sq := 0.0;
				each(row : rows) {
					diff := data[row, col] - mean;
					sum_sq += diff * diff;
				};
				std := Float->Sqrt(sum_sq / rows->As(Float));

				# Standardize
				each(row : rows) {
					if(std > 0.0) {
						result[row, col] := (data[row, col] - mean) / std;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Scales features to a [0, 1] range (Min-Max normalization)
		@param data input matrix
		@return scaled matrix with values in [0, 1]
		~#
		function : native : MinMaxScaler(data : Float[,]) ~ Float[,] {
			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			result := Float->New[rows, cols];

			# Scale each column
			each(col : cols) {
				# Find min and max
				min_val := data[0, col];
				max_val := data[0, col];

				each(row : rows) {
					if(data[row, col] < min_val) {
						min_val := data[row, col];
					};
					if(data[row, col] > max_val) {
						max_val := data[row, col];
					};
				};

				# Scale to [0, 1]
				range := max_val - min_val;
				each(row : rows) {
					if(range > 0.0) {
						result[row, col] := (data[row, col] - min_val) / range;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Normalizes each row to unit norm (L2 normalization)
		@param data input matrix
		@return normalized matrix where each row has L2 norm = 1
		~#
		function : native : Normalize(data : Float[,]) ~ Float[,] {
			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			result := Float->New[rows, cols];

			# Normalize each row
			each(row : rows) {
				# Calculate L2 norm
				sum_sq := 0.0;
				each(col : cols) {
					sum_sq += data[row, col] * data[row, col];
				};
				norm := Float->Sqrt(sum_sq);

				# Normalize
				each(col : cols) {
					if(norm > 0.0) {
						result[row, col] := data[row, col] / norm;
					}
					else {
						result[row, col] := 0.0;
					};
				};
			};

			return result;
		}
	}

	#~
	Turns a CsvTable into the numeric matrix a model can train on, learning its
	encoding once so the same encoding can be reapplied to other tables.

	MatrixReader already loads a CSV, but only one that is numeric throughout, and
	it reads the header row as another record whose non-numeric cells become 0.0.
	Real tabular data is mixed: NSL-KDD's protocol, service and flag columns are
	strings among thirty-eight numeric ones. This skips the header, one-hot encodes
	the string columns and passes the numeric ones through.

	The vocabulary is fixed at Fit. Transform reuses it, so a training table and a
	test table produce the same columns in the same order even when the test split
	never contains some category, and a category that appears only in test encodes
	as all-zeros rather than silently shifting every column after it.

```
enc := TableEncoder->New("class");
train_x := enc->FitTransform(train);
train_y := enc->TransformLabelsBinary(train, "normal");
test_x := enc->Transform(test);
```
	~#
	class TableEncoder {
		@label_col : String;
		@source : Int[];
		@numeric : Bool[];
		@offset : Int[];
		@onehot : Hash<String, IntRef>;
		@names : Vector<String>;
		@classes : Vector<String>;
		@width : Int;
		@fitted : Bool;

		#~
		Constructor for a table with no label column: every column is a feature.
		~#
		New() {
			@label_col := "";
			@fitted := false;
		}

		#~
		Constructor
		@param label_col name of the label column, which is excluded from the features
		~#
		New(label_col : String) {
			@label_col := label_col;
			@fitted := false;
		}

		#~
		Learns the feature layout: which columns are numeric, and the value
		vocabulary of each column that is not.

		A column counts as numeric only when every data value in it parses as a
		number. One non-numeric value makes the whole column categorical, which is
		the safe direction: encoding a number as a category costs columns, while
		reading a category as a number invents an ordering that is not there.
		@param table table to learn from, normally the training split only
		@return true when the layout was learned, false for an unparsed or empty table
		~#
		method : public : Fit(table : CsvTable) ~ Bool {
			if(table = Nil | <>table->IsParsed()) {
				return false;
			};

			# Row 0 is the header; rows 1 and up are data.
			rows := table->Size();
			if(rows < 2) {
				return false;
			};

			headers := table->GetHeaders();
			if(headers = Nil) {
				return false;
			};

			cols := headers->Size();
			feature_count := 0;
			each(c : cols) {
				if(<>headers->Get(c)->Equals(@label_col)) {
					feature_count += 1;
				};
			};
			if(feature_count < 1) {
				return false;
			};

			@source := Int->New[feature_count];
			@numeric := Bool->New[feature_count];
			@offset := Int->New[feature_count];
			@onehot := Hash->New()<String, IntRef>;
			@names := Vector->New()<String>;
			@classes := Vector->New()<String>;

			f := 0;
			each(c : cols) {
				if(<>headers->Get(c)->Equals(@label_col)) {
					@source[f] := c;
					@numeric[f] := IsNumericColumn(table, c, rows);
					f += 1;
				};
			};

			# Assign output columns: one per numeric feature, one per distinct value
			# of each categorical feature, in first-seen row order so the layout is
			# reproducible from the same training file.
			@width := 0;
			each(i : feature_count) {
				@offset[i] := @width;
				if(@numeric[i]) {
					@names->AddBack(headers->Get(@source[i]));
					@width += 1;
				}
				else {
					for(r := 1; r < rows; r += 1;) {
						row := table->Get(r);
						if(row <> Nil) {
							value := row->Get(@source[i]);
							if(value <> Nil) {
								key := Key(i, value);
								if(<>@onehot->Has(key)) {
									@onehot->Insert(key, IntRef->New(@width));
									@names->AddBack(headers->Get(@source[i]) + "=" + value);
									@width += 1;
								};
							};
						};
					};
				};
			};

			# The label's own classes, in first-seen order, for TransformLabels.
			if(@label_col->Size() > 0) {
				li := table->GetRowId(@label_col);
				if(li > -1) {
					for(r := 1; r < rows; r += 1;) {
						row := table->Get(r);
						if(row <> Nil) {
							value := row->Get(li);
							if(value <> Nil & <>HasClass(value)) {
								@classes->AddBack(value);
							};
						};
					};
				};
			};

			@fitted := true;

			return true;
		}

		method : IsNumericColumn(table : CsvTable, c : Int, rows : Int) ~ Bool {
			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				if(row <> Nil) {
					value := row->Get(c);
					if(value = Nil) {
						return false;
					};

					if(<>value->IsInt() & <>value->IsFloat()) {
						return false;
					};
				};
			};

			return true;
		}

		method : Key(feature : Int, value : String) ~ String {
			# A separator that cannot occur in a CSV field, so "a=" + "b" and
			# "a" + "=b" cannot collide into the same vocabulary entry.
			return feature->ToString() + "\r" + value;
		}

		method : HasClass(value : String) ~ Bool {
			each(i : @classes) {
				if(@classes->Get(i)->Equals(value)) {
					return true;
				};
			};

			return false;
		}

		#~
		Encodes a table using the layout learned by Fit.
		@param table table to encode; its header row is skipped
		@return matrix of (data rows) x (encoded width), or Nil when unfitted or the table cannot be read

```
test_x := enc->Transform(test);
if(test_x = Nil) {
  "unfitted, or the table did not parse"->PrintLine();
};
```
		~#
		method : public : Transform(table : CsvTable) ~ Float[,] {
			if(<>@fitted | table = Nil | <>table->IsParsed()) {
				return Nil;
			};

			rows := table->Size();
			if(rows < 2) {
				return Nil;
			};

			features := @source->Size();
			result := Float->New[rows - 1, @width];

			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				if(row <> Nil) {
					each(i : features) {
						value := row->Get(@source[i]);
						if(value <> Nil) {
							if(@numeric[i]) {
								result[r - 1, @offset[i]] := value->ToFloat();
							}
							else {
								found := @onehot->Find(Key(i, value));
								# A value Fit never saw leaves this group all zeros.
								# Dropping the row or adding a column instead would
								# change the feature space between train and test.
								if(found <> Nil) {
									result[r - 1, found->Get()] := 1.0;
								};
							};
						};
					};
				};
			};

			return result;
		}

		#~
		Fits on this table and encodes it. For the training split only.
		@param table table to fit and encode
		@return encoded matrix, or Nil when the table could not be fitted
		~#
		method : public : FitTransform(table : CsvTable) ~ Float[,] {
			if(<>Fit(table)) {
				return Nil;
			};

			return Transform(table);
		}

		#~
		Encodes the label column as class indices, using the classes seen at Fit.
		@param table table to read labels from
		@return one index per data row; a class unseen at Fit becomes -1.0
		~#
		method : public : TransformLabels(table : CsvTable) ~ Float[] {
			if(<>@fitted | table = Nil | <>table->IsParsed() | @label_col->Size() = 0) {
				return Nil;
			};

			li := table->GetRowId(@label_col);
			if(li < 0) {
				return Nil;
			};

			rows := table->Size();
			if(rows < 2) {
				return Nil;
			};

			result := Float->New[rows - 1];
			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				result[r - 1] := -1.0;
				if(row <> Nil) {
					value := row->Get(li);
					if(value <> Nil) {
						each(i : @classes) {
							if(@classes->Get(i)->Equals(value)) {
								result[r - 1] := i->As(Float);
							};
						};
					};
				};
			};

			return result;
		}

		#~
		Encodes the label column as a two-class target: 0.0 for the named value,
		1.0 for everything else. Intrusion detection labels are usually one benign
		value against many attack names, and this avoids enumerating the attacks.
		@param table table to read labels from
		@param negative the label value that maps to 0.0
		@return one value per data row, or Nil when unfitted or the label is missing
		~#
		method : public : TransformLabelsBinary(table : CsvTable, negative : String) ~ Float[] {
			if(<>@fitted | table = Nil | <>table->IsParsed() | @label_col->Size() = 0) {
				return Nil;
			};

			li := table->GetRowId(@label_col);
			if(li < 0) {
				return Nil;
			};

			rows := table->Size();
			if(rows < 2) {
				return Nil;
			};

			result := Float->New[rows - 1];
			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				result[r - 1] := 1.0;
				if(row <> Nil) {
					value := row->Get(li);
					if(value <> Nil & value->Equals(negative)) {
						result[r - 1] := 0.0;
					};
				};
			};

			return result;
		}

		#~
		Whether Fit has been called successfully.
		@return true when this encoder holds a layout
		~#
		method : public : IsFitted() ~ Bool {
			return @fitted;
		}

		#~
		The number of columns Transform produces.
		@return encoded width, or 0 when unfitted
		~#
		method : public : GetWidth() ~ Int {
			if(<>@fitted) {
				return 0;
			};

			return @width;
		}

		#~
		The name of each encoded column: the source column for a numeric feature,
		and "column=value" for each one-hot column.
		@return names in output order, or Nil when unfitted
		~#
		method : public : GetFeatureNames() ~ String[] {
			if(<>@fitted) {
				return Nil;
			};

			result := String->New[@names->Size()];
			each(i : @names) {
				result[i] := @names->Get(i);
			};

			return result;
		}

		#~
		The label classes seen at Fit, in the order TransformLabels indexes them.
		@return class values, or Nil when unfitted
		~#
		method : public : GetLabelClasses() ~ String[] {
			if(<>@fitted) {
				return Nil;
			};

			result := String->New[@classes->Size()];
			each(i : @classes) {
				result[i] := @classes->Get(i);
			};

			return result;
		}
	}

	#~
	Model evaluation metrics for classification tasks
	~#
	class Metrics {
		#~
		Calculates accuracy: (TP + TN) / Total
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return accuracy score between 0.0 and 1.0
		~#
		function : native : Accuracy(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			correct := 0;
			each(i : predictions) {
				if(predictions[i] = actuals[i]) {
					correct += 1;
				};
			};

			return correct->As(Float) / predictions->Size()->As(Float);
		}

		#~
		Calculates precision: TP / (TP + FP)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return precision score between 0.0 and 1.0
		~#
		function : native : Precision(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			tp := 0; # True Positives
			fp := 0; # False Positives

			each(i : predictions) {
				if(predictions[i] & actuals[i]) {
					tp += 1;
				}
				else if(predictions[i] & <>actuals[i]) {
					fp += 1;
				};
			};

			if(tp + fp = 0) {
				return 0.0;
			};

			return tp->As(Float) / (tp + fp)->As(Float);
		}

		#~
		Calculates recall (sensitivity): TP / (TP + FN)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return recall score between 0.0 and 1.0
		~#
		function : native : Recall(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			tp := 0; # True Positives
			fn := 0; # False Negatives

			each(i : predictions) {
				if(predictions[i] & actuals[i]) {
					tp += 1;
				}
				else if(<>predictions[i] & actuals[i]) {
					fn += 1;
				};
			};

			if(tp + fn = 0) {
				return 0.0;
			};

			return tp->As(Float) / (tp + fn)->As(Float);
		}

		#~
		Calculates F1 score: 2 * (Precision * Recall) / (Precision + Recall)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return F1 score between 0.0 and 1.0
		~#
		function : native : F1Score(predictions : Bool[], actuals : Bool[]) ~ Float {
			precision := Precision(predictions, actuals);
			recall := Recall(predictions, actuals);

			if(precision + recall = 0.0) {
				return 0.0;
			};

			return 2.0 * (precision * recall) / (precision + recall);
		}

		#~
		Creates a confusion matrix
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return 2x2 confusion matrix [[TN, FP], [FN, TP]]
		~#
		function : native : ConfusionMatrix(predictions : Bool[], actuals : Bool[]) ~ Int[,] {
			matrix := Int->New[2, 2];

			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return matrix;
			};

			each(i : predictions) {
				# TN (0,0), FP (0,1), FN (1,0), TP (1,1)
				pred_idx := predictions[i] ? 1 : 0;
				actual_idx := actuals[i] ? 1 : 0;
				matrix[actual_idx, pred_idx] += 1;
			};

			return matrix;
		}

		#~
		Calculates Matthews Correlation Coefficient (MCC)
		@param predictions predicted boolean values
		@param actuals actual boolean values
		@return MCC score between -1.0 and 1.0
		~#
		function : native : MCC(predictions : Bool[], actuals : Bool[]) ~ Float {
			if(predictions->Size() <> actuals->Size() | predictions->Size() = 0) {
				return 0.0;
			};

			tp := 0; tn := 0; fp := 0; fn := 0;

			each(i : predictions) {
				if(predictions[i] & actuals[i]) {
					tp += 1;
				}
				else if(<>predictions[i] & <>actuals[i]) {
					tn += 1;
				}
				else if(predictions[i] & <>actuals[i]) {
					fp += 1;
				}
				else {
					fn += 1;
				};
			};

			numerator := (tp * tn - fp * fn)->As(Float);
			denominator := Float->Sqrt((tp + fp)->As(Float) * (tp + fn)->As(Float) *
			                           (tn + fp)->As(Float) * (tn + fn)->As(Float));

			if(denominator = 0.0) {
				return 0.0;
			};

			return numerator / denominator;
		}

		#~
		Prints a formatted confusion matrix
		@param matrix 2x2 confusion matrix
		~#
		function : native : PrintConfusionMatrix(matrix : Int[,]) ~ Nil {
			tn := matrix[0,0];
			fp := matrix[0,1];
			fn := matrix[1,0];
			tp := matrix[1,1];

			"Confusion Matrix:"->PrintLine();
			"                Predicted"->PrintLine();
			"              Negative  Positive"->PrintLine();
			"Actual Neg  |   {$tn}   |   {$fp}   |"->PrintLine();
			"Actual Pos  |   {$fn}   |   {$tp}   |"->PrintLine();
		}
	}

	#~
	Cross-validation utilities for model evaluation
	~#
	class CrossValidation {
		#~
		Splits data into K folds for cross-validation
		@param data input matrix
		@param k number of folds
		@return array of K fold indices
		~#
		function : native : KFold(data : Float[,], k : Int) ~ Vector[]<IntRef> {
			dims := data->Size();
			rows := dims[0];

			if(k <= 0 | k > rows) {
				return Nil;
			};

			fold_size := rows / k;
			indices := Int->New[rows];
			each(i : rows) {
				indices[i] := i;
			};

			# Shuffle indices
			each(i : rows) {
				j := (rows - 1)->Random();
				temp := indices[i];
				indices[i] := indices[j];
				indices[j] := temp;
			};

			# Create folds
			folds := Vector->New[k]<IntRef>;
			each(fold : k) {
				fold_indices := Vector->New()<IntRef>;
				start := fold * fold_size;
				ending := fold = k - 1 ? rows : (fold + 1) * fold_size;

				for(i := start; i < ending; i += 1;) {
					fold_indices->AddBack(indices[i]);
				};

				folds[fold] := fold_indices;
			};

			return folds;
		}

		#~
		Splits row indices into K folds that each keep the class ratio of the whole,
		shuffled from a caller-supplied seed so the same seed gives the same folds.

		KFold above shuffles with the global generator and ignores labels. Both hurt
		on imbalanced data: an unseeded split cannot be reproduced, and an unstratified
		split lets the rare class land unevenly, so a fold may hold too few positives
		to measure anything at a low false-positive rate. Intrusion-detection sets are
		exactly that shape.

		Classes are taken from the label values as they first appear. Each class is
		shuffled independently and dealt round-robin across the folds, continuing from
		where the previous class stopped, so a remainder cannot pile into fold 0.
		@param labels one label per row; only the labels are needed to stratify
		@param k number of folds, at least 2
		@param seed shuffle seed; the same seed reproduces the same folds
		@return k vectors of row indices, or Nil on bad input

```
folds := CrossValidation->StratifiedKFold(y, 5, 42);
each(f : folds) {
  test_rows := folds[f];
};
```
		~#
		function : StratifiedKFold(labels : Float[], k : Int, seed : Int) ~ Vector[]<IntRef> {
			if(labels = Nil) {
				return Nil;
			};

			rows := labels->Size();
			if(k < 2 | k > rows) {
				return Nil;
			};

			# Hoisted: a local declared inside a nested block and read outside it is
			# a known way to fault in this compiler.
			found : Int;
			n : Int;
			p : Int;
			t : Int;
			j : Int;
			idx : Int[];

			# Distinct class values, in first-seen order, and each row's class.
			class_values := Float->New[rows];
			class_of := Int->New[rows];
			class_count := 0;

			each(i : rows) {
				found := -1;
				each(c : class_count) {
					if(class_values[c] = labels[i]) {
						found := c;
					};
				};

				if(found < 0) {
					class_values[class_count] := labels[i];
					found := class_count;
					class_count += 1;
				};

				class_of[i] := found;
			};

			folds := Vector->New[k]<IntRef>;
			each(f : k) {
				folds[f] := Vector->New()<IntRef>;
			};

			state := seed;
			next_fold := 0;

			each(c : class_count) {
				n := 0;
				each(i : rows) {
					if(class_of[i] = c) {
						n += 1;
					};
				};

				idx := Int->New[n];
				p := 0;
				each(i : rows) {
					if(class_of[i] = c) {
						idx[p] := i;
						p += 1;
					};
				};

				# Fisher-Yates from the seed. A local generator rather than the global
				# one, because the point of the seed is that another machine, and a
				# later run, produce the same folds.
				for(i := n - 1; i > 0; i -= 1;) {
					state := (state * 1103515245 + 12345) and 2147483647;
					j := state % (i + 1);
					t := idx[i];
					idx[i] := idx[j];
					idx[j] := t;
				};

				each(i : n) {
					folds[next_fold]->AddBack(idx[i]);
					next_fold := (next_fold + 1) % k;
				};
			};

			return folds;
		}

		#~
		Splits data into training and test sets
		@param data input matrix
		@param test_ratio percentage of data for testing (0.0 to 1.0)
		@return array with [training_data, test_data]
		~#
		function : native : TrainTestSplit(data : Float[,], test_ratio : Float) ~ FloatMatrixRef[] {
			if(test_ratio <= 0.0 | test_ratio >= 1.0) {
				return Nil;
			};

			dims := data->Size();
			rows := dims[0];
			cols := dims[1];

			test_size := (rows->As(Float) * test_ratio)->As(Int);
			train_size := rows - test_size;

			# Shuffle indices
			indices := Int->New[rows];
			each(i : rows) {
				indices[i] := i;
			};

			each(i : rows) {
				j := (rows - 1)->Random();
				temp := indices[i];
				indices[i] := indices[j];
				indices[j] := temp;
			};

			# Split data
			train_data := Float->New[train_size, cols];
			test_data := Float->New[test_size, cols];

			each(i : train_size) {
				idx := indices[i];
				each(j : cols) {
					train_data[i, j] := data[idx, j];
				};
			};

			for(i := train_size; i < rows; i += 1;) {
				idx := indices[i];
				each(j : cols) {
					test_data[i - train_size, j] := data[idx, j];
				};
			};

			result := FloatMatrixRef->New[2];
			result[0] := FloatMatrixRef->New(train_data);
			result[1] := FloatMatrixRef->New(test_data);

			return result;
		}
	}
}
