use Collection;

#~
Regular expression matching and replacement. RegEx compiles a pattern once and supports full match, substring search, numbered capture groups, and global replacement. Link with -lib regex.
~#
bundle Query.RegEx {
	#~
	Regular expression engine. A match is the leftmost-longest one; when several paths give that
	match, capture groups take their values from the greedy (highest-priority) path.

	<p>Support for following patterns:<p>
	<ul>
		<li>any &#8208; .</li>
		<li>optional &#8208; ?</li>
		<li>zero or more repetitions &#8208; *</li>
		<li>one or more repetitions &#8208; +</li>
		<li>repeat &#8208; {least} or {least, most}</li>
		<li>start of input &#8208; ^</li>
		<li>end of input &#8208; $</li>
		<li>(one|two|three) &#8208; numbered capture group, see Result-&gt;GetGroup</li>
		<li>(?:one|two) &#8208; non-capturing group</li>
		<li>[abc], [a-zA-Z0-9_], [.,;] &#8208; character class (several ranges and literal punctuation)</li>
		<li>[^abc] &#8208; negated character class</li>
		<li>inside a class: \d \w \s \D \W \S, \] \\ \- and other escaped literals; a leading or trailing '-' and a ']' first are literals</li>
	</ul>

	<p>Support for following special groups:<p>
	<ul>
		<li>word &#8208; \w</li>
		<li>not word &#8208; \W</li>
		<li>digit &#8208; \d</li>
		<li>not digit &#8208; \D</li>
		<li>white space &#8208; \s</li>
		<li>not white space &#8208; \S</li>
		<li>word boundary &#8208; \b</li>
		<li>not a word boundary &#8208; \B</li>
		<li>newline, carriage return, tab &#8208; \n \r \t</li>
	</ul>

	```
output := HttpsClient->New()->QuickGet(Web.HTTP.Url->New(url))->ToString();
output_len := output->Size();
"URL: {$output}, read: {$output_len} character(s)"->PrintLine();

"running regex..."->PrintLine();
expr := "(href|HREF|src|SRC)=(\"|')(http://|https://|/)?((\\w|\\d|-|_)+(\\.|/)?)+(\\?(\\w|\\d|-|_)+=(\\w|\\d|-|_)+)?(&(\\w|\\d|-|_)+=(\\w|\\d|-|_)+)?(\"|')";

found := Query.RegEx.RegEx->New(expr)->Find(output)<Result>;
"---"->PrintLine();
each(i : found) {
   found->Get(i)->ToString()->PrintLine();
};
	```
	~#

	class RegEx {
		# parsing
		@tokens : Char[];
		@token_pos : Int;
		@token : Char;
		@expressions : Vector<Expression>;
		@error : String;
		@starts_anchor : Bool;
		@group_count : Int;
		@class_shorthand : Bool;

		# compiled NFA program (parallel simulation)
		@program : Vector<Instruction>;

		# matching state
		@is_exact : Bool;

		#~
		Default constructor
		@param stream_in regex pattern

```
re := RegEx->New("\\d+");
if(re->IsOk()) {
  results := re->Find("order 42 ships on day 7")<Result>;
  each(r := results) {
    r->GetValue()->PrintLine();
  };
};
```
		~#
		New(stream_in : String) {
			@tokens := stream_in->ToCharArray();
			@expressions := Vector->New()<Expression>;
			@program := Vector->New()<Instruction>;
			@group_count := 0;

			Parse();
			if(@error = Nil) {
				Compile();
			};
		}

		#~
		Check of the regex was parsed correctly
		@return true if parsed, false otherwise

```
re := RegEx->New("[a-z]+");
if(re->IsOk()) {
  "pattern compiled ok"->PrintLine();
};
```
		~#
		method : public : IsOk() ~ Bool {
			return @error = Nil;
		}

		#~
		Looks for an exact regex match
		@param stream_in string to match against
		@return true if exact, false otherwise

```
re := RegEx->New("\\d{4}-\\d{2}-\\d{2}");
if(re->MatchExact("2025-06-15")) {
  "valid date format"->PrintLine();
};
```
		~#
		method : public : MatchExact(stream_in : String) ~ Bool {
			return Evaluate(stream_in, 0) > -1 & @is_exact;
		}

		#~
		Matches as much of the string as possible
		@param stream_in string to match against
		@return matched string if found, empty string otherwise

```
re := RegEx->New("\\w+");
matched := re->Match("hello world");
matched->PrintLine();
```
		~#
		method : public : Match(stream_in : String) ~ String {
			return Match(stream_in, 0);
		}

		#~
		Matches as much of the string as possible
		@param stream_in string to match against
		@param offset offset into the to match against
		@return matched string if found, empty string otherwise

```
re := RegEx->New("\\d+");
matched := re->Match("skip 42 here", 5);
matched->PrintLine();
```
		~#
		method : public : Match(stream_in : String, offset : Int) ~ String {
			right := Evaluate(stream_in, offset);
			if(right > -1) {
				return stream_in->SubString(offset, right - offset);
			};

			return "";
		}

		#~
		Matches the first occurrence
		@param stream_in string to match against
		@return matched string if found, empty string otherwise

```
re := RegEx->New("[A-Z][a-z]+");
result := re->FindFirst("Hello World");
if(result <> Nil) {
  result->GetValue()->PrintLine();
  Console->PrintLine(result->GetStart());
};
```
		~#
		method : public : FindFirst(stream_in : String) ~ Result {
			is_anchored := @expressions->Size() > 0 & @expressions->Get(0)->GetType() = Expression->Type->STARTS_ANCHOR;

			first_char : Char := '\0';
			if(@expressions->Size() > 0 & @expressions->Get(0)->GetType() = Expression->Type->CHAR) {
				first_char := @expressions->Get(0)->GetValue();
			};

			left := 0;
			input_size := stream_in->Size();
			# '<=' so a pattern that matches the empty string also matches at the end of the input
			while(left <= input_size) {
				if(first_char <> '\0') {
					while(left < input_size & stream_in->Get(left) <> first_char) {
						left += 1;
					};
					if(left >= input_size) {
						return Nil;
					};
				};

				right := Evaluate(stream_in, left);
				if(right > -1) {
					return MakeResult(stream_in, left, right);
				};

				if(is_anchored) {
					return Nil;
				};
				left += 1;
			};

			return Nil;
		}

		#~
		Finds all non-empty, non-overlapping occurrences
		@param stream_in string to match against
		@return vector of string matches

```
re := RegEx->New("\\d+");
results := re->Find("1 cat, 2 dogs, 3 birds")<Result>;
each(r := results) {
  r->GetValue()->PrintLine();
};
```
		~#
		method : public : Find(stream_in : String) ~ Vector<Result> {
			matches := Vector->New()<Result>;

			is_anchored := @expressions->Size() > 0 & @expressions->Get(0)->GetType() = Expression->Type->STARTS_ANCHOR;

			first_char : Char := '\0';
			if(@expressions->Size() > 0 & @expressions->Get(0)->GetType() = Expression->Type->CHAR) {
				first_char := @expressions->Get(0)->GetValue();
			};

			left := 0;
			input_size := stream_in->Size();
			while(left < input_size) {
				if(first_char <> '\0') {
					while(left < input_size & stream_in->Get(left) <> first_char) {
						left += 1;
					};
					if(left >= input_size) {
						left := input_size;
					};
				};

				if(left < input_size) {
					right := Evaluate(stream_in, left);
					if(right > -1 & left <> right) {
						if(left < right) {
							matches->AddBack(MakeResult(stream_in, left, right));
							left := right - 1;
						};
					};

					if(is_anchored) {
						left := input_size;
					}
					else {
						left += 1;
					};
				};
			};

			return matches;
		}

		#~
		Replaces the first occurrence with the given string
		@param stream_in string to match against
		@param replace string to replace the match with
		@return replaced string

```
re := RegEx->New("\\d+");
result := re->ReplaceFirst("order 42 ships on day 7", "NUM");
result->PrintLine();
```
		~#
		method : public : ReplaceFirst(stream_in : String, replace : String) ~ String {
			left := 0;
			while(left < stream_in->Size()) {
				right := Evaluate(stream_in, left);
				if(right > -1 & left <> right) {
					result := stream_in->SubString(left);
					result->Append(replace);
					result->Append(stream_in->SubString(right, stream_in->Size() - right));
					return result;
				};
				left += 1;
			};

			return stream_in;
		}

		#~
		Replaces all occurrences of the given string
		@param stream_in string to match against
		@param replace string to replace the match with
		@return replaced string

```
re := RegEx->New("\\d+");
result := re->ReplaceAll("order 42 ships on day 7", "NUM");
result->PrintLine();
```
		~#
		method : public : ReplaceAll(stream_in : String, replace : String) ~ String {
			left := 0;
			while(left < stream_in->Size()) {
				right := Evaluate(stream_in, left);
				if(right > -1 & left <> right) {
					result := stream_in->SubString(left);
					result->Append(replace);
					result->Append(stream_in->SubString(right, stream_in->Size() - right));
					stream_in := result;
					left += replace->Size() - 1;
				};
				left += 1;
			};

			return stream_in;
		}

		# ---------- parallel NFA simulation ----------

		# Compile the AST expression list into a flat NFA program.
		method : private : Compile() ~ Nil {
			CompileExprs(@expressions);
			@program->AddBack(Instruction->NewOp(Instruction->Op->MATCH));
		}

		method : private : CompileExprs(exprs : Vector<Expression>) ~ Nil {
			each(i : exprs) {
				CompileExpr(exprs->Get(i));
			};
		}

		method : private : CompileExpr(expr : Expression) ~ Nil {
			select(expr->GetType()) {
				label Expression->Type->CHAR: {
					instr := Instruction->NewChar(expr->GetValue());
					@program->AddBack(instr);
				}

				label Expression->Type->ANY: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->ANY));
				}

				label Expression->Type->DIGIT: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->DIGIT));
				}

				label Expression->Type->NOT_DIGIT: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->NOT_DIGIT));
				}

				label Expression->Type->WORD: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->WORD));
				}

				label Expression->Type->NOT_WORD: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->NOT_WORD));
				}

				label Expression->Type->WHITESPACE: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->WHITESPACE));
				}

				label Expression->Type->NOT_WHITESPACE: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->NOT_WHITESPACE));
				}

				label Expression->Type->CHAR_CLASS: {
					@program->AddBack(Instruction->NewClass(expr->GetSet()));
				}

				label Expression->Type->WORD_BOUNDARY: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->WORD_BOUND));
				}

				label Expression->Type->NOT_WORD_BOUNDARY: {
					@program->AddBack(Instruction->NewOp(Instruction->Op->NOT_WORD_BOUND));
				}

				label Expression->Type->STARTS_ANCHOR: {
					# ANC_START checks position; if ok, continue to the wrapped expression
					anc := Instruction->NewOp(Instruction->Op->ANC_START);
					@program->AddBack(anc);
					CompileExpr(expr->GetExpression());
				}

				label Expression->Type->ENDS_ANCHOR: {
					CompileExpr(expr->GetExpression());
					@program->AddBack(Instruction->NewOp(Instruction->Op->ANC_END));
				}

				label Expression->Type->OR: {
					# SPLIT t1 t2 ; t1: compile(left) ; JUMP after ; t2: compile(right) ; after:
					split := Instruction->NewSplit(0, 0);
					split_pc := @program->Size();
					@program->AddBack(split);

					t1_pc := @program->Size();
					CompileExprs(expr->GetLeft());

					jump := Instruction->NewJump(0);
					jump_pc := @program->Size();
					@program->AddBack(jump);

					t2_pc := @program->Size();
					CompileExprs(expr->GetRight());

					after_pc := @program->Size();

					# patch targets
					@program->Get(split_pc)->SetTarget1(t1_pc);
					@program->Get(split_pc)->SetTarget2(t2_pc);
					@program->Get(jump_pc)->SetTarget1(after_pc);
				}

				label Expression->Type->OPTIONAL: {
					# SPLIT(body, after) ; body: compile(e) ; after:
					split := Instruction->NewSplit(0, 0);
					split_pc := @program->Size();
					@program->AddBack(split);

					body_pc := @program->Size();
					CompileExpr(expr->GetExpression());

					after_pc := @program->Size();
					@program->Get(split_pc)->SetTarget1(body_pc);
					@program->Get(split_pc)->SetTarget2(after_pc);
				}

				label Expression->Type->ZERO_MORE: {
					# L0: SPLIT(L1, after) ; L1: compile(e) ; JUMP(L0) ; after:
					l0_pc := @program->Size();
					split := Instruction->NewSplit(0, 0);
					@program->AddBack(split);

					l1_pc := @program->Size();
					CompileExpr(expr->GetExpression());

					jump := Instruction->NewJump(l0_pc);
					@program->AddBack(jump);

					after_pc := @program->Size();
					@program->Get(l0_pc)->SetTarget1(l1_pc);
					@program->Get(l0_pc)->SetTarget2(after_pc);
				}

				label Expression->Type->ONE_MORE: {
					# L0: compile(e) ; SPLIT(L0, after) ; after:
					l0_pc := @program->Size();
					CompileExpr(expr->GetExpression());

					split := Instruction->NewSplit(0, 0);
					split_pc := @program->Size();
					@program->AddBack(split);

					after_pc := @program->Size();
					@program->Get(split_pc)->SetTarget1(l0_pc);
					@program->Get(split_pc)->SetTarget2(after_pc);
				}

				label Expression->Type->REPEAT: {
					least := expr->GetLeast();
					most := expr->GetMost();
					inner := expr->GetExpression();

					# mandatory repetitions
					i := 0;
					while(i < least) {
						CompileExpr(inner);
						i += 1;
					};

					if(most = -1) {
						# unlimited optional tail: ZERO_MORE(inner)
						l0_pc := @program->Size();
						split := Instruction->NewSplit(0, 0);
						@program->AddBack(split);

						l1_pc := @program->Size();
						CompileExpr(inner);

						jump := Instruction->NewJump(l0_pc);
						@program->AddBack(jump);

						after_pc := @program->Size();
						@program->Get(l0_pc)->SetTarget1(l1_pc);
						@program->Get(l0_pc)->SetTarget2(after_pc);
					}
					else {
						# optional repetitions up to most
						j := least;
						while(j < most) {
							split := Instruction->NewSplit(0, 0);
							split_pc := @program->Size();
							@program->AddBack(split);

							body_pc := @program->Size();
							CompileExpr(inner);

							after_pc := @program->Size();
							@program->Get(split_pc)->SetTarget1(body_pc);
							@program->Get(split_pc)->SetTarget2(after_pc);
							j += 1;
						};
					};
				}

				label Expression->Type->SUB_EXPR: {
					# a capturing group saves its start and end positions in slots 2g and 2g+1
					group := expr->GetGroup();
					if(group > 0) {
						@program->AddBack(Instruction->NewSave(group * 2));
					};
					CompileExprs(expr->GetLeft());
					if(group > 0) {
						@program->AddBack(Instruction->NewSave(group * 2 + 1));
					};
				}
			};
		}

		# Builds a Result for the match [left, right), filling in the capture groups if the pattern has any.
		method : private : MakeResult(stream_in : String, left : Int, right : Int) ~ Result {
			length := right - left;
			value := stream_in->SubString(left, length);
			if(@group_count = 0) {
				return Result->New(left, length, value);
			};

			caps := Captures(stream_in, left, right);
			starts := Int->New[@group_count + 1];
			values := String->New[@group_count + 1];
			starts[0] := left;
			values[0] := value;
			for(g := 1; g <= @group_count; g += 1;) {
				s := caps[g * 2];
				e := caps[g * 2 + 1];
				if(s > -1 & e >= s) {
					starts[g] := s;
					values[g] := stream_in->SubString(s, e - s);
				}
				else {
					starts[g] := -1;
				};
			};

			return Result->New(left, length, value, starts, values);
		}

		# True if the character at 'pos' exists and is a word character
		method : private : IsWordAt(stream_in : String, pos : Int, input_size : Int) ~ Bool {
			if(pos < 0 | pos >= input_size) {
				return false;
			};
			return CharSet->IsWord(stream_in->Get(pos));
		}

		# True if 'pos' is a word boundary (a word character on exactly one side)
		method : private : IsBoundary(stream_in : String, pos : Int, input_size : Int) ~ Bool {
			before := IsWordAt(stream_in, pos - 1, input_size);
			after := IsWordAt(stream_in, pos, input_size);
			return before <> after;
		}

		# True if the char-consuming instruction accepts 'c'
		method : private : Accepts(instr : Instruction, c : Char) ~ Bool {
			op := instr->GetOp();
			if(op = Instruction->Op->CHAR->As(Int)) {
				return instr->GetChar() = c;
			}
			else if(op = Instruction->Op->ANY->As(Int)) {
				return c <> '\0';
			}
			else if(op = Instruction->Op->DIGIT->As(Int)) {
				return c->IsDigit();
			}
			else if(op = Instruction->Op->NOT_DIGIT->As(Int)) {
				return c <> '\0' & <>c->IsDigit();
			}
			else if(op = Instruction->Op->WORD->As(Int)) {
				return CharSet->IsWord(c);
			}
			else if(op = Instruction->Op->NOT_WORD->As(Int)) {
				return c <> '\0' & <>CharSet->IsWord(c);
			}
			else if(op = Instruction->Op->WHITESPACE->As(Int)) {
				return CharSet->IsSpace(c);
			}
			else if(op = Instruction->Op->NOT_WHITESPACE->As(Int)) {
				return c <> '\0' & <>CharSet->IsSpace(c);
			}
			else if(op = Instruction->Op->CLASS->As(Int)) {
				return c <> '\0' & instr->GetSet()->Contains(c);
			};

			return false;
		}

		# Follow epsilon transitions and record char-consuming PCs in threads[0..n_ref-1].
		method : private : AddThread(pc : Int, threads : Int[], n_ref : IntRef, visited : Int[], gen : Int, stream_in : String, pos : Int, input_size : Int, match_end : IntRef) ~ Nil {
			prog_size := @program->Size();
			while(pc < prog_size & visited[pc] <> gen) {
				visited[pc] := gen;
				op := @program->Get(pc)->GetOp();

				if(op = Instruction->Op->SPLIT->As(Int)) {
					t1 := @program->Get(pc)->GetTarget1();
					t2 := @program->Get(pc)->GetTarget2();
					AddThread(t1, threads, n_ref, visited, gen, stream_in, pos, input_size, match_end);
					pc := t2;
				}
				else if(op = Instruction->Op->JUMP->As(Int)) {
					pc := @program->Get(pc)->GetTarget1();
				}
				else if(op = Instruction->Op->SAVE->As(Int)) {
					# captures are recovered by a second pass, see Captures()
					pc += 1;
				}
				else if(op = Instruction->Op->MATCH->As(Int)) {
					match_end->Set(pos);
					return;
				}
				else if(op = Instruction->Op->ANC_START->As(Int)) {
					if(pos = 0) {
						pc += 1;
					}
					else {
						return;
					};
				}
				else if(op = Instruction->Op->ANC_END->As(Int)) {
					if(pos = input_size) {
						pc += 1;
					}
					else {
						return;
					};
				}
				else if(op = Instruction->Op->WORD_BOUND->As(Int)) {
					if(IsBoundary(stream_in, pos, input_size)) {
						pc += 1;
					}
					else {
						return;
					};
				}
				else if(op = Instruction->Op->NOT_WORD_BOUND->As(Int)) {
					if(IsBoundary(stream_in, pos, input_size)) {
						return;
					}
					else {
						pc += 1;
					};
				}
				else {
					n := n_ref->Get();
					threads[n] := pc;
					n_ref->Set(n + 1);
					return;
				};
			};
		}

		# Parallel NFA simulation. Returns end position of the longest match starting at 'offset', or -1.
		# Uses two pre-allocated Int[] arrays swapped each step â€” zero hot-path allocation.
		method : Evaluate(stream_in : String, offset : Int) ~ Int {
			if(@error <> Nil | @program->Size() = 0) {
				return -1;
			};

			# offset = input_size is allowed: a pattern such as 'x*' matches the empty string there
			input_size := stream_in->Size();
			if(offset < 0 | offset > input_size) {
				return -1;
			};

			@is_exact := false;

			prog_size := @program->Size();
			visited := Int->New[prog_size];
			cur  := Int->New[prog_size];
			nxt  := Int->New[prog_size];
			cur_n := IntRef->New(0);
			nxt_n := IntRef->New(0);
			match_holder := IntRef->New(-1);
			gen := 1;

			AddThread(0, cur, cur_n, visited, gen, stream_in, offset, input_size, match_holder);
			match_end := match_holder->Get();
			pos := offset;

			while(pos < input_size & cur_n->Get() > 0) {
				c := stream_in->Get(pos);

				gen += 1;
				nxt_n->Set(0);
				match_holder->Set(-1);

				k := 0;
				lim := cur_n->Get();
				while(k < lim) {
					pc := cur[k];
					if(Accepts(@program->Get(pc), c)) {
						AddThread(pc + 1, nxt, nxt_n, visited, gen, stream_in, pos + 1, input_size, match_holder);
					};
					k += 1;
				};

				if(match_holder->Get() > -1) {
					match_end := match_holder->Get();
				};

				# swap cur/nxt without allocation
				tmp := cur;
				cur := nxt;
				nxt := tmp;
				cur_n->Set(nxt_n->Get());
				nxt_n->Set(0);

				pos += 1;
			};

			if(match_end > -1) {
				@is_exact := match_end = input_size;
				return match_end;
			};

			return -1;
		}

		# Capture-tracking variant of AddThread. 'caps' is a scratch array updated in place by SAVE and
		# restored afterwards; each recorded thread gets its own copy in thread_caps[slot * ncap ...].
		method : private : AddThreadCap(pc : Int, caps : Int[], threads : Int[], thread_caps : Int[], n_ref : IntRef, ncap : Int,
				visited : Int[], gen : Int, stream_in : String, pos : Int, input_size : Int, target : Int, found : Int[], found_ref : IntRef) ~ Nil {
			prog_size := @program->Size();
			while(pc < prog_size & visited[pc] <> gen) {
				visited[pc] := gen;
				instr := @program->Get(pc);
				op := instr->GetOp();

				if(op = Instruction->Op->SPLIT->As(Int)) {
					AddThreadCap(instr->GetTarget1(), caps, threads, thread_caps, n_ref, ncap, visited, gen, stream_in, pos, input_size, target, found, found_ref);
					pc := instr->GetTarget2();
				}
				else if(op = Instruction->Op->JUMP->As(Int)) {
					pc := instr->GetTarget1();
				}
				else if(op = Instruction->Op->SAVE->As(Int)) {
					slot := instr->GetTarget1();
					old := caps[slot];
					caps[slot] := pos;
					AddThreadCap(pc + 1, caps, threads, thread_caps, n_ref, ncap, visited, gen, stream_in, pos, input_size, target, found, found_ref);
					caps[slot] := old;
					return;
				}
				else if(op = Instruction->Op->MATCH->As(Int)) {
					# the first thread to match at the target end has the highest priority
					if(pos = target & found_ref->Get() = 0) {
						for(i := 0; i < ncap; i += 1;) {
							found[i] := caps[i];
						};
						found_ref->Set(1);
					};
					return;
				}
				else if(op = Instruction->Op->ANC_START->As(Int)) {
					if(pos = 0) { pc += 1; } else { return; };
				}
				else if(op = Instruction->Op->ANC_END->As(Int)) {
					if(pos = input_size) { pc += 1; } else { return; };
				}
				else if(op = Instruction->Op->WORD_BOUND->As(Int)) {
					if(IsBoundary(stream_in, pos, input_size)) { pc += 1; } else { return; };
				}
				else if(op = Instruction->Op->NOT_WORD_BOUND->As(Int)) {
					if(IsBoundary(stream_in, pos, input_size)) { return; } else { pc += 1; };
				}
				else {
					n := n_ref->Get();
					threads[n] := pc;
					base := n * ncap;
					for(i := 0; i < ncap; i += 1;) {
						thread_caps[base + i] := caps[i];
					};
					n_ref->Set(n + 1);
					return;
				};
			};
		}

		# Re-runs the NFA over a known match [left, right) tracking capture positions. Only used when the
		# pattern has groups, so the plain Evaluate() path stays allocation-free.
		method : private : Captures(stream_in : String, left : Int, right : Int) ~ Int[] {
			ncap := (@group_count + 1) * 2;
			prog_size := @program->Size();
			input_size := stream_in->Size();

			visited := Int->New[prog_size];
			cur := Int->New[prog_size];
			nxt := Int->New[prog_size];
			cur_caps := Int->New[prog_size * ncap];
			nxt_caps := Int->New[prog_size * ncap];
			cur_n := IntRef->New(0);
			nxt_n := IntRef->New(0);
			found_ref := IntRef->New(0);

			caps := Int->New[ncap];
			found := Int->New[ncap];
			for(i := 0; i < ncap; i += 1;) {
				caps[i] := -1;
				found[i] := -1;
			};

			gen := 1;
			AddThreadCap(0, caps, cur, cur_caps, cur_n, ncap, visited, gen, stream_in, left, input_size, right, found, found_ref);

			pos := left;
			while(pos < right & found_ref->Get() = 0 & cur_n->Get() > 0) {
				c := stream_in->Get(pos);
				gen += 1;
				nxt_n->Set(0);

				lim := cur_n->Get();
				for(k := 0; k < lim; k += 1;) {
					pc := cur[k];
					if(Accepts(@program->Get(pc), c)) {
						base := k * ncap;
						for(i := 0; i < ncap; i += 1;) {
							caps[i] := cur_caps[base + i];
						};
						AddThreadCap(pc + 1, caps, nxt, nxt_caps, nxt_n, ncap, visited, gen, stream_in, pos + 1, input_size, right, found, found_ref);
					};
				};

				tmp := cur;
				cur := nxt;
				nxt := tmp;
				tmp_caps := cur_caps;
				cur_caps := nxt_caps;
				nxt_caps := tmp_caps;
				cur_n->Set(nxt_n->Get());
				nxt_n->Set(0);

				pos += 1;
			};

			return found;
		}

		# ---------- parsing methods ----------
		method : private : NextToken() ~ Nil {
			if(@token_pos < @tokens->Size()) {
				@token := @tokens[@token_pos];
				@token_pos += 1;
			}
			else {
				@token := '\0';
			};
		}

		method : private : Parse() ~ Nil {
			NextToken();
			Binary();

			if(@starts_anchor) {
				@error := "stray token";
			};
		}

		method : private : Binary() ~ Nil {
			if(@starts_anchor & @expressions->Size() > 0) {
				expression := @expressions->RemoveBack();
				@expressions->AddBack(Expression->New(Expression->Type->STARTS_ANCHOR, expression));
				@starts_anchor := false;
			};

			while(@token <> '\0' & @token <> ')' & @token <> '|') {
				Unary();
				if(@error <> Nil) {
					return;
				};
			};

			if(@token = '|') {
				NextToken();

				left := @expressions;
				@expressions := Vector->New()<Expression>;

				Binary();
				if(@error <> Nil) {
					return;
				};

				right := @expressions;
				@expressions := Vector->New()<Expression>;

				@expressions->AddBack(Expression->New(left, right));
			};
		}

		method : private : Unary() ~ Nil {
			if(@starts_anchor & @expressions->Size() > 0) {
				expression := @expressions->RemoveBack();
				@expressions->AddBack(Expression->New(Expression->Type->STARTS_ANCHOR, expression));
				@starts_anchor := false;
			};

			Value();
			if(@error <> Nil) {
				return;
			};

			if(@token = '*') {
				if(@expressions->Size() > 0) {
					expression := @expressions->RemoveBack();
					@expressions->AddBack(Expression->New(Expression->Type->ZERO_MORE, expression));
					NextToken();
				}
				else {
					@error := "missing left-hand side operand";
					return;
				};
			}
			else if(@token = '+') {
				if(@expressions->Size() > 0) {
					expression := @expressions->RemoveBack();
					@expressions->AddBack(Expression->New(Expression->Type->ONE_MORE, expression));
					NextToken();
				}
				else {
					@error := "missing left-hand side operand";
					return;
				};
			}
			else if(@token = '?') {
				if(@expressions->Size() > 0) {
					expression := @expressions->RemoveBack();
					@expressions->AddBack(Expression->New(Expression->Type->OPTIONAL, expression));
					NextToken();
				}
				else {
					@error := "missing left-hand side operand";
					return;
				};
			}
			else if(@token = '$') {
				if(@expressions->Size() > 0) {
					expression := @expressions->RemoveBack();
					@expressions->AddBack(Expression->New(Expression->Type->ENDS_ANCHOR, expression));
					NextToken();
				}
				else {
					@error := "missing left-hand side operand";
					return;
				};
			}
			else if(@token = '{') {
				if(@expressions->Size() > 0) {
					NextToken();

					Whitespace();
					least := Number()->ToInt();
					if(@error <> Nil) {
						return;
					};

					Whitespace();
					most := -1;
					if(@token = ',') {
						NextToken();
						Whitespace();
						most := Number()->ToInt();
						if(@error <> Nil) {
							return;
						};
					};

					Whitespace();
					if(@token <> '}') {
						@error := "expected '}'";
						return;
					};
					NextToken();

					expression := @expressions->RemoveBack();
					@expressions->AddBack(Expression->New(least, most, expression));
				}
				else {
					@error := "missing left-hand side operand";
					return;
				};
			};
		}

		method : private : Whitespace() ~ Nil {
			while(@token <> '\0' & (@token = ' ' | @token = '\t' | @token = '\r' | @token = '\n')) {
				NextToken();
			};
		}

		method : private : Number() ~ String {
			start := @token_pos - 1;
			while(@token <> '\0' & @token->IsDigit()) {
				NextToken();
			};

			if(start = @token_pos) {
				@error := "invalid number";
				return "";
			};

			return String->New(@tokens, start, @token_pos - start - 1);
		}

		method : private : Value() ~ Nil {
			if(@starts_anchor & @expressions->Size() > 0) {
				expression := @expressions->RemoveBack();
				@expressions->AddBack(Expression->New(Expression->Type->STARTS_ANCHOR, expression));
				@starts_anchor := false;
			};

			if(@token = '(') {
				Parentheses();
			}
			else if(@token = '[') {
				CharacterClass();
			}
			else if(@token = '\\') {
				EscapeCharacter();
			}
			else if(@token = '.') {
				@expressions->AddBack(Expression->New());
				NextToken();
			}
			else if(@token = '^') {
				@starts_anchor := true;
				NextToken();
			}
			else {
				select(@token) {
					label '*':
					label '+':
					label '?':
					label '$':
					label '{': { # nop processed by unary method
					}

					other: {
						@expressions->AddBack(Expression->New(@token));
						NextToken();
					}
				};
			};
		}

		# The token after the current one, without consuming it
		method : private : PeekToken() ~ Char {
			if(@token_pos < @tokens->Size()) {
				return @tokens[@token_pos];
			};
			return '\0';
		}

		# Parses '[...]': any mix of literals, ranges and \d \w \s \D \W \S, optionally negated with a
		# leading '^'. A ']' first, or a '-' first or last, is a literal.
		method : private : CharacterClass() ~ Nil {
			NextToken();

			set := CharSet->New();
			if(@token = '^') {
				set->SetNegate(true);
				NextToken();
			};

			first := true;
			while(@token <> '\0' & (first | @token <> ']')) {
				first := false;

				lo := ClassAtom(set);
				if(@error <> Nil) {
					return;
				};

				if(@class_shorthand) {
					# shorthand already added; a '-' after it is read as a literal next time round
				}
				else if(@token = '-' & PeekToken() <> ']' & PeekToken() <> '\0') {
					NextToken();
					hi := ClassAtom(set);
					if(@error <> Nil) {
						return;
					};

					if(@class_shorthand) {
						# e.g. [a-\d]: no range, so 'a' and '-' are literals
						set->AddRange(lo, lo);
						set->AddRange('-', '-');
					}
					else if(hi < lo) {
						@error := "invalid character class range";
						return;
					}
					else {
						set->AddRange(lo, hi);
					};
				}
				else {
					set->AddRange(lo, lo);
				};
			};

			if(@token <> ']') {
				@error := "expected ']'";
				return;
			};
			NextToken();

			@expressions->AddBack(Expression->New(set));
		}

		# Reads one class member. Returns the literal character, or sets @class_shorthand after adding
		# a \d \w \s \D \W \S set to 'set'.
		method : private : ClassAtom(set : CharSet) ~ Char {
			@class_shorthand := false;

			if(@token = '\\') {
				NextToken();
				escaped := @token;
				select(escaped) {
					label 'd':
					label 'D':
					label 'w':
					label 'W':
					label 's':
					label 'S': {
						set->AddShorthand(escaped);
						@class_shorthand := true;
						NextToken();
						return '\0';
					}

					label 'n': {
						NextToken();
						return '\n';
					}

					label 'r': {
						NextToken();
						return '\r';
					}

					label 't': {
						NextToken();
						return '\t';
					}

					label 'b': {
						# inside a class \b is a backspace, as in other dialects
						NextToken();
						return '\b';
					}

					label '\0': {
						@error := "expected ']'";
						return '\0';
					}
				};

				# any other escaped character is itself: \] \\ \- \^ \[ \. ...
				NextToken();
				return escaped;
			};

			literal := @token;
			NextToken();
			return literal;
		}

		method : private : EscapeCharacter() ~ Nil {
			NextToken();
			select(@token) {
				label '(':
				label ')':
				label '[':
				label ']':
				label '}':
				label '{':
				label '|':
				label '.':
				label '?':
				label '^':
				label '$':
				label '*':
				label '+': {
					@expressions->AddBack(Expression->New(@token));
					NextToken();
				}

				label 'd': {
					@expressions->AddBack(Expression->New(Expression->Type->DIGIT));
					NextToken();
				}

				label 'D': {
					@expressions->AddBack(Expression->New(Expression->Type->NOT_DIGIT));
					NextToken();
				}

				label 'w': {
					@expressions->AddBack(Expression->New(Expression->Type->WORD));
					NextToken();
				}

				label 'W': {
					@expressions->AddBack(Expression->New(Expression->Type->NOT_WORD));
					NextToken();
				}

				label 's': {
					@expressions->AddBack(Expression->New(Expression->Type->WHITESPACE));
					NextToken();
				}

				label 'S': {
					@expressions->AddBack(Expression->New(Expression->Type->NOT_WHITESPACE));
					NextToken();
				}

				label 'n': {
					@expressions->AddBack(Expression->New('\n'));
					NextToken();
				}

				label 'r': {
					@expressions->AddBack(Expression->New('\r'));
					NextToken();
				}

				label 'b': {
					@expressions->AddBack(Expression->New(Expression->Type->WORD_BOUNDARY));
					NextToken();
				}

				label 'B': {
					@expressions->AddBack(Expression->New(Expression->Type->NOT_WORD_BOUNDARY));
					NextToken();
				}

				label 't': {
					@expressions->AddBack(Expression->New('\t'));
					NextToken();
				}

				label '\\': {
					@expressions->AddBack(Expression->New('\\'));
					NextToken();
				}
			};
		}

		method : private : Parentheses() ~ Nil {
			NextToken();

			# '(?:' opens a non-capturing group; groups are numbered by their '(' left to right
			group := 0;
			if(@token = '?') {
				if(PeekToken() <> ':') {
					@error := "unsupported group syntax";
					return;
				};
				NextToken();
				NextToken();
			}
			else {
				@group_count += 1;
				group := @group_count;
			};

			left := @expressions;
			@expressions := Vector->New()<Expression>;

			Binary();
			if(@error <> Nil) {
				return;
			};

			if(@token <> ')') {
				@error := "expected ')'";
				return;
			};
			NextToken();

			sub_expr := Expression->New(@expressions);
			sub_expr->SetGroup(group);
			left->AddBack(sub_expr);
			@expressions := left;
		}
	}

	#~
	RegEx result: the matched text, its position, and the text of each numbered capture group
	~#
	class Result {
		@start : Int;
		@length : Int;
		@value : String;
		@group_starts : Int[];
		@group_values : String[];

		#~
		Creates a result without capture groups
		@param start starting index of the match
		@param length length of the match
		@param value matched string
		~#
		New(start : Int, length : Int, value : String) {
			@start := start;
			@length := length;
			@value := value;
		}

		#~
		Creates a result with capture groups
		@param start starting index of the match
		@param length length of the match
		@param value matched string
		@param group_starts start index of each group, index 0 is the whole match, -1 if a group did not take part
		@param group_values text of each group, index 0 is the whole match, Nil if a group did not take part
		~#
		New(start : Int, length : Int, value : String, group_starts : Int[], group_values : String[]) {
			@start := start;
			@length := length;
			@value := value;
			@group_starts := group_starts;
			@group_values := group_values;
		}

		#~
		Gets the number of capture groups in the pattern, not counting group 0 (the whole match)
		@return number of capture groups
		~#
		method : public : GroupCount() ~ Int {
			if(@group_values = Nil) {
				return 0;
			};
			return @group_values->Size() - 1;
		}

		#~
		Gets the text captured by a group. Groups are numbered from 1 by their opening '(' left to
		right; '(?:...)' does not capture. Group 0 is the whole match. In a repeated group the last
		iteration wins.
		@param index group number
		@return captured text, or Nil if the group did not take part in the match or does not exist

```
re := RegEx->New("(\\d+)-(\\d+)");
r := re->FindFirst("call 555-1234 now");
if(r <> Nil) {
  r->GetGroup(1)->PrintLine();
  r->GetGroup(2)->PrintLine();
};
```
		~#
		method : public : GetGroup(index : Int) ~ String {
			if(index = 0) {
				return @value;
			};

			if(@group_values = Nil | index < 0 | index >= @group_values->Size()) {
				return Nil;
			};

			return @group_values[index];
		}

		#~
		Gets the starting index of the text captured by a group
		@param index group number, 0 is the whole match
		@return starting index, or -1 if the group did not take part in the match or does not exist
		~#
		method : public : GetGroupStart(index : Int) ~ Int {
			if(index = 0) {
				return @start;
			};

			if(@group_starts = Nil | index < 0 | index >= @group_starts->Size()) {
				return -1;
			};

			return @group_starts[index];
		}

		#~
		Gets the starting index of match
		@return starting index of match

```
re := RegEx->New("\\d+");
r := re->FindFirst("price: 99 dollars");
if(r <> Nil) {
  Console->PrintLine(r->GetStart());
};
```
		~#
		method : public : GetStart() ~ Int {
			return @start;
		}

		#~
		Gets the string length of the match
		@return string length of the match

```
re := RegEx->New("\\w+");
r := re->FindFirst("hello world");
if(r <> Nil) {
  Console->PrintLine(r->GetLength());
};
```
		~#
		method : public : GetLength() ~ Int {
			return @length;
		}

		#~
		Gets the string value
		@return string value

```
re := RegEx->New("[A-Z][a-z]+");
r := re->FindFirst("The Quick Brown Fox");
if(r <> Nil) {
  r->GetValue()->PrintLine();
};
```
		~#
		method : public : GetValue() ~ String {
			return @value;
		}

		#~
		Gets the string representation
		@return string representation

```
re := RegEx->New("\\d+");
results := re->Find("a1 b22 c333")<Result>;
each(r := results) {
  r->ToString()->PrintLine();
};
```
		~#
		method : public : ToString() ~ String {
			return @value;
		}
	}

	# ---------- flat NFA instruction ----------
	class : private : Instruction {
		enum Op := 0 {
			CHAR,
			ANY,
			DIGIT,
			NOT_DIGIT,
			WORD,
			NOT_WORD,
			WHITESPACE,
			NOT_WHITESPACE,
			CLASS,
			SPLIT,
			JUMP,
			MATCH,
			ANC_START,
			ANC_END,
			WORD_BOUND,
			NOT_WORD_BOUND,
			SAVE
		}

		@op : Int;
		@char_val : Char;
		@set : CharSet;
		@target1 : Int;
		@target2 : Int;

		New(op : Instruction->Op) {
			@op := op->As(Int);
		}

		New(op : Instruction->Op, c : Char) {
			@op := op->As(Int);
			@char_val := c;
		}

		New(op : Instruction->Op, set : CharSet) {
			@op := op->As(Int);
			@set := set;
		}

		New(op : Instruction->Op, t1 : Int, t2 : Int) {
			@op := op->As(Int);
			@target1 := t1;
			@target2 := t2;
		}

		function : NewOp(op : Instruction->Op) ~ Instruction {
			return Instruction->New(op);
		}

		function : NewChar(c : Char) ~ Instruction {
			return Instruction->New(Instruction->Op->CHAR, c);
		}

		function : NewClass(set : CharSet) ~ Instruction {
			return Instruction->New(Instruction->Op->CLASS, set);
		}

		# SAVE keeps its capture slot in target1
		function : NewSave(slot : Int) ~ Instruction {
			return Instruction->New(Instruction->Op->SAVE, slot, 0);
		}

		function : NewSplit(t1 : Int, t2 : Int) ~ Instruction {
			return Instruction->New(Instruction->Op->SPLIT, t1, t2);
		}

		function : NewJump(t1 : Int) ~ Instruction {
			instr := Instruction->New(Instruction->Op->JUMP, t1, 0);
			return instr;
		}

		method : public : GetOp() ~ Int {
			return @op;
		}

		method : public : GetChar() ~ Char {
			return @char_val;
		}

		method : public : GetSet() ~ CharSet {
			return @set;
		}

		method : public : GetTarget1() ~ Int {
			return @target1;
		}

		method : public : GetTarget2() ~ Int {
			return @target2;
		}

		method : public : SetTarget1(t : Int) ~ Nil {
			@target1 := t;
		}

		method : public : SetTarget2(t : Int) ~ Nil {
			@target2 := t;
		}
	}

	# ---------- character class: inclusive ranges plus \d \w \s style sets ----------
	class : private : CharSet {
		@ranges : Char[];
		@size : Int;
		@negate : Bool;
		@digit : Bool;
		@not_digit : Bool;
		@word : Bool;
		@not_word : Bool;
		@space : Bool;
		@not_space : Bool;

		New() {
			@ranges := Char->New[8];
			@size := 0;
		}

		function : IsWord(c : Char) ~ Bool {
			return c->IsDigit() | c->IsChar() | c = '_';
		}

		function : IsSpace(c : Char) ~ Bool {
			return c = ' ' | c = '\t' | c = '\r' | c = '\n' | c = 0xB;
		}

		method : public : SetNegate(negate : Bool) ~ Nil {
			@negate := negate;
		}

		# adds lo..hi inclusive (lo = hi for a single character)
		method : public : AddRange(lo : Char, hi : Char) ~ Nil {
			if(@size + 2 > @ranges->Size()) {
				grown := Char->New[@ranges->Size() * 2];
				for(i := 0; i < @size; i += 1;) {
					grown[i] := @ranges[i];
				};
				@ranges := grown;
			};

			@ranges[@size] := lo;
			@ranges[@size + 1] := hi;
			@size += 2;
		}

		# adds the set named by the letter of \d \D \w \W \s \S
		method : public : AddShorthand(letter : Char) ~ Nil {
			select(letter) {
				label 'd': { @digit := true; }
				label 'D': { @not_digit := true; }
				label 'w': { @word := true; }
				label 'W': { @not_word := true; }
				label 's': { @space := true; }
				label 'S': { @not_space := true; }
			};
		}

		method : public : Contains(c : Char) ~ Bool {
			if(@negate) {
				return <>Member(c);
			};
			return Member(c);
		}

		method : private : Member(c : Char) ~ Bool {
			for(i := 0; i < @size; i += 2;) {
				if(c >= @ranges[i] & c <= @ranges[i + 1]) {
					return true;
				};
			};

			if(@digit & c->IsDigit()) {
				return true;
			};

			if(@not_digit & <>c->IsDigit()) {
				return true;
			};

			if(@word & IsWord(c)) {
				return true;
			};

			if(@not_word & <>IsWord(c)) {
				return true;
			};

			if(@space & IsSpace(c)) {
				return true;
			};

			if(@not_space & <>IsSpace(c)) {
				return true;
			};

			return false;
		}
	}

	# ---------- sub-expression value object ----------
	class : private : Expression {
		# expression type
		enum Type := -100 {
			CHAR,
			ANY,
			OPTIONAL,
			DIGIT,
			NOT_DIGIT,
			WORD,
			NOT_WORD,
			WHITESPACE,
			NOT_WHITESPACE,
			CHAR_CLASS,
			ENDS_ANCHOR,
			STARTS_ANCHOR,
			OR,
			ZERO_MORE,
			ONE_MORE,
			REPEAT,
			SUB_EXPR,
			WORD_BOUNDARY,
			NOT_WORD_BOUNDARY
		}

		@type : Expression->Type;
		@value : Char;
		@set : CharSet;
		@group : Int;
		@expression : Expression;
		@left : Vector<Expression>;
		@right : Vector<Expression>;
		@least : Int;
		@most : Int;

		New() {
			@type := Expression->Type->ANY;
		}

		New(value : Char) {
			@type := Expression->Type->CHAR;
			@value := value;
		}

		New(least : Int, most : Int, expression : Expression) {
			@type := Expression->Type->REPEAT;
			@least := least;
			@most := most;
			@expression := expression;
		}

		New(set : CharSet) {
			@type := Expression->Type->CHAR_CLASS;
			@set := set;
		}

		New(left : Vector<Expression>) {
			@type := Expression->Type->SUB_EXPR;
			@left := left;
		}

		New(type : Expression->Type) {
			@type := type;
		}

		New(type : Expression->Type, expression : Expression) {
			@type := type;
			@expression := expression;
		}

		New(left : Vector<Expression>, right : Vector<Expression>) {
			@type := Expression->Type->OR;
			@left := left;
			@right := right;
		}

		method : public : GetType() ~ Expression->Type {
			return @type;
		}

		method : public : GetValue() ~ Char {
			return @value;
		}

		method : public : GetSet() ~ CharSet {
			return @set;
		}

		# capture group number of a SUB_EXPR, 0 if it does not capture
		method : public : GetGroup() ~ Int {
			return @group;
		}

		method : public : SetGroup(group : Int) ~ Nil {
			@group := group;
		}

		method : public : GetLeft() ~ Vector<Expression> {
			return @left;
		}

		method : public : GetRight() ~ Vector<Expression> {
			return @right;
		}

		method : public : GetLeast() ~ Int {
			return @least;
		}

		method : public : GetMost() ~ Int {
			return @most;
		}

		method : public : GetExpression() ~ Expression {
			return @expression;
		}
	}
}
