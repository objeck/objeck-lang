use Web.HTTP, Collection, Data.JSON, System.Concurrency, System.IO.Filesystem;

#~
A provider-neutral tool-use loop (an agent). A program hands a chat model a set of Objeck functions
as tools and gets the final answer back: AgentTool describes one function (name, description, a JSON
Schema for its arguments, and the handler), ToolRegistry holds them, ChatBackend is the one interface a
model sits behind (AnthropicBackend, OpenAIBackend, GeminiBackend and OllamaBackend translate to each
provider's wire format; ScriptedBackend is a fake for tests), and Agent runs the loop: send the
conversation, run the tool calls the model asks for, send the results, repeat until a plain answer.
The loop checks each call's arguments against the tool's schema before the handler runs, turns a
failing handler into an error result the model can read, enforces a step limit, an allow list, a deny
list and an optional approval callback, and returns the whole transcript as an AgentResult. The
backends speak to the providers directly over HTTPS (or HTTP for a local Ollama), so this library does
not need the provider client libraries. Compile with -lib agent,net,json,cipher,misc.
~#
bundle API.Agent {
	#~
	Runs one tool. Implement this for a tool that needs state; a plain function can be wrapped with
	Func2Ref instead.
	~#
	interface AgentToolHandler {
		#~
		Runs the tool
		@param arguments the call's arguments, already checked against the tool's schema
		@return the result text for the model, or Nil when the tool failed. A handler may also fail by
		calling Runtime->Raise(Error->New("what went wrong")) or by hitting a runtime error; the agent
		catches it and reports the message to the model as an error result
		~#
		method : virtual : public : Run(arguments : JsonElement) ~ String;
	}

	#~
	Decides whether a tool marked dangerous (or any tool, when the agent is told to ask every time) may run
	~#
	interface AgentApprover {
		#~
		Asked after the arguments pass validation and before the handler runs
		@param call the call the model made
		@param tool the tool it names
		@return true to run it, false to refuse; the model is told the call was declined
		~#
		method : virtual : public : Approve(call : AgentToolCall, tool : AgentTool) ~ Bool;
	}

	#~
	Receives the steps of a run as they happen, for a progress display or a log
	~#
	interface AgentObserver {
		#~
		Called after the model answers, before its tool calls run
		@param step_index step number, from 1
		@param reply the model's reply
		~#
		method : virtual : public : OnReply(step_index : Int, reply : AgentReply) ~ Nil;

		#~
		Called after each tool call finishes, including calls that were refused or failed
		@param step_index step number, from 1
		@param result what the call produced
		~#
		method : virtual : public : OnToolResult(step_index : Int, result : AgentToolResult) ~ Nil;
	}

	#~
	Runs a tool that wants the run's cancellation token. The handler can poll IsCancelled() in a long
	loop and return early; the token also reports a passed deadline, so a cooperative tool stops for either.
	~#
	interface AgentCancelableHandler {
		#~
		Runs the tool
		@param arguments the call's arguments, already checked against the tool's schema
		@param cancel the run's token, never Nil
		@return the result text for the model, or Nil when the tool failed
		~#
		method : virtual : public : Run(arguments : JsonElement, cancel : AgentCancel) ~ String;
	}

	#~
	Receives the structured events of a run (run_start, budget_check, model_start, model_end, model_retry,
	tool_start, tool_end, halt, run_end). An AgentObserver that also implements this interface gets them too.
	~#
	interface AgentTraceSink {
		#~
		Called for each event, in order, on the thread that runs the loop
		@param event the event
		~#
		method : virtual : public : OnEvent(event : AgentEvent) ~ Nil;
	}

	#~
	An optional extension for a ChatBackend: the loop tells it how long the next call may take, and a
	backend that can honor a total deadline returns promptly (a Nil reply with GetLastError set) when the
	time passes. A backend that does not implement it is simply never told.
	~#
	interface AgentDeadlineAware {
		#~
		Sets the longest the next Chat may take
		@param millis limit in milliseconds, 0 for none
		~#
		method : virtual : public : SetDeadlineMs(millis : Int) ~ Nil;
	}

	#~
	One model, behind the one method the loop needs. A backend turns the neutral conversation and tool
	list into its provider's request, sends it and turns the response back into an AgentReply.
	~#
	interface ChatBackend {
		#~
		Names the provider
		@return anthropic, openai, gemini, ollama or scripted
		~#
		method : virtual : public : GetName() ~ String;

		#~
		Sends the conversation and returns the model's next reply
		@param conversation the conversation so far
		@param tools the tools the model may call, or Nil for none
		@return the reply, or Nil with GetLastError() set
		~#
		method : virtual : public : Chat(conversation : AgentConversation, tools : Vector<AgentTool>) ~ AgentReply;

		#~
		Says why the last Chat returned Nil
		@return the error, or Nil
		~#
		method : virtual : public : GetLastError() ~ String;
	}

	#~
	A tool call the model made
	~#
	class AgentToolCall {
		@id : String;
		@name : String;
		@arguments : JsonElement;

		#~
		Constructor
		@param id the call's id, which the result must carry back
		@param name name of the tool
		@param arguments the arguments as a JSON object, or Nil when the model sent text that was not JSON
		~#
		New(id : String, name : String, arguments : JsonElement) {
			@id := id;
			@name := name;
			@arguments := arguments;
		}

		#~
		Gets the call id
		@return id
		~#
		method : public : GetId() ~ String {
			return @id;
		}

		#~
		Gets the tool name
		@return name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Gets the arguments
		@return a JSON object, or Nil when the model's arguments were not JSON
		~#
		method : public : GetArguments() ~ JsonElement {
			return @arguments;
		}

		#~
		Gets one argument as text
		@param name argument name
		@return the value as text, or Nil when it is missing
		~#
		method : public : GetArgument(name : String) ~ String {
			return AgentJs->Text(@arguments, name);
		}

		#~
		Describes the call
		@return name(arguments)
		~#
		method : public : ToString() ~ String {
			text := String->New();
			text->Append(@name);
			text->Append('(');
			if(@arguments <> Nil) {
				text->Append(@arguments->ToString());
			};
			text->Append(')');
			return text;
		}
	}

	#~
	What a model sent back: text, tool calls, and why it stopped
	~#
	class AgentReply {
		@text : String;
		@calls : Vector<AgentToolCall>;
		@stop : String;
		@input_tokens : Int;
		@output_tokens : Int;
		@raw : JsonElement;

		#~
		Constructor
		@param text the reply text, "" for none
		@param calls tool calls, or Nil for none
		@param stop why it stopped: end, tool_calls, length, filtered or other
		@param input_tokens tokens read, 0 when unknown
		@param output_tokens tokens written, 0 when unknown
		~#
		New(text : String, calls : Vector<AgentToolCall>, stop : String, input_tokens : Int, output_tokens : Int) {
			@text := text;
			if(@text = Nil) {
				@text := "";
			};
			@calls := calls;
			if(@calls = Nil) {
				@calls := Vector->New()<AgentToolCall>;
			};
			@stop := stop;
			@input_tokens := input_tokens;
			@output_tokens := output_tokens;
		}

		#~
		A reply that is plain text
		@param text the answer
		@return reply
		~#
		function : Say(text : String) ~ AgentReply {
			return AgentReply->New(text, Nil, "end", 0, 0);
		}

		#~
		A reply that asks for one tool call
		@param id call id
		@param name tool name
		@param arguments arguments as JSON text
		@return reply
		~#
		function : Ask(id : String, name : String, arguments : String) ~ AgentReply {
			calls := Vector->New()<AgentToolCall>;
			calls->AddBack(AgentToolCall->New(id, name, AgentJs->Arguments(arguments)));
			return AgentReply->New("", calls, "tool_calls", 0, 0);
		}

		#~
		A reply that asks for several tool calls at once
		@param calls the calls
		@return reply
		~#
		function : AskAll(calls : Vector<AgentToolCall>) ~ AgentReply {
			return AgentReply->New("", calls, "tool_calls", 0, 0);
		}

		#~
		Gets the text
		@return text, "" when the reply has none
		~#
		method : public : GetText() ~ String {
			return @text;
		}

		#~
		Gets the tool calls
		@return calls, empty for a plain answer
		~#
		method : public : GetToolCalls() ~ Vector<AgentToolCall> {
			return @calls;
		}

		#~
		Says whether the model asked for tools
		@return true when there is at least one call
		~#
		method : public : HasToolCalls() ~ Bool {
			return @calls->Size() > 0;
		}

		#~
		Gets the stop reason, in one vocabulary for every provider
		@return end, tool_calls, length, filtered or other
		~#
		method : public : GetStopReason() ~ String {
			return @stop;
		}

		#~
		Gets the tokens read
		@return count, 0 when unknown
		~#
		method : public : GetInputTokens() ~ Int {
			return @input_tokens;
		}

		#~
		Gets the tokens written
		@return count, 0 when unknown
		~#
		method : public : GetOutputTokens() ~ Int {
			return @output_tokens;
		}

		#~
		The provider's own form of the reply, kept so a backend can send it back exactly (Gemini needs
		its thought signatures returned)
		@param raw provider payload
		~#
		method : public : SetRaw(raw : JsonElement) ~ Nil {
			@raw := raw;
		}

		#~
		Gets the provider's own form of the reply
		@return payload, or Nil
		~#
		method : public : GetRaw() ~ JsonElement {
			return @raw;
		}
	}

	#~
	One item of a conversation: what the user said, what the model said (with its tool calls), or what a tool returned
	~#
	class AgentEntry {
		@role : String;
		@text : String;
		@calls : Vector<AgentToolCall>;
		@raw : JsonElement;
		@provider : String;
		@call_id : String;
		@tool_name : String;
		@is_error : Bool;

		#~
		Constructor
		@param role user, assistant or tool
		@param text the text, or a tool's result
		~#
		New(role : String, text : String) {
			@role := role;
			@text := text;
			if(@text = Nil) {
				@text := "";
			};
			@calls := Vector->New()<AgentToolCall>;
		}

		#~
		Gets the role
		@return user, assistant or tool
		~#
		method : public : GetRole() ~ String {
			return @role;
		}

		#~
		Gets the text
		@return text, or a tool's result
		~#
		method : public : GetText() ~ String {
			return @text;
		}

		#~
		Gets the tool calls of an assistant entry
		@return calls, empty for other roles
		~#
		method : public : GetToolCalls() ~ Vector<AgentToolCall> {
			return @calls;
		}

		#~
		Gets the provider's own form of an assistant entry
		@return payload, or Nil
		~#
		method : public : GetRaw() ~ JsonElement {
			return @raw;
		}

		#~
		Gets the provider that made the raw payload
		@return provider name, or Nil
		~#
		method : public : GetProvider() ~ String {
			return @provider;
		}

		#~
		Gets the id of the call a tool entry answers
		@return call id
		~#
		method : public : GetCallId() ~ String {
			return @call_id;
		}

		#~
		Gets the name of the tool a tool entry answers
		@return tool name
		~#
		method : public : GetToolName() ~ String {
			return @tool_name;
		}

		#~
		Says whether a tool entry reports a failure
		@return true for an error result
		~#
		method : public : IsError() ~ Bool {
			return @is_error;
		}

		#~
		@hidden
		~#
		method : public : SetAssistant(reply : AgentReply, provider : String) ~ Nil {
			@calls := reply->GetToolCalls();
			@raw := reply->GetRaw();
			@provider := provider;
		}

		#~
		@hidden
		~#
		method : public : SetResult(call_id : String, tool_name : String, is_error : Bool) ~ Nil {
			@call_id := call_id;
			@tool_name := tool_name;
			@is_error := is_error;
		}
	}

	#~
	The conversation a backend turns into a request: an optional system prompt and the entries so far
	~#
	class AgentConversation {
		@system : String;
		@entries : Vector<AgentEntry>;

		#~
		Constructor
		~#
		New() {
			@entries := Vector->New()<AgentEntry>;
		}

		#~
		Sets the system prompt
		@param system prompt, or Nil for none
		~#
		method : public : SetSystem(system : String) ~ Nil {
			@system := system;
		}

		#~
		Gets the system prompt
		@return prompt, or Nil
		~#
		method : public : GetSystem() ~ String {
			return @system;
		}

		#~
		Adds a user message
		@param text the message
		~#
		method : public : AddUser(text : String) ~ Nil {
			@entries->AddBack(AgentEntry->New("user", text));
		}

		#~
		Adds the model's reply, with its tool calls
		@param reply the reply
		@param provider the backend that made it
		~#
		method : public : AddAssistant(reply : AgentReply, provider : String) ~ Nil {
			entry := AgentEntry->New("assistant", reply->GetText());
			entry->SetAssistant(reply, provider);
			@entries->AddBack(entry);
		}

		#~
		Adds the result of one tool call
		@param call_id id of the call it answers
		@param tool_name name of the tool
		@param content the result, or the error text
		@param is_error true when the call failed
		~#
		method : public : AddToolResult(call_id : String, tool_name : String, content : String, is_error : Bool) ~ Nil {
			entry := AgentEntry->New("tool", content);
			entry->SetResult(call_id, tool_name, is_error);
			@entries->AddBack(entry);
		}

		#~
		Gets the entries
		@return entries, oldest first
		~#
		method : public : GetEntries() ~ Vector<AgentEntry> {
			return @entries;
		}

		#~
		Gets the number of entries
		@return count
		~#
		method : public : Size() ~ Int {
			return @entries->Size();
		}

		#~
		Forgets every entry; the system prompt stays
		~#
		method : public : Clear() ~ Nil {
			@entries := Vector->New()<AgentEntry>;
		}
	}

	#~
	A function the model may call: its name, a description the model reads, a JSON Schema for the
	arguments, and the handler.

```
schema := JsonParser->TextToElement("{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"]}");
tool := AgentTool->New("get_weather", "Get the weather for a city", schema, Func2Ref->New(Weather->Get(JsonElement) ~ String)<JsonElement, String>);
```
	~#
	class AgentTool {
		@name : String;
		@description : String;
		@schema : JsonElement;
		@handler : AgentToolHandler;
		@func : Func2Ref<JsonElement, String>;
		@json_func : Func2Ref<JsonElement, JsonElement>;
		@dangerous : Bool;
		@read_only : Int;
		@destructive : Int;
		@timeout_ms : Int;
		@cancel_handler : AgentCancelableHandler;
		@mode : AgentTool->Mode;
		@mode_set : Bool;

		#~
		How the loop runs a tool's handler. IN_THREAD runs it on the loop's own thread, which cannot be
		interrupted: a call over its limit is reported as a timeout only after it returns. BOUNDED_THREAD runs
		it on a worker thread and waits at most the tool's time limit, the run's deadline and cancellation: when
		one passes, the worker is abandoned (a thread cannot be killed, so a hung handler keeps its thread and
		whatever it holds until it returns, if it ever does) and its late result is dropped.
		~#
		enum Mode {
			IN_THREAD,
			BOUNDED_THREAD
		}

		#~
		Constructor for a handler that takes the run's cancellation token
		@param name tool name
		@param description what the tool does and when to use it
		@param schema JSON Schema of the arguments, an object schema; Nil means no arguments
		@param handler runs the tool
		~#
		New(name : String, description : String, schema : JsonElement, handler : AgentCancelableHandler) {
			Init(name, description, schema);
			@cancel_handler := handler;
		}

		#~
		Constructor for a handler object
		@param name tool name, letters, digits, underscores and hyphens (the providers require this)
		@param description what the tool does and when to use it
		@param schema JSON Schema of the arguments, an object schema; Nil means no arguments
		@param handler runs the tool
		~#
		New(name : String, description : String, schema : JsonElement, handler : AgentToolHandler) {
			Init(name, description, schema);
			@handler := handler;
		}

		#~
		Constructor for a function that returns text
		@param name tool name
		@param description what the tool does and when to use it
		@param schema JSON Schema of the arguments, an object schema; Nil means no arguments
		@param func function taking the arguments and returning the result text, or Nil on failure
		~#
		New(name : String, description : String, schema : JsonElement, func : Func2Ref<JsonElement, String>) {
			Init(name, description, schema);
			@func := func;
		}

		#~
		Constructor for a function that returns JSON; the result is sent to the model as JSON text
		@param name tool name
		@param description what the tool does and when to use it
		@param schema JSON Schema of the arguments, an object schema; Nil means no arguments
		@param func function taking the arguments and returning a JSON result, or Nil on failure
		~#
		New(name : String, description : String, schema : JsonElement, func : Func2Ref<JsonElement, JsonElement>) {
			Init(name, description, schema);
			@json_func := func;
		}

		method : Init(name : String, description : String, schema : JsonElement) ~ Nil {
			@name := name;
			@description := description;
			@schema := schema;
			if(@schema = Nil) {
				@schema := AgentJs->Arguments("{\"type\":\"object\",\"properties\":{}}");
			};
			@dangerous := false;
			@timeout_ms := 0;
			@mode := AgentTool->Mode->IN_THREAD;
		}

		#~
		Gets the name
		@return name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Gets the description
		@return description
		~#
		method : public : GetDescription() ~ String {
			return @description;
		}

		#~
		Gets the argument schema
		@return JSON Schema
		~#
		method : public : GetSchema() ~ JsonElement {
			return @schema;
		}

		#~
		Marks the tool as dangerous: every call needs the agent's approver to say yes, and with no approver
		the call is refused
		@param dangerous true for a tool with side effects the user should see first
		@return self for chaining
		~#
		method : public : SetDangerous(dangerous : Bool) ~ AgentTool {
			@dangerous := dangerous;
			return @self;
		}

		#~
		Says whether the tool needs approval
		@return true when dangerous
		~#
		method : public : IsDangerous() ~ Bool {
			return @dangerous;
		}

		#~
		Records the effect hint readOnlyHint (the MCP annotation of the same name): the tool does not change anything. A read-only tool is not asked about when the agent is set to SetApproveUnlessReadOnly
		@param read_only true for a tool that only reads
		@return self for chaining
		~#
		method : public : SetReadOnlyHint(read_only : Bool) ~ AgentTool {
			if(read_only) {
				@read_only := 1;
			}
			else {
				@read_only := 2;
			};
			return @self;
		}

		#~
		Records the effect hint destructiveHint (the MCP annotation of the same name): the tool may destroy or overwrite something. A tool whose destructive hint is true needs approval, like a dangerous one. An absent hint changes nothing
		@param destructive true for a tool that may destroy data
		@return self for chaining
		~#
		method : public : SetDestructiveHint(destructive : Bool) ~ AgentTool {
			if(destructive) {
				@destructive := 1;
			}
			else {
				@destructive := 2;
			};
			return @self;
		}

		#~
		Says whether the tool is known to be read-only
		@return true only when the read-only hint was stated and is true
		~#
		method : public : IsReadOnly() ~ Bool {
			return @read_only = 1;
		}

		#~
		Says whether the tool states that it may destroy data
		@return true only when the destructive hint was stated and is true
		~#
		method : public : IsDestructive() ~ Bool {
			return @destructive = 1;
		}

		#~
		Says whether every call needs the approver: the tool is dangerous or its destructive hint is true
		@return true when approval is needed whatever the agent's other settings
		~#
		method : public : NeedsApproval() ~ Bool {
			return @dangerous | (@destructive = 1);
		}

		#~
		Sets the longest the tool may take, in milliseconds. In IN_THREAD mode a running handler cannot be
		interrupted: a call that takes longer is reported to the model as a timeout and its result is discarded.
		In BOUNDED_THREAD mode the loop stops waiting at the limit.
		@param timeout_ms limit in milliseconds, 0 for the agent's default
		@return self for chaining
		~#
		method : public : SetTimeout(timeout_ms : Int) ~ AgentTool {
			@timeout_ms := timeout_ms;
			return @self;
		}

		#~
		Gets the tool's time limit
		@return milliseconds, 0 when it uses the agent's
		~#
		method : public : GetTimeout() ~ Int {
			return @timeout_ms;
		}

		#~
		Sets how the loop runs this tool, overriding the agent's default (see Mode)
		@param mode IN_THREAD or BOUNDED_THREAD
		@return self for chaining
		~#
		method : public : SetMode(mode : AgentTool->Mode) ~ AgentTool {
			@mode := mode;
			@mode_set := true;
			return @self;
		}

		#~
		Gets the tool's own mode
		@return the mode set with SetMode, IN_THREAD when none was set
		~#
		method : public : GetMode() ~ AgentTool->Mode {
			return @mode;
		}

		#~
		Says whether SetMode was called
		@return true when the tool has its own mode
		~#
		method : public : HasMode() ~ Bool {
			return @mode_set;
		}

		#~
		Runs the handler; errors it raises are not caught here (Agent does that)
		@param arguments the arguments
		@return result text, or Nil on failure
		~#
		method : public : Invoke(arguments : JsonElement) ~ String {
			return InvokeWith(arguments, Nil);
		}

		#~
		Runs the handler with the run's cancellation token; errors it raises are not caught here
		@param arguments the arguments
		@param cancel the token, or Nil for a token that is never cancelled
		@return result text, or Nil on failure
		~#
		method : public : InvokeWith(arguments : JsonElement, cancel : AgentCancel) ~ String {
			if(@cancel_handler <> Nil) {
				token := cancel;
				if(token = Nil) {
					token := AgentCancel->New();
				};
				return @cancel_handler->Run(arguments, token);
			};

			if(@handler <> Nil) {
				return @handler->Run(arguments);
			};

			if(@func <> Nil) {
				fn := @func->Get();
				return fn(arguments);
			};

			if(@json_func <> Nil) {
				jn := @json_func->Get();
				out := jn(arguments);
				if(out = Nil) {
					return Nil;
				};
				if(out->GetType() = JsonElement->JsonType->STRING) {
					return out->GetString();
				};
				return out->ToString();
			};

			return Nil;
		}
	}

	#~
	The tools an agent knows, with an allow list and a deny list. A tool the lists exclude is not shown to the
	model and a call to it is refused. With no allow list every registered tool is allowed; a name on the deny
	list is always refused.
	~#
	class ToolRegistry {
		@tools : Vector<AgentTool>;
		@allowed : Vector<String>;
		@denied : Vector<String>;

		#~
		Constructor
		~#
		New() {
			@tools := Vector->New()<AgentTool>;
			@allowed := Vector->New()<String>;
			@denied := Vector->New()<String>;
		}

		#~
		Adds a tool; one with the same name is replaced
		@param tool the tool
		@return self for chaining
		~#
		method : public : Add(tool : AgentTool) ~ ToolRegistry {
			i := 0;
			while(i < @tools->Size()) {
				if(@tools->Get(i)->GetName()->Equals(tool->GetName())) {
					@tools->Set(tool, i);
					return @self;
				};
				i += 1;
			};

			@tools->AddBack(tool);
			return @self;
		}

		#~
		Finds a tool by name
		@param name tool name
		@return the tool, or Nil
		~#
		method : public : Find(name : String) ~ AgentTool {
			if(name = Nil) {
				return Nil;
			};

			i := 0;
			while(i < @tools->Size()) {
				if(@tools->Get(i)->GetName()->Equals(name)) {
					return @tools->Get(i);
				};
				i += 1;
			};
			return Nil;
		}

		#~
		Gets the number of registered tools
		@return count
		~#
		method : public : Size() ~ Int {
			return @tools->Size();
		}

		#~
		Gets every registered tool
		@return tools in the order they were added
		~#
		method : public : GetAll() ~ Vector<AgentTool> {
			return @tools;
		}

		#~
		Adds a name to the allow list. Once the list has a name, only listed tools are allowed.
		@param name tool name
		@return self for chaining
		~#
		method : public : Allow(name : String) ~ ToolRegistry {
			@allowed->AddBack(name);
			return @self;
		}

		#~
		Adds a name to the deny list
		@param name tool name
		@return self for chaining
		~#
		method : public : Deny(name : String) ~ ToolRegistry {
			@denied->AddBack(name);
			return @self;
		}

		#~
		Says whether a tool may be offered and run
		@param name tool name
		@return false when it is on the deny list or an allow list exists without it
		~#
		method : public : Permits(name : String) ~ Bool {
			if(name = Nil | Listed(@denied, name)) {
				return false;
			};

			if(@allowed->Size() > 0) {
				return Listed(@allowed, name);
			};
			return true;
		}

		#~
		Gets the tools the model is shown
		@return registered tools that pass the allow and deny lists
		~#
		method : public : GetPermitted() ~ Vector<AgentTool> {
			permitted := Vector->New()<AgentTool>;
			i := 0;
			while(i < @tools->Size()) {
				if(Permits(@tools->Get(i)->GetName())) {
					permitted->AddBack(@tools->Get(i));
				};
				i += 1;
			};
			return permitted;
		}

		#~
		Lists the registered tool names, for an error message
		@return names separated by commas
		~#
		method : public : Names() ~ String {
			names := String->New();
			i := 0;
			while(i < @tools->Size()) {
				if(i > 0) {
					names->Append(", ");
				};
				names->Append(@tools->Get(i)->GetName());
				i += 1;
			};
			return names;
		}

		method : Listed(list : Vector<String>, name : String) ~ Bool {
			i := 0;
			while(i < list->Size()) {
				if(list->Get(i)->Equals(name)) {
					return true;
				};
				i += 1;
			};
			return false;
		}
	}

	#~
	What one tool call produced. The status says how it ended: ok, error (the handler failed), invalid
	(the arguments broke the schema), unknown (no such tool), denied (an allow or deny list excludes it),
	refused (the approver said no, or a dangerous tool had no approver), timeout (over its time limit, or
	the run's deadline passed while it ran), cancelled (the run was cancelled while it ran), or skipped (the
	step limit, a budget, a deadline or a cancellation came before it ran).
	~#
	class AgentToolResult {
		@call_id : String;
		@tool_name : String;
		@arguments : String;
		@content : String;
		@status : String;
		@millis : Int;

		#~
		Constructor
		@param call_id id of the call
		@param tool_name tool name
		@param arguments the arguments as JSON text
		@param content what goes back to the model
		@param status ok, error, invalid, unknown, denied, refused, timeout, cancelled or skipped
		@param millis how long the handler took
		~#
		New(call_id : String, tool_name : String, arguments : String, content : String, status : String, millis : Int) {
			@call_id := call_id;
			@tool_name := tool_name;
			@arguments := arguments;
			@content := content;
			@status := status;
			@millis := millis;
		}

		#~
		Gets the call id
		@return id
		~#
		method : public : GetCallId() ~ String {
			return @call_id;
		}

		#~
		Gets the tool name
		@return name
		~#
		method : public : GetToolName() ~ String {
			return @tool_name;
		}

		#~
		Gets the arguments the model sent
		@return JSON text
		~#
		method : public : GetArguments() ~ String {
			return @arguments;
		}

		#~
		Gets the result, or the error text, as the model saw it
		@return content
		~#
		method : public : GetContent() ~ String {
			return @content;
		}

		#~
		Gets the status
		@return ok, error, invalid, unknown, denied, refused, timeout, cancelled or skipped
		~#
		method : public : GetStatus() ~ String {
			return @status;
		}

		#~
		Says whether the call succeeded
		@return true for status ok
		~#
		method : public : IsOk() ~ Bool {
			return @status->Equals("ok");
		}

		#~
		Gets how long the handler ran
		@return milliseconds
		~#
		method : public : GetMillis() ~ Int {
			return @millis;
		}
	}

	#~
	One round of a run: the model's reply and the tool results that followed it
	~#
	class AgentStep {
		@index : Int;
		@reply : AgentReply;
		@results : Vector<AgentToolResult>;

		#~
		Constructor
		@param index step number, from 1
		@param reply the model's reply
		~#
		New(index : Int, reply : AgentReply) {
			@index := index;
			@reply := reply;
			@results := Vector->New()<AgentToolResult>;
		}

		#~
		Gets the step number
		@return number, from 1
		~#
		method : public : GetIndex() ~ Int {
			return @index;
		}

		#~
		Gets the model's reply
		@return reply
		~#
		method : public : GetReply() ~ AgentReply {
			return @reply;
		}

		#~
		Gets the tool results of this step
		@return results in call order, empty for the final answer
		~#
		method : public : GetResults() ~ Vector<AgentToolResult> {
			return @results;
		}

		#~
		@hidden
		~#
		method : public : AddResult(result : AgentToolResult) ~ Nil {
			@results->AddBack(result);
		}
	}

	#~
	The outcome of Agent->Run: the final text, how the run ended, and every step
	~#
	class AgentResult {
		@text : String;
		@status : String;
		@error : String;
		@steps : Vector<AgentStep>;
		@stop_reason : String;
		@model_calls : Int;
		@elapsed_ms : Int;
		@cost : Float;

		#~
		Constructor
		~#
		New() {
			@text := "";
			@status := "completed";
			@stop_reason := "completed";
			@steps := Vector->New()<AgentStep>;
		}

		#~
		Gets why the run stopped, in one vocabulary: completed, cancelled, deadline, budget_steps (the step
		limit, SetMaxSteps or the budget's), budget_model_calls, budget_tool_calls, budget_tokens,
		budget_cost or error. GetStatus gives the same word, except max_steps for the SetMaxSteps limit.
		@return the stop reason
		~#
		method : public : GetStopReason() ~ String {
			return @stop_reason;
		}

		#~
		Counts the model calls of the run, retries and failed calls included
		@return calls made
		~#
		method : public : GetModelCalls() ~ Int {
			return @model_calls;
		}

		#~
		Gets how long the run took
		@return milliseconds
		~#
		method : public : GetElapsedMs() ~ Int {
			return @elapsed_ms;
		}

		#~
		Gets what the run cost by the budget's price table
		@return cost, 0.0 when no prices were set
		~#
		method : public : GetCost() ~ Float {
			return @cost;
		}

		#~
		Counts the tokens the run read and wrote
		@return tokens, as far as the provider reported them
		~#
		method : public : GetTotalTokens() ~ Int {
			return GetInputTokens() + GetOutputTokens();
		}

		#~
		Gets the final answer
		@return the model's last text, "" when the run did not finish
		~#
		method : public : GetText() ~ String {
			return @text;
		}

		#~
		Gets how the run ended
		@return completed, max_steps or error, or one of the other stop reasons (see GetStopReason)
		~#
		method : public : GetStatus() ~ String {
			return @status;
		}

		#~
		Says whether the model gave a final answer
		@return true for status completed
		~#
		method : public : IsCompleted() ~ Bool {
			return @status->Equals("completed");
		}

		#~
		Gets the error of a run that did not finish
		@return message with API keys removed, or Nil
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Gets the steps
		@return steps, oldest first
		~#
		method : public : GetSteps() ~ Vector<AgentStep> {
			return @steps;
		}

		#~
		Counts the tool calls of the run
		@return calls made, whatever their outcome
		~#
		method : public : GetToolCallCount() ~ Int {
			total := 0;
			i := 0;
			while(i < @steps->Size()) {
				total += @steps->Get(i)->GetResults()->Size();
				i += 1;
			};
			return total;
		}

		#~
		Counts the tokens the run read
		@return tokens, as far as the provider reported them
		~#
		method : public : GetInputTokens() ~ Int {
			total := 0;
			i := 0;
			while(i < @steps->Size()) {
				total += @steps->Get(i)->GetReply()->GetInputTokens();
				i += 1;
			};
			return total;
		}

		#~
		Counts the tokens the run wrote
		@return tokens, as far as the provider reported them
		~#
		method : public : GetOutputTokens() ~ Int {
			total := 0;
			i := 0;
			while(i < @steps->Size()) {
				total += @steps->Get(i)->GetReply()->GetOutputTokens();
				i += 1;
			};
			return total;
		}

		#~
		@hidden
		~#
		method : public : AddStep(step : AgentStep) ~ Nil {
			@steps->AddBack(step);
		}

		#~
		@hidden
		~#
		method : public : Finish(text : String, status : String, error : String) ~ Nil {
			@text := text;
			@status := status;
			@stop_reason := status;
			if(status->Equals("max_steps")) {
				@stop_reason := "budget_steps";
			};
			if(error <> Nil) {
				@error := Redactor->Scrub(error);
			};
		}

		#~
		@hidden
		~#
		method : public : Halt(reason : String, message : String) ~ Nil {
			Finish("", reason, message);
		}

		#~
		@hidden
		~#
		method : public : SetStats(model_calls : Int, elapsed_ms : Int, cost : Float) ~ Nil {
			@model_calls := model_calls;
			@elapsed_ms := elapsed_ms;
			@cost := cost;
		}

		#~
		Writes the transcript as text, one line per event, with API keys removed
		@return transcript
		~#
		method : public : ToString() ~ String {
			out := String->New();
			i := 0;
			while(i < @steps->Size()) {
				AppendStep(out, @steps->Get(i));
				i += 1;
			};

			out->Append("result: ");
			out->Append(@status);
			if(@error <> Nil) {
				out->Append(" (");
				out->Append(@error);
				out->Append(')');
			};
			out->Append('\n');
			if(@text->Size() > 0) {
				out->Append("answer: ");
				out->Append(@text);
				out->Append('\n');
			};
			return Redactor->Scrub(out);
		}

		method : AppendStep(out : String, step : AgentStep) ~ Nil {
			index := step->GetIndex();
			reply := step->GetReply();
			if(reply->GetText()->Size() > 0) {
				out->Append("[{$index}] model: ");
				out->Append(reply->GetText());
				out->Append('\n');
			};

			results := step->GetResults();
			j := 0;
			while(j < results->Size()) {
				result := results->Get(j);
				out->Append("[{$index}] call ");
				out->Append(result->GetToolName());
				out->Append(' ');
				out->Append(result->GetArguments());
				out->Append(" -> ");
				out->Append(result->GetStatus());
				out->Append(": ");
				out->Append(result->GetContent()->Truncate(300, "..."));
				out->Append('\n');
				j += 1;
			};
		}

		#~
		Writes the transcript as JSON, with API keys removed
		@return an object with status, text, error and steps
		~#
		method : public : ToJson() ~ JsonElement {
			json := AgentJs->Object();
			json->Insert("status", @status);
			json->Insert("stop_reason", @stop_reason);
			json->Insert("text", Redactor->Scrub(@text));
			if(@error <> Nil) {
				json->Insert("error", @error);
			};

			steps_json := AgentJs->Array();
			i := 0;
			while(i < @steps->Size()) {
				steps_json->Add(StepJson(@steps->Get(i)));
				i += 1;
			};
			json->Insert("steps", steps_json);
			return json;
		}

		method : StepJson(step : AgentStep) ~ JsonElement {
			json := AgentJs->Object();
			json->Insert("index", step->GetIndex());
			json->Insert("text", Redactor->Scrub(step->GetReply()->GetText()));
			json->Insert("stop", step->GetReply()->GetStopReason());
			json->Insert("input_tokens", step->GetReply()->GetInputTokens());
			json->Insert("output_tokens", step->GetReply()->GetOutputTokens());

			results := step->GetResults();
			calls_json := AgentJs->Array();
			j := 0;
			while(j < results->Size()) {
				result := results->Get(j);
				call_json := AgentJs->Object();
				call_json->Insert("id", result->GetCallId());
				call_json->Insert("tool", result->GetToolName());
				call_json->Insert("arguments", Redactor->Scrub(result->GetArguments()));
				call_json->Insert("status", result->GetStatus());
				call_json->Insert("content", Redactor->Scrub(result->GetContent()));
				call_json->Insert("millis", result->GetMillis());
				calls_json->Add(call_json);
				j += 1;
			};
			json->Insert("calls", calls_json);
			return json;
		}
	}

	#~
	A cancellation token. Any thread may call Cancel(); the loop checks the token before every step and
	between tool calls and passes it to handlers that take one. A token can be linked to a parent: it
	counts as cancelled when its parent is.

```
cancel := AgentCancel->New();
agent->SetCancel(cancel);
# from another thread: cancel->Cancel("user pressed stop");
```
	~#
	class AgentCancel {
		@mutex : ThreadMutex;
		@cancelled : Bool;
		@reason : String;
		@parent : AgentCancel;

		#~
		Constructor
		~#
		New() {
			@mutex := ThreadMutex->New("agent_cancel");
		}

		#~
		Constructor for a token that is cancelled when its parent is
		@param parent the parent token, or Nil
		~#
		New(parent : AgentCancel) {
			@mutex := ThreadMutex->New("agent_cancel");
			@parent := parent;
		}

		#~
		Cancels the token; safe from any thread and safe to call twice
		~#
		method : public : Cancel() ~ Nil {
			Cancel("cancelled");
		}

		#~
		Cancels the token with a reason
		@param reason short text for the trace
		~#
		method : public : Cancel(reason : String) ~ Nil {
			critical(@mutex) {
				if(<>@cancelled) {
					@cancelled := true;
					@reason := reason;
				};
			};
		}

		#~
		Says whether the token or a parent was cancelled
		@return true after Cancel
		~#
		method : public : IsCancelled() ~ Bool {
			flag := false;
			critical(@mutex) {
				flag := @cancelled;
			};

			if(<>flag & @parent <> Nil) {
				return @parent->IsCancelled();
			};
			return flag;
		}

		#~
		Gets why the token was cancelled
		@return the reason, or Nil while it is not cancelled
		~#
		method : public : GetReason() ~ String {
			text : String;
			critical(@mutex) {
				text := @reason;
			};

			if(text = Nil & @parent <> Nil) {
				return @parent->GetReason();
			};
			return text;
		}
	}

	#~
	Per-model prices for the cost budget, in currency units per million tokens
	~#
	class AgentPrices {
		@names : Vector<String>;
		@input : Vector<FloatRef>;
		@output : Vector<FloatRef>;

		#~
		Constructor
		~#
		New() {
			@names := Vector->New()<String>;
			@input := Vector->New()<FloatRef>;
			@output := Vector->New()<FloatRef>;
		}

		#~
		Adds or replaces the price of a model
		@param model model name
		@param input_per_million price of a million tokens read
		@param output_per_million price of a million tokens written
		@return self for chaining
		~#
		method : public : Add(model : String, input_per_million : Float, output_per_million : Float) ~ AgentPrices {
			i := 0;
			while(i < @names->Size()) {
				if(@names->Get(i)->Equals(model)) {
					@input->Set(FloatRef->New(input_per_million), i);
					@output->Set(FloatRef->New(output_per_million), i);
					return @self;
				};
				i += 1;
			};

			@names->AddBack(model);
			@input->AddBack(FloatRef->New(input_per_million));
			@output->AddBack(FloatRef->New(output_per_million));
			return @self;
		}

		#~
		Finds a model's row
		@param model model name
		@return index, or -1 when the model has no price
		~#
		method : public : Find(model : String) ~ Int {
			i := 0;
			while(i < @names->Size()) {
				if(@names->Get(i)->Equals(model)) {
					return i;
				};
				i += 1;
			};
			return -1;
		}

		#~
		Gets the price of tokens read
		@param index row from Find
		@return currency per million
		~#
		method : public : GetInput(index : Int) ~ Float {
			return @input->Get(index)->Get();
		}

		#~
		Gets the price of tokens written
		@param index row from Find
		@return currency per million
		~#
		method : public : GetOutput(index : Int) ~ Float {
			return @output->Get(index)->Get();
		}
	}

	#~
	What one Run may use. Every limit is off (0) until it is set; the first one reached ends the run with a
	matching stop reason: budget_steps, budget_model_calls, budget_tool_calls, budget_tokens, budget_cost or
	deadline (the wall-clock limit). The counters start at zero on every Run. Tokens count only what the
	backend reports, so a backend that reports none never trips the token or cost limit.

```
budget := AgentBudget->New()->SetMaxWallMs(30000)->SetMaxToolCalls(20)->SetMaxTokens(50000);
agent->SetBudget(budget);
```
	~#
	class AgentBudget {
		@max_steps : Int;
		@max_wall_ms : Int;
		@max_model_calls : Int;
		@max_tool_calls : Int;
		@max_tokens : Int;
		@max_cost : Float;
		@model_call_ms : Int;
		@price_input : Float;
		@price_output : Float;

		#~
		Constructor: no limits
		~#
		New() {
		}

		#~
		Limits the model replies (steps) of one Run
		@param max_steps limit, 0 for none
		@return self for chaining
		~#
		method : public : SetMaxSteps(max_steps : Int) ~ AgentBudget {
			@max_steps := max_steps;
			return @self;
		}

		#~
		Limits the whole Run's wall-clock time: the total deadline. It also bounds every model call (for a
		backend that is deadline aware) and every tool wait.
		@param millis limit in milliseconds, 0 for none
		@return self for chaining
		~#
		method : public : SetMaxWallMs(millis : Int) ~ AgentBudget {
			@max_wall_ms := millis;
			return @self;
		}

		#~
		Limits the model calls of one Run, retries included
		@param max_calls limit, 0 for none
		@return self for chaining
		~#
		method : public : SetMaxModelCalls(max_calls : Int) ~ AgentBudget {
			@max_model_calls := max_calls;
			return @self;
		}

		#~
		Limits the tool calls of one Run that actually run
		@param max_calls limit, 0 for none
		@return self for chaining
		~#
		method : public : SetMaxToolCalls(max_calls : Int) ~ AgentBudget {
			@max_tool_calls := max_calls;
			return @self;
		}

		#~
		Limits the tokens (read plus written) of one Run
		@param max_tokens limit, 0 for none
		@return self for chaining
		~#
		method : public : SetMaxTokens(max_tokens : Int) ~ AgentBudget {
			@max_tokens := max_tokens;
			return @self;
		}

		#~
		Limits the cost of one Run; set the prices with SetPrice or SetPrices
		@param max_cost limit in the price table's currency, 0.0 for none
		@return self for chaining
		~#
		method : public : SetMaxCost(max_cost : Float) ~ AgentBudget {
			@max_cost := max_cost;
			return @self;
		}

		#~
		Sets how long one model call may take, apart from the run's deadline
		@param millis limit in milliseconds, 0 for none
		@return self for chaining
		~#
		method : public : SetModelCallMs(millis : Int) ~ AgentBudget {
			@model_call_ms := millis;
			return @self;
		}

		#~
		Sets one price for every model
		@param input_per_million price of a million tokens read
		@param output_per_million price of a million tokens written
		@return self for chaining
		~#
		method : public : SetPrice(input_per_million : Float, output_per_million : Float) ~ AgentBudget {
			@price_input := input_per_million;
			@price_output := output_per_million;
			return @self;
		}

		#~
		Takes the price of one model from a table
		@param prices the table
		@param model the model's name; a model with no row leaves the price unchanged
		@return self for chaining
		~#
		method : public : SetPrices(prices : AgentPrices, model : String) ~ AgentBudget {
			index := prices->Find(model);
			if(index >= 0) {
				@price_input := prices->GetInput(index);
				@price_output := prices->GetOutput(index);
			};
			return @self;
		}

		#~
		Prices a number of tokens
		@param input_tokens tokens read
		@param output_tokens tokens written
		@return cost in the price table's currency
		~#
		method : public : Cost(input_tokens : Int, output_tokens : Int) ~ Float {
			return (input_tokens->As(Float) * @price_input + output_tokens->As(Float) * @price_output) / 1000000.0;
		}

		#~
		Gets the step limit
		@return limit, 0 for none
		~#
		method : public : GetMaxSteps() ~ Int {
			return @max_steps;
		}

		#~
		Gets the wall-clock limit
		@return milliseconds, 0 for none
		~#
		method : public : GetMaxWallMs() ~ Int {
			return @max_wall_ms;
		}

		#~
		Gets the model call limit
		@return limit, 0 for none
		~#
		method : public : GetMaxModelCalls() ~ Int {
			return @max_model_calls;
		}

		#~
		Gets the tool call limit
		@return limit, 0 for none
		~#
		method : public : GetMaxToolCalls() ~ Int {
			return @max_tool_calls;
		}

		#~
		Gets the token limit
		@return limit, 0 for none
		~#
		method : public : GetMaxTokens() ~ Int {
			return @max_tokens;
		}

		#~
		Gets the cost limit
		@return limit, 0.0 for none
		~#
		method : public : GetMaxCost() ~ Float {
			return @max_cost;
		}

		#~
		Gets the per-call model limit
		@return milliseconds, 0 for none
		~#
		method : public : GetModelCallMs() ~ Int {
			return @model_call_ms;
		}
	}

	#~
	One event of a run's trace: a sequence number, the milliseconds since the run began, a kind, the step
	it belongs to and the kind's own fields
	~#
	class AgentEvent {
		@seq : Int;
		@millis : Int;
		@kind : String;
		@step : Int;
		@data : JsonElement;

		#~
		Constructor
		@param seq number of the event in the run, from 1
		@param millis milliseconds since the run began
		@param kind event kind
		@param step step number, 0 outside a step
		@param data an object with the kind's fields, or Nil
		~#
		New(seq : Int, millis : Int, kind : String, step : Int, data : JsonElement) {
			@seq := seq;
			@millis := millis;
			@kind := kind;
			@step := step;
			@data := data;
			if(@data = Nil) {
				@data := AgentJs->Object();
			};
		}

		#~
		Gets the sequence number
		@return number, from 1
		~#
		method : public : GetSeq() ~ Int {
			return @seq;
		}

		#~
		Gets the time of the event
		@return milliseconds since the run began
		~#
		method : public : GetMillis() ~ Int {
			return @millis;
		}

		#~
		Gets the kind
		@return run_start, budget_check, model_start, model_end, model_retry, tool_start, tool_end, halt or run_end
		~#
		method : public : GetKind() ~ String {
			return @kind;
		}

		#~
		Gets the step
		@return step number, 0 outside a step
		~#
		method : public : GetStep() ~ Int {
			return @step;
		}

		#~
		Gets the kind's own fields
		@return an object
		~#
		method : public : GetData() ~ JsonElement {
			return @data;
		}

		#~
		Gets one field as text
		@param name field name
		@return the value as text, or Nil when the event has no such field
		~#
		method : public : Get(name : String) ~ String {
			return AgentJs->Text(@data, name);
		}

		#~
		Writes the event as one JSON object with API keys removed
		@return seq, ms, event, step and the kind's fields
		~#
		method : public : ToJson() ~ JsonElement {
			json := AgentJs->Object();
			json->Insert("seq", @seq);
			json->Insert("ms", @millis);
			json->Insert("event", @kind);
			json->Insert("step", @step);
			names := @data->GetNames();
			i := 0;
			while(i < names->Size()) {
				json->Insert(names->Get(i), @data->Get(names->Get(i)));
				i += 1;
			};
			return JsonParser->TextToElement(Redactor->Scrub(json->ToString()));
		}

		#~
		Writes the event as one line of JSON, the trace file format
		@return JSON text with no line break
		~#
		method : public : ToString() ~ String {
			return Redactor->Scrub(ToJson()->ToString());
		}
	}

	#~
	Keeps the events of a run in memory, for a test or a report
	~#
	class AgentTraceBuffer implements AgentTraceSink {
		@events : Vector<AgentEvent>;

		#~
		Constructor
		~#
		New() {
			@events := Vector->New()<AgentEvent>;
		}

		method : public : OnEvent(event : AgentEvent) ~ Nil {
			@events->AddBack(event);
		}

		#~
		Gets the events
		@return events, oldest first
		~#
		method : public : GetEvents() ~ Vector<AgentEvent> {
			return @events;
		}

		#~
		Counts the events of one kind
		@param kind event kind
		@return count
		~#
		method : public : Count(kind : String) ~ Int {
			total := 0;
			i := 0;
			while(i < @events->Size()) {
				if(@events->Get(i)->GetKind()->Equals(kind)) {
					total += 1;
				};
				i += 1;
			};
			return total;
		}

		#~
		Finds the first event of one kind
		@param kind event kind
		@return the event, or Nil
		~#
		method : public : First(kind : String) ~ AgentEvent {
			i := 0;
			while(i < @events->Size()) {
				if(@events->Get(i)->GetKind()->Equals(kind)) {
					return @events->Get(i);
				};
				i += 1;
			};
			return Nil;
		}

		#~
		Lists the kinds in order
		@return kinds separated by commas
		~#
		method : public : Kinds() ~ String {
			text := String->New();
			i := 0;
			while(i < @events->Size()) {
				if(i > 0) {
					text->Append(',');
				};
				text->Append(@events->Get(i)->GetKind());
				i += 1;
			};
			return text;
		}
	}

	# milliseconds since a run began; read by the loop thread only
	class : private : AgentClock {
		@timer : System.Time.Timer;
		@total : Float;

		New() {
			@timer := System.Time.Timer->New(true);
			@total := 0.0;
		}

		method : public : Ms() ~ Int {
			@total += @timer->GetElapsedTime();
			@timer->Start();
			return (@total * 1000.0)->As(Int);
		}
	}

	# what a worker thread hands back; a worker that was abandoned can no longer write to it
	class : private : AgentSlot {
		@mutex : ThreadMutex;
		@cond : Condition;
		@done : Bool;
		@abandoned : Bool;
		@text : String;
		@failure : String;
		@reply : AgentReply;
		New() {
			@mutex := ThreadMutex->New("agent_slot");
			@cond := Condition->New();
		}

		method : public : Complete(text : String, failure : String, reply : AgentReply) ~ Nil {
			critical(@mutex) {
				if(<>@abandoned) {
					@text := text;
					@failure := failure;
					@reply := reply;
					@done := true;
				};
				@cond->Signal();
			};
		}

		method : public : WaitDone(millis : Int) ~ Bool {
			flag := false;
			critical(@mutex) {
				if(<>@done) {
					@cond->Wait(@mutex, millis);
				};
				flag := @done;
			};
			return flag;
		}

		# true when the worker had not finished and is now cut loose
		method : public : Abandon() ~ Bool {
			flag := false;
			critical(@mutex) {
				if(<>@done) {
					@abandoned := true;
					flag := true;
				};
			};
			return flag;
		}

		method : public : GetText() ~ String {
			return @text;
		}

		method : public : GetFailure() ~ String {
			return @failure;
		}

		method : public : GetReply() ~ AgentReply {
			return @reply;
		}
	}

	# runs one tool call or model call off the loop's thread
	class : private : AgentWorker from Thread {
		@slot : AgentSlot;
		@kind : Int;
		@tool : AgentTool;
		@arguments : JsonElement;
		@cancel : AgentCancel;
		@backend : ChatBackend;
		@conversation : AgentConversation;
		@tools : Vector<AgentTool>;

		New(slot : AgentSlot) {
			Parent("agent_worker");
			@slot := slot;
		}

		method : public : ForTool(tool : AgentTool, arguments : JsonElement, cancel : AgentCancel) ~ AgentWorker {
			@kind := 0;
			@tool := tool;
			@arguments := arguments;
			@cancel := cancel;
			return @self;
		}

		method : public : ForModel(backend : ChatBackend, conversation : AgentConversation, tools : Vector<AgentTool>) ~ AgentWorker {
			@kind := 1;
			@backend := backend;
			@conversation := conversation;
			@tools := tools;
			return @self;
		}

		method : public : Run(param : System.Base) ~ Nil {
			text : String;
			failure : String;
			reply : AgentReply;
			try {
				if(@kind = 0) {
					text := @tool->InvokeWith(@arguments, @cancel);
				}
				else if(@kind = 1) {
					reply := @backend->Chat(@conversation, @tools);
					if(reply = Nil) {
						failure := @backend->GetLastError();
						if(failure = Nil) {
							failure := "the backend returned no reply";
						};
					};
				};
			}
			on(e : Error) {
				failure := e->GetMessage();
				if(failure = Nil) {
					failure := "the worker failed";
				};
			};
			@slot->Complete(text, failure, reply);
		}
	}

	#~
	The loop. Run sends the prompt, runs the tool calls the model asks for and sends the results back,
	until the model answers without a tool call, the step limit is reached or the backend fails. The
	conversation is kept, so Run can be called again to carry on; Reset starts over.

	Every call goes through the same gates, in order: the tool must exist (unknown otherwise), the
	registry's allow and deny lists must permit it (denied), the arguments must satisfy the tool's schema
	(invalid), a dangerous tool, a tool whose destructive hint is true, any tool when SetApproveAll is on, and
	any tool not known to be read-only when SetApproveUnlessReadOnly is on, must be approved (refused), and the
	handler runs with its errors caught (error) and its time measured (timeout). Whatever goes wrong becomes
	an error result the model can read and the loop carries on.

```
registry := ToolRegistry->New();
registry->Add(AgentTools->Calculator());
agent := Agent->New(AnthropicBackend->New("claude-sonnet-5-5", Nil), registry);
result := agent->Run("What is 17 * 23?");
result->GetText()->PrintLine();
```
	~#
	class Agent {
		@backend : ChatBackend;
		@registry : ToolRegistry;
		@conversation : AgentConversation;
		@max_steps : Int;
		@tool_timeout_ms : Int;
		@max_result_chars : Int;
		@approver : AgentApprover;
		@approve_all : Bool;
		@approve_unless_read_only : Bool;
		@observer : AgentObserver;
		@cancel : AgentCancel;
		@budget : AgentBudget;
		@tool_mode : AgentTool->Mode;
		@bounded_model : Bool;
		@retries : Int;
		@retry_delay_ms : Int;
		@trace : AgentTraceSink;
		@clock : AgentClock;
		@token : AgentCancel;
		@halt : String;
		@model_calls : Int;
		@tool_calls : Int;
		@tokens_used : Int;
		@cost_used : Float;
		@event_seq : Int;
		@tracing : Bool;
		@last_error : String;

		#~
		Constructor
		@param backend the model
		@param registry the tools
		~#
		New(backend : ChatBackend, registry : ToolRegistry) {
			@backend := backend;
			@registry := registry;
			if(@registry = Nil) {
				@registry := ToolRegistry->New();
			};
			@conversation := AgentConversation->New();
			@max_steps := 10;
			@tool_timeout_ms := 0;
			@max_result_chars := 20000;
			@approve_all := false;
			@tool_mode := AgentTool->Mode->IN_THREAD;
		}

		#~
		Sets the system prompt
		@param system prompt
		@return self for chaining
		~#
		method : public : SetSystem(system : String) ~ Agent {
			@conversation->SetSystem(system);
			return @self;
		}

		#~
		Sets the most model calls one Run may make (default 10)
		@param max_steps limit, at least 1
		@return self for chaining
		~#
		method : public : SetMaxSteps(max_steps : Int) ~ Agent {
			@max_steps := max_steps;
			if(@max_steps < 1) {
				@max_steps := 1;
			};
			return @self;
		}

		#~
		Sets the longest a tool may take, in milliseconds; a tool's own limit wins. 0, the default, means no limit.
		A running handler cannot be interrupted, so a call that overruns is reported as a timeout and its result is dropped.
		@param timeout_ms limit
		@return self for chaining
		~#
		method : public : SetToolTimeout(timeout_ms : Int) ~ Agent {
			@tool_timeout_ms := timeout_ms;
			return @self;
		}

		#~
		Sets the longest tool result sent to the model, in characters (default 20000); longer results are cut
		@param max_chars limit
		@return self for chaining
		~#
		method : public : SetMaxResultChars(max_chars : Int) ~ Agent {
			@max_result_chars := max_chars;
			return @self;
		}

		#~
		Sets who approves dangerous tools. A dangerous tool is refused while there is none.
		@param approver the approver
		@return self for chaining
		~#
		method : public : SetApprover(approver : AgentApprover) ~ Agent {
			@approver := approver;
			return @self;
		}

		#~
		Asks the approver about every call, not only those to dangerous tools. Calls are refused while there is no approver.
		@param approve_all true to ask every time
		@return self for chaining
		~#
		method : public : SetApproveAll(approve_all : Bool) ~ Agent {
			@approve_all := approve_all;
			return @self;
		}

		#~
		Asks the approver about every call to a tool that is not known to be read-only: a tool with no read-only hint, or one whose hint is false, needs approval. A tool marked read-only runs without being asked. The safe default for tools from a server you do not control, since a missing hint says nothing
		@param on true to ask about everything but read-only tools
		@return self for chaining
		~#
		method : public : SetApproveUnlessReadOnly(on : Bool) ~ Agent {
			@approve_unless_read_only := on;
			return @self;
		}

		#~
		Sets who hears about steps as they happen
		@param observer the observer
		@return self for chaining
		~#
		method : public : SetObserver(observer : AgentObserver) ~ Agent {
			@observer := observer;
			return @self;
		}

		#~
		Gets the conversation so far
		@return conversation
		~#
		method : public : GetConversation() ~ AgentConversation {
			return @conversation;
		}

		#~
		Forgets the conversation; the system prompt stays
		~#
		method : public : Reset() ~ Nil {
			@conversation->Clear();
		}

		#~
		Sets the cancellation token every Run checks: before each step, between tool calls and while it
		waits for a model call or a tool in a worker thread
		@param cancel the token, or Nil for none
		@return self for chaining
		~#
		method : public : SetCancel(cancel : AgentCancel) ~ Agent {
			@cancel := cancel;
			return @self;
		}

		#~
		Gets the cancellation token
		@return the token, or Nil
		~#
		method : public : GetCancel() ~ AgentCancel {
			return @cancel;
		}

		#~
		Sets the limits of each Run: steps, wall-clock time, model calls, tool calls, tokens and cost
		@param budget the budget, or Nil for none
		@return self for chaining
		~#
		method : public : SetBudget(budget : AgentBudget) ~ Agent {
			@budget := budget;
			return @self;
		}

		#~
		Gets the budget
		@return the budget, or Nil
		~#
		method : public : GetBudget() ~ AgentBudget {
			return @budget;
		}

		#~
		Sets how tools run unless a tool sets its own mode (default IN_THREAD, as before)
		@param mode IN_THREAD or BOUNDED_THREAD
		@return self for chaining
		~#
		method : public : SetToolMode(mode : AgentTool->Mode) ~ Agent {
			@tool_mode := mode;
			return @self;
		}

		#~
		Runs every model call on a worker thread, so the loop can return at a cancellation or the run's
		deadline even when the backend cannot be interrupted (the call is then abandoned, with the leak
		BOUNDED_THREAD describes, and its late reply is dropped). A backend that is deadline aware does not
		need it. Default off.
		@param bounded true to run model calls on a worker thread
		@return self for chaining
		~#
		method : public : SetBoundedModelCalls(bounded : Bool) ~ Agent {
			@bounded_model := bounded;
			return @self;
		}

		#~
		Sets how many times a failed model call is tried again before the run ends with an error (default 0)
		@param retries extra tries
		@param delay_ms wait before each try, in milliseconds; a cancellation cuts the wait short
		@return self for chaining
		~#
		method : public : SetModelRetries(retries : Int, delay_ms : Int) ~ Agent {
			@retries := retries;
			@retry_delay_ms := delay_ms;
			return @self;
		}

		#~
		Sets who receives the trace events of a run
		@param sink the receiver, for example an AgentTraceBuffer; Nil for none
		@return self for chaining
		~#
		method : public : SetTrace(sink : AgentTraceSink) ~ Agent {
			@trace := sink;
			return @self;
		}

		#~
		Runs the loop for one user message. Before every step and between tool calls it checks the
		cancellation token and the budget; the run then ends with a stop reason (see AgentResult) and the
		conversation stays valid, because the calls that did not run are answered as skipped.
		@param prompt what the user asks
		@return the transcript; check IsCompleted() before trusting GetText()
		~#
		method : public : Run(prompt : String) ~ AgentResult {
			result := AgentResult->New();
			@conversation->AddUser(prompt);

			@clock := AgentClock->New();
			@token := AgentCancel->New(@cancel);
			@halt := Nil;
			@model_calls := 0;
			@tool_calls := 0;
			@tokens_used := 0;
			@cost_used := 0.0;
			@event_seq := 0;
			@tracing := @trace <> Nil | (@observer <> Nil & @observer->TypeOf(AgentTraceSink));
			if(@tracing) {
				data := AgentJs->Object();
				data->Insert("backend", @backend->GetName());
				data->Insert("max_steps", @max_steps);
				data->Insert("tool_mode", ModeName(@tool_mode));
				Emit("run_start", 0, data);
			};

			tools := @registry->GetPermitted();
			step_number := 0;
			running := true;
			while(running) {
				stop := BeforeModel(step_number);
				if(stop <> Nil) {
					Stop(result, stop);
					running := false;
				}
				else if(step_number >= @max_steps) {
					result->Finish("", "max_steps", "the model was still asking for tools after {$@max_steps} steps");
					running := false;
				}
				else {
					reply := ModelCall(tools, step_number + 1);
					if(reply = Nil) {
						if(@halt <> Nil) {
							Stop(result, @halt);
						}
						else {
							message := @last_error;
							if(message = Nil) {
								message := "the backend returned no reply";
							};
							result->Finish("", "error", message);
						};
						running := false;
					}
					else {
						step_number += 1;
						@tokens_used += reply->GetInputTokens() + reply->GetOutputTokens();
						if(@budget <> Nil) {
							@cost_used += @budget->Cost(reply->GetInputTokens(), reply->GetOutputTokens());
						};

						@conversation->AddAssistant(reply, @backend->GetName());
						step := AgentStep->New(step_number, reply);
						result->AddStep(step);
						if(@observer <> Nil) {
							@observer->OnReply(step_number, reply);
						};

						if(reply->HasToolCalls()) {
							last_step := step_number >= @max_steps;
							over := OverBudget();
							if(over <> Nil & @halt = Nil) {
								@halt := over;
								EmitHalt(over, step_number);
							};

							AnswerCalls(step, reply, last_step);
							if(@halt <> Nil) {
								Stop(result, @halt);
								running := false;
							}
							else if(last_step) {
								result->Finish("", "max_steps", "the model was still asking for tools after {$@max_steps} steps");
								running := false;
							};
						}
						else {
							result->Finish(reply->GetText(), "completed", Nil);
							if(reply->GetStopReason() <> Nil & reply->GetStopReason()->Equals("length")) {
								result->Finish(reply->GetText(), "error", "the reply was cut off at the model's token limit");
							}
							else if(reply->GetStopReason() <> Nil & reply->GetStopReason()->Equals("filtered")) {
								result->Finish(reply->GetText(), "error", "the reply was blocked by the provider's content filter");
							};
							running := false;
						};
					};
				};
			};

			elapsed := @clock->Ms();
			result->SetStats(@model_calls, elapsed, @cost_used);
			if(@tracing) {
				data := AgentJs->Object();
				data->Insert("stop_reason", result->GetStopReason());
				data->Insert("steps", result->GetSteps()->Size());
				data->Insert("model_calls", @model_calls);
				data->Insert("tool_calls", @tool_calls);
				data->Insert("tokens", @tokens_used);
				data->Insert("cost", @cost_used);
				data->Insert("elapsed_ms", elapsed);
				Emit("run_end", step_number, data);
			};
			return result;
		}

		# ends the result with a stop reason and a sentence for it
		method : Stop(result : AgentResult, reason : String) ~ Nil {
			message := reason;
			if(reason->Equals("cancelled")) {
				message := "the run was cancelled";
				why := @token->GetReason();
				if(why <> Nil & <>why->Equals("cancelled")) {
					message->Append(": ");
					message->Append(why);
				};
			}
			else if(reason->Equals("deadline")) {
				limit := @budget->GetMaxWallMs();
				message := "the run passed its {$limit} ms deadline";
			}
			else if(reason->Equals("budget_steps")) {
				limit := @budget->GetMaxSteps();
				message := "the step budget of {$limit} was used up";
			}
			else if(reason->Equals("budget_model_calls")) {
				limit := @budget->GetMaxModelCalls();
				message := "the budget of {$limit} model calls was used up";
			}
			else if(reason->Equals("budget_tool_calls")) {
				limit := @budget->GetMaxToolCalls();
				message := "the budget of {$limit} tool calls was used up";
			}
			else if(reason->Equals("budget_tokens")) {
				limit := @budget->GetMaxTokens();
				message := "the token budget of {$limit} was used up ({$@tokens_used} used)";
			}
			else if(reason->Equals("budget_cost")) {
				limit := @budget->GetMaxCost();
				message := "the cost budget of {$limit} was used up ({$@cost_used} spent)";
			};
			result->Halt(reason, message);
		}

		method : ModeName(mode : AgentTool->Mode) ~ String {
			if(mode = AgentTool->Mode->BOUNDED_THREAD) {
				return "bounded_thread";
			};
			return "in_thread";
		}

		# cancelled or deadline when the run must stop now, else Nil; the first answer is kept
		method : Checkpoint() ~ String {
			if(@halt <> Nil) {
				return @halt;
			};

			reason : String;
			if(@budget <> Nil & @budget->GetMaxWallMs() > 0 & @clock->Ms() >= @budget->GetMaxWallMs()) {
				reason := "deadline";
				@token->Cancel("deadline");
			}
			else if(@token->IsCancelled()) {
				reason := "cancelled";
			};

			if(reason <> Nil) {
				@halt := reason;
				EmitHalt(reason, 0);
			};
			return reason;
		}

		# the budget limits that decide, before a model call, that the run is over
		method : BeforeModel(step_number : Int) ~ String {
			reason := Checkpoint();
			if(reason = Nil & @budget <> Nil) {
				if(@budget->GetMaxSteps() > 0 & step_number >= @budget->GetMaxSteps()) {
					reason := "budget_steps";
				}
				else if(@budget->GetMaxModelCalls() > 0 & @model_calls >= @budget->GetMaxModelCalls()) {
					reason := "budget_model_calls";
				}
				else {
					reason := OverBudget();
				};

				if(@tracing) {
					data := AgentJs->Object();
					data->Insert("steps", step_number);
					data->Insert("model_calls", @model_calls);
					data->Insert("tool_calls", @tool_calls);
					data->Insert("tokens", @tokens_used);
					data->Insert("cost", @cost_used);
					data->Insert("elapsed_ms", @clock->Ms());
					word := "none";
					if(reason <> Nil) {
						word := reason;
					};
					data->Insert("exhausted", word);
					Emit("budget_check", step_number, data);
				};

				if(reason <> Nil) {
					@halt := reason;
				};
			};
			return reason;
		}

		# tokens and cost, which are known only after a reply
		method : OverBudget() ~ String {
			if(@budget = Nil) {
				return Nil;
			};

			if(@budget->GetMaxTokens() > 0 & @tokens_used >= @budget->GetMaxTokens()) {
				return "budget_tokens";
			};

			if(@budget->GetMaxCost() > 0.0 & @cost_used >= @budget->GetMaxCost()) {
				return "budget_cost";
			};
			return Nil;
		}

		# milliseconds a model call may take, 0 for no limit
		method : CallLimit() ~ Int {
			limit := 0;
			if(@budget <> Nil) {
				limit := @budget->GetModelCallMs();
				if(@budget->GetMaxWallMs() > 0) {
					left := @budget->GetMaxWallMs() - @clock->Ms();
					if(left < 1) {
						left := 1;
					};
					if(limit <= 0 | left < limit) {
						limit := left;
					};
				};
			};
			return limit;
		}

		# one model call, with retries; Nil when the run was halted (@halt) or the backend failed (@last_error)
		method : ModelCall(tools : Vector<AgentTool>, step_number : Int) ~ AgentReply {
			reply : AgentReply;
			attempt := 0;
			finished := false;
			@last_error := Nil;
			while(<>finished) {
				@model_calls += 1;
				limit := CallLimit();
				started := @clock->Ms();
				if(@tracing) {
					data := AgentJs->Object();
					data->Insert("attempt", attempt + 1);
					data->Insert("limit_ms", limit);
					data->Insert("bounded", @bounded_model);
					Emit("model_start", step_number, data);
				};

				reply := Nil;
				@last_error := Nil;
				if(@backend->TypeOf(AgentDeadlineAware)) {
					@backend->As(AgentDeadlineAware)->SetDeadlineMs(limit);
				};

				if(@bounded_model) {
					slot := AgentSlot->New();
					worker := AgentWorker->New(slot)->ForModel(@backend, Snapshot(), tools);
					worker->Execute(Nil);
					how := Await(slot, limit);
					if(how->Equals("done")) {
						reply := slot->GetReply();
						@last_error := slot->GetFailure();
					}
					else if(how->Equals("timeout")) {
						@last_error := "the model call took longer than {$limit} ms and was abandoned";
					};
				}
				else {
					reply := @backend->Chat(@conversation, tools);
					if(reply = Nil) {
						@last_error := @backend->GetLastError();
					};
				};

				if(reply <> Nil) {
					finished := true;
				}
				else {
					if(@last_error = Nil) {
						@last_error := "the backend returned no reply";
					};

					NearDeadline();
					if(Checkpoint() <> Nil) {
						finished := true;
					}
					else if(attempt < @retries) {
						if(@budget <> Nil & @budget->GetMaxModelCalls() > 0 & @model_calls >= @budget->GetMaxModelCalls()) {
							@halt := "budget_model_calls";
							EmitHalt(@halt, step_number);
							finished := true;
						}
						else {
							attempt += 1;
						};
					}
					else {
						finished := true;
					};
				};

				if(@tracing) {
					data := AgentJs->Object();
					data->Insert("ok", reply <> Nil);
					data->Insert("ms", @clock->Ms() - started);
					if(reply <> Nil) {
						data->Insert("input_tokens", reply->GetInputTokens());
						data->Insert("output_tokens", reply->GetOutputTokens());
						data->Insert("tool_calls", reply->GetToolCalls()->Size());
					}
					else {
						data->Insert("error", Redactor->Scrub(@last_error));
					};
					Emit("model_end", step_number, data);

					if(reply = Nil & <>finished) {
						retry := AgentJs->Object();
						retry->Insert("attempt", attempt + 1);
						retry->Insert("after_error", Redactor->Scrub(@last_error));
						Emit("model_retry", step_number, retry);
					};
				};

				if(reply = Nil & <>finished) {
					Pause(@retry_delay_ms);
					if(Checkpoint() <> Nil) {
						finished := true;
					};
				};
			};
			return reply;
		}

		# a deadline-aware backend gives up a moment before the loop's own clock says the deadline passed
		method : NearDeadline() ~ Nil {
			if(@halt = Nil & @budget <> Nil & @budget->GetMaxWallMs() > 0 & @clock->Ms() + 25 >= @budget->GetMaxWallMs()) {
				@halt := "deadline";
				@token->Cancel("deadline");
				EmitHalt("deadline", 0);
			};
		}

		# sleeps in short slices, so a cancellation or the deadline cuts it short
		method : Pause(millis : Int) ~ Nil {
			waited := 0;
			while(waited < millis & Checkpoint() = Nil) {
				System.Concurrency.Thread->Sleep(10);
				waited += 10;
			};
		}

		# a copy of the conversation for a worker that may outlive the call
		method : Snapshot() ~ AgentConversation {
			copy := AgentConversation->New();
			copy->SetSystem(@conversation->GetSystem());
			entries := @conversation->GetEntries();
			i := 0;
			while(i < entries->Size()) {
				copy->GetEntries()->AddBack(entries->Get(i));
				i += 1;
			};
			return copy;
		}

		# waits for a worker: done, timeout (over limit), cancelled or deadline. A worker still running when
		# the wait ends is abandoned 
		method : Await(slot : AgentSlot, limit : Int) ~ String {
			start := @clock->Ms();
			how := "";
			while(how->Size() = 0) {
				slice := 10;
				if(limit > 0) {
					left := limit - (@clock->Ms() - start);
					if(left < slice) {
						slice := left;
					};
				};

				if(slice < 1) {
					slice := 1;
				};

				if(slot->WaitDone(slice)) {
					how := "done";
				}
				else {
					reason := Checkpoint();
					if(reason <> Nil) {
						how := reason;
					}
					else if(limit > 0 & @clock->Ms() - start >= limit) {
						how := "timeout";
					};
				};
			};

			if(<>how->Equals("done")) {
				# a worker that finished in the meantime is dropped too: the wait already ended
				slot->Abandon();
			};
			return how;
		}

		method : Emit(kind : String, step : Int, data : JsonElement) ~ Nil {
			@event_seq += 1;
			event := AgentEvent->New(@event_seq, @clock->Ms(), kind, step, data);
			if(@trace <> Nil) {
				@trace->OnEvent(event);
			};

			if(@observer <> Nil & @observer->TypeOf(AgentTraceSink)) {
				@observer->As(AgentTraceSink)->OnEvent(event);
			};
		}

		method : EmitHalt(reason : String, step : Int) ~ Nil {
			if(@tracing) {
				data := AgentJs->Object();
				data->Insert("reason", reason);
				Emit("halt", step, data);
			};
		}

		# answers every call of a reply; calls that are not run (past the last step, or after the run was
		# halted) are still answered so the conversation stays valid
		method : AnswerCalls(step : AgentStep, reply : AgentReply, skip : Bool) ~ Nil {
			calls := reply->GetToolCalls();
			i := 0;
			while(i < calls->Size()) {
				call := calls->Get(i);
				if(<>skip & @halt = Nil) {
					Checkpoint();
					if(@halt = Nil & @budget <> Nil & @budget->GetMaxToolCalls() > 0 & @tool_calls >= @budget->GetMaxToolCalls()) {
						@halt := "budget_tool_calls";
						EmitHalt(@halt, step->GetIndex());
					};
				};

				outcome : AgentToolResult;
				if(skip) {
					outcome := AgentToolResult->New(call->GetId(), call->GetName(), ArgumentText(call), "Error: the step limit was reached, so this call was not run", "skipped", 0);
				}
				else if(@halt <> Nil) {
					reason := @halt;
					outcome := AgentToolResult->New(call->GetId(), call->GetName(), ArgumentText(call), "Error: the run was stopped ({$reason}), so this call was not run", "skipped", 0);
				}
				else {
					outcome := Execute(call);
					@tool_calls += 1;
				};

				step->AddResult(outcome);
				@conversation->AddToolResult(call->GetId(), call->GetName(), outcome->GetContent(), <>outcome->IsOk());
				if(@observer <> Nil) {
					@observer->OnToolResult(step->GetIndex(), outcome);
				};
				i += 1;
			};
		}

		method : ArgumentText(call : AgentToolCall) ~ String {
			if(call->GetArguments() = Nil) {
				return "null";
			};
			return call->GetArguments()->ToString();
		}

		# runs one call through the gates
		method : Execute(call : AgentToolCall) ~ AgentToolResult {
			id := call->GetId();
			name := call->GetName();
			arguments := ArgumentText(call);

			tool := @registry->Find(name);
			if(tool = Nil) {
				message := "Error: there is no tool named '{$name}'. Available tools: ";
				message->Append(AvailableNames());
				return AgentToolResult->New(id, name, arguments, message, "unknown", 0);
			};

			if(<>@registry->Permits(name)) {
				return AgentToolResult->New(id, name, arguments, "Error: the tool '{$name}' is not permitted here", "denied", 0);
			};

			problem := AgentSchema->Check(tool->GetSchema(), call->GetArguments());
			if(problem <> Nil) {
				message := "Error: invalid arguments for '{$name}': ";
				message->Append(problem);
				return AgentToolResult->New(id, name, arguments, message, "invalid", 0);
			};

			if(tool->NeedsApproval() | @approve_all | (@approve_unless_read_only & <>tool->IsReadOnly())) {
				if(@approver = Nil) {
					return AgentToolResult->New(id, name, arguments, "Error: the tool '{$name}' needs approval and none is available, so it was not run", "refused", 0);
				};

				if(<>@approver->Approve(call, tool)) {
					return AgentToolResult->New(id, name, arguments, "Error: the user declined to run '{$name}'", "refused", 0);
				};
			};

			return Invoke(tool, call, arguments);
		}

		method : AvailableNames() ~ String {
			permitted := @registry->GetPermitted();
			names := String->New();
			i := 0;
			while(i < permitted->Size()) {
				if(i > 0) {
					names->Append(", ");
				};
				names->Append(permitted->Get(i)->GetName());
				i += 1;
			};

			if(names->Size() = 0) {
				return "none";
			};
			return names;
		}

		method : Invoke(tool : AgentTool, call : AgentToolCall, arguments : String) ~ AgentToolResult {
			id := call->GetId();
			name := call->GetName();
			output : String;
			failure : String;

			limit := tool->GetTimeout();
			if(limit <= 0) {
				limit := @tool_timeout_ms;
			};

			mode := @tool_mode;
			if(tool->HasMode()) {
				mode := tool->GetMode();
			};

			if(@tracing) {
				data := AgentJs->Object();
				data->Insert("id", id);
				data->Insert("tool", name);
				data->Insert("mode", ModeName(mode));
				data->Insert("limit_ms", limit);
				data->Insert("arguments", Redactor->Scrub(arguments->Truncate(500, "...")));
				Emit("tool_start", 0, data);
			};

			how := "done";
			started := @clock->Ms();
			if(mode = AgentTool->Mode->IN_THREAD) {
				try {
					output := tool->InvokeWith(call->GetArguments(), @token);
				}
				on(e : Error) {
					failure := e->GetMessage();
					if(failure = Nil) {
						failure := "the tool failed";
					};
				};
			}
			else {
				slot := AgentSlot->New();
				worker := AgentWorker->New(slot);
				worker->ForTool(tool, call->GetArguments(), @token);
				worker->Execute(Nil);
				how := Await(slot, limit);
				if(how->Equals("done")) {
					failure := slot->GetFailure();
					output := slot->GetText();
				};
			};
			millis := @clock->Ms() - started;

			outcome := Finish(tool, id, name, arguments, output, failure, how, limit, millis);
			if(@tracing) {
				data := AgentJs->Object();
				data->Insert("id", id);
				data->Insert("tool", name);
				data->Insert("status", outcome->GetStatus());
				data->Insert("ms", millis);
				data->Insert("chars", outcome->GetContent()->Size());
				Emit("tool_end", 0, data);
			};
			return outcome;
		}

		# turns how a call ended into the result the model reads
		method : Finish(tool : AgentTool, id : String, name : String, arguments : String, output : String, failure : String, how : String, limit : Int, millis : Int) ~ AgentToolResult {
			if(how->Equals("cancelled")) {
				return AgentToolResult->New(id, name, arguments, "Error: the run was cancelled while the tool '{$name}' was running, so its result was discarded", "cancelled", millis);
			};

			if(how->Equals("deadline")) {
				return AgentToolResult->New(id, name, arguments, "Error: the run's deadline passed while the tool '{$name}' was running, so its result was discarded", "timeout", millis);
			};

			if(how->Equals("timeout")) {
				return AgentToolResult->New(id, name, arguments, "Error: the tool '{$name}' did not finish within its {$limit} ms limit and was stopped, so it has no result", "timeout", millis);
			};

			if(limit > 0 & millis > limit) {
				return AgentToolResult->New(id, name, arguments, "Error: the tool '{$name}' took {$millis} ms, over its {$limit} ms limit, so its result was discarded", "timeout", millis);
			};

			if(failure <> Nil) {
				message := "Error: the tool '{$name}' failed: ";
				message->Append(failure);
				return AgentToolResult->New(id, name, arguments, Redactor->Scrub(message), "error", millis);
			};

			if(output = Nil) {
				return AgentToolResult->New(id, name, arguments, "Error: the tool '{$name}' returned no result", "error", millis);
			};

			text := output;
			if(@max_result_chars > 0 & text->Size() > @max_result_chars) {
				text := text->Truncate(@max_result_chars, "... [truncated]");
			};
			return AgentToolResult->New(id, name, arguments, text, "ok", millis);
		}
	}

	#~
	Checks arguments against the JSON Schema of a tool. It covers the parts tool schemas use: type
	(one name or a list), properties, required, additionalProperties set to false, enum, const, minimum,
	maximum, minLength, maxLength, minItems, maxItems, items, anyOf and oneOf. Other keywords, pattern and
	format among them, are not checked.
	~#
	class AgentSchema {
		#~
		Checks a value against a schema
		@param schema the schema, an object
		@param value the value, the call's arguments for a tool
		@return Nil when the value fits, else a message naming the first problem and where it is
		~#
		function : Check(schema : JsonElement, value : JsonElement) ~ String {
			if(value = Nil) {
				return "arguments: expected a JSON object, but the arguments were not valid JSON";
			};
			return Walk(schema, value, "arguments");
		}

		function : Walk(schema : JsonElement, value : JsonElement, path : String) ~ String {
			if(<>AgentJs->IsObject(schema)) {
				return Nil;
			};

			kind := schema->Get("type");
			if(kind <> Nil) {
				if(<>TypeMatches(kind, value)) {
					actual := Describe(value);
					expected := Expected(kind);
					return "{$path}: expected {$expected}, got {$actual}";
				};
			};

			values := schema->Get("enum");
			if(AgentJs->IsArray(values)) {
				found := false;
				i := 0;
				while(i < values->Size() & <>found) {
					if(Equal(values->Get(i), value)) {
						found := true;
					};
					i += 1;
				};
				if(<>found) {
					return "{$path}: must be one of {$values->ToString()}";
				};
			};

			constant := schema->Get("const");
			if(constant <> Nil & <>Equal(constant, value)) {
				return "{$path}: must be {$constant->ToString()}";
			};

			problem := Combined(schema, value, path);
			if(problem <> Nil) {
				return problem;
			};

			type_of := value->GetType();
			if(type_of = JsonElement->JsonType->OBJECT) {
				return WalkObject(schema, value, path);
			};

			if(type_of = JsonElement->JsonType->ARRAY) {
				return WalkArray(schema, value, path);
			};

			if(type_of = JsonElement->JsonType->STRING) {
				return WalkString(schema, value, path);
			};

			if(type_of = JsonElement->JsonType->NUMBER) {
				return WalkNumber(schema, value, path);
			};

			return Nil;
		}

		# anyOf and oneOf: at least one option must fit
		function : Combined(schema : JsonElement, value : JsonElement, path : String) ~ String {
			names := Vector->New()<String>;
			names->AddBack("anyOf");
			names->AddBack("oneOf");
			n := 0;
			while(n < names->Size()) {
				options := schema->Get(names->Get(n));
				if(AgentJs->IsArray(options) & options->Size() > 0) {
					fits := false;
					i := 0;
					while(i < options->Size() & <>fits) {
						if(Walk(options->Get(i), value, path) = Nil) {
							fits := true;
						};
						i += 1;
					};
					if(<>fits) {
						return "{$path}: does not match any of the allowed shapes";
					};
				};
				n += 1;
			};
			return Nil;
		}

		function : WalkObject(schema : JsonElement, value : JsonElement, path : String) ~ String {
			required := schema->Get("required");
			if(AgentJs->IsArray(required)) {
				i := 0;
				while(i < required->Size()) {
					name := AgentJs->Text(required->Get(i));
					if(name <> Nil & <>value->Has(name)) {
						return "{$path}: missing required property '{$name}'";
					};
					i += 1;
				};
			};

			properties := schema->Get("properties");
			names := value->GetNames();
			j := 0;
			while(j < names->Size()) {
				key := names->Get(j);
				sub_path := "{$path}.{$key}";
				if(AgentJs->IsObject(properties) & properties->Has(key)) {
					problem := Walk(properties->Get(key), value->Get(key), sub_path);
					if(problem <> Nil) {
						return problem;
					};
				}
				else {
					extra := schema->Get("additionalProperties");
					if(extra <> Nil & extra->GetType() = JsonElement->JsonType->FALSE) {
						return "{$path}: unexpected property '{$key}'";
					};
					if(AgentJs->IsObject(extra)) {
						problem := Walk(extra, value->Get(key), sub_path);
						if(problem <> Nil) {
							return problem;
						};
					};
				};
				j += 1;
			};
			return Nil;
		}

		function : WalkArray(schema : JsonElement, value : JsonElement, path : String) ~ String {
			size := value->Size();
			low := schema->Get("minItems");
			if(low <> Nil & low->GetType() = JsonElement->JsonType->NUMBER & size < low->GetInt()) {
				return "{$path}: needs at least {$low->GetInt()} items, has {$size}";
			};

			high := schema->Get("maxItems");
			if(high <> Nil & high->GetType() = JsonElement->JsonType->NUMBER & size > high->GetInt()) {
				return "{$path}: allows at most {$high->GetInt()} items, has {$size}";
			};

			items := schema->Get("items");
			if(AgentJs->IsObject(items)) {
				i := 0;
				while(i < size) {
					problem := Walk(items, value->Get(i), "{$path}[{$i}]");
					if(problem <> Nil) {
						return problem;
					};
					i += 1;
				};
			};
			return Nil;
		}

		function : WalkString(schema : JsonElement, value : JsonElement, path : String) ~ String {
			size := value->GetString()->Size();
			low := schema->Get("minLength");
			if(low <> Nil & low->GetType() = JsonElement->JsonType->NUMBER & size < low->GetInt()) {
				return "{$path}: must be at least {$low->GetInt()} characters, has {$size}";
			};

			high := schema->Get("maxLength");
			if(high <> Nil & high->GetType() = JsonElement->JsonType->NUMBER & size > high->GetInt()) {
				return "{$path}: must be at most {$high->GetInt()} characters, has {$size}";
			};
			return Nil;
		}

		function : WalkNumber(schema : JsonElement, value : JsonElement, path : String) ~ String {
			number := value->GetFloat();
			low := schema->Get("minimum");
			if(low <> Nil & low->GetType() = JsonElement->JsonType->NUMBER & number < low->GetFloat()) {
				return "{$path}: must be at least {$low->GetValue()}";
			};

			high := schema->Get("maximum");
			if(high <> Nil & high->GetType() = JsonElement->JsonType->NUMBER & number > high->GetFloat()) {
				return "{$path}: must be at most {$high->GetValue()}";
			};
			return Nil;
		}

		# a type name, or a list of them
		function : TypeMatches(kind : JsonElement, value : JsonElement) ~ Bool {
			if(kind->GetType() = JsonElement->JsonType->STRING) {
				return IsType(kind->GetString(), value);
			};

			if(AgentJs->IsArray(kind)) {
				i := 0;
				while(i < kind->Size()) {
					name := AgentJs->Text(kind->Get(i));
					if(name <> Nil & IsType(name, value)) {
						return true;
					};
					i += 1;
				};
				return false;
			};
			return true;
		}

		function : IsType(name : String, value : JsonElement) ~ Bool {
			type_of := value->GetType();
			if(name->Equals("object")) {
				return type_of = JsonElement->JsonType->OBJECT;
			};
			if(name->Equals("array")) {
				return type_of = JsonElement->JsonType->ARRAY;
			};
			if(name->Equals("string")) {
				return type_of = JsonElement->JsonType->STRING;
			};
			if(name->Equals("boolean")) {
				return type_of = JsonElement->JsonType->TRUE | type_of = JsonElement->JsonType->FALSE;
			};
			if(name->Equals("null")) {
				return type_of = JsonElement->JsonType->NULL;
			};
			if(name->Equals("number")) {
				return type_of = JsonElement->JsonType->NUMBER;
			};
			if(name->Equals("integer")) {
				if(type_of <> JsonElement->JsonType->NUMBER) {
					return false;
				};
				return IsWhole(value->GetValue());
			};
			return true;
		}

		# 3, 3.0 and 3e2 are whole numbers; 3.5 is not
		function : IsWhole(text : String) ~ Bool {
			if(text = Nil) {
				return false;
			};

			if(text->Has('e') | text->Has('E')) {
				return true;
			};

			dot := text->Find('.');
			if(dot < 0) {
				return true;
			};

			i := dot + 1;
			while(i < text->Size()) {
				if(text->Get(i) <> '0') {
					return false;
				};
				i += 1;
			};
			return true;
		}

		function : Expected(kind : JsonElement) ~ String {
			if(kind->GetType() = JsonElement->JsonType->STRING) {
				return kind->GetString();
			};
			return kind->ToString();
		}

		function : Describe(value : JsonElement) ~ String {
			type_of := value->GetType();
			if(type_of = JsonElement->JsonType->OBJECT) {
				return "object";
			};
			if(type_of = JsonElement->JsonType->ARRAY) {
				return "array";
			};
			if(type_of = JsonElement->JsonType->STRING) {
				return "string";
			};
			if(type_of = JsonElement->JsonType->NUMBER) {
				return "number";
			};
			if(type_of = JsonElement->JsonType->NULL) {
				return "null";
			};
			return "boolean";
		}

		function : Equal(a : JsonElement, b : JsonElement) ~ Bool {
			if(a = Nil | b = Nil) {
				return false;
			};

			if(a->GetType() = JsonElement->JsonType->NUMBER & b->GetType() = JsonElement->JsonType->NUMBER) {
				return a->GetFloat() = b->GetFloat();
			};
			return a->ToString()->Equals(b->ToString());
		}
	}

	#~
	Removes API keys from text before it is logged, shown or kept in an error. Keys are found by value
	(every key a backend has used is registered) and by shape (sk-..., AIza..., and the token after Bearer).
	~#
	class Redactor {
		@secrets : static : Vector<String>;

		#~
		Registers a secret so it is masked wherever it appears
		@param secret the key; values under 8 characters are ignored
		~#
		function : Add(secret : String) ~ Nil {
			if(secret = Nil | secret->Size() < 8) {
				return;
			};

			if(@secrets = Nil) {
				@secrets := Vector->New()<String>;
			};

			i := 0;
			while(i < @secrets->Size()) {
				if(@secrets->Get(i)->Equals(secret)) {
					return;
				};
				i += 1;
			};
			@secrets->AddBack(secret);
		}

		#~
		Masks keys in a text
		@param text any text
		@return the text with every registered key and every key-shaped token replaced by [REDACTED]
		~#
		function : Scrub(text : String) ~ String {
			if(text = Nil) {
				return Nil;
			};

			result := text;
			if(@secrets <> Nil) {
				i := 0;
				while(i < @secrets->Size()) {
					result := result->ReplaceAll(@secrets->Get(i), "[REDACTED]");
					i += 1;
				};
			};

			result := ScrubPrefix(result, "sk-", 16);
			result := ScrubPrefix(result, "AIza", 16);
			result := ScrubPrefix(result, "Bearer ", 8);
			return result;
		}

		# replaces prefix plus the token characters after it when the token is long enough to be a key
		function : ScrubPrefix(text : String, prefix : String, min_size : Int) ~ String {
			if(<>text->Has(prefix)) {
				return text;
			};

			out := String->New();
			pos := 0;
			searching := true;
			while(searching) {
				at := text->Find(pos, prefix);
				if(at < 0) {
					out->Append(text->SubString(pos, text->Size() - pos));
					searching := false;
				}
				else {
					start := at + prefix->Size();
					end := start;
					while(end < text->Size() & KeyChar(text->Get(end))) {
						end += 1;
					};

					out->Append(text->SubString(pos, at - pos));
					starts_word := at = 0 | <>KeyChar(text->Get(at - 1));
					if(starts_word & end - start >= min_size) {
						out->Append("[REDACTED]");
					}
					else {
						out->Append(text->SubString(at, end - at));
					};
					pos := end;
					if(pos >= text->Size()) {
						searching := false;
					};
				};
			};
			return out;
		}

		function : KeyChar(c : Char) ~ Bool {
			return (c >= 'a' & c <= 'z') | (c >= 'A' & c <= 'Z') | (c >= '0' & c <= '9') | c = '_' | c = '-' | c = '.';
		}
	}

	# JSON helpers
	class : private : AgentJs {
		function : Object() ~ JsonElement {
			return JsonElement->New(JsonElement->JsonType->OBJECT);
		}

		function : Array() ~ JsonElement {
			return JsonElement->New(JsonElement->JsonType->ARRAY);
		}

		function : IsObject(elem : JsonElement) ~ Bool {
			return elem <> Nil & elem->GetType() = JsonElement->JsonType->OBJECT;
		}

		function : IsArray(elem : JsonElement) ~ Bool {
			return elem <> Nil & elem->GetType() = JsonElement->JsonType->ARRAY;
		}

		function : Same(a : String, b : String) ~ Bool {
			return a <> Nil & b <> Nil & a->Equals(b);
		}

		# decoded string value, or Nil when absent or null
		function : Text(elem : JsonElement) ~ String {
			if(elem = Nil | elem->IsNull()) {
				return Nil;
			};

			if(elem->GetType() = JsonElement->JsonType->STRING) {
				return elem->GetString();
			};
			return elem->ToString();
		}

		function : Text(json : JsonElement, name : String) ~ String {
			if(<>IsObject(json)) {
				return Nil;
			};
			return Text(json->Get(name));
		}

		function : Child(json : JsonElement, name : String) ~ JsonElement {
			if(<>IsObject(json)) {
				return Nil;
			};
			return json->Get(name);
		}

		function : IntOf(json : JsonElement, name : String) ~ Int {
			elem := Child(json, name);
			if(elem = Nil | elem->GetType() <> JsonElement->JsonType->NUMBER) {
				return 0;
			};
			return elem->GetInt();
		}

		# a parsed JSON object, or Nil when the text is not one; empty text is the empty object
		function : Arguments(text : String) ~ JsonElement {
			if(text = Nil | text->Trim()->Size() = 0) {
				return Object();
			};

			json := JsonParser->TextToElement(text);
			if(IsObject(json)) {
				return json;
			};
			return Nil;
		}

		function : RoleText(role : String, content : String) ~ JsonElement {
			item := Object();
			item->Insert("role", role);
			item->Insert("content", content);
			return item;
		}

		# the schema with no keyword a provider's validator would reject for being unknown to it
		function : Copy(elem : JsonElement) ~ JsonElement {
			if(elem = Nil) {
				return Nil;
			};
			return JsonParser->TextToElement(elem->ToString());
		}
	}

	#~
	A fake model that replays a script: each Chat call returns the next reply in the list. It is for
	testing tools and the loop without a network or a key, and it is what the offline demo runs on.
	It remembers what it was shown, so a test can check the conversation the loop built.

```
script := Vector->New()<AgentReply>;
script->AddBack(AgentReply->Ask("c1", "calculator", "{\"expression\":\"6*7\"}"));
script->AddBack(AgentReply->Say("The answer is 42."));
backend := ScriptedBackend->New(script);
```
	~#
	class ScriptedBackend implements ChatBackend, AgentDeadlineAware {
		@script : Vector<AgentReply>;
		@used : Int;
		@asked : Int;
		@delay_ms : Int;
		@deadline_ms : Int;
		@last_error : String;
		@last_conversation : AgentConversation;
		@offered : String;

		#~
		Constructor
		@param script the replies, in the order they are given
		~#
		New(script : Vector<AgentReply>) {
			@script := script;
			if(@script = Nil) {
				@script := Vector->New()<AgentReply>;
			};
		}

		#~
		Adds a reply to the end of the script
		@param reply the reply
		@return self for chaining
		~#
		method : public : Add(reply : AgentReply) ~ ScriptedBackend {
			@script->AddBack(reply);
			return @self;
		}

		method : public : GetName() ~ String {
			return "scripted";
		}

		method : public : GetLastError() ~ String {
			return @last_error;
		}

		#~
		Gets how many replies the model has given
		@return count
		~#
		method : public : GetCallCount() ~ Int {
			return @used;
		}

		#~
		Gets how many times the model was asked, including calls that ran out of time or script
		@return count
		~#
		method : public : GetAskedCount() ~ Int {
			return @asked;
		}

		#~
		Makes every call take this long before it answers, to test cancellation and deadlines. The wait is
		in short slices, and ends early with no reply when a deadline set with SetDeadlineMs passes.
		@param millis delay in milliseconds, 0 for none
		@return self for chaining
		~#
		method : public : SetDelayMs(millis : Int) ~ ScriptedBackend {
			@delay_ms := millis;
			return @self;
		}

		method : public : SetDeadlineMs(millis : Int) ~ Nil {
			@deadline_ms := millis;
		}

		#~
		Gets the conversation as it was the last time the model was asked (the live object, so it keeps growing)
		@return conversation, or Nil before the first call
		~#
		method : public : GetLastConversation() ~ AgentConversation {
			return @last_conversation;
		}

		#~
		Gets the names of the tools offered the last time the model was asked
		@return names separated by commas, "" for none
		~#
		method : public : GetOfferedTools() ~ String {
			return @offered;
		}

		method : public : Chat(conversation : AgentConversation, tools : Vector<AgentTool>) ~ AgentReply {
			@last_error := Nil;
			@asked += 1;
			@last_conversation := conversation;
			@offered := "";
			if(tools <> Nil) {
				i := 0;
				while(i < tools->Size()) {
					if(i > 0) {
						@offered->Append(',');
					};
					@offered->Append(tools->Get(i)->GetName());
					i += 1;
				};
			};

			waited := 0;
			while(waited < @delay_ms) {
				if(@deadline_ms > 0 & waited >= @deadline_ms) {
					@last_error := "the model call passed its deadline of {$@deadline_ms} ms";
					return Nil;
				};
				System.Concurrency.Thread->Sleep(10);
				waited += 10;
			};

			if(@used >= @script->Size()) {
				@last_error := "the script has no reply number {$(@used + 1)}";
				return Nil;
			};

			reply := @script->Get(@used);
			@used += 1;
			return reply;
		}
	}

	# The outcome of a request: a parsed JSON body or an error message
	class : private : AgentOutcome {
		@json : JsonElement;
		@error : String;

		New(json : JsonElement, error : String) {
			@json := json;
			@error := error;
		}

		method : public : IsOk() ~ Bool {
			return @error = Nil;
		}

		method : public : GetJson() ~ JsonElement {
			return @json;
		}

		method : public : GetError() ~ String {
			return @error;
		}
	}

	# HTTP requests and response bodies, shared by the four provider backends
	class : private : AgentWire {
		# the message of an error body ({"error":{"message":...,"type"|"status":...}} or {"error":"..."}), or Nil
		function : ErrorText(json : JsonElement) ~ String {
			if(<>AgentJs->IsObject(json)) {
				return Nil;
			};

			error_json := json->Get("error");
			if(error_json = Nil | error_json->IsNull()) {
				return Nil;
			};

			if(error_json->GetType() = JsonElement->JsonType->STRING) {
				return error_json->GetString();
			};

			message := AgentJs->Text(error_json, "message");
			kind := AgentJs->Text(error_json, "type");
			if(kind = Nil) {
				kind := AgentJs->Text(error_json, "status");
			};

			if(message = Nil) {
				message := "the API returned an error";
			};
			if(kind <> Nil) {
				message := "{$kind}: {$message}";
			};
			return message;
		}

		# a response body read as a JSON object, or the error it carries
		function : Body(text : String) ~ AgentOutcome {
			json : JsonElement;
			if(text <> Nil & text->Size() > 0) {
				json := JsonParser->TextToElement(text);
			};

			if(<>AgentJs->IsObject(json)) {
				return AgentOutcome->New(Nil, "the response was not JSON");
			};

			message := ErrorText(json);
			if(message <> Nil) {
				return AgentOutcome->New(Nil, message);
			};
			return AgentOutcome->New(json, Nil);
		}

		# POST a JSON body; headers holds name, value, name, value, ...; plain true uses HTTP (a local Ollama)
		function : Post(url : String, headers : Vector<String>, body : JsonElement, pem : String, plain : Bool, who : String) ~ AgentOutcome {
			response : Response;
			data := body->ToString()->ToByteArray();
			if(plain) {
				response := HttpClient->QuickPost(Url->New(url), data, "application/json");
			}
			else {
				client := HttpsClient->New();
				i := 0;
				while(i + 1 < headers->Size()) {
					client->AddHeader(headers->Get(i), headers->Get(i + 1));
					i += 2;
				};
				response := client->Post(Url->New(url), data, "application/json", pem);
			};

			if(response = Nil | response->GetCode() = 0) {
				return AgentOutcome->New(Nil, "no response from {$who}");
			};

			code := response->GetCode();
			text : String;
			content := response->GetContent();
			if(content <> Nil) {
				text := content->ToString();
			};

			json : JsonElement;
			if(text <> Nil & text->Size() > 0) {
				json := JsonParser->TextToElement(text);
			};

			if(code < 200 | code > 299) {
				message := ErrorText(json);
				if(message = Nil) {
					return AgentOutcome->New(Nil, "{$who} answered HTTP {$code}");
				};
				return AgentOutcome->New(Nil, "HTTP {$code}, {$message}");
			};

			if(<>AgentJs->IsObject(json)) {
				return AgentOutcome->New(Nil, "the response was not JSON (HTTP {$code})");
			};

			message := ErrorText(json);
			if(message <> Nil) {
				return AgentOutcome->New(Nil, message);
			};
			return AgentOutcome->New(json, Nil);
		}
	}

	# API keys: where they come from, and the guard against sending one over an unchecked connection
	class : private : AgentKeys {
		# true when TLS checking is off and nothing says sending a key that way is intended
		function : InsecureTlsBlocksKey() ~ Bool {
			skip := System.Runtime->GetEnvironmentVariable("OBJECK_TLS_INSECURE_SKIP_VERIFY");
			if(skip = Nil | skip->Size() = 0) {
				return false;
			};

			mode := skip->Get(0);
			if(mode <> '1' & mode <> 't' & mode <> 'T' & mode <> 'y' & mode <> 'Y') {
				return false;
			};

			allow := System.Runtime->GetEnvironmentVariable("OBJECK_TLS_INSECURE_ALLOW_API_KEYS");
			if(allow <> Nil & allow->Size() > 0 & allow->Get(0) = '1') {
				return false;
			};
			return true;
		}

		# the key passed in, else the first environment variable that is set, else the first line of the key file; registered for redaction
		function : Find(explicit : String, env_one : String, env_two : String, file : String) ~ String {
			if(InsecureTlsBlocksKey()) {
				return Nil;
			};

			if(explicit <> Nil & explicit->Size() > 0) {
				Redactor->Add(explicit);
				return explicit;
			};

			value := FromEnvironment(env_one);
			if(value = Nil & env_two <> Nil) {
				value := FromEnvironment(env_two);
			};

			if(value = Nil) {
				text := System.IO.Filesystem.FileReader->ReadFile(file);
				if(text <> Nil) {
					value := text->Trim();
					line_end := value->Find('\n');
					if(line_end > -1) {
						value := value->SubString(line_end)->Trim();
					};
					if(value->Size() = 0) {
						value := Nil;
					};
				};
			};

			Redactor->Add(value);
			return value;
		}

		function : FromEnvironment(name : String) ~ String {
			value := System.Runtime->GetEnvironmentVariable(name);
			if(value <> Nil) {
				value := value->Trim();
				if(value->Size() > 0) {
					return value;
				};
			};
			return Nil;
		}

		function : Refusal() ~ String {
			return "refusing to use an API key: OBJECK_TLS_INSECURE_SKIP_VERIFY turns TLS certificate checking off, so the key would go to an unauthenticated server (set OBJECK_TLS_INSECURE_ALLOW_API_KEYS=1 to allow it for testing)";
		}
	}

	#~
	The Anthropic Messages API. The conversation becomes messages with content blocks: a model's tool calls
	are tool_use blocks, and the results of one reply's calls go back together in one user message as
	tool_result blocks that name the call's id. The key is the argument, else ANTHROPIC_API_KEY, else the first
	line of anthropic_api_key.dat in the working directory.
	~#
	class AnthropicBackend implements ChatBackend {
		@model : String;
		@key : String;
		@base_url : String;
		@pem : String;
		@max_tokens : Int;
		@temperature : Float;
		@has_temperature : Bool;
		@last_error : String;

		#~
		Constructor; it does not contact the server
		@param model model id, i.e. claude-sonnet-5-5
		@param key API key, or Nil to look for one
		~#
		New(model : String, key : String) {
			@model := model;
			@key := key;
			@max_tokens := 4096;
			@base_url := "https://api.anthropic.com/v1";
		}

		#~
		Sets the API base URL, for a gateway or proxy
		@param base_url URL without a trailing slash; it must be https
		@return self for chaining
		~#
		method : public : SetBaseUrl(base_url : String) ~ AnthropicBackend {
			@base_url := base_url;
			return @self;
		}

		#~
		Pins the certificate a gateway or test server presents
		@param pem PEM file used as the trust anchor, or Nil for the system store
		@return self for chaining
		~#
		method : public : SetCertificate(pem : String) ~ AnthropicBackend {
			@pem := pem;
			return @self;
		}

		#~
		Sets the most tokens a reply may use (default 4096)
		@param max_tokens limit
		@return self for chaining
		~#
		method : public : SetMaxTokens(max_tokens : Int) ~ AnthropicBackend {
			@max_tokens := max_tokens;
			return @self;
		}

		#~
		Sets the sampling temperature
		@param temperature between 0 and 1
		@return self for chaining
		~#
		method : public : SetTemperature(temperature : Float) ~ AnthropicBackend {
			@temperature := temperature;
			@has_temperature := true;
			return @self;
		}

		method : public : GetName() ~ String {
			return "anthropic";
		}

		method : public : GetLastError() ~ String {
			return @last_error;
		}

		#~
		Builds the request body for a conversation, public so it can be inspected without a server
		@param conversation the conversation
		@param tools the tools to offer, or Nil
		@return request JSON
		~#
		method : public : BuildRequest(conversation : AgentConversation, tools : Vector<AgentTool>) ~ JsonElement {
			request := AgentJs->Object();
			request->Insert("model", @model);
			request->Insert("max_tokens", @max_tokens);
			if(conversation->GetSystem() <> Nil) {
				request->Insert("system", conversation->GetSystem());
			};
			if(@has_temperature) {
				request->Insert("temperature", @temperature);
			};
			request->Insert("messages", Messages(conversation));

			if(tools <> Nil & tools->Size() > 0) {
				tools_json := AgentJs->Array();
				i := 0;
				while(i < tools->Size()) {
					tool := tools->Get(i);
					tool_json := AgentJs->Object();
					tool_json->Insert("name", tool->GetName());
					if(tool->GetDescription() <> Nil) {
						tool_json->Insert("description", tool->GetDescription());
					};
					tool_json->Insert("input_schema", tool->GetSchema());
					tools_json->Add(tool_json);
					i += 1;
				};
				request->Insert("tools", tools_json);
			};
			return request;
		}

		method : Messages(conversation : AgentConversation) ~ JsonElement {
			messages := AgentJs->Array();
			entries := conversation->GetEntries();
			i := 0;
			while(i < entries->Size()) {
				entry := entries->Get(i);
				role := entry->GetRole();
				if(role->Equals("user")) {
					messages->Add(AgentJs->RoleText("user", entry->GetText()));
					i += 1;
				}
				else if(role->Equals("assistant")) {
					message := Assistant(entry);
					if(message <> Nil) {
						messages->Add(message);
					};
					i += 1;
				}
				else {
					# the results of one reply's calls share one user message
					blocks := AgentJs->Array();
					while(i < entries->Size() & entries->Get(i)->GetRole()->Equals("tool")) {
						blocks->Add(ResultBlock(entries->Get(i)));
						i += 1;
					};
					message := AgentJs->Object();
					message->Insert("role", "user");
					message->Insert("content", blocks);
					messages->Add(message);
				};
			};
			return messages;
		}

		method : Assistant(entry : AgentEntry) ~ JsonElement {
			blocks := AgentJs->Array();
			if(entry->GetText()->Size() > 0) {
				block := AgentJs->Object();
				block->Insert("type", "text");
				block->Insert("text", entry->GetText());
				blocks->Add(block);
			};

			calls := entry->GetToolCalls();
			i := 0;
			while(i < calls->Size()) {
				call := calls->Get(i);
				call_block := AgentJs->Object();
				call_block->Insert("type", "tool_use");
				call_block->Insert("id", call->GetId());
				call_block->Insert("name", call->GetName());
				if(call->GetArguments() <> Nil) {
					call_block->Insert("input", call->GetArguments());
				}
				else {
					call_block->Insert("input", AgentJs->Object());
				};
				blocks->Add(call_block);
				i += 1;
			};

			if(blocks->Size() = 0) {
				return Nil;
			};

			message := AgentJs->Object();
			message->Insert("role", "assistant");
			message->Insert("content", blocks);
			return message;
		}

		method : ResultBlock(entry : AgentEntry) ~ JsonElement {
			block := AgentJs->Object();
			block->Insert("type", "tool_result");
			block->Insert("tool_use_id", entry->GetCallId());
			block->Insert("content", entry->GetText());
			if(entry->IsError()) {
				block->Insert("is_error", true);
			};
			return block;
		}

		#~
		Reads a response body without a server, for tests and for replaying recorded responses
		@param body response text
		@return reply, or Nil with the last error set
		~#
		method : public : ParseBody(body : String) ~ AgentReply {
			@last_error := Nil;
			outcome := AgentWire->Body(body);
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};

			json := outcome->GetJson();
			content := json->Get("content");
			if(<>AgentJs->IsArray(content)) {
				@last_error := "the response did not contain a content list";
				return Nil;
			};

			text := String->New();
			calls := Vector->New()<AgentToolCall>;
			i := 0;
			while(i < content->Size()) {
				block := content->Get(i);
				kind := AgentJs->Text(block, "type");
				if(AgentJs->Same(kind, "text")) {
					piece := AgentJs->Text(block, "text");
					if(piece <> Nil) {
						text->Append(piece);
					};
				}
				else if(AgentJs->Same(kind, "tool_use")) {
					input := AgentJs->Child(block, "input");
					if(<>AgentJs->IsObject(input)) {
						input := AgentJs->Object();
					};
					calls->AddBack(AgentToolCall->New(AgentJs->Text(block, "id"), AgentJs->Text(block, "name"), input));
				};
				i += 1;
			};

			raw := AgentJs->Text(json, "stop_reason");
			stop := "other";
			if(calls->Size() > 0 | AgentJs->Same(raw, "tool_use")) {
				stop := "tool_calls";
			}
			else if(raw = Nil | AgentJs->Same(raw, "end_turn") | AgentJs->Same(raw, "stop_sequence")) {
				stop := "end";
			}
			else if(AgentJs->Same(raw, "max_tokens")) {
				stop := "length";
			}
			else if(AgentJs->Same(raw, "refusal")) {
				stop := "filtered";
			};

			usage := AgentJs->Child(json, "usage");
			return AgentReply->New(text, calls, stop, AgentJs->IntOf(usage, "input_tokens"), AgentJs->IntOf(usage, "output_tokens"));
		}

		method : public : Chat(conversation : AgentConversation, tools : Vector<AgentTool>) ~ AgentReply {
			@last_error := Nil;
			if(AgentKeys->InsecureTlsBlocksKey()) {
				@last_error := AgentKeys->Refusal();
				return Nil;
			};

			key := AgentKeys->Find(@key, "ANTHROPIC_API_KEY", Nil, "anthropic_api_key.dat");
			if(key = Nil) {
				@last_error := "no API key: pass one, set ANTHROPIC_API_KEY, or create anthropic_api_key.dat";
				return Nil;
			};

			headers := Vector->New()<String>;
			headers->AddBack("x-api-key");
			headers->AddBack(key);
			headers->AddBack("anthropic-version");
			headers->AddBack("2023-06-01");

			outcome := AgentWire->Post("{$@base_url}/messages", headers, BuildRequest(conversation, tools), @pem, false, "the Anthropic API");
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};
			return ParseBody(outcome->GetJson()->ToString());
		}
	}

	#~
	The OpenAI Chat Completions API (POST /chat/completions), which many compatible servers also speak: set
	the base URL to use one. Tools are function tools; a model's calls arrive with string arguments that are
	parsed here, and each result goes back as a tool message that carries the call's id. The key is the
	argument, else OPENAI_API_KEY, else the first line of openai_api_key.dat in the working directory.
	~#
	class OpenAIBackend implements ChatBackend {
		@model : String;
		@key : String;
		@base_url : String;
		@pem : String;
		@max_tokens : Int;
		@temperature : Float;
		@has_temperature : Bool;
		@last_error : String;

		#~
		Constructor; it does not contact the server
		@param model model id, i.e. gpt-5
		@param key API key, or Nil to look for one
		~#
		New(model : String, key : String) {
			@model := model;
			@key := key;
			@base_url := "https://api.openai.com/v1";
		}

		#~
		Sets the API base URL, for a compatible server or gateway
		@param base_url URL without a trailing slash; it must be https
		@return self for chaining
		~#
		method : public : SetBaseUrl(base_url : String) ~ OpenAIBackend {
			@base_url := base_url;
			return @self;
		}

		#~
		Pins the certificate a gateway or test server presents
		@param pem PEM file used as the trust anchor, or Nil for the system store
		@return self for chaining
		~#
		method : public : SetCertificate(pem : String) ~ OpenAIBackend {
			@pem := pem;
			return @self;
		}

		#~
		Sets the most tokens a reply may use (sent as max_completion_tokens); unset by default
		@param max_tokens limit
		@return self for chaining
		~#
		method : public : SetMaxTokens(max_tokens : Int) ~ OpenAIBackend {
			@max_tokens := max_tokens;
			return @self;
		}

		#~
		Sets the sampling temperature; unset by default because some models only accept their own
		@param temperature value
		@return self for chaining
		~#
		method : public : SetTemperature(temperature : Float) ~ OpenAIBackend {
			@temperature := temperature;
			@has_temperature := true;
			return @self;
		}

		method : public : GetName() ~ String {
			return "openai";
		}

		method : public : GetLastError() ~ String {
			return @last_error;
		}

		#~
		Builds the request body for a conversation, public so it can be inspected without a server
		@param conversation the conversation
		@param tools the tools to offer, or Nil
		@return request JSON
		~#
		method : public : BuildRequest(conversation : AgentConversation, tools : Vector<AgentTool>) ~ JsonElement {
			request := AgentJs->Object();
			request->Insert("model", @model);
			request->Insert("messages", Messages(conversation));
			if(@max_tokens > 0) {
				request->Insert("max_completion_tokens", @max_tokens);
			};
			if(@has_temperature) {
				request->Insert("temperature", @temperature);
			};

			if(tools <> Nil & tools->Size() > 0) {
				tools_json := AgentJs->Array();
				i := 0;
				while(i < tools->Size()) {
					tool := tools->Get(i);
					function_json := AgentJs->Object();
					function_json->Insert("name", tool->GetName());
					if(tool->GetDescription() <> Nil) {
						function_json->Insert("description", tool->GetDescription());
					};
					function_json->Insert("parameters", tool->GetSchema());

					tool_json := AgentJs->Object();
					tool_json->Insert("type", "function");
					tool_json->Insert("function", function_json);
					tools_json->Add(tool_json);
					i += 1;
				};
				request->Insert("tools", tools_json);
			};
			return request;
		}

		method : Messages(conversation : AgentConversation) ~ JsonElement {
			messages := AgentJs->Array();
			if(conversation->GetSystem() <> Nil) {
				messages->Add(AgentJs->RoleText("system", conversation->GetSystem()));
			};

			entries := conversation->GetEntries();
			i := 0;
			while(i < entries->Size()) {
				entry := entries->Get(i);
				role := entry->GetRole();
				if(role->Equals("user")) {
					messages->Add(AgentJs->RoleText("user", entry->GetText()));
				}
				else if(role->Equals("assistant")) {
					messages->Add(Assistant(entry));
				}
				else {
					message := AgentJs->Object();
					message->Insert("role", "tool");
					message->Insert("tool_call_id", entry->GetCallId());
					message->Insert("content", entry->GetText());
					messages->Add(message);
				};
				i += 1;
			};
			return messages;
		}

		method : Assistant(entry : AgentEntry) ~ JsonElement {
			message := AgentJs->Object();
			message->Insert("role", "assistant");
			calls := entry->GetToolCalls();
			if(entry->GetText()->Size() > 0 | calls->Size() = 0) {
				message->Insert("content", entry->GetText());
			};

			if(calls->Size() > 0) {
				calls_json := AgentJs->Array();
				i := 0;
				while(i < calls->Size()) {
					call := calls->Get(i);
					function_json := AgentJs->Object();
					function_json->Insert("name", call->GetName());
					if(call->GetArguments() <> Nil) {
						function_json->Insert("arguments", call->GetArguments()->ToString());
					}
					else {
						function_json->Insert("arguments", "{}");
					};

					call_json := AgentJs->Object();
					call_json->Insert("id", call->GetId());
					call_json->Insert("type", "function");
					call_json->Insert("function", function_json);
					calls_json->Add(call_json);
					i += 1;
				};
				message->Insert("tool_calls", calls_json);
			};
			return message;
		}

		#~
		Reads a response body without a server, for tests and for replaying recorded responses
		@param body response text
		@return reply, or Nil with the last error set
		~#
		method : public : ParseBody(body : String) ~ AgentReply {
			@last_error := Nil;
			outcome := AgentWire->Body(body);
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};

			json := outcome->GetJson();
			choices := json->Get("choices");
			if(<>AgentJs->IsArray(choices) | choices->Size() = 0) {
				@last_error := "the response did not contain a choice";
				return Nil;
			};

			choice := choices->Get(0);
			message := AgentJs->Child(choice, "message");
			if(<>AgentJs->IsObject(message)) {
				@last_error := "the response did not contain a message";
				return Nil;
			};

			text := AgentJs->Text(message, "content");
			if(text = Nil) {
				text := "";
			};

			refusal := AgentJs->Text(message, "refusal");
			calls := Vector->New()<AgentToolCall>;
			made := AgentJs->Child(message, "tool_calls");
			if(AgentJs->IsArray(made)) {
				i := 0;
				while(i < made->Size()) {
					function_json := AgentJs->Child(made->Get(i), "function");
					calls->AddBack(AgentToolCall->New(AgentJs->Text(made->Get(i), "id"), AgentJs->Text(function_json, "name"), AgentJs->Arguments(AgentJs->Text(function_json, "arguments"))));
					i += 1;
				};
			};

			raw := AgentJs->Text(choice, "finish_reason");
			stop := "other";
			if(calls->Size() > 0) {
				stop := "tool_calls";
			}
			else if(AgentJs->Same(raw, "stop") | raw = Nil) {
				stop := "end";
			}
			else if(AgentJs->Same(raw, "length")) {
				stop := "length";
			}
			else if(AgentJs->Same(raw, "content_filter")) {
				stop := "filtered";
			};

			if(refusal <> Nil & text->Size() = 0 & calls->Size() = 0) {
				text := refusal;
				stop := "filtered";
			};

			usage := AgentJs->Child(json, "usage");
			return AgentReply->New(text, calls, stop, AgentJs->IntOf(usage, "prompt_tokens"), AgentJs->IntOf(usage, "completion_tokens"));
		}

		method : public : Chat(conversation : AgentConversation, tools : Vector<AgentTool>) ~ AgentReply {
			@last_error := Nil;
			if(AgentKeys->InsecureTlsBlocksKey()) {
				@last_error := AgentKeys->Refusal();
				return Nil;
			};

			key := AgentKeys->Find(@key, "OPENAI_API_KEY", Nil, "openai_api_key.dat");
			if(key = Nil) {
				@last_error := "no API key: pass one, set OPENAI_API_KEY, or create openai_api_key.dat";
				return Nil;
			};

			headers := Vector->New()<String>;
			headers->AddBack("Authorization");
			headers->AddBack("Bearer {$key}");

			outcome := AgentWire->Post("{$@base_url}/chat/completions", headers, BuildRequest(conversation, tools), @pem, false, "the OpenAI API");
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};
			return ParseBody(outcome->GetJson()->ToString());
		}
	}

	#~
	The Google Gemini API (generateContent). Tool calls are functionCall parts and results go back as
	functionResponse parts in one user turn. A tool schema is trimmed to the keywords Gemini's Schema knows
	(for one, additionalProperties is dropped) and a tool with no arguments is sent without parameters. The
	model's own parts are kept and sent back unchanged, which Gemini needs for its thought signatures. The
	key travels in the x-goog-api-key header, not the URL, and comes from the argument, else GOOGLE_API_KEY or
	GEMINI_API_KEY, else the first line of gemini_api_key.dat in the working directory.
	~#
	class GeminiBackend implements ChatBackend {
		@model : String;
		@key : String;
		@base_url : String;
		@pem : String;
		@max_tokens : Int;
		@temperature : Float;
		@has_temperature : Bool;
		@last_error : String;

		#~
		Constructor; it does not contact the server
		@param model model id, i.e. gemini-2.5-flash (a leading models/ is accepted)
		@param key API key, or Nil to look for one
		~#
		New(model : String, key : String) {
			@model := model;
			if(@model <> Nil & @model->StartsWith("models/")) {
				@model := @model->SubString(7, @model->Size() - 7);
			};
			@key := key;
			@base_url := "https://generativelanguage.googleapis.com/v1beta";
		}

		#~
		Sets the API base URL, for a gateway or proxy
		@param base_url URL without a trailing slash; it must be https
		@return self for chaining
		~#
		method : public : SetBaseUrl(base_url : String) ~ GeminiBackend {
			@base_url := base_url;
			return @self;
		}

		#~
		Pins the certificate a gateway or test server presents
		@param pem PEM file used as the trust anchor, or Nil for the system store
		@return self for chaining
		~#
		method : public : SetCertificate(pem : String) ~ GeminiBackend {
			@pem := pem;
			return @self;
		}

		#~
		Sets the most tokens a reply may use; unset by default
		@param max_tokens limit
		@return self for chaining
		~#
		method : public : SetMaxTokens(max_tokens : Int) ~ GeminiBackend {
			@max_tokens := max_tokens;
			return @self;
		}

		#~
		Sets the sampling temperature
		@param temperature value
		@return self for chaining
		~#
		method : public : SetTemperature(temperature : Float) ~ GeminiBackend {
			@temperature := temperature;
			@has_temperature := true;
			return @self;
		}

		method : public : GetName() ~ String {
			return "gemini";
		}

		method : public : GetLastError() ~ String {
			return @last_error;
		}

		#~
		Builds the request body for a conversation, public so it can be inspected without a server
		@param conversation the conversation
		@param tools the tools to offer, or Nil
		@return request JSON
		~#
		method : public : BuildRequest(conversation : AgentConversation, tools : Vector<AgentTool>) ~ JsonElement {
			request := AgentJs->Object();
			request->Insert("contents", Contents(conversation));
			if(conversation->GetSystem() <> Nil) {
				part := AgentJs->Object();
				part->Insert("text", conversation->GetSystem());
				parts := AgentJs->Array();
				parts->Add(part);
				system_json := AgentJs->Object();
				system_json->Insert("parts", parts);
				request->Insert("systemInstruction", system_json);
			};

			if(@max_tokens > 0 | @has_temperature) {
				config := AgentJs->Object();
				if(@max_tokens > 0) {
					config->Insert("maxOutputTokens", @max_tokens);
				};
				if(@has_temperature) {
					config->Insert("temperature", @temperature);
				};
				request->Insert("generationConfig", config);
			};

			if(tools <> Nil & tools->Size() > 0) {
				declarations := AgentJs->Array();
				i := 0;
				while(i < tools->Size()) {
					tool := tools->Get(i);
					declaration := AgentJs->Object();
					declaration->Insert("name", tool->GetName());
					if(tool->GetDescription() <> Nil) {
						declaration->Insert("description", tool->GetDescription());
					};
					if(HasProperties(tool->GetSchema())) {
						declaration->Insert("parameters", GeminiSchema->Clean(tool->GetSchema()));
					};
					declarations->Add(declaration);
					i += 1;
				};

				group := AgentJs->Object();
				group->Insert("functionDeclarations", declarations);
				tools_json := AgentJs->Array();
				tools_json->Add(group);
				request->Insert("tools", tools_json);
			};
			return request;
		}

		method : HasProperties(schema : JsonElement) ~ Bool {
			properties := AgentJs->Child(schema, "properties");
			return AgentJs->IsObject(properties) & properties->Size() > 0;
		}

		method : Contents(conversation : AgentConversation) ~ JsonElement {
			contents := AgentJs->Array();
			entries := conversation->GetEntries();
			i := 0;
			while(i < entries->Size()) {
				entry := entries->Get(i);
				role := entry->GetRole();
				if(role->Equals("user")) {
					contents->Add(Turn("user", TextPart(entry->GetText())));
					i += 1;
				}
				else if(role->Equals("assistant")) {
					model_turn := Assistant(entry);
					if(model_turn <> Nil) {
						contents->Add(model_turn);
					};
					i += 1;
				}
				else {
					# the results of one reply's calls share one user turn
					parts := AgentJs->Array();
					while(i < entries->Size() & entries->Get(i)->GetRole()->Equals("tool")) {
						parts->Add(ResponsePart(entries->Get(i)));
						i += 1;
					};
					turn := AgentJs->Object();
					turn->Insert("role", "user");
					turn->Insert("parts", parts);
					contents->Add(turn);
				};
			};
			return contents;
		}

		method : TextPart(text : String) ~ JsonElement {
			part := AgentJs->Object();
			part->Insert("text", text);
			parts := AgentJs->Array();
			parts->Add(part);
			return parts;
		}

		method : Turn(role : String, parts : JsonElement) ~ JsonElement {
			turn := AgentJs->Object();
			turn->Insert("role", role);
			turn->Insert("parts", parts);
			return turn;
		}

		method : Assistant(entry : AgentEntry) ~ JsonElement {
			# the model's own parts go back unchanged
			if(AgentJs->Same(entry->GetProvider(), "gemini") & AgentJs->IsArray(entry->GetRaw()) & entry->GetRaw()->Size() > 0) {
				return Turn("model", entry->GetRaw());
			};

			parts := AgentJs->Array();
			if(entry->GetText()->Size() > 0) {
				part := AgentJs->Object();
				part->Insert("text", entry->GetText());
				parts->Add(part);
			};

			calls := entry->GetToolCalls();
			i := 0;
			while(i < calls->Size()) {
				call := calls->Get(i);
				function_json := AgentJs->Object();
				function_json->Insert("name", call->GetName());
				if(call->GetArguments() <> Nil) {
					function_json->Insert("args", call->GetArguments());
				}
				else {
					function_json->Insert("args", AgentJs->Object());
				};

				part := AgentJs->Object();
				part->Insert("functionCall", function_json);
				parts->Add(part);
				i += 1;
			};

			if(parts->Size() = 0) {
				return Nil;
			};
			return Turn("model", parts);
		}

		method : ResponsePart(entry : AgentEntry) ~ JsonElement {
			content := AgentJs->Object();
			if(entry->IsError()) {
				content->Insert("error", entry->GetText());
			}
			else {
				content->Insert("result", entry->GetText());
			};

			function_json := AgentJs->Object();
			function_json->Insert("name", entry->GetToolName());
			# an id made up here is not Gemini's, so it is not sent
			id := entry->GetCallId();
			if(id <> Nil & <>id->StartsWith("gemini_call_")) {
				function_json->Insert("id", id);
			};
			function_json->Insert("response", content);

			part := AgentJs->Object();
			part->Insert("functionResponse", function_json);
			return part;
		}

		#~
		Reads a response body without a server, for tests and for replaying recorded responses
		@param body response text
		@return reply, or Nil with the last error set
		~#
		method : public : ParseBody(body : String) ~ AgentReply {
			@last_error := Nil;
			outcome := AgentWire->Body(body);
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};

			json := outcome->GetJson();
			candidates := json->Get("candidates");
			if(<>AgentJs->IsArray(candidates) | candidates->Size() = 0) {
				reason := AgentJs->Text(AgentJs->Child(json, "promptFeedback"), "blockReason");
				if(reason <> Nil) {
					@last_error := "the prompt was blocked: {$reason}";
				}
				else {
					@last_error := "the response did not contain a candidate";
				};
				return Nil;
			};

			candidate := candidates->Get(0);
			content := AgentJs->Child(candidate, "content");
			parts := AgentJs->Child(content, "parts");
			text := String->New();
			calls := Vector->New()<AgentToolCall>;
			if(AgentJs->IsArray(parts)) {
				i := 0;
				while(i < parts->Size()) {
					part := parts->Get(i);
					function_json := AgentJs->Child(part, "functionCall");
					if(AgentJs->IsObject(function_json)) {
						args := AgentJs->Child(function_json, "args");
						if(<>AgentJs->IsObject(args)) {
							args := AgentJs->Object();
						};
						id := AgentJs->Text(function_json, "id");
						if(id = Nil) {
							id := AgentIds->Next("gemini_call_");
						};
						calls->AddBack(AgentToolCall->New(id, AgentJs->Text(function_json, "name"), args));
					}
					else {
						# a thought summary is not part of the answer
						thought := AgentJs->Child(part, "thought");
						piece := AgentJs->Text(part, "text");
						if(piece <> Nil & (thought = Nil | thought->GetType() <> JsonElement->JsonType->TRUE)) {
							text->Append(piece);
						};
					};
					i += 1;
				};
			};

			raw := AgentJs->Text(candidate, "finishReason");
			stop := "other";
			if(calls->Size() > 0) {
				stop := "tool_calls";
			}
			else if(raw = Nil | AgentJs->Same(raw, "STOP")) {
				stop := "end";
			}
			else if(AgentJs->Same(raw, "MAX_TOKENS")) {
				stop := "length";
			}
			else if(AgentJs->Same(raw, "SAFETY") | AgentJs->Same(raw, "RECITATION") | AgentJs->Same(raw, "BLOCKLIST") | AgentJs->Same(raw, "PROHIBITED_CONTENT") | AgentJs->Same(raw, "SPII")) {
				stop := "filtered";
			};

			usage := AgentJs->Child(json, "usageMetadata");
			reply := AgentReply->New(text, calls, stop, AgentJs->IntOf(usage, "promptTokenCount"), AgentJs->IntOf(usage, "candidatesTokenCount"));
			if(AgentJs->IsArray(parts)) {
				reply->SetRaw(parts);
			};
			return reply;
		}

		method : public : Chat(conversation : AgentConversation, tools : Vector<AgentTool>) ~ AgentReply {
			@last_error := Nil;
			if(AgentKeys->InsecureTlsBlocksKey()) {
				@last_error := AgentKeys->Refusal();
				return Nil;
			};

			key := AgentKeys->Find(@key, "GOOGLE_API_KEY", "GEMINI_API_KEY", "gemini_api_key.dat");
			if(key = Nil) {
				@last_error := "no API key: pass one, set GOOGLE_API_KEY, or create gemini_api_key.dat";
				return Nil;
			};

			headers := Vector->New()<String>;
			headers->AddBack("x-goog-api-key");
			headers->AddBack(key);

			outcome := AgentWire->Post("{$@base_url}/models/{$@model}:generateContent", headers, BuildRequest(conversation, tools), @pem, false, "the Gemini API");
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};
			return ParseBody(outcome->GetJson()->ToString());
		}
	}

	# Trims a JSON Schema to the keywords Gemini's function Schema accepts
	class : private : GeminiSchema {
		function : Clean(schema : JsonElement) ~ JsonElement {
			if(<>AgentJs->IsObject(schema)) {
				return schema;
			};

			clean := AgentJs->Object();
			names := schema->GetNames();
			i := 0;
			while(i < names->Size()) {
				name := names->Get(i);
				value := schema->Get(name);
				if(name->Equals("type")) {
					CleanType(clean, value);
				}
				else if(name->Equals("properties")) {
					if(AgentJs->IsObject(value)) {
						properties := AgentJs->Object();
						keys := value->GetNames();
						j := 0;
						while(j < keys->Size()) {
							properties->Insert(keys->Get(j), Clean(value->Get(keys->Get(j))));
							j += 1;
						};
						clean->Insert("properties", properties);
					};
				}
				else if(name->Equals("items")) {
					clean->Insert("items", Clean(value));
				}
				else if(name->Equals("anyOf") | name->Equals("oneOf")) {
					if(AgentJs->IsArray(value) & <>clean->Has("anyOf")) {
						options := AgentJs->Array();
						k := 0;
						while(k < value->Size()) {
							options->Add(Clean(value->Get(k)));
							k += 1;
						};
						clean->Insert("anyOf", options);
					};
				}
				else if(name->Equals("const")) {
					if(<>schema->Has("enum")) {
						values := AgentJs->Array();
						values->Add(value);
						clean->Insert("enum", values);
					};
				}
				else if(Allowed(name)) {
					clean->Insert(name, value);
				};
				i += 1;
			};
			return clean;
		}

		function : Allowed(name : String) ~ Bool {
			return name->Equals("format") | name->Equals("title") | name->Equals("description") | name->Equals("nullable") |
				name->Equals("enum") | name->Equals("required") | name->Equals("minItems") | name->Equals("maxItems") |
				name->Equals("minimum") | name->Equals("maximum") | name->Equals("minLength") | name->Equals("maxLength") |
				name->Equals("pattern") | name->Equals("propertyOrdering");
		}

		# a list of types such as ["string","null"] becomes one type and nullable
		function : CleanType(clean : JsonElement, value : JsonElement) ~ Nil {
			if(value = Nil) {
				return;
			};

			if(value->GetType() = JsonElement->JsonType->STRING) {
				clean->Insert("type", value);
			}
			else if(AgentJs->IsArray(value)) {
				nullable := false;
				i := 0;
				while(i < value->Size()) {
					kind := AgentJs->Text(value->Get(i));
					if(kind <> Nil & kind->Equals("null")) {
						nullable := true;
					}
					else if(kind <> Nil & <>clean->Has("type")) {
						clean->Insert("type", kind);
					};
					i += 1;
				};

				if(nullable) {
					clean->Insert("nullable", true);
				};
			};
		}
	}

	#~
	A local Ollama server (POST /api/chat over plain HTTP, default http://localhost:11434). Ollama gives
	tool calls no ids, so one is made up for each and a result goes back as a tool message that names the tool.
	The model must support tools.
	~#
	class OllamaBackend implements ChatBackend {
		@model : String;
		@host : String;
		@max_tokens : Int;
		@temperature : Float;
		@has_temperature : Bool;
		@last_error : String;

		#~
		Constructor; it does not contact the server
		@param model model name, i.e. llama3.2
		~#
		New(model : String) {
			@model := model;
			@host := "http://localhost:11434";
		}

		#~
		Sets the server address
		@param host URL without a trailing slash
		@return self for chaining
		~#
		method : public : SetHost(host : String) ~ OllamaBackend {
			@host := host;
			return @self;
		}

		#~
		Sets the most tokens a reply may use (num_predict); unset by default
		@param max_tokens limit
		@return self for chaining
		~#
		method : public : SetMaxTokens(max_tokens : Int) ~ OllamaBackend {
			@max_tokens := max_tokens;
			return @self;
		}

		#~
		Sets the sampling temperature
		@param temperature value
		@return self for chaining
		~#
		method : public : SetTemperature(temperature : Float) ~ OllamaBackend {
			@temperature := temperature;
			@has_temperature := true;
			return @self;
		}

		method : public : GetName() ~ String {
			return "ollama";
		}

		method : public : GetLastError() ~ String {
			return @last_error;
		}

		#~
		Builds the request body for a conversation, public so it can be inspected without a server
		@param conversation the conversation
		@param tools the tools to offer, or Nil
		@return request JSON
		~#
		method : public : BuildRequest(conversation : AgentConversation, tools : Vector<AgentTool>) ~ JsonElement {
			request := AgentJs->Object();
			request->Insert("model", @model);
			request->Insert("messages", Messages(conversation));
			request->Insert("stream", false);

			if(tools <> Nil & tools->Size() > 0) {
				tools_json := AgentJs->Array();
				i := 0;
				while(i < tools->Size()) {
					tool := tools->Get(i);
					function_json := AgentJs->Object();
					function_json->Insert("name", tool->GetName());
					if(tool->GetDescription() <> Nil) {
						function_json->Insert("description", tool->GetDescription());
					};
					function_json->Insert("parameters", tool->GetSchema());

					tool_json := AgentJs->Object();
					tool_json->Insert("type", "function");
					tool_json->Insert("function", function_json);
					tools_json->Add(tool_json);
					i += 1;
				};
				request->Insert("tools", tools_json);
			};

			if(@max_tokens > 0 | @has_temperature) {
				options := AgentJs->Object();
				if(@max_tokens > 0) {
					options->Insert("num_predict", @max_tokens);
				};
				if(@has_temperature) {
					options->Insert("temperature", @temperature);
				};
				request->Insert("options", options);
			};
			return request;
		}

		method : Messages(conversation : AgentConversation) ~ JsonElement {
			messages := AgentJs->Array();
			if(conversation->GetSystem() <> Nil) {
				messages->Add(AgentJs->RoleText("system", conversation->GetSystem()));
			};

			entries := conversation->GetEntries();
			i := 0;
			while(i < entries->Size()) {
				entry := entries->Get(i);
				role := entry->GetRole();
				if(role->Equals("user")) {
					messages->Add(AgentJs->RoleText("user", entry->GetText()));
				}
				else if(role->Equals("assistant")) {
					messages->Add(Assistant(entry));
				}
				else {
					message := AgentJs->RoleText("tool", entry->GetText());
					message->Insert("tool_name", entry->GetToolName());
					messages->Add(message);
				};
				i += 1;
			};
			return messages;
		}

		method : Assistant(entry : AgentEntry) ~ JsonElement {
			message := AgentJs->RoleText("assistant", entry->GetText());
			calls := entry->GetToolCalls();
			if(calls->Size() > 0) {
				calls_json := AgentJs->Array();
				i := 0;
				while(i < calls->Size()) {
					call := calls->Get(i);
					function_json := AgentJs->Object();
					function_json->Insert("name", call->GetName());
					if(call->GetArguments() <> Nil) {
						function_json->Insert("arguments", call->GetArguments());
					}
					else {
						function_json->Insert("arguments", AgentJs->Object());
					};

					call_json := AgentJs->Object();
					call_json->Insert("function", function_json);
					calls_json->Add(call_json);
					i += 1;
				};
				message->Insert("tool_calls", calls_json);
			};
			return message;
		}

		#~
		Reads a response body without a server, for tests and for replaying recorded responses
		@param body response text
		@return reply, or Nil with the last error set
		~#
		method : public : ParseBody(body : String) ~ AgentReply {
			@last_error := Nil;
			outcome := AgentWire->Body(body);
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};

			json := outcome->GetJson();
			message := AgentJs->Child(json, "message");
			if(<>AgentJs->IsObject(message)) {
				@last_error := "the response did not contain a message";
				return Nil;
			};

			text := AgentJs->Text(message, "content");
			if(text = Nil) {
				text := "";
			};

			calls := Vector->New()<AgentToolCall>;
			made := AgentJs->Child(message, "tool_calls");
			if(AgentJs->IsArray(made)) {
				i := 0;
				while(i < made->Size()) {
					function_json := AgentJs->Child(made->Get(i), "function");
					args := AgentJs->Child(function_json, "arguments");
					if(args <> Nil & args->GetType() = JsonElement->JsonType->STRING) {
						args := AgentJs->Arguments(args->GetString());
					}
					else if(<>AgentJs->IsObject(args)) {
						args := AgentJs->Object();
					};
					calls->AddBack(AgentToolCall->New(AgentIds->Next("ollama_call_"), AgentJs->Text(function_json, "name"), args));
					i += 1;
				};
			};

			raw := AgentJs->Text(json, "done_reason");
			stop := "other";
			if(calls->Size() > 0) {
				stop := "tool_calls";
			}
			else if(raw = Nil | AgentJs->Same(raw, "stop")) {
				stop := "end";
			}
			else if(AgentJs->Same(raw, "length")) {
				stop := "length";
			};

			return AgentReply->New(text, calls, stop, AgentJs->IntOf(json, "prompt_eval_count"), AgentJs->IntOf(json, "eval_count"));
		}

		method : public : Chat(conversation : AgentConversation, tools : Vector<AgentTool>) ~ AgentReply {
			@last_error := Nil;
			outcome := AgentWire->Post("{$@host}/api/chat", Nil, BuildRequest(conversation, tools), Nil, true, "the Ollama server at {$@host}");
			if(<>outcome->IsOk()) {
				@last_error := Redactor->Scrub(outcome->GetError());
				return Nil;
			};
			return ParseBody(outcome->GetJson()->ToString());
		}
	}

	#~
	Ready-made tools: a calculator, the current time and a file reader confined to one directory. They are
	examples and are safe to give a model; none is marked dangerous.

```
registry := ToolRegistry->New();
registry->Add(AgentTools->Calculator());
registry->Add(AgentTools->CurrentTime());
registry->Add(AgentTools->ReadFile("notes"));
```
	~#
	class AgentTools {
		#~
		Adds the calculator, the clock and a file reader for a directory to a registry
		@param registry the registry
		@param sandbox directory the file reader may read under, or Nil to leave the file reader out
		~#
		function : AddAll(registry : ToolRegistry, sandbox : String) ~ Nil {
			registry->Add(Calculator());
			registry->Add(CurrentTime());
			if(sandbox <> Nil) {
				registry->Add(ReadFile(sandbox));
			};
		}

		#~
		A calculator: + - * / % ^, parentheses, pi, e, and sqrt, abs, sin, cos, tan, ln, log10, exp, floor, ceil, round
		@return the tool, named calculator, taking {"expression": string}
		~#
		function : Calculator() ~ AgentTool {
			schema := AgentJs->Arguments("{\"type\":\"object\",\"properties\":{\"expression\":{\"type\":\"string\",\"description\":\"an arithmetic expression such as (3 + 4) * sqrt(16)\",\"minLength\":1}},\"required\":[\"expression\"],\"additionalProperties\":false}");
			return AgentTool->New("calculator", "Evaluates an arithmetic expression and returns the number. Use it for any calculation instead of working it out yourself.", schema, CalculatorHandler->New());
		}

		#~
		The current date and time in UTC, optionally shifted by whole hours
		@return the tool, named current_time, taking an optional {"offset_hours": integer}
		~#
		function : CurrentTime() ~ AgentTool {
			schema := AgentJs->Arguments("{\"type\":\"object\",\"properties\":{\"offset_hours\":{\"type\":\"integer\",\"description\":\"hours to add to UTC, -12 to 14\",\"minimum\":-12,\"maximum\":14}},\"additionalProperties\":false}");
			return AgentTool->New("current_time", "Returns the current date and time in UTC, or shifted by offset_hours.", schema, TimeHandler->New());
		}

		#~
		Reads a text file from under a directory. The path must be relative and may not contain .. or start with a
		slash or a drive letter; the checks are on the text of the path, so a symbolic link inside the directory
		can still lead out of it. Results over 64000 characters are cut.
		@param sandbox the directory
		@return the tool, named read_file, taking {"path": string}
		~#
		function : ReadFile(sandbox : String) ~ AgentTool {
			schema := AgentJs->Arguments("{\"type\":\"object\",\"properties\":{\"path\":{\"type\":\"string\",\"description\":\"file path relative to the sandbox directory\",\"minLength\":1}},\"required\":[\"path\"],\"additionalProperties\":false}");
			return AgentTool->New("read_file", "Reads a text file and returns its contents. The path is relative to a fixed directory.", schema, FileHandler->New(sandbox));
		}

		#~
		Joins a relative path onto a directory, or refuses it
		@param sandbox the directory
		@param path the path the model gave
		@return the joined path, or Nil when the path is empty, absolute or climbs out with ..
		~#
		function : SafePath(sandbox : String, path : String) ~ String {
			if(sandbox = Nil | path = Nil) {
				return Nil;
			};

			clean := path->ReplaceAll('\\', '/')->Trim();
			if(clean->Size() = 0 | clean->StartsWith('/') | clean->Has('\0')) {
				return Nil;
			};

			# a drive letter such as C:
			if(clean->Size() > 1 & clean->Get(1) = ':') {
				return Nil;
			};

			i := 0;
			segment := String->New();
			while(i <= clean->Size()) {
				if(i = clean->Size() | clean->Get(i) = '/') {
					if(segment->Equals("..")) {
						return Nil;
					};
					segment->Clear();
				}
				else {
					segment->Append(clean->Get(i));
				};
				i += 1;
			};

			base := sandbox->ReplaceAll('\\', '/');
			if(base->EndsWith('/')) {
				return "{$base}{$clean}";
			};
			return "{$base}/{$clean}";
		}
	}

	class : private : CalculatorHandler implements AgentToolHandler {
		New() {
		}

		method : public : Run(arguments : JsonElement) ~ String {
			expression := AgentJs->Text(arguments, "expression");
			calc := AgentCalc->New(expression);
			value := calc->Evaluate();
			if(Float->Abs(value) < 1.0e15 & Float->Floor(value) = value) {
				whole := value->As(Int);
				return whole->ToString();
			};
			# 3.500000 is 3.5
			text := value->ToString();
			if(text->Has('.')) {
				end := text->Size();
				while(end > 1 & text->Get(end - 1) = '0') {
					end -= 1;
				};
				if(text->Get(end - 1) = '.') {
					end -= 1;
				};
				text := text->SubString(0, end);
			};
			return text;
		}
	}

	class : private : TimeHandler implements AgentToolHandler {
		New() {
		}

		method : public : Run(arguments : JsonElement) ~ String {
			now := System.Time.Date->New(true);
			offset := AgentJs->IntOf(arguments, "offset_hours");
			if(offset <> 0) {
				now->AddHours(offset);
			};

			text := now->GetDateString();
			text->Append(' ');
			text->Append(now->GetTimeString());
			if(offset = 0) {
				text->Append(" UTC");
			}
			else if(offset > 0) {
				text->Append(" (UTC+{$offset})");
			}
			else {
				text->Append(" (UTC{$offset})");
			};
			return text;
		}
	}

	class : private : FileHandler implements AgentToolHandler {
		@sandbox : String;

		New(sandbox : String) {
			@sandbox := sandbox;
		}

		method : public : Run(arguments : JsonElement) ~ String {
			path := AgentJs->Text(arguments, "path");
			full := AgentTools->SafePath(@sandbox, path);
			if(full = Nil) {
				Runtime->Raise(Error->New("the path must be relative to the sandbox and may not contain .."));
			};

			text := System.IO.Filesystem.FileReader->ReadFile(full);
			if(text = Nil) {
				Runtime->Raise(Error->New("no such file: {$path}"));
			};

			if(text->Size() > 64000) {
				return text->Truncate(64000, "... [truncated]");
			};
			return text;
		}
	}

	# A recursive-descent evaluator for the calculator tool; it raises an Error for text it cannot read
	class : private : AgentCalc {
		@chars : Char[];
		@pos : Int;

		New(text : String) {
			if(text = Nil) {
				text := "";
			};
			@chars := text->ToCharArray();
			@pos := 0;
		}

		method : public : Evaluate() ~ Float {
			value := Sum();
			Skip();
			if(@pos < @chars->Size()) {
				Fail("unexpected '{$(@chars[@pos])}'");
			};
			return value;
		}

		method : Fail(message : String) ~ Nil {
			Runtime->Raise(Error->New(message));
		}

		method : Skip() ~ Nil {
			while(@pos < @chars->Size() & (@chars[@pos] = ' ' | @chars[@pos] = '\t')) {
				@pos += 1;
			};
		}

		method : Peek() ~ Char {
			Skip();
			if(@pos < @chars->Size()) {
				return @chars[@pos];
			};
			return '\0';
		}

		method : Sum() ~ Float {
			value := Product();
			more := true;
			while(more) {
				c := Peek();
				if(c = '+') {
					@pos += 1;
					value += Product();
				}
				else if(c = '-') {
					@pos += 1;
					value -= Product();
				}
				else {
					more := false;
				};
			};
			return value;
		}

		method : Product() ~ Float {
			value := Power();
			more := true;
			while(more) {
				c := Peek();
				if(c = '*') {
					@pos += 1;
					value *= Power();
				}
				else if(c = '/') {
					@pos += 1;
					divisor := Power();
					if(divisor = 0.0) {
						Fail("division by zero");
					};
					value /= divisor;
				}
				else if(c = '%') {
					@pos += 1;
					divisor := Power();
					if(divisor = 0.0) {
						Fail("division by zero");
					};
					value := Float->Mod(value, divisor);
				}
				else {
					more := false;
				};
			};
			return value;
		}

		# ^ is right-associative and binds tighter than unary minus on its left: -2^2 is -4
		method : Power() ~ Float {
			base := Unary();
			if(Peek() = '^') {
				@pos += 1;
				return Float->Pow(base, Power());
			};
			return base;
		}

		method : Unary() ~ Float {
			c := Peek();
			if(c = '-') {
				@pos += 1;
				return 0.0 - Power();
			};
			if(c = '+') {
				@pos += 1;
				return Unary();
			};
			return Primary();
		}

		method : Primary() ~ Float {
			c := Peek();
			if(c = '(') {
				@pos += 1;
				value := Sum();
				if(Peek() <> ')') {
					Fail("missing )");
				};
				@pos += 1;
				return value;
			};

			if((c >= '0' & c <= '9') | c = '.') {
				return Number();
			};

			if((c >= 'a' & c <= 'z') | (c >= 'A' & c <= 'Z')) {
				return Named();
			};

			if(c = '\0') {
				Fail("the expression ended early");
			};
			Fail("unexpected '{$c}'");
			return 0.0;
		}

		method : Number() ~ Float {
			start := @pos;
			while(@pos < @chars->Size() & ((@chars[@pos] >= '0' & @chars[@pos] <= '9') | @chars[@pos] = '.')) {
				@pos += 1;
			};

			text := String->New();
			i := start;
			while(i < @pos) {
				text->Append(@chars[i]);
				i += 1;
			};

			if(<>text->IsFloat() & <>text->IsInt()) {
				Fail("'{$text}' is not a number");
			};
			return text->ToFloat();
		}

		method : Named() ~ Float {
			name := String->New();
			while(@pos < @chars->Size() & ((@chars[@pos] >= 'a' & @chars[@pos] <= 'z') | (@chars[@pos] >= 'A' & @chars[@pos] <= 'Z') | (@chars[@pos] >= '0' & @chars[@pos] <= '9'))) {
				name->Append(@chars[@pos]);
				@pos += 1;
			};

			lower := name->ToLower();
			if(Peek() <> '(') {
				if(lower->Equals("pi")) {
					return Float->Pi();
				};
				if(lower->Equals("e")) {
					return Float->E();
				};
				Fail("unknown name '{$name}'");
			};

			@pos += 1;
			arg := Sum();
			if(Peek() <> ')') {
				Fail("missing )");
			};
			@pos += 1;
			return Apply(lower, arg);
		}

		method : Apply(name : String, arg : Float) ~ Float {
			if(name->Equals("sqrt")) {
				if(arg < 0.0) {
					Fail("sqrt of a negative number");
				};
				return Float->Sqrt(arg);
			};
			if(name->Equals("abs")) {
				return Float->Abs(arg);
			};
			if(name->Equals("sin")) {
				return Float->Sin(arg);
			};
			if(name->Equals("cos")) {
				return Float->Cos(arg);
			};
			if(name->Equals("tan")) {
				return Float->Tan(arg);
			};
			if(name->Equals("ln")) {
				if(arg <= 0.0) {
					Fail("ln needs a positive number");
				};
				return Float->Log(arg);
			};
			if(name->Equals("log10")) {
				if(arg <= 0.0) {
					Fail("log10 needs a positive number");
				};
				return Float->Log10(arg);
			};
			if(name->Equals("exp")) {
				return Float->Exp(arg);
			};
			if(name->Equals("floor")) {
				return Float->Floor(arg);
			};
			if(name->Equals("ceil")) {
				return Float->Ceil(arg);
			};
			if(name->Equals("round")) {
				return Float->Round(arg);
			};
			Fail("unknown function '{$name}'");
			return 0.0;
		}
	}

	# Made-up ids for the providers that do not number their tool calls
	class : private : AgentIds {
		@next : static : Int;

		function : Next(prefix : String) ~ String {
			@next += 1;
			count := @next;
			return "{$prefix}{$count}";
		}
	}
}
