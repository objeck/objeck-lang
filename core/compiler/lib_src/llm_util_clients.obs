use Collection;
use Data.JSON;
use API.LlmUtil;

#~
Adapters that connect the llm_util interfaces to the four chat clients: AnthropicChatFn, OpenAIChatFn, GeminiChatFn and OllamaChatFn implement ChatFn (so StructuredCall works with any of them), GeminiTokenCounter implements TokenCounter with Gemini's exact count endpoint, and PromptAdapters turns a PromptBuilder into each client's own message type. This is a separate library so that llm_util itself links no client and no network code: the pure helpers work with a ChatFn you write. Using these adapters links all four client libraries, whichever one you call: compile with -lib llm_util_clients,llm_util,regex,json,gen_collect,anthropic,openai,gemini,ollama,net,net_server,cipher,misc. Every class names the client classes in full, so no client's short names are imported. Guide: docs/AI.md, "LLM utilities".

An adapter is stateless: each Complete() builds a fresh client conversation from the turns it is given and sends it, so a retry loop can replay a longer conversation on every call. An adapter that fails returns Nil from Complete() and says why in GetError().
~#
bundle API.LlmUtil.Clients {
	#~
	Splits a conversation: the system turns joined into one text, and the other turns.
	~#
	class TurnSplit {
		@system : String;
		@turns : Vector<PromptTurn>;

		#~
		Constructor
		@param turns every turn, with any "system" turns among them
		~#
		New(turns : Vector<PromptTurn>) {
			@turns := Vector->New()<PromptTurn>;
			buffer := String->New();
			if(turns <> Nil) {
				each(i : turns) {
					turn := turns->Get(i);
					if(turn->GetRole()->Equals("system")) {
						if(buffer->Size() > 0) {
							buffer->Append("\n\n");
						};
						buffer->Append(turn->GetText());
					}
					else {
						@turns->AddBack(turn);
					};
				};
			};
			if(buffer->Size() > 0) {
				@system := buffer->ToString();
			};
		}

		#~
		Gets the system text
		@return the system turns joined with blank lines, or Nil when there are none
		~#
		method : public : GetSystem() ~ String {
			return @system;
		}

		#~
		Gets the user and assistant turns
		@return the turns
		~#
		method : public : GetTurns() ~ Vector<PromptTurn> {
			return @turns;
		}

		#~
		Checks that the conversation can be sent: it is not empty and ends with a user turn
		@return Nil when it can, else the reason
		~#
		method : public : Problem() ~ String {
			if(@turns->Size() = 0) {
				return "the conversation has no user turn";
			};
			if(<>@turns->Last()->GetRole()->Equals("user")) {
				return "the conversation must end with a user turn";
			};
			return Nil;
		}
	}

	#~
	ChatFn over API.Anthropic.Chat. The system turns become the system prompt; earlier turns are added to the conversation and the last user turn is sent. The token counts of the last reply are kept.

```
chat := AnthropicChatFn->New("claude-sonnet-5-5", Nil);
outcome := StructuredCall->New(chat, schema)->Ask("Extract the order from: ...");
```
	~#
	class AnthropicChatFn implements ChatFn {
		@model : String;
		@key : String;
		@max_tokens : Int;
		@error : String;
		@input_tokens : Int;
		@output_tokens : Int;

		#~
		Constructor
		@param model model id
		@param key API key, or Nil to use the client's own lookup (ANTHROPIC_API_KEY or anthropic_api_key.dat)
		~#
		New(model : String, key : String) {
			@model := model;
			@key := key;
			@max_tokens := 4096;
		}

		#~
		Sets the reply length limit
		@param max_tokens most tokens in a reply, default 4096
		@return self for chaining
		~#
		method : public : SetMaxTokens(max_tokens : Int) ~ AnthropicChatFn {
			@max_tokens := max_tokens;
			return @self;
		}

		#~
		Sends a conversation
		@param turns the conversation, ending with a user turn
		@return the reply text, or Nil with GetError() set
		~#
		method : public : Complete(turns : Vector<PromptTurn>) ~ String {
			@error := Nil;
			split := TurnSplit->New(turns);
			@error := split->Problem();
			if(@error <> Nil) {
				return Nil;
			};

			chat := API.Anthropic.Chat->New(@model, @key);
			chat->SetMaxTokens(@max_tokens);
			if(split->GetSystem() <> Nil) {
				chat->SetSystem(split->GetSystem());
			};
			source := split->GetTurns();
			for(i := 0; i < source->Size() - 1; i += 1;) {
				chat->AddMessage(source->Get(i)->GetRole(), source->Get(i)->GetText());
			};

			text := chat->Send(source->Last()->GetText());
			if(text = Nil) {
				@error := API.Anthropic.EndPoint->GetLastError();
				if(@error = Nil) {
					@error := "the Anthropic client returned no reply";
				};
				return Nil;
			};

			reply := chat->GetLastReply();
			if(reply <> Nil) {
				@input_tokens := reply->GetInputTokens();
				@output_tokens := reply->GetOutputTokens();
			};
			return text;
		}

		#~
		Gets the last error
		@return why the last Complete() returned Nil
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Gets the input tokens the last reply reported, an exact count of what was sent
		@return input tokens
		~#
		method : public : GetLastInputTokens() ~ Int {
			return @input_tokens;
		}

		#~
		Gets the output tokens the last reply reported
		@return output tokens
		~#
		method : public : GetLastOutputTokens() ~ Int {
			return @output_tokens;
		}
	}

	#~
	ChatFn over API.OpenAI.Chat.Completion (the chat completions endpoint). The system turns are sent as "system" messages.
	~#
	class OpenAIChatFn implements ChatFn {
		@model : String;
		@key : String;
		@error : String;

		#~
		Constructor
		@param model model id
		@param key API key, or Nil to use the client's own lookup
		~#
		New(model : String, key : String) {
			@model := model;
			@key := key;
		}

		#~
		Sends a conversation
		@param turns the conversation, ending with a user turn
		@return the reply text, or Nil with GetError() set
		~#
		method : public : Complete(turns : Vector<PromptTurn>) ~ String {
			@error := Nil;
			split := TurnSplit->New(turns);
			@error := split->Problem();
			if(@error <> Nil) {
				return Nil;
			};

			key := @key;
			if(key = Nil) {
				key := API.OpenAI.EndPoint->GetApiKey();
			};
			if(key = Nil) {
				@error := "no OpenAI API key";
				return Nil;
			};

			messages := PromptAdapters->OpenAIMessages(turns);
			completion := API.OpenAI.Chat.Completion->Complete(@model, messages, key);
			if(completion = Nil) {
				@error := API.OpenAI.EndPoint->GetLastError();
				if(@error = Nil) {
					@error := "the OpenAI client returned no completion";
				};
				return Nil;
			};

			choice := completion->GetFirstChoice();
			if(choice = Nil) {
				@error := "the completion has no choices";
				return Nil;
			};
			return choice->GetMessage()->GetSecond();
		}

		#~
		Gets the last error
		@return why the last Complete() returned Nil
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	#~
	ChatFn over API.Google.Gemini.Model->GenerateContent. The system turns become the system instruction and assistant turns are sent with Gemini's "model" role.
	~#
	class GeminiChatFn implements ChatFn {
		@model : String;
		@key : String;
		@error : String;

		#~
		Constructor
		@param model model name as Gemini writes it, for example Model->GEMINI_2_5_FLASH()
		@param key API key, or Nil to use the client's own lookup (GOOGLE_API_KEY)
		~#
		New(model : String, key : String) {
			@model := model;
			@key := key;
		}

		#~
		Sends a conversation
		@param turns the conversation, ending with a user turn
		@return the reply text, or Nil with GetError() set
		~#
		method : public : Complete(turns : Vector<PromptTurn>) ~ String {
			@error := Nil;
			split := TurnSplit->New(turns);
			@error := split->Problem();
			if(@error <> Nil) {
				return Nil;
			};

			key := @key;
			if(key = Nil) {
				key := API.Google.Gemini.EndPoint->GetApiKey();
			};
			if(key = Nil) {
				@error := "no Gemini API key";
				return Nil;
			};

			# The client's multi-turn GenerateContent takes a Vector<Content>, a generic argument that
			# resolves by short name and clashes with other libraries' Content classes, so the request
			# is built here and sent the way the client sends it; the client parses the reply.
			request := JsonElement->New(JsonElement->JsonType->OBJECT);
			request->Insert("contents", PromptAdapters->GeminiContents(turns));
			if(split->GetSystem() <> Nil) {
				request->Insert("systemInstruction", PromptAdapters->GeminiSystem(turns));
			};

			url := Web.HTTP.Url->New("https://generativelanguage.googleapis.com/v1beta/{$@model}:generateContent?key={$key}");
			response := Web.HTTP.HttpsClient->QuickPost(url, request->ToString()->ToByteArray(), "application/json");
			if(response = Nil) {
				@error := API.Google.Gemini.EndPoint->GetLastError();
				if(@error = Nil) {
					@error := "no response from Gemini";
				};
				return Nil;
			};

			return ReplyText(API.Google.Gemini.OAuthEndPoint->ResponseText(response));
		}

		#~
		Reads the reply text out of a generateContent response body: the text parts of the first candidate, joined
		@param body response body
		@return the text, or Nil with GetError() set (an error body, a blocked prompt, no candidate)
		~#
		method : public : ReplyText(body : String) ~ String {
			@error := Nil;
			root := JsonParser->TextToElement(body);
			if(root = Nil | root->GetType() <> JsonElement->JsonType->OBJECT) {
				@error := "Gemini sent a reply that is not a JSON object";
				return Nil;
			};

			failure := root->Get("error");
			if(failure <> Nil) {
				message := failure->Get("message");
				if(message <> Nil) {
					@error := message->GetString();
				}
				else {
					@error := failure->ToString();
				};
				return Nil;
			};

			candidates := root->Get("candidates");
			if(candidates = Nil | candidates->Size() = 0) {
				@error := "Gemini returned no candidates (the prompt may have been blocked)";
				return Nil;
			};

			content := candidates->Get(0)->Get("content");
			if(content = Nil | content->Get("parts") = Nil) {
				@error := "the Gemini candidate has no content";
				return Nil;
			};

			parts := content->Get("parts");
			text := String->New();
			for(i := 0; i < parts->Size(); i += 1;) {
				piece := parts->Get(i)->Get("text");
				if(piece <> Nil) {
					text->Append(piece->GetString());
				};
			};
			return text->ToString();
		}

		#~
		Gets the last error
		@return why the last Complete() returned Nil
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	#~
	ChatFn over API.Ollama.Chat, for a local model. The system turns are added as a "system" message.
	~#
	class OllamaChatFn implements ChatFn {
		@model : String;
		@error : String;

		#~
		Constructor
		@param model model name such as "llama3"
		~#
		New(model : String) {
			@model := model;
		}

		#~
		Sends a conversation
		@param turns the conversation, ending with a user turn
		@return the reply text, or Nil with GetError() set
		~#
		method : public : Complete(turns : Vector<PromptTurn>) ~ String {
			@error := Nil;
			split := TurnSplit->New(turns);
			@error := split->Problem();
			if(@error <> Nil) {
				return Nil;
			};

			chat := API.Ollama.Chat->New(@model);
			if(split->GetSystem() <> Nil) {
				chat->AddMessage("system", split->GetSystem());
			};
			source := split->GetTurns();
			for(i := 0; i < source->Size() - 1; i += 1;) {
				chat->AddMessage(source->Get(i)->GetRole(), source->Get(i)->GetText());
			};

			text := chat->Send(source->Last()->GetText());
			if(text = Nil) {
				@error := API.Ollama.EndPoint->GetLastError();
				if(@error = Nil) {
					@error := "the Ollama client returned no reply";
				};
				return Nil;
			};
			return text;
		}

		#~
		Gets the last error
		@return why the last Complete() returned Nil
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	#~
	An exact token counter over Gemini's countTokens endpoint. It makes a network call for every Count(); when the call fails it falls back to a TokenEstimator and IsExact() says false, so a budget never stops on a network error.
	~#
	class GeminiTokenCounter implements TokenCounter {
		@model : String;
		@key : String;
		@fallback : TokenEstimator;
		@exact : Bool;

		#~
		Constructor
		@param model model name as Gemini writes it
		@param key API key, or Nil to use the client's own lookup
		~#
		New(model : String, key : String) {
			@model := model;
			@key := key;
			@fallback := TokenEstimator->New();
		}

		#~
		Counts the tokens in a text
		@param text the text
		@return the model's own count, or the estimate when the call failed
		~#
		method : public : Count(text : String) ~ Int {
			@exact := false;
			if(text = Nil | text->Size() = 0) {
				@exact := true;
				return 0;
			};

			key := @key;
			if(key = Nil) {
				key := API.Google.Gemini.EndPoint->GetApiKey();
			};
			if(key <> Nil) {
				content := API.Google.Gemini.Content->New("user")->AddPart(API.Google.Gemini.TextPart->New(text));
				count := API.Google.Gemini.Model->CountTokens(@model, content, key);
				if(count >= 0) {
					@exact := true;
					return count;
				};
			};
			return @fallback->Estimate(text);
		}

		#~
		Tells whether the last Count() came from Gemini
		@return true if exact, false if it was estimated
		~#
		method : public : IsExact() ~ Bool {
			return @exact;
		}
	}

	#~
	Turns a conversation into each client's own message type, for code that drives a client directly instead of through ChatFn.

```
builder := PromptBuilder->New()->System("Be brief.")->User("Hi");
chat := PromptAdapters->FillAnthropic(builder, API.Anthropic.Chat->New("claude-sonnet-5-5", Nil));
```
	~#
	class PromptAdapters {
		#~
		The conversation as role and text pairs for API.OpenAI.Chat.Completion->Complete, system turns first
		@param turns the turns
		@return the pairs
		~#
		function : OpenAIMessages(turns : Vector<PromptTurn>) ~ Vector<Pair<String, String>> {
			pairs := Vector->New()<Pair<String, String>>;
			if(turns <> Nil) {
				each(i : turns) {
					pairs->AddBack(Pair->New(turns->Get(i)->GetRole(), turns->Get(i)->GetText())<String, String>);
				};
			};
			return pairs;
		}

		#~
		The conversation as the "contents" array of a Gemini generateContent request: "user" turns stay, "assistant" turns take Gemini's "model" role, system turns are left out (see GeminiSystem)
		@param turns the turns
		@return a JSON array of role and parts objects
		~#
		function : GeminiContents(turns : Vector<PromptTurn>) ~ JsonElement {
			contents := JsonElement->New(JsonElement->JsonType->ARRAY);
			if(turns <> Nil) {
				each(i : turns) {
					role := turns->Get(i)->GetRole();
					if(<>role->Equals("system")) {
						if(role->Equals("assistant")) {
							role := "model";
						};
						part := JsonElement->New(JsonElement->JsonType->OBJECT);
						part->Insert("text", turns->Get(i)->GetText());
						parts := JsonElement->New(JsonElement->JsonType->ARRAY);
						parts->Add(part);
						content := JsonElement->New(JsonElement->JsonType->OBJECT);
						content->Insert("role", role);
						content->Insert("parts", parts);
						contents->Add(content);
					};
				};
			};
			return contents;
		}

		#~
		The system turns as the "systemInstruction" object of a Gemini request
		@param turns the turns
		@return a JSON object with a parts array, or Nil when there is no system turn
		~#
		function : GeminiSystem(turns : Vector<PromptTurn>) ~ JsonElement {
			split := TurnSplit->New(turns);
			if(split->GetSystem() = Nil) {
				return Nil;
			};
			part := JsonElement->New(JsonElement->JsonType->OBJECT);
			part->Insert("text", split->GetSystem());
			parts := JsonElement->New(JsonElement->JsonType->ARRAY);
			parts->Add(part);
			instruction := JsonElement->New(JsonElement->JsonType->OBJECT);
			instruction->Insert("parts", parts);
			return instruction;
		}

		#~
		Adds a builder's system prompt and turns to an Anthropic chat
		@param builder the conversation
		@param chat the chat to fill
		@return the same chat, for chaining
		~#
		function : FillAnthropic(builder : PromptBuilder, chat : API.Anthropic.Chat) ~ API.Anthropic.Chat {
			if(builder->GetSystem() <> Nil) {
				chat->SetSystem(builder->GetSystem());
			};
			turns := builder->GetTurns();
			each(i : turns) {
				chat->AddMessage(turns->Get(i)->GetRole(), turns->Get(i)->GetText());
			};
			return chat;
		}

		#~
		Adds a builder's system prompt and turns to an Ollama chat
		@param builder the conversation
		@param chat the chat to fill
		@return the same chat, for chaining
		~#
		function : FillOllama(builder : PromptBuilder, chat : API.Ollama.Chat) ~ API.Ollama.Chat {
			if(builder->GetSystem() <> Nil) {
				chat->AddMessage("system", builder->GetSystem());
			};
			turns := builder->GetTurns();
			each(i : turns) {
				chat->AddMessage(turns->Get(i)->GetRole(), turns->Get(i)->GetText());
			};
			return chat;
		}
	}
}
