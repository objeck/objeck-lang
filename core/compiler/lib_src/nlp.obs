use Collection;

#~
Natural language processing toolkit. Provides tokenization, text preprocessing, TF-IDF vectorization, cosine similarity, and sentiment analysis. Works with plain strings — no external model required. Compile with -lib nlp.
~#
bundle System.NLP {
	#~
	Text tokenization utilities for breaking text into words, sentences, and n-grams

```
text := "Hello, world! This is a test.";
words := System.NLP.Tokenizer->WordTokenize(text);
sentences := System.NLP.Tokenizer->SentenceTokenize(text);
bigrams := System.NLP.Tokenizer->WordNGrams(words, 2);
```
	~#
	class Tokenizer {
		@abbreviations : static : Hash<String, BoolRef>;

		#~
		Tokenizes text into words. A word is a run of letters and digits, including non-Latin
		letters; an apostrophe between letters (don't, O'Brien), a hyphen between letters or
		digits (state-of-the-art, COVID-19) and a '.' or ',' between digits (3.14, 5,000) stay
		inside it. Whitespace and punctuation separate words and are dropped. Case is kept.
		@param text input text to tokenize
		@return array of word tokens

```
words := Tokenizer->WordTokenize("I don't think 3.14 is state-of-the-art.");
each(w in words) {
  w->PrintLine();
};
```
		~#
		function : WordTokenize(text : String) ~ String[] {
			if(text = Nil | text->IsEmpty()) {
				return String->New[0];
			};

			tokens := Vector->New()<String>;
			n := text->Size();
			i := 0;

			while(i < n) {
				if(IsWordChar(text->Get(i))) {
					start := i;
					i += 1;
					scanning := true;
					while(scanning & i < n) {
						if(IsWordChar(text->Get(i))) {
							i += 1;
						}
						else if(i + 1 < n & IsJoiner(text->Get(i - 1), text->Get(i), text->Get(i + 1))) {
							i += 2;
						}
						else {
							scanning := false;
						};
					};
					tokens->AddBack(text->SubString(start, i - start));
				}
				else {
					i += 1;
				};
			};

			return tokens->ToArray();
		}

		#~
		Tokenizes text into sentences. A sentence ends at a run of '.', '!' or '?' (so "..." and
		"?!" are one boundary), with any closing quotes or brackets, followed by whitespace or the
		end of the text. A '.' after a known abbreviation (Dr, Mrs, e.g, U.S, Jan ...) or a single
		capital initial does not end a sentence, and neither does a '.' inside a number (3.50).
		@param text input text to tokenize
		@return array of sentence tokens

```
sents := Tokenizer->SentenceTokenize("Dr. Smith paid $3.50. Wait... really?! Yes.");
each(s in sents) {
  s->PrintLine();
};
```
		~#
		function : SentenceTokenize(text : String) ~ String[] {
			if(text = Nil | text->IsEmpty()) {
				return String->New[0];
			};

			InitAbbreviations();

			sentences := Vector->New()<String>;
			n := text->Size();
			start := 0;
			i := 0;

			while(i < n) {
				c := text->Get(i);
				if(IsTerminator(c)) {
					# the whole run of terminators, then any closing quotes or brackets
					j := i;
					while(j < n & IsTerminator(text->Get(j))) {
						j += 1;
					};
					while(j < n & IsCloser(text->Get(j))) {
						j += 1;
					};

					if(j = n | IsSpace(text->Get(j))) {
						# a lone '.' after an abbreviation or an initial is not a boundary
						boundary := true;
						if(c = '.' & j - i = 1) {
							boundary := <>IsAbbreviation(text, i);
						};

						if(boundary) {
							sentence := text->SubString(start, j - start)->Trim();
							if(<>sentence->IsEmpty()) {
								sentences->AddBack(sentence);
							};
							start := j;
						};
					};
					i := j;
				}
				else {
					i += 1;
				};
			};

			if(start < n) {
				remaining := text->SubString(start, n - start)->Trim();
				if(<>remaining->IsEmpty()) {
					sentences->AddBack(remaining);
				};
			};

			return sentences->ToArray();
		}

		# the word ending just before the '.' at 'pos', letters and inner periods ("U.S", "e.g")
		function : private : IsAbbreviation(text : String, pos : Int) ~ Bool {
			start := pos;
			while(start > 0 & (IsLetter(text->Get(start - 1)) | text->Get(start - 1) = '.')) {
				start -= 1;
			};

			if(start = pos) {
				return false;
			};

			word := text->SubString(start, pos - start);
			# a single capital is an initial ("J. R. R. Tolkien"), except the pronoun
			if(word->Size() = 1) {
				letter := word->Get(0);
				return Char->IsUpper(letter) & letter <> 'I';
			};

			return @abbreviations->Has(word->ToLower());
		}

		function : private : InitAbbreviations() ~ Nil {
			if(@abbreviations = Nil) {
				@abbreviations := Hash->New()<String, BoolRef>;
				words := [
					"mr", "mrs", "ms", "dr", "prof", "sr", "jr", "st", "vs", "etc", "e.g", "i.e",
					"u.s", "u.k", "inc", "ltd", "co", "corp", "fig", "approx", "dept", "est",
					"jan", "feb", "mar", "apr", "jun", "jul", "aug", "sep", "sept", "oct", "nov", "dec"
				];
				each(word := words) {
					@abbreviations->Insert(word, BoolRef->New(true));
				};
			};
		}

		function : private : IsLetter(c : Char) ~ Bool {
			if(Char->IsLower(c) | Char->IsUpper(c)) {
				return true;
			};

			# any other character past ASCII that is not punctuation or space: accented and
			# non-Latin letters, including scripts without case
			code := c->As(Int);
			return code > 127 & <>IsUnicodePunctuation(code) & <>IsSpace(c);
		}

		function : private : IsWordChar(c : Char) ~ Bool {
			return Char->IsDigit(c) | IsLetter(c);
		}

		# a character that joins the two either side of it into one word
		function : private : IsJoiner(prev : Char, c : Char, next : Char) ~ Bool {
			if(c = '\'' | c->As(Int) = 0x2019) {
				return IsLetter(prev) & IsLetter(next);
			};

			if(c = '-') {
				return IsWordChar(prev) & IsWordChar(next);
			};

			if(c = '.' | c = ',') {
				return Char->IsDigit(prev) & Char->IsDigit(next);
			};

			return false;
		}

		function : private : IsUnicodePunctuation(code : Int) ~ Bool {
			return (code >= 0x00A1 & code <= 0x00BF) | code = 0x00D7 | code = 0x00F7 |
				(code >= 0x2000 & code <= 0x206F) | (code >= 0x20A0 & code <= 0x20CF) |
				(code >= 0x2190 & code <= 0x2BFF) | (code >= 0x3000 & code <= 0x303F) |
				(code >= 0xFF01 & code <= 0xFF0F) | (code >= 0xFF1A & code <= 0xFF20) |
				(code >= 0xFF3B & code <= 0xFF40) | (code >= 0xFF5B & code <= 0xFF65) |
				(code >= 0xFE30 & code <= 0xFE4F) | (code >= 0x1F000 & code <= 0x1FAFF);
		}

		function : private : IsSpace(c : Char) ~ Bool {
			code := c->As(Int);
			return code <= 32 | code = 0x00A0 | code = 0x1680 | (code >= 0x2000 & code <= 0x200A) |
				code = 0x2028 | code = 0x2029 | code = 0x202F | code = 0x205F | code = 0x3000;
		}

		function : private : IsTerminator(c : Char) ~ Bool {
			return c = '.' | c = '!' | c = '?' | c->As(Int) = 0x2026;
		}

		function : private : IsCloser(c : Char) ~ Bool {
			code := c->As(Int);
			return c = '"' | c = '\'' | c = ')' | c = ']' | c = '}' | code = 0x2019 | code = 0x201D | code = 0x00BB;
		}

		#~
		Generates character-level n-grams from text
		@param text input text
		@param n size of n-grams
		@return array of n-gram strings

```
trigrams := Tokenizer->CharNGrams("hello", 3);
each(g in trigrams) {
  g->PrintLine();
};
```
		~#
		function : CharNGrams(text : String, n : Int) ~ String[] {
			if(text = Nil | text->IsEmpty() | n <= 0 | n > text->Size()) {
				return String->New[0];
			};

			ngrams := Vector->New()<String>;
			text_length := text->Size();

			for(i := 0; i <= text_length - n; i += 1;) {
				ngram := text->SubString(i, n);
				ngrams->AddBack(ngram);
			};

			return ngrams->ToArray();
		}

		#~
		Generates word-level n-grams from tokenized text
		@param tokens array of word tokens
		@param n size of n-grams
		@return array of n-gram strings (words joined by spaces)

```
words := Tokenizer->WordTokenize("the quick brown fox");
bigrams := Tokenizer->WordNGrams(words, 2);
each(g in bigrams) {
  g->PrintLine();
};
```
		~#
		function : WordNGrams(tokens : String[], n : Int) ~ String[] {
			if(tokens = Nil | tokens->Size() = 0 | n <= 0 | n > tokens->Size()) {
				return String->New[0];
			};

			ngrams := Vector->New()<String>;
			tokens_length := tokens->Size();

			for(i := 0; i <= tokens_length - n; i += 1;) {
				ngram := "";
				for(j := 0; j < n; j += 1;) {
					if(j > 0) {
						ngram->Append(' ');
					};
					ngram->Append(tokens[i + j]);
				};
				ngrams->AddBack(ngram);
			};

			return ngrams->ToArray();
		}
	}

	#~
	Text preprocessing utilities for cleaning and normalizing text

```
text := "The Quick Brown FOX!";
lower := System.NLP.TextPreprocessor->Lowercase(text);
clean := System.NLP.TextPreprocessor->RemovePunctuation(text);
tokens := System.NLP.Tokenizer->WordTokenize(lower);
filtered := System.NLP.TextPreprocessor->RemoveStopwords(tokens);
stemmed := System.NLP.TextPreprocessor->StemAll(filtered);
```
	~#
	class TextPreprocessor {
		@stopwords : static : Hash<String, BoolRef>;

		#~
		Initializes common English stopwords
		~#
		function : Init() ~ Nil {
			if(@stopwords = Nil) {
				@stopwords := Hash->New()<String, BoolRef>;

				# Common English stopwords
				words := [
					"a", "about", "above", "after", "again", "against", "all", "am", "an", "and",
					"any", "are", "as", "at", "be", "because", "been", "before", "being", "below",
					"between", "both", "but", "by", "could", "did", "do", "does", "doing", "down",
					"during", "each", "few", "for", "from", "further", "had", "has", "have", "having",
					"he", "her", "here", "hers", "herself", "him", "himself", "his", "how", "i",
					"if", "in", "into", "is", "it", "its", "itself", "just", "me", "might", "more",
					"most", "must", "my", "myself", "no", "nor", "not", "now", "of", "off", "on",
					"once", "only", "or", "other", "our", "ours", "ourselves", "out", "over", "own",
					"same", "she", "should", "so", "some", "such", "than", "that", "the", "their",
					"theirs", "them", "themselves", "then", "there", "these", "they", "this", "those",
					"through", "to", "too", "under", "until", "up", "very", "was", "we", "were",
					"what", "when", "where", "which", "while", "who", "whom", "why", "will", "with",
					"would", "you", "your", "yours", "yourself", "yourselves"
				];

				each(word := words) {
					@stopwords->Insert(word, BoolRef->New(true));
				};
			};
		}

		#~
		Converts text to lowercase
		@param text input text
		@return lowercase text

```
lower := TextPreprocessor->Lowercase("Hello WORLD");
lower->PrintLine();
```
		~#
		function : Lowercase(text : String) ~ String {
			if(text = Nil) {
				return "";
			};

			return text->ToLower();
		}

		#~
		Removes common English stopwords from token array
		@param tokens array of word tokens
		@return filtered token array without stopwords

```
words := Tokenizer->WordTokenize("The cat sat on the mat");
filtered := TextPreprocessor->RemoveStopwords(words);
each(w in filtered) {
  w->PrintLine();
};
```
		~#
		function : RemoveStopwords(tokens : String[]) ~ String[] {
			Init();

			if(tokens = Nil | tokens->Size() = 0) {
				return String->New[0];
			};

			filtered := Vector->New()<String>;

			each(token := tokens) {
				lowercase_token := token->ToLower();
				if(<>@stopwords->Has(lowercase_token)) {
					filtered->AddBack(token);
				};
			};

			return filtered->ToArray();
		}

		#~
		Removes punctuation from text
		@param text input text
		@return text with punctuation removed

```
clean := TextPreprocessor->RemovePunctuation("Hello, world! How's it going?");
clean->PrintLine();
```
		~#
		function : RemovePunctuation(text : String) ~ String {
			if(text = Nil) {
				return "";
			};

			result := text->ReplaceAll(",", "")
				->ReplaceAll(".", "")
				->ReplaceAll("!", "")
				->ReplaceAll("?", "")
				->ReplaceAll(";", "")
				->ReplaceAll(":", "")
				->ReplaceAll("\"", "")
				->ReplaceAll("'", "")
				->ReplaceAll("(", "")
				->ReplaceAll(")", "")
				->ReplaceAll("[", "")
				->ReplaceAll("]", "")
				->ReplaceAll("{", "")
				->ReplaceAll("}", "")
				->ReplaceAll("-", "")
				->ReplaceAll("_", "");

			return result;
		}

		#~
		Porter stemmer: reduces an English word to its stem with the Porter (1980) algorithm, as
		Martin Porter's reference implementation applies it. Stems need not be words
		("happily" becomes "happili", "relational" becomes "relat"); what matters is that
		related forms meet ("connected", "connecting" and "connection" all become "connect").
		The word is lowercased; words of one or two letters, and words holding anything but
		the letters a-z, are returned lowercased and otherwise unchanged.
		@param word input word
		@return stemmed word

```
TextPreprocessor->Stem("running")->PrintLine();
TextPreprocessor->Stem("connection")->PrintLine();
```
		~#
		function : Stem(word : String) ~ String {
			if(word = Nil) {
				return word;
			};

			return PorterStemmer->New(word->ToLower())->Stem();
		}

		#~
		Applies stemming to all tokens in array
		@param tokens array of word tokens
		@return array of stemmed tokens

```
words := Tokenizer->WordTokenize("running quickly and happily");
stemmed := TextPreprocessor->StemAll(words);
each(s in stemmed) {
  s->PrintLine();
};
```
		~#
		function : StemAll(tokens : String[]) ~ String[] {
			if(tokens = Nil | tokens->Size() = 0) {
				return String->New[0];
			};

			stemmed := String->New[tokens->Size()];
			each(i : tokens->Size()) {
				stemmed[i] := Stem(tokens[i]);
			};

			return stemmed;
		}
	}

	#
	# The Porter (1980) algorithm, step for step as Martin Porter's reference C implementation
	# (porter.c): the word is held in @b[0..@k], and @j marks the end of the stem under test
	# after a successful Ends(). Including its two departures from the paper: step 2 maps
	# "bli" to "ble" (not "abli" to "able") and adds "logi" to "log".
	#
	class : private : PorterStemmer {
		@b : Char[];
		@k : Int;
		@j : Int;

		New(word : String) {
			@b := word->ToCharArray();
			@k := @b->Size() - 1;
			@j := 0;
		}

		method : public : Stem() ~ String {
			if(@k <= 1) {
				return String->New(@b);
			};

			each(i : @b) {
				if(@b[i] < 'a' | @b[i] > 'z') {
					return String->New(@b);
				};
			};

			Step1ab();
			if(@k > 0) {
				Step1c();
				Step2();
				Step3();
				Step4();
				Step5();
			};

			return String->New(@b, 0, @k + 1);
		}

		# is @b[i] a consonant? 'y' is one at the start or after a vowel
		method : IsCons(i : Int) ~ Bool {
			c := @b[i];
			if(c = 'a' | c = 'e' | c = 'i' | c = 'o' | c = 'u') {
				return false;
			};

			if(c = 'y') {
				return i = 0 ? true : <>IsCons(i - 1);
			};

			return true;
		}

		# the number of vowel-consonant sequences in @b[0..@j]: [C](VC)^m[V]
		method : Measure() ~ Int {
			n := 0;
			i := 0;

			while(i <= @j & IsCons(i)) {
				i += 1;
			};

			while(i <= @j) {
				while(i <= @j & <>IsCons(i)) {
					i += 1;
				};
				if(i > @j) {
					return n;
				};

				n += 1;
				while(i <= @j & IsCons(i)) {
					i += 1;
				};
			};

			return n;
		}

		# does @b[0..@j] hold a vowel?
		method : VowelInStem() ~ Bool {
			for(i := 0; i <= @j; i += 1;) {
				if(<>IsCons(i)) {
					return true;
				};
			};

			return false;
		}

		# do @b[i-1] and @b[i] hold the same consonant?
		method : DoubleCons(i : Int) ~ Bool {
			if(i < 1) {
				return false;
			};

			return @b[i] = @b[i - 1] & IsCons(i);
		}

		# consonant-vowel-consonant ending at i, the last not w, x or y: "hop", not "snow"
		method : Cvc(i : Int) ~ Bool {
			if(i < 2 | <>IsCons(i) | IsCons(i - 1) | <>IsCons(i - 2)) {
				return false;
			};

			c := @b[i];
			return c <> 'w' & c <> 'x' & c <> 'y';
		}

		# does @b[0..@k] end with s? if so, @j marks the stem before it
		method : Ends(s : String) ~ Bool {
			length := s->Size();
			if(length > @k + 1) {
				return false;
			};

			offset := @k - length + 1;
			each(i : length) {
				if(@b[offset + i] <> s->Get(i)) {
					return false;
				};
			};

			@j := @k - length;
			return true;
		}

		# replace @b[@j+1..@k] with s
		method : SetTo(s : String) ~ Nil {
			length := s->Size();
			if(@j + length + 1 > @b->Size()) {
				grown := Char->New[@j + length + 1];
				for(i := 0; i <= @j; i += 1;) {
					grown[i] := @b[i];
				};
				@b := grown;
			};

			each(i : length) {
				@b[@j + 1 + i] := s->Get(i);
			};
			@k := @j + length;
		}

		method : Replace(s : String) ~ Nil {
			if(Measure() > 0) {
				SetTo(s);
			};
		}

		# plurals and -ed or -ing: caresses -> caress, ponies -> poni, agreed -> agree,
		# plastered -> plaster, motoring -> motor, hopping -> hop, filing -> file
		method : Step1ab() ~ Nil {
			if(@b[@k] = 's') {
				if(Ends("sses")) {
					@k -= 2;
				}
				else if(Ends("ies")) {
					SetTo("i");
				}
				else if(@b[@k - 1] <> 's') {
					@k -= 1;
				};
			};

			if(Ends("eed")) {
				if(Measure() > 0) {
					@k -= 1;
				};
			}
			else if((Ends("ed") | Ends("ing")) & VowelInStem()) {
				@k := @j;
				if(Ends("at")) {
					SetTo("ate");
				}
				else if(Ends("bl")) {
					SetTo("ble");
				}
				else if(Ends("iz")) {
					SetTo("ize");
				}
				else if(DoubleCons(@k)) {
					c := @b[@k];
					if(c <> 'l' & c <> 's' & c <> 'z') {
						@k -= 1;
					};
				}
				else {
					@j := @k;
					if(Measure() = 1 & Cvc(@k)) {
						SetTo("e");
					};
				};
			};
		}

		# a final y after a vowel in the stem becomes i: happy -> happi, but sky stays
		method : Step1c() ~ Nil {
			if(Ends("y") & VowelInStem()) {
				@b[@k] := 'i';
			};
		}

		# double suffixes to single ones, keyed on the penultimate letter
		method : Step2() ~ Nil {
			if(@k < 1) {
				return;
			};

			select(@b[@k - 1]) {
				label 'a': {
					if(Ends("ational")) { Replace("ate"); }
					else if(Ends("tional")) { Replace("tion"); };
				}

				label 'c': {
					if(Ends("enci")) { Replace("ence"); }
					else if(Ends("anci")) { Replace("ance"); };
				}

				label 'e': {
					if(Ends("izer")) { Replace("ize"); };
				}

				label 'l': {
					if(Ends("bli")) { Replace("ble"); }
					else if(Ends("alli")) { Replace("al"); }
					else if(Ends("entli")) { Replace("ent"); }
					else if(Ends("eli")) { Replace("e"); }
					else if(Ends("ousli")) { Replace("ous"); };
				}

				label 'o': {
					if(Ends("ization")) { Replace("ize"); }
					else if(Ends("ation")) { Replace("ate"); }
					else if(Ends("ator")) { Replace("ate"); };
				}

				label 's': {
					if(Ends("alism")) { Replace("al"); }
					else if(Ends("iveness")) { Replace("ive"); }
					else if(Ends("fulness")) { Replace("ful"); }
					else if(Ends("ousness")) { Replace("ous"); };
				}

				label 't': {
					if(Ends("aliti")) { Replace("al"); }
					else if(Ends("iviti")) { Replace("ive"); }
					else if(Ends("biliti")) { Replace("ble"); };
				}

				label 'g': {
					if(Ends("logi")) { Replace("log"); };
				}
			};
		}

		# -ic-, -full, -ness and the like
		method : Step3() ~ Nil {
			select(@b[@k]) {
				label 'e': {
					if(Ends("icate")) { Replace("ic"); }
					else if(Ends("ative")) { Replace(""); }
					else if(Ends("alize")) { Replace("al"); };
				}

				label 'i': {
					if(Ends("iciti")) { Replace("ic"); };
				}

				label 'l': {
					if(Ends("ical")) { Replace("ic"); }
					else if(Ends("ful")) { Replace(""); };
				}

				label 's': {
					if(Ends("ness")) { Replace(""); };
				}
			};
		}

		# drops -ant, -ence and the like where the measure is above 1
		method : Step4() ~ Nil {
			if(@k < 1) {
				return;
			};

			found := false;
			select(@b[@k - 1]) {
				label 'a': {
					found := Ends("al");
				}

				label 'c': {
					found := Ends("ance") | Ends("ence");
				}

				label 'e': {
					found := Ends("er");
				}

				label 'i': {
					found := Ends("ic");
				}

				label 'l': {
					found := Ends("able") | Ends("ible");
				}

				label 'n': {
					found := Ends("ant") | Ends("ement") | Ends("ment") | Ends("ent");
				}

				label 'o': {
					if(Ends("ion") & @j >= 0) {
						found := @b[@j] = 's' | @b[@j] = 't';
					};
					if(<>found) {
						found := Ends("ou");
					};
				}

				label 's': {
					found := Ends("ism");
				}

				label 't': {
					found := Ends("ate") | Ends("iti");
				}

				label 'u': {
					found := Ends("ous");
				}

				label 'v': {
					found := Ends("ive");
				}

				label 'z': {
					found := Ends("ize");
				}
			};

			if(found & Measure() > 1) {
				@k := @j;
			};
		}

		# a final -e where the measure allows, and -ll to -l: probate -> probat, controll -> control
		method : Step5() ~ Nil {
			@j := @k;
			if(@b[@k] = 'e') {
				a := Measure();
				if(a > 1 | (a = 1 & <>Cvc(@k - 1))) {
					@k -= 1;
				};
			};

			# @j still marks the word as it was before a final 'e' went, as in porter.c
			if(@b[@k] = 'l' & DoubleCons(@k) & Measure() > 1) {
				@k -= 1;
			};
		}
	}

	#~
	Term Frequency-Inverse Document Frequency (TF-IDF) vectorizer for document analysis. By
	default IDF is smoothed as scikit-learn's is, ln((1 + N) / (1 + df)) + 1, and vectors are
	scaled to unit length, so the cosine similarity of two of them is their dot product.

```
documents := ["The cat sat on the mat", "The dog sat on the log", "Cats and dogs are pets"];
tfidf := System.NLP.TF_IDF->New(stem : true);
tfidf->Fit(documents);

a := tfidf->Transform("The cat and the dog");
b := tfidf->Transform("cats and dogs");
System.NLP.TextSimilarity->CosineSimilarity(a, b)->PrintLine();
```
	~#
	class TF_IDF {
		@vocabulary : Hash<String, IntRef>;
		@idf : Float[];
		@document_count : Int;
		@smooth_idf : Bool;
		@l2_normalize : Bool;
		@remove_stopwords : Bool;
		@stem : Bool;

		#~
		Constructor
		@param smooth_idf smooth IDF as ln((1 + N) / (1 + df)) + 1, so a word in every document still weighs 1; false gives the raw ln(N / df)
		@param l2_normalize scale each vector to unit length
		@param remove_stopwords drop common English stopwords before counting
		@param stem count words by their Porter stem, so "cat" and "cats" share a column
		~#
		New(smooth_idf : Bool := true, l2_normalize : Bool := true, remove_stopwords : Bool := false, stem : Bool := false) {
			@vocabulary := Hash->New()<String, IntRef>;
			@idf := Float->New[0];
			@document_count := 0;
			@smooth_idf := smooth_idf;
			@l2_normalize := l2_normalize;
			@remove_stopwords := remove_stopwords;
			@stem := stem;
		}

		#~
		Fits the TF-IDF model on a corpus of documents, replacing any earlier fit
		@param documents array of document strings

```
docs := ["the cat sat on the mat", "the dog ran in the park", "cats and dogs are pets"];
tfidf := TF_IDF->New();
tfidf->Fit(docs);
"Vocabulary size: {$tfidf->GetVocabularySize()}"->PrintLine();
```
		~#
		method : public : Fit(documents : String[]) ~ Nil {
			# each Fit starts from nothing: a refit must not keep the last corpus's words
			@vocabulary := Hash->New()<String, IntRef>;
			@idf := Float->New[0];
			@document_count := 0;

			if(documents = Nil | documents->Size() = 0) {
				return;
			};

			@document_count := documents->Size();

			# vocabulary in first-seen order, and the number of documents holding each term
			doc_freq := Hash->New()<String, IntRef>;
			each(doc := documents) {
				seen := Hash->New()<String, BoolRef>;
				terms := Terms(doc);
				each(term := terms) {
					if(<>@vocabulary->Has(term)) {
						@vocabulary->Insert(term, IntRef->New(@vocabulary->Size()));
					};

					if(<>seen->Has(term)) {
						seen->Insert(term, BoolRef->New(true));
						count := doc_freq->Find(term);
						if(count <> Nil) {
							count->Set(count->Get() + 1);
						}
						else {
							doc_freq->Insert(term, IntRef->New(1));
						};
					};
				};
			};

			n := @document_count->As(Float);
			@idf := Float->New[@vocabulary->Size()];
			keys := @vocabulary->GetKeys()<String>;
			each(key := keys) {
				df := doc_freq->Find(key)->Get()->As(Float);
				if(@smooth_idf) {
					@idf[@vocabulary->Find(key)->Get()] := Float->Log((1.0 + n) / (1.0 + df)) + 1.0;
				}
				else {
					@idf[@vocabulary->Find(key)->Get()] := Float->Log(n / df);
				};
			};
		}

		#~
		Transforms a document into a TF-IDF vector, one entry per vocabulary word; words the fit
		did not see are ignored
		@param document input document string
		@return TF-IDF vector as float array (unit length unless l2_normalize is false, or all zero)

```
vec := tfidf->Transform("the cat chased the dog");
"Vector length: {$vec->Size()}"->PrintLine();
```
		~#
		method : public : Transform(document : String) ~ Float[] {
			vocab_size := @vocabulary->Size();
			tfidf := Float->New[vocab_size];
			if(vocab_size = 0 | document = Nil) {
				return tfidf;
			};

			terms := Terms(document);
			if(terms->Size() = 0) {
				return tfidf;
			};

			# term frequency, as a share of the document's terms
			share := 1.0 / terms->Size()->As(Float);
			each(term := terms) {
				idx := @vocabulary->Find(term);
				if(idx <> Nil) {
					tfidf[idx->Get()] += share;
				};
			};

			norm := 0.0;
			each(i : vocab_size) {
				tfidf[i] *= @idf[i];
				norm += tfidf[i] * tfidf[i];
			};

			if(@l2_normalize & norm > 0.0) {
				norm := Float->Sqrt(norm);
				each(i : vocab_size) {
					tfidf[i] /= norm;
				};
			};

			return tfidf;
		}

		# a document's terms: lowercased words, optionally without stopwords and stemmed
		method : Terms(document : String) ~ String[] {
			tokens := Tokenizer->WordTokenize(document);
			if(@remove_stopwords) {
				tokens := TextPreprocessor->RemoveStopwords(tokens);
			};

			terms := String->New[tokens->Size()];
			each(i : tokens) {
				terms[i] := @stem ? TextPreprocessor->Stem(tokens[i]) : tokens[i]->ToLower();
			};

			return terms;
		}

		#~
		Gets the vocabulary (word to index mapping)
		@return vocabulary hash map

```
vocab := tfidf->GetVocabulary();
keys := vocab->GetKeys()<String>;
each(k in keys) {
  k->PrintLine();
};
```
		~#
		method : public : GetVocabulary() ~ Hash<String, IntRef> {
			return @vocabulary;
		}

		#~
		Gets the size of the vocabulary
		@return vocabulary size
		~#
		method : public : GetVocabularySize() ~ Int {
			return @vocabulary->Size();
		}

		#~
		Gets the inverse document frequency of each vocabulary word, indexed as the vocabulary is
		@return a copy of the IDF vector

```
idf := tfidf->GetIdf();
idx := tfidf->GetVocabulary()->Find("cat")->Get();
"IDF of cat: {$(idf[idx])}"->PrintLine();
```
		~#
		method : public : GetIdf() ~ Float[] {
			copy := Float->New[@idf->Size()];
			each(i : @idf) {
				copy[i] := @idf[i];
			};

			return copy;
		}
	}

	#~
	Text similarity metrics for comparing documents and strings

```
vec1 := [1.0, 2.0, 3.0];
vec2 := [2.0, 4.0, 6.0];
similarity := System.NLP.TextSimilarity->CosineSimilarity(vec1, vec2);

tokens1 := ["the", "cat", "sat"];
tokens2 := ["the", "dog", "sat"];
jaccard := System.NLP.TextSimilarity->JaccardSimilarity(tokens1, tokens2);

distance := System.NLP.TextSimilarity->LevenshteinDistance("kitten", "sitting");
```
	~#
	class TextSimilarity {
		#~
		Calculates cosine similarity between two vectors
		@param vec1 first vector
		@param vec2 second vector
		@return cosine similarity (-1.0 to 1.0; 0.0 to 1.0 for non-negative vectors such as TF-IDF)

```
v1 := [1.0, 0.0, 1.0];
v2 := [1.0, 1.0, 0.0];
sim := TextSimilarity->CosineSimilarity(v1, v2);
"Similarity: {$sim}"->PrintLine();
```
		~#
		function : CosineSimilarity(vec1 : Float[], vec2 : Float[]) ~ Float {
			if(vec1 = Nil | vec2 = Nil | vec1->Size() <> vec2->Size()) {
				return 0.0;
			};

			dot_product := 0.0;
			norm1 := 0.0;
			norm2 := 0.0;

			each(i : vec1->Size()) {
				dot_product += vec1[i] * vec2[i];
				norm1 += vec1[i] * vec1[i];
				norm2 += vec2[i] * vec2[i];
			};

			if(norm1 = 0.0 | norm2 = 0.0) {
				return 0.0;
			};

			return dot_product / (Float->Sqrt(norm1) * Float->Sqrt(norm2));
		}

		#~
		Calculates Jaccard similarity between two sets of tokens
		@param tokens1 first token array
		@param tokens2 second token array
		@return Jaccard similarity (0.0 to 1.0); two empty sets are identical, 1.0

```
t1 := ["cat", "sat", "mat"];
t2 := ["cat", "sat", "log"];
jaccard := TextSimilarity->JaccardSimilarity(t1, t2);
"Jaccard: {$jaccard}"->PrintLine();
```
		~#
		function : JaccardSimilarity(tokens1 : String[], tokens2 : String[]) ~ Float {
			if(tokens1 = Nil) {
				tokens1 := String->New[0];
			};

			if(tokens2 = Nil) {
				tokens2 := String->New[0];
			};

			if(tokens1->Size() = 0 & tokens2->Size() = 0) {
				return 1.0;
			};

			if(tokens1->Size() = 0 | tokens2->Size() = 0) {
				return 0.0;
			};

			# Create sets
			set1 := Hash->New()<String, BoolRef>;
			each(token := tokens1) {
				set1->Insert(token->ToLower(), BoolRef->New(true));
			};

			set2 := Hash->New()<String, BoolRef>;
			each(token := tokens2) {
				set2->Insert(token->ToLower(), BoolRef->New(true));
			};

			# Calculate intersection
			intersection := 0;
			keys1 := set1->GetKeys()<String>;
			each(key := keys1) {
				if(set2->Has(key)) {
					intersection += 1;
				};
			};

			# Calculate union
			union := set1->Size() + set2->Size() - intersection;

			if(union = 0) {
				return 0.0;
			};

			return intersection->As(Float) / union->As(Float);
		}

		#~
		Calculates Levenshtein distance (edit distance) between two strings
		@param str1 first string
		@param str2 second string
		@return edit distance (number of edits needed)

```
dist := TextSimilarity->LevenshteinDistance("kitten", "sitting");
"Edit distance: {$dist}"->PrintLine();
```
		~#
		function : LevenshteinDistance(str1 : String, str2 : String) ~ Int {
			if(str1 = Nil) {
				str1 := "";
			};

			if(str2 = Nil) {
				str2 := "";
			};

			len1 := str1->Size();
			len2 := str2->Size();

			if(len1 = 0) {
				return len2;
			};

			if(len2 = 0) {
				return len1;
			};

			# Create DP matrix
			dp := Int->New[len1 + 1, len2 + 1];

			# Initialize first row and column
			rows := len1 + 1;
			each(i : rows) {
				dp[i, 0] := i;
			};

			cols := len2 + 1;
			each(j : cols) {
				dp[0, j] := j;
			};

			# Fill DP matrix
			for(i := 1; i <= len1; i += 1;) {
				for(j := 1; j <= len2; j += 1;) {
					cost := str1->Get(i - 1) = str2->Get(j - 1) ? 0 : 1;

					min_val := dp[i - 1, j] + 1; # Deletion

					temp := dp[i, j - 1] + 1; # Insertion
					if(temp < min_val) {
						min_val := temp;
					};

					temp := dp[i - 1, j - 1] + cost; # Substitution
					if(temp < min_val) {
						min_val := temp;
					};

					dp[i, j] := min_val;
				};
			};

			return dp[len1, len2];
		}

		#~
		Calculates normalized edit distance (0.0 = identical, 1.0 = completely different)
		@param str1 first string
		@param str2 second string
		@return normalized distance (0.0 to 1.0)

```
nd := TextSimilarity->NormalizedEditDistance("kitten", "sitting");
"Normalized distance: {$nd}"->PrintLine();
```
		~#
		function : NormalizedEditDistance(str1 : String, str2 : String) ~ Float {
			if(str1 = Nil) {
				str1 := "";
			};

			if(str2 = Nil) {
				str2 := "";
			};

			distance := LevenshteinDistance(str1, str2);
			max_len := str1->Size() > str2->Size() ? str1->Size() : str2->Size();

			if(max_len = 0) {
				return 0.0;
			};

			return distance->As(Float) / max_len->As(Float);
		}
	}

	#~
	Rule-based sentiment analysis in the manner of VADER (Hutto and Gilbert, 2014), with a
	built-in English lexicon of valences on a -4..+4 scale, part of it VADER's own values (MIT
	licence). Negators ("not", "never", "don't") within
	three words flip and damp a word's valence, boosters ("very", "extremely") and dampeners
	("slightly", "kind of") scale it, a word in capitals in mixed-case text and each '!' add
	emphasis, and "but" shifts weight to the clause after it. Unknown inflections fall back to
	their base form ("loved" finds "love", "terribly" finds "terrible").

```
text := "The plot was not bad at all, but the acting was really terrible!";
score := System.NLP.SentimentAnalyzer->AnalyzeCompound(text);
label := System.NLP.SentimentAnalyzer->Classify(text);
result := System.NLP.SentimentAnalyzer->AnalyzeDetailed(text);
result->ToString()->PrintLine();
```
	~#
	class SentimentAnalyzer {
		@lexicon : static : Hash<String, FloatRef>;
		@boosters : static : Hash<String, FloatRef>;
		@negators : static : Hash<String, BoolRef>;

		#~
		Loads the lexicon, boosters and negators; called by every other function, so calling it
		yourself is never necessary
		~#
		function : Init() ~ Nil {
			if(@lexicon = Nil) {
				@lexicon := Hash->New()<String, FloatRef>;
				@boosters := Hash->New()<String, FloatRef>;
				@negators := Hash->New()<String, BoolRef>;

				# word:valence, on VADER's -4..+4 scale; about 190 values are VADER's
				# vader_lexicon.txt ones (MIT License, see the file header)
				lines := [
					"good:1.9 great:3.1 excellent:2.7 amazing:2.8 wonderful:2.7 fantastic:2.6 awesome:3.1 love:3.2 lovely:2.8 best:3.2",
