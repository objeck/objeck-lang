					"gifted:2.0 glowing:1.7 gracious:2.0 harmony:1.9 healthy:1.7 heroic:2.1 honor:2.0 humane:1.7 humor:1.7 humour:1.7",
					"ingenious:2.2 intriguing:1.7 irresistible:2.1 jolly:2.0 lovable:2.4 loyal:2.0 luminous:1.9 meaningful:1.8 mesmerizing:2.2 miracle:2.3",
					"neat:1.5 noble:1.9 passionate:1.9 perfection:2.9 playful:1.7 poignant:1.4 poetic:1.5 popular:1.4 praise:2.3 precious:2.2",
					"profound:1.7 promising:1.6 pure:1.4 quality:1.0 refined:1.4 relief:1.6 resonant:1.4 respect:1.9 robust:1.3 romantic:1.6",
					"sensational:2.4 skilful:1.8 skillful:1.8 sleek:1.4 smooth:1.1 spirited:1.6 stellar:2.6 striking:1.6 strong:1.0 stylish:1.7",
					"suspenseful:1.5 talented:2.2 tasteful:1.6 timeless:2.0 treasure:2.2 triumphant:2.5 trust:2.0 unforgettable:2.3 unique:1.4 upbeat:1.7",
					"vibrant:2.0 victorious:2.5 virtuoso:2.2 warmth:1.8 welcome:2.0 whimsical:1.5 winning:2.2 wit:1.6 wonder:1.6 wondrous:2.4",
					"worthwhile:2.0 likable:1.9 likeable:1.9 liked:1.8 likes:1.4 entertain:1.6 surprising:0.9 delight:2.6 pleasing:2.0 finest:2.6",
					"greatest:3.0 aggravating:-1.9 aimless:-1.4 annoyance:-1.8 anger:-2.4 appalled:-2.4 arrogant:-2.0 ashamed:-2.1 banal:-1.6 bitter:-1.7",
					"blah:-1.0 brutal:-2.0 bumbling:-1.5 burden:-1.7 careless:-1.6 chaotic:-1.6 cheap:-1.2 cheated:-2.2 childish:-1.4 clueless:-1.6",
					"cold:-0.8 confusion:-1.4 contempt:-2.3 crash:-1.7 crude:-1.5 cynical:-1.4 damn:-1.6 defeat:-1.8 deficient:-1.6 desperate:-1.7",
					"despair:-2.6 destroy:-2.3 destroyed:-2.4 dirty:-1.8 discomfort:-1.6 disgrace:-2.4 dishonest:-2.4 distasteful:-1.9 distracting:-1.2 disturbing:-1.8",
					"doom:-2.1 drab:-1.5 drag:-1.1 drivel:-2.0 dud:-1.8 egregious:-2.0 empty:-1.0 excessive:-1.1 exhausting:-1.6 faulty:-1.8",
					"feeble:-1.8 filthy:-2.0 flat:-0.9 foolish:-1.7 frustration:-2.1 futile:-1.9 ghastly:-2.4 gimmicky:-1.3 grating:-1.6 greedy:-1.9",
					"grief:-2.4 grotesque:-2.0 haphazard:-1.3 heavy-handed:-1.5 horrendous:-2.8 idiotic:-2.4 ignorant:-1.9 illogical:-1.4 incomprehensible:-1.7 inconsistent:-1.2",
					"insipid:-1.8 interminable:-1.9 irrelevant:-1.1 jarring:-1.2 junk:-1.6 lackluster:-1.6 lacklustre:-1.6 limp:-1.3 listless:-1.5 lumbering:-1.2",
					"manipulative:-1.7 meandering:-1.3 monotonous:-1.6 muddled:-1.5 murky:-1.0 naive:-0.9 needless:-1.2 nightmare:-2.3 obnoxious:-2.2 overblown:-1.4",
					"overdone:-1.2 puerile:-1.7 repetitive:-1.4 repellent:-2.0 repugnant:-2.4 repulsive:-2.4 sappy:-1.2 shoddy:-1.9 sickening:-2.3 simplistic:-1.2",
					"snooze:-1.3 soulless:-1.9 squandered:-1.7 strained:-1.1 stupidity:-2.2 tacky:-1.5 tasteless:-1.8 tepid:-1.3 thin:-0.8 trite:-1.6",
					"turgid:-1.5 uncomfortable:-1.4 underwhelming:-1.8 uneventful:-1.0 unimaginative:-1.6 uninteresting:-1.7 unlikable:-1.7 unsatisfying:-1.8 vapid:-1.7 vile:-2.7",
					"wearisome:-1.7 weird:-0.7 woeful:-2.2 wooden:-1.2 wretched:-2.4 cringe:-1.8 cringeworthy:-2.0 headache:-1.4 joyless:-1.9 humorless:-1.7",
					"charmless:-1.8 witless:-1.8 pedestrian:-1.0 misfire:-1.6 mistake:-1.7 fault:-1.5 hatred:-2.6 sorrow:-2.1 suffer:-2.0 suffering:-2.2",
					"tragedy:-2.0 victim:-1.8 weakness:-1.6"
				];

				each(line := lines) {
					entries := line->Split(" ");
					each(entry := entries) {
						colon := entry->Find(':');
						if(colon > 0) {
							valence := entry->SubString(colon + 1, entry->Size() - colon - 1)->ToFloat();
							@lexicon->Insert(entry->SubString(0, colon), FloatRef->New(valence));
						};
					};
				};

				# words that scale the next sentiment word up or down
				up := [
					"absolutely", "amazingly", "awfully", "completely", "considerably", "decidedly", "deeply",
					"enormously", "entirely", "especially", "exceptionally", "extremely", "fabulously", "greatly",
					"highly", "hugely", "incredibly", "intensely", "particularly", "purely", "quite", "really",
					"remarkably", "so", "substantially", "thoroughly", "totally", "tremendously", "truly",
					"unbelievably", "utterly", "very", "super", "most", "more", "too", "such", "insanely"
				];
				each(word := up) {
					@boosters->Insert(word, FloatRef->New(0.293));
				};

				down := [
					"almost", "barely", "hardly", "scarcely", "slightly", "somewhat", "kinda", "sorta",
					"kind_of", "sort_of", "marginally", "occasionally", "partly", "less", "little", "fairly",
					"rather", "mildly", "moderately", "nearly"
				];
				each(word := down) {
					@boosters->Insert(word, FloatRef->New(-0.293));
				};

				negators := [
					"not", "no", "never", "none", "nobody", "nothing", "neither", "nor", "nowhere", "without",
					"cannot", "rarely", "seldom", "dont", "doesnt", "didnt", "isnt", "wasnt", "arent", "werent",
					"wont", "cant", "couldnt", "shouldnt", "wouldnt", "aint", "havent", "hasnt", "hadnt",
					"neednt", "mustnt", "nope"
				];
				each(word := negators) {
					@negators->Insert(word, BoolRef->New(true));
				};
			};
		}

		#~
		Adds a word to the lexicon or changes its valence, for a domain's own vocabulary
		@param word the word (matched case-insensitively)
		@param valence its sentiment, on the -4.0 to 4.0 scale the built-in words use

```
SentimentAnalyzer->AddWord("bullish", 2.0);
SentimentAnalyzer->AddWord("bearish", -2.0);
SentimentAnalyzer->Classify("Analysts are bullish on the stock")->PrintLine();
```
		~#
		function : AddWord(word : String, valence : Float) ~ Nil {
			Init();
			if(word <> Nil & <>word->IsEmpty()) {
				@lexicon->Insert(word->ToLower(), FloatRef->New(valence));
			};
		}

		#~
		Adds the words in a lexicon file, one per line: the word, a tab, its valence on the
		-4.0 to 4.0 scale, and anything after a further tab ignored. That is the layout of
		VADER's own vader_lexicon.txt (MIT licence), so a program can use VADER's full lexicon
		in place of, or on top of, the built-in one. Lines that are empty or start with '#' are
		skipped; a listed word replaces the built-in entry.
		@param path lexicon file
		@return number of words added, or -1 if the file could not be read

```
added := SentimentAnalyzer->LoadLexicon("vader_lexicon.txt");
"Loaded {$added} words"->PrintLine();
```
		~#
		function : LoadLexicon(path : String) ~ Int {
			return LoadLexiconFile(path);
		}

		#~
		Removes every word from the lexicon, built-in ones included, so that LoadLexicon or
		AddWord can supply a lexicon of the program's own. Boosters and negators are kept.

```
SentimentAnalyzer->ClearLexicon();
SentimentAnalyzer->LoadLexicon("vader_lexicon.txt");
```
		~#
		function : ClearLexicon() ~ Nil {
			Init();
			@lexicon := Hash->New()<String, FloatRef>;
		}

		function : private : LoadLexiconFile(path : String) ~ Int {
			Init();
			if(path = Nil) {
				return -1;
			};

			reader := System.IO.Filesystem.FileReader->New(path);
			if(<>reader->IsOpen()) {
				return -1;
			};

			added := 0;
			line := reader->ReadLine();
			while(line <> Nil) {
				line := line->Trim();
				if(<>line->IsEmpty() & line->Get(0) <> '#') {
					fields := line->Split('\t');
					if(fields->Size() >= 2) {
						word := fields[0]->Trim()->ToLower();
						if(<>word->IsEmpty()) {
							@lexicon->Insert(word, FloatRef->New(fields[1]->Trim()->ToFloat()));
							added += 1;
						};
					};
				};
				line := reader->ReadLine();
			};
			reader->Close();

			return added;
		}

		#~
		Gets a word's valence from the lexicon, trying its base form when the word itself is not
		listed ("loved" finds "love")
		@param word the word
		@return its valence, or 0.0 when neither it nor its base form is listed

```
SentimentAnalyzer->GetValence("terribly")->PrintLine();
```
		~#
		function : GetValence(word : String) ~ Float {
			Init();
			if(word = Nil) {
				return 0.0;
			};

			found := Lookup(word->ToLower());
			if(found = Nil) {
				return 0.0;
			};

			return found->Get();
		}

		#~
		Analyzes sentiment of text and returns the summed valence of its words, rounded
		@param text input text to analyze
		@return summed valence, rounded to the nearest integer: above 0 leans positive, below 0 negative. AnalyzeCompound gives the normalized score Classify uses.

```
score := SentimentAnalyzer->Analyze("This product is absolutely wonderful!");
"Score: {$score}"->PrintLine();
```
		~#
		function : Analyze(text : String) ~ Int {
			scores := Score(text);
			return Round(scores[0]);
		}

		#~
		Analyzes sentiment of text and returns VADER's normalized compound score
		@param text input text to analyze
		@return compound score from -1.0 (most negative) to 1.0 (most positive)

```
compound := SentimentAnalyzer->AnalyzeCompound("Not bad at all, actually.");
"Compound: {$compound}"->PrintLine();
```
		~#
		function : AnalyzeCompound(text : String) ~ Float {
			scores := Score(text);
			return scores[1];
		}

		#~
		Classifies text sentiment as positive (compound score of 0.05 or more), negative (-0.05 or
		less) or neutral
		@param text input text to classify
		@return sentiment label: "positive", "negative", or "neutral"

```
label := SentimentAnalyzer->Classify("This is not good.");
label->PrintLine();
```
		~#
		function : Classify(text : String) ~ String {
			scores := Score(text);
			return Label(scores[1]);
		}

		#~
		Gets detailed sentiment analysis with scores
		@param text input text to analyze
		@return sentiment result with the rounded score, the compound score and the classification

```
result := SentimentAnalyzer->AnalyzeDetailed("Amazing and wonderful experience!");
result->ToString()->PrintLine();
```
		~#
		function : AnalyzeDetailed(text : String) ~ SentimentResult {
			scores := Score(text);
			return SentimentResult->New(Round(scores[0]), scores[1], Label(scores[1]));
		}

		function : private : Label(compound : Float) ~ String {
			if(compound >= 0.05) {
				return "positive";
			}
			else if(compound <= -0.05) {
				return "negative";
			};

			return "neutral";
		}

		function : private : Round(value : Float) ~ Int {
			if(value >= 0.0) {
				return (value + 0.5)->As(Int);
			};

			return (value - 0.5)->As(Int);
		}

		# [summed valence, compound]
		function : private : Score(text : String) ~ Float[] {
			Init();

			scores := Float->New[2];
			if(text = Nil | text->IsEmpty()) {
				return scores;
			};

			tokens := Tokenizer->WordTokenize(text);
			n := tokens->Size();
			if(n = 0) {
				return scores;
			};

			# lowercase, with "kind of" and "sort of" joined into one dampener
			lowered := String->New[n];
			each(i : n) {
				lowered[i] := tokens[i]->ToLower();
			};
			for(i := 0; i + 1 < n; i += 1;) {
				if((lowered[i]->Equals("kind") | lowered[i]->Equals("sort")) & lowered[i + 1]->Equals("of")) {
					lowered[i] := lowered[i]->Equals("kind") ? "kind_of" : "sort_of";
					lowered[i + 1] := "";
				};
			};

			# capitals are emphasis only when the text is not all capitals
			capitals := 0;
			each(i : n) {
				if(IsAllCaps(tokens[i])) {
					capitals += 1;
				};
			};
			cap_diff := capitals > 0 & capitals < n;

			sentiments := Float->New[n];
			each(i : n) {
				word := lowered[i];
				found : FloatRef;
				if(<>@boosters->Has(word) & <>word->IsEmpty()) {
					found := Lookup(word);
				};

				if(found <> Nil) {
					valence := found->Get();
					if(cap_diff & IsAllCaps(tokens[i])) {
						valence += valence > 0.0 ? 0.733 : -0.733;
					};

					# the three words before: boosters, decaying with distance, and negators
					for(distance := 1; distance <= 3; distance += 1;) {
						p := i - distance;
						if(p >= 0) {
							prev := lowered[p];
							if(Lookup(prev) = Nil) {
								boost := BoostOf(prev, tokens[p], valence, cap_diff);
								if(distance = 2) {
									boost *= 0.95;
								}
								else if(distance = 3) {
									boost *= 0.9;
								};
								valence += boost;

								if(IsNegator(prev)) {
									valence *= -0.74;
								};
							};
						};
					};

					sentiments[i] := valence;
				};
			};

			# "but": the clause before it counts half, the one after it half again as much
			but_at := -1;
			each(i : n) {
				if(but_at < 0 & lowered[i]->Equals("but")) {
					but_at := i;
				};
			};
			if(but_at >= 0) {
				each(i : n) {
					if(i < but_at) {
						sentiments[i] *= 0.5;
					}
					else if(i > but_at) {
						sentiments[i] *= 1.5;
					};
				};
			};

			sum := 0.0;
			each(i : n) {
				sum += sentiments[i];
			};

			# '!' adds emphasis, up to four; two or more '?' add a little
			exclamations := 0;
			questions := 0;
			text_size := text->Size();
			each(i : text_size) {
				c := text->Get(i);
				if(c = '!') {
					exclamations += 1;
				}
				else if(c = '?') {
					questions += 1;
				};
			};
			if(exclamations > 4) {
				exclamations := 4;
			};
			emphasis := exclamations->As(Float) * 0.292;
			if(questions > 1) {
				emphasis += questions <= 3 ? questions->As(Float) * 0.18 : 0.96;
			};

			if(sum > 0.0) {
				sum += emphasis;
			}
			else if(sum < 0.0) {
				sum -= emphasis;
			};

			compound := sum / Float->Sqrt(sum * sum + 15.0);
			if(compound > 1.0) {
				compound := 1.0;
			}
			else if(compound < -1.0) {
				compound := -1.0;
			};

			scores[0] := sum;
			scores[1] := compound;
			return scores;
		}

		# a booster's push in the direction of the sentiment it precedes
		function : private : BoostOf(word : String, original : String, valence : Float, cap_diff : Bool) ~ Float {
			scalar := @boosters->Find(word);
			if(scalar = Nil) {
				return 0.0;
			};

			boost := scalar->Get();
			if(valence < 0.0) {
				boost *= -1.0;
			};

			if(cap_diff & IsAllCaps(original)) {
				boost += valence > 0.0 ? 0.733 : -0.733;
			};

			return boost;
		}

		function : private : IsNegator(word : String) ~ Bool {
			if(@negators->Has(word)) {
				return true;
			};

			return word->EndsWith("n't") | word->EndsWith("n’t");
		}

		# all capitals, at least two letters, no lower case: "GREAT", not "I"
		function : private : IsAllCaps(token : String) ~ Bool {
			letters := 0;
			size := token->Size();
			each(i : size) {
				c := token->Get(i);
				if(Char->IsLower(c)) {
					return false;
				};
				if(Char->IsUpper(c)) {
					letters += 1;
				};
			};

			return letters > 1;
		}

		# the word itself, else its base form with a regular inflection removed
		function : private : Lookup(word : String) ~ FloatRef {
			found := @lexicon->Find(word);
			if(found <> Nil) {
				return found;
			};

			n := word->Size();
			if(n < 4) {
				return Nil;
			};

			forms := Vector->New()<String>;
			if(word->EndsWith("ies") | word->EndsWith("ied")) {
				forms->AddBack(word->SubString(0, n - 3) + "y");
			};

			if(word->EndsWith("ily")) {
				forms->AddBack(word->SubString(0, n - 3) + "y");
			}
			else if(word->EndsWith("ably") | word->EndsWith("ibly")) {
				forms->AddBack(word->SubString(0, n - 1) + "e");
			}
			else if(word->EndsWith("ly")) {
				forms->AddBack(word->SubString(0, n - 2));
			};

			if(word->EndsWith("ing") & n > 5) {
				AddBaseForms(word->SubString(0, n - 3), forms);
			};

			if(word->EndsWith("ed") & n > 4) {
				AddBaseForms(word->SubString(0, n - 2), forms);
			};

			if(word->EndsWith("es")) {
				forms->AddBack(word->SubString(0, n - 2));
			};

			if(word->EndsWith("s") & <>word->EndsWith("ss")) {
				forms->AddBack(word->SubString(0, n - 1));
			};

			each(form := forms) {
				found := @lexicon->Find(form);
				if(found <> Nil) {
					return found;
				};
			};

			return Nil;
		}

		# "lov" -> lov, love; "stopp" -> stopp, stoppe, stop
		function : private : AddBaseForms(base : String, forms : Vector<String>) ~ Nil {
			forms->AddBack(base);
			forms->AddBack(base + "e");

			size := base->Size();
			if(size > 2 & base->Get(size - 1) = base->Get(size - 2)) {
				forms->AddBack(base->SubString(0, size - 1));
			};
		}
	}

	#~
	Sentiment analysis result

```
result := System.NLP.SentimentAnalyzer->AnalyzeDetailed("Great product!");
score := result->GetScore();
compound := result->GetCompound();
label := result->GetClassification();
```
	~#
	class SentimentResult {
		@score : Int;
		@compound : Float;
		@classification : String;

		#~
		Constructor; the compound score is derived from the integer score
		@param score sentiment score
		@param classification sentiment label
		~#
		New(score : Int, classification : String) {
			@score := score;
			@compound := score->As(Float) / Float->Sqrt((score * score)->As(Float) + 15.0);
			@classification := classification;
		}

		#~
		Constructor
		@param score sentiment score, the rounded sum of valences
		@param compound normalized score from -1.0 to 1.0
		@param classification sentiment label
		~#
		New(score : Int, compound : Float, classification : String) {
			@score := score;
			@compound := compound;
			@classification := classification;
		}

		#~
		Gets the sentiment score
		@return sentiment score, the rounded sum of valences

```
result := SentimentAnalyzer->AnalyzeDetailed("Great job!");
"Score: {$result->GetScore()}"->PrintLine();
```
		~#
		method : public : GetScore() ~ Int {
			return @score;
		}

		#~
		Gets the normalized compound score
		@return compound score from -1.0 to 1.0

```
result := SentimentAnalyzer->AnalyzeDetailed("Not bad at all.");
"Compound: {$result->GetCompound()}"->PrintLine();
```
		~#
		method : public : GetCompound() ~ Float {
			return @compound;
		}

		#~
		Gets the classification label
		@return classification (positive, negative, or neutral)

```
