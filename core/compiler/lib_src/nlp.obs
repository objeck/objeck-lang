result->GetClassification()->PrintLine();
```
		~#
		method : public : GetClassification() ~ String {
			return @classification;
		}

		#~
		String representation
		@return formatted result
		~#
		method : public : ToString() ~ String {
			return "Sentiment: {$@classification}, Score: {$@score}, Compound: {$@compound}";
		}
	}

	#~
	One text encoded for a BERT-family model: the token ids, the attention mask and the token
	type (segment) ids, all the same length, ready to become a model's input_ids,
	attention_mask and token_type_ids. Produced by WordPieceTokenizer and ApiSequenceTokenizer.

```
tokenizer := WordPieceTokenizer->New("vocab.txt");
encoding := tokenizer->Encode("unaffable", 8);
encoding->GetTokens()->Size()->PrintLine();   # 8: [CLS] un ##aff ##able [SEP] [PAD] [PAD] [PAD]
encoding->GetLength()->PrintLine();           # 5: the tokens before the padding
```
	~#
	class TokenEncoding {
		@ids : Int[];
		@attention_mask : Int[];
		@token_type_ids : Int[];
		@tokens : String[];
		@length : Int;
		@truncated : Bool;
		@offsets : Int[];

		#~
		Constructor, for a tokenizer of the program's own.
		@param ids token ids, padding included
		@param attention_mask 1 for a real token, 0 for padding
		@param token_type_ids segment of each token, 0 or 1
		@param tokens the token strings, one per id
		@param length tokens before the padding, special tokens included
		@param truncated whether text was dropped to fit
		~#
		New(ids : Int[], attention_mask : Int[], token_type_ids : Int[], tokens : String[], length : Int, truncated : Bool) {
			@ids := ids;
			@attention_mask := attention_mask;
			@token_type_ids := token_type_ids;
			@tokens := tokens;
			@length := length;
			@truncated := truncated;
		}

		#~
		Constructor with each token's character offsets in the text.
		@param ids token ids, padding included
		@param attention_mask 1 for a real token, 0 for padding
		@param token_type_ids segment of each token, 0 or 1
		@param tokens the token strings, one per id
		@param length tokens before the padding, special tokens included
		@param truncated whether text was dropped to fit
		@param offsets start and end of each token in its text, two per id: [2i] and [2i + 1]
		~#
		New(ids : Int[], attention_mask : Int[], token_type_ids : Int[], tokens : String[], length : Int, truncated : Bool, offsets : Int[]) {
			@ids := ids;
			@attention_mask := attention_mask;
			@token_type_ids := token_type_ids;
			@tokens := tokens;
			@length := length;
			@truncated := truncated;
			@offsets := offsets;
		}

		#~
		Each token's character offsets in its text, as Hugging Face's offset_mapping: the
		token at position i spans [offsets[2i], offsets[2i + 1]) of the text it came from;
		special tokens and padding are (0, 0).
		@return two per id, or Nil when the tokenizer does not record offsets
		~#
		method : public : GetOffsets() ~ Int[] {
			return @offsets;
		}

		#~
		Token ids, padding included.
		@return ids
		~#
		method : public : GetIds() ~ Int[] {
			return @ids;
		}

		#~
		Attention mask: 1 for a real token, 0 for padding.
		@return mask
		~#
		method : public : GetAttentionMask() ~ Int[] {
			return @attention_mask;
		}

		#~
		Token type (segment) ids: 0 for the first text, 1 for the second of a pair.
		@return token type ids
		~#
		method : public : GetTokenTypeIds() ~ Int[] {
			return @token_type_ids;
		}

		#~
		The token strings, one per id.
		@return tokens
		~#
		method : public : GetTokens() ~ String[] {
			return @tokens;
		}

		#~
		Tokens before the padding, [CLS] and [SEP] included.
		@return unpadded length
		~#
		method : public : GetLength() ~ Int {
			return @length;
		}

		#~
		Total length, padding included: the max_len it was encoded to.
		@return padded length
		~#
		method : public : GetSize() ~ Int {
			return @ids->Size();
		}

		#~
		Whether text was dropped to fit max_len.
		@return true when truncated
		~#
		method : public : IsTruncated() ~ Bool {
			return @truncated;
		}

		method : public : ToString() ~ String {
			text := "";
			for(i := 0; i < @length; i += 1;) {
				if(i > 0) {
					text += " ";
				};
				text += @tokens[i];
			};
			return text;
		}
	}

	#~
	BERT's tokenizer: a BasicTokenizer followed by WordPiece, reading a model's vocab.txt, and
	the encoding a BERT-family model takes as input.

	The BasicTokenizer drops control characters, puts spaces around CJK ideographs, splits on
	whitespace, then per word lowercases (an option), strips accents (an option: decompose,
	then drop combining marks) and splits off every punctuation character. WordPiece then
	splits each word greedily, longest match first, into vocabulary pieces, continuations
	prefixed "##"; a word with a remainder no piece matches, or longer than 100 characters,
	becomes one [UNK]. The special tokens [CLS], [SEP], [PAD], [MASK] and [UNK] are never split
	when they appear in the text.

	This is Hugging Face's BertTokenizer (the Python one), checked against a transcription of
	it on a corpus (programs/regression/nlp_wordpiece_parity.obs). Its Unicode tables are
	generated from Python's unicodedata (tools/nlp/gen_wordpiece_tables.py). Two differences:
	Hugging Face composes the text to NFC first, which matters only to a model that does not
	strip accents given decomposed text; and it drops code points Unicode has not assigned,
	which this keeps.

	Defaults are bert-base-uncased's: lowercase and strip accents. A cased model needs both
	off.

```
tokenizer := WordPieceTokenizer->New("vocab.txt");
pieces := tokenizer->Tokenize("He's unaffable!");    # he ' s un ##aff ##able !
encoding := tokenizer->Encode("He's unaffable!", 16);
ids := encoding->GetIds();                            # [CLS] ... [SEP] then [PAD] to 16
pair := tokenizer->EncodePair("a question", "a passage", 32);
tokenizer->Decode(ids)->PrintLine();                  # he ' s unaffable !
```
	~#
	class WordPieceTokenizer implements SubwordTokenizer {
		@vocab : Hash<String, IntRef>;
		@tokens : String[];
		@lower_case : Bool;
		@strip_accents : Bool;
		@max_word_chars : Int;
		@pad_id : Int;
		@unk_id : Int;
		@cls_id : Int;
		@sep_id : Int;
		@mask_id : Int;
		@specials : String[];
		@load_error : String;
		@error : String;

		#~
		Loads a vocabulary for an uncased model: lowercase and strip accents.
		@param vocab_path vocab.txt, one token per line, the line number its id
		~#
		New(vocab_path : String) {
			Init(ReadLines(vocab_path), true, true);
			if(@tokens = Nil) {
				@load_error := "cannot read vocabulary '{$vocab_path}'";
			};
		}

		#~
		Loads a vocabulary.
		@param vocab_path vocab.txt, one token per line, the line number its id
		@param lower_case lowercase the text (true for an uncased model)
		@param strip_accents remove accents (true for an uncased model)
		~#
		New(vocab_path : String, lower_case : Bool, strip_accents : Bool) {
			Init(ReadLines(vocab_path), lower_case, strip_accents);
			if(@tokens = Nil) {
				@load_error := "cannot read vocabulary '{$vocab_path}'";
			};
		}

		#~
		Builds a tokenizer from a vocabulary held in memory.
		@param tokens the vocabulary, each token's index its id
		@param lower_case lowercase the text
		@param strip_accents remove accents
		~#
		New(tokens : String[], lower_case : Bool, strip_accents : Bool) {
			Init(tokens, lower_case, strip_accents);
		}

		method : Init(tokens : String[], lower_case : Bool, strip_accents : Bool) ~ Nil {
			@lower_case := lower_case;
			@strip_accents := strip_accents;
			@max_word_chars := 100;
			@specials := ["[UNK]", "[SEP]", "[PAD]", "[CLS]", "[MASK]"];
			@vocab := Hash->New()<String, IntRef>;
			@pad_id := -1; @unk_id := -1; @cls_id := -1; @sep_id := -1; @mask_id := -1;

			if(tokens = Nil) {
				@load_error := "no vocabulary";
				return;
			};

			@tokens := tokens;
			# a token listed twice keeps its LAST id, as a Python dict built from the file does
			each(i : tokens) {
				token := tokens[i];
				if(token <> Nil) {
					@vocab->Insert(token, IntRef->New(i));
				};
			};

			@pad_id := TokenToId("[PAD]");
			@unk_id := TokenToId("[UNK]");
			@cls_id := TokenToId("[CLS]");
			@sep_id := TokenToId("[SEP]");
			@mask_id := TokenToId("[MASK]");

			if(@unk_id < 0 | @cls_id < 0 | @sep_id < 0 | @pad_id < 0) {
				@load_error := "the vocabulary lacks one of [UNK], [CLS], [SEP], [PAD]";
			};
		}

		function : private : ReadLines(path : String) ~ String[] {
			if(path = Nil) {
				return Nil;
			};

			reader := System.IO.Filesystem.FileReader->New(path);
			if(<>reader->IsOpen()) {
				return Nil;
			};

			lines := Vector->New()<String>;
			line := reader->ReadLine();
			while(line <> Nil) {
				lines->AddBack(line);
				line := reader->ReadLine();
			};
			reader->Close();

			return lines->ToArray();
		}

		#~
		Whether the vocabulary loaded and names [UNK], [CLS], [SEP] and [PAD].
		@return true when the tokenizer can encode
		~#
		method : public : IsLoaded() ~ Bool {
			return @load_error = Nil & @tokens <> Nil;
		}

		#~
		Why the tokenizer is not loaded, or why the last Encode returned Nil.
		@return the reason, or Nil
		~#
		method : public : GetError() ~ String {
			if(@load_error <> Nil) {
				return @load_error;
			};
			return @error;
		}

		#~
		Number of tokens in the vocabulary.
		@return vocabulary size
		~#
		method : public : GetVocabSize() ~ Int {
			if(@tokens = Nil) {
				return 0;
			};
			return @tokens->Size();
		}

		#~
		A token's id.
		@param token the token, e.g. "##able"
		@return its id, or -1 when the vocabulary lacks it
		~#
		method : public : TokenToId(token : String) ~ Int {
			if(token = Nil) {
				return -1;
			};

			id := @vocab->Find(token);
			if(id = Nil) {
				return -1;
			};
			return id->Get();
		}

		#~
		The token with an id.
		@param id token id
		@return the token, or Nil when the id is out of range
		~#
		method : public : IdToToken(id : Int) ~ String {
			if(@tokens = Nil | id < 0 | id >= @tokens->Size()) {
				return Nil;
			};
			return @tokens[id];
		}

		#~
		Id of [PAD].
		@return id, -1 when absent
		~#
		method : public : GetPadId() ~ Int {
			return @pad_id;
		}

		#~
		Id of [UNK].
		@return id, -1 when absent
		~#
		method : public : GetUnkId() ~ Int {
			return @unk_id;
		}

		#~
		Id of [CLS].
		@return id, -1 when absent
		~#
		method : public : GetClsId() ~ Int {
			return @cls_id;
		}

		#~
		Id of [SEP].
		@return id, -1 when absent
		~#
		method : public : GetSepId() ~ Int {
			return @sep_id;
		}

		#~
		Id of [MASK].
		@return id, -1 when absent
		~#
		method : public : GetMaskId() ~ Int {
			return @mask_id;
		}

		#~
		Whether text is lowercased.
		@return true for an uncased tokenizer
		~#
		method : public : IsLowerCase() ~ Bool {
			return @lower_case;
		}

		#~
		Whether accents are stripped.
		@return true when accents are removed
		~#
		method : public : IsStripAccents() ~ Bool {
			return @strip_accents;
		}

		#~
		Sets the longest word, in characters, WordPiece will split; a longer one becomes [UNK].
		BERT's value is 100.
		@param max_word_chars longest word
		~#
		method : public : SetMaxWordChars(max_word_chars : Int) ~ Nil {
			@max_word_chars := max_word_chars;
		}

		#~
		Splits text into words and punctuation, BERT's BasicTokenizer: no vocabulary is used.
		@param text the text
		@return words, lowercased and accent-stripped as configured

```
words := tokenizer->BasicTokenize("Hello, World!");   # hello , world !
```
		~#
		method : public : BasicTokenize(text : String) ~ String[] {
			words := Vector->New()<String>;
			if(text = Nil) {
				return words->ToArray();
			};

			pieces := Vector->New()<IntArrayRef>;
			specials := Vector->New()<String>;
			Basic(text, pieces, specials);
			each(i : pieces) {
				special := specials->Get(i);
				if(special <> Nil) {
					words->AddBack(special);
				}
				else {
					words->AddBack(WordPieceText->Encode(pieces->Get(i)->Get()));
				};
			};

			return words->ToArray();
		}

		#~
		Splits text into WordPiece tokens, without [CLS], [SEP] or padding.
		@param text the text
		@return the pieces

```
tokenizer->Tokenize("unaffable");   # un ##aff ##able
```
		~#
		method : public : Tokenize(text : String) ~ String[] {
			ids := IntVector->New();
			pieces := Vector->New()<String>;
			Pieces(text, ids, pieces);
			return pieces->ToArray();
		}

		#~
		Splits text into WordPiece token ids, without [CLS], [SEP] or padding.
		@param text the text
		@return the ids
		~#
		method : public : TokenizeToIds(text : String) ~ Int[] {
			ids := IntVector->New();
			pieces := Vector->New()<String>;
			Pieces(text, ids, pieces);
			return ids->ToArray();
		}

		#~
		Encodes one text: [CLS], its pieces, [SEP], then [PAD] to exactly max_len. A text too
		long keeps its beginning.
		@param text the text
		@param max_len the length to truncate and pad to, at least 2
		@return the encoding, or Nil when the tokenizer is not loaded or max_len is below 2

```
encoding := tokenizer->Encode("the quick brown fox", 128);
```
		~#
		method : public : Encode(text : String, max_len : Int) ~ TokenEncoding {
			if(<>IsLoaded()) {
				return Nil;
			};
			if(max_len < 2) {
				@error := "max_len must be at least 2 for [CLS] and [SEP]";
				return Nil;
			};

			ids := IntVector->New();
			pieces := Vector->New()<String>;
			Pieces(text, ids, pieces, max_len - 2);

			keep := ids->Size();
			truncated := false;
			if(keep > max_len - 2) {
				keep := max_len - 2;
				truncated := true;
			};

			return Layout(ids, pieces, keep, Nil, Nil, 0, max_len, truncated);
		}

		#~
		Encodes a pair: [CLS] a [SEP] b [SEP], token types 0 through the first [SEP] and 1
		after, then [PAD] to max_len. When the pair is too long, a token at a time is dropped
		from the end of whichever text is longer (the second on a tie), Hugging Face's
		longest_first truncation.
		@param text_a the first text
		@param text_b the second text
		@param max_len the length to truncate and pad to, at least 3
		@return the encoding, or Nil when the tokenizer is not loaded or max_len is below 3
		~#
		method : public : EncodePair(text_a : String, text_b : String, max_len : Int) ~ TokenEncoding {
			if(<>IsLoaded()) {
				return Nil;
			};
			if(max_len < 3) {
				@error := "max_len must be at least 3 for a pair";
				return Nil;
			};

			ids_a := IntVector->New();
			pieces_a := Vector->New()<String>;
			Pieces(text_a, ids_a, pieces_a);
			ids_b := IntVector->New();
			pieces_b := Vector->New()<String>;
			Pieces(text_b, ids_b, pieces_b);

			keep_a := ids_a->Size();
			keep_b := ids_b->Size();
			truncated := false;
			while(keep_a + keep_b > max_len - 3) {
				if(keep_a > keep_b) {
					keep_a -= 1;
				}
				else {
					keep_b -= 1;
				};
				truncated := true;
			};

			return Layout(ids_a, pieces_a, keep_a, ids_b, pieces_b, keep_b, max_len, truncated);
		}

		#~
		Encodes several texts, each with Encode.
		@param texts the texts
		@param max_len the length to truncate and pad to
		@return one encoding per text, or Nil when any cannot be encoded
		~#
		method : public : EncodeBatch(texts : String[], max_len : Int) ~ TokenEncoding[] {
			if(texts = Nil) {
				return Nil;
			};

			out := TokenEncoding->New[texts->Size()];
			each(i : texts) {
				encoding := Encode(texts[i], max_len);
				if(encoding = Nil) {
					return Nil;
				};
				out[i] := encoding;
			};

			return out;
		}

		#~
		Turns ids back into text: pieces joined with spaces, a "##" continuation joined to the
		piece before it, special tokens left out. Lowercasing and stripped accents do not come
		back.
		@param ids token ids
		@return the text
		~#
		method : public : Decode(ids : Int[]) ~ String {
			return Decode(ids, true);
		}

		#~
		Turns ids back into text.
		@param ids token ids
		@param skip_special leave out [CLS], [SEP], [PAD], [MASK] and [UNK]
		@return the text
		~#
		method : public : Decode(ids : Int[], skip_special : Bool) ~ String {
			text := String->New();
			if(ids = Nil) {
				return text;
			};

			first := true;
			each(i : ids) {
				token := IdToToken(ids[i]);
				if(token = Nil) {
					token := "[UNK]";
				};

				if(<>skip_special | <>IsSpecial(token)) {
					if(<>first & token->StartsWith("##")) {
						text->Append(token->SubString(2, token->Size() - 2));
					}
					else {
						if(<>first) {
							text->Append(' ');
						};
						text->Append(token);
					};
					first := false;
				};
			};

			return text;
		}

		method : IsSpecial(token : String) ~ Bool {
			each(i : @specials) {
				if(@specials[i]->Equals(token)) {
					return true;
				};
			};
			return false;
		}

		method : Layout(ids_a : IntVector, pieces_a : Vector<String>, keep_a : Int,
				ids_b : IntVector, pieces_b : Vector<String>, keep_b : Int, max_len : Int, truncated : Bool) ~ TokenEncoding {
			ids := Int->New[max_len];
			mask := Int->New[max_len];
			types := Int->New[max_len];
			tokens := String->New[max_len];

			at := 0;
			ids[at] := @cls_id; tokens[at] := "[CLS]"; mask[at] := 1;
			at += 1;
			for(i := 0; i < keep_a; i += 1;) {
				ids[at] := ids_a->Get(i); tokens[at] := pieces_a->Get(i); mask[at] := 1;
				at += 1;
			};
			ids[at] := @sep_id; tokens[at] := "[SEP]"; mask[at] := 1;
			at += 1;

			if(ids_b <> Nil) {
				for(i := 0; i < keep_b; i += 1;) {
					ids[at] := ids_b->Get(i); tokens[at] := pieces_b->Get(i); mask[at] := 1; types[at] := 1;
					at += 1;
				};
				ids[at] := @sep_id; tokens[at] := "[SEP]"; mask[at] := 1; types[at] := 1;
				at += 1;
			};

			length := at;
			while(at < max_len) {
				ids[at] := @pad_id; tokens[at] := "[PAD]";
				at += 1;
			};

			return TokenEncoding->New(ids, mask, types, tokens, length, truncated);
		}

		# The BasicTokenizer, then WordPiece over each word.
		method : Pieces(text : String, ids : IntVector, pieces : Vector<String>) ~ Nil {
			Pieces(text, ids, pieces, -1);
		}

		# Stops once more than limit pieces are found (limit < 0: no limit). Truncation keeps
		# the beginning, so for a single text the pieces past max_len need not be found at all:
		# a long API trace would otherwise be split in full to keep its first hundred pieces.
		method : Pieces(text : String, ids : IntVector, pieces : Vector<String>, limit : Int) ~ Nil {
			if(text = Nil | @tokens = Nil) {
				return;
			};

			words := Vector->New()<IntArrayRef>;
			specials := Vector->New()<String>;
			Basic(text, words, specials);
			for(i := 0; i < words->Size() & (limit < 0 | ids->Size() <= limit); i += 1;) {
				special := specials->Get(i);
				if(special <> Nil) {
					ids->AddBack(TokenToId(special));
					pieces->AddBack(special);
				}
				else {
					WordPiece(words->Get(i)->Get(), ids, pieces);
				};
			};
		}

		# Greedy longest-match-first over one word's code points.
		method : WordPiece(word : Int[], ids : IntVector, pieces : Vector<String>) ~ Nil {
			count := word->Size();
			if(count > @max_word_chars) {
				ids->AddBack(@unk_id);
				pieces->AddBack("[UNK]");
				return;
			};

			# the word once as a String, and where each code point starts in it, so a candidate
			# piece is one SubString rather than a code point at a time
			text := WordPieceText->Encode(word);
			offsets := Int->New[count + 1];
			at := 0;
			for(i := 0; i < count; i += 1;) {
				offsets[i] := at;
				if(word[i] > 0xFFFF & <>WordPieceText->IsWide()) {
					at += 2;
				}
				else {
					at += 1;
				};
			};
			offsets[count] := at;

			found_ids := IntVector->New();
			found := Vector->New()<String>;
			start := 0;
			while(start < count) {
				end := count;
				match_id := -1;
				match : String := Nil;
				while(start < end & match_id < 0) {
					piece := text->SubString(offsets[start], offsets[end] - offsets[start]);
					if(start > 0) {
						piece := "##" + piece;
					};

					id := TokenToId(piece);
					if(id >= 0) {
						match_id := id;
						match := piece;
					}
					else {
						end -= 1;
					};
				};

				if(match_id < 0) {
					ids->AddBack(@unk_id);
					pieces->AddBack("[UNK]");
					return;
				};

				found_ids->AddBack(match_id);
				found->AddBack(match);
				start := end;
			};

			for(i := 0; i < found_ids->Size(); i += 1;) {
				ids->AddBack(found_ids->Get(i));
				pieces->AddBack(found->Get(i));
			};
		}

		# Splits text into words (code points) and the special tokens that appear in it whole;
		# specials[i] is the special token, or Nil for a word. Works on code points throughout:
		# a String cut with SubString ends at a NUL, and NUL is text BERT drops, not an end.
		method : Basic(text : String, words : Vector<IntArrayRef>, specials : Vector<String>) ~ Nil {
			points := WordPieceText->Decode(text);
			size := points->Size();

			start := 0;
			i := 0;
			while(i < size) {
				special := SpecialAt(points, i);
				if(special <> Nil) {
					if(i > start) {
						Words(points, start, i, words, specials);
					};
					words->AddBack(Nil);
					specials->AddBack(special);
					i += special->Size();
					start := i;
				}
				else {
					i += 1;
				};
			};

			if(size > start) {
				Words(points, start, size, words, specials);
			};
		}

		# The special token, in the vocabulary, that starts at points[at], or Nil
		method : SpecialAt(points : Int[], at : Int) ~ String {
			if(points[at] <> 91) { # '['
				return Nil;
			};

			each(i : @specials) {
				special := @specials[i];
				if(at + special->Size() <= points->Size() & @vocab->Has(special)) {
					match := true;
					for(j := 0; j < special->Size() & match; j += 1;) {
						if(points[at + j] <> special->Get(j)->As(Int)) {
							match := false;
						};
					};
					if(match) {
						return special;
					};
				};
			};

			return Nil;
		}

		method : Words(points : Int[], first : Int, last : Int, words : Vector<IntArrayRef>, specials : Vector<String>) ~ Nil {
			# clean: drop NUL, U+FFFD and controls; whitespace becomes a space; CJK ideographs
			# get a space either side
			cleaned := IntVector->New();
			for(i := first; i < last; i += 1;) {
				cp := points[i];
				if(cp <> 0 & cp <> 0xFFFD & <>WordPieceText->IsControl(cp)) {
					if(WordPieceText->IsWhitespace(cp)) {
						cleaned->AddBack(32);
					}
					else if(WordPieceText->IsChinese(cp)) {
						cleaned->AddBack(32);
						cleaned->AddBack(cp);
						cleaned->AddBack(32);
					}
					else {
						cleaned->AddBack(cp);
					};
				};
			};

			# split on whitespace; then case, accents and punctuation per word
			word := IntVector->New();
			for(i := 0; i <= cleaned->Size(); i += 1;) {
				boundary := i = cleaned->Size();
				if(<>boundary) {
					cp := cleaned->Get(i);
					boundary := cp = 32 | cp = 0x2028 | cp = 0x2029;
				};

				if(boundary) {
					if(word->Size() > 0) {
						Word(word->ToArray(), words, specials);
						word := IntVector->New();
					};
				}
				else {
					word->AddBack(cleaned->Get(i));
				};
			};
		}

		method : Word(word : Int[], words : Vector<IntArrayRef>, specials : Vector<String>) ~ Nil {
			points := word;
			if(@lower_case) {
				points := WordPieceText->Lower(points);
			};
			if(@strip_accents) {
				points := WordPieceText->StripAccents(points);
			};

			run := IntVector->New();
			each(i : points) {
				cp := points[i];
				if(WordPieceText->IsPunctuation(cp)) {
					if(run->Size() > 0) {
						words->AddBack(IntArrayRef->New(run->ToArray()));
						specials->AddBack(Nil);
						run := IntVector->New();
					};
					one := Int->New[1];
					one[0] := cp;
					words->AddBack(IntArrayRef->New(one));
					specials->AddBack(Nil);
				}
				else {
					run->AddBack(cp);
				};
			};

			if(run->Size() > 0) {
				words->AddBack(IntArrayRef->New(run->ToArray()));
				specials->AddBack(Nil);
			};
		}
	}

	#~
	A tokenizer that turns text into a model's input: WordPieceTokenizer (BERT, DistilBERT,
	MiniLM) and BpeTokenizer (RoBERTa, GPT-2). The task classes of System.NLP.Onnx take either.
	~#
	interface SubwordTokenizer {
		#~
		Encodes one text, truncated and padded to max_len, special tokens included.
		@param text the text
		@param max_len the length to truncate and pad to
		@return the encoding, or Nil (see GetError)
		~#
		method : virtual : public : Encode(text : String, max_len : Int) ~ TokenEncoding;

		#~
		Encodes a pair of texts, truncated and padded to max_len, special tokens included.
		@param text_a the first text
		@param text_b the second text
		@param max_len the length to truncate and pad to
		@return the encoding, or Nil (see GetError)
		~#
		method : virtual : public : EncodePair(text_a : String, text_b : String, max_len : Int) ~ TokenEncoding;

		#~
		Whether the vocabulary loaded.
		@return true when the tokenizer can encode
		~#
		method : virtual : public : IsLoaded() ~ Bool;

		#~
		Why the vocabulary did not load, or why the last call returned Nil.
		@return the reason, or Nil
		~#
		method : virtual : public : GetError() ~ String;
	}

	#~
	Byte-level BPE, the tokenizer of RoBERTa, DistilRoBERTa and GPT-2, as Hugging Face's
	tokenizers library runs it: the GPT-2 split of the text into words, numbers, punctuation
	runs and whitespace; each piece's UTF-8 bytes as characters; the merges applied lowest
	rank first; then RoBERTa's specials, <s> text </s> or <s> a </s></s> b </s>.

	Every encoding records each token's character offsets in the text (GetOffsets), with the
	leading space a token carries trimmed off when trim_offsets is set, as RoBERTa's are.
	Special tokens the vocabulary lists, such as <mask>, are matched in the text before it is
	split; one marked lstrip takes the whitespace before it.

	Usually built from a model's tokenizer.json by System.NLP.Onnx; the constructor takes the
	vocabulary and merges themselves.

```
tokenizer := BpeTokenizer->New(tokens, merges, false, true);
encoding := tokenizer->Encode("Hello world", 8);
encoding->GetTokens()->Size()->PrintLine();   # 8: <s> Hello Ġworld </s> <pad> <pad> <pad> <pad>
```
	~#
	class BpeTokenizer implements SubwordTokenizer {
		@vocab : Hash<String, IntRef>;
		@tokens : String[];
		@ranks : Hash<String, IntRef>;
		@cache : Hash<String, BpeWord>;
		@byte_chars : String[];
		@char_bytes : Hash<String, IntRef>;
		@added : Vector<BpeAdded>;
		@add_prefix_space : Bool;
		@trim_offsets : Bool;
		@cls_token : String;
		@sep_token : String;
		@pad_token : String;
		@cls_id : Int;
		@sep_id : Int;
		@pad_id : Int;
		@unk_id : Int;
		@load_error : String;
		@error : String;

		#~
		Builds a tokenizer from a vocabulary and its merges, with RoBERTa's specials: <s>, </s>,
		<pad> and <unk>.
		@param tokens the vocabulary, each token's index its id (byte-level strings, e.g. "Ġworld")
		@param merges the merges in rank order, each "left right"
		@param add_prefix_space whether a space is put before text that does not start with one
		@param trim_offsets whether a token's offsets leave out the space it carries
		~#
		New(tokens : String[], merges : String[], add_prefix_space : Bool, trim_offsets : Bool) {
			@add_prefix_space := add_prefix_space;
			@trim_offsets := trim_offsets;
			@added := Vector->New()<BpeAdded>;
			@cache := Hash->New()<String, BpeWord>;
			@cls_id := -1;
			@sep_id := -1;
			@pad_id := -1;
			@unk_id := -1;
			InitBytes();

			if(tokens = Nil | tokens->Size() = 0) {
				@load_error := "no vocabulary";
				return;
			};
			@tokens := tokens;
			@vocab := Hash->New()<String, IntRef>;
			each(i : tokens) {
				if(tokens[i] <> Nil) {
					@vocab->Insert(tokens[i], IntRef->New(i));
				};
			};

			@ranks := Hash->New()<String, IntRef>;
			if(merges <> Nil) {
				each(i : merges) {
					merge := merges[i];
					if(merge <> Nil & merge->Find(' ') > 0 & @ranks->Find(merge) = Nil) {
						@ranks->Insert(merge, IntRef->New(i));
					};
				};
			};

			if(<>SetSpecialTokens("<s>", "</s>", "<pad>", "<unk>")) {
				@load_error := @error;
			};
		}

		#~
		Sets the special tokens, for a vocabulary that does not use RoBERTa's names.
		@param cls the token that starts a text, e.g. <s>
		@param sep the token that ends one, e.g. </s>
		@param pad the padding token, e.g. <pad>
		@param unk the token for what the vocabulary lacks, e.g. <unk>; may be Nil
		@return true when the vocabulary holds them
		~#
		method : public : SetSpecialTokens(cls : String, sep : String, pad : String, unk : String) ~ Bool {
			cls_id := Id(cls);
			sep_id := Id(sep);
			pad_id := Id(pad);
			if(cls_id < 0 | sep_id < 0 | pad_id < 0) {
				@error := "the vocabulary has no '{$cls}', '{$sep}' or '{$pad}'";
				return false;
			};

			@cls_token := cls;
			@sep_token := sep;
			@pad_token := pad;
			@cls_id := cls_id;
			@sep_id := sep_id;
			@pad_id := pad_id;
			@unk_id := Id(unk);

			# they are matched in the text too, as tokenizer.json's added_tokens are
			AddSpecialToken(cls, false, false);
			AddSpecialToken(sep, false, false);
			AddSpecialToken(pad, false, false);
			if(@unk_id >= 0) {
				AddSpecialToken(unk, false, false);
			};
			return true;
		}

		#~
		Adds a special token matched in the text before it is split, e.g. <mask>; the specials
		SetSpecialTokens names are matched already. Adding one again replaces its rules.
		@param content the token, as the vocabulary lists it
		@param lstrip whether it takes the whitespace before it
		@param rstrip whether it takes the whitespace after it
		@return true when the vocabulary holds it
		~#
		method : public : AddSpecialToken(content : String, lstrip : Bool, rstrip : Bool) ~ Bool {
			id := Id(content);
			if(id < 0 | content->Size() = 0) {
				@error := "the vocabulary has no '{$content}'";
				return false;
			};
			each(i : @added) {
				if(@added->Get(i)->GetContent()->Equals(content)) {
					@added->Set(BpeAdded->New(WordPieceText->Decode(content), content, id, lstrip, rstrip), i);
					return true;
				};
			};
			@added->AddBack(BpeAdded->New(WordPieceText->Decode(content), content, id, lstrip, rstrip));
			return true;
		}

		method : Id(token : String) ~ Int {
			if(token = Nil | @vocab = Nil) {
				return -1;
			};
			id := @vocab->Find(token);
			if(id = Nil) {
				return -1;
			};
			return id->Get();
		}

		#~
		Whether the vocabulary and specials loaded.
		@return true when the tokenizer can encode
		~#
		method : public : IsLoaded() ~ Bool {
			return @vocab <> Nil & @load_error = Nil;
		}

		#~
		Why the vocabulary did not load, or why the last call returned Nil.
		@return the reason, or Nil
		~#
		method : public : GetError() ~ String {
			if(@load_error <> Nil) {
				return @load_error;
			};
			return @error;
		}

		#~
		The vocabulary's size.
		@return tokens
		~#
		method : public : GetVocabularySize() ~ Int {
			if(@tokens = Nil) {
				return 0;
			};
			return @tokens->Size();
		}

		#~
		A token's id.
		@param token the token, e.g. "Ġworld"
		@return its id, or -1 when the vocabulary lacks it
		~#
		method : public : GetId(token : String) ~ Int {
			return Id(token);
		}

		#~
		The token an id stands for.
		@param id the id
		@return the token, or Nil
		~#
		method : public : GetToken(id : Int) ~ String {
			if(@tokens = Nil | id < 0 | id >= @tokens->Size()) {
				return Nil;
			};
			return @tokens[id];
		}

		#~
		The pieces a text becomes, before special tokens are added: byte-level strings, a
		leading Ġ for a space.
		@param text the text
		@return the tokens; Nil when the tokenizer is not loaded
		~#
		method : public : Tokenize(text : String) ~ String[] {
			if(<>IsLoaded() | text = Nil) {
				return Nil;
			};
			sequence := Sequence(text);
			return sequence->GetTokens()->ToArray();
		}

		#~
		Encodes one text: <s> text </s>, then <pad> to max_len. Text past max_len - 2 tokens is
		dropped, and the encoding says so.
		@param text the text
		@param max_len the length to truncate and pad to, at least 2
		@return the encoding, or Nil when the tokenizer is not loaded or max_len is below 2
		~#
		method : public : Encode(text : String, max_len : Int) ~ TokenEncoding {
			if(<>IsLoaded()) {
				return Nil;
			};
			if(text = Nil) {
				@error := "no text";
				return Nil;
			};
			if(max_len < 2) {
				@error := "max_len must be at least 2 for {$@cls_token} and {$@sep_token}";
				return Nil;
			};

			a := Sequence(text);
			keep := a->Size();
			truncated := false;
			if(keep > max_len - 2) {
				keep := max_len - 2;
				truncated := true;
			};
			return Layout(a, keep, Nil, 0, max_len, truncated);
		}

		#~
		Encodes a pair: <s> a </s></s> b </s>, then <pad> to max_len; token types are all 0, as
		RoBERTa's are. When the pair is too long, a token at a time is dropped from the end of
		whichever text is longer (the second on a tie), Hugging Face's longest_first truncation.
		@param text_a the first text
		@param text_b the second text
		@param max_len the length to truncate and pad to, at least 4
		@return the encoding, or Nil when the tokenizer is not loaded or max_len is below 4
		~#
		method : public : EncodePair(text_a : String, text_b : String, max_len : Int) ~ TokenEncoding {
			if(<>IsLoaded()) {
				return Nil;
			};
			if(text_a = Nil | text_b = Nil) {
				@error := "no text";
				return Nil;
			};
			if(max_len < 4) {
				@error := "max_len must be at least 4 for a pair";
				return Nil;
			};

			a := Sequence(text_a);
			b := Sequence(text_b);
			keep_a := a->Size();
			keep_b := b->Size();
			truncated := false;
			while(keep_a + keep_b > max_len - 4) {
				if(keep_a > keep_b) {
					keep_a -= 1;
				}
				else {
					keep_b -= 1;
				};
				truncated := true;
			};
			return Layout(a, keep_a, b, keep_b, max_len, truncated);
		}

		#~
		Turns ids back into text: the tokens' bytes, decoded as UTF-8, special tokens left out.
		@param ids token ids
		@return the text
		~#
		method : public : Decode(ids : Int[]) ~ String {
			if(ids = Nil | <>IsLoaded()) {
				return Nil;
			};

			bytes := IntVector->New();
			each(i : ids) {
				id := ids[i];
				if(id <> @cls_id & id <> @sep_id & id <> @pad_id & id >= 0 & id < @tokens->Size()) {
					token := @tokens[id];
					if(token <> Nil & <>IsAdded(id)) {
						each(j : token) {
							value := @char_bytes->Find(CharString(token->Get(j)));
							if(value <> Nil) {
								bytes->AddBack(value->Get());
							};
						};
					}
					else if(token <> Nil) {
						utf8 := Utf8(WordPieceText->Decode(token));
						each(j : utf8) {
							bytes->AddBack(utf8->Get(j));
						};
					};
				};
			};
			return WordPieceText->Encode(FromUtf8(bytes->ToArray()));
		}

		method : IsAdded(id : Int) ~ Bool {
			each(i : @added) {
				if(@added->Get(i)->GetId() = id) {
					return true;
				};
			};
			return false;
		}

		# --- encoding ---

		# one text's tokens, ids and offsets, special tokens matched first
		method : Sequence(text : String) ~ BpeSequence {
			points := WordPieceText->Decode(text);
			sequence := BpeSequence->New();
			size := points->Size();

			segment := 0;
			i := 0;
			while(i < size) {
				match := MatchAdded(points, i);
				if(match = Nil) {
					i += 1;
				}
				else {
					cut := i;
					if(match->IsLstrip()) {
						while(cut > segment & IsSpace(points[cut - 1])) {
							cut -= 1;
						};
					};
					EncodeSegment(points, segment, cut, sequence);

					finish := i + match->GetLength();
					if(match->IsRstrip()) {
						while(finish < size & IsSpace(points[finish])) {
							finish += 1;
						};
					};
					# its offsets are its own text: not the whitespace it takes
					sequence->Add(match->GetId(), match->GetContent(), i, i + match->GetLength());
					segment := finish;
					i := finish;
				};
			};
			EncodeSegment(points, segment, size, sequence);

			if(@trim_offsets) {
				TrimOffsets(sequence);
			};
			return sequence;
		}

		# the longest special token that starts at position i
		method : MatchAdded(points : Int[], i : Int) ~ BpeAdded {
			best : BpeAdded;
			each(k : @added) {
				candidate := @added->Get(k);
				content := candidate->GetPoints();
				length := content->Size();
				if(i + length <= points->Size() & (best = Nil | length > best->GetLength())) {
					same := true;
					for(j := 0; same & j < length; j += 1;) {
						if(points[i + j] <> content[j]) {
							same := false;
						};
					};
					if(same) {
						best := candidate;
					};
				};
			};
			return best;
		}

		# text between special tokens: the GPT-2 split, then BPE on each piece's bytes
		method : EncodeSegment(points : Int[], start : Int, finish : Int, sequence : BpeSequence) ~ Nil {
			if(start >= finish) {
				return;
			};

			# a space before text that does not start with one: it carries the first character's
			# offsets, with no width of its own
			if(@add_prefix_space & points[start] <> 32) {
				prefixed := Int->New[finish - start + 1];
				prefixed[0] := 32;
				for(k := start; k < finish; k += 1;) {
					prefixed[k - start + 1] := points[k];
				};
				SplitAndEncode(prefixed, 0, prefixed->Size(), start - 1, sequence);
				return;
			};

			SplitAndEncode(points, start, finish, 0, sequence);
		}

		# shift maps a position in points to the text's character offset: position + shift,
		# except the prepended space, which is clamped to the first character
		method : SplitAndEncode(points : Int[], start : Int, finish : Int, shift : Int, sequence : BpeSequence) ~ Nil {
			i := start;
			while(i < finish) {
				j := PieceEnd(points, i, finish);
				EncodePiece(points, i, j, shift, sequence);
				i := j;
			};
		}

		# GPT-2's pattern: 's|'t|'re|'ve|'m|'ll|'d| ?\p{L}+| ?\p{N}+| ?[^\s\p{L}\p{N}]+|\s+(?!\S)|\s+
		method : PieceEnd(points : Int[], i : Int, finish : Int) ~ Int {
			cp := points[i];

			if(cp = 39 & i + 1 < finish) {
				c1 := points[i + 1];
				if(c1 = 115 | c1 = 116 | c1 = 109 | c1 = 100) {
					return i + 2;
				};
				if(i + 2 < finish) {
					c2 := points[i + 2];
					if((c1 = 114 & c2 = 101) | (c1 = 118 & c2 = 101) | (c1 = 108 & c2 = 108)) {
						return i + 3;
					};
				};
			};

			# letters, then numbers, then other: each with an optional leading space
			for(kind := 0; kind < 3; kind += 1;) {
				if(cp = 32 & i + 1 < finish & Kind(points[i + 1]) = kind) {
					return RunEnd(points, i + 1, finish, kind);
				};
				if(Kind(cp) = kind) {
					return RunEnd(points, i, finish, kind);
				};
			};

			# whitespace: \s+(?!\S) leaves the last space to the word after it; \s+ otherwise
			w := i;
			while(w < finish & IsSpace(points[w])) {
				w += 1;
			};
			if(w < finish & w - 1 > i) {
				return w - 1;
			};
			if(w = i) {
				return i + 1;
			};
			return w;
		}

		method : RunEnd(points : Int[], i : Int, finish : Int, kind : Int) ~ Int {
			j := i;
			while(j < finish & Kind(points[j]) = kind) {
				j += 1;
			};
			return j;
		}

		# 0 letter, 1 number, 2 other, 3 whitespace
		function : Kind(cp : Int) ~ Int {
			if(IsSpace(cp)) {
				return 3;
			};
			if(WordPieceText->InRanges(WordPieceUnicode->GetLetters(), cp)) {
				return 0;
			};
			if(WordPieceText->InRanges(WordPieceUnicode->GetNumbers(), cp)) {
				return 1;
			};
			return 2;
		}

		# Unicode White_Space, as the regex's \s
		function : IsSpace(cp : Int) ~ Bool {
			return (cp >= 0x09 & cp <= 0x0D) | cp = 0x20 | cp = 0x85 | cp = 0xA0 | cp = 0x1680 |
				(cp >= 0x2000 & cp <= 0x200A) | cp = 0x2028 | cp = 0x2029 | cp = 0x202F | cp = 0x205F | cp = 0x3000;
		}

		# one piece: its UTF-8 bytes as byte-level characters, merged, each token with the
		# offsets of the characters its bytes came from
		method : EncodePiece(points : Int[], start : Int, finish : Int, shift : Int, sequence : BpeSequence) ~ Nil {
			key := "";
			owners := IntVector->New();
			for(k := start; k < finish; k += 1;) {
				bytes := Utf8One(points[k]);
				each(b : bytes) {
					key += @byte_chars[bytes[b]];
					owners->AddBack(k);
				};
			};

			word := Merge(key);
			symbols := word->GetSymbols();
			at := 0;
			each(s : symbols) {
				symbol := symbols[s];
				first := owners->Get(at);
				last := owners->Get(at + symbol->Size() - 1);
				at += symbol->Size();

				char_start := first + shift;
				char_end := last + 1 + shift;
				if(char_start < 0) {
					char_start := 0;
				};
				if(char_end < char_start) {
					char_end := char_start;
				};

				id := Id(symbol);
				if(id < 0) {
					id := @unk_id;
				};
				sequence->Add(id, symbol, char_start, char_end);
			};
		}

		# BPE: merge the adjacent pair of lowest rank, every occurrence, until none is listed
		method : Merge(key : String) ~ BpeWord {
			cached := @cache->Find(key);
			if(cached <> Nil) {
				return cached;
			};

			symbols := Vector->New()<String>;
			each(i : key) {
				symbols->AddBack(CharString(key->Get(i)));
			};

			done := false;
			while(<>done & symbols->Size() > 1) {
				best := -1;
				best_rank := -1;
				for(i := 0; i + 1 < symbols->Size(); i += 1;) {
					pair := symbols->Get(i)->Clone();
					pair += ' ';
					pair += symbols->Get(i + 1);
					rank := @ranks->Find(pair);
					if(rank <> Nil & (best < 0 | rank->Get() < best_rank)) {
						best := i;
						best_rank := rank->Get();
					};
				};

				if(best < 0) {
					done := true;
				}
				else {
					left := symbols->Get(best)->Clone();
					right := symbols->Get(best + 1)->Clone();
					merged := Vector->New()<String>;
					i := 0;
					while(i < symbols->Size()) {
						if(i + 1 < symbols->Size() & symbols->Get(i)->Equals(left) & symbols->Get(i + 1)->Equals(right)) {
							joined := left->Clone();
							joined += right;
							merged->AddBack(joined);
							i += 2;
						}
						else {
							merged->AddBack(symbols->Get(i));
							i += 1;
						};
					};
					symbols := merged;
				};
			};

			word := BpeWord->New(symbols->ToArray());
			@cache->Insert(key, word);
			return word;
		}

		# Hugging Face's ByteLevel process_offsets: a token's offsets leave out the spaces (Ġ) it
		# starts or ends with; the first token keeps its prefix space when one was added
		method : TrimOffsets(sequence : BpeSequence) ~ Nil {
			space := @byte_chars[32];
			tokens := sequence->GetTokens();
			starts := sequence->GetStarts();
			ends := sequence->GetEnds();
			each(i : tokens) {
				token := tokens->Get(i);
				leading := 0;
				while(leading < token->Size() & CharString(token->Get(leading))->Equals(space)) {
					leading += 1;
				};
				trailing := 0;
				while(trailing < token->Size() & CharString(token->Get(token->Size() - 1 - trailing))->Equals(space)) {
					trailing += 1;
				};

				start := starts->Get(i);
				finish := ends->Get(i);
				if(leading > 0) {
					if((i = 0 | start = 0) & @add_prefix_space & leading = 1) {
						leading := 0;
					};
					start := start + leading;
					if(start > finish) {
						start := finish;
					};
				};
				if(trailing > 0 & finish >= trailing) {
					finish := finish - trailing;
					if(finish < start) {
						finish := start;
					};
				};
				starts->Set(start, i);
				ends->Set(finish, i);
			};
		}

		method : Layout(a : BpeSequence, keep_a : Int, b : BpeSequence, keep_b : Int, max_len : Int, truncated : Bool) ~ TokenEncoding {
			ids := Int->New[max_len];
			mask := Int->New[max_len];
			types := Int->New[max_len];
			tokens := String->New[max_len];
			offsets := Int->New[2 * max_len];

			at := 0;
			at := Put(ids, mask, tokens, offsets, at, @cls_id, @cls_token, 0, 0);
			at := Copy(a, keep_a, ids, mask, tokens, offsets, at);
			at := Put(ids, mask, tokens, offsets, at, @sep_id, @sep_token, 0, 0);
			if(b <> Nil) {
				at := Put(ids, mask, tokens, offsets, at, @sep_id, @sep_token, 0, 0);
				at := Copy(b, keep_b, ids, mask, tokens, offsets, at);
				at := Put(ids, mask, tokens, offsets, at, @sep_id, @sep_token, 0, 0);
			};
			length := at;
			while(at < max_len) {
				ids[at] := @pad_id;
				tokens[at] := @pad_token;
				at += 1;
			};

			return TokenEncoding->New(ids, mask, types, tokens, length, truncated, offsets);
		}

		function : Put(ids : Int[], mask : Int[], tokens : String[], offsets : Int[], at : Int, id : Int, token : String, start : Int, finish : Int) ~ Int {
			ids[at] := id;
			mask[at] := 1;
			tokens[at] := token;
			offsets[2 * at] := start;
			offsets[2 * at + 1] := finish;
			return at + 1;
		}

		function : Copy(sequence : BpeSequence, keep : Int, ids : Int[], mask : Int[], tokens : String[], offsets : Int[], at : Int) ~ Int {
			for(i := 0; i < keep; i += 1;) {
				at := Put(ids, mask, tokens, offsets, at, sequence->GetIds()->Get(i), sequence->GetTokens()->Get(i),
					sequence->GetStarts()->Get(i), sequence->GetEnds()->Get(i));
			};
			return at;
		}

		# --- bytes ---

		# GPT-2's bytes_to_unicode: printable bytes stand for themselves, the rest for
		# U+0100 onward, so every byte is one visible character
		method : InitBytes() ~ Nil {
			@byte_chars := String->New[256];
			@char_bytes := Hash->New()<String, IntRef>;
			next := 256;
			for(b := 0; b < 256; b += 1;) {
				cp := b;
				if(<>((b >= 0x21 & b <= 0x7E) | (b >= 0xA1 & b <= 0xAC) | (b >= 0xAE & b <= 0xFF))) {
					cp := next;
					next += 1;
				};
				@byte_chars[b] := CharString(cp->As(Char));
				@char_bytes->Insert(@byte_chars[b], IntRef->New(b));
			};
		}

		function : CharString(c : Char) ~ String {
			text := String->New();
			text->Append(c);
			return text;
		}

		function : Utf8One(cp : Int) ~ Int[] {
			if(cp < 0x80) {
				return [cp];
			};
			if(cp < 0x800) {
				return [0xC0 or (cp >> 6), 0x80 or (cp and 0x3F)];
			};
			if(cp < 0x10000) {
				return [0xE0 or (cp >> 12), 0x80 or ((cp >> 6) and 0x3F), 0x80 or (cp and 0x3F)];
			};
			return [0xF0 or (cp >> 18), 0x80 or ((cp >> 12) and 0x3F), 0x80 or ((cp >> 6) and 0x3F), 0x80 or (cp and 0x3F)];
		}

		function : Utf8(points : Int[]) ~ IntVector {
			bytes := IntVector->New();
			each(i : points) {
				one := Utf8One(points[i]);
				each(j : one) {
					bytes->AddBack(one[j]);
				};
			};
			return bytes;
		}

		# UTF-8 to code points; a malformed sequence becomes U+FFFD
		function : FromUtf8(bytes : Int[]) ~ Int[] {
			points := IntVector->New();
			i := 0;
			while(i < bytes->Size()) {
				b := bytes[i];
				need := 0;
				cp := 0xFFFD;
				if(b < 0x80) {
					cp := b;
				}
				else if((b and 0xE0) = 0xC0) {
					need := 1;
					cp := b and 0x1F;
				}
				else if((b and 0xF0) = 0xE0) {
					need := 2;
					cp := b and 0x0F;
				}
				else if((b and 0xF8) = 0xF0) {
					need := 3;
					cp := b and 0x07;
				};

				ok := i + need < bytes->Size() | need = 0;
				for(k := 1; ok & k <= need; k += 1;) {
					c := bytes[i + k];
					if((c and 0xC0) <> 0x80) {
						ok := false;
					}
					else {
						cp := (cp << 6) or (c and 0x3F);
					};
				};
				if(ok & b >= 0x80 & need = 0) {
					ok := false;
				};

				if(ok) {
					points->AddBack(cp);
					i += need + 1;
				}
				else {
					points->AddBack(0xFFFD);
					i += 1;
				};
			};
			return points->ToArray();
		}
	}

	# a special token matched in the text: its code points, id and whitespace rules
	class : private : BpeAdded {
		@points : Int[];
		@content : String;
		@id : Int;
		@lstrip : Bool;
		@rstrip : Bool;

		New(points : Int[], content : String, id : Int, lstrip : Bool, rstrip : Bool) {
			@points := points;
			@content := content;
			@id := id;
			@lstrip := lstrip;
			@rstrip := rstrip;
		}

		method : public : GetPoints() ~ Int[] { return @points; }
		method : public : GetContent() ~ String { return @content; }
		method : public : GetLength() ~ Int { return @points->Size(); }
		method : public : GetId() ~ Int { return @id; }
		method : public : IsLstrip() ~ Bool { return @lstrip; }
		method : public : IsRstrip() ~ Bool { return @rstrip; }
	}

	# a piece's tokens after merging, cached by the piece
	class : private : BpeWord {
		@symbols : String[];

		New(symbols : String[]) {
			@symbols := symbols;
		}

		method : public : GetSymbols() ~ String[] { return @symbols; }
	}

	# one text's tokens before special tokens: ids, strings and character offsets
	class : private : BpeSequence {
		@ids : IntVector;
		@tokens : Vector<String>;
		@starts : IntVector;
		@ends : IntVector;

		New() {
			@ids := IntVector->New();
			@tokens := Vector->New()<String>;
			@starts := IntVector->New();
			@ends := IntVector->New();
		}

		method : public : Add(id : Int, token : String, start : Int, finish : Int) ~ Nil {
			@ids->AddBack(id);
			@tokens->AddBack(token);
			@starts->AddBack(start);
			@ends->AddBack(finish);
		}

		method : public : Size() ~ Int { return @ids->Size(); }
		method : public : GetIds() ~ IntVector { return @ids; }
		method : public : GetTokens() ~ Vector<String> { return @tokens; }
		method : public : GetStarts() ~ IntVector { return @starts; }
		method : public : GetEnds() ~ IntVector { return @ends; }
	}

	# Code points, and the Unicode properties BERT's BasicTokenizer uses. Objeck's Char is a
	# UTF-16 unit on Windows and a code point elsewhere; text is decoded to code points so the
	# same text tokenizes the same everywhere.
	class : private : WordPieceText {
		# Whether a String stores a code point past U+FFFF as one Char (false where strings are
		# UTF-16). A Char VALUE holds any code point everywhere; only the storage differs, so the
		# question is asked of storage.
		function : IsWide() ~ Bool {
			return <>String->IsUtf16Storage();
		}

		function : Decode(text : String) ~ Int[] {
			points := IntVector->New();
			size := text->Size();
			i := 0;
			while(i < size) {
				cp := text->Get(i)->As(Int);
				if(cp >= 0xD800 & cp <= 0xDBFF & i + 1 < size) {
					low := text->Get(i + 1)->As(Int);
					if(low >= 0xDC00 & low <= 0xDFFF) {
						cp := 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
						i += 1;
					};
				};
				points->AddBack(cp);
				i += 1;
			};

			return points->ToArray();
		}

		function : Encode(points : Int[]) ~ String {
			text := String->New();
			each(i : points) {
				AppendCodePoint(text, points[i]);
			};
			return text;
		}

		# String->Append(Char) stores a code point past U+FFFF as a surrogate pair where strings
		# are UTF-16 (#1185)
		function : AppendCodePoint(text : String, cp : Int) ~ Nil {
			text->Append(cp->As(Char));
		}

		function : InRanges(ranges : Int[], cp : Int) ~ Bool {
			lo := 0;
			hi := ranges->Size() / 2 - 1;
			while(lo <= hi) {
				mid := (lo + hi) / 2;
				if(cp < ranges[mid * 2]) {
					hi := mid - 1;
				}
				else if(cp > ranges[mid * 2 + 1]) {
					lo := mid + 1;
				}
				else {
					return true;
				};
			};
			return false;
		}

		function : IsWhitespace(cp : Int) ~ Bool {
			# space, tab, newline, carriage return, and the Zs category
			return cp = 32 | cp = 9 | cp = 10 | cp = 13 | cp = 0xA0 | cp = 0x1680 |
				(cp >= 0x2000 & cp <= 0x200A) | cp = 0x202F | cp = 0x205F | cp = 0x3000;
		}

		function : IsControl(cp : Int) ~ Bool {
			if(cp = 9 | cp = 10 | cp = 13) {
				return false;
			};
			return InRanges(WordPieceUnicode->GetControl(), cp);
		}

		function : IsPunctuation(cp : Int) ~ Bool {
			# every non-alphanumeric ASCII character counts, as BERT has it, '$' and '^' too
			if((cp >= 33 & cp <= 47) | (cp >= 58 & cp <= 64) | (cp >= 91 & cp <= 96) | (cp >= 123 & cp <= 126)) {
				return true;
			};
			if(cp < 128) {
				return false;
			};
			return InRanges(WordPieceUnicode->GetPunctuation(), cp);
		}

		function : IsChinese(cp : Int) ~ Bool {
			return (cp >= 0x4E00 & cp <= 0x9FFF) | (cp >= 0x3400 & cp <= 0x4DBF) |
				(cp >= 0x20000 & cp <= 0x2A6DF) | (cp >= 0x2A700 & cp <= 0x2B73F) |
				(cp >= 0x2B740 & cp <= 0x2B81F) | (cp >= 0x2B820 & cp <= 0x2CEAF) |
				(cp >= 0xF900 & cp <= 0xFAFF) | (cp >= 0x2F800 & cp <= 0x2FA1F);
		}

		function : IsMark(cp : Int) ~ Bool {
			if(cp < 0x300) {
				return false;
			};
			return InRanges(WordPieceUnicode->GetMarks(), cp);
		}

		# One code point's lowercase, or the code point itself
		function : LowerOne(cp : Int) ~ Int {
			if(cp < 128) {
				if(cp >= 65 & cp <= 90) {
					return cp + 32;
				};
				return cp;
			};

			runs := WordPieceUnicode->GetLower();
			lo := 0;
			hi := runs->Size() / 4 - 1;
			found := -1;
			while(lo <= hi) {
				mid := (lo + hi) / 2;
				if(runs[mid * 4] <= cp) {
					found := mid;
					lo := mid + 1;
				}
				else {
					hi := mid - 1;
				};
			};

			if(found >= 0) {
				start := runs[found * 4];
				end := runs[found * 4 + 1];
				step := runs[found * 4 + 2];
				if(cp <= end & (cp - start) % step = 0) {
					return cp + runs[found * 4 + 3];
				};
			};

			return cp;
		}

		function : IsGreekLetter(cp : Int) ~ Bool {
			return (cp >= 0x386 & cp <= 0x3FF & cp <> 0x387) | (cp >= 0x1F00 & cp <= 0x1FFC);
		}

		# Python's str.lower() of a word: U+0130 becomes two code points, and a capital sigma
		# that ends a Greek word becomes the final sigma
		function : Lower(points : Int[]) ~ Int[] {
			out := IntVector->New();
			size := points->Size();
			each(i : points) {
				cp := points[i];
				if(cp = 0x130) {
					out->AddBack(0x69);
					out->AddBack(0x307);
				}
				else if(cp = 0x3A3) {
					before := i > 0 & IsGreekLetter(points[i - 1]);
					after := i + 1 < size & IsGreekLetter(points[i + 1]);
					if(before & <>after) {
						out->AddBack(0x3C2);
					}
					else {
						out->AddBack(0x3C3);
					};
				}
				else {
					out->AddBack(LowerOne(cp));
				};
			};

			return out->ToArray();
		}

		# NFD, then drop the nonspacing marks
		function : StripAccents(points : Int[]) ~ Int[] {
			keys := WordPieceUnicode->GetStripKeys();
			offsets := WordPieceUnicode->GetStripOffsets();
			values := WordPieceUnicode->GetStripValues();

			out := IntVector->New();
			each(i : points) {
				cp := points[i];
				if(cp >= 0xAC00 & cp <= 0xD7A3) {
					# Hangul syllable: leading consonant, vowel, optional trailing consonant
					s := cp - 0xAC00;
					out->AddBack(0x1100 + s / 588);
					out->AddBack(0x1161 + (s % 588) / 28);
					if(s % 28 <> 0) {
						out->AddBack(0x11A7 + s % 28);
					};
				}
				else if(cp < 0xC0) {
					out->AddBack(cp);
				}
				else {
					at := Find(keys, cp);
					if(at >= 0) {
						for(j := offsets[at]; j < offsets[at + 1]; j += 1;) {
							out->AddBack(values[j]);
						};
					}
					else if(<>IsMark(cp)) {
						out->AddBack(cp);
					};
				};
			};

			return out->ToArray();
		}

		function : Find(keys : Int[], cp : Int) ~ Int {
			lo := 0;
			hi := keys->Size() - 1;
			while(lo <= hi) {
				mid := (lo + hi) / 2;
				if(keys[mid] < cp) {
					lo := mid + 1;
				}
				else if(keys[mid] > cp) {
					hi := mid - 1;
				}
				else {
					return mid;
				};
			};
			return -1;
		}
	}

	# BEGIN GENERATED UNICODE TABLES (tools/nlp/gen_wordpiece_tables.py)
	# Unicode 13.0.0, from Python 3.10.11's unicodedata. Do not edit by hand.
	class : private : WordPieceUnicode {
		@punctuation : static : Int[];
		@control : static : Int[];
		@marks : static : Int[];
		@lower : static : Int[];
		@strip_keys : static : Int[];
		@strip_offsets : static : Int[];
		@strip_values : static : Int[];
		@letters : static : Int[];
		@numbers : static : Int[];

		# Two threads racing here each build the same arrays; either result is right.
		function : Init() ~ Nil {
			if(@strip_values = Nil) {
				@punctuation := Punctuation();
				@control := Control();
				@marks := Marks();
				@lower := Lower();
				@strip_keys := StripKeys();
				@strip_offsets := StripOffsets();
				@strip_values := StripValues();
			};
			if(@numbers = Nil) {
				@letters := Letters();
				@numbers := Numbers();
			};
		}

		function : GetPunctuation() ~ Int[] { Init(); return @punctuation; }
		function : GetControl() ~ Int[] { Init(); return @control; }
		function : GetMarks() ~ Int[] { Init(); return @marks; }
		function : GetLower() ~ Int[] { Init(); return @lower; }
		function : GetStripKeys() ~ Int[] { Init(); return @strip_keys; }
		function : GetStripOffsets() ~ Int[] { Init(); return @strip_offsets; }
		function : GetStripValues() ~ Int[] { Init(); return @strip_values; }
		function : GetLetters() ~ Int[] { Init(); return @letters; }
		function : GetNumbers() ~ Int[] { Init(); return @numbers; }

		function : private : Punctuation() ~ Int[] {
			return [
				0x21, 0x23, 0x25, 0x2A, 0x2C, 0x2F, 0x3A, 0x3B, 0x3F, 0x40, 0x5B, 0x5D,
