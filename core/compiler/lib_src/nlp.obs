	# END GENERATED UNICODE TABLES

	#~
	A tokenizer for sequences of API calls, as malware-analysis datasets record them:
	CreateFileW,ReadFile,CloseHandle or the same separated by spaces or semicolons.

	Fit builds a vocabulary from training data: [PAD]=0, [UNK]=1, [CLS]=2, [SEP]=3, then each
	API name by descending frequency, ties by name, so the same data always gives the same
	ids. Encode gives a TokenEncoding like WordPieceTokenizer's: [CLS], the first max_len - 2
	calls, [SEP], then [PAD]. Names are case-sensitive unless asked otherwise.

	Its ids are for a model trained on them. A pretrained BERT knows only its own WordPiece
	vocabulary, so for BERT pass the calls as text instead: ToText normalises the separators
	and truncates by call count, and WordPieceTokenizer splits "CreateFileW" into its pieces.

```
apis := ApiSequenceTokenizer->New();
apis->Fit(["CreateFileW,ReadFile,CloseHandle", "RegOpenKeyExA RegSetValueExA"]);
encoding := apis->Encode("CreateFileW;WriteFile", 8);   # [CLS] CreateFileW [UNK] [SEP] [PAD]...
text := apis->ToText("CreateFileW,ReadFile", 0);        # "CreateFileW ReadFile"
```
	~#
	class ApiSequenceTokenizer {
		@vocab : Hash<String, IntRef>;
		@tokens : Vector<String>;
		@lower_case : Bool;
		@min_count : Int;

		#~
		An empty tokenizer, case-sensitive, keeping every name seen at least once.
		~#
		New() {
			@lower_case := false;
			@min_count := 1;
			Reset();
		}

		#~
		An empty tokenizer.
		@param lower_case fold names to lowercase
		@param min_count least number of training occurrences for a name to get an id; rarer
		names encode as [UNK]
		~#
		New(lower_case : Bool, min_count : Int) {
			@lower_case := lower_case;
			@min_count := min_count;
			if(@min_count < 1) {
				@min_count := 1;
			};
			Reset();
		}

		method : Reset() ~ Nil {
			@vocab := Hash->New()<String, IntRef>;
			@tokens := Vector->New()<String>;
			Add("[PAD]");
			Add("[UNK]");
			Add("[CLS]");
			Add("[SEP]");
		}

		method : Add(token : String) ~ Nil {
			@vocab->Insert(token, IntRef->New(@tokens->Size()));
			@tokens->AddBack(token);
		}

		#~
		Splits a sequence into API names at commas, semicolons and whitespace, dropping empty
		names, and lowercasing them if configured.
		@param sequence the calls
		@return the names
		~#
		method : public : Split(sequence : String) ~ String[] {
			names := Vector->New()<String>;
			if(sequence = Nil) {
				return names->ToArray();
			};

			name := String->New();
			size := sequence->Size();
			for(i := 0; i <= size; i += 1;) {
				boundary := i = size;
				c := ' ';
				if(<>boundary) {
					c := sequence->Get(i);
					boundary := c = ',' | c = ';' | Char->IsWhitespace(c);
				};

				if(boundary) {
					if(name->Size() > 0) {
						if(@lower_case) {
							names->AddBack(name->ToLower());
						}
						else {
							names->AddBack(name);
						};
						name := String->New();
					};
				}
				else {
					name->Append(c);
				};
			};

			return names->ToArray();
		}

		#~
		Builds the vocabulary from training sequences, replacing any earlier one.
		@param sequences training sequences
		@return the vocabulary size, special tokens included
		~#
		method : public : Fit(sequences : String[]) ~ Int {
			Reset();
			if(sequences = Nil) {
				return @tokens->Size();
			};

			counts := Hash->New()<String, IntRef>;
			each(i : sequences) {
				names := Split(sequences[i]);
				each(j : names) {
					count := counts->Find(names[j]);
					if(count = Nil) {
						counts->Insert(names[j], IntRef->New(1));
					}
					else {
						count->Set(count->Get() + 1);
					};
				};
			};

			keys := counts->GetKeys()<String>;
			names := String->New[keys->Size()];
			freqs := Int->New[keys->Size()];
			each(i : keys) {
				names[i] := keys->Get(i);
				freqs[i] := counts->Find(names[i])->Get();
			};
			SortByCount(names, freqs);

			each(i : names) {
				if(freqs[i] >= @min_count & <>@vocab->Has(names[i])) {
					Add(names[i]);
				};
			};

			return @tokens->Size();
		}

		# bottom-up merge sort, stable: count descending, then name ascending
		function : SortByCount(names : String[], freqs : Int[]) ~ Nil {
			size := names->Size();
			tmp_names := String->New[size];
			tmp_freqs := Int->New[size];
			width := 1;
			while(width < size) {
				lo := 0;
				while(lo < size) {
					mid := lo + width;
					if(mid > size) { mid := size; };
					hi := lo + 2 * width;
					if(hi > size) { hi := size; };

					a := lo; b := mid; k := lo;
					while(k < hi) {
						take_a := false;
						if(a < mid & b < hi) {
							take_a := freqs[a] > freqs[b] | (freqs[a] = freqs[b] & names[a]->Compare(names[b]) <= 0);
						}
						else {
							take_a := a < mid;
						};

						if(take_a) {
							tmp_names[k] := names[a]; tmp_freqs[k] := freqs[a]; a += 1;
						}
						else {
							tmp_names[k] := names[b]; tmp_freqs[k] := freqs[b]; b += 1;
						};
						k += 1;
					};
					lo := hi;
				};

				for(i := 0; i < size; i += 1;) {
					names[i] := tmp_names[i];
					freqs[i] := tmp_freqs[i];
				};
				width *= 2;
			};
		}

		#~
		Encodes a sequence: [CLS], the first max_len - 2 calls, [SEP], then [PAD] to exactly
		max_len. A name not in the vocabulary is [UNK].
		@param sequence the calls
		@param max_len the length to truncate and pad to, at least 2
		@return the encoding, or Nil when max_len is below 2
		~#
		method : public : Encode(sequence : String, max_len : Int) ~ TokenEncoding {
			if(max_len < 2) {
				return Nil;
			};

			names := Split(sequence);
			keep := names->Size();
			truncated := false;
			if(keep > max_len - 2) {
				keep := max_len - 2;
				truncated := true;
			};

			ids := Int->New[max_len];
			mask := Int->New[max_len];
			types := Int->New[max_len];
			tokens := String->New[max_len];

			ids[0] := 2; tokens[0] := "[CLS]"; mask[0] := 1;
			for(i := 0; i < keep; i += 1;) {
				id := TokenToId(names[i]);
				if(id < 0) {
					ids[i + 1] := 1;
					tokens[i + 1] := "[UNK]";
				}
				else {
					ids[i + 1] := id;
					tokens[i + 1] := names[i];
				};
				mask[i + 1] := 1;
			};
			ids[keep + 1] := 3; tokens[keep + 1] := "[SEP]"; mask[keep + 1] := 1;
			for(i := keep + 2; i < max_len; i += 1;) {
				tokens[i] := "[PAD]";
			};

			return TokenEncoding->New(ids, mask, types, tokens, keep + 2, truncated);
		}

		#~
		Encodes several sequences, each with Encode.
		@param sequences the sequences
		@param max_len the length to truncate and pad to
		@return one encoding per sequence, or Nil when max_len is below 2
		~#
		method : public : EncodeBatch(sequences : String[], max_len : Int) ~ TokenEncoding[] {
			if(sequences = Nil | max_len < 2) {
				return Nil;
			};

			out := TokenEncoding->New[sequences->Size()];
			each(i : sequences) {
				out[i] := Encode(sequences[i], max_len);
			};
			return out;
		}

		#~
		The calls as text for a WordPiece tokenizer: names separated by single spaces.
		@param sequence the calls
		@param max_calls keep at most this many calls; 0 or less keeps all
		@return the text
		~#
		method : public : ToText(sequence : String, max_calls : Int) ~ String {
			names := Split(sequence);
			keep := names->Size();
			if(max_calls > 0 & keep > max_calls) {
				keep := max_calls;
			};

			text := String->New();
			for(i := 0; i < keep; i += 1;) {
				if(i > 0) {
					text->Append(' ');
				};
				text->Append(names[i]);
			};
			return text;
		}

		#~
		Turns ids back into API names separated by spaces, leaving out the special tokens.
		@param ids token ids
		@return the names
		~#
		method : public : Decode(ids : Int[]) ~ String {
			text := String->New();
			if(ids = Nil) {
				return text;
			};

			each(i : ids) {
				id := ids[i];
				if(id > 3) {
					token := IdToToken(id);
					if(token <> Nil) {
						if(text->Size() > 0) {
							text->Append(' ');
						};
						text->Append(token);
					};
				};
			};
			return text;
		}

		#~
		Number of tokens in the vocabulary, special tokens included.
		@return vocabulary size
		~#
		method : public : GetVocabSize() ~ Int {
			return @tokens->Size();
		}

		#~
		A name's id.
		@param token an API name or special token
		@return its id, or -1 when the vocabulary lacks it
		~#
		method : public : TokenToId(token : String) ~ Int {
			if(token = Nil) {
				return -1;
			};

			key := token;
			if(@lower_case & <>token->StartsWith('[')) {
				key := token->ToLower();
			};
			id := @vocab->Find(key);
			if(id = Nil) {
				return -1;
			};
			return id->Get();
		}

		#~
		The name with an id.
		@param id token id
		@return the name, or Nil when the id is out of range
		~#
		method : public : IdToToken(id : Int) ~ String {
			if(id < 0 | id >= @tokens->Size()) {
				return Nil;
			};
			return @tokens->Get(id);
		}

		#~
		Writes the vocabulary, one token per line, the line number its id: the vocab.txt layout.
		@param path the file
		@return true when written
		~#
		method : public : Save(path : String) ~ Bool {
			writer := System.IO.Filesystem.FileWriter->New(path);
			if(<>writer->IsOpen()) {
				return false;
			};

			each(i : @tokens) {
				line := @tokens->Get(i);
				writer->WriteString("{$line}\n");
			};
			writer->Close();
			return true;
		}

		#~
		Reads a vocabulary Save wrote.
		@param path the file
		@param lower_case fold names to lowercase, as the tokenizer that saved it did
		@return the tokenizer, or Nil when the file cannot be read or does not start with
		[PAD], [UNK], [CLS], [SEP]
		~#
		function : Load(path : String, lower_case : Bool) ~ ApiSequenceTokenizer {
			if(path = Nil) {
				return Nil;
			};

			reader := System.IO.Filesystem.FileReader->New(path);
			if(<>reader->IsOpen()) {
				return Nil;
			};

			lines := Vector->New()<String>;
			line := reader->ReadLine();
			while(line <> Nil) {
				lines->AddBack(line);
				line := reader->ReadLine();
			};
			reader->Close();

			if(lines->Size() < 4 | <>lines->Get(0)->Equals("[PAD]") | <>lines->Get(1)->Equals("[UNK]") |
					<>lines->Get(2)->Equals("[CLS]") | <>lines->Get(3)->Equals("[SEP]")) {
				return Nil;
			};

			tokenizer := ApiSequenceTokenizer->New(lower_case, 1);
			for(i := 4; i < lines->Size(); i += 1;) {
				tokenizer->AddToken(lines->Get(i));
			};
			return tokenizer;
		}

		method : AddToken(token : String) ~ Nil {
			if(<>token->IsEmpty() & <>@vocab->Has(token)) {
				Add(token);
			};
		}
	}
}
