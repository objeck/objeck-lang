use Collection;

#~
CSV reading and writing. CsvTable parses delimited text (RFC 4180: quoted fields may hold the delimiter, line breaks and doubled quotes) into CsvRow records and CsvColumn values, reports the first malformed row through GetError(), and writes CSV back out with ToString() or CsvTable->FormatRow(). The delimiter defaults to a comma and can be set per table. Compile with -lib csv.
~#
bundle Data.CSV {
	#~
	CSV row

```
csv := CsvTable->New(FileReader->ReadFile("data.csv"));
row := csv->Get(0);
row->Get(0)->PrintLine();       # by index
row->Get("name")->PrintLine();  # by column name
row->Size()->PrintLine();       # column count
```
	~#
	class CsvRow {
		@table : CsvTable;
		@id : Int;
		@columns : CompareVector<String>;
		@read_only : Bool;

		#~
		Constructor
		@param table table that has row
		@param id row id
		@param read_only true if readonly, false otherwise
		@param columns column values
		~#
		New(table : CsvTable, id : Int, read_only : Bool, columns : CompareVector<String>) {
			@table := table;
			@id := id;
			@read_only := read_only;
			@columns := columns;
		}
		
		#~
		Gets the row ID
		@return id

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
row := csv->Get(1);
Console->PrintLine(row->Id());
```
		~#
		method : public : Id() ~ Int {
			return @id;
		}

		#~
		Gets the indexed row value
		@param index index
		@return row value

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
row := csv->Get(1);
row->Get(0)->PrintLine();
row->Get(1)->PrintLine();
```
		~#
		method : public : Get(index : Int) ~ String {
			if(index < @columns->Size()) {
				return @columns->Get(index);
			};
			
			return Nil;
		}

		#~
		Gets the indexed row value
		@param name name
		@return row value

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
row := csv->Get(1);
row->Get("name")->PrintLine();
row->Get("age")->PrintLine();
```
		~#
		method : public : Get(name : String) ~ String {
			index := @table->GetRowId(name);
			if(index < @columns->Size()) {
				return @columns->Get(index);
			};
			
			return Nil;
		}
		
		#~
		Sets the indexed row value
		@param value value to set
		@param index index
		@return true of value was set, false otherwise

```
csv := CsvTable->New("name,score\r\nAlice,0\r\nBob,0");
row := csv->Get(1);
row->Set(1, "95");
row->Get(1)->PrintLine();
```
		~#
		method : public : Set(index : Int, value : String) ~ Bool {
			if(@read_only = false & index < @columns->Size()) {
				# stored as given: ToString() escapes quotes when the row is written
				return @columns->Set(value, index);
			};
			
			return false;
		}

		#~
		Sets the named row value
		@param name name
		@param value value
		@return true of value was set, false otherwise

```
csv := CsvTable->New("name,score\r\nAlice,0\r\nBob,0");
row := csv->Get(1);
row->Set("score", "88");
row->Get("score")->PrintLine();
```
		~#
		method : public : Set(name : String, value : String) ~ Bool {
			return Set(@table->GetRowId(name), value);
		}
		
		#~
		Appends value to the end of the row
		@param value to append

```
csv := CsvTable->New("name,age\r\nAlice,30");
row := csv->Get(1);
row->Append("engineer");
Console->PrintLine(row->Size());
```
		~#
		method : public : Append(value : String) ~ Nil {
			@columns->AddBack(value);
		}
		
		#~
		Gets the row size
		@return row size

```
csv := CsvTable->New("a,b,c\r\n1,2,3");
row := csv->Get(1);
Console->PrintLine(row->Size());
```
		~#
		method : public : Size() ~ Int {
			return @columns->Size();
		}
		
		#~
		Calculates the row sum
		@return row sum

```
csv := CsvTable->New("a,b,c\r\n10,20,30");
row := csv->Get(1);
Console->PrintLine(row->Sum());
```
		~#
		method : public : Sum() ~ Float {
			return Sum(0, @columns->Size());
		}

		#~
		Calculates the row sum
		@param end ending column
		@return row sum
		~#
		method : public : Sum(end : Int) ~ Float {
			return Sum(0, end);
		}

		#~
		Calculates the row sum
		@param start starting column
		@param end ending column
		@return row sum
		~#
		method : public : Sum(start : Int, end : Int) ~ Float {
			sum := 0.0;
			
			length := end - start;
			offset := start + length;

# "length={$length}, offset={$offset}"->PrintLine();

			if(length > 0 & offset <= @columns->Size()) {
				for(i := start; i < offset; i += 1;) {
					sum += @columns->Get(i)->ToFloat();
				};
			};
			
			return sum;
		}
		
		#~
		Calculates the row average
		@return row average

```
csv := CsvTable->New("a,b,c\r\n10,20,30");
row := csv->Get(1);
Console->PrintLine(row->Average());
```
		~#
		method : public : Average() ~ Float {
			return Average(0, @columns->Size());
		}

		#~
		Calculates the row average
		@param end ending column
		@return row average
		~#
		method : public : Average(end : Int) ~ Float {
			return Average(0, end);
		}

		#~
		Calculates the row average
		@param start starting column
		@param end ending column
		@return row average
		~#
		method : public : Average(start : Int, end : Int) ~ Float {
			if(@columns->Size() = 0) {
				return 0.0;
			};

			# An empty range has no average. The guard above covers an empty
			# container but not start = end, and Objeck RAISES on a divide by
			# zero rather than yielding NaN -- so Average(1, 1) on a populated
			# table aborted the VM rather than returning anything.
			if(end - start <= 0) {
				return 0.0;
			};

			return Sum(start, end) / (end - start);
		}

		#~
		Calculates the row median
		@return row median

```
csv := CsvTable->New("a,b,c,d\r\n1,3,5,7");
row := csv->Get(1);
Console->PrintLine(row->Median());
```
		~#
		method : public : Median() ~ Float {
			if(@columns->Size() = 1) {
				return @columns->Get(0)->ToFloat();
			};

			# a plain Float[] sorted in place: no FloatRef per value, and no vector
			values := Float->New[@columns->Size()];
			each(i : @columns) {
				values[i] := @columns->Get(i)->ToFloat();
			};
			ArraySort->Sort(values);

			# find median
			size := values->Size();
			if(size % 2 = 0) {
				return (values[size / 2 - 1] + values[size / 2]) / 2;
			}
			else {
				return values[size / 2];
			};
		}
		
		#~
		Formats the row as one CSV record: every field is quoted, a quote inside
		a field is doubled, and fields are separated by the table's delimiter.
		CsvTable parses the result back to the same values.
		@return string representation of the row

```
csv := CsvTable->New("name,age\r\nAlice,30");
row := csv->Get(1);
row->ToString()->PrintLine();
```
		~#
		method : public : ToString() ~ String {
			delimiter := @table->GetDelimiter();
			buffer := "";

			each(i : @columns) {
				value := @columns->Get(i);
				buffer->Append('"');
				if(value <> Nil) {
					if(value->Has('"')) {
						buffer->Append(value->ReplaceAll("\"", "\"\""));
					}
					else {
						buffer->Append(value);
					};
				};
				buffer->Append('"');
				if(i + 1 < @columns->Size()) {
					buffer->Append(delimiter);
				};
			};

			return buffer;
		}

		#~
		Formats the row into a JSON object string
		@return JSON object string

```
csv := CsvTable->New("name,age\r\nAlice,30");
row := csv->Get(1);
row->ToJson()->PrintLine();
```
		~#
		method : public : ToJson() ~ String {
			headers := @table->GetHeaders();
			
			buffer := "{";
			each(i : headers) {
				header := headers->Get(i);
				value := @columns->Get(i);

				buffer->Append('"');
				buffer->Append(header);
				buffer->Append("\":");

				if(value->IsInt() | value->IsFloat()) {
					buffer->Append(value);
				}
				else {
					buffer->Append('"');
					buffer->Append(value);
					buffer->Append('"');
				};

				if(i + 1 < headers->Size()) {
					buffer->Append(',');
				};
			};
			buffer->Append('}');
			
			return buffer;
		}
	}
	
