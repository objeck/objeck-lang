	#~
	CSV table

```
csv := CsvTable->New(FileReader->ReadFile("data.csv"));
if(csv->IsParsed()) {
   each(i : csv) {
      row := csv->Get(i);
      row->Get(0)->PrintLine();
   };
};
```
	~#
	class CsvTable {
		@data : Vector<CsvRow>;
		@is_parsed : Bool;
		@header_names : Hash<String, IntRef>;
		@ending : String;
		@auto_ending : Bool;
		@delimiter : Char;
		@error : String;
		@error_row : Int;
		@replace_str : static : String;

		#~
		Constructor. Fields are separated by commas. A record ends at a CRLF, an
		LF or a lone CR outside quotes, so a file written on any platform parses
		without the caller knowing which; ToString() writes back the first ending
		the data used. Use the two-argument constructor to force one ending.
		@param data CSV data

```
csv := CsvTable->New("name,age\nAlice,30\nBob,25");
if(csv->IsParsed()) {
  Console->PrintLine(csv->Size());
};
```
		~#
		New(data : String) {
			Init(data, Nil, ',');
		}

		#~
		Constructor that forces the line ending: only this ending ends a record,
		and any other line break is kept as part of a field.
		@param data CSV data
		@param ending line ending

```
csv := CsvTable->New("name,age\nAlice,30\nBob,25", "\n");
if(csv->IsParsed()) {
  Console->PrintLine(csv->Size());
};
```
		~#
		New(data : String, ending : String) {
			Init(data, ending, ',');
		}

		#~
		Constructor with a custom delimiter, such as a tab or a semicolon. The
		line ending is taken from the data, as for the one-argument constructor.
		@param data CSV data
		@param delimiter field delimiter; not a quote, CR or LF

```
csv := CsvTable->New("name;age\nAlice;30\nBob;25", ';');
if(csv->IsParsed()) {
  csv->Get(1)->Get("age")->PrintLine();
};
```
		~#
		New(data : String, delimiter : Char) {
			Init(data, Nil, delimiter);
		}

		#~
		Constructor with a forced line ending and a custom delimiter
		@param data CSV data
		@param ending line ending
		@param delimiter field delimiter; not a quote, CR or LF

```
csv := CsvTable->New("name\tage\r\nAlice\t30", "\r\n", '\t');
if(csv->IsParsed()) {
  csv->Get(1)->Get("name")->PrintLine();
};
```
		~#
		New(data : String, ending : String, delimiter : Char) {
			Init(data, ending, delimiter);
		}

		method : public : GetReplaceStr() ~ String {
			return @replace_str;
		}

		#~
		Gets the field delimiter
		@return field delimiter

```
csv := CsvTable->New("a;b\n1;2", ';');
csv->GetDelimiter()->PrintLine();
```
		~#
		method : public : GetDelimiter() ~ Char {
			return @delimiter;
		}

		#~
		Gets why the data could not be parsed: the first malformed row, with its
		row number (0 is the header) and the line it starts on, or a missing
		closing quote, or too few rows. A table that parsed returns Nil.
		@return error message, or Nil if the table parsed

```
csv := CsvTable->New("a,b,c\n1,2,3\n4,5");
if(<>csv->IsParsed()) {
  csv->GetError()->PrintLine();
};
```
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Gets the row the parse failed on (0 is the header), or -1 when the table
		parsed or the failure is not tied to one row
		@return failing row number, or -1

```
csv := CsvTable->New("a,b,c\n1,2,3\n4,5");
Console->PrintLine(csv->GetErrorRow());
```
		~#
		method : public : GetErrorRow() ~ Int {
			return @error_row;
		}

		method : Init(data : String, ending : String, delimiter : Char) ~ Nil {
			if(@replace_str = Nil) {
				@replace_str := "";
				@replace_str += 0xfffd->As(Char);
			};

			@delimiter := delimiter;
			@error_row := -1;
			@is_parsed := true;

			# No ending given (or an empty one): any of CRLF, LF or CR ends a record,
			# and ToString() reuses the first one the data contains.
			if(ending = Nil | ending->Size() = 0) {
				@auto_ending := true;
				@ending := "\r\n";
			}
			else {
				@auto_ending := false;
				@ending := ending;
			};

			# No data at all is an unparsed table, not a fault. FileReader->ReadFile
			# returns Nil for a file that is not there, and MatrixReader's loaders
			# hand that result straight to CsvTable->New, so a mistyped filename
			# used to unwind the VM. This does not return early: the header map
			# below has to be built in every case (#934).
			if(data = Nil) {
				SetError(-1, 0, "no data");
			}
			else if(delimiter = '"' | delimiter = '\r' | delimiter = '\n') {
				SetError(-1, 0, "the delimiter cannot be a quote, CR or LF");
			}
			else {
				@data := Parse(data);
			};

			# Always give the table a header map, even when the parse failed.
			# Every name-keyed reader below goes through @header_names, and each
			# already handles a name it cannot find; leaving it Nil turned an
			# unparsed table from a reportable state into a VM unwind (#934).
			@header_names := Hash->New()<String, IntRef>;
			if(@is_parsed) {
				headers := @data->Get(0)->As(CsvRow);
				each(i : headers) {
					@header_names->Insert(headers->Get(i), i);
				};
			};
		}

		method : SetError(row : Int, line : Int, message : String) ~ Nil {
			@is_parsed := false;
			@data := Nil;
			@error_row := row;
			if(row < 0) {
				@error := message;
			}
			else {
				@error := "row {$row} (line {$line}): {$message}";
			};
		}

		# Length of the record ending at index, or 0 if there is none there
		method : EndingAt(data : String, index : Int, size : Int) ~ Int {
			c := data->Get(index);
			if(@auto_ending) {
				if(c = '\n') {
					return 1;
				};

				if(c = '\r') {
					if(index + 1 < size & data->Get(index + 1) = '\n') {
						return 2;
					};
					return 1;
				};

				return 0;
			};

			ending_size := @ending->Size();
			if(c <> @ending->Get(0) | index + ending_size > size) {
				return 0;
			};

			for(j := 1; j < ending_size; j += 1;) {
				if(data->Get(index + j) <> @ending->Get(j)) {
					return 0;
				};
			};

			return ending_size;
		}

		# Reads the whole text as RFC 4180 records. Quotes are resolved before
		# records are split, so a quoted field may hold the delimiter, a line break
		# or a doubled quote. Leading white space before a field, and white space
		# around an unquoted field, is dropped (as it always was); a blank line is
		# not a record. Every record must have the header's field count: the first
		# that does not leaves the table unparsed, and GetError() names it.
		method : Parse(data : String) ~ Vector<CsvRow> {
			rows := Vector->New()<CsvRow>;
			lines := Vector->New()<IntRef>;
			fields := CompareVector->New()<String>;
			any_quoted := false;
			ending_seen := false;
			line := 1;
			record_line := 1;
			size := data->Size();
			index := 0;

			while(index < size) {
				# leading white space, but never the delimiter itself (a tab)
				skipping := true;
				while(skipping & index < size) {
					c := data->Get(index);
					if(c <> @delimiter & (c = ' ' | c = '\t' | c = '\f' | c = '\v')) {
						index += 1;
					}
					else {
						skipping := false;
					};
				};

				value : String;
				if(index < size & data->Get(index) = '"') {
					any_quoted := true;
					index += 1;
					buffer := String->New();
					closed := false;
					while(<>closed & index < size) {
						c := data->Get(index);
						if(c = '"') {
							if(index + 1 < size & data->Get(index + 1) = '"') {
								buffer->Append('"');
								index += 2;
							}
							else {
								closed := true;
								index += 1;
							};
						}
						else {
							if(c = '\n') {
								line += 1;
							}
							else if(c = '\r') {
								if(index + 1 >= size | data->Get(index + 1) <> '\n') {
									line += 1;
								};
							};
							buffer->Append(c);
							index += 1;
						};
					};

					if(<>closed) {
						SetError(rows->Size(), record_line, "a quoted field has no closing quote");
						return Nil;
					};

					# text between the closing quote and the delimiter is kept
					start := index;
					while(index < size & data->Get(index) <> @delimiter & EndingAt(data, index, size) = 0) {
						index += 1;
					};
					if(index > start) {
						buffer->Append(data->SubString(start, index - start)->Trim());
					};
					value := buffer;
				}
				else {
					start := index;
					while(index < size & data->Get(index) <> @delimiter & EndingAt(data, index, size) = 0) {
						index += 1;
					};

					if(index > start) {
						value := data->SubString(start, index - start)->Trim();
						# a doubled quote in an unquoted field has always read as one
						if(value->Has("\"\"")) {
							value := value->ReplaceAll("\"\"", "\"");
						};
					}
					else {
						value := "";
					};
				};
				fields->AddBack(value);

				if(index < size & data->Get(index) = @delimiter) {
					index += 1;
					# a delimiter at the very end of the data opens one last, empty field
					if(index = size) {
						fields->AddBack("");
					};
				}
				else {
					# a record ending, or the end of the data
					if(index < size) {
						length := EndingAt(data, index, size);
						if(@auto_ending & <>ending_seen) {
							@ending := data->SubString(index, length);
						};
						ending_seen := true;
						index += length;
						line += 1;
					};

					AddRecord(rows, lines, fields, any_quoted, record_line);
					fields := CompareVector->New()<String>;
					any_quoted := false;
					record_line := line;
				};
			};

			# the last record of data that ends in a delimiter, with no final ending
			if(fields->Size() > 0) {
				AddRecord(rows, lines, fields, any_quoted, record_line);
			};

			if(rows->Size() < 2) {
				SetError(-1, 0, "a header row and at least one record are required");
				return Nil;
			};

			# Short and long rows are both rejected: a short one has no value for a
			# named column, and a long one carries values no column names.
			column_size := rows->Get(0)->Size();
			for(i := 1; i < rows->Size(); i += 1;) {
				row_size := rows->Get(i)->Size();
				if(row_size <> column_size) {
					SetError(i, lines->Get(i)->Get(), "{$row_size} fields, but the header has {$column_size}");
					return Nil;
				};
			};

			return rows;
		}

		# A blank line (one empty, unquoted field) is not a record
		method : AddRecord(rows : Vector<CsvRow>, lines : Vector<IntRef>, fields : CompareVector<String>, any_quoted : Bool, line : Int) ~ Nil {
			if(fields->Size() > 1 | any_quoted | <>fields->Get(0)->IsEmpty()) {
				id := rows->Size();
				rows->AddBack(CsvRow->New(@self, id, id = 0, fields));
				lines->AddBack(IntRef->New(line));
			};
		}

		New(data : Vector<CsvRow>, header_names : Hash<String, IntRef>) {
			@is_parsed := true;
			@data := data;
			@header_names := header_names;
			@ending := "\r\n";
			@delimiter := ',';
			@error_row := -1;
		}

		# a query result writes out the way its source table does
		method : SetFormat(ending : String, delimiter : Char) ~ CsvTable {
			@ending := ending;
			@delimiter := delimiter;
			return @self;
		}

		#~
		Formats values as one CSV record with comma delimiters. A field is quoted
		only when it must be: when it holds the delimiter, a quote, a line break,
		or white space at either end. A quote inside a field is doubled. Nil is
		written as an empty field. CsvTable parses the result back to the same
		values.
		@param values field values
		@return CSV record, without a line ending

```
line := CsvTable->FormatRow(["plain", "has,comma", "say \"hi\""]);
line->PrintLine();
```
		~#
		function : FormatRow(values : String[]) ~ String {
			return FormatRow(values, ',');
		}

		#~
		Formats values as one CSV record with the given delimiter, quoting a field
		only when it must be (see the one-argument form)
		@param values field values
		@param delimiter field delimiter
		@return CSV record, without a line ending

```
line := CsvTable->FormatRow(["a", "b c", "d"], '\t');
line->PrintLine();
```
		~#
		function : FormatRow(values : String[], delimiter : Char) ~ String {
			buffer := "";
			if(values = Nil) {
				return buffer;
			};

			each(i : values) {
				value := values[i];
				if(value = Nil) {
					value := "";
				};

				if(NeedsQuotes(value, delimiter) | (values->Size() = 1 & value->IsEmpty())) {
					buffer->Append('"');
					buffer->Append(value->ReplaceAll("\"", "\"\""));
					buffer->Append('"');
				}
				else {
					buffer->Append(value);
				};

				if(i + 1 < values->Size()) {
					buffer->Append(delimiter);
				};
			};

			return buffer;
		}

		function : private : NeedsQuotes(value : String, delimiter : Char) ~ Bool {
			size := value->Size();
			if(size = 0) {
				return false;
			};

			first := value->Get(0);
			last := value->Get(size - 1);
			if(first = ' ' | first = '\t' | first = '\f' | first = '\v' | last = ' ' | last = '\t' | last = '\f' | last = '\v') {
				return true;
			};

			return value->Has(delimiter) | value->Has('"') | value->Has('\n') | value->Has('\r');
		}

		#~
		Returns rather the file has been successfully parsed
		@return true if successfully parsed, false otherwise

```
csv := CsvTable->New("name,age\r\nAlice,30");
if(csv->IsParsed()) {
  "parsed ok"->PrintLine();
};
```
		~#
		method : public : IsParsed() ~ Bool {
			return @is_parsed;
		}
		
		#~
		Gets row name
		@param name name
		@return row index

```
csv := CsvTable->New("name,age,city\r\nAlice,30,NY");
Console->PrintLine(csv->GetRowId("age"));
```
		~#
		method : public : GetRowId(name : String) ~ Int {
			index := @header_names->Find(name);
			if(index <> Nil) {
				return index->Get();
			};
			
			return -1;
		}

		#~
		Gets header names
		@return header names

```
csv := CsvTable->New("name,age,city\r\nAlice,30,NY");
headers := csv->GetHeaders();
headers->Get(0)->PrintLine();
headers->Get(1)->PrintLine();
```
		~#
		method : public : GetHeaders() ~ CsvRow {
			if(@is_parsed) {
				return @data->Get(0)->As(CsvRow);
			};
			
			return Nil;
		}

		#~
		Appends a column to the end of the table
		@param name name of column to add
		@return true if column was added, false otherwise

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
csv->AppendColumn("score");
Console->PrintLine(csv->RowSize());
```
		~#
		method : public : AppendColumn(name : String) ~ Bool {
			if(@header_names->Has(name) = false & @is_parsed) {
				@data->Get(0)->As(CsvRow)->Append(name);
				for(i := 1; i < @data->Size(); i+=1;) {
					@data->Get(i)->As(CsvRow)->Append("");
				};
				@header_names->Insert(name, RowSize() - 1);
				
				return true;
			};
			
			return false;
		}
		
		#~
		Removes a row from the table
		@param id row to delete
		@return true if deleted false otherwise

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
csv->Delete(1);
Console->PrintLine(csv->Size());
```
		~#
		method : public : Delete(id : Int) ~ Bool {
			if(id = 0) {
				return false;
			};
			
			return @data->Remove(id) <> Nil;
		}
		
		#~
		Gets the size of rows
		@return row size

```
csv := CsvTable->New("a,b,c\r\n1,2,3");
Console->PrintLine(csv->RowSize());
```
		~#
		method : public : RowSize() ~ Int {
			if(<>@is_parsed) {
				return 0;
			};
			
			return @data->Get(0)->As(CsvRow)->Size();
		}
		
		#~
		Gets an indexed row
		@param index index
		@return row

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
row := csv->Get(1);
row->Get("name")->PrintLine();
```
		~#
		method : public : Get(index : Int) ~ CsvRow {
			if(<>@is_parsed) {
				return Nil;
			};
			
			return @data->Get(index)->As(CsvRow);
		}
		
		#~
		Gets the number of rows
		@return number of rows

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25\r\nCarol,28");
Console->PrintLine(csv->Size());
```
		~#
		method : public : Size() ~ Int {
			if(<>@is_parsed) {
				return 0;
			};

			return @data->Size();
		}
				
		#~
		Searches a given column for matching values
		@param name column name
		@param value value to search for
		@return table of matching results

```
csv := CsvTable->New("name,dept\r\nAlice,Eng\r\nBob,HR\r\nCarol,Eng");
results := csv->Matches("dept", "Eng");
Console->PrintLine(results->Size());
```
		~#
		method : public : Matches(name : String, value : String) ~ CsvTable {
			index := @header_names->Find(name);
			if(index <> Nil) {
				return Matches(index->Get(), value);
			};
			
			return Nil;
		}
		
		#~
		Searches a given column for matching values
		@param index column index
		@param value value to search for
		@return table of matching results 
		~#
		method : public : Matches(index : Int, value : String) ~ CsvTable {
			if(index >= RowSize()) {
				return Nil;
			};
			
			found := Vector->New()<CsvRow>;
			found->AddBack(@data->Get(0));
			
			for(i := 1; i < @data->Size(); i +=1;) {
				row := @data->Get(i);
				if(row->Get(index)->Equals(value)) {
					found->AddBack(row);
				};
			};
			
			return CsvTable->New(found, @header_names)->SetFormat(@ending, @delimiter);
		}
		
		#~
		Counts a column for matching values
		@param name column name
		@param value value to search for
		@return number of occurrences

```
csv := CsvTable->New("name,dept\r\nAlice,Eng\r\nBob,HR\r\nCarol,Eng");
count := csv->CountMatches("dept", "Eng");
Console->PrintLine(count);
```
		~#
		method : public : CountMatches(name : String, value : String) ~ Int {
			index := @header_names->Find(name);
			if(index <> Nil) {
				return CountMatches(index->Get(), value);
			};
			
			return 0;
		}
		
		#~
		Counts a column for matching values
		@param index column index
		@param value value to search for
		@return number of occurrences
		~#
		method : public : CountMatches(index : Int, value : String) ~ Int {
			if(index >= RowSize()) {
				return 0;
			};
			
			count := 0;
			for(i := 1; i < @data->Size(); i +=1;) {
				row := @data->Get(i)->As(CsvRow);
				if(row->Get(index)->Equals(value)) {
					count += 1;
				};
			};
			
			return count;
		}

		#~
		Searches a given column for like values
		@param name column name
		@param value value to search for
		@return table of like results

```
csv := CsvTable->New("name,role\r\nAlice,Engineer\r\nBob,Manager\r\nCarol,Engineering Lead");
results := csv->Contains("role", "Engin");
Console->PrintLine(results->Size());
```
		~#
		method : public : Contains(name : String, value : String) ~ CsvTable {
			index := @header_names->Find(name);
			if(index <> Nil) {
				return Contains(index->Get(), value);
			};
			
			return Nil;
		}
		
		#~
		Searches a given column for like values
		@param index column index
		@param value value to search for
		@return table of like results 
		~#
		method : public : Contains(index : Int, value : String) ~ CsvTable {
			if(index >= RowSize()) {
				return Nil;
			};
			
			found := Vector->New()<CsvRow>;
			found->AddBack(@data->Get(0));
			
			for(i := 1; i < @data->Size(); i +=1;) {
				row := @data->Get(i);
				if(row->Get(index)->Has(value)) {
					found->AddBack(row);
				};
			};
			
			return CsvTable->New(found, @header_names)->SetFormat(@ending, @delimiter);
		}
		
		#~
		Counts a column for like values
		@param name column name
		@param value value to search for
		@return number of occurrences

```
csv := CsvTable->New("name,role\r\nAlice,Engineer\r\nBob,Manager\r\nCarol,Senior Engineer");
count := csv->CountContains("role", "Engineer");
Console->PrintLine(count);
```
		~#
		method : public : CountContains(name : String, value : String) ~ Int {
			index := @header_names->Find(name);
			if(index <> Nil) {
				return CountContains(index->Get(), value);
			};
			
			return 0;
		}
		
		#~
		Counts a column for like values
		@param index column index
		@param value value to search for
		@return number of occurrences
		~#
		method : public : CountContains(index : Int, value : String) ~ Int {
			if(index >= RowSize()) {
				return 0;
			};
			
			count := 0;
			for(i := 1; i < @data->Size(); i +=1;) {
				row := @data->Get(i)->As(CsvRow);
				if(row->Get(index)->Has(value)) {
					count += 1;
				};
			};
			
			return count;
		}

		#~
		Formats the table into a string
		@return string representation of the table

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
csv->ToString()->PrintLine();
```
		~#
		method : public : ToString() ~ String {
			buffer := "";
			if(<>@is_parsed) {
				return buffer;
			};

			each(i : @data) {
				row := @data->Get(i)->As(CsvRow);
				buffer->Append(row->ToString());
				buffer->Append(@ending);
			};
		
			return buffer;
		}

		#~
		Formats the table into a JSON object string
		@return JSON object string

```
csv := CsvTable->New("name,age\r\nAlice,30\r\nBob,25");
csv->ToJson()->PrintLine();
```
		~#
		method : public : ToJson() ~ String {
			buffer := "[";
			if(<>@is_parsed) {
				buffer->Append(']');
				return buffer;
			};

			for(i := 1; i < @data->Size(); i += 1;) {
				row := @data->Get(i);
				buffer->Append(row->ToJson());
				
				if(i + 1 < @data->Size()) {
					buffer->Append(',');
				};
			};
			buffer->Append(']');

			return buffer;
		}
		
		#~
		Get unique values for a given row
		@param name column name
		@return unique values for the given row

```
csv := CsvTable->New("name,dept\r\nAlice,Eng\r\nBob,HR\r\nCarol,Eng");
uniq := csv->UniqueColumnValues("dept");
Console->PrintLine(uniq->Size());
```
		~#
		method : public : UniqueColumnValues(name : String) ~ CsvColumn {
			index := @header_names->Find(name);
			if(index <> Nil) {
				return UniqueColumnValues(index->Get());
			};
			
			return Nil;
		}
		
		#~
		Get values for a given row
		@param index column index
		@return values for the given row

```
csv := CsvTable->New("name,score\r\nAlice,90\r\nBob,85");
col := csv->ColumnValues(1);
Console->PrintLine(col->Sum());
```
		~#
		method : public : ColumnValues(index : Int) ~ CsvColumn {
			if(index >= RowSize()) {
				return Nil;
			};
			
			values := Vector->New()<String>;
			for(i := 1; i < @data->Size(); i +=1;) {
				value := @data->Get(i)->As(CsvRow)->Get(index);
				values->AddBack(value);
			};
			
			return CsvColumn->New(values);
		}
		
		#~
		Get values for a given row
		@param name column name
		@return values for the given row

```
csv := CsvTable->New("name,score\r\nAlice,90\r\nBob,85");
col := csv->ColumnValues("score");
Console->PrintLine(col->Average());
```
		~#
		method : public : ColumnValues(name : String) ~ CsvColumn {
			index := @header_names->Find(name);
			if(index <> Nil) {
				return ColumnValues(index->Get());
			};
			
			return Nil;
		}
		
		#~
		Get unique values for a given row
		@param index column index
		@return unique values for the given row
		~#
		method : public : UniqueColumnValues(index : Int) ~ CsvColumn {
			if(index >= RowSize()) {
				return Nil;
			};
			
			values := Vector->New()<String>;
			uniques := Set->New()<String>;
			for(i := 1; i < @data->Size(); i +=1;) {
				value := @data->Get(i)->As(CsvRow)->Get(index);
				if(<>uniques->Has(value)) {
					values->AddBack(value);
					uniques->Insert(value);
				};
			};
			
			return CsvColumn->New(values);
		}
	}
}
