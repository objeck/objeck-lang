		#~
		Downloads a resource to a file without holding it in memory, so its size is limited
		only by the disk. Redirects, retries and headers work as for Get. A 2xx body is written
		to path + ".part" and moved over path only once complete, so an interrupted download
		never leaves a truncated file under the real name. Any other status leaves path
		untouched and its body in the response, as Get would return it.
		@param url URL
		@param path the file to write
		@param pem the PEM file of trusted certificates; Nil for the system's
		@return the response: status and headers, no content for a 2xx; Nil when the connection
		failed or the file could not be written
```
client := Web.HTTP.HttpsClient->New();
response := client->GetToFile(Web.HTTP.Url->New("https://example.com/model.onnx"), "model.onnx", Nil);
if(response <> Nil & response->GetCode() = 200) {
  client->GetDownloadSize()->PrintLine();
};
```
		~#
		method : public : GetToFile(url : Web.HTTP.Url, path : String, pem : String) ~ Web.HTTP.Response {
			if(url = Nil | path = Nil) {
				return Nil;
			};

			@download_path := path;
			@download_size := -1;
			response := Get(url, "application/octet-stream", pem);
			@download_path := Nil;
			# code 0: no status line arrived -- the connection dropped before the reply
			if(response <> Nil & response->GetCode() = 0) {
				return Nil;
			};
			return response;
		}

		#~
		Downloads a resource to a file without holding it in memory, trusting the system's
		certificates. See GetToFile(url, path, pem).
		@param url URL
		@param path the file to write
		@return the response; Nil when the connection failed or the file could not be written
		~#
		method : public : GetToFile(url : Web.HTTP.Url, path : String) ~ Web.HTTP.Response {
			return GetToFile(url, path, Nil);
		}

		#~
		Bytes the last GetToFile wrote.
		@return bytes written, or -1 when nothing was written (a failure, or a non-2xx response)
		~#
		method : public : GetDownloadSize() ~ Int {
			return @download_size;
		}

		#~
		Downloads a resource to a file without holding it in memory. See GetToFile.
		@param url URL
		@param path the file to write
		@return the response; Nil when the connection failed or the file could not be written
		~#
		function : QuickGetToFile(url : Web.HTTP.Url, path : String) ~ Web.HTTP.Response {
			return HttpsClient->New()->GetToFile(url, path);
		}

		method : PullOperation(url : Web.HTTP.Url, content_type : String, task : HttpsClient->Task, pem : String) ~ Web.HTTP.Response {
			@limits->Begin();
			return PullOperationWithRetry(url, content_type, task, pem, 0);
		}

		method : PullOperationWithRetry(url : Web.HTTP.Url, content_type : String, task : HttpsClient->Task, pem : String, redirect_count : Int) ~ Web.HTTP.Response {
			if(redirect_count > @max_redirects) {
				return Web.HTTP.Response->New(310); # too many redirects
			};

			response := PullOperationInner(url, content_type, task, pem, redirect_count, false);

			# retry on transient errors
			if(response <> Nil & @max_retries > 0) {
				code := response->GetCode();
				if(code = 429 | code = 503) {
					delay := @retry_delay_ms;
					for(attempt := 0; attempt < @max_retries; attempt += 1;) {
						# a retry's wait is cut to the deadline, and none starts past it
						if(<>@limits->Sleep(delay)) {
							break;
						};
						response := PullOperationInner(url, content_type, task, pem, redirect_count, false);
						if(response = Nil | (response->GetCode() <> 429 & response->GetCode() <> 503)) {
							break;
						};
						delay *= 2; # exponential backoff
					};
				};
			};

			return response;
		}

		method : PullOperationInner(url : Web.HTTP.Url, content_type : String, task : HttpsClient->Task, pem : String, redirect_count : Int, strip : Bool) ~ Web.HTTP.Response {
			if(redirect_count > @max_redirects) {
				return Web.HTTP.Response->New(310);
			};

			if(@limits->Expired()) {
				return @limits->DeadlineExceeded();
			};

			content : ByteBuffer;
			status_code := 0;

			if(url->GetScheme()->Equals("https")) {
				address := url->GetHost();

				location := url->GetPath();
				location := location ?? "/";

				query := url->GetQuery();
				if(query <> Nil) {
					location += '?';
					location += query;
				};

				frag := url->GetFragment();
				if(frag <> Nil) {
					location += '#';
					location += frag;
				};

				port := url->GetPort();
				if(port < 0) {
					port := 443;
				};

				socket := @limits->SecureConnect(address, port, pem);
				if(<>socket->IsOpen() & @limits->Timeout(TCPSecureSocket->GetLastError(), true)) {
					return @limits->Failed();
				};
				if(socket->IsOpen()) {
					@limits->Apply(socket);
					@response_headers->Empty();

					oper : String;

					if(task = HttpsClient->Task->GET) {
						oper := "GET ";
					}
					else {
						oper := "DELETE ";
					};

					# location and address land verbatim in the request line, so a CR, LF
					# or space here splits the request itself. Url->New does not
					# sanitize, and a Url is the input most likely to be untrusted.
					if(Web.HTTP.HeaderCheck->IsValidRequestTarget(location) = false |
							Web.HTTP.HeaderCheck->IsValidRequestTarget(address) = false) {
						return Nil;
					};
					oper->Append(location);
					oper->Append(" HTTP/1.1\r\nHost: ");
					oper->Append(address);
					if(port <> 443) {
						oper->Append(':');
						oper->Append(port);
					};
					oper->Append("\r\nConnection: close\r\n");

					request_keys := @request_headers->GetKeys()<String>;
					each(request_key in request_keys) {
						# the caller's credentials go to the caller's origin only (#1453)
						if(<>strip | <>Web.HTTP.RedirectCheck->IsCredential(request_key)) {
							request_value := @request_headers->Find(request_key);
							oper->Append(request_key);
							oper->Append(": ");
							oper->Append(request_value);
							oper->Append("\r\n");
						};
					};

					if(<>strip & @cookies_enabled & @cookies->Size() > 0) {
						oper->Append("Cookie: ");
						each(i : @cookies) {
							oper->Append(@cookies->Get(i)->ToShortString());
							if(i + 1 < @cookies->Size()) {
								oper->Append("; ");
							};
						};
						oper->Append("\r\n");
					};
					oper->Append("\r\n");

					socket->WriteString(oper);

					status_line := socket->ReadLine();

					if(status_line <> Nil & status_line->StartsWith("HTTP/1.")) {
						status_line := status_line->SubString("HTTP/1."->Size() + 2,
							status_line->Size() - "HTTP/1."->Size() - 2);
						status_code := WebCommon->ParseStatusCode(status_line);
					};

					# no status line because the server did not send one in time
					if(status_code = 0 & @limits->Timeout(TCPSecureSocket->GetLastError(), false)) {
						socket->Close();
						return @limits->Failed();
					};

					# 0 means no status line was parsed -- a dead socket or a reply that
					# is not HTTP. A genuine 500 must fall through here so its headers
					# and body are read like any other response.
					if(status_code <> 0) {
						do {
							line := socket->ReadLine();
							if(line <> Nil & line->Size() > 0) {
								index := line->Find(':');
								name := line->SubString(index);
								value := line->SubString(index + 1, line->Size() - index - 1)->Trim();

								if(@cookies_enabled & name->Equals("Set-Cookie")) {
									@cookies->AddBack(Cookie->New(value));
								}
								else {
									@response_headers->Insert(name->ToLower(), value);
								};
							};
						}
						while(line <> Nil & line->Size() > 0);

						if(@limits->Timeout(TCPSecureSocket->GetLastError(), false)) {
							socket->Close();
							return @limits->Failed();
						};

						if(status_code = 301 | status_code = 302 | status_code = 303 |
						   status_code = 307 | status_code = 308) {
							moved_location := @response_headers->Find("location");
							if(moved_location <> Nil) {
								moved_url_str := BuildRedirectUrl(address, port, "https://", moved_location);
								moved_url := Url->New(moved_url_str);
								@response_headers->Empty();
								socket->Close();

								return PullOperationInner(moved_url, content_type, HttpsClient->Task->GET, pem, redirect_count + 1, strip | Web.HTTP.RedirectCheck->IsCrossOrigin(url, moved_url));
							};
						};

						encoding : String := @response_headers->Find("transfer-encoding");
						# A 1xx, 204 or 304 response never has a body, whatever its headers say
						# (RFC 9110 sec. 6.4.1, RFC 9112 sec. 6.3). Reading on would fall into
						# ReadUntilClose, which waits for a server that keeps the connection
						# despite this request's Connection: close.
						if(status_code < 200 | status_code = 204 | status_code = 304) {
							content := Nil;
						}
						# GetToFile: a successful body goes to the file, not into memory
						else if(@download_path <> Nil & status_code < 300) {
							@download_size := WebCommon->SaveBody(socket, encoding, @response_headers->Find("content-length"), @download_path);
							content := Nil;
							if(@download_size < 0) {
								if(@limits->Timeout(TCPSecureSocket->GetLastError(), false)) {
									socket->Close();
									return @limits->Failed();
								};
								socket->Close();
								return Nil;
							};
						}
						else if(encoding <> Nil & encoding->Equals("chunked")) {
							content := WebCommon->ReadChunked(socket);
						}
						else {
							length_header : String := @response_headers->Find("content-length");
							if(length_header <> Nil) {
								content := WebCommon->ReadLength(length_header->ToInt(), socket);
							}
							else {
								content := WebCommon->ReadUntilClose(socket);
							};
						};
						# a body cut short by a limit is no response
						if(@limits->Timeout(TCPSecureSocket->GetLastError(), false)) {
							socket->Close();
							return @limits->Failed();
						};

						@cert_issuer := socket->GetIssuer();
						@cert_subject := socket->GetSubject();
					};
					socket->Close();
				}
				else {
					return Nil;
				};
			}

			if(content = Nil) {
				return Web.HTTP.Response->New(status_code);
			};

			content_type := GetContentType();
			return Web.HTTP.Response->New(content->ToByteArray(), status_code, content_type);
		}
	}

	#~
	Secure web socket client

	```
client := SecureWebSocket->New(Url->New("wss://echo.websocket.org"));
if(client->Connect()) {
  client->ReadSocketText()->PrintLine();

  client->WriteTextSocket("Hello World!");
  client->ReadSocketText()->PrintLine();

  client->CloseSocket();
};
	```
	~#
	class SecureWebSocket {
		# web socket support
		@socket : TCPSecureSocket;
		@header : Byte[];
		@url : Web.HTTP.Url;

		@status_code : Int;
		@status_msg : String;

		# https client support
		@request_headers : Hash<String, String>;
		@response_headers : Hash<String, String>;
		@cookies_enabled : Bool;
		@cookies : Vector<Cookie>;
		@cert_issuer : String;
		@cert_subject : String;

		@is_debug : Bool;

		#~
		Constructor
		@param url URL
		@param cookies_enabled true if cookies are enabled, false otherwise
		~#
		New(url : Web.HTTP.Url, cookies_enabled : Bool) {
			@url := url;

			@request_headers := Hash->New()<String, String>;
			@request_headers->Insert("Cache-Control"->ToLower(), "max-age=0");
			@request_headers->Insert("User-Agent"->ToLower(), "Objeck/1.0");

			@response_headers := Hash->New()<String, String>;

			@cookies_enabled := cookies_enabled;
			@cookies := Vector->New()<Cookie>;

			# @is_debug := true;
		}

		#~
		Constructor
		@param url URL
		~#
		New(url : Web.HTTP.Url) {
			@url := url;

			@request_headers := Hash->New()<String, String>;
			@request_headers->Insert("Cache-Control"->ToLower(), "max-age=0");
			@request_headers->Insert("User-Agent"->ToLower(), "Objeck/1.0");

			@response_headers := Hash->New()<String, String>;

			# @is_debug := true;
		}

		#~
		Opens a connection to a web socket
		@return true if connected, false otherwise

		```
		client := Web.HTTP.SecureWebSocket->New(Web.HTTP.Url->New("wss://echo.websocket.org"));
		if(client->Connect()) {
		  client->WriteSocket("Hello!");
		  client->ReadSocketText()->PrintLine();  # Hello!
		  client->CloseSocket();
		};
		```
		~#
		method : public : Connect() ~ Bool {
			if(@url->GetScheme()->Equals("wss")) {
				address := @url->GetHost();

				location := @url->GetPath();
				location := location ?? "/";

				query := @url->GetQuery();
				if(query <> Nil) {
					location += '?';
					location += query;
				};

				frag := @url->GetFragment();
				if(frag <> Nil) {
					location += '#';
					location += frag;
				};

				port := @url->GetPort();
				if(port < 0) {
					port := 443;
				};
				# "### address='{$address}', port={$port}, location='{$location}'"->PrintLine();

				socket := TCPSecureSocket->New(address, port);
				if(socket->IsOpen()) {
					@response_headers->Empty();

					oper := "GET ";

					# location and address land verbatim in the request line, so a CR, LF
					# or space here splits the request itself. Url->New does not
					# sanitize, and a Url is the input most likely to be untrusted.
					if(Web.HTTP.HeaderCheck->IsValidRequestTarget(location) = false |
							Web.HTTP.HeaderCheck->IsValidRequestTarget(address) = false) {
						return false;
					};
					oper->Append(location);
					oper->Append(" HTTP/1.1\r\nHost: ");
					oper->Append(address);
					oper->Append(':');
					oper->Append(port);
					oper->Append("\r\n");

					request_keys := @request_headers->GetKeys()<String>;
					each(request_key in request_keys) {
						request_value := @request_headers->Find(request_key);
						oper->Append(request_key);
						oper->Append(": ");
						oper->Append(request_value);
						oper->Append("\r\n");
					};

					oper->Append("Connection: Upgrade\r\nUpgrade: websocket\r\nSec-WebSocket-Version: 13\r\nSec-WebSocket-Key: ");

					nonce := Byte->New[16];
					each(i : nonce) {
						nonce[i] := Int->Random(255);
					};
					key := Cipher.Encrypt->Base64(nonce);

					oper->Append(key);
					oper->Append("\r\n\r\n");

					# IO.Console->Print("Get: |")->Print(oper)->PrintLine("|");

					socket->WriteString(oper);

					status_line := socket->ReadLine();
					@status_code := Web.HTTP.WebSocketHandshake->StatusCode(status_line);
					@status_msg := Nil;

					# The reply headers, read only for a 101: anything else is refused on
					# its status line. Header names are matched without regard to case
					# (RFC 9110 5.1) and a line with no name is skipped. The count is
					# capped so a peer cannot hold the client here forever. The block ends at
					# a blank line and only there: a reply that stops before it (the peer
					# closed, or a read failed) is not a handshake, whatever it held so far.
					header_max := 256;
					header_count := 0;
					header_end := false;
					if(@status_code = 101) {
						do {
							line := ReadReplyLine(socket);
							if(line <> Nil & line->Size() = 0) {
								header_end := true;
							};
							if(line <> Nil & line->Size() > 0) {
								header_count += 1;
								index := line->Find(':');
								if(index > 0) {
									name := line->SubString(index)->Trim()->ToLower();
									value := line->SubString(index + 1, line->Size() - index - 1)->Trim();

									# IO.Console->Print("|")->Print(name)->Print("|, |")->Print(value)->PrintLine("|");
									if(@cookies_enabled & name->Equals("set-cookie")) {
										@cookies->AddBack(Cookie->New(value));
										# IO.Console->Print("cookie=")->PrintLine(value);
									}
									else {
										@response_headers->Insert(name, value);
									};
								};
							};
						}
						while(line <> Nil & header_end = false & header_count < header_max);
					};

					# RFC 6455 section 4.1: the client fails the connection unless the reply
					# is a 101 that upgrades to websocket and its Sec-WebSocket-Accept is the
					# value derived from the key sent above. Why it was refused is left in
					# GetStatusMessage().
					if(@status_code = 101 & header_end = false & header_count < header_max) {
						@status_msg := "WebSocket handshake refused: the reply ended before the blank line that ends its headers";
					}
					else if(header_count < header_max) {
						@status_msg := Web.HTTP.WebSocketHandshake->Check(status_line, @response_headers, @request_headers, key);
					}
					else {
						@status_msg := "WebSocket handshake refused: the reply has too many headers";
					};

					if(@status_msg = Nil) {
						@socket := socket;
						@header := Byte->New[2];
						return true;
					};

					socket->Close();
				}
			};

			return false;
		}

		#~
		Writes binary output to the web socket
		@param data binary payload
		@param fragment true if fragmented, false otherwise
		@return true if successful, false otherwise

		```
		client := Web.HTTP.SecureWebSocket->New(Web.HTTP.Url->New("wss://echo.websocket.org"));
		if(client->Connect()) {
		  payload := Byte->New[4];
		  payload[0] := 0xDE; payload[1] := 0xAD; payload[2] := 0xBE; payload[3] := 0xEF;
		  client->WriteSocket(payload);
		  echo := client->ReadSocketBinary();
		  echo->ToHexString()->PrintLine();  # deadbeef
		  client->CloseSocket();
		};
		```
		~#
		method : public : WriteSocket(data : Byte[], fragment : Bool := false) ~ Bool {
			chunk_size := 4096;
			if(data = Nil) {
				return false;
			};
			data_size := data->Size();

			if(fragment & data_size > chunk_size) {
				i := 0;

				if(@is_debug) {
					"0: write - off={$i}, len={$chunk_size}"->PrintLine();
				};
				# a frame that could not be written ends the message: the peer cannot
				# use the fragments that follow it
				if(<>WriteFrame(data, i, chunk_size, 2, true)) {
					return false;
				};

				for(i := chunk_size; chunk_size + i  < data_size; i += chunk_size) {
					if(@is_debug) {
						"1: write - off={$i}, len={$chunk_size}"->PrintLine();
					};

					if(<>WriteFrame(data, i, chunk_size, 0, true)) {
						return false;
					};
				};

				# finish frame
				if(data_size - i <> 0) {
					rest := data_size - i;
					if(@is_debug) {
						"2: write - off={$i}, len={$rest}"->PrintLine();
					};

					return WriteFrame(data, i, rest, 0, false);
				};

				return true;
			}
			else {
				return WriteFrame(data, 0, data_size, 2, false);
			};
		}

		#~
		Writes text to the web socket
		@param message message
		@param fragment true if fragmented, false otherwise
		@return true if successful, false otherwise

		```
		client := Web.HTTP.SecureWebSocket->New(Web.HTTP.Url->New("wss://echo.websocket.org"));
		if(client->Connect()) {
		  client->WriteSocket("ping");
		  reply := client->ReadSocketText();
		  reply->PrintLine();   # ping
		  client->CloseSocket();
		};
		```
		~#
		method : public : WriteSocket(message : String, fragment : Bool := false) ~ Bool {
			chunk_size := 4096;
			if(message = Nil) {
				return false;
			};

			data := message->ToByteArray();
			data_size := data->Size();

			if(fragment & data_size > chunk_size) {
				i := 0;

				if(@is_debug) {
					"0: write - off={$i}, len={$chunk_size}"->PrintLine();
				};
				# a frame that could not be written ends the message: the peer cannot
				# use the fragments that follow it
				if(<>WriteFrame(data, i, chunk_size, 1, true)) {
					return false;
				};

				for(i := chunk_size; chunk_size + i  < data_size; i += chunk_size) {
					if(@is_debug) {
						"1: write - off={$i}, len={$chunk_size}"->PrintLine();
					};

					if(<>WriteFrame(data, i, chunk_size, 0, true)) {
						return false;
					};
				};

				# finish frame
				if(data_size - i <> 0) {
					rest := data_size - i;
					if(@is_debug) {
						"2: write - off={$i}, len={$rest}"->PrintLine();
					};

					return WriteFrame(data, i, rest, 0, false);
				};

				return true;
			}
			else {
				return WriteFrame(data, 0, data_size, 1, false);
			};
		}

		#~
		Reads binary input from the web socket
		@return binary input read, Nil otherwise
		~#
		method : public : ReadSocketBinary() ~ Byte[] {
			return ReadFrame();
		}

		#~
		Reads text from the web socket
		@return text read, Nil otherwise
		~#
		method : public : ReadSocketText() ~ String {
			data := ReadFrame();
			if(data <> Nil) {
				return String->New(data);
			};

			return Nil;
		}

		# One line of the handshake reply without its line ending, or Nil if the peer
		# stopped before the line ended: the stream closed, a read failed or timed
		# out, or a NUL arrived. The socket's ReadLine() cannot be used for this: it
		# answers "" for a closed connection exactly as for a blank line, so a reply
		# cut off after its last header read as a complete one. A line longer than
		# the buffer comes back in pieces, as ReadLine() gives it.
		method : ReadReplyLine(socket : TCPSecureSocket) ~ String {
			one := Byte->New[1];
			text := Byte->New[8192];
			size := 0;
			while(size < 8191) {
				if(socket->ReadBuffer(0, 1, one) <> 1) {
					return Nil;
				};

				value := one[0]->As(Int);
				if(value = 0) {
					return Nil;
				};

				# CR is taken with the byte after it (LF), which must arrive too
				if(value = 13) {
					if(socket->ReadBuffer(0, 1, one) <> 1) {
						return Nil;
					};
					value := 10;
				};

				if(value = 10) {
					if(size = 0) {
						return "";
					};
					return String->New(text, 0, size);
				};

				text[size] := one[0];
				size += 1;
			};

			return String->New(text, 0, size);
		}

		# Reads exactly 'num' bytes of a frame into 'buffer'. ReadBuffer() answers with
		# the number of bytes that arrived, which is fewer when the peer closes, the
		# read fails or it times out part way; the callers ignored that number, so a
		# frame cut short was delivered as a whole one (its missing bytes zero, or
		# whatever the last frame left in the header). A short read ends the
		# connection: what follows on the stream can no longer be told apart.
		method : ReadExact(num : Int, buffer : Byte[]) ~ Bool {
			if(@socket->ReadBuffer(0, num, buffer) = num) {
				return true;
			};

			@status_msg := "WebSocket connection lost: the peer closed or a read failed before a whole frame arrived";
			@socket->Close();
			return false;
		}

		method : ReadFrame() ~ Byte[] {
			if(@socket <> Nil) {
				# read header
				if(<>ReadExact(2, @header)) {
					return Nil;
				};
				opcode := (@header[0] and 0xff)->As(Byte);

				if(@is_debug){
					System.IO.Console->Print("read - opt+len: ")->PrintLine(@header->ToHexString());
				};

				# ping
				if(opcode = 0x89) {
					payload_length : Int := @header[1];
					# masked by the server, see below
					if((payload_length and 0x80) <> 0) {
						@status_msg := "WebSocket frame refused: masked by the server";
						@socket->Close();
						return Nil;
					};
					buffer := Byte->New[payload_length];
					if(payload_length > 0) {
						if(<>ReadExact(payload_length, buffer)) {
							return Nil;
						};
					};

					if(@is_debug){
						System.IO.Console->Print("ping - payload: ")->PrintLine(buffer->ToHexString());
					};

					@socket->WriteByte(0x8a);
					@socket->WriteBuffer(buffer);

					# read header
					if(<>ReadExact(2, @header)) {
						return Nil;
					};
					opcode := (@header[0] and 0xff)->As(Byte);

					if(@is_debug){
						System.IO.Console->Print("read - opt+len: ")->PrintLine(@header->ToHexString());
					};
				};

				if(opcode = 0x81 | opcode = 0x82 | opcode = 0x88) {
					payload_length : Int := @header[1];
					# A server never masks (RFC 6455 section 5.1: the client fails the
					# connection if it does). The mask bit is the length byte's top
					# bit, so a masked frame also read as a negative length for the
					# allocation below.
					if((payload_length and 0x80) <> 0) {
						@status_msg := "WebSocket frame refused: masked by the server";
						@socket->Close();
						return Nil;
					};

					if(payload_length = 126) {
						if(<>ReadExact(2, @header)) {
							return Nil;
						};

						if(@is_debug){
							System.IO.Console->Print("read - length-ext: ")->PrintLine(@header->ToHexString());
						};

						payload_length := DecodeInt(@header, 0, 2);
					}
					else if(payload_length = 127) {
						buffer := Byte->New[8];
						if(<>ReadExact(8, buffer)) {
							return Nil;
						};

						if(@is_debug){
							System.IO.Console->Print("read - length-ext: ")->PrintLine(buffer->ToHexString());
						};

						payload_length := DecodeInt(buffer, 0, 8);
					};

					if(@is_debug){
						System.IO.Console->Print("read - length: ")->PrintLine(payload_length);
					};

					# The 8-byte length is the peer's to choose: one with the top bit set
					# decodes negative, and the read below counts in a 32-bit int, so
					# the cap is 2 GiB (it was 4 GiB, with no lower bound).
					if(payload_length >= 0 & payload_length <= 2147483647) {
						# read payload
						buffer := Byte->New[payload_length];
						if(payload_length > 0) {
							if(<>ReadExact(payload_length, buffer)) {
								return Nil;
							};
						};

						if(opcode = 0x88) {
							# the status code is the first two bytes of the close frame's
							# payload, and both it and the reason are optional (RFC 6455
							# section 5.5.1); 1005 is "no status code was present"
							if(buffer->Size() >= 2) {
								@status_code := DecodeInt(buffer, 0, 2);
								# the reason is UTF-8 on its own: decoded together with
								# the two code bytes in front of it, it came out garbled
								# whenever those bytes were not text (1001 is 0x03 0xE9)
								@status_msg := "";
								if(buffer->Size() > 2) {
									reason := Byte->New[buffer->Size() - 2];
									each(k : reason) {
										reason[k] := buffer[k + 2];
									};
									@status_msg := String->New(reason);
								};
							}
							else {
								@status_code := 1005;
								@status_msg := "";
							};
							@socket->Close();

							return Nil;
						};

						if(@is_debug){
							System.IO.Console->Print("read - buffer: '")->Print(buffer->ToHexString())->PrintLine("'\n===");
						};

						return buffer;
					};
				};
			};

			return Nil;
		}

		method : WriteFrame(data : Byte[], offset : Int, length : Int, mode : Int, fragment : Bool) ~ Bool {
			# The range must lie inside the data: a negative or oversized offset or
			# length is refused here instead of faulting in the copy loop below (or,
			# for a negative length, in the frame's allocation). The frame is one
			# array handed to one native write, and that write counts in a 32-bit
			# int, so the payload is capped at 2 GiB less the 14-byte header rather
			# than the 4 GiB this once allowed (such a frame was built, then not sent).
			in_bounds := false;
			if(@socket <> Nil & data <> Nil) {
				if(offset >= 0 & length >= 0 & length <= 2147483633) {
					in_bounds := offset <= data->Size() - length;
				};
			};

			if(in_bounds) {
				frame_offset : Int;

				# create frame
				frame : Byte[];

				if(length < 126) {
					frame_offset := 6;
				}
				else if(length < 65536) {
					frame_offset := 8;
				}
				else {
					frame_offset := 14;
				};
				frame := Byte->New[frame_offset + length];

				# set utf-8 opcode
				if(fragment) {
					frame[0] := 0x0 + mode;
				}
				else {
					frame[0] := 0x80 + mode;
				};

				# set payload length and bit mask
				mask_payload_length := 0x80; # set mask bit
				if(length < 126) {
					mask_payload_length += length; # payload size
					frame[1] := mask_payload_length;

					if(@is_debug){
						opcodes := Byte->New[2];
						opcodes[0] := frame[0];
						opcodes[1] := frame[1];
						System.IO.Console->Print("write - opcode+length: ")->PrintLine(opcodes->ToHexString());
					};

					# key mask
					frame[2] := Int->Random(255);
					frame[3] := Int->Random(255);
					frame[4] := Int->Random(255);
					frame[5] := Int->Random(255);

					if(@is_debug){
						mask := Byte->New[4];
						mask[0] := frame[2];
						mask[1] := frame[3];
						mask[2] := frame[4];
						mask[3] := frame[5];
						System.IO.Console->Print("write - mask: ")->PrintLine(mask->ToHexString());
					};
				}
				else if(length < 65536) {
					mask_payload_length += 126; # payload size

					frame[1] := mask_payload_length;
					EncodeInt(length, frame, 2, 2);

					if(@is_debug){
						opcodes := Byte->New[3];
						opcodes[0] := frame[0];
						opcodes[1] := frame[1];
						opcodes[2] := frame[2];
						System.IO.Console->Print("write - opcode+length-ext-2: ")->PrintLine(opcodes->ToHexString());
					};

					# key mask
					frame[4] := Int->Random(255);
					frame[5] := Int->Random(255);
					frame[6] := Int->Random(255);
					frame[7] := Int->Random(255);

					if(@is_debug){
						mask := Byte->New[4];
						mask[0] := frame[4];
						mask[1] := frame[5];
						mask[2] := frame[6];
						mask[3] := frame[7];
						System.IO.Console->Print("write - mask: ")->PrintLine(mask->ToHexString());
					};
				}
				else {
					mask_payload_length += 127; # payload size

					frame[1] := mask_payload_length;
					EncodeInt(length, frame, 2, 8);

					if(@is_debug){
						opcodes := Byte->New[9];
						opcodes[0] := frame[0];
						opcodes[1] := frame[1];
						opcodes[2] := frame[2];
						opcodes[3] := frame[3];
						opcodes[4] := frame[4];
						opcodes[5] := frame[5];
						opcodes[6] := frame[6];
						opcodes[7] := frame[7];
						opcodes[8] := frame[8];

						System.IO.Console->Print("write - opcode+length-ext-8: ")->PrintLine(opcodes->ToHexString());
					};

					# key mask
					frame[10] := Int->Random(255);
					frame[11] := Int->Random(255);
					frame[12] := Int->Random(255);
					frame[13] := Int->Random(255);

					if(@is_debug){
						mask := Byte->New[4];
						mask[0] := frame[10];
						mask[1] := frame[11];
						mask[2] := frame[12];
						mask[3] := frame[13];
						System.IO.Console->Print("write - mask: ")->PrintLine(mask->ToHexString());
					};
				};

				# encode payload
				j := 0;
				for(i := 0; i < length; i += 1;) {
					frame[frame_offset + i] := data[i + offset] xor frame[j % 4 + frame_offset - 4];
					j += 1;
				};

				if(@is_debug){
					buffer := ByteBuffer->New();

					each(f in frame) {
						buffer->Append(f)
					};

					"write - frame: "->Print();
					buffer->ToByteArray()->ToHexString()->PrintLine();
					"\n==="->PrintLine();
				};

				return @socket->WriteBuffer(frame) > 0;
			};

			return false;
		}

		method : native : EncodeInt(value : Int, bytes : Byte[], offset : Int, num_bytes : Int) ~ Nil {
			shift := (num_bytes - 1) << 3;
			end := offset + num_bytes;

			for(i := offset; i < end; i += 1;) {
				bytes[i] := (value >> shift) and 0xff;
				shift -= 8;
			};
		}

		method : native : DecodeInt(bytes : Byte[], offset : Int, num_bytes : Int) ~ Int {
			value : Int;

			shift := (num_bytes - 1) << 3;
			end := offset + num_bytes;

			for(i := offset; i < end; i += 1;) {
				value += (bytes[i] and 0xff) << shift;
				shift -= 8;
			};

			return value;
		}

		#~
		Pings the websocket server
		@return true if pinged, false otherwise

		```
		client := Web.HTTP.SecureWebSocket->New(Web.HTTP.Url->New("wss://echo.websocket.org"));
		if(client->Connect()) {
		  alive := client->PingSocket();
		  alive->PrintLine();   # true
		  client->CloseSocket();
		};
		```
		~#
		method : public : PingSocket() ~ Bool {
			if(@socket <> Nil) {
				# ping frame: FIN+ping, mask bit set, 0 payload, 4-byte mask
				frame := Byte->New[6];
				frame[0] := 0x89;
				frame[1] := 0x80;
				frame[2] := Int->Random(255);
				frame[3] := Int->Random(255);
				frame[4] := Int->Random(255);
				frame[5] := Int->Random(255);
				@socket->WriteBuffer(frame);

				# read header
				if(<>ReadExact(2, @header)) {
					return false;
				};
				opcode := (@header[0] and 0xff)->As(Byte);
				# System.IO.Console->Print("read - opt+len: ")->PrintLine(@header->ToHexString());

				payload_length : Int := @header[1];
				# masked by the server, see ReadFrame
				if((payload_length and 0x80) <> 0) {
					@status_msg := "WebSocket frame refused: masked by the server";
					@socket->Close();
					return false;
				};
				buffer := Byte->New[payload_length];
				if(payload_length > 0) {
					if(<>ReadExact(payload_length, buffer)) {
						return false;
					};
				};

				if(@is_debug){
					System.IO.Console->Print("pong - payload: ")->PrintLine(buffer->ToHexString());
				};

				if(opcode = 0x8a) {
					return true;
				};
			};

			return false;
		}

		#~
		Closes the web socket connection
		~#
		method : public : CloseSocket() ~ Nil {
			CloseSocket(1000);
		}

		#~
		Closes the web socket connection
		@param reason reason to close socket
		~#
		method : public : CloseSocket(reason : Int) ~ Nil {
			if(@socket <> Nil) {
				frame := Byte->New[8];
				frame[0] := 0x88;  # FIN + close opcode
				frame[1] := 0x82;  # mask bit set + 2 bytes payload
				frame[2] := Int->Random(255);  # masking key
				frame[3] := Int->Random(255);
				frame[4] := Int->Random(255);
				frame[5] := Int->Random(255);
				frame[6] := ((reason >> 8) and 0xff) xor frame[2];
				frame[7] := (reason and 0xff) xor frame[3];
				@socket->WriteBuffer(frame);
				@socket->Close();
			};
		}

		#~
		Gets the last status code
		@return last status code
		~#
		method : public : GetStatusCode() ~ Int {
			return @status_code;
		}

		#~
		Gets the last status message
		@return last status message
		~#
		method : public : GetStatusMessage() ~ String {
			return @status_msg;
		}

		#~
		Gets the socket's X.509 certificate issuer name
		@return certificate issuer name
		~#
		method : public : GetIssuer() ~ String {
			return @cert_issuer;
		}

		#~
		Gets the socket's X.509 certificate subject name
		@return certificate subject name
		~#
		method : public : GetSubject() ~ String {
			return @cert_subject;
		}

		#~
		Sets cookie support
		@param cookies_enabled true if cookies are enabled, false otherwise
		~#
		method : public : EnableCookies(cookies_enabled : Bool) ~ Nil {
			@cookies_enabled := cookies_enabled;
		}

		#~
		Gets the cookies
		@return vector of cookies
		~#
		method : public : GetCookies() ~ Vector<Cookie> {
			return @cookies;
		}

		#~
		Adds a HTTPS request header
		@param name header name
		@param value header value
		~#
		method : public : AddHeader(name : String, value : String) ~  Nil {
			# Refuse anything that could inject a header line of its own.
			# A CR/LF here would split the request (HTTP/1.1) or reach the
			# wire unvalidated (HTTP/2, HTTP/3). Never legitimate content.
			if(Web.HTTP.HeaderCheck->IsValidName(name->ToLower()) = false |
				Web.HTTP.HeaderCheck->IsValidValue(value) = false) {
				return;
			};
			@request_headers->Insert(name->ToLower(), value);
		}

		#~
		Removes a HTTPS request header
		@param name header name
		~#
		method : public : RemoveHeader(name : String) ~  Nil {
			@request_headers->Remove(name->ToLower());
		}
	}
}
