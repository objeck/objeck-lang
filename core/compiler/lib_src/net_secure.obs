use System.IO.Net, Collection;

#~
HTTPS/TLS client library. HttpsClient mirrors the HttpClient API over TLS with certificate inspection (issuer, subject). SecureWebSocket adds TLS to WebSocket connections. Compile with -lib net_secure.
~#
bundle Web.HTTP {
	#~
	HTTPS client

	```
html := HttpsClient->QuickGet(Web.HTTP.Url->New("https://www.nasa.gov")->ToString();
if(html <> Nil) {
   html->PrintLine();
};
	```
	~#
	class HttpsClient {
		#~
		The HTTP method of a request.
		~#
		enum Task {
			#~
			GET
			~#
			GET,
			#~
			DELETE
			~#
			DELETE,
			#~
			POST
			~#
			POST,
			#~
			PUT
			~#
			PUT,
			#~
			PATCH
			~#
			PATCH
		}

		# https client support
		@request_headers : Hash<String, String>;
		@response_headers : Hash<String, String>;
		@cookies_enabled : Bool;
		@cookies : Vector<Cookie>;
		@cert_issuer : String;
		@cert_subject : String;
		@max_redirects : Int;
		@max_retries : Int;
		@retry_delay_ms : Int;
		@download_path : String;
		@download_size : Int;
		@limits : RequestLimits;

		#~
		Defaults of the time limits
		~#
		consts Timeout {
			#~
			The read timeout an HTTPS connection starts with, in milliseconds: how long a read
			waits for the peer before it fails. It starts again with every byte received. It is
			longer than a plain HTTP connection's, as a model API can be silent for minutes while
			it reasons. SetReadTimeout changes it, and SetDeadline bounds the request as a whole.
			OBJECK_TLS_RECV_TIMEOUT (milliseconds) changes it for every HTTPS client in a process.
			~#
			DEFAULT_READ_MS := 300000
		}

		#~
		Default constructor
		@param cookies_enabled true if cookies are enabled, false otherwise

		```
		client := Web.HTTP.HttpsClient->New();
		client->AddHeader("Authorization", "Bearer mytoken");
		response := client->Get(Web.HTTP.Url->New("https://api.example.com/data"));
		if(response <> Nil) {
		  response->GetCode()->PrintLine();  # 200
		};
		```
		~#
		New(cookies_enabled : Bool := false) {
			@request_headers := Hash->New()<String, String>;
			@request_headers->Insert("Cache-Control"->ToLower(), "max-age=0");
			@request_headers->Insert("User-Agent"->ToLower(), "Objeck/1.0");

			@response_headers := Hash->New()<String, String>;

			@cookies_enabled := cookies_enabled;
			@cookies := Vector->New()<Cookie>;
			@max_redirects := 10;
			@max_retries := 3;
			@retry_delay_ms := 1000;
			@limits := RequestLimits->New(HttpsClient->Timeout->DEFAULT_READ_MS->As(Int));
		}

		#~
		Sets the maximum number of redirects to follow (default 10)
		@param max maximum redirects

		```
		client := Web.HTTP.HttpsClient->New();
		client->SetMaxRedirects(5);
		response := client->Get(Web.HTTP.Url->New("https://httpbin.org/redirect/3"));
		response->GetCode()->PrintLine();  # 200
		```
		~#
		method : public : SetMaxRedirects(max : Int) ~ Nil {
			@max_redirects := max;
		}

		#~
		Sets retry behavior for transient errors (429, 503)
		@param max_retries maximum retry attempts (default 3, 0 to disable)
		@param delay_ms initial delay between retries in milliseconds (default 1000, doubles each retry)

		```
		client := Web.HTTP.HttpsClient->New();
		client->SetRetry(5, 500);  # retry up to 5 times, starting at 500ms
		response := client->Get(Web.HTTP.Url->New("https://api.example.com/data"));
		response->GetCode()->PrintLine();
		```
		~#
		method : public : SetRetry(max_retries : Int, delay_ms : Int) ~ Nil {
			@max_retries := max_retries;
			@retry_delay_ms := delay_ms;
		}

		#~
		Sets the connect timeout: the longest the TCP connect to a server, and then the TLS
		handshake, may each take. One that does not finish fails the request, with response
		code 0 and GetErrorCode() CONNECT_TIMEOUT. The default is none, the operating system's
		own for the connect and the read timeout for the handshake.
		@param ms milliseconds, 0 for none

		```
		client := Web.HTTP.HttpsClient->New();
		client->SetConnectTimeout(2000);
		response := client->Get(Web.HTTP.Url->New("https://192.0.2.1/"));
		if(response->GetCode() = 0) {
		  client->GetError()->PrintLine();  # connect timed out after 2000 ms
		};
		```
		~#
		method : public : SetConnectTimeout(ms : Int) ~ Nil {
			@limits->SetConnectTimeout(ms);
		}

		#~
		Sets the read timeout: the longest a read waits for the server to send. It starts again
		with every byte received, so it does not bound the request: a server that sends a byte
		at a time can keep a request going far past it (see SetDeadline). A read that times out
		fails the request, with response code 0 and GetErrorCode() READ_TIMEOUT. The default is
		DEFAULT_READ_MS, 300 seconds.
		@param ms milliseconds, 0 for the default

		```
		client := Web.HTTP.HttpsClient->New();
		client->SetReadTimeout(5000);
		response := client->Get(Web.HTTP.Url->New("https://example.com/slow"));
		```
		~#
		method : public : SetReadTimeout(ms : Int) ~ Nil {
			@limits->SetReadTimeout(ms);
		}

		#~
		Sets the deadline for a whole request: the longest it may take from the call to its last
		byte, covering the connect, the TLS handshake, the send, every read, every redirect
		followed and every retry (a retry's delay is cut short by it). Unlike the read timeout
		it does not start again with each byte, so a server that dribbles its reply is cut off
		when the deadline is reached. A request that reaches it fails with response code 0 and
		GetErrorCode() DEADLINE_EXCEEDED, and its connection is closed. For StreamPost it
		bounds the stream. The default is none.
		@param ms milliseconds, 0 for none

		```
		client := Web.HTTP.HttpsClient->New();
		client->SetDeadline(30000);
		response := client->Get(Web.HTTP.Url->New("https://api.example.com/data"));
		if(response->GetCode() = 0) {
		  client->GetError()->PrintLine();  # deadline of 30000 ms exceeded
		};
		```
		~#
		method : public : SetDeadline(ms : Int) ~ Nil {
			@limits->SetDeadline(ms);
		}

		#~
		Gets the connect timeout
		@return milliseconds, 0 for none
		~#
		method : public : GetConnectTimeout() ~ Int {
			return @limits->GetConnectTimeout();
		}

		#~
		Gets the read timeout
		@return milliseconds, DEFAULT_READ_MS when none was set
		~#
		method : public : GetReadTimeout() ~ Int {
			return @limits->GetReadTimeout();
		}

		#~
		Gets the deadline
		@return milliseconds, 0 for none
		~#
		method : public : GetDeadline() ~ Int {
			return @limits->GetDeadline();
		}

		#~
		Why the last request ended on a time limit
		@return a message, Nil when it did not
		~#
		method : public : GetError() ~ String {
			return @limits->GetError();
		}

		#~
		Which time limit the last request ended on
		@return a RequestLimits->Error code: CONNECT_TIMEOUT, READ_TIMEOUT or DEADLINE_EXCEEDED, 0 when it did not end on one
		~#
		method : public : GetErrorCode() ~ Int {
			return @limits->GetErrorCode();
		}

		#~
		Performs a HTTPS GET that ends within a deadline
		@param url URL
		@param deadline_ms the longest the request may take, in milliseconds
		@return the response; code 0 and GetError() when the deadline was reached

		```
		response := Web.HTTP.HttpsClient->QuickGet(Web.HTTP.Url->New("https://example.com/"), 5000);
		if(response->GetCode() = 0) {
		  response->GetError()->PrintLine();
		};
		```
		~#
		function : QuickGet(url : Web.HTTP.Url, deadline_ms : Int) ~ Web.HTTP.Response {
			client := HttpsClient->New();
			client->SetDeadline(deadline_ms);
			return client->Get(url);
		}

		#~
		Performs a HTTPS POST that ends within a deadline
		@param url URL
		@param data data to post
		@param content_type content type
		@param deadline_ms the longest the request may take, in milliseconds
		@return the response; code 0 and GetError() when the deadline was reached
		~#
		function : QuickPost(url : Web.HTTP.Url, data : Byte[], content_type : String, deadline_ms : Int) ~ Web.HTTP.Response {
			client := HttpsClient->New();
			client->SetDeadline(deadline_ms);
			return client->Post(url, data, content_type);
		}

		#~
		Gets the HTTPS request headers
		@return HTTPS request headers
		~#
		method : public : GetRequestHeaders() ~ Hash<String, String> {
			return @request_headers;
		}

		#~
		Gets the HTTPS response headers
		@return HTTPS response headers
		~#
		method : public : GetResponseHeaders() ~ Hash<String, String> {
			return @response_headers;
		}

		#~
		Adds a HTTPS request header
		@param name header name
		@param value header value

		```
		client := Web.HTTP.HttpsClient->New();
		client->AddHeader("Authorization", "Bearer token123");
		client->AddHeader("Accept", "application/json");
		response := client->Get(Web.HTTP.Url->New("https://api.example.com/users"));
		response->GetCode()->PrintLine();
		```
		~#
		method : public : AddHeader(name : String, value : String) ~  Nil {
			# Refuse anything that could inject a header line of its own.
			# A CR/LF here would split the request (HTTP/1.1) or reach the
			# wire unvalidated (HTTP/2, HTTP/3). Never legitimate content.
			if(Web.HTTP.HeaderCheck->IsValidName(name->ToLower()) = false |
				Web.HTTP.HeaderCheck->IsValidValue(value) = false) {
				return;
			};
			@request_headers->Insert(name->ToLower(), value);
		}

		#~
		Removes a HTTPS request header
		@param name header name

		```
		client := Web.HTTP.HttpsClient->New();
		client->RemoveHeader("Cache-Control");  # strip default cache header
		response := client->Get(Web.HTTP.Url->New("https://api.example.com/data"));
		response->GetCode()->PrintLine();
		```
		~#
		method : public : RemoveHeader(name : String) ~  Nil {
			@request_headers->Remove(name->ToLower());
		}

		#~
		Sets cookie support
		@param cookies_enabled true if cookies are enabled, false otherwise

		```
		client := Web.HTTP.HttpsClient->New();
		client->EnableCookies(true);
		client->Get(Web.HTTP.Url->New("https://example.com/login"));  # server sets cookie
		client->Get(Web.HTTP.Url->New("https://example.com/profile")); # cookie sent automatically
		```
		~#
		method : public : EnableCookies(cookies_enabled : Bool) ~ Nil {
			@cookies_enabled := cookies_enabled;
		}

		#~
		Gets the cookies
		@return vector of cookies
		~#
		method : public : GetCookies() ~ Vector<Cookie> {
			return @cookies;
		}

		#~
		Get a cookie
		@param name cookie name
		@return found cookie, Nil otherwise
		~#
		method : public : GetCookie(name : String) ~ Cookie {
			each(cookie in @cookies) {
				if(cookie->GetName()->EqualsIgnoreCase(name)) {
					return cookie;
				};
			};

			return Nil;
		}

		#~
		Checks for a cookie
		@param name cookie name
		@return true if found cookie, false otherwise
		~#
		method : public : HasCookie(name : String) ~ Bool {
			return GetCookie(name) <> Nil;
		}

		#~
		Sets a cookie
		@param cookie cookie
		~#
		method : public : SetCookie(cookie : Cookie) ~ Nil {
			@cookies->AddBack(cookie);
		}

		#~
		Gets the socket's X.509 certificate issuer name
		@return certificate issuer name

		```
		client := Web.HTTP.HttpsClient->New();
		client->Get(Web.HTTP.Url->New("https://example.com/"));
		client->GetIssuer()->PrintLine();   # e.g. "Let's Encrypt Authority X3"
		```
		~#
		method : public : GetIssuer() ~ String {
			return @cert_issuer;
		}

		#~
		Gets the socket's X.509 certificate subject name
		@return certificate subject name

		```
		client := Web.HTTP.HttpsClient->New();
		client->Get(Web.HTTP.Url->New("https://example.com/"));
		client->GetSubject()->PrintLine();  # e.g. "CN=example.com"
		```
		~#
		method : public : GetSubject() ~ String {
			return @cert_subject;
		}

		method : GetContentType() ~ String {
			value := @response_headers->Find("content-type");
			if(value <> Nil) {
				return value;
			};

			return "text/plain";
		}

		#~
		Performs a HTTPS POST
		@param url URL
		@param data data to oper
		@return read strings

		```
		url := Web.HTTP.Url->New("https://httpbin.org/post");
		body := "field=value"->ToByteArray();
		response := Web.HTTP.HttpsClient->QuickPost(url, body);
		response->GetCode()->PrintLine();  # 200
		```
		~#
		function : QuickPost(url : Web.HTTP.Url, data : Byte[]) ~ Web.HTTP.Response {
			return HttpsClient->New()->Post(url, data);
		}

		#~
		Performs a HTTPS POST
		@param url URL
		@param data data to oper
		@param content_type content type
		@return read strings
		~#
		function : QuickPost(url : Web.HTTP.Url, data : Byte[], content_type : String) ~ Web.HTTP.Response {
			return QuickPost(url, data, content_type, Nil);
		}

		#~
		Performs a HTTPS POST
		@param url URL
		@param data data to oper
		@param content_type content type
		@param headers key/value headers
		@return read strings
		~#
		function : QuickPost(url : Web.HTTP.Url, data : Byte[], content_type : String, headers : Map<String, String>) ~ Web.HTTP.Response {
			client := HttpsClient->New();
			if(headers <> Nil) {
				header_key_values := headers->GetKeyValues()<Pair<String, String>>;
				each(key_value in header_key_values) {
					key := key_value->GetFirst();
					value := key_value->GetSecond();
					client->AddHeader(key, value);
				};
			};

			return client->Post(url, data, content_type);
		}

		#~
		Performs a HTTP POST
		@param url URL
		@param data data to oper
		@return read strings
		~#
		function : QuickPut(url : Web.HTTP.Url, data : Byte[]) ~ Web.HTTP.Response {
			return HttpsClient->New()->Put(url, data);
		}

		#~
		Performs a HTTPS POST
		@param url URL
		@param data data to oper
		@param content_type content type
		@return read strings
		~#
		function : QuickPut(url : Web.HTTP.Url, data : Byte[], content_type : String) ~ Web.HTTP.Response {
			return QuickPut(url, data, content_type, Nil);
		}

		#~
		Performs a HTTP POST
		@param url URL
		@param data data to oper
		@param content_type content type
		@param headers key/value headers
		@return read strings
		~#
		function : QuickPut(url : Web.HTTP.Url, data : Byte[], content_type : String, headers : Map<String, String>) ~ Web.HTTP.Response {
			client := HttpsClient->New();

			if(headers <> Nil) {
				header_key_values := headers->GetKeyValues()<Pair<String, String>>;
				each(key_value in header_key_values) {
					key := key_value->GetFirst();
					value := key_value->GetSecond();
					client->AddHeader(key, value);
				};
			};

			return client->Put(url, data, content_type);
		}

		#~
		Performs a HTTPS POST
		@param url URL
		@param data data to oper
		@param content_type content type
		@return string read
		~#
		method : public : Post(url : Web.HTTP.Url, data : Byte[], content_type : String) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, content_type, HttpsClient->Task->POST, Nil);
		}

		#~
		Performs a HTTPS POST
		@param url URL
		@param data data to oper
		@param content_type content type
		@param pem the Privacy Enhanced Mail file
		@return string read
		~#
		method : public : Post(url : Web.HTTP.Url, data : Byte[], content_type : String, pem : String) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, content_type, HttpsClient->Task->POST, pem);
		}

		#~
		Performs a HTTPS POST
		@param url URL
		@param data data to oper
		@return string read
		~#
		method : public : Post(url : Web.HTTP.Url, data : Byte[]) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, "text/plain", HttpsClient->Task->POST, Nil);
		}

		#~
		Performs a HTTPS PUT
		@param url URL
		@param data data to oper
		@param content_type content type
		@return string read
		~#
		method : public : Put(url : Web.HTTP.Url, data : Byte[], content_type : String) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, content_type, HttpsClient->Task->PUT, Nil);
		}

		#~
		Performs a HTTPS PUT
		@param url URL
		@param data data to oper
		@param content_type content type
		@param pem the Privacy Enhanced Mail file
		@return string read
		~#
		method : public : Put(url : Web.HTTP.Url, data : Byte[], content_type : String, pem : String) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, content_type, HttpsClient->Task->PUT, pem);
		}

		#~
		Performs a HTTPS PUT
		@param url URL
		@param data data to oper
		@return string read
		~#
		method : public : Put(url : Web.HTTP.Url, data : Byte[]) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, "text/plain", HttpsClient->Task->PUT, Nil);
		}

		#~
		Performs a HTTPS PATCH
		@param url URL
		@param data data to patch
		@return read strings

		```
		url := Web.HTTP.Url->New("https://api.example.com/items/1");
		body := "{\"status\":\"active\"}"->ToByteArray();
		response := Web.HTTP.HttpsClient->QuickPatch(url, body, "application/json");
		response->GetCode()->PrintLine();  # 200
		```
		~#
		function : QuickPatch(url : Web.HTTP.Url, data : Byte[]) ~ Web.HTTP.Response {
			return HttpsClient->New()->Patch(url, data);
		}

		#~
		Performs a HTTPS PATCH
		@param url URL
		@param data data to patch
		@param content_type content type
		@return read strings
		~#
		function : QuickPatch(url : Web.HTTP.Url, data : Byte[], content_type : String) ~ Web.HTTP.Response {
			return QuickPatch(url, data, content_type, Nil);
		}

		#~
		Performs a HTTPS PATCH
		@param url URL
		@param data data to patch
		@param content_type content type
		@param headers key/value headers
		@return read strings
		~#
		function : QuickPatch(url : Web.HTTP.Url, data : Byte[], content_type : String, headers : Map<String, String>) ~ Web.HTTP.Response {
			client := HttpsClient->New();

			if(headers <> Nil) {
				header_key_values := headers->GetKeyValues()<Pair<String, String>>;
				each(key_value in header_key_values) {
					key := key_value->GetFirst();
					value := key_value->GetSecond();
					client->AddHeader(key, value);
				};
			};

			return client->Patch(url, data, content_type);
		}

		#~
		Performs a HTTPS PATCH
		@param url URL
		@param data data to patch
		@param content_type content type
		@return string read
		~#
		method : public : Patch(url : Web.HTTP.Url, data : Byte[], content_type : String) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, content_type, HttpsClient->Task->PATCH, Nil);
		}

		#~
		Performs a HTTPS PATCH
		@param url URL
		@param data data to patch
		@param content_type content type
		@param pem the Privacy Enhanced Mail file
		@return string read
		~#
		method : public : Patch(url : Web.HTTP.Url, data : Byte[], content_type : String, pem : String) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, content_type, HttpsClient->Task->PATCH, pem);
		}

		#~
		Performs a HTTPS PATCH
		@param url URL
		@param data data to patch
		@return string read
		~#
		method : public : Patch(url : Web.HTTP.Url, data : Byte[]) ~ Web.HTTP.Response {
			return PushPullOperation(url, data, "text/plain", HttpsClient->Task->PATCH, Nil);
		}

		#~
		Performs an HTTPS POST and returns an SSE stream for reading events.
		Used for streaming responses from LLM APIs.
		@param url URL
		@param data request body
		@param content_type content type
		@return SSE stream, or Nil on error

		```
		client := Web.HTTP.HttpsClient->New();
		client->AddHeader("Authorization", "Bearer mykey");
		url := Web.HTTP.Url->New("https://api.openai.com/v1/chat/completions");
		body := "{\"model\":\"gpt-4o\",\"stream\":true,\"messages\":[]}"->ToByteArray();
		stream := client->StreamPost(url, body, "application/json");
		if(stream <> Nil) {
		  while(stream->HasNext()) {
		    stream->Next()->GetData()->PrintLine();
		  };
		  stream->Close();
		};
		```
		~#
		method : public : StreamPost(url : Web.HTTP.Url, data : Byte[], content_type : String) ~ SSEStream {
			return StreamPost(url, data, content_type, Nil);
		}

		#~
		Performs an HTTPS POST and returns an SSE stream for reading events.
		@param url URL
		@param data request body
		@param content_type content type
		@param pem PEM certificate
		@return SSE stream, or Nil on error
		~#
		method : public : StreamPost(url : Web.HTTP.Url, data : Byte[], content_type : String, pem : String) ~ SSEStream {
			if(<>url->GetScheme()->Equals("https")) {
				return Nil;
			};

			address := url->GetHost();
			location := url->GetPath();
			location := location ?? "/";

			query := url->GetQuery();
			if(query <> Nil) {
				location += '?';
				location += query;
			};

			port := url->GetPort();
			if(port < 0) {
				port := 443;
			};

			@limits->Begin();
			socket := @limits->SecureConnect(address, port, pem);
			if(<>socket->IsOpen()) {
				@limits->Timeout(TCPSecureSocket->GetLastError(), true);
				return Nil;
			};
			@limits->Apply(socket);

			@response_headers->Empty();

			oper := "POST ";
			# location and address land verbatim in the request line, so a CR, LF
			# or space here splits the request itself. Url->New does not
			# sanitize, and a Url is the input most likely to be untrusted.
			if(Web.HTTP.HeaderCheck->IsValidRequestTarget(location) = false |
					Web.HTTP.HeaderCheck->IsValidRequestTarget(address) = false) {
				return Nil;
			};
			oper->Append(location);
			oper->Append(" HTTP/1.1\r\nHost: ");
			oper->Append(address);
			oper->Append(':');
			oper->Append(port);
			# Caller-supplied. A CR/LF here would inject a header line into the
			# request -- and it lands before Content-Length, which is the
			# smuggling-relevant position. Fail closed rather than send it.
			if(Web.HTTP.HeaderCheck->IsValidValue(content_type) = false) {
				return Nil;
			};
			# Caller-supplied. A CR/LF here would inject a header line into the
			# request -- and it lands before Content-Length, which is the
			# smuggling-relevant position. Fail closed rather than send it.
			if(Web.HTTP.HeaderCheck->IsValidValue(content_type) = false) {
				return Nil;
			};
			oper->Append("\r\nContent-Type: ");
			oper->Append(content_type);
			oper->Append("\r\nContent-Length: ");
			oper->Append(data->Size()->ToString());
			oper->Append("\r\nAccept: text/event-stream\r\n");

			request_keys := @request_headers->GetKeys()<String>;
			each(request_key in request_keys) {
				request_value := @request_headers->Find(request_key);
				oper->Append(request_key);
				oper->Append(": ");
				oper->Append(request_value);
				oper->Append("\r\n");
			};

			if(@cookies_enabled & @cookies->Size() > 0) {
				oper->Append("Cookie: ");
				each(i : @cookies) {
					oper->Append(@cookies->Get(i)->ToShortString());
					if(i + 1 < @cookies->Size()) {
						oper->Append("; ");
					};
				};
				oper->Append("\r\n");
			};
			oper->Append("\r\n");
			socket->WriteString(oper);
			socket->WriteBuffer(data);

			# Read status line
			status_code := 0;
			status_line := socket->ReadLine();
			if(status_line <> Nil & status_line->StartsWith("HTTP/1.")) {
				status_line := status_line->SubString("HTTP/1."->Size() + 2,
					status_line->Size() - "HTTP/1."->Size() - 2);
				status_code := WebCommon->ParseStatusCode(status_line);
			};

			# Read response headers
			do {
				line := socket->ReadLine();
				if(line <> Nil & line->Size() > 0) {
					index := line->Find(':');
					name := line->SubString(index);
					value := line->SubString(index + 1, line->Size() - index - 1)->Trim();
					@response_headers->Insert(name->ToLower(), value);
				};
			}
			while(line <> Nil & line->Size() > 0);

			@cert_issuer := socket->GetIssuer();
			@cert_subject := socket->GetSubject();

			# Return stream — caller reads events and closes when done
			return SSEStream->New(socket, socket, status_code);
		}

		method : BuildRedirectUrl(address : String, port : Int, scheme : String, location : String) ~ String {
			if(location->StartsWith("http://") | location->StartsWith("https://")) {
				return location;
			};

			url := scheme;
			url += address;
			default_port := 80;
			if(scheme->Equals("https://")) {
				default_port := 443;
			};
			if(port <> default_port) {
				url += ':';
				url += port;
			};
			if(<>location->StartsWith("/")) {
				url += '/';
			};
			url += location;
			return url;
		}

		method : PushPullOperation(url : Web.HTTP.Url, data : Byte[], content_type : String, task : HttpsClient->Task, pem : String) ~ Web.HTTP.Response {
			@limits->Begin();
			response := PushPullOperationInner(url, data, content_type, task, pem, 0, false);

			# retry on transient errors
			if(response <> Nil & @max_retries > 0) {
				code := response->GetCode();
				if(code = 429 | code = 503) {
					delay := @retry_delay_ms;
					for(attempt := 0; attempt < @max_retries; attempt += 1;) {
						# a retry's wait is cut to the deadline, and none starts past it
						if(<>@limits->Sleep(delay)) {
							break;
						};
						response := PushPullOperationInner(url, data, content_type, task, pem, 0, false);
						if(response = Nil | (response->GetCode() <> 429 & response->GetCode() <> 503)) {
							break;
						};
						delay *= 2;
					};
				};
			};

			return response;
		}

		method : PushPullOperationInner(url : Web.HTTP.Url, data : Byte[], content_type : String, task : HttpsClient->Task, pem : String, redirect_count : Int, strip : Bool) ~ Web.HTTP.Response {
			if(redirect_count > @max_redirects) {
				return Web.HTTP.Response->New(310);
			};

			if(@limits->Expired()) {
				return @limits->DeadlineExceeded();
			};

			content : ByteBuffer;
			status_code := 0;

			if(url->GetScheme()->Equals("https")) {
				address := url->GetHost();

				location := url->GetPath();
				location := location ?? "/";

				query := url->GetQuery();
				if(query <> Nil) {
					location += '?';
					location += query;
				};

				frag := url->GetFragment();
				if(frag <> Nil) {
					location += '#';
					location += frag;
				};

				port := url->GetPort();
				if(port < 0) {
					port := 443;
				};

				socket := @limits->SecureConnect(address, port, pem);
				if(<>socket->IsOpen() & @limits->Timeout(TCPSecureSocket->GetLastError(), true)) {
					return @limits->Failed();
				};
				if(socket->IsOpen()) {
					@limits->Apply(socket);
					@response_headers->Empty();

					oper : String;

					if(task = HttpsClient->Task->POST) {
						oper := "POST ";
					}
					else if(task = HttpsClient->Task->PATCH) {
						oper := "PATCH ";
					}
					else {
						oper := "PUT ";
					};

					# location and address land verbatim in the request line, so a CR, LF
					# or space here splits the request itself. Url->New does not
					# sanitize, and a Url is the input most likely to be untrusted.
					if(Web.HTTP.HeaderCheck->IsValidRequestTarget(location) = false |
							Web.HTTP.HeaderCheck->IsValidRequestTarget(address) = false) {
						return Nil;
					};
					oper->Append(location);
					oper->Append(" HTTP/1.1\r\nHost: ");
					oper->Append(address);
					if(port <> 443) {
						oper->Append(':');
						oper->Append(port);
					};
					oper->Append("\r\nContent-Type: ");
					oper->Append(content_type);
					oper->Append("\r\nContent-Length: ");
					oper->Append(data->Size()->ToString());
					oper->Append("\r\nConnection: close\r\n");

					request_keys := @request_headers->GetKeys()<String>;
					each(request_key in request_keys) {
						# the caller's credentials go to the caller's origin only (#1453)
						if(<>strip | <>Web.HTTP.RedirectCheck->IsCredential(request_key)) {
							request_value := @request_headers->Find(request_key);
							oper->Append(request_key);
							oper->Append(": ");
							oper->Append(request_value);
							oper->Append("\r\n");
						};
					};

					if(<>strip & @cookies_enabled & @cookies->Size() > 0) {
						oper->Append("Cookie: ");
						each(i : @cookies) {
							oper->Append(@cookies->Get(i)->ToShortString());
							if(i + 1 < @cookies->Size()) {
								oper->Append("; ");
							};
						};
						oper->Append("\r\n");
					};
					oper->Append("\r\n");
					socket->WriteString(oper);
					socket->WriteBuffer(data);

					status_line := socket->ReadLine();
					if(status_line <> Nil & status_line->StartsWith("HTTP/1.")) {
						status_line := status_line->SubString("HTTP/1."->Size() + 2,
							status_line->Size() - "HTTP/1."->Size() - 2);
						status_code := WebCommon->ParseStatusCode(status_line);
					};

					# no status line because the server did not send one in time
					if(status_code = 0 & @limits->Timeout(TCPSecureSocket->GetLastError(), false)) {
						socket->Close();
						return @limits->Failed();
					};

					# 0 means no status line was parsed -- a dead socket or a reply that
					# is not HTTP. A genuine 500 must fall through here so its headers
					# and body are read like any other response.
					if(status_code <> 0) {
						do {
							line := socket->ReadLine();
							if(line <> Nil & line->Size() > 0) {
								index := line->Find(':');
								name := line->SubString(index);
								value := line->SubString(index + 1, line->Size() - index - 1)->Trim();

								if(@cookies_enabled & name->Equals("Set-Cookie")) {
									@cookies->AddBack(Cookie->New(value));
								}
								else {
									@response_headers->Insert(name->ToLower(), value);
								};
							};
						}
						while(line <> Nil & line->Size() > 0);

						if(@limits->Timeout(TCPSecureSocket->GetLastError(), false)) {
							socket->Close();
							return @limits->Failed();
						};

						if(status_code = 301 | status_code = 302 | status_code = 303 |
						   status_code = 307 | status_code = 308) {
							moved_location := @response_headers->Find("location");
							if(moved_location <> Nil) {
								moved_url_str := BuildRedirectUrl(address, port, "https://", moved_location);
								moved_url := Url->New(moved_url_str);
								@response_headers->Empty();
								socket->Close();

								if(status_code = 301 | status_code = 302 | status_code = 303) {
									return PullOperationInner(moved_url, content_type, HttpsClient->Task->GET, pem, redirect_count + 1, strip | Web.HTTP.RedirectCheck->IsCrossOrigin(url, moved_url));
								}
								else {
									return PushPullOperationInner(moved_url, data, content_type, task, pem, redirect_count + 1, strip | Web.HTTP.RedirectCheck->IsCrossOrigin(url, moved_url));
								};
							};
						};

						encoding : String := @response_headers->Find("transfer-encoding");
						# A 1xx, 204 or 304 response never has a body, whatever its headers say
						# (RFC 9110 sec. 6.4.1, RFC 9112 sec. 6.3). Reading on would fall into
						# ReadUntilClose, which waits for a server that keeps the connection
						# despite this request's Connection: close.
						if(status_code < 200 | status_code = 204 | status_code = 304) {
							content := Nil;
						}
						else if(encoding <> Nil & encoding->Equals("chunked")) {
							content := WebCommon->ReadChunked(socket);
						}
						else {
							length_header : String := @response_headers->Find("content-length");
							if(length_header <> Nil) {
								content := WebCommon->ReadLength(length_header->ToInt(), socket);
							}
							else {
								content := WebCommon->ReadUntilClose(socket);
							};
						};
					};

					# a body cut short by a limit is no response
					if(@limits->Timeout(TCPSecureSocket->GetLastError(), false)) {
						socket->Close();
						return @limits->Failed();
					};
					socket->Close();
				};
			};

			if(content = Nil) {
				return Web.HTTP.Response->New(status_code);
			};

			content_type := GetContentType();
			return Web.HTTP.Response->New(content->ToByteArray(), status_code, content_type);
		}

		#~
		Performs a HTTPS GET and returns results as a String
		@param url URL
		@return output buffer

		```
		url := Web.HTTP.Url->New("https://httpbin.org/get");
		response := Web.HTTP.HttpsClient->QuickGet(url);
		if(response <> Nil) {
		  response->GetCode()->PrintLine();            # 200
		  String->New(response->GetContent())->PrintLine();  # JSON body
		};
		```
		~#
		function : QuickGet(url : Web.HTTP.Url) ~ Web.HTTP.Response {
			return QuickGet(url, "text/plain", Nil);
		}

		#~
		Performs a HTTPS GET and returns results as a String
		@param url URL
		@param headers key/value headers
		@return output buffer
		~#
		function : QuickGet(url : Web.HTTP.Url, headers : Map<String, String>) ~ Web.HTTP.Response {
			return QuickGet(url, "text/plain", headers);
		}

		#~
		Performs a HTTPS GET and returns results as a String
		@param url URL
		@param content_type content type
		@return output buffer
		~#
		function : QuickGet(url : Web.HTTP.Url, content_type : String) ~ Web.HTTP.Response {
			return QuickGet(url, content_type, Nil);
		}

		#~
		Performs a HTTPS GET and returns results as a String
		@param url URL
		@param content_type content type
		@param headers key/value headers
		@return output buffer
		~#
		function : QuickGet(url : Web.HTTP.Url, content_type : String, headers : Map<String, String>) ~ Web.HTTP.Response {
			client := HttpsClient->New();
			if(headers <> Nil) {
				header_key_values := headers->GetKeyValues()<Pair<String, String>>;
				each(key_value in header_key_values) {
					key := key_value->GetFirst();
					value := key_value->GetSecond();

					if(value->IsEmpty()) {
						client->RemoveHeader(key);
					}
					else {
						client->AddHeader(key, value);
					};
				};
			};

			return client->Get(url, content_type);
		}

		#~
		Performs a HTTPS GET and returns results as a String
		@param url URL
		@param content_type content type
		@param headers key/value headers
		@param pem the Privacy Enhanced Mail file
		@return output buffer
		~#
		function : QuickGet(url : Web.HTTP.Url, content_type : String, headers : Map<String, String>, pem : String) ~ Web.HTTP.Response {
			client := HttpsClient->New();

			if(headers <> Nil) {
				header_key_values := headers->GetKeyValues()<Pair<String, String>>;
				each(key_value in header_key_values) {
					key := key_value->GetFirst();
					value := key_value->GetSecond();

					if(value->IsEmpty()) {
						client->RemoveHeader(key);
					}
					else {
						client->AddHeader(key, value);
					};
				};
			};

			return client->Get(url, content_type, pem);
		}

		#~
		Performs a HTTPS GET
		@param url URL
		@return string read
		~#
		method : public : Get(url : Web.HTTP.Url) ~ Web.HTTP.Response {
			return Get(url, "text/plain");
		}

		#~
		Performs a HTTPS GET
		@param url URL
		@param content_type content type
		@return string read
		~#
		method : public : Get(url : Web.HTTP.Url, content_type : String) ~ Web.HTTP.Response {
			return PullOperation(url, content_type, HttpsClient->Task->GET, Nil);
		}

		#~
		Performs a HTTPS GET
		@param url URL
		@param content_type content type
		@return string read
		~#
		method : public : Get(url : Web.HTTP.Url, content_type : String, pem : String) ~ Web.HTTP.Response {
			return PullOperation(url, content_type, HttpsClient->Task->GET, pem);
		}

