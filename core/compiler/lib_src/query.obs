use Collection;
use System.Time;
use Query.RegEx;
use System.IO.Filesystem;
use Data.XML;

#~
In-memory object query engine. Table stores typed records and supports filtering, aggregation (sum, average), and CSV/filesystem import. Finder provides filesystem search. Compile with -lib query.
~#
bundle Query.Structured {
	#~
	Container for semi-structured data

```
table := Table->New("users", ["name", "age"]);
row := table->Insert();
row->Set("name", "Alice");
row->Set("age", IntRef->New(30));

results := table->Query("select * from users where age > 25");
each(i : results) {
   results->Get(i)->ToString()->PrintLine();
};
```
	~#
	class Table {
		@name : String;
		@keys : Map<IntRef, Row>;
		@column_names : String[];
		@column_map : Map<String, IntRef>;
		@head : Row;
		@tail : Row;
		@count : Int;
		@next_pk : Int;
		@query : Query;
		
		#~
		Constructor
		@param name table name
		@param column_names column names
		~#
		New(name : String, column_names : String[]) {
			@column_map := Map->New()<String, IntRef>;
			@keys := Map->New()<IntRef, Row>;
			@name := name;

			@column_names := String->New[column_names->Size() + 1];
			@column_names[0] := "pk";
			@column_map->Insert(@column_names[0], 0);
			each(i : column_names) {
				@column_names[i + 1] := column_names[i];
				@column_map->Insert(@column_names[i + 1], i + 1);
			};
		}

		New(name : String, column_names : Vector<String>) {
			@column_map := Map->New()<String, IntRef>;
			@keys := Map->New()<IntRef, Row>;
			@name := name;
			
			@column_names := String->New[column_names->Size() + 1];
			@column_names[0] := "pk";
			@column_map->Insert(@column_names[0], 0);
			each(i : column_names) {
				@column_names[i + 1] := column_names->Get(i);
				@column_map->Insert(@column_names[i + 1], i + 1);
			};
		}
		
		#~
		Gets the table name
		@return table name
		```
		table := Query.Structured.Table->New("products", ["sku", "price"]);
		table->GetName()->PrintLine(); # prints "products"
		```
		~#
		method : public : GetName() ~ String {
			return @name;
		}
		
		#~
		Get column index by name
		@param name column name
		@return column name
		```
		table := Query.Structured.Table->New("items", ["name", "qty"]);
		idx := table->GetIndex("qty"); # returns 2 (pk=0, name=1, qty=2)
		"qty column index={$idx}"->PrintLine();
		```
		~#
		method : public : native : GetIndex(name : String) ~ Int {
			found := @column_map->Find(name);
			if(found <> Nil) {
				return found->As(IntRef)->Get();
			};
			
			return -1;
		}
		
		#~
		Get all rows
		@return all rows
		```
		table := Query.Structured.Table->New("items", ["name"]);
		row := table->Insert(); row->Set("name", "Alpha");
		all := table->GetAll(); # retrieve every row
		each(i : all) { all->Get(i)->ToString()->PrintLine(); };
		```
		~#
		method : public : native : GetAll() ~ Vector<Row> {
			matches := Vector->New()<Row>;
			
			row1 := @head;
			while(row1 <> Nil) {
				matches->AddBack(row1);
				row1 := row1->Next();
			};
			
			return matches;
		}
		
		#~
		Get row by primary key
		@param pk primary key
		@return row
		```
		table := Query.Structured.Table->New("items", ["name"]);
		row := table->Insert(); row->Set("name", "Beta");
		found := table->Get(0); # fetch row with pk=0
		found->ToString()->PrintLine();
		```
		~#
		method : public : native : Get(pk : Int) ~ Row {
			return @keys->Find(pk);
		}
		
		#~
		Gets all column names
		@return column names
		~#
		method : public : GetColumnNames() ~ String[] {
			return @column_names;
		}
		
		#~
		Gets unique rows by column name
		@param name column name
		@return unique rows
		```
		table := Query.Structured.Table->New("sales", ["region"]);
		r1 := table->Insert(); r1->Set("region", "East");
		r2 := table->Insert(); r2->Set("region", "East"); # duplicate
		r3 := table->Insert(); r3->Set("region", "West");
		unique := table->Unique("region"); # 2 rows: East, West
		"unique regions: {$unique->Size()}"->PrintLine();
		```
		~#
		method : public : Unique(name : String) ~ Vector<Row> {
			out := Vector->New()<Row>;

			index := GetIndex(name);
			if(index < 0) {
				return out;
			};

			# Use hash for O(n) lookup instead of O(n²) nested loops
			seen := Hash->New()<Compare, BoolRef>;

			in_row := @head;
			while(in_row <> Nil) {
				left := in_row->Get(index);

				if(left <> Nil & <>seen->Has(left)) {
					seen->Insert(left, true);
					out->AddBack(in_row);
				};

				# next
				in_row := in_row->Next();
			};

			return out;
		}
		
		#~
		Gets the column average over its numeric cells (IntRef and FloatRef).
		String, Date and Nil cells are skipped: they add nothing to the sum and
		are not counted in the divisor. A column with no numeric cells, or an
		unknown column, averages to 0.0; Count(name) tells the cases apart.
		@param name column name
		@return column average
		```
		table := Query.Structured.Table->New("scores", ["score"]);
		r1 := table->Insert(); r1->Set("score", IntRef->New(80));
		r2 := table->Insert(); r2->Set("score", IntRef->New(90));
		avg := table->Average("score"); # returns 85.0
		"avg={$avg}"->PrintLine();
		```
		~#
		method : public : Average(name : String) ~ Float {
			index := GetIndex(name);		
			if(index < 0) {
				return 0.0;
			};
			
			sum := 0.0;
			count := 0;
			row1 := @head;
			while(row1 <> Nil) {
				value := row1->Get(index);
				if(Cell->IsNumeric(value)) {
					sum += Cell->ToNumber(value);
					count += 1;
				};
				
				# next
				row1 := row1->Next();
			};
						
			# Only numeric cells take part: a string or Nil cell is not a zero.
			# No numeric cells (an empty table, an unknown column, or a column of
			# strings) has no average; report 0.0 rather than divide by zero.
			if(count = 0) {
				return 0.0;
			};

			return sum / count->As(Float);
		}
		
		#~
		Gets the number of numeric cells in a column: cells holding an IntRef or a
		FloatRef. String, Date and Nil cells are not counted. This is the divisor
		Average uses, so a caller can tell an average of 0.0 from a column with no
		numbers in it. The row count is Count() with no argument.
		@param name column name
		@return number of numeric cells, 0 for an unknown column
		```
		table := Query.Structured.Table->New("scores", ["score"]);
		r1 := table->Insert(); r1->Set("score", IntRef->New(80));
		r2 := table->Insert(); r2->Set("score", "absent");
		n := table->Count("score"); # returns 1
		"numeric cells={$n}"->PrintLine();
		```
		~#
		method : public : Count(name : String) ~ Int {
			index := GetIndex(name);
			if(index < 0) {
				return 0;
			};

			count := 0;
			row1 := @head;
			while(row1 <> Nil) {
				if(Cell->IsNumeric(row1->Get(index))) {
					count += 1;
				};
				row1 := row1->Next();
			};

			return count;
		}

		#~
		Gets the smallest numeric value in a column. Only IntRef and FloatRef cells
		take part; when there are none the result is 0.0 (check Count(name)).
		@param name column name
		@return column minimum
		```
		table := Query.Structured.Table->New("temps", ["deg"]);
		r1 := table->Insert(); r1->Set("deg", IntRef->New(-4));
		r2 := table->Insert(); r2->Set("deg", FloatRef->New(12.5));
		low := table->Min("deg"); # returns -4.0
		"low={$low}"->PrintLine();
		```
		~#
		method : public : Min(name : String) ~ Float {
			return MinMax(name, true);
		}

		#~
		Gets the largest numeric value in a column. Only IntRef and FloatRef cells
		take part; when there are none the result is 0.0 (check Count(name)).
		@param name column name
		@return column maximum
		```
		table := Query.Structured.Table->New("temps", ["deg"]);
		r1 := table->Insert(); r1->Set("deg", IntRef->New(-4));
		r2 := table->Insert(); r2->Set("deg", FloatRef->New(12.5));
		high := table->Max("deg"); # returns 12.5
		"high={$high}"->PrintLine();
		```
		~#
		method : public : Max(name : String) ~ Float {
			return MinMax(name, false);
		}

		method : MinMax(name : String, is_min : Bool) ~ Float {
			index := GetIndex(name);
			if(index < 0) {
				return 0.0;
			};

			found := false;
			result := 0.0;
			row1 := @head;
			while(row1 <> Nil) {
				value := row1->Get(index);
				if(Cell->IsNumeric(value)) {
					number := Cell->ToNumber(value);
					if(<>found) {
						result := number;
						found := true;
					}
					else if(is_min & number < result) {
						result := number;
					}
					else if(<>is_min & number > result) {
						result := number;
					};
				};
				row1 := row1->Next();
			};

			return result;
		}
		
		#~
		Gets the column sum over its numeric cells (IntRef and FloatRef); other
		cells are skipped. No numeric cells, or an unknown column, sums to 0.0.
		@param name column name
		@return column sum
		```
		table := Query.Structured.Table->New("sales", ["amount"]);
		r1 := table->Insert(); r1->Set("amount", FloatRef->New(19.99));
		r2 := table->Insert(); r2->Set("amount", FloatRef->New(5.01));
		total := table->Sum("amount"); # returns 25.0
		"total={$total}"->PrintLine();
		```
		~#
		method : public : Sum(name : String) ~ Float {
			index := GetIndex(name);		
			if(index < 0) {
				return 0.0;
			};
			
			sum := 0.0;
			row1 := @head;
			while(row1 <> Nil) {
				value := row1->Get(index);
				if(Cell->IsNumeric(value)) {
					sum += Cell->ToNumber(value);
				};
				
				# next
				row1 := row1->Next();
			};
			
			return sum;
		}
		
		#~
		Filters table based upon conditional criteria. A Nil cell matches no
		condition. Numbers compare by value, so an IntRef cell compares with a
		FloatRef literal and the other way round. Cells that cannot be ordered
		against the value (a string cell and a number, say) are unequal to it:
		they match '<>' and no other comparison.
		@param cond conditional filter
		@return filtered rows
		~#
		method : public : native : Filter(cond : Conditional) ~ Vector<Row> {
			matches := Vector->New()<Row>;
			right := cond->GetValue();
			row1 := @head;
			while(row1 <> Nil) {
				left := row1->Get(cond->GetLeft());
				if(left <> Nil) {
					is_match := false;
					select(cond->GetQualifier()) {
						label Conditional->Qualifier->LIKE: {
							if(left->TypeOf(String) & right <> Nil) {
								if(right->TypeOf(String)) {
									is_match := Cell->MatchLike(left->As(String), right->As(String));
								};
							};
						}

						label Conditional->Qualifier->NOT_LIKE: {
							if(left->TypeOf(String) & right <> Nil) {
								if(right->TypeOf(String)) {
									is_match := <>Cell->MatchLike(left->As(String), right->As(String));
								};
							};
						}

						other: {
							is_match := Cell->Test(Cell->Compare(left, right), cond->GetQualifier());
						}
					};

					if(is_match) {
						matches->AddBack(row1);
					};
				};
				# next
				row1 := row1->Next();
			};
			
			return matches;
		}
		
		#~
		Query table using SQL-like syntax. Support for 'select', 'from', 'where',
		'distinct', 'order by' and logical operators.
		@param statement query statement
		@return result table
		```
		table := Query.Structured.Table->New("emp", ["name", "dept"]);
		r := table->Insert(); r->Set("name", "Carol"); r->Set("dept", "Eng");
		rs := table->Query("select name from emp where dept = 'Eng'");
		rs->ToString()->PrintLine();
		```
		~#
		method : public : Query(statement : String) ~ Table {
			@query := Query->New(statement, @self);
			return @query->Query();
		}
		
		#~
		Gets the last query error
		@return last query error, Nil if the last query succeeded or none has run
		~#
		method : public : GetError() ~ String {
			if(@query = Nil) {
				return Nil;
			};

			return @query->GetError();
		}
		
		#~
		Inserts a new row into the table. After the row
		has been added its values will need to be set.
		@return newly inserted row
		```
		table := Query.Structured.Table->New("tasks", ["title", "done"]);
		row := table->Insert(); # add empty row
		row->Set("title", "Write tests");
		row->Set("done", Row->False());
		row->ToString()->PrintLine();
		```
		~#
		method : public : native : Insert() ~ Row {
			# primary keys are never reused, so they come from their own counter
			# rather than the row count, which drops on Delete
			pk := IntRef->New(@next_pk);
			values := Compare->New[@column_names->Size()];
			values[0] := pk;
			row1 := Row->New(@self, values);
			@keys->Insert(pk->Get(), row1);
			@next_pk += 1;
			@count += 1;
			
			if(@head = Nil) {
				@head := row1;
				@tail := row1;
			}
			else {
				@tail->Next(row1);
				row1->Prev(@tail);
				@tail := row1;
			};
			
			return row1;
		}
		
		#~
		Delete row by primary key
		@param pk primary key
		@return true if successful, false otherwise
		```
		table := Query.Structured.Table->New("items", ["name"]);
		row := table->Insert(); row->Set("name", "Temp");
		ok := table->Delete(0); # remove row with pk=0
		"deleted={$ok}"->PrintLine();
		```
		~#
		method : public : native : Delete(pk : Int) ~ Bool {
			row1 := @keys->Find(pk);
			if(row1 <> Nil) {
				prev := row1->Prev();
				next := row1->Next();

				if(prev <> Nil) {
					prev->Next(next);
				}
				else {
					@head := next;
				};
				
				if(next <> Nil) {
					next->Prev(prev);
				}
				else {
					@tail := prev;
				};

				row1->Next(Nil);
				row1->Prev(Nil);
				
				@keys->Remove(pk);
				@count -= 1;
				return true;
			};
			
			return false;
		}
		
		#~
		Count of rows. Count(name) counts the numeric cells in one column.
		@return number of rows
		~#
		method : public : Count() ~ Int {
			return @count;
		}

		#~
		Count of rows
		@return number of rows
		~#
		method : public : Size() ~ Int {
			return @count;
		}
		
		#~
		String representation of table
		@return all row1 as a string
		~#
		method : public : ToString() ~ String {
			buffer := "";
			
			row1 := @head;
			while(row1 <> Nil) {
				buffer += row1->ToString();
				buffer += "\r\n";
				row1 := row1->Next();
			};
			
			return buffer;
		}

		#~
		Loads a table from a CSV file. The first line names the columns. A cell
		holding a whole number ('42', '-3', '+3') becomes an IntRef; a decimal or
		exponent form ('3.5', '.5', '-0.5', '1e3') becomes a FloatRef; '#MM/dd/yyyy#'
		style cells become dates; anything else ('1-2', '3.', 'abc', '') stays a
		String. A file holding only the header line gives an empty table.
		@param table_name table name
		@param path to CSV
		@return new table, Nil if the file cannot be read or parsed
		```
		table := Query.Structured.Table->FromCsv("orders", "orders.csv");
		if(table <> Nil) {
		  rs := table->Query("select * from orders where total > 100");
		  rs->ToString()->PrintLine();
		};
		```
		~#
		function : FromCsv(table_name : String, path : String) ~ Table {
			table := CsvToTable(table_name, FileReader->ReadFile(path));
			if(table = Nil) {
				"Unable to parse {$path}!"->ErrorLine();
			};
			
			return table;
		}

		function : private : CsvToTable(table_name : String, data : String) ~ Table {
			if(data = Nil) {
				return Nil;
			};

			has_rows := true;
			csv := Data.CSV.CsvTable->New(data);
			if(<>csv->IsParsed()) {
				# CsvTable wants a header and at least one record, but a header
				# alone is a valid table with no rows. Parse the lone line as a
				# header and a copy of itself, so quoting follows the CSV rules,
				# and then ignore the copy.
				line := data->Trim();
				if(line->IsEmpty() | line->Has('\n') | line->Has('\r')) {
					return Nil;
				};

				doubled := String->New(line);
				doubled += "\r\n";
				doubled += line;
				csv := Data.CSV.CsvTable->New(doubled, "\r\n");
				if(<>csv->IsParsed()) {
					return Nil;
				};
				has_rows := false;
			};

			if(csv->Size() < 1) {
				return Nil;
			};

			headers := csv->Get(0);
			columns := String->New[headers->Size()];
			each(i : headers) {	
				columns[i] := headers->Get(i);
			};

			table := Query.Structured.Table->New(table_name, columns);
			if(has_rows) {
				for(i := 1; i < csv->Size(); i += 1;) {
					csv_row := csv->Get(i);
					row1 := table->Insert();
					for(j := 0; j < columns->Size(); j += 1;) {
						# a short row leaves its missing cells Nil
						row1->Set(j + 1, Cell->FromText(csv_row->Get(j)));
					};
				};
			};
			
			return table;
		}

		#~
		Loads a table from a directory file system. Columns are: name, path_name, create_date, owner, is_dir and is_readonly.
		@param table_name table name
		@param path to directory
		@return new table
		```
		table := Query.Structured.Table->FromFilesystem("files", "/tmp/");
		rs := table->Query("select name from files where is_dir = false");
		rs->ToString()->PrintLine(); # list only files, not directories
		```
		~#
		function : FromFilesystem(table_name : String, path : String) ~ Table {
			table := Table->New(table_name, ["name", "path_name", "create_date", "owner", "is_dir", "is_readonly"]);

			if(<>path->EndsWith('/')  <>path->EndsWith('\\')) {
				path += '/';
			};

			files := Directory->List(path);
			each(i : files) {
				short_name := files[i];
				long_name := String->New(path); 
				long_name += short_name;
				file_owner := File->Owner(long_name);
				create_date := File->CreateTime(long_name);
				is_dir := Directory->Exists(long_name);
				is_readonly := File->IsReadOnly(long_name);
				
				row1 := table->Insert();
				row1->Set("name", short_name);
				row1->Set("path_name", long_name);
				row1->Set("create_date", create_date);
				row1->Set("owner", file_owner);
				row1->Set("is_dir", is_dir ? Row->True() : Row->False());
				row1->Set("is_readonly", is_readonly ? Row->True() : Row->False());
			};
			
			return table;	
		}
	}
	
	#~
	Conditional for filtering
	~#
	class : private : Conditional {
		@left : Int;
		@qualifier : Conditional->Qualifier;
		@value : Compare;
		
		#~
		Conditional comparisons 
		~#
		enum Qualifier {
			EQUAL,
			NOT_EQUAL,
			GREATER,
			LESS,
			GREATER_EQUAL,
			LESS_EQUAL,
			LIKE,
			NOT_LIKE
		}
		
		#~
		Constructor
		@param left index of column to compare
		@param qualifier comparison type
		@param value to compare against column
		~#
		New(left : Int, qualifier : Conditional->Qualifier, value : Compare) {
			@left := left;
			@qualifier := qualifier;
			@value := value;
		}
		
		#~
		Get the qualifying value
		@return qualifying value
		~#
		method : public : GetQualifier() ~ Qualifier {
			return @qualifier;
		}
		
		#~
		Gets the comparison value
		@return comparison value
		~#
		method : public : GetValue() ~ Compare {
			return @value;
		}
		
		#~
		Gets comparison index
		@return comparison index
		~#
		method : public : GetLeft() ~ Int {
			return @left;
		}
	}
	
	# Cell value helpers shared by Table and Query: numeric tests for the
	# aggregates, type-aware comparison for 'where' and 'order by', LIKE
	# matching and CSV text conversion.
	class : private : Cell {
		# Compare's result for two cells that cannot be ordered against each
		# other; the ordered results are only ever -1, 0 and 1
		function : NotComparable() ~ Int {
			return 2;
		}

		# true if the cell holds a number an aggregate can use
		function : IsNumeric(value : Compare) ~ Bool {
			if(value = Nil) {
				return false;
			};

			return value->TypeOf(IntRef) | value->TypeOf(FloatRef);
		}

		# a numeric cell as a Float; call IsNumeric first
		function : ToNumber(value : Compare) ~ Float {
			if(value->TypeOf(IntRef)) {
				return value->As(IntRef)->Get()->As(Float);
			};

			return value->As(FloatRef)->Get();
		}

		# Orders two cells: -1, 0 or 1, or NotComparable() when they cannot be
		# ordered against each other (a string and a number, a Nil cell). An
		# IntRef and a FloatRef compare by value; two cells of the same class use
		# that class's Compare, which casts its argument to its own class and so
		# must never see a different one.
		function : Compare(left : Compare, right : Compare) ~ Int {
			if(left = Nil | right = Nil) {
				return NotComparable();
			};

			if(left->TypeOf(IntRef) & right->TypeOf(IntRef)) {
				l := left->As(IntRef)->Get();
				r := right->As(IntRef)->Get();
				if(l < r) {
					return -1;
				}
				else if(l > r) {
					return 1;
				};
				return 0;
			};

			if(IsNumeric(left) & IsNumeric(right)) {
				l := ToNumber(left);
				r := ToNumber(right);
				if(l < r) {
					return -1;
				}
				else if(l > r) {
					return 1;
				};
				return 0;
			};

			if(left->GetClassID() = right->GetClassID()) {
				result := left->Compare(right);
				if(result < 0) {
					return -1;
				}
				else if(result > 0) {
					return 1;
				};
				return 0;
			};

			return NotComparable();
		}

		# applies a comparison qualifier to a Compare result; cells that cannot
		# be compared are unequal, and satisfy no ordering
		function : Test(result : Int, qualifier : Conditional->Qualifier) ~ Bool {
			if(result = NotComparable()) {
				return qualifier = Conditional->Qualifier->NOT_EQUAL;
			};

			select(qualifier) {
				label Conditional->Qualifier->EQUAL: {
					return result = 0;
				}

				label Conditional->Qualifier->NOT_EQUAL: {
					return result <> 0;
				}

				label Conditional->Qualifier->GREATER: {
					return result > 0;
				}

				label Conditional->Qualifier->LESS: {
					return result < 0;
				}

				label Conditional->Qualifier->GREATER_EQUAL: {
					return result >= 0;
				}

				label Conditional->Qualifier->LESS_EQUAL: {
					return result <= 0;
				}
			};

			return false;
		}

		# Total order for 'order by': numbers, then strings, then dates, then
		# anything else (by class name), with Nil cells last. Within a kind the
		# cells compare as in Compare.
		function : Order(left : Compare, right : Compare) ~ Int {
			left_rank := Rank(left);
			right_rank := Rank(right);
			if(left_rank <> right_rank) {
				return left_rank < right_rank ? -1 : 1;
			};

			if(left = Nil) {
				return 0;
			};

			result := Compare(left, right);
			if(result = NotComparable()) {
				return left->GetClass()->GetName()->Compare(right->GetClass()->GetName());
			};

			return result;
		}

		function : Rank(value : Compare) ~ Int {
			if(value = Nil) {
				return 4;
			}
			else if(IsNumeric(value)) {
				return 0;
			}
			else if(value->TypeOf(String)) {
				return 1;
			}
			else if(value->TypeOf(Date)) {
				return 2;
			};

			return 3;
		}

		# SQL LIKE: '%' matches any run of characters, '_' any one character,
		# everything else itself. Matched directly, not through a regex, so a
		# '.', '(' or '*' in the pattern is literal.
		function : MatchLike(check : String, pattern : String) ~ Bool {
			c := 0;
			p := 0;
			star_p := -1;
			star_c := 0;

			while(c < check->Size()) {
				if(p < pattern->Size() & pattern->Get(p) = '%') {
					star_p := p;
					star_c := c;
					p += 1;
				}
				else if(p < pattern->Size() & (pattern->Get(p) = '_' | pattern->Get(p) = check->Get(c))) {
					p += 1;
					c += 1;
				}
				else if(star_p > -1) {
					# let the last '%' absorb one more character and retry
					star_c += 1;
					c := star_c;
					p := star_p + 1;
				}
				else {
					return false;
				};
			};

			while(p < pattern->Size() & pattern->Get(p) = '%') {
				p += 1;
			};

			return p = pattern->Size();
		}

		# Classifies text as a number: 0 not a number, 1 a whole number, 2 a
		# decimal. Accepted: an optional sign, digits with an optional fraction
		# or a fraction alone ('.5'), then an optional exponent ('1e3', '2E-4').
		# A '.' must be followed by a digit, so '3.' is not a number.
		function : NumberKind(text : String) ~ Int {
			size := text->Size();
			i := 0;
			if(i < size & (text->Get(i) = '-' | text->Get(i) = '+')) {
				i += 1;
			};

			int_digits := 0;
			while(i < size & text->Get(i)->IsDigit()) {
				int_digits += 1;
				i += 1;
			};

			is_decimal := false;
			if(i < size & text->Get(i) = '.') {
				i += 1;
				frac_digits := 0;
				while(i < size & text->Get(i)->IsDigit()) {
					frac_digits += 1;
					i += 1;
				};

				if(frac_digits = 0) {
					return 0;
				};
				is_decimal := true;
			}
			else if(int_digits = 0) {
				return 0;
			};

			if(i < size & (text->Get(i) = 'e' | text->Get(i) = 'E')) {
				i += 1;
				if(i < size & (text->Get(i) = '-' | text->Get(i) = '+')) {
					i += 1;
				};

				exp_digits := 0;
				while(i < size & text->Get(i)->IsDigit()) {
					exp_digits += 1;
					i += 1;
				};

				if(exp_digits = 0) {
					return 0;
				};
				is_decimal := true;
			};

			if(i <> size) {
				return 0;
			};

			# more digits than an Int holds is kept as an approximate Float
			if(is_decimal | int_digits > 18) {
				return 2;
			};

			return 1;
		}

		# a CSV cell's text as a table value
		function : FromText(text : String) ~ Compare {
			if(text = Nil) {
				return Nil;
			};

			kind := NumberKind(text);
			if(kind = 1) {
				return IntRef->New(text->ToInt());
			}
			else if(kind = 2) {
				return FloatRef->New(text->ToFloat());
			};

			# date
			if(text->Size() > 1 & text->StartsWith('#') & text->EndsWith('#')) {
				str_value := text->SubString(1, text->Size() - 2);
				select(str_value->Size()) {
					label 8: {
						return DateUtility->Parse(str_value, "MM/dd/yy", false);
					}

					label 10: {
						return DateUtility->Parse(str_value, "MM/dd/yyyy", false);
					}

					label 17: {
						return DateUtility->Parse(str_value, "MM/dd/yy hh:mm:ss", false);
					}

					label 19: {
						return DateUtility->Parse(str_value, "MM/dd/yyyy hh:mm:ss", false);
					}
				};

				return str_value;
			};

			return text;
		}
	}
	
	#~
	Row in table
	~#
	class Row {
		@values : Compare[];
		@table : Table;
		@true_token : static : IntRef;
		@false_token : static : IntRef;
		@next : Row;
		@prev : Row;
		
		New(table : Table, values : Compare[]) {
			@table := table;
			@values := values;
		}
		
		#~
		Gets value by name
		@param name column name
		@return value
		~#
		method : public : Get(name : String) ~ Compare {
			return Get(@table->GetIndex(name));
		}
		
		#~
		Sets value by name
		@param name column name
		@param value value
		@return ture of successful, false otherwise
		~#
		method : public : Set(name : String, value : Compare) ~ Bool {
			return Set(@table->GetIndex(name), value);
		}
		
		#~
		Gets value by index
		@param index column index
		@return value
		~#
		method : public : Get(index : Int) ~ Compare {
			if(index < 0 | index >= @values->Size()) {
				return Nil;
			};
			
			return @values[index];
		}
		
		#~
		Sets value by index
		@param index column index
		@param value value
		@return ture of successful, false otherwise
		~#
		method : public : Set(index : Int, value : Compare) ~ Bool {
			if(index < 0 | index >= @values->Size()) {
				return false;
			};
			
			@values[index] := value;
			return true;
		}
		
		#~
		Helper for setting 'true' column value
		@return 'true' value holder
		~#
		function : True() ~ IntRef {
			if(@true_token = Nil) {
				@true_token := IntRef->New(1);
			};
			
			return @true_token;
		}
		
		#~
		Helper for setting 'false' column value
		@return 'false' value holder
		~#
		function : False() ~ IntRef {
			if(@false_token = Nil) {
				@false_token := IntRef->New(0);
			};
			
			return @false_token;
		}
			
		method : public : Next() ~ Row {
			return @next;
		}
		
		method : public : Next(next : Row) ~ Nil {
			@next := next;
		}
		
		method : public : Prev() ~ Row {
			return @prev;
		}
		
		method : public : Prev(prev : Row) ~ Nil {
			@prev := prev;
		}
		
		#~
		Gets the number of columns
		@return number of columns
		~#
		method : public : Size() ~ Int {
			return @values->Size();
		}
		
		#~
		String representation of row1
		@return row1 as string
		~#
		method : public : ToString() ~ String {
			buffer := "";

			each(i : @values) {
				value := @values[i];
				
				if(value <> Nil) {
					if(value->TypeOf(IntRef)) {
						buffer += value->As(IntRef)->ToString();
					}
					else if(value->TypeOf(FloatRef)) {
						buffer += value->As(FloatRef)->ToString();
					}
					else if(value->TypeOf(Date)) {
						buffer += value->As(Date)->ToString();
					}
					else if(value->TypeOf(String)) {
						buffer += value->As(String);
					}
					else {
						buffer += value->GetClass()->GetName();
					};
				}
				else {
						buffer += "<Nil>";
				};	
					
				buffer += ", ";
			};
			
			return buffer;
		}
	}
	
	class Query {
		@parser : Parser;
		@terms : Term;
		@table : Table;
		@error : String;
		
		New(line : String, table : Table) {
			@table := table;
			@parser := Parser->New(line);
		}
		
		method : public : Query() ~ Table {
			expr := @parser->Parse();
			if(expr = Nil) {
				@error := "*** Parse error ***";
				return Nil;
			};
			
			if(expr->GetType() = Token->Type->SELECT) {

				results := ProcessSelect(expr);
				if(results = Nil) {
					@error := "*** Select error ***";
					return Nil;
				};
				
				return results;
			}
			else if(expr->GetType() = Token->Type->FROM) {
				results := ProcessFrom(expr)<Row>;
				if(results = Nil) {
					@error := "*** From error ***";
					return Nil;
				};
				
				names := @table->GetColumnNames();
				column_names := String->New[names->Size() - 1];
				each(i : column_names) {
					column_names[i] := names[i + 1];
				};
								
				order_by : String;
				order := expr->GetRight();
				if(order <> Nil & order->GetType() = Token->Type->REF) {
					order_by := order->GetValue()->As(String);
				};

				return BuildTable("<rs>", column_names, results, order_by);
			}
			else {
				@error := "*** General error ***";
				return Nil;
			};
			
			return Nil;
		}

		method : public : GetError() ~ String {
			return @error;
		}
		
		method : ProcessSelect(expr : Term) ~ Table {
# "== Select =="->PrintLine();
			results := ProcessFrom(expr->GetLeft());
			if(results = Nil) {
				return Nil;
			};
			columns := expr->GetTerms();
						
			column_names : String[];
			if(columns->Size() = 1 & columns->Get(0)->As(Term)->GetType() = Token->Type->STAR) {
				names := @table->GetColumnNames();
				column_names := String->New[names->Size() - 1];
				each(i : column_names) {
					column_names[i] := names[i + 1];
				};
			}
			else if(columns->Size() = 2 & 
					columns->Get(0)->As(Term)->GetType() = Token->Type->DISTINCT & 
					columns->Get(1)->As(Term)->GetType() = Token->Type->REF) {
				column_names := String->New[1];
				column_name := columns->Get(1)->As(Term)->GetValue()->As(String);
				column_names[0] := column_name;
				results := Unique(column_name, results);
			}
			else {
				column_names := String->New[columns->Size()];
				each(i : columns) {
					column_names[i] := columns->Get(i)->As(Term)->GetValue()->As(String);
				};
			};

			if(expr->GetRight() <> Nil) {
				order_by := expr->GetRight()->GetValue()->As(String);
				return BuildTable("<rs>", column_names, results, order_by);
			};
						
			return BuildTable("<rs>", column_names, results, Nil);
		}
		
		method : Unique(col : String, input : Vector<Row>) ~ Vector<Row> {
			out := Vector->New()<Row>;

			index := @table->GetIndex(col);
			if(index < 0) {
				return out;
			};

			# Use hash for O(n) lookup instead of O(n²) nested loops
			seen := Hash->New()<Compare, BoolRef>;

			each(i : input) {
				in_row := input->Get(i);
				left := in_row->Get(index);

				if(left <> Nil & <>seen->Has(left)) {
					seen->Insert(left, true);
					out->AddBack(in_row);
				};
			};

			return out;
		}
		
		method : BuildTable(name : String, column_names : String[], from_results : Vector<Row>, order_by : String) ~ Table {
			table := Table->New(name, column_names);

			if(order_by <> Nil) {
				order_index := @table->GetIndex(order_by);
				if(order_index > -1) {
					# a stable sort: rows sharing an order value (or holding Nil)
					# all stay, in their original order
					from_results := SortRows(from_results, order_index);
				};
			};
			
			each(i : from_results) {
				row1 := from_results->Get(i);
				result_row := table->Insert();
				each(j : column_names) {
					column_name := column_names[j];
					result_row->Set(column_name, row1->Get(column_name));
				};
			};

			return table;
		}

		# bottom-up merge sort of rows by one column, stable
		method : SortRows(rows : Vector<Row>, index : Int) ~ Vector<Row> {
			size := rows->Size();
			src := Row->New[size];
			each(i : src) {
				src[i] := rows->Get(i);
			};
			dest := Row->New[size];

			width := 1;
			while(width < size) {
				start := 0;
				while(start < size) {
					middle := start + width;
					if(middle > size) {
						middle := size;
					};
					finish := start + width * 2;
					if(finish > size) {
						finish := size;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						take_left := l < middle;
						if(take_left & r < finish) {
							left_row := src[l];
							right_row := src[r];
							take_left := Cell->Order(left_row->Get(index), right_row->Get(index)) <= 0;
						};

						if(take_left) {
							dest[k] := src[l];
							l += 1;
						}
						else {
							dest[k] := src[r];
							r += 1;
						};
						k += 1;
					};

					start := finish;
				};

				swap := src;
				src := dest;
				dest := swap;
				width *= 2;
			};

			sorted := Vector->New()<Row>;
			each(i : src) {
				sorted->AddBack(src[i]);
			};

			return sorted;
		}
		
		method : ProcessFrom(expr : Term) ~ Vector<Row> {
# "== From =="->PrintLine();
			
			name := expr->GetValue()->As(String);
			if(<>name->Equals(@table->GetName())) {
				return Nil;
			};
			
			# where
			left := expr->GetLeft();
			if(left <> Nil & left->GetType() = Token->Type->WHERE) {
				return ProcessTerm(left->GetLeft());
			}
			else {
				return @table->GetAll();
			};
		}
		
		method : ProcessTerm(expr : Term) ~ Vector<Row> {
			if(expr = Nil) {
				return Nil;
			};

			left := expr->GetLeft();
			right := expr->GetRight();
			if(left = Nil | right = Nil) {
 				return Nil;
 			};
			
			select(expr->GetType()) {
				label Token->Type->AND: {
# "== And =="->PrintLine();		
					left_result := ProcessTerm(left);
					if(left_result = Nil) {
						return Nil;
					};

					right_result := ProcessTerm(right);
					if(right_result = Nil) {
						return Nil;
					};

					return MergeAnd(left_result, right_result);
				}
				
				label Token->Type->OR: {
# "== Or =="->PrintLine();		
					left_result := ProcessTerm(left);
					if(left_result = Nil) {
						return Nil;
					};

					right_result := ProcessTerm(right);
					if(right_result = Nil) {
						return Nil;
					};

					return MergeOr(left_result, right_result);
				}
				
				other: {
					index := @table->GetIndex(left->GetValue()->As(String));
					if(index > -1) {
						cond := MakeCondition(index, expr->GetType(), expr->GetNot(), right->GetValue());
						if(cond <> Nil) {
							return @table->Filter(cond);
						};
					};
				}
			};

			return Nil;
		}

		# A comparison term as a filter. 'not' negates any operator: 'not =' is
		# '<>', 'not >' is '<=' and so on. Nil if the term is not a comparison.
		method : MakeCondition(index : Int, type : Token->Type, is_not : Bool, value : Compare) ~ Conditional {
			select(type) {
				label Token->Type->EQUAL: {	
					return Conditional->New(index, is_not ? Conditional->Qualifier->NOT_EQUAL : Conditional->Qualifier->EQUAL, value);
				}
				
				label Token->Type->NOT_EQUAL: {
					return Conditional->New(index, is_not ? Conditional->Qualifier->EQUAL : Conditional->Qualifier->NOT_EQUAL, value);
				}
				
				label Token->Type->GREATER: {
					return Conditional->New(index, is_not ? Conditional->Qualifier->LESS_EQUAL : Conditional->Qualifier->GREATER, value);
				}
				
				label Token->Type->LESS: {
					return Conditional->New(index, is_not ? Conditional->Qualifier->GREATER_EQUAL : Conditional->Qualifier->LESS, value);
				}
				
				label Token->Type->GREATER_EQUAL: {
					return Conditional->New(index, is_not ? Conditional->Qualifier->LESS : Conditional->Qualifier->GREATER_EQUAL, value);
				}
				
				label Token->Type->LESS_EQUAL: {
					return Conditional->New(index, is_not ? Conditional->Qualifier->GREATER : Conditional->Qualifier->LESS_EQUAL, value);
				}
				
				label Token->Type->LIKE: {
					return Conditional->New(index, is_not ? Conditional->Qualifier->NOT_LIKE : Conditional->Qualifier->LIKE, value);
				}
			};
			
			return Nil;
		}
		
		method : MergeAnd(left : Vector<Row>, right : Vector<Row>) ~ Vector<Row> {
			merged := Vector->New()<Row>;

			if(left <> Nil & right <> Nil) {
				# Build hash from left set for O(1) lookup
				left_set := Hash->New()<IntRef, Row>;
				each(i : left) {
					row := left->Get(i);
					left_set->Insert(row->GetInstanceID(), row);
				};

				# Find intersection: items in both sets
				each(i : right) {
					right_value := right->Get(i);
					if(left_set->Has(right_value->GetInstanceID())) {
						merged->AddBack(right_value);
					};
				};
			};

			return merged;
		}
		
		method : MergeOr(left : Vector<Row>, right : Vector<Row>) ~ Vector<Row> {
			if(left <> Nil & right <> Nil) {
				# Build hash from left set for O(1) lookup
				left_set := Hash->New()<IntRef, Row>;
				each(i : left) {
					row := left->Get(i);
					left_set->Insert(row->GetInstanceID(), row);
				};

				# Find union: add items from right that aren't in left
				each(i : right) {
					right_value := right->Get(i);
					if(<>left_set->Has(right_value->GetInstanceID())) {
						left->AddBack(right_value);
					};
				};
			};

			return left;
		}
	}
	
	class Parser {
		@line : String;
		@tokens : Vector<Token>;
		@tokens_index : Int;
		@cur_token : Token;
		@reserved : Map<String, Token>;

		New(line : String) {
			@line := line;

			@reserved := Map->New()<String, Token>;
			@reserved->Insert("select", Token->New(Token->Type->SELECT));
			@reserved->Insert("distinct", Token->New(Token->Type->DISTINCT));
			@reserved->Insert("from", Token->New(Token->Type->FROM));
			@reserved->Insert("where", Token->New(Token->Type->WHERE));
			@reserved->Insert("not", Token->New(Token->Type->NOT));
			@reserved->Insert("like", Token->New(Token->Type->LIKE));
			@reserved->Insert("between", Token->New(Token->Type->BETWEEN));
			@reserved->Insert("in", Token->New(Token->Type->IN));
			@reserved->Insert("and", Token->New(Token->Type->AND));
			@reserved->Insert("or", Token->New(Token->Type->OR));
			@reserved->Insert("true", Token->New(1));
			@reserved->Insert("false", Token->New(0));
			@reserved->Insert("order", Token->New(Token->Type->ORDER));
			@reserved->Insert("by", Token->New(Token->Type->BY));
		}
		
		method : public : Parse() ~ Term {
			@tokens := Scan();

			term : Term;
			if(@tokens = Nil)	{
				return Nil;
			};			
			NextToken();

			if(TokenType() = Token->Type->SELECT) {
				NextToken();		
				term := ParseSelect();
			}
			else if(TokenType() = Token->Type->FROM) {
				NextToken();
				term := ParseFrom();
			};

			if(term <> Nil & TokenType() = Token->Type->ORDER) {
				NextToken();

				if(TokenType() <> Token->Type->BY) {
					return Nil;
				};
				NextToken();

				if(TokenType() <> Token->Type->REF) {
					return Nil;
				};

				right := Term->New(TokenType());
				right->SetValue(TokenValue());
				term->SetRight(right);
				NextToken();
			};

			# anything left over is an error, not something to skip past
			if(TokenType() <> Token->Type->EOS) {
				return Nil;
			};
			
			return term;
		}
		
		method : ParseSelect() ~ Term {
# "--- Select ---"->PrintLine();		
			term := Term->New(Token->Type->SELECT);
			term->SetValue(TokenValue());
			
			if(TokenType() = Token->Type->STAR) {
				term->AddTerm(Term->New(TokenType()));
				NextToken();		
			}
			else if(TokenType() = Token->Type->DISTINCT) {
				term->AddTerm(Term->New(TokenType()));
				NextToken();
				
				if(TokenType() <> Token->Type->REF) {
					return Nil;
				};
				name := Term->New(TokenType());
				name->SetValue(TokenValue());
				term->AddTerm(name);
				NextToken();
			}
			else {
				do {
					if(TokenType() <> Token->Type->REF) {
						return Nil;
					};
					name := Term->New(TokenType());
					name->SetValue(TokenValue());
					term->AddTerm(name);
					NextToken();

				
					if(TokenType() = Token->Type->COMMA) {
						NextToken();
					};
				}
				while(TokenType() <> Token->Type->EOS & TokenType() <> Token->Type->FROM);
			};
			
			if(TokenType() <> Token->Type->FROM) {			
				return Nil;
			};
			
			NextToken();
			left := ParseFrom();
			if(left = Nil) {			
				return Nil;
			};
			term->SetLeft(left);

			return term;
		}

		method : ParseFrom() ~ Term {
# "--- From ---"->PrintLine();

			if(TokenType() <> Token->Type->REF) {
				return Nil;
			};
			term := Term->New(Token->Type->FROM);
			term->SetValue(TokenValue());
			NextToken();
			
			if(TokenType() = Token->Type->WHERE) {
				NextToken();
				left := ParseWhere();
				if(left = Nil) {
					return Nil;
				};
				term->SetLeft(left);
			};
			
			term->SetRight(Term->New(Token->Type->EOS));
			return term;
		}

		# where := or_expr
		# or_expr := and_expr ('or' and_expr)*
		# and_expr := primary ('and' primary)*
		# primary := '(' or_expr ')' | comparison
		# 'and' binds tighter than 'or', as in SQL.
		method : public : ParseWhere() ~ Term {
			left := ParseOr();
			if(left = Nil) {
				return Nil;
			};
			
			where := Term->New(Token->Type->WHERE);
			where->SetLeft(left);
			return where;
		}
		
		method : ParseOr() ~ Term {
			left := ParseAnd();
			if(left = Nil) {
				return Nil;
			};
			
			while(TokenType() = Token->Type->OR) {
				term := Term->New(TokenType());
				term->SetValue(TokenValue());
				NextToken();
				
				right := ParseAnd();
				if(right = Nil) {
					return Nil;
				};
				
				term->SetLeft(left);
				term->SetRight(right);
				left := term;
			};

			return left;
		}
		
		method : ParseAnd() ~ Term {
			left := ParsePrimary();
			if(left = Nil) {
				return Nil;
			};

			while(TokenType() = Token->Type->AND) {
				term := Term->New(TokenType());
				term->SetValue(TokenValue());
				NextToken();

				right := ParsePrimary();
				if(right = Nil) {
					return Nil;
				};

				term->SetLeft(left);
				term->SetRight(right);
				left := term;
			};

			return left;
		}

		method : ParsePrimary() ~ Term {
			if(TokenType() = Token->Type->OPRN) {
				NextToken();

				expr := ParseOr();
				if(expr = Nil | TokenType() <> Token->Type->CPRN) {
					return Nil;
				};
				NextToken();

				return expr;
			};

			return ParseTerm();
		}
		
		# column [not] operator value; the left side must name a column
		method : ParseTerm() ~ Term {
			if(TokenType() <> Token->Type->REF) {
				return Nil;
			};
			
			left := Term->New(TokenType());
			left->SetValue(TokenValue());
			NextToken();

			is_not := false;
			if(TokenType() = Token->Type->NOT) {
				is_not := true;
				NextToken();		
			};
			
			term : Term;
			select(TokenType()) {
				label Token->Type->LIKE:
				label Token->Type->EQUAL:
				label Token->Type->NOT_EQUAL:
				label Token->Type->LESS:
				label Token->Type->GREATER:
				label Token->Type->LESS_EQUAL:
				label Token->Type->GREATER_EQUAL: {				
					term := Term->New(TokenType());
					term->SetValue(TokenValue());
					term->SetNot(is_not);
					NextToken();
				}

				other: {
					return Nil;
				}
			};
			
			right : Term;			
			select(TokenType()) {
				label Token->Type->REF:
				label Token->Type->DATE:
				label Token->Type->INT:
				label Token->Type->FLOAT: {			
					right := Term->New(TokenType());					
					right->SetValue(TokenValue());
					NextToken();
				}
				
				other: {
					return Nil;
				}
			};
		
			term->SetLeft(left);
			term->SetRight(right);
			
			return term;
		}
		
		method : NextToken() ~ Bool {
			if(@tokens_index < @tokens->Size()) {
				@cur_token := @tokens->Get(@tokens_index);
				@tokens_index += 1;
				return true;
			};
			
			@cur_token := Nil;
			return false;
		}
		
		method : TokenType() ~ Token->Type {
			if(@cur_token <> Nil) {
				return @cur_token->GetType();
			};
			
			return Token->Type->EOS;
		}
		
		method : TokenValue() ~ Compare {
			if(@cur_token <> Nil) {
				return @cur_token->GetValue();
			};
			
			return "";
		}
		
		# the character at index, or '\0' past the end of the line
		method : Peek(index : Int) ~ Char {
			if(index < @line->Size()) {
				return @line->Get(index);
			};

			return '\0';
		}

		# a number starts with a digit, or a '-' or '.' that leads to one
		method : IsNumberStart(index : Int) ~ Bool {
			c := Peek(index);
			if(c->IsDigit()) {
				return true;
			};

			if(c = '-') {
				index += 1;
				c := Peek(index);
				if(c->IsDigit()) {
					return true;
				};
			};

			return c = '.' & Peek(index + 1)->IsDigit();
		}

		method : native : Scan() ~ Vector<Token> {
			i := 0;
			tokens := Vector->New()<Token>;
			while(i < @line->Size()) { 			 			  
				# skip whitespace
				while(i < @line->Size() & (@line->Get(i) = ' ' | @line->Get(i) = '\t' | @line->Get(i) = '\r' | @line->Get(i) = '\n')) {
					i += 1;					
				};
				
				# parse the @line
				if(i < @line->Size()) {
					# string
					if(@line->Get(i) = '\'') {
						string := "";
						i += 1;
						while(i < @line->Size() & @line->Get(i) <> '\'') {
							string->Append(@line->Get(i));
							i += 1;
						};
						
						# unterminated
						if(i >= @line->Size()) {
							return Nil;
						};
						i += 1;
						
						tokens->AddBack(Token->New(string));
					}
					# date
					else if(@line->Get(i) = '#') {
						i += 1;					
						string := "";
						while(i < @line->Size() & @line->Get(i) <> '#') {
							string->Append(@line->Get(i));
							i += 1;
						};
					
						# unterminated
						if(i >= @line->Size()) {
							return Nil;
						};
						i += 1;
						
						date : Date;
						select(string->Size()) {
							label 8: {
								date := DateUtility->Parse(string, "MM/dd/yy", false);
							}
							
							label 10: {						
								date := DateUtility->Parse(string, "MM/dd/yyyy", false);	
							}
							
							label 17: {
								date := DateUtility->Parse(string, "MM/dd/yy hh:mm:ss", false);
							}
							
							label 19: {
								date := DateUtility->Parse(string, "MM/dd/yyyy hh:mm:ss", false);
							}
						};

						if(date = Nil) {
							return Nil;
						};
						tokens->AddBack(Token->New(date));
					}
					# word: a letter or '_', then letters, digits and '_'
					else if(@line->Get(i)->IsChar() | @line->Get(i) = '_') {
						string := "";
						while(i < @line->Size() & (@line->Get(i)->IsChar() | @line->Get(i)->IsDigit() | @line->Get(i) = '_')) {
							string->Append(@line->Get(i));
							i += 1;
						};

						result := @reserved->Find(string->ToLower());
						if(result <> Nil) {
							tokens->AddBack(result);
						}
						else {
							tokens->AddBack(Token->New(string));
						};
					}
					# number: optional '-', digits and '.', optional exponent
					else if(IsNumberStart(i)) {
						number := "";
						if(@line->Get(i) = '-') {
							number->Append('-');
							i += 1;
						};

						while(i < @line->Size() & (@line->Get(i)->IsDigit() | @line->Get(i) = '.')) {
							number->Append(@line->Get(i));
							i += 1;
						};

						if(i < @line->Size() & (@line->Get(i) = 'e' | @line->Get(i) = 'E')) {
							number->Append(@line->Get(i));
							i += 1;
							if(i < @line->Size() & (@line->Get(i) = '-' | @line->Get(i) = '+')) {
								number->Append(@line->Get(i));
								i += 1;
							};
							while(i < @line->Size() & @line->Get(i)->IsDigit()) {
								number->Append(@line->Get(i));
								i += 1;
							};
						};

						kind := Cell->NumberKind(number);
						if(kind = 1) {
							tokens->AddBack(Token->New(number->ToInt()));
						}
						else if(kind = 2) {
							tokens->AddBack(Token->New(number->ToFloat()));
						}
						else {
							return Nil;
						};
					}
					else {
						select(@line->Get(i)) {
							label '*': {
								tokens->AddBack(Token->New(Token->Type->STAR));
							}

							label ',': {
								tokens->AddBack(Token->New(Token->Type->COMMA));
							}
							
							label '(': {
								tokens->AddBack(Token->New(Token->Type->OPRN));
							}
							
							label ')': {
								tokens->AddBack(Token->New(Token->Type->CPRN));
							}
							
							label '=': {
								tokens->AddBack(Token->New(Token->Type->EQUAL));
							}
							
							label '<': {
								if(Peek(i + 1) = '>') {
									i += 1;
									tokens->AddBack(Token->New(Token->Type->NOT_EQUAL));
								}
								else if(Peek(i + 1) = '=') {
									i += 1;
									tokens->AddBack(Token->New(Token->Type->LESS_EQUAL));
								}
								else {
									tokens->AddBack(Token->New(Token->Type->LESS));
								};
							}
							
							label '!': {
								if(Peek(i + 1) <> '=') {
									return Nil;
								};
								i += 1;
								tokens->AddBack(Token->New(Token->Type->NOT_EQUAL));
							}

							label '>': {
								if(Peek(i + 1) = '=') {
									i += 1;
									tokens->AddBack(Token->New(Token->Type->GREATER_EQUAL));
								}
								else {
									tokens->AddBack(Token->New(Token->Type->GREATER));
								};
							}
              
							other: {
								return Nil;
							}
						};
						i += 1;
					};
				};			
			};			
			tokens->AddBack(Token->New(Token->Type->EOS));

			return tokens;
		}
	}
	
	class Term {
		@type : Token->Type;
		@oper : Conditional->Qualifier;
		@left : Term;
		@right : Term;
		@terms : Vector<Term>;
		@value : Compare;
		@is_not : Bool;

		
		New(type : Token->Type) {
			@type := type;
		}
		
		method : public : GetType() ~ Token->Type {
			return @type;
		}
		
		method : public : SetType(type : Token->Type) ~ Nil {
			@type := type;
		}

		method : public : GetNot() ~ Bool {
			return @is_not;
		}
		
		method : public : SetNot(is_not : Bool) ~ Nil {
			@is_not := is_not;
		}
		
		method : public : GetOperator() ~ Conditional->Qualifier {
			return @oper;
		}
		
		method : public : SetOperator(oper : Conditional->Qualifier) ~ Nil {
			@oper := oper;
		}
		
		method : public : SetValue(value : Compare) ~ Nil {
			@value := value;
		}
		
		method : public : GetValue() ~ Compare {
			return @value;
		}
		
		method : public : SetLeft(left : Term) ~ Nil {
			@left := left;
		}
		
		method : public : GetLeft() ~ Term {
			return @left;
		}
		
		method : public : SetRight(right : Term) ~ Nil {
			@right := right;
		}
		
		method : public : GetRight() ~ Term {
			return @right;
		}
		
		method : public : AddTerm(term : Term) ~ Nil {
			if(@terms = Nil) {
				@terms := Vector->New()<Term>;
			};
			
			@terms->AddBack(term);
		}
		
		method : public : GetTerms() ~ Vector<Term> {
			return @terms;
		}
	}
	
	class Token {
		@type : Type;
		@value : Compare;

		enum Type {
			SELECT,
			DISTINCT,
			FROM,
			WHERE,
			LIKE,
			NOT,
			BETWEEN,
			IN,
			AND,
			OR,
			ORDER,
			BY,
			STAR,
			COMMA,
			OPRN,
			CPRN,
			EQUAL,
			NOT_EQUAL,
			LESS_EQUAL,
			LESS,
			GREATER_EQUAL,
			GREATER,
			REF,
			OPER,
			INT,
			FLOAT,
			DATE,
			TRUE,
			FASLE,
			EOS
		}
		
		New(value : String) {
			@type := Type->REF;
			@value := value;
		}
		
		New(value : Date) {
			@type := Type->DATE;
			@value := value;
		}
		
		New(type : Type) {
			@type := type;
			@value := "";
		}
		
		New(value : Float) {
			@type := Type->FLOAT;
			@value := FloatRef->New(value);
		}

		New(value : Int) {
			@type := Type->INT;
			@value := IntRef->New(value);
		}
		
		method : public : GetType() ~ Type {
			return @type;
		}
		
		method : public : GetValue() ~ Compare {
			return @value;
		}

		method : public : ToString() ~ String {
			buffer := "";

			select(@type) {
				label Type->SELECT: {
					buffer += "SELECT";
				}

				label Type->DISTINCT: {
					buffer += "DISTINCT";
				}
				
				label Type->FROM: {
					buffer += "FROM";
				}

				label Type->WHERE: {
					buffer += "WHERE";
				}

				label Type->LIKE: {
					buffer += "LIKE";
				}

				label Type->NOT: {
					buffer += "NOT";
				}

				label Type->BETWEEN: {
					buffer += "BETWEEN";
				}

				label Type->IN: {
					buffer += "IN";
				}

				label Type->AND: {
					buffer += "AND";
				}

				label Type->OR: {
					buffer += "OR";
				}

				label Type->STAR: {
					buffer += "STAR";
				}

				label Type->ORDER: {
					buffer += "ORDER";
				}

				label Type->BY: {
					buffer += "BY";
				}

				label Type->COMMA: {
					buffer += "COMMA";
				}

				label Type->OPRN: {
					buffer += "OPRN";
				}
				
				label Type->CPRN: {
					buffer += "CPRN";
				}

				label Type->EQUAL: {
					buffer += "EQUAL";
				}

				label Type->NOT_EQUAL: {
					buffer += "NOT_EQUAL";
				}

				label Type->LESS_EQUAL: {
					buffer += "LESS_EQUAL";
				}

				label Type->LESS: {
					buffer += "LESS";
				}

				label Type->GREATER_EQUAL: {
					buffer += "GREATER_EQUAL";
				}

				label Type->GREATER: {
					buffer += "GREATER";
				}

				label Type->REF: {
					buffer += "REF, value='";
					buffer += @value->As(String);
					buffer += '"';
				}

				label Type->INT: {
					buffer += "INT, value=";
					buffer += @value->As(IntRef)->Get();
				}

				label Type->FLOAT: {
					buffer += "FLOAT, value=";
					f := @value->As(FloatRef);
					buffer += f->Get();
				}

				label Type->EOS: {
					buffer += "EOS";
				}
			};

			return buffer;
		}
	}

	#~
	Supports string data queries
	~#
	class Finder {
		@regex : RegEx;

		#~
		Default constructor
		@param expr regex expression
		```
		finder := Query.Structured.Finder->New(".*\\.obs$"); # match .obs files
		matches := finder->FindFiles("/home/user/src");
		each(i : matches) { matches->Get(i)->PrintLine(); };
		```
		~#
		New(expr : String) {
			@regex := RegEx->New(expr);
		}

		#~
		Finds matching files in a given directory
		@param path root directory to start searching
		@return matching file names
		```
		finder := Query.Structured.Finder->New(".*\\.json$"); # find JSON files
		results := finder->FindFiles("/etc/");
		each(i : results) {
		  results->Get(i)->PrintLine();
		};
		```
		~#
		method : public : FindFiles(path : String) ~ Vector<String> {
			matches := Vector->New()<String>;

			if(@regex->IsOk()) {
				FindFiles(path, matches);
			};
			
			return matches;
		}

		method : FindFiles(path : String, matches : Vector<String>) ~ Nil {
			files := Directory->List(path);
			each(i : files) {
				file := files[i];
				if(<>file->StartsWith('.')) {
					dir_path := String->New(path);
					dir_path += '/';
					dir_path += file;
					
					if(Directory->Exists(dir_path)) {
						FindFiles(dir_path, matches);
					}
					else if(File->Exists(dir_path)) {
						full_name := File->GetFullName(dir_path);
						if(@regex->MatchExact(full_name)) {
							matches->AddBack(full_name);
						};
					};
				};
			};
		}
	}
}
