#~~
Query.Structured: an in-memory, column-oriented query engine
Copyright (c) 2017-2026 Randy Hollines
~~#

use Collection;
use System.Time;
use Query.RegEx;
use System.IO.Filesystem;
use Data.XML;

#~
In-memory query engine over typed columns. Tables are filled row by row or loaded from sources (CSV files, folders, the program's own objects) and queried with SQL-like statements; aggregates, Describe() and Finder (file search) are included. Compile with -lib query.
~#
bundle Query.Structured {
	#~
	The storage type of a column. NONE is a column that has held no value yet; it takes the
	type of the first value stored in it.
	~#
	enum ColumnType {
		NONE,
		INT,
		FLOAT,
		STRING,
		DATE,
		BOOL,
		OBJECT
	}

	#~
	One column of a table, held as a typed array rather than one object per cell. A column is
	either declared, in which case storing a value of the wrong type is refused, or inferred
	from its first value, in which case an Int widens into a Float column, a Float promotes an
	Int column to Float, and any other mix promotes the column to OBJECT so every value is kept
	as it was given. Empty cells are tracked in a bitmap allocated with the first one. Text
	columns store each distinct string once while they have few of them. Numeric and date
	columns keep the minimum and maximum of every 65,536-row group, so a filter can skip groups.
	~#
	class Column {
		@name : String;
		@type : ColumnType;
		@declared : Bool;
		@size : Int;
		@capacity : Int;
		@ints : Int[];
		@floats : Float[];
		@strings : String[];
		@objects : Compare[];
		@nulls : Int[];
		@null_count : Int;
		@encoded : Bool;
		@dict : String[];
		@dict_size : Int;
		@dict_index : Hash<String, IntRef>;
		@gmt : Int[];
		@zone_min : Float[];
		@zone_max : Float[];
		@zone_stale : Bool[];
		@promotions : Int;
		@error : String;
		@col_index : ColumnIndex;

		#~
		Constructor
		@param name column name
		@param type storage type; NONE takes the type of the first value stored
		@param declared true to refuse values of another type
		~#
		New(name : String, type : ColumnType, declared : Bool) {
			@name := name;
			@type := ColumnType->NONE;
			@declared := declared;
			@encoded := true;
			@capacity := 0;
			Ensure(16);
			if(type <> ColumnType->NONE) {
				Become(type);
			};
		}

		#~
		Rows in a zone-map group
		@return rows per group
		~#
		function : GroupRows() ~ Int {
			return 65536;
		}

		#~
		Distinct strings a text column keeps in its dictionary before it may store plain strings
		@return dictionary size limit
		~#
		function : DictionaryLimit() ~ Int {
			return 4096;
		}

		#~
		Gets the column name
		@return column name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Gets the storage type
		@return storage type
		~#
		method : public : GetType() ~ ColumnType {
			return @type;
		}

		#~
		Whether the column's type was declared, so mismatched values are refused
		@return true if declared
		~#
		method : public : IsDeclared() ~ Bool {
			return @declared;
		}

		#~
		Gets the number of rows, empty ones included
		@return number of rows
		~#
		method : public : Size() ~ Int {
			return @size;
		}

		#~
		Gets the number of empty cells
		@return number of empty cells
		~#
		method : public : GetNullCount() ~ Int {
			return @null_count;
		}

		#~
		Whether a text column stores its values as dictionary codes
		@return true if dictionary encoded
		~#
		method : public : IsEncoded() ~ Bool {
			return @type = ColumnType->STRING & @encoded;
		}

		#~
		Gets the number of distinct strings in a dictionary-encoded column
		@return dictionary size, 0 if not encoded
		~#
		method : public : GetDictionarySize() ~ Int {
			if(IsEncoded()) {
				return @dict_size;
			};

			return 0;
		}

		#~
		Gets how many times the column changed type to keep a value
		@return number of promotions
		~#
		method : public : GetPromotions() ~ Int {
			return @promotions;
		}

		#~
		Gets the reason the last value was refused
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Gets the kind of index the column has (see Table->CreateIndex)
		@return HASH, SORTED, or NONE if it has none
		~#
		method : public : GetIndexKind() ~ IndexKind {
			if(@col_index = Nil) {
				return IndexKind->NONE;
			};

			return @col_index->GetKind();
		}

		#~
		Gets the name of the column's index
		@return index name, Nil if it has none
		~#
		method : public : GetIndexName() ~ String {
			if(@col_index = Nil) {
				return Nil;
			};

			return @col_index->GetName();
		}

		#~
		Gets the column's index. Used by Table and the query planner.
		@return index, Nil if none
		~#
		method : public : GetColumnIndex() ~ ColumnIndex {
			return @col_index;
		}

		#~
		Gives the column an index, or takes it away. Used by Table->CreateIndex and DropIndex.
		@param index index, Nil for none
		~#
		method : public : SetColumnIndex(index : ColumnIndex) ~ Nil {
			@col_index := index;
		}

		#~
		Tells the column's index that a row was deleted from its table. Used by Table->Delete.
		@param row row slot
		~#
		method : public : IndexDeleted(row : Int) ~ Nil {
			if(@col_index <> Nil) {
				@col_index->Deleted(row);
			};
		}

		# every write of one cell ends here, so the index sees each change
		method : IndexChanged(row : Int) ~ Nil {
			if(@col_index <> Nil) {
				@col_index->Changed(@self, row);
			};
		}

		# the column's arrays were rewritten as a whole: the index is rebuilt when next used
		method : IndexStale() ~ Nil {
			if(@col_index <> Nil) {
				@col_index->SetStale();
			};
		}

		#~
		Adds an empty cell at the end. Used by Table.
		~#
		method : public : Append() ~ Nil {
			Ensure(@size + 1);
			@size += 1;
			SetNullBit(@size - 1, true);
		}

		#~
		Whether a cell is empty
		@param row row number
		@return true if empty or out of range
		~#
		method : public : IsNull(row : Int) ~ Bool {
			if(row < 0 | row >= @size | @nulls = Nil) {
				return row < 0 | row >= @size;
			};

			return (@nulls[row >> 6] and (1 << (row and 63))) <> 0;
		}

		#~
		Gets a cell as an object: IntRef, FloatRef, String, Date, BoolRef or the stored object
		@param row row number
		@return value, Nil if empty
		~#
		method : public : Get(row : Int) ~ Compare {
			if(IsNull(row)) {
				return Nil;
			};

			select(@type) {
				label ColumnType->INT: {
					return IntRef->New(@ints[row]);
				}

				label ColumnType->FLOAT: {
					return FloatRef->New(@floats[row]);
				}

				label ColumnType->STRING: {
					return GetString(row);
				}

				label ColumnType->DATE: {
					return DateCodec->ToDate(@ints[row], GmtBit(row));
				}

				label ColumnType->BOOL: {
					return BoolRef->New(@ints[row] <> 0);
				}

				label ColumnType->OBJECT: {
					return @objects[row];
				}
			};

			return Nil;
		}

		#~
		Gets a cell of an INT, BOOL (0 or 1) or DATE (epoch milliseconds) column
		@param row row number
		@return value, 0 if empty
		~#
		method : public : GetInt(row : Int) ~ Int {
			if(@ints = Nil | IsNull(row)) {
				return 0;
			};

			return @ints[row];
		}

		#~
		Gets a numeric or date cell as a Float
		@param row row number
		@return value, 0.0 if empty or not numeric
		~#
		method : public : GetFloat(row : Int) ~ Float {
			if(IsNull(row)) {
				return 0.0;
			};

			if(@type = ColumnType->FLOAT) {
				return @floats[row];
			}
			else if(@type = ColumnType->INT | @type = ColumnType->DATE | @type = ColumnType->BOOL) {
				return @ints[row]->As(Float);
			}
			else if(@type = ColumnType->OBJECT) {
				return Cell->IsNumeric(@objects[row]) ? Cell->ToNumber(@objects[row]) : 0.0;
			};

			return 0.0;
		}

		#~
		Gets a cell of a STRING column
		@param row row number
		@return value, Nil if empty or not a text column
		~#
		method : public : GetString(row : Int) ~ String {
			if(@type <> ColumnType->STRING | IsNull(row)) {
				return Nil;
			};

			if(@encoded) {
				return @dict[@ints[row]];
			};

			return @strings[row];
		}

		#~
		Gets the dictionary code of a cell in an encoded text column
		@param row row number
		@return code, -1 if empty or not encoded
		~#
		method : public : GetCode(row : Int) ~ Int {
			if(<>IsEncoded() | IsNull(row)) {
				return -1;
			};

			return @ints[row];
		}

		#~
		Whether a cell holds a number an aggregate can use: an Int or a Float
		@param row row number
		@return true if numeric
		~#
		method : public : IsNumeric(row : Int) ~ Bool {
			if(IsNull(row)) {
				return false;
			};

			if(@type = ColumnType->INT | @type = ColumnType->FLOAT) {
				return true;
			};

			if(@type = ColumnType->OBJECT) {
				return Cell->IsNumeric(@objects[row]);
			};

			return false;
		}

		#~
		Stores a value. Nil empties the cell.
		@param row row number
		@param value value
		@return true if stored, false if out of range or refused by a declared type (see GetError)
		~#
		method : public : Set(row : Int, value : Compare) ~ Bool {
			if(row < 0 | row >= @size) {
				@error := "row {$row} is out of range";
				return false;
			};

			if(value = Nil) {
				if(<>IsNull(row)) {
					SetNullBit(row, true);
					MarkStale(row);
					IndexChanged(row);
				};
				return true;
			};

			kind := KindOf(value);
			if(@type = ColumnType->NONE) {
				Become(kind);
			}
			else if(kind <> @type) {
				if(@type = ColumnType->FLOAT & kind = ColumnType->INT) {
					# an Int widens into a Float column
				}
				else if(@type = ColumnType->OBJECT) {
					# an object column keeps anything
				}
				else if(@declared) {
					@error := "column '{$@name}' holds {$(TypeName(@type))}, not {$(TypeName(kind))}";
					return false;
				}
				else if(@type = ColumnType->INT & kind = ColumnType->FLOAT) {
					Promote(ColumnType->FLOAT);
				}
				else {
					Promote(ColumnType->OBJECT);
				};
			};

			was_null := IsNull(row);
			select(@type) {
				label ColumnType->INT: {
					@ints[row] := value->As(IntRef)->Get();
					NoteValue(row, @ints[row]->As(Float), was_null);
				}

				label ColumnType->FLOAT: {
					if(value->TypeOf(IntRef)) {
						@floats[row] := value->As(IntRef)->Get()->As(Float);
					}
					else {
						@floats[row] := value->As(FloatRef)->Get();
					};
					NoteValue(row, @floats[row], was_null);
				}

				label ColumnType->STRING: {
					StoreString(row, value->As(String));
				}

				label ColumnType->DATE: {
					date := value->As(Date);
					@ints[row] := DateCodec->ToMillis(date);
					SetGmtBit(row, date->IsGmt());
					NoteValue(row, @ints[row]->As(Float), was_null);
				}

				label ColumnType->BOOL: {
					@ints[row] := value->As(BoolRef)->Get() ? 1 : 0;
				}

				label ColumnType->OBJECT: {
					@objects[row] := value;
				}
			};

			if(was_null) {
				SetNullBit(row, false);
			};
			IndexChanged(row);

			return true;
		}

		#~
		Copies a cell from another column, converting through Set when the types differ
		@param src column to copy from
		@param src_row row in that column
		@param row row in this column
		@return true if stored
		~#
		method : public : CopyFrom(src : Column, src_row : Int, row : Int) ~ Bool {
			if(src->IsNull(src_row)) {
				return Set(row, Nil);
			};

			if(src->GetType() = @type & @type = ColumnType->FLOAT) {
				was_null := IsNull(row);
				@floats[row] := src->GetFloat(src_row);
				NoteValue(row, @floats[row], was_null);
				if(was_null) {
					SetNullBit(row, false);
				};
				IndexChanged(row);
				return true;
			}
			else if(src->GetType() = @type & @type = ColumnType->INT) {
				was_null := IsNull(row);
				@ints[row] := src->GetInt(src_row);
				NoteValue(row, @ints[row]->As(Float), was_null);
				if(was_null) {
					SetNullBit(row, false);
				};
				IndexChanged(row);
				return true;
			};

			return Set(row, src->Get(src_row));
		}

		#~
		Keeps only the given rows, in order, and trims the arrays to fit. Used by Table->Compact.
		@param keep rows to keep, ascending
		~#
		method : public : Compact(keep : Int[]) ~ Nil {
			size := keep->Size();
			type := @type;
			old_ints := @ints;
			old_floats := @floats;
			old_strings := @strings;
			old_objects := @objects;
			old_nulls := @nulls;
			old_gmt := @gmt;

			@ints := Nil;
			@floats := Nil;
			@strings := Nil;
			@objects := Nil;
			@nulls := Nil;
			@gmt := Nil;
			@null_count := 0;
			@capacity := 0;
			@size := 0;
			@type := ColumnType->NONE;
			Ensure(size > 16 ? size : 16);
			if(type <> ColumnType->NONE) {
				# the dictionary is left in place, so the copied codes stay valid
				Become(type);
			};

			@size := size;
			each(i : size) {
				src := keep[i];
				is_null := old_nulls <> Nil & (old_nulls[src >> 6] and (1 << (src and 63))) <> 0;
				if(is_null) {
					SetNullBit(i, true);
				}
				else {
					if(old_ints <> Nil & @ints <> Nil) {
						@ints[i] := old_ints[src];
					};
					if(old_floats <> Nil & @floats <> Nil) {
						@floats[i] := old_floats[src];
					};
					if(old_strings <> Nil & @strings <> Nil) {
						@strings[i] := old_strings[src];
					};
					if(old_objects <> Nil & @objects <> Nil) {
						@objects[i] := old_objects[src];
					};
					if(old_gmt <> Nil & (old_gmt[src >> 6] and (1 << (src and 63))) <> 0) {
						SetGmtBit(i, true);
					};
				};
			};

			RecomputeAllZones();
			IndexStale();
		}

		#~
		Gets the array of 64-row words marking empty cells, for code that scans the column
		directly. Valid until the column next grows or changes type.
		@return null bitmap
		~#
		method : public : GetNullBits() ~ Int[] {
			return @nulls;
		}

		#~
		Gets the values of an INT, DATE or BOOL column, or the codes of an encoded STRING
		column, for code that scans the column directly
		@return values, Nil for other types
		~#
		method : public : GetIntArray() ~ Int[] {
			return @ints;
		}

		#~
		Gets the values of a FLOAT column, for code that scans the column directly
		@return values, Nil for other types
		~#
		method : public : GetFloatArray() ~ Float[] {
			return @floats;
		}

		#~
		Gets the values of a plain (not encoded) STRING column
		@return values, Nil for other columns
		~#
		method : public : GetStringArray() ~ String[] {
			return @strings;
		}

		#~
		Gets the values of an OBJECT column
		@return values, Nil for other types
		~#
		method : public : GetObjectArray() ~ Compare[] {
			return @objects;
		}

		#~
		Gets the strings of an encoded STRING column, indexed by code
		@return dictionary, Nil if not encoded
		~#
		method : public : GetDictionary() ~ String[] {
			if(IsEncoded()) {
				return @dict;
			};

			return Nil;
		}

		#~
		Gets the code of a string in an encoded column
		@param value string
		@return code, -1 if the column does not hold it or is not encoded
		~#
		method : public : FindCode(value : String) ~ Int {
			if(<>IsEncoded() | value = Nil) {
				return -1;
			};

			found := @dict_index->Find(value);
			if(found = Nil) {
				return -1;
			};

			return found->Get();
		}

		#~
		Gets each dictionary code's position in sorted order, so encoded text sorts by number
		@return rank per code, Nil if not encoded
		~#
		method : public : GetDictionaryRanks() ~ Int[] {
			if(<>IsEncoded()) {
				return Nil;
			};

			size := @dict_size;
			src := Int->New[size];
			each(i : size) {
				src[i] := i;
			};

			# a merge sort of the codes by their strings
			dest := Int->New[size];
			width := 1;
			while(width < size) {
				start := 0;
				while(start < size) {
					middle := start + width;
					if(middle > size) {
						middle := size;
					};
					finish := start + width * 2;
					if(finish > size) {
						finish := size;
					};
					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						take_left := l < middle;
						if(take_left & r < finish) {
							take_left := @dict[src[l]]->Compare(@dict[src[r]]) <= 0;
						};
						if(take_left) {
							dest[k] := src[l];
							l += 1;
						}
						else {
							dest[k] := src[r];
							r += 1;
						};
						k += 1;
					};
					start := finish;
				};
				swap := src;
				src := dest;
				dest := swap;
				width *= 2;
			};

			ranks := Int->New[size];
			each(i : size) {
				ranks[src[i]] := i;
			};

			return ranks;
		}

		#~
		Fills an empty column with copies of another column's cells, in the given order. The
		column takes the other's type. Used to copy query results.
		@param src column to copy from
		@param rows its row slots to copy; -1 gives an empty cell
		~#
		method : public : Gather(src : Column, rows : Int[]) ~ Nil {
			count := rows->Size();
			@size := 0;
			@capacity := 0;
			@ints := Nil;
			@floats := Nil;
			@strings := Nil;
			@objects := Nil;
			@nulls := Nil;
			@gmt := Nil;
			@dict := Nil;
			@dict_index := Nil;
			@dict_size := 0;
			@null_count := 0;
			@zone_min := Nil;
			@type := ColumnType->NONE;
			@encoded := src->IsEncoded() | src->GetType() <> ColumnType->STRING;
			Ensure(count > 16 ? count : 16);
			src_type := src->GetType();
			if(src_type <> ColumnType->NONE) {
				if(src->IsEncoded()) {
					# a private copy of the dictionary, so this column can grow its own
					dict := src->GetDictionary();
					dict_size := src->GetDictionarySize();
					@dict := String->New[dict_size > 16 ? dict_size : 16];
					@dict_index := Hash->New()<String, IntRef>;
					each(i : dict_size) {
						@dict[i] := dict[i];
						@dict_index->Insert(dict[i], IntRef->New(i));
					};
					@dict_size := dict_size;
				};
				Become(src_type);
			};

			@size := count;
			src_nulls := src->GetNullBits();
			src_ints := src->GetIntArray();
			src_floats := src->GetFloatArray();
			src_strings := src->GetStringArray();
			src_objects := src->GetObjectArray();
			type := @type;
			plain := type = ColumnType->STRING & <>@encoded;
			each(i : count) {
				row := rows[i];
				if(row < 0 | (src_nulls[row >> 6] and (1 << (row and 63))) <> 0) {
					@nulls[i >> 6] := @nulls[i >> 6] or (1 << (i and 63));
					@null_count += 1;
				}
				else if(type = ColumnType->FLOAT) {
					@floats[i] := src_floats[row];
				}
				else if(type = ColumnType->OBJECT) {
					@objects[i] := src_objects[row];
				}
				else if(plain) {
					@strings[i] := src_strings[row];
				}
				else if(type <> ColumnType->NONE) {
					@ints[i] := src_ints[row];
					if(type = ColumnType->DATE) {
						if(src->GmtAt(row)) {
							SetGmtBit(i, true);
						};
					};
				};
			};

			RecomputeAllZones();
			IndexStale();
		}

		#~
		Fills an empty INT column with values, none empty. Used by Table->Gather.
		@param values values
		~#
		method : public : FillInts(values : Int[]) ~ Nil {
			count := values->Size();
			Ensure(count > 16 ? count : 16);
			if(@type = ColumnType->NONE) {
				Become(ColumnType->INT);
			};
			each(i : count) {
				@ints[i] := values[i];
			};
			@size := count;
			RecomputeAllZones();
			IndexStale();
		}

		#~
		Fills an empty column with n empty cells. Used by Table->Gather.
		@param n number of rows
		~#
		method : public : FillNulls(n : Int) ~ Nil {
			Ensure(n > 16 ? n : 16);
			each(i : n) {
				@nulls[i >> 6] := @nulls[i >> 6] or (1 << (i and 63));
			};
			@size := n;
			@null_count := n;
			IndexStale();
		}

		#~
		Refills a column with numbers. Used for query aggregates.
		@param type INT or FLOAT
		@param ints values for an INT column
		@param floats values for a FLOAT column
		@param present false where a cell is empty
		~#
		method : public : FillNumbers(type : ColumnType, ints : Int[], floats : Float[], present : Bool[]) ~ Nil {
			count := present->Size();
			@size := 0;
			@capacity := 0;
			@ints := Nil;
			@floats := Nil;
			@strings := Nil;
			@objects := Nil;
			@nulls := Nil;
			@gmt := Nil;
			@dict := Nil;
			@dict_index := Nil;
			@dict_size := 0;
			@null_count := 0;
			@zone_min := Nil;
			@type := ColumnType->NONE;
			Ensure(count > 16 ? count : 16);
			Become(type);
			@size := count;
			each(i : count) {
				if(present[i]) {
					if(type = ColumnType->INT) {
						@ints[i] := ints[i];
					}
					else {
						@floats[i] := floats[i];
					};
				}
				else {
					@nulls[i >> 6] := @nulls[i >> 6] or (1 << (i and 63));
					@null_count += 1;
				};
			};

			RecomputeAllZones();
			IndexStale();
		}

		#~
		Gets the array of 64-row words marking DATE cells stored as GMT dates
		@return GMT bitmap
		~#
		method : public : GetGmtBits() ~ Int[] {
			return @gmt;
		}

		#~
		Refills a column with stored arrays, as an .otab file holds them. Used by OtabFile.
		@param type column type
		@param declared true to refuse values of another type afterwards
		@param n rows
		@param ints INT, BOOL and DATE values, or dictionary codes of an encoded STRING column
		@param floats FLOAT values
		@param strings plain STRING values
		@param objects OBJECT values
		@param nulls null bitmap
		@param null_count empty cells
		@param gmt DATE GMT bitmap
		@param encoded true if a STRING column is dictionary encoded
		@param dict dictionary of an encoded STRING column
		~#
		method : public : Restore(type : ColumnType, declared : Bool, n : Int, ints : Int[], floats : Float[], strings : String[],
				objects : Compare[], nulls : Int[], null_count : Int, gmt : Int[], encoded : Bool, dict : String[]) ~ Nil {
			@size := 0;
			@capacity := 0;
			@ints := Nil;
			@floats := Nil;
			@strings := Nil;
			@objects := Nil;
			@nulls := Nil;
			@gmt := Nil;
			@dict := Nil;
			@dict_index := Nil;
			@dict_size := 0;
			@null_count := 0;
			@zone_min := Nil;
			@type := ColumnType->NONE;
			@declared := declared & type <> ColumnType->NONE;
			@encoded := type <> ColumnType->STRING | encoded;
			Ensure(n > 16 ? n : 16);

			if(type = ColumnType->STRING & encoded & dict <> Nil) {
				size := dict->Size();
				@dict := String->New[size > 16 ? size : 16];
				@dict_index := Hash->New()<String, IntRef>;
				each(i : size) {
					@dict[i] := dict[i];
					@dict_index->Insert(dict[i], IntRef->New(i));
				};
				@dict_size := size;
			};

			if(type <> ColumnType->NONE) {
				Become(type);
			};

			if(ints <> Nil & @ints <> Nil) {
				Int->Copy(@ints, 0, ints, 0, n);
			};
			if(floats <> Nil & @floats <> Nil) {
				Float->Copy(@floats, 0, floats, 0, n);
			};
			if(strings <> Nil) {
				each(i : n) {
					@strings[i] := strings[i];
				};
			};
			if(objects <> Nil) {
				each(i : n) {
					@objects[i] := objects[i];
				};
			};

			words := (n + 63) / 64;
			if(nulls <> Nil) {
				Int->Copy(@nulls, 0, nulls, 0, words);
			};
			if(gmt <> Nil & type = ColumnType->DATE) {
				Int->Copy(@gmt, 0, gmt, 0, words);
			};

			@size := n;
			@null_count := null_count;
			RecomputeAllZones();
			IndexStale();
		}

		#~
		Whether a DATE cell was stored as a GMT date
		@param row row number
		@return true if GMT
		~#
		method : public : GmtAt(row : Int) ~ Bool {
			return GmtBit(row);
		}

		#~
		Gets the number of zone-map groups
		@return number of groups
		~#
		method : public : GetGroupCount() ~ Int {
			return (@size + GroupRows() - 1) / GroupRows();
		}

		#~
		Whether the column keeps zone maps: INT, FLOAT and DATE columns do
		@return true if zone maps are kept
		~#
		method : public : HasZones() ~ Bool {
			return @type = ColumnType->INT | @type = ColumnType->FLOAT | @type = ColumnType->DATE;
		}

		#~
		Gets the smallest value in a group, ignoring empty cells
		@param group group number
		@return minimum; for a group with no values the minimum is above the maximum (see GroupHasValues)
		~#
		method : public : GetGroupMin(group : Int) ~ Float {
			FreshenZone(group);
			return @zone_min[group];
		}

		#~
		Gets the largest value in a group, ignoring empty cells
		@param group group number
		@return maximum (see GetGroupMin)
		~#
		method : public : GetGroupMax(group : Int) ~ Float {
			FreshenZone(group);
			return @zone_max[group];
		}

		#~
		Whether a group holds any non-empty value
		@param group group number
		@return true if the group has values
		~#
		method : public : GroupHasValues(group : Int) ~ Bool {
			FreshenZone(group);
			return @zone_min[group] <= @zone_max[group];
		}

		#~
		Gets the name of a type
		@param type storage type
		@return lowercase type name
		~#
		function : TypeName(type : ColumnType) ~ String {
			select(type) {
				label ColumnType->INT: { return "int"; }
				label ColumnType->FLOAT: { return "float"; }
				label ColumnType->STRING: { return "string"; }
				label ColumnType->DATE: { return "date"; }
				label ColumnType->BOOL: { return "bool"; }
				label ColumnType->OBJECT: { return "object"; }
			};

			return "none";
		}

		#~
		Gets the storage type a value calls for
		@param value value
		@return storage type
		~#
		function : KindOf(value : Compare) ~ ColumnType {
			if(value->TypeOf(IntRef)) {
				return ColumnType->INT;
			}
			else if(value->TypeOf(FloatRef)) {
				return ColumnType->FLOAT;
			}
			else if(value->TypeOf(String)) {
				return ColumnType->STRING;
			}
			else if(value->TypeOf(Date)) {
				return ColumnType->DATE;
			}
			else if(value->TypeOf(BoolRef)) {
				return ColumnType->BOOL;
			};

			return ColumnType->OBJECT;
		}

		# grows the arrays the column's type uses to hold at least 'needed' rows
		method : Ensure(needed : Int) ~ Nil {
			if(needed <= @capacity) {
				return;
			};

			capacity := @capacity < 16 ? 16 : @capacity;
			while(capacity < needed) {
				capacity *= 2;
			};

			@ints := GrowInts(@ints, capacity);
			@floats := GrowFloats(@floats, capacity);
			@strings := GrowStrings(@strings, capacity);
			@objects := GrowObjects(@objects, capacity);
			# the null bitmap exists for every column, typed or not
			words := (capacity + 63) / 64;
			@nulls := @nulls = Nil ? Int->New[words] : GrowInts(@nulls, words);
			@gmt := GrowInts(@gmt, words);

			groups := (capacity + GroupRows() - 1) / GroupRows();
			if(@zone_min = Nil | @zone_min->Size() < groups) {
				mins := Float->New[groups];
				maxs := Float->New[groups];
				stale := Bool->New[groups];
				start := 0;
				if(@zone_min <> Nil) {
					each(i : @zone_min) {
						mins[i] := @zone_min[i];
						maxs[i] := @zone_max[i];
						stale[i] := @zone_stale[i];
					};
					start := @zone_min->Size();
				};
				for(i := start; i < groups; i += 1;) {
					mins[i] := 1.0;
					maxs[i] := 0.0;
				};
				@zone_min := mins;
				@zone_max := maxs;
				@zone_stale := stale;
			};

			@capacity := capacity;
		}

		function : GrowInts(old : Int[], size : Int) ~ Int[] {
			if(old = Nil) {
				return Nil;
			};

			grown := Int->New[size];
			each(i : old) {
				grown[i] := old[i];
			};

			return grown;
		}

		function : GrowFloats(old : Float[], size : Int) ~ Float[] {
			if(old = Nil) {
				return Nil;
			};

			grown := Float->New[size];
			each(i : old) {
				grown[i] := old[i];
			};

			return grown;
		}

		function : GrowStrings(old : String[], size : Int) ~ String[] {
			if(old = Nil) {
				return Nil;
			};

			grown := String->New[size];
			each(i : old) {
				grown[i] := old[i];
			};

			return grown;
		}

		function : GrowObjects(old : Compare[], size : Int) ~ Compare[] {
			if(old = Nil) {
				return Nil;
			};

			grown := Compare->New[size];
			each(i : old) {
				grown[i] := old[i];
			};

			return grown;
		}

		# gives a column of no type the arrays for one
		method : Become(type : ColumnType) ~ Nil {
			@type := type;
			if(@nulls = Nil) {
				@nulls := Int->New[(@capacity + 63) / 64];
			};

			select(type) {
				label ColumnType->INT: {
					@ints := Int->New[@capacity];
				}

				label ColumnType->FLOAT: {
					@floats := Float->New[@capacity];
				}

				label ColumnType->STRING: {
					if(@encoded) {
						@ints := Int->New[@capacity];
						if(@dict = Nil) {
							@dict := String->New[16];
							@dict_size := 0;
							@dict_index := Hash->New()<String, IntRef>;
						};
					}
					else {
						@strings := String->New[@capacity];
					};
				}

				label ColumnType->DATE: {
					@ints := Int->New[@capacity];
					@gmt := Int->New[(@capacity + 63) / 64];
				}

				label ColumnType->BOOL: {
					@ints := Int->New[@capacity];
				}

				label ColumnType->OBJECT: {
					@objects := Compare->New[@capacity];
				}
			};
		}

		# converts the stored values to another type, keeping each one
		method : Promote(type : ColumnType) ~ Nil {
			if(type = ColumnType->FLOAT & @type = ColumnType->INT) {
				floats := Float->New[@capacity];
				each(i : @size) {
					if(<>IsNull(i)) {
						floats[i] := @ints[i]->As(Float);
					};
				};
				@floats := floats;
				@ints := Nil;
				@type := ColumnType->FLOAT;
			}
			else {
				objects := Compare->New[@capacity];
				each(i : @size) {
					objects[i] := Get(i);
				};
				@objects := objects;
				@ints := Nil;
				@floats := Nil;
				@strings := Nil;
				@dict := Nil;
				@dict_index := Nil;
				@dict_size := 0;
				@gmt := Nil;
				@type := ColumnType->OBJECT;
			};

			@promotions += 1;
			IndexStale();
		}

		# stores a string as a dictionary code, or plainly once the dictionary is too big
		method : StoreString(row : Int, value : String) ~ Nil {
			if(@encoded) {
				found := @dict_index->Find(value);
				if(found <> Nil) {
					@ints[row] := found->Get();
					return;
				};

				if(@dict_size >= DictionaryLimit() & @dict_size * 2 > @size - @null_count) {
					Decode();
					@strings[row] := value;
					return;
				};

				if(@dict_size = @dict->Size()) {
					grown := String->New[@dict_size * 2];
					each(i : @dict_size) {
						grown[i] := @dict[i];
					};
					@dict := grown;
				};

				@dict[@dict_size] := value;
				@dict_index->Insert(value, IntRef->New(@dict_size));
				@ints[row] := @dict_size;
				@dict_size += 1;
				return;
			};

			@strings[row] := value;
		}

		# turns dictionary codes into plain strings, for a column with too many distinct values
		method : Decode() ~ Nil {
			strings := String->New[@capacity];
			each(i : @size) {
				if(<>IsNull(i)) {
					strings[i] := @dict[@ints[i]];
				};
			};
			@strings := strings;
			@ints := Nil;
			@dict := Nil;
			@dict_index := Nil;
			@dict_size := 0;
			@encoded := false;
			IndexStale();
		}

		method : SetNullBit(row : Int, on : Bool) ~ Nil {
			word := row >> 6;
			bit := 1 << (row and 63);
			is_on := (@nulls[word] and bit) <> 0;
			if(on & <>is_on) {
				@nulls[word] := @nulls[word] or bit;
				@null_count += 1;
			}
			else if(<>on & is_on) {
				@nulls[word] := @nulls[word] xor bit;
				@null_count -= 1;
			};
		}

		method : GmtBit(row : Int) ~ Bool {
			if(@gmt = Nil) {
				return false;
			};

			return (@gmt[row >> 6] and (1 << (row and 63))) <> 0;
		}

		method : SetGmtBit(row : Int, on : Bool) ~ Nil {
			if(@gmt = Nil) {
				return;
			};

			word := row >> 6;
			bit := 1 << (row and 63);
			if(on) {
				@gmt[word] := @gmt[word] or bit;
			}
			else if((@gmt[word] and bit) <> 0) {
				@gmt[word] := @gmt[word] xor bit;
			};
		}

		# widens a group's range for a new value; a replaced value may have been the
		# group's minimum or maximum, so that group is marked to be recomputed
		method : NoteValue(row : Int, value : Float, was_null : Bool) ~ Nil {
			group := row / GroupRows();
			if(<>was_null) {
				@zone_stale[group] := true;
				return;
			};

			# NaN matches no comparison a zone map rules on, and has no place between bounds
			if(value <> value) {
				return;
			};

			if(@zone_stale[group]) {
				return;
			};

			if(@zone_min[group] > @zone_max[group]) {
				@zone_min[group] := value;
				@zone_max[group] := value;
			}
			else {
				if(value < @zone_min[group]) {
					@zone_min[group] := value;
				};
				if(value > @zone_max[group]) {
					@zone_max[group] := value;
				};
			};
		}

		method : MarkStale(row : Int) ~ Nil {
			@zone_stale[row / GroupRows()] := true;
		}

		# A query recomputes a stale group's bounds, and several threads may query at once (see
		# ColumnIndex->Freshen): one recomputes under the rebuild lock, and the bounds are
		# written before the group is marked fresh, so a reader never sees half of them.
		method : FreshenZone(group : Int) ~ Nil {
			if(@zone_stale[group]) {
				lock := RebuildLock->Get();
				critical(lock) {
					if(@zone_stale[group]) {
						RecomputeZone(group);
					};
				};
			};
		}

		method : RecomputeZone(group : Int) ~ Nil {
			# no values: the minimum above the maximum
			low := 1.0;
			high := 0.0;
			if(HasZones()) {
				start := group * GroupRows();
				finish := start + GroupRows();
				if(finish > @size) {
					finish := @size;
				};

				found := false;
				for(row := start; row < finish; row += 1;) {
					value := GetFloat(row);
					if(<>IsNull(row) & value = value) {
						if(<>found) {
							low := value;
							high := value;
							found := true;
						}
						else if(value < low) {
							low := value;
						}
						else if(value > high) {
							high := value;
						};
					};
				};
			};

			@zone_min[group] := low;
			@zone_max[group] := high;
			@zone_stale[group] := false;
		}

		method : RecomputeAllZones() ~ Nil {
			each(i : @zone_min) {
				RecomputeZone(i);
			};
		}
	}

	#~
	The kind of index a column has (see Table->CreateIndex). A HASH index serves '=' and IN. A
	SORTED index serves '<', '<=', '>', '>=', BETWEEN, '=' and IN, and gives ORDER BY, GROUP BY,
	Min and Max their order without sorting.
	~#
	enum IndexKind {
		NONE,
		HASH,
		SORTED
	}

	# The lock that state rebuilt by a query is rebuilt under: a stale index, a stale zone map,
	# and a table's plan cache (docs/QUERY_DESIGN.md, "Concurrent readers"). One per process,
	# held in a class variable, because a table must not hold one: the generic Serializer would
	# copy its native handle. It is made when the first table is, before there is a table to
	# share between threads. Only the slow paths take it: a fresh index or zone map is read
	# without it.
	class : private : RebuildLock {
		@lock : static : System.Concurrency.ThreadMutex;

		function : Get() ~ System.Concurrency.ThreadMutex {
			if(@lock = Nil) {
				@lock := System.Concurrency.ThreadMutex->New("query_rebuild");
			};

			return @lock;
		}
	}

	# The last error of each thread's call on an object several threads may use at once, a
	# Table or a Catalog, so that GetError answers the calling thread's own (docs/
	# QUERY_DESIGN.md, "Errors per thread"). Errors are kept by Thread->GetCurrentId: a
	# thread's is set when its call fails and removed when its next call succeeds, and those of
	# threads that have ended are dropped whenever the map is changed. With no errors the map is
	# Nil, so a call that succeeds, the common case, reads one field and takes no lock: only a
	# thread adds its own entry, and the map goes back to Nil only when it is empty, so a thread
	# that sees Nil has no entry. The lock is one per process, in a class variable, for the
	# reason RebuildLock gives; it is held only while the map is read or changed.
	class : private : ThreadErrors {
		@lock : static : System.Concurrency.ThreadMutex;
		@messages : Map<IntRef, String>;

		New() {
			Lock();
		}

		function : Lock() ~ System.Concurrency.ThreadMutex {
			if(@lock = Nil) {
				@lock := System.Concurrency.ThreadMutex->New("query_errors");
			};

			return @lock;
		}

		# the calling thread's last error, Nil if its last call succeeded
		method : public : Get() ~ String {
			if(@messages = Nil) {
				return Nil;
			};

			id := System.Concurrency.Thread->GetCurrentId();
			message : String := Nil;
			lock := Lock();
			critical(lock) {
				if(@messages <> Nil) {
					message := @messages->Find(id);
				};
			};

			return message;
		}

		# sets the calling thread's error; Nil clears it
		method : public : Set(message : String) ~ Nil {
			if(message = Nil & @messages = Nil) {
				return;
			};

			id := System.Concurrency.Thread->GetCurrentId();
			lock := Lock();
			critical(lock) {
				if(message <> Nil) {
					if(@messages = Nil) {
						@messages := Map->New()<IntRef, String>;
					};
					@messages->Insert(id, message);
				}
				else if(@messages <> Nil) {
					@messages->Remove(id);
				};
				Sweep();
			};
		}

		# drops the errors of threads that have ended; the caller holds the lock
		method : Sweep() ~ Nil {
			if(@messages <> Nil) {
				ids := @messages->GetKeys()<IntRef>;
				each(i : ids) {
					id := ids->Get(i)->Get();
					if(<>System.Concurrency.Thread->IsAlive(id)) {
						@messages->Remove(id);
					};
				};

				if(@messages->Size() = 0) {
					@messages := Nil;
				};
			};
		}
	}

	# The locks that let several threads share a Catalog (docs/QUERY_DESIGN.md, "One catalog,
	# many threads"). One guards every catalog's maps (its tables, plan cache and file cache)
	# and is held only while a map is read or changed. Sixteen more guard reading files: a
	# thread holds one while it reads a file into a catalog's cache, or writes a URL's local
	# copy, chosen by the file, so threads that miss the cache for one file at once read it
	# once (the others wait, then find it cached), and threads reading other files rarely wait
	# for each other. Class variables, one set per process, for the reason RebuildLock gives;
	# made by the first table or catalog, before there is one to share.
	class : private : CatalogLocks {
		@maps : static : System.Concurrency.ThreadMutex;
		@files : static : System.Concurrency.ThreadMutex[];

		function : Prepare() ~ Nil {
			if(@maps = Nil) {
				@maps := System.Concurrency.ThreadMutex->New("query_catalog");
			};

			if(@files = Nil) {
				files := System.Concurrency.ThreadMutex->New[16];
				each(i : files) {
					files[i] := System.Concurrency.ThreadMutex->New("query_file");
				};
				@files := files;
			};
		}

		function : Maps() ~ System.Concurrency.ThreadMutex {
			Prepare();
			return @maps;
		}

		# the lock for reading a file, by its cache key or a URL
		function : ForFile(key : String) ~ System.Concurrency.ThreadMutex {
			Prepare();
			hash := 0;
			each(i : key) {
				hash := (hash * 31 + key->Get(i)->As(Int)) and 0xFFFFFF;
			};

			return @files[hash % @files->Size()];
		}
	}

	# An index on one column (docs/QUERY_DESIGN.md, section 5). The column holds it, so every
	# path that writes a cell reaches it. A hash index is updated in place by each cell write and
	# each delete; a sorted index is marked stale by a write and rebuilt by the next query that
	# uses it. Writes that replace a column's arrays as a whole (Compact, Gather, Restore, a type
	# promotion, a dictionary turning into plain text) mark either kind stale. A lookup gives
	# candidate slots: every live slot whose cell can match, and perhaps some that cannot (two
	# values sharing a hash key, NaN cells), which the caller tests again. An index can make a
	# query faster but cannot change its answer.
	class : private : ColumnIndex {
		@kind : IndexKind;
		@name : String;
		@stale : Bool;
		@type : ColumnType;
		@encoded : Bool;
		@hash : HashState;
		@sorted : SortedState;

		New(kind : IndexKind, name : String) {
			@kind := kind;
			@name := name;
			@stale := true;
			@type := ColumnType->NONE;
		}

		method : public : GetKind() ~ IndexKind {
			return @kind;
		}

		method : public : GetName() ~ String {
			return @name;
		}

		method : public : SetStale() ~ Nil {
			@stale := true;
		}

		method : public : GetHash() ~ HashState {
			return @hash;
		}

		method : public : GetSorted() ~ SortedState {
			return @sorted;
		}

		# the column types an index serves; an OBJECT column's cells have no one order or key
		function : CanServe(type : ColumnType) ~ Bool {
			return type = ColumnType->INT | type = ColumnType->FLOAT | type = ColumnType->STRING |
				type = ColumnType->DATE | type = ColumnType->BOOL;
		}

		# one cell was written
		method : public : Changed(column : Column, row : Int) ~ Nil {
			if(@stale) {
				return;
			};

			if(@kind = IndexKind->SORTED | @type <> column->GetType() | @encoded <> column->IsEncoded()) {
				@stale := true;
				return;
			};

			@hash->Remove(row);
			if(<>column->IsNull(row)) {
				AddRow(@hash, column, row);
			};
		}

		# a row was deleted; a sorted index keeps the slot, and lookups skip it
		method : public : Deleted(row : Int) ~ Nil {
			if(<>@stale & @kind = IndexKind->HASH) {
				@hash->Remove(row);
			};
		}

		# brings the index up to date with its column; false if the column's type cannot be
		# indexed (OBJECT, or no type yet), so the caller scans
		method : public : Freshen(column : Column, deleted : Int[]) ~ Bool {
			type := column->GetType();
			if(<>CanServe(type)) {
				return false;
			};

			encoded := column->IsEncoded();
			if(<>@stale & @type = type & @encoded = encoded) {
				return true;
			};

			# Several threads may query a shared table right after a write, and each finds the
			# index stale. One rebuilds it, under the library's rebuild lock; the others wait
			# there and then find it fresh. The new state is built aside and put in place
			# before '@stale' is cleared, so a thread that checks without the lock sees either
			# a stale index (and waits) or a whole one.
			lock := RebuildLock->Get();
			critical(lock) {
				if(@stale | @type <> type | @encoded <> encoded) {
					if(@kind = IndexKind->HASH) {
						hash := BuildHash(column, deleted);
						@hash := hash;
						@sorted := Nil;
					}
					else {
						sorted := BuildSorted(column, deleted);
						@sorted := sorted;
						@hash := Nil;
					};
					@type := type;
					@encoded := encoded;
					@stale := false;
				};
			};

			return true;
		}

		function : Live(deleted : Int[], row : Int) ~ Bool {
			if(deleted = Nil) {
				return true;
			};

			word := row >> 6;
			if(word >= deleted->Size()) {
				return true;
			};

			return (deleted[word] and (1 << (row and 63))) = 0;
		}

		# A hash key for a Float: equal numbers get equal keys (0.0 and -0.0 both 0), and
		# different numbers usually get different ones. Two that share a key are told apart when
		# the candidates are tested again. NaN has no key; it is kept apart.
		function : FloatKey(value : Float) ~ Int {
			if(value = 0.0) {
				return 0;
			};

			magnitude := value < 0.0 ? 0.0 - value : value;
			if(magnitude < 1.0) {
				return (value * 1.0e18)->As(Int);
			}
			else if(magnitude < 9.0e9) {
				return (value * 1.0e9)->As(Int);
			}
			else if(magnitude < 9.0e18) {
				return value->As(Int);
			};

			return value > 0.0 ? 1 : -1;
		}

		function : AddRow(state : HashState, column : Column, row : Int) ~ Nil {
			type := column->GetType();
			if(type = ColumnType->FLOAT) {
				floats := column->GetFloatArray();
				value := floats[row];
				if(value <> value) {
					state->AddNan(row);
				}
				else {
					state->Add(row, FloatKey(value));
				};
			}
			else if(type = ColumnType->STRING & <>column->IsEncoded()) {
				strings := column->GetStringArray();
				state->Add(row, strings[row]->HashID());
			}
			else {
				ints := column->GetIntArray();
				state->Add(row, ints[row]);
			};
		}

		function : BuildHash(column : Column, deleted : Int[]) ~ HashState {
			size := column->Size();
			state := HashState->New(size);
			nulls := column->GetNullBits();
			type := column->GetType();
			ints := column->GetIntArray();
			floats := column->GetFloatArray();
			strings := column->GetStringArray();
			plain := type = ColumnType->STRING & <>column->IsEncoded();
			for(row := 0; row < size; row += 1;) {
				if((nulls[row >> 6] and (1 << (row and 63))) = 0 & Live(deleted, row)) {
					if(type = ColumnType->FLOAT) {
						value := floats[row];
						if(value <> value) {
							state->AddNan(row);
						}
						else {
							state->Add(row, FloatKey(value));
						};
					}
					else if(plain) {
						state->Add(row, strings[row]->HashID());
					}
					else {
						state->Add(row, ints[row]);
					};
				};
			};

			return state;
		}

		# the live, non-empty slots in the order Sorter gives them: by value, and by slot
		# among equal values; NaN cells are kept apart, since they have no place in the order
		function : BuildSorted(column : Column, deleted : Int[]) ~ SortedState {
			size := column->Size();
			nulls := column->GetNullBits();
			type := column->GetType();
			ints := column->GetIntArray();
			floats := column->GetFloatArray();
			strings := column->GetStringArray();
			plain := type = ColumnType->STRING & <>column->IsEncoded();

			slots := Int->New[size];
			n := 0;
			nans := IntVector->New();
			for(row := 0; row < size; row += 1;) {
				if((nulls[row >> 6] and (1 << (row and 63))) = 0 & Live(deleted, row)) {
					if(type = ColumnType->FLOAT) {
						value := floats[row];
						if(value <> value) {
							nans->AddBack(row);
						}
						else {
							slots[n] := row;
							n += 1;
						};
					}
					else {
						slots[n] := row;
						n += 1;
					};
				};
			};

			state := SortedState->New(n, nans->ToArray());
			if(type = ColumnType->FLOAT) {
				keys := Float->New[n];
				each(i : n) {
					keys[i] := floats[slots[i]];
				};
				state->SetFloats(SortByFloats(slots, keys, n), keys);
			}
			else if(plain) {
				keys := String->New[n];
				each(i : n) {
					keys[i] := strings[slots[i]];
				};
				state->SetStrings(SortByStrings(slots, keys, n), keys);
			}
			else {
				keys := Int->New[n];
				if(type = ColumnType->STRING) {
					# encoded text sorts by each code's place in the sorted dictionary
					ranks := column->GetDictionaryRanks();
					each(i : n) {
						keys[i] := ranks[ints[slots[i]]];
					};
				}
				else {
					each(i : n) {
						keys[i] := ints[slots[i]];
					};
				};
				state->SetInts(SortByInts(slots, keys, n), keys);
			};

			return state;
		}

		# Stable merge sorts of slots by keys, both arrays reordered together: the slots come in
		# ascending, so equal keys keep slot order. Each starts by checking for keys already in
		# order, which data loaded in time or id order often is.
		function : SortByInts(slots : Int[], keys : Int[], n : Int) ~ Int[] {
			sorted := true;
			for(i := 1; i < n & sorted; i += 1;) {
				if(keys[i - 1] > keys[i]) {
					sorted := false;
				};
			};
			if(sorted) {
				return slots;
			};

			src_slots := slots;
			src_keys := keys;
			dest_slots := Int->New[n];
			dest_keys := Int->New[n];
			width := 1;
			while(width < n) {
				start := 0;
				while(start < n) {
					middle := start + width;
					if(middle > n) {
						middle := n;
					};
					finish := middle + width;
					if(finish > n) {
						finish := n;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						if(l < middle & (r >= finish | src_keys[l] <= src_keys[r])) {
							dest_keys[k] := src_keys[l];
							dest_slots[k] := src_slots[l];
							l += 1;
						}
						else {
							dest_keys[k] := src_keys[r];
							dest_slots[k] := src_slots[r];
							r += 1;
						};
						k += 1;
					};
					start := finish;
				};

				swap_slots := src_slots;
				src_slots := dest_slots;
				dest_slots := swap_slots;
				swap_keys := src_keys;
				src_keys := dest_keys;
				dest_keys := swap_keys;
				width *= 2;
			};

			# the keys go back in the caller's array, in sorted order
			if(src_keys <> keys) {
				Int->Copy(keys, 0, src_keys, 0, n);
			};
			return src_slots;
		}

		function : SortByFloats(slots : Int[], keys : Float[], n : Int) ~ Int[] {
			sorted := true;
			for(i := 1; i < n & sorted; i += 1;) {
				if(keys[i - 1] > keys[i]) {
					sorted := false;
				};
			};
			if(sorted) {
				return slots;
			};

			src_slots := slots;
			src_keys := keys;
			dest_slots := Int->New[n];
			dest_keys := Float->New[n];
			width := 1;
			while(width < n) {
				start := 0;
				while(start < n) {
					middle := start + width;
					if(middle > n) {
						middle := n;
					};
					finish := middle + width;
					if(finish > n) {
						finish := n;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						if(l < middle & (r >= finish | src_keys[l] <= src_keys[r])) {
							dest_keys[k] := src_keys[l];
							dest_slots[k] := src_slots[l];
							l += 1;
						}
						else {
							dest_keys[k] := src_keys[r];
							dest_slots[k] := src_slots[r];
							r += 1;
						};
						k += 1;
					};
					start := finish;
				};

				swap_slots := src_slots;
				src_slots := dest_slots;
				dest_slots := swap_slots;
				swap_keys := src_keys;
				src_keys := dest_keys;
				dest_keys := swap_keys;
				width *= 2;
			};

			if(src_keys <> keys) {
				Float->Copy(keys, 0, src_keys, 0, n);
			};
			return src_slots;
		}

		function : SortByStrings(slots : Int[], keys : String[], n : Int) ~ Int[] {
			sorted := true;
			for(i := 1; i < n & sorted; i += 1;) {
				if(keys[i - 1]->Compare(keys[i]) > 0) {
					sorted := false;
				};
			};
			if(sorted) {
				return slots;
			};

			src_slots := slots;
			src_keys := keys;
			dest_slots := Int->New[n];
			dest_keys := String->New[n];
			width := 1;
			while(width < n) {
				start := 0;
				while(start < n) {
					middle := start + width;
					if(middle > n) {
						middle := n;
					};
					finish := middle + width;
					if(finish > n) {
						finish := n;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						if(l < middle & (r >= finish | src_keys[l]->Compare(src_keys[r]) <= 0)) {
							dest_keys[k] := src_keys[l];
							dest_slots[k] := src_slots[l];
							l += 1;
						}
						else {
							dest_keys[k] := src_keys[r];
							dest_slots[k] := src_slots[r];
							r += 1;
						};
						k += 1;
					};
					start := finish;
				};

				swap_slots := src_slots;
				src_slots := dest_slots;
				dest_slots := swap_slots;
				swap_keys := src_keys;
				src_keys := dest_keys;
				dest_keys := swap_keys;
				width *= 2;
			};

			if(src_keys <> keys) {
				each(i : n) {
					keys[i] := src_keys[i];
				};
			};
			return src_slots;
		}

		# Live rows, ascending, put in the order Sorter gives them: by value, NaN after every
		# number, equal values in row order, empty cells last. Nil when the rows are not
		# ascending.
		method : public : Order(rows : Int[], capacity : Int, descending : Bool, nulls : Int[]) ~ Int[] {
			sorted := @sorted;
			if(sorted = Nil) {
				return Nil;
			};

			size := rows->Size();
			words := Int->New[(capacity + 63) / 64 + 1];
			last := -1;
			each(i : size) {
				row := rows[i];
				if(row <= last | row >= capacity) {
					return Nil;
				};
				words[row >> 6] := words[row >> 6] or (1 << (row and 63));
				last := row;
			};

			out := Int->New[size];
			n := 0;
			order := sorted->GetOrder();
			count := sorted->GetSize();
			nans := sorted->GetNans();
			if(<>descending) {
				each(p : count) {
					slot := order[p];
					if((words[slot >> 6] and (1 << (slot and 63))) <> 0) {
						out[n] := slot;
						n += 1;
					};
				};
				n := Marked(nans, words, out, n);
			}
			else {
				n := Marked(nans, words, out, n);
				# runs of equal values from the largest down, each run in slot order
				finish := count;
				while(finish > 0) {
					start := finish - 1;
					while(start > 0 & sorted->SameKey(start - 1, start)) {
						start -= 1;
					};
					for(p := start; p < finish; p += 1;) {
						slot := order[p];
						if((words[slot >> 6] and (1 << (slot and 63))) <> 0) {
							out[n] := slot;
							n += 1;
						};
					};
					finish := start;
				};
			};

			# empty cells last, in the order they came
			each(i : size) {
				row := rows[i];
				if((nulls[row >> 6] and (1 << (row and 63))) <> 0) {
					out[n] := row;
					n += 1;
				};
			};

			# every row must be placed exactly once; anything else falls back to a sort
			if(n <> size) {
				return Nil;
			};

			return out;
		}

		# appends the marked slots of a list, in its order
		function : Marked(slots : Int[], words : Int[], out : Int[], n : Int) ~ Int {
			each(i : slots) {
				slot := slots[i];
				if((words[slot >> 6] and (1 << (slot and 63))) <> 0) {
					out[n] := slot;
					n += 1;
				};
			};
			return n;
		}
	}

	# A hash index's entries: an IntMap from a key to its chain's first slot, and the chains
	# linked through per-slot arrays, so adding or removing a slot touches only its neighbours.
	# Links hold slot + 1, with 0 for none. NaN cells have their own chain.
	class : private : HashState {
		@heads : IntMap;
		@next : Int[];
		@prev : Int[];
		@keys : Int[];
		@state : Int[];
		@nan_head : Int;
		@nan_count : Int;

		New(capacity : Int) {
			@heads := IntMap->New();
			size := capacity < 16 ? 16 : capacity;
			@next := Int->New[size];
			@prev := Int->New[size];
			@keys := Int->New[size];
			@state := Int->New[size];
		}

		method : Ensure(slot : Int) ~ Nil {
			if(slot < @state->Size()) {
				return;
			};

			size := @state->Size();
			while(size <= slot) {
				size *= 2;
			};
			@next := Column->GrowInts(@next, size);
			@prev := Column->GrowInts(@prev, size);
			@keys := Column->GrowInts(@keys, size);
			@state := Column->GrowInts(@state, size);
		}

		method : public : Add(slot : Int, key : Int) ~ Nil {
			Ensure(slot);
			head := @heads->Find(key, 0);
			@next[slot] := head;
			@prev[slot] := 0;
			if(head > 0) {
				@prev[head - 1] := slot + 1;
			};
			@heads->Insert(key, slot + 1);
			@keys[slot] := key;
			@state[slot] := 1;
		}

		method : public : AddNan(slot : Int) ~ Nil {
			Ensure(slot);
			@next[slot] := @nan_head;
			@prev[slot] := 0;
			if(@nan_head > 0) {
				@prev[@nan_head - 1] := slot + 1;
			};
			@nan_head := slot + 1;
			@nan_count += 1;
			@state[slot] := 2;
		}

		method : public : Remove(slot : Int) ~ Nil {
			if(slot >= @state->Size()) {
				return;
			};

			state := @state[slot];
			if(state = 0) {
				return;
			};

			before := @prev[slot];
			after := @next[slot];
			if(state = 2) {
				if(before = 0) {
					@nan_head := after;
				}
				else {
					@next[before - 1] := after;
				};
				@nan_count -= 1;
			}
			else {
				key := @keys[slot];
				if(before = 0) {
					if(after = 0) {
						@heads->Remove(key);
					}
					else {
						@heads->Insert(key, after);
					};
				}
				else {
					@next[before - 1] := after;
				};
			};

			if(after > 0) {
				@prev[after - 1] := before;
			};
			@state[slot] := 0;
		}

		# entries under a key, NaN cells not included: a walk of its chain, which costs what
		# reading them would
		method : public : Count(key : Int) ~ Int {
			count := 0;
			link := @heads->Find(key, 0);
			while(link > 0) {
				count += 1;
				link := @next[link - 1];
			};
			return count;
		}

		method : public : GetNanCount() ~ Int {
			return @nan_count;
		}

		# adds the slots under a key
		method : public : Collect(key : Int, out : IntVector) ~ Nil {
			link := @heads->Find(key, 0);
			while(link > 0) {
				out->AddBack(link - 1);
				link := @next[link - 1];
			};
		}

		# adds the NaN slots
		method : public : CollectNans(out : IntVector) ~ Nil {
			link := @nan_head;
			while(link > 0) {
				out->AddBack(link - 1);
				link := @next[link - 1];
			};
		}
	}

	# A sorted index's entries: the slots in value order, with their keys (numbers, dictionary
	# ranks or text) beside them, and the NaN slots apart
	class : private : SortedState {
		@order : Int[];
		@size : Int;
		@nans : Int[];
		@int_keys : Int[];
		@float_keys : Float[];
		@text_keys : String[];

		New(size : Int, nans : Int[]) {
			@size := size;
			@nans := nans;
		}

		method : public : SetInts(order : Int[], keys : Int[]) ~ Nil {
			@order := order;
			@int_keys := keys;
		}

		method : public : SetFloats(order : Int[], keys : Float[]) ~ Nil {
			@order := order;
			@float_keys := keys;
		}

		method : public : SetStrings(order : Int[], keys : String[]) ~ Nil {
			@order := order;
			@text_keys := keys;
		}

		method : public : GetOrder() ~ Int[] {
			return @order;
		}

		method : public : GetSize() ~ Int {
			return @size;
		}

		method : public : GetNans() ~ Int[] {
			return @nans;
		}

		method : public : GetNanCount() ~ Int {
			return @nans->Size();
		}

		# whether two positions hold equal values, as Sorter compares them
		method : public : SameKey(a : Int, b : Int) ~ Bool {
			if(@float_keys <> Nil) {
				return Filter->Order3F(@float_keys[a], @float_keys[b]) = 0;
			}
			else if(@text_keys <> Nil) {
				return @text_keys[a]->Compare(@text_keys[b]) = 0;
			};

			return @int_keys[a] = @int_keys[b];
		}
	}

	# How the planner reads candidate slots: through one index (a list of hash keys, or a range
	# of a sorted index's positions), or as the union of several, for OR and IN
	class : private : IndexProbe {
		@index : ColumnIndex;
		@column : String;
		@ops : String;
		@keys : IntVector;
		@low : Int;
		@high : Int;
		@empty : Bool;
		@parts : Vector<IndexProbe>;

		New(index : ColumnIndex, column : String, ops : String) {
			@index := index;
			@column := column;
			@ops := ops;
		}

		New(parts : Vector<IndexProbe>) {
			@parts := parts;
		}

		function : Hash(index : ColumnIndex, column : String, op : String, key : Int) ~ IndexProbe {
			probe := IndexProbe->New(index, column, op);
			probe->SetKey(key);
			return probe;
		}

		function : Range(index : ColumnIndex, column : String, op : String, low : Int, high : Int) ~ IndexProbe {
			probe := IndexProbe->New(index, column, op);
			probe->SetRange(low, high);
			return probe;
		}

		function : Empty(index : ColumnIndex, column : String, op : String) ~ IndexProbe {
			probe := IndexProbe->New(index, column, op);
			probe->SetEmpty();
			return probe;
		}

		method : public : SetKey(key : Int) ~ Nil {
			@keys := IntVector->New();
			@keys->AddBack(key);
		}

		method : public : SetRange(low : Int, high : Int) ~ Nil {
			@low := low;
			@high := high;
			if(@high < @low) {
				@high := @low;
			};
		}

		method : public : SetEmpty() ~ Nil {
			@empty := true;
		}

		method : public : GetIndex() ~ ColumnIndex {
			return @index;
		}

		method : public : IsEmpty() ~ Bool {
			if(@parts <> Nil) {
				each(i : @parts) {
					if(<>@parts->Get(i)->IsEmpty()) {
						return false;
					};
				};
				return true;
			};

			return @empty;
		}

		# whether every index read is a hash index's
		method : public : IsHash() ~ Bool {
			if(@parts <> Nil) {
				each(i : @parts) {
					if(<>@parts->Get(i)->IsHash()) {
						return false;
					};
				};
				return true;
			};

			return @index->GetKind() = IndexKind->HASH;
		}

		# a range of a sorted index
		method : public : IsRange() ~ Bool {
			return @parts = Nil & <>@empty & @keys = Nil;
		}

		# narrows a range by another range of the same sorted index: both conditions hold
		method : public : Intersect(narrower : IndexProbe) ~ Nil {
			if(narrower->GetLow() > @low) {
				@low := narrower->GetLow();
			};
			if(narrower->GetHigh() < @high) {
				@high := narrower->GetHigh();
			};
			if(@high < @low) {
				@high := @low;
			};
			@ops := "{$@ops} {$(narrower->GetOps())}";
		}

		method : public : GetLow() ~ Int {
			return @low;
		}

		method : public : GetHigh() ~ Int {
			return @high;
		}

		method : public : GetOps() ~ String {
			return @ops;
		}

		# the number of slots the probe reads, an estimate of its cost
		method : public : Count() ~ Int {
			if(@parts <> Nil) {
				total := 0;
				each(i : @parts) {
					total += @parts->Get(i)->Count();
				};
				return total;
			};

			if(@empty) {
				return 0;
			};

			if(@keys <> Nil) {
				hash := @index->GetHash();
				total := hash->GetNanCount();
				each(i : @keys) {
					total += hash->Count(@keys->Get(i));
				};
				return total;
			};

			return @high - @low + @index->GetSorted()->GetNanCount();
		}

		method : public : Describe() ~ String {
			if(@parts <> Nil) {
				text := "union(";
				each(i : @parts) {
					if(i > 0) {
						text += " | ";
					};
					text += @parts->Get(i)->Describe();
				};
				text += ")";
				return text;
			};

			kind := @index->GetKind() = IndexKind->HASH ? "HASH" : "SORTED";
			text := "{$kind} index {$(@index->GetName())} on {$@column} ({$@ops})";
			if(@empty) {
				text += " matches nothing";
			};
			return text;
		}

		# adds the slots read, in no particular order
		method : public : Collect(out : IntVector) ~ Nil {
			if(@parts <> Nil) {
				each(i : @parts) {
					@parts->Get(i)->Collect(out);
				};
				return;
			};

			if(@empty) {
				return;
			};

			if(@keys <> Nil) {
				hash := @index->GetHash();
				each(i : @keys) {
					hash->Collect(@keys->Get(i), out);
				};
				hash->CollectNans(out);
				return;
			};

			sorted := @index->GetSorted();
			order := sorted->GetOrder();
			for(p := @low; p < @high; p += 1;) {
				out->AddBack(order[p]);
			};
			nans := sorted->GetNans();
			each(i : nans) {
				out->AddBack(nans[i]);
			};
		}

		# the live slots read, ascending and each once: the order a scan visits them in
		method : public : Slots(table : Table) ~ Int[] {
			found := IntVector->New();
			Collect(found);

			capacity := table->GetRowCapacity();
			deleted := table->GetDeletedBits();
			count := found->Size();
			if(count * 64 >= capacity) {
				# many slots: mark them, then read the marks in order
				words := Int->New[(capacity + 63) / 64 + 1];
				each(i : count) {
					slot := found->Get(i);
					if(slot < capacity & ColumnIndex->Live(deleted, slot)) {
						words[slot >> 6] := words[slot >> 6] or (1 << (slot and 63));
					};
				};

				out := Int->New[count];
				n := 0;
				each(w : words) {
					word := words[w];
					if(word <> 0) {
						base := w << 6;
						each(b : 64) {
							if((word and (1 << b)) <> 0) {
								out[n] := base + b;
								n += 1;
							};
						};
					};
				};
				return Filter->Trim(out, n);
			};

			# few slots: sort them
			values := found->ToArray();
			ArraySort->Sort(values);
			out := Int->New[count];
			n := 0;
			each(i : count) {
				slot := values[i];
				if((n = 0 | out[n - 1] <> slot) & slot < capacity & ColumnIndex->Live(deleted, slot)) {
					out[n] := slot;
					n += 1;
				};
			};
			return Filter->Trim(out, n);
		}
	}

	# Dates as epoch milliseconds of their calendar fields, read as UTC. No time-zone
	# conversion is applied, so a date reads back with exactly the fields it was stored with,
	# and ordering the numbers orders the dates. Days from the civil calendar follow Howard
	# Hinnant's algorithm.
	class : private : DateCodec {
		function : ToMillis(date : Date) ~ Int {
			days := DaysFromCivil(date->GetYear(), date->GetMonth(), date->GetDay());
			secs := ((days * 24 + date->GetHours()) * 60 + date->GetMinutes()) * 60 + date->GetSeconds();
			return secs * 1000;
		}

		function : ToDate(millis : Int, gmt : Bool) ~ Date {
			secs := FloorDiv(millis, 1000);
			days := FloorDiv(secs, 86400);
			rest := secs - days * 86400;
			fields := CivilFromDays(days);
			hours := rest / 3600;
			mins := (rest - hours * 3600) / 60;
			s := rest - hours * 3600 - mins * 60;
			return Date->New(fields[2], fields[1], fields[0], hours, mins, s, gmt);
		}

		function : FloorDiv(a : Int, b : Int) ~ Int {
			q := a / b;
			if((a - q * b) <> 0 & (a < 0) <> (b < 0)) {
				q -= 1;
			};
			return q;
		}

		function : DaysFromCivil(year : Int, month : Int, day : Int) ~ Int {
			y := month <= 2 ? year - 1 : year;
			era := FloorDiv(y, 400);
			yoe := y - era * 400;
			mp := month > 2 ? month - 3 : month + 9;
			doy := (153 * mp + 2) / 5 + day - 1;
			doe := yoe * 365 + yoe / 4 - yoe / 100 + doy;
			return era * 146097 + doe - 719468;
		}

		# [year, month, day]
		function : CivilFromDays(days : Int) ~ Int[] {
			z := days + 719468;
			era := FloorDiv(z, 146097);
			doe := z - era * 146097;
			yoe := (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365;
			doy := doe - (365 * yoe + yoe / 4 - yoe / 100);
			mp := (5 * doy + 2) / 153;
			day := doy - (153 * mp + 2) / 5 + 1;
			month := mp < 10 ? mp + 3 : mp - 9;
			year := yoe + era * 400;
			if(month <= 2) {
				year += 1;
			};

			fields := Int->New[3];
			fields[0] := year;
			fields[1] := month;
			fields[2] := day;
			return fields;
		}
	}

	#~
	A table of typed columns. Each row has a primary key in the hidden 'pk' column, assigned in
	insertion order and never reused. Rows are read and written through Row cursors, and queried
	with SQL-like statements.

	Threads: any number of threads may query one table at once, and GetError gives each thread
	its own last error. Writes are not locked: while one thread writes a table, no other may
	use it, so a program that mixes writes and queries orders them itself.

```
table := Table->New("users", ["name", "age"]);
row := table->Insert();
row->Set("name", "Alice");
row->Set("age", IntRef->New(30));

results := table->Query("select * from users where age > 25");
results->ToString()->PrintLine();
```
	~#
	class Table {
		@name : String;
		@columns : Column[];
		@column_names : String[];
		@column_map : Map<String, IntRef>;
		@size : Int;
		@count : Int;
		@deleted : Int[];
		@next_pk : Int;
		@compacted : Bool;
		@version : Int;
		@layout : Int;
		@plans : Map<String, Plan>;
		@errors : ThreadErrors;
		@store : TableStore;

		#~
		Constructor. Column types are taken from the first value stored in each.
		@param name table name
		@param column_names column names
		~#
		New(name : String, column_names : String[]) {
			Init(name, column_names, ColumnType->New[0], false);
		}

		#~
		Constructor. Column types are taken from the first value stored in each.
		@param name table name
		@param column_names column names
		~#
		New(name : String, column_names : Vector<String>) {
			names := String->New[column_names->Size()];
			each(i : names) {
				names[i] := column_names->Get(i);
			};
			Init(name, names, ColumnType->New[0], false);
		}

		#~
		Constructor with declared column types; storing a value of another type is refused
		@param name table name
		@param column_names column names
		@param types one type per column; NONE leaves that column inferred
		~#
		New(name : String, column_names : String[], types : ColumnType[]) {
			Init(name, column_names, types, true);
		}

		#~
		Constructor with starting column types
		@param name table name
		@param column_names column names
		@param types one type per column; NONE leaves that column inferred
		@param declared true to refuse values of another type, false to let the columns widen or promote as inferred ones do
		~#
		New(name : String, column_names : String[], types : ColumnType[], declared : Bool) {
			Init(name, column_names, types, declared);
		}

		method : Init(name : String, column_names : String[], types : ColumnType[], declared : Bool) ~ Nil {
			# made before any table exists to share, so threads never race to make them
			RebuildLock->Get();
			CatalogLocks->Prepare();
			@errors := ThreadErrors->New();
			@name := name;
			@column_map := Map->New()<String, IntRef>;
			@column_names := String->New[column_names->Size() + 1];
			@columns := Column->New[column_names->Size() + 1];

			@column_names[0] := "pk";
			@columns[0] := Column->New("pk", ColumnType->INT, true);
			@column_map->Insert("pk", 0);

			each(i : column_names) {
				type := ColumnType->NONE;
				if(types <> Nil & i < types->Size()) {
					type := types[i];
				};
				# a copy of the caller's name: Strings change in place with '+=', and the
				# map below is keyed by this one
				name := String->New(column_names[i]);
				@column_names[i + 1] := name;
				@columns[i + 1] := Column->New(name, type, declared & type <> ColumnType->NONE);
				@column_map->Insert(name, i + 1);
			};
		}

		#~
		Adds a column; existing rows hold an empty cell in it
		@param name column name
		@param type storage type; NONE takes the type of the first value stored
		@return true if added, false if a column has that name
		~#
		method : public : AddColumn(name : String, type : ColumnType) ~ Bool {
			if(name = Nil | @column_map->Has(name)) {
				return false;
			};

			name := String->New(name);
			column := Column->New(name, type, type <> ColumnType->NONE);
			each(i : @size) {
				column->Append();
			};

			columns := Column->New[@columns->Size() + 1];
			names := String->New[@columns->Size() + 1];
			each(i : @columns) {
				columns[i] := @columns[i];
				names[i] := @column_names[i];
			};
			columns[@columns->Size()] := column;
			names[@columns->Size()] := name;
			@column_map->Insert(name, @columns->Size());
			@columns := columns;
			@column_names := names;
			@version += 1;

			if(@store <> Nil & <>@store->LogAddColumn(name, type)) {
				SetError(@store->GetError());
			};

			return true;
		}

		#~
		Gets the table name
		@return table name
		```
		table := Query.Structured.Table->New("products", ["sku", "price"]);
		table->GetName()->PrintLine(); # prints "products"
		```
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Get column index by name
		@param name column name
		@return column index, -1 if there is no such column
		```
		table := Query.Structured.Table->New("items", ["name", "qty"]);
		idx := table->GetIndex("qty"); # returns 2 (pk=0, name=1, qty=2)
		"qty column index={$idx}"->PrintLine();
		```
		~#
		method : public : GetIndex(name : String) ~ Int {
			if(name = Nil) {
				return -1;
			};

			found := @column_map->Find(name);
			if(found <> Nil) {
				return found->As(IntRef)->Get();
			};

			return -1;
		}

		#~
		Gets the array of 64-row words marking deleted rows, for code that scans the table
		directly
		@return deleted-row bitmap, Nil if no row has been deleted since the last Compact
		~#
		method : public : GetDeletedBits() ~ Int[] {
			return @deleted;
		}

		#~
		Gets every live row as a view, without copying
		@return view
		~#
		method : public : AsView() ~ View {
			return View->New(@self, DataColumns(), LiveRows());
		}

		# the indexes of every column but 'pk'
		method : DataColumns() ~ Int[] {
			columns := Int->New[@columns->Size() - 1];
			each(i : columns) {
				columns[i] := i + 1;
			};

			return columns;
		}

		#~
		The rows that meet a condition, as a view. Whole row groups the zone maps rule out are
		skipped.
		@param condition condition
		@return view, Nil if the condition names an unknown column (see GetError)
		```
		rs := table->Where(Col->Of("score")->Gt(0.5)->AndAlso(Col->Of("label")->Eq("cat")));
		```
		~#
		method : public : Where(condition : Predicate) ~ View {
			SetError(Nil);
			holder := StringHolder->New();
			filter := Filter->Bind(condition, @self, Nil, holder);
			if(filter = Nil) {
				SetError(holder->Get());
				return Nil;
			};

			view := View->New(@self, DataColumns(), filter->Apply(@self, Nil));
			view->SetPlan(filter->GetPlan());
			return view;
		}

		#~
		Indexes a column, so that conditions on it read only the rows that can match instead of
		scanning the table. A HASH index serves '=' and IN; a SORTED index serves '<', '<=', '>',
		'>=', BETWEEN, '=' and IN, and gives ORDER BY, GROUP BY, Min and Max their order without
		sorting. A column has at most one index; creating another replaces it. An index never
		changes a query's answer or its row order, only how fast it comes: every insert, update,
		delete and Compact keeps it correct (a sorted index is rebuilt by the first query after a
		change). Save and ToBytes keep the index definitions, and Load, FromBytes and Open
		restore them (built by the first query that uses each); on a durable table (Open) the
		change is saved at once, by a checkpoint.
		Columns holding objects (OBJECT) cannot be indexed, and neither can 'pk', which Get finds
		directly. SQL's CREATE INDEX does the same.
		@param column column name
		@param kind HASH or SORTED
		@return true if created, false if the column is unknown or cannot be indexed (see GetError)
		```
		table->CreateIndex("label", IndexKind->HASH);
		table->CreateIndex("score", IndexKind->SORTED);
		rs := table->Where(Col->Of("label")->Eq("cat")->AndAlso(Col->Of("score")->Gt(0.9)));
		rs->GetPlan()->PrintLine(); # where runs: HASH index runs_label on label (=)
		```
		~#
		method : public : CreateIndex(column : String, kind : IndexKind) ~ Bool {
			return CreateIndex(Nil, column, kind);
		}

		#~
		Indexes a column under a name (see CreateIndex(column, kind)); DROP INDEX finds it by
		that name
		@param name index name, unique among this table's indexes; Nil names it table_column
		@param column column name
		@param kind HASH or SORTED
		@return true if created, false on error (see GetError)
		```
		table->CreateIndex("by_score", "score", IndexKind->SORTED);
		table->Execute("drop index by_score");
		```
		~#
		method : public : CreateIndex(name : String, column : String, kind : IndexKind) ~ Bool {
			SetError(Nil);
			index := GetIndex(column);
			if(index < 0) {
				SetError("unknown column '{$column}'");
				return false;
			};

			if(index = 0) {
				SetError("the key column 'pk' needs no index: Get finds a key directly");
				return false;
			};

			if(kind <> IndexKind->HASH & kind <> IndexKind->SORTED) {
				SetError("an index is HASH or SORTED");
				return false;
			};

			target := @columns[index];
			if(target->GetType() = ColumnType->OBJECT) {
				SetError("column '{$column}' holds objects, which have no one order or key to index");
				return false;
			};

			if(name = Nil) {
				name := "{$@name}_{$column}";
			};

			for(i := 1; i < @columns->Size(); i += 1;) {
				other_name := @columns[i]->GetIndexName();
				if(i <> index & other_name <> Nil) {
					if(other_name->Equals(name)) {
						SetError("an index named '{$name}' is on column '{$(@columns[i]->GetName())}'");
						return false;
					};
				};
			};

			created := ColumnIndex->New(kind, String->New(name));
			target->SetColumnIndex(created);
			# built now, so the first query pays nothing for it
			created->Freshen(target, @deleted);
			return IndexesChanged();
		}

		# An index definition read from an .otab file, put on a column without building it: the
		# first query that uses it builds it, so loading stays a copy of arrays. The file's
		# footer was checked: the column exists, holds no other index, and the name is unique.
		method : public : AttachIndex(column : Int, name : String, kind : IndexKind) ~ Nil {
			target := GetColumn(column);
			if(target <> Nil & column > 0) {
				target->SetColumnIndex(ColumnIndex->New(kind, String->New(name)));
			};
		}

		# A durable table's file keeps its index definitions, so creating or dropping one is
		# saved at once, by a checkpoint (a statement's at its end): the change log records
		# rows, not indexes, and an index made since the last save would otherwise be lost.
		method : IndexesChanged() ~ Bool {
			if(@store = Nil) {
				return true;
			};

			if(<>@store->IndexesChanged()) {
				SetError("the index changed, but '{$(@store->GetPath())}' could not be saved: {$(@store->GetError())}");
				return false;
			};
			return true;
		}

		#~
		Removes a column's index
		@param column column name
		@return true if removed, false if the column has no index
		~#
		method : public : DropIndex(column : String) ~ Bool {
			target := GetColumn(column);
			if(target = Nil | target->GetColumnIndex() = Nil) {
				SetError("column '{$column}' has no index");
				return false;
			};

			target->SetColumnIndex(Nil);
			return IndexesChanged();
		}

		#~
		Whether a column has an index
		@param column column name
		@return true if it has one
		~#
		method : public : HasIndex(column : String) ~ Bool {
			return GetIndexKind(column) <> IndexKind->NONE;
		}

		#~
		Gets the kind of a column's index
		@param column column name
		@return HASH, SORTED, or NONE if the column has no index or is unknown
		~#
		method : public : GetIndexKind(column : String) ~ IndexKind {
			target := GetColumn(column);
			if(target = Nil) {
				return IndexKind->NONE;
			};

			return target->GetIndexKind();
		}

		#~
		Gets the name of a column's index
		@param column column name
		@return index name, Nil if the column has no index
		~#
		method : public : GetIndexName(column : String) ~ String {
			target := GetColumn(column);
			if(target = Nil) {
				return Nil;
			};

			return target->GetIndexName();
		}

		#~
		Gets the column an index is on
		@param name index name
		@return column name, Nil if the table has no index of that name
		~#
		method : public : FindIndex(name : String) ~ String {
			if(name = Nil) {
				return Nil;
			};

			for(i := 1; i < @columns->Size(); i += 1;) {
				index_name := @columns[i]->GetIndexName();
				if(index_name <> Nil) {
					if(index_name->Equals(name)) {
						return @columns[i]->GetName();
					};
				};
			};

			return Nil;
		}

		#~
		Tells how a statement reads its rows: for each table, whether its WHERE clause scans or
		reads through an index (naming it), and whether ORDER BY or GROUP BY took its order from
		a sorted index. A SELECT is run to find out; an UPDATE or DELETE is not.
		@param statement SQL statement naming this table
		@return the plan, Nil on error (see GetError)
		```
		table->CreateIndex("grp", IndexKind->HASH);
		table->Explain("select * from runs where grp = 'g7'")->PrintLine();
		# where runs: HASH index runs_grp on grp (=)
		```
		~#
		method : public : Explain(statement : String) ~ String {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return Nil;
			};

			holder := StringHolder->New();
			text := plan->Explain(@self, Compare->New[0], holder);
			SetError(holder->Get());
			return text;
		}

		#~
		Orders live row slots, given in ascending order, the way Sorter orders them by a column,
		through the column's sorted index. Used by queries.
		@param index column index
		@param rows row slots, ascending
		@param descending true for descending order
		@return the slots in order, Nil if the column has no sorted index that can give it
		~#
		method : public : IndexOrder(index : Int, rows : Int[], descending : Bool) ~ Int[] {
			column := GetColumn(index);
			if(column = Nil | index = 0 | rows = Nil) {
				return Nil;
			};

			found := column->GetColumnIndex();
			if(found = Nil) {
				return Nil;
			};

			if(found->GetKind() <> IndexKind->SORTED | <>found->Freshen(column, @deleted)) {
				return Nil;
			};

			return found->Order(rows, @size, descending, column->GetNullBits());
		}

		#~
		Every live row showing only some columns, as a view
		@param names column names
		@return view, Nil if a name is unknown
		~#
		method : public : Select(names : String[]) ~ View {
			return AsView()->Select(names);
		}

		#~
		Every live row sorted by a column, as a view; empty cells last
		@param name column name
		@param order ASC or DESC
		@return view, Nil if the column is unknown
		~#
		method : public : OrderBy(name : String, order : Order) ~ View {
			return AsView()->OrderBy(name, order);
		}

		#~
		Every live row sorted by a column, ascending, as a view; empty cells last
		@param name column name
		@return view, Nil if the column is unknown
		~#
		method : public : OrderBy(name : String) ~ View {
			return AsView()->OrderBy(name, Order->ASC);
		}

		#~
		At most the first n live rows, as a view
		@param n row limit
		@return view
		~#
		method : public : Limit(n : Int) ~ View {
			return AsView()->Limit(n);
		}

		#~
		Parses a query once, to run many times with values bound to its '?' placeholders
		@param statement query statement
		@return prepared statement, Nil if it does not parse (see GetError)
		```
		s := table->Prepare("select id from runs where score > ?");
		s->Bind(1, 0.9);
		rs := s->Execute();
		```
		~#
		method : public : Prepare(statement : String) ~ Statement {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return Nil;
			};

			return Statement->New(@self, plan);
		}

		# a parsed plan for a statement, from a small cache of recent ones
		method : FindPlan(statement : String) ~ Plan {
			if(statement = Nil) {
				SetError("*** Parse error ***");
				return Nil;
			};

			# threads querying one table share its cache, a Map, which is read and written
			# under the rebuild lock; parsing, the slow part, is not
			lock := RebuildLock->Get();
			plan : Plan := Nil;
			critical(lock) {
				if(@plans <> Nil) {
					plan := @plans->Find(statement);
				};
			};

			if(plan = Nil) {
				holder := StringHolder->New();
				plan := Plan->Parse(statement, holder);
				if(plan = Nil) {
					SetError(holder->Get());
					return Nil;
				};

				critical(lock) {
					if(@plans = Nil | @plans->Size() >= 64) {
						@plans := Map->New()<String, Plan>;
					};
					@plans->Insert(statement, plan);
				};
			};

			return plan;
		}

		#~
		Copies chosen rows and columns of a table into a new table
		@param name new table's name
		@param source table to copy from
		@param columns its column indexes, -1 for a name it does not have (an empty column)
		@param names the new table's column names
		@param rows its row slots, in order
		@return new table
		~#
		function : Gather(name : String, source : Table, columns : Int[], names : String[], rows : Int[]) ~ Table {
			table := Table->New(name, names);
			table->Fill(rows->Size());
			each(i : columns) {
				if(columns[i] > -1) {
					table->GetColumn(i + 1)->Gather(source->GetColumn(columns[i]), rows);
				};
			};

			return table;
		}

		#~
		Gets the key the next inserted row will have
		@return next key
		~#
		method : public : GetNextKey() ~ Int {
			return @next_pk;
		}

		# after a Gather of 'rows' from 'source': the rows keep the keys they had there
		method : public : KeepKeys(source : Table, rows : Int[]) ~ Nil {
			keys := Int->New[rows->Size()];
			source_keys := source->GetColumn(0);
			each(i : keys) {
				keys[i] := source_keys->GetInt(rows[i]);
			};
			key_column := Column->New("pk", ColumnType->INT, true);
			key_column->FillInts(keys);
			@columns[0] := key_column;
			@next_pk := source->GetNextKey();
			@compacted := true;
			@layout += 1;
		}

		# the rows numbered again from 'first'
		method : public : RenumberKeys(first : Int) ~ Nil {
			keys := Int->New[@size];
			each(i : keys) {
				keys[i] := first + i;
			};
			key_column := Column->New("pk", ColumnType->INT, true);
			key_column->FillInts(keys);
			@columns[0] := key_column;
			@next_pk := first + @size;
			@compacted := first <> 0;
			@layout += 1;
		}

		#~
		Makes a table from columns read back from storage. Used by OtabFile.
		@param name table name
		@param column_names data column names
		@param columns the key column, then the data columns
		@param next_key key the next inserted row will have
		@return table
		~#
		function : Restore(name : String, column_names : String[], columns : Column[], next_key : Int) ~ Table {
			table := Table->New(name, column_names);
			table->Adopt(columns, next_key);
			return table;
		}

		method : public : Adopt(columns : Column[], next_key : Int) ~ Nil {
			each(i : columns) {
				@columns[i] := columns[i];
			};

			@size := columns[0]->Size();
			@count := @size;
			@deleted := Nil;
			@next_pk := next_key;

			# keys 0, 1, 2 ... map straight to slots; anything else is found by search
			keys := columns[0];
			@compacted := false;
			each(i : @size) {
				if(keys->GetInt(i) <> i) {
					@compacted := true;
				};
			};
			@version += 1;
			@layout += 1;
		}

		#~
		Saves the table's live rows, with their keys, as an .otab file, written to a temporary
		file and renamed over 'path', so a crash leaves the old file or the new one. The file
		keeps the table's index definitions, and Load and Open restore them; a table with
		indexes is saved in format 2, which libraries older than that refuse, and one without
		in format 1.
		@param path file
		@return true if saved, false on error (see GetError)
		```
		table->Save("runs.otab");
		runs := Table->Load("runs.otab");
		```
		~#
		method : public : Save(path : String) ~ Bool {
			return Save(path, Compression->NONE);
		}

		#~
		Saves the table's live rows as an .otab file, compressing its blocks
		@param path file
		@param compression NONE, FAST or SMALL
		@return true if saved, false on error (see GetError)
		~#
		method : public : Save(path : String, compression : Compression) ~ Bool {
			# a durable table's own file: saving it without emptying the log would leave the
			# log naming an older save, and the changes after this one would be skipped
			if(@store <> Nil & path <> Nil & path->Equals(@store->GetPath())) {
				if(<>@store->Checkpoint(compression)) {
					SetError(@store->GetError());
					return false;
				};
				return true;
			};

			return WriteFile(path, compression);
		}

		# the save itself, for Save and a store's Checkpoint
		method : public : WriteFile(path : String, compression : Compression) ~ Bool {
			SetError(Nil);
			holder := StringHolder->New();
			bytes := Otab->Write(@self, compression, true, holder);
			if(bytes = Nil | <>Otab->Commit(path, bytes, holder)) {
				SetError(holder->Get());
				return false;
			};

			return true;
		}

		#~
		Gets the table's live rows as an .otab image in memory
		@return image, Nil on error (see GetError)
		~#
		method : public : ToBytes() ~ Byte[] {
			return ToBytes(Compression->NONE);
		}

		#~
		Gets the table's live rows as an .otab image in memory, compressing its blocks
		@param compression NONE, FAST or SMALL
		@return image, Nil on error (see GetError)
		~#
		method : public : ToBytes(compression : Compression) ~ Byte[] {
			return ToBytes(compression, true);
		}

		#~
		Gets the table's live rows as an .otab image in memory, with or without its index
		definitions. Without them the image is format 1, which every library that reads .otab
		reads; TableServer sends tables this way.
		@param compression NONE, FAST or SMALL
		@param indexes true to keep the index definitions (format 2 when there are any)
		@return image, Nil on error (see GetError)
		~#
		method : public : ToBytes(compression : Compression, indexes : Bool) ~ Byte[] {
			SetError(Nil);
			holder := StringHolder->New();
			bytes := Otab->Write(@self, compression, indexes, holder);
			SetError(holder->Get());
			return bytes;
		}

		#~
		Reads a table from an .otab image in memory
		@param bytes image, as ToBytes makes it
		@return table, Nil if the image is damaged or not an .otab image (OtabFile says why)
		~#
		function : FromBytes(bytes : Byte[]) ~ Table {
			return OtabFile->New(bytes)->Read();
		}

		#~
		Reads a table from an .otab file
		@param path file
		@return table, Nil if the file is missing, damaged or not an .otab file (OtabFile says why)
		~#
		function : Load(path : String) ~ Table {
			return OtabFile->New(path)->Read();
		}

		#~
		Reads only some columns of an .otab file; the other columns' blocks are not read
		@param path file
		@param names column names
		@return table, Nil on error (OtabFile says why)
		~#
		function : Load(path : String, names : String[]) ~ Table {
			return OtabFile->New(path)->Read(names);
		}

		#~
		Adds the table's live rows to an .otab file as new row groups, without decoding or
		changing the groups already there, and saves it as Save does. The columns must match the
		file's, in name, order and type. The rows get keys after the file's last key. A file that
		does not exist yet is saved. The file keeps its format and its index definitions; this
		table's indexes are not added to it.
		@param path file
		@return true if added, false on error (see GetError)
		~#
		method : public : Append(path : String) ~ Bool {
			return Append(path, Compression->NONE);
		}

		#~
		Adds the table's live rows to an .otab file as new row groups, compressing them
		@param path file
		@param compression NONE, FAST or SMALL
		@return true if added, false on error (see GetError)
		~#
		method : public : Append(path : String, compression : Compression) ~ Bool {
			SetError(Nil);
			if(@store <> Nil & path <> Nil & path->Equals(@store->GetPath())) {
				SetError("'{$path}' is this table's own file; its changes are already recorded (use Checkpoint)");
				return false;
			};
			if(path = Nil | <>File->Exists(path)) {
				return Save(path, compression);
			};

			file := OtabFile->New(path);
			if(<>file->IsOpen()) {
				SetError("'{$path}': {$(file->GetError())}");
				return false;
			};

			names := file->GetAllNames();
			types := file->GetTypes();
			if(names->Size() <> @columns->Size()) {
				SetError("'{$path}' has {$(names->Size() - 1)} columns; this table has {$(@columns->Size() - 1)}");
				return false;
			};

			for(c := 1; c < names->Size(); c += 1;) {
				column := @columns[c];
				if(<>names[c]->Equals(column->GetName())) {
					SetError("column {$c} is '{$(names[c])}' in '{$path}' and '{$(column->GetName())}' here");
					return false;
				};

				if(types[c] <> column->GetType()) {
					file_type := Column->TypeName(types[c]);
					this_type := Column->TypeName(column->GetType());
					SetError("column '{$(names[c])}' is {$file_type} in '{$path}' and {$this_type} here");
					return false;
				};
			};

			# the rows to add, numbered after the file's last key
			rows := LiveRows();
			copy := Table->Gather(@name, @self, Otab->DataColumns(@self), Otab->DataNames(@self), rows);
			copy->RenumberKeys(file->GetNextKey());

			prefix := file->ReadPrefix();
			if(prefix = Nil) {
				SetError("'{$path}': {$(file->GetError())}");
				return false;
			};

			out := OtabWriter->New();
			out->PutBytes(prefix);
			counts := Vector->New()<IntRef>;
			file_counts := file->GetCounts();
			each(g : file_counts) {
				counts->AddBack(IntRef->New(file_counts[g]));
			};
			blocks := Vector->New()<OtabBlockInfo>;
			file_blocks := file->GetBlocks();
			each(b : file_blocks) {
				blocks->AddBack(file_blocks[b]);
			};

			holder := StringHolder->New();
			if(<>Otab->WriteGroups(out, copy, Otab->CodecOf(compression), counts, blocks, holder)) {
				SetError(holder->Get());
				return false;
			};

			# the file keeps its own format and index definitions: the copied prefix holds its
			# header, and this table's indexes are not the file's
			file_indexes := Vector->New()<OtabIndex>;
			found_indexes := file->GetIndexDefinitions();
			each(i : found_indexes) {
				file_indexes->AddBack(found_indexes[i]);
			};
			Otab->WriteFooter(out, file->GetName(), copy->GetNextKey(), names, types, file->GetDeclared(), counts, blocks,
				file->GetFormatVersion(), file_indexes);
			if(<>Otab->Commit(path, out->ToByteArray(), holder)) {
				SetError(holder->Get());
				return false;
			};

			return true;
		}

		#~
		Gives an empty table n rows with fresh keys and empty cells. Used by Gather.
		@param n number of rows
		~#
		method : public : Fill(n : Int) ~ Nil {
			keys := Int->New[n];
			each(i : n) {
				keys[i] := i;
			};

			key_column := Column->New("pk", ColumnType->INT, true);
			key_column->FillInts(keys);
			@columns[0] := key_column;
			for(i := 1; i < @columns->Size(); i += 1;) {
				@columns[i]->FillNulls(n);
			};

			@size := n;
			@count := n;
			@next_pk := n;
			@version += 1;
		}

		#~
		Gets a column by name
		@param name column name
		@return column, Nil if there is no such column
		~#
		method : public : GetColumn(name : String) ~ Column {
			index := GetIndex(name);
			if(index < 0) {
				return Nil;
			};

			return @columns[index];
		}

		#~
		Gets a column by index; 0 is the 'pk' column
		@param index column index
		@return column, Nil if out of range
		~#
		method : public : GetColumn(index : Int) ~ Column {
			if(index < 0 | index >= @columns->Size()) {
				return Nil;
			};

			return @columns[index];
		}

		#~
		Gets the number of columns, 'pk' included
		@return number of columns
		~#
		method : public : GetColumnCount() ~ Int {
			return @columns->Size();
		}

		#~
		Gets all column names, 'pk' first
		@return column names
		~#
		method : public : GetColumnNames() ~ String[] {
			return @column_names;
		}

		#~
		Gets a number that changes whenever the table's rows or columns change
		@return version
		~#
		method : public : GetVersion() ~ Int {
			return @version;
		}

		#~
		Gets the number of row slots, deleted rows included until Compact
		@return number of row slots
		~#
		method : public : GetRowCapacity() ~ Int {
			return @size;
		}

		#~
		Whether a row slot holds a live (not deleted) row
		@param row row slot
		@return true if live
		~#
		method : public : IsLive(row : Int) ~ Bool {
			if(row < 0 | row >= @size) {
				return false;
			};

			if(@deleted = Nil) {
				return true;
			};

			return (@deleted[row >> 6] and (1 << (row and 63))) = 0;
		}

		#~
		Gets the slots of every live row, in insertion order
		@return row slots
		~#
		method : public : LiveRows() ~ Int[] {
			rows := Int->New[@count];
			n := 0;
			each(i : @size) {
				if(IsLive(i)) {
					rows[n] := i;
					n += 1;
				};
			};

			return rows;
		}

		#~
		Gets a cursor over a row slot
		@param row row slot
		@return row cursor, Nil if the slot is not live
		~#
		method : public : RowAt(row : Int) ~ Row {
			if(<>IsLive(row)) {
				return Nil;
			};

			return Row->New(@self, row);
		}

		#~
		Gets the layout number, which changes when Compact moves rows. Used by Row.
		@return layout number
		~#
		method : public : GetLayout() ~ Int {
			return @layout;
		}

		#~
		Gets the row slot holding a primary key
		@param pk primary key
		@return row slot, -1 if no live row has the key
		~#
		method : public : FindRow(pk : Int) ~ Int {
			if(pk < 0 | pk >= @next_pk) {
				return -1;
			};

			row := -1;
			if(<>@compacted) {
				row := pk;
			}
			else {
				# keys stay ascending in slot order, so a compacted table is searched
				low := 0;
				high := @size - 1;
				pk_column := @columns[0];
				while(low <= high & row < 0) {
					middle := (low + high) / 2;
					key := pk_column->GetInt(middle);
					if(key = pk) {
						row := middle;
					}
					else if(key < pk) {
						low := middle + 1;
					}
					else {
						high := middle - 1;
					};
				};
			};

			if(row < 0 | <>IsLive(row)) {
				return -1;
			};

			return row;
		}

		#~
		Get all rows
		@return all rows
		```
		table := Query.Structured.Table->New("items", ["name"]);
		row := table->Insert(); row->Set("name", "Alpha");
		all := table->GetAll(); # retrieve every row
		each(i : all) { all->Get(i)->ToString()->PrintLine(); };
		```
		~#
		method : public : GetAll() ~ Vector<Row> {
			matches := Vector->New()<Row>;
			each(i : @size) {
				if(IsLive(i)) {
					matches->AddBack(Row->New(@self, i));
				};
			};

			return matches;
		}

		#~
		Get row by primary key
		@param pk primary key
		@return row, Nil if there is no live row with the key
		```
		table := Query.Structured.Table->New("items", ["name"]);
		row := table->Insert(); row->Set("name", "Beta");
		found := table->Get(0); # fetch row with pk=0
		found->ToString()->PrintLine();
		```
		~#
		method : public : Get(pk : Int) ~ Row {
			row := FindRow(pk);
			if(row < 0) {
				return Nil;
			};

			return Row->New(@self, row);
		}

		#~
		Gets unique rows by column name: the first row holding each distinct value. Empty cells
		are skipped.
		@param name column name
		@return unique rows
		```
		table := Query.Structured.Table->New("sales", ["region"]);
		r1 := table->Insert(); r1->Set("region", "East");
		r2 := table->Insert(); r2->Set("region", "East"); # duplicate
		r3 := table->Insert(); r3->Set("region", "West");
		unique := table->Unique("region"); # 2 rows: East, West
		"unique regions: {$unique->Size()}"->PrintLine();
		```
		~#
		method : public : Unique(name : String) ~ Vector<Row> {
			out := Vector->New()<Row>;
			index := GetIndex(name);
			if(index < 0) {
				return out;
			};

			rows := UniqueRows(index, LiveRows());
			each(i : rows) {
				out->AddBack(Row->New(@self, rows[i]));
			};

			return out;
		}

		#~
		Gets the first slot holding each distinct value of a column, among the given slots. Used
		by Query.
		@param index column index
		@param rows row slots to consider, in order
		@return row slots
		~#
		method : public : UniqueRows(index : Int, rows : Int[]) ~ Int[] {
			column := @columns[index];
			kept := Vector->New()<IntRef>;
			if(column->IsEncoded()) {
				seen := Bool->New[column->GetDictionarySize()];
				each(i : rows) {
					code := column->GetCode(rows[i]);
					if(code > -1 & <>seen[code]) {
						seen[code] := true;
						kept->AddBack(rows[i]);
					};
				};
			}
			else {
				# one set per kind of value: a Hash compares keys with the first key's own
				# Compare, which casts its argument, so mixed kinds must never meet in one.
				# A whole-number Float joins the Ints, so 3 and 3.0 are one value, as '='
				# treats them.
				whole := Hash->New()<IntRef, BoolRef>;
				fractions := Hash->New()<FloatRef, BoolRef>;
				by_class := Hash->New()<String, Hash<Compare, BoolRef>>;
				each(i : rows) {
					value := column->Get(rows[i]);
					if(value <> Nil) {
						is_new := false;
						if(value->TypeOf(IntRef)) {
							is_new := Remember(whole, value->As(IntRef));
						}
						else if(value->TypeOf(FloatRef)) {
							number := value->As(FloatRef)->Get();
							if(number = number->Floor() & number->Abs() < 9.0e15) {
								is_new := Remember(whole, IntRef->New(number->As(Int)));
							}
							else {
								is_new := Remember(fractions, value->As(FloatRef));
							};
						}
						else {
							name := value->GetClass()->GetName();
							seen := by_class->Find(name);
							if(seen = Nil) {
								seen := Hash->New()<Compare, BoolRef>;
								by_class->Insert(name, seen);
							};
							if(<>seen->Has(value)) {
								seen->Insert(value, true);
								is_new := true;
							};
						};

						if(is_new) {
							kept->AddBack(rows[i]);
						};
					};
				};
			};

			out := Int->New[kept->Size()];
			each(i : out) {
				out[i] := kept->Get(i)->Get();
			};

			return out;
		}

		function : Remember(seen : Hash<IntRef, BoolRef>, key : IntRef) ~ Bool {
			if(seen->Has(key)) {
				return false;
			};
			seen->Insert(key, true);
			return true;
		}

		function : Remember(seen : Hash<FloatRef, BoolRef>, key : FloatRef) ~ Bool {
			if(seen->Has(key)) {
				return false;
			};
			seen->Insert(key, true);
			return true;
		}

		#~
		Gets the column average over its numeric cells (Ints and Floats). String, date and
		empty cells are skipped: they add nothing to the sum and are not counted in the divisor.
		A column with no numeric cells, or an unknown column, averages to 0.0; Count(name) tells
		the cases apart.
		@param name column name
		@return column average
		```
		table := Query.Structured.Table->New("scores", ["score"]);
		r1 := table->Insert(); r1->Set("score", IntRef->New(80));
		r2 := table->Insert(); r2->Set("score", IntRef->New(90));
		avg := table->Average("score"); # returns 85.0
		"avg={$avg}"->PrintLine();
		```
		~#
		method : public : Average(name : String) ~ Float {
			count := Count(name);
			if(count = 0) {
				return 0.0;
			};

			return Sum(name) / count->As(Float);
		}

		#~
		Gets the number of numeric cells in a column: cells holding an Int or a Float. String,
		date and empty cells are not counted. This is the divisor Average uses, so a caller can
		tell an average of 0.0 from a column with no numbers in it. The row count is Count()
		with no argument.
		@param name column name
		@return number of numeric cells, 0 for an unknown column
		```
		table := Query.Structured.Table->New("scores", ["score"]);
		r1 := table->Insert(); r1->Set("score", IntRef->New(80));
		r2 := table->Insert(); r2->Set("score", "absent");
		n := table->Count("score"); # returns 1
		"numeric cells={$n}"->PrintLine();
		```
		~#
		method : public : Count(name : String) ~ Int {
			index := GetIndex(name);
			if(index < 0) {
				return 0;
			};

			column := @columns[index];
			type := column->GetType();
			if((type = ColumnType->INT | type = ColumnType->FLOAT) & @deleted = Nil) {
				return @size - column->GetNullCount();
			};

			count := 0;
			each(row : @size) {
				if(IsLive(row) & column->IsNumeric(row)) {
					count += 1;
				};
			};

			return count;
		}

		#~
		Gets the smallest numeric value in a column. Only Int and Float cells take part; when
		there are none the result is 0.0 (check Count(name)).
		@param name column name
		@return column minimum
		```
		table := Query.Structured.Table->New("temps", ["deg"]);
		r1 := table->Insert(); r1->Set("deg", IntRef->New(-4));
		r2 := table->Insert(); r2->Set("deg", FloatRef->New(12.5));
		low := table->Min("deg"); # returns -4.0
		"low={$low}"->PrintLine();
		```
		~#
		method : public : Min(name : String) ~ Float {
			return MinMax(name, true);
		}

		#~
		Gets the largest numeric value in a column. Only Int and Float cells take part; when
		there are none the result is 0.0 (check Count(name)).
		@param name column name
		@return column maximum
		```
		table := Query.Structured.Table->New("temps", ["deg"]);
		r1 := table->Insert(); r1->Set("deg", IntRef->New(-4));
		r2 := table->Insert(); r2->Set("deg", FloatRef->New(12.5));
		high := table->Max("deg"); # returns 12.5
		"high={$high}"->PrintLine();
		```
		~#
		method : public : Max(name : String) ~ Float {
			return MinMax(name, false);
		}

		method : MinMax(name : String, is_min : Bool) ~ Float {
			index := GetIndex(name);
			if(index < 0) {
				return 0.0;
			};

			column := @columns[index];
			ends := IndexEnd(column, is_min);
			if(ends <> Nil) {
				return ends->Get();
			};

			found := false;
			result := 0.0;
			each(row : @size) {
				if(IsLive(row) & column->IsNumeric(row)) {
					number := column->GetFloat(row);
					if(<>found) {
						result := number;
						found := true;
					}
					else if(is_min & number < result) {
						result := number;
					}
					else if(<>is_min & number > result) {
						result := number;
					};
				};
			};

			return result;
		}

		# Min or Max of an INT or FLOAT column read from its sorted index: the first live cell
		# of the smallest (or largest) value, which is the cell a scan settles on. Nil when the
		# column has no such index, holds NaN (which a scan's comparisons treat specially) or
		# holds no live value.
		method : IndexEnd(column : Column, is_min : Bool) ~ FloatRef {
			type := column->GetType();
			found := column->GetColumnIndex();
			if(found = Nil | (type <> ColumnType->INT & type <> ColumnType->FLOAT)) {
				return Nil;
			};

			if(found->GetKind() <> IndexKind->SORTED | <>found->Freshen(column, @deleted)) {
				return Nil;
			};

			sorted := found->GetSorted();
			if(sorted->GetNanCount() > 0) {
				return Nil;
			};

			order := sorted->GetOrder();
			size := sorted->GetSize();
			if(is_min) {
				each(p : size) {
					if(IsLive(order[p])) {
						return FloatRef->New(column->GetFloat(order[p]));
					};
				};
				return Nil;
			};

			# the largest value's first live cell: back to the start of its run of equal values
			last := size - 1;
			while(last >= 0 & <>IsLive(order[last])) {
				last -= 1;
			};
			if(last < 0) {
				return Nil;
			};

			first := last;
			p := last - 1;
			while(p >= 0 & sorted->SameKey(p, last)) {
				if(IsLive(order[p])) {
					first := p;
				};
				p -= 1;
			};

			return FloatRef->New(column->GetFloat(order[first]));
		}

		#~
		Gets the column sum over its numeric cells (Ints and Floats); other cells are skipped.
		No numeric cells, or an unknown column, sums to 0.0.
		@param name column name
		@return column sum
		```
		table := Query.Structured.Table->New("sales", ["amount"]);
		r1 := table->Insert(); r1->Set("amount", FloatRef->New(19.99));
		r2 := table->Insert(); r2->Set("amount", FloatRef->New(5.01));
		total := table->Sum("amount"); # returns 25.0
		"total={$total}"->PrintLine();
		```
		~#
		method : public : Sum(name : String) ~ Float {
			index := GetIndex(name);
			if(index < 0) {
				return 0.0;
			};

			column := @columns[index];
			sum := 0.0;
			if(column->GetType() = ColumnType->FLOAT | column->GetType() = ColumnType->INT) {
				# a typed column sums straight from its array
				no_nulls := column->GetNullCount() = 0 & @deleted = Nil;
				each(row : @size) {
					if(no_nulls) {
						sum += column->GetFloat(row);
					}
					else if(IsLive(row) & <>column->IsNull(row)) {
						sum += column->GetFloat(row);
					};
				};
				return sum;
			};

			each(row : @size) {
				if(IsLive(row) & column->IsNumeric(row)) {
					sum += column->GetFloat(row);
				};
			};

			return sum;
		}

		#~
		Filters table based upon conditional criteria. An empty cell matches no condition.
		Numbers compare by value, so an Int cell compares with a Float literal and the other way
		round. Cells that cannot be ordered against the value (a string cell and a number, say)
		are unequal to it: they match '<>' and no other comparison.
		@param cond conditional filter
		@return filtered rows
		~#
		method : public : Filter(cond : Conditional) ~ Vector<Row> {
			matches := Vector->New()<Row>;
			rows := FilterRows(cond, LiveRows());
			each(i : rows) {
				matches->AddBack(Row->New(@self, rows[i]));
			};

			return matches;
		}

		#~
		Gets the slots among the given ones whose cell meets a condition. Used by Query.
		@param cond condition
		@param rows row slots to test, in order
		@return matching row slots, in order
		~#
		method : public : FilterRows(cond : Conditional, rows : Int[]) ~ Int[] {
			column := @columns[cond->GetLeft()];
			right := cond->GetValue();
			kept := Int->New[rows->Size()];
			n := 0;
			each(i : rows) {
				left := column->Get(rows[i]);
				if(left <> Nil) {
					is_match := false;
					select(cond->GetQualifier()) {
						label Conditional->Qualifier->LIKE: {
							if(left->TypeOf(String) & right <> Nil) {
								if(right->TypeOf(String)) {
									is_match := Cell->MatchLike(left->As(String), right->As(String));
								};
							};
						}

						label Conditional->Qualifier->NOT_LIKE: {
							if(left->TypeOf(String) & right <> Nil) {
								if(right->TypeOf(String)) {
									is_match := <>Cell->MatchLike(left->As(String), right->As(String));
								};
							};
						}

						other: {
							is_match := Cell->Test(Cell->Compare(left, right), cond->GetQualifier());
						}
					};

					if(is_match) {
						kept[n] := rows[i];
						n += 1;
					};
				};
			};

			out := Int->New[n];
			each(i : n) {
				out[i] := kept[i];
			};

			return out;
		}

		#~
		Query table using SQL-like syntax. Support for 'select', 'from', 'where', 'distinct',
		'order by' and logical operators.
		@param statement query statement
		@return result table, Nil on error (see GetError)
		```
		table := Query.Structured.Table->New("emp", ["name", "dept"]);
		r := table->Insert(); r->Set("name", "Carol"); r->Set("dept", "Eng");
		rs := table->Query("select name from emp where dept = 'Eng'");
		rs->ToString()->PrintLine();
		```
		~#
		method : public : Query(statement : String) ~ Table {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return Nil;
			};

			holder := StringHolder->New();
			view := plan->Run(@self, Compare->New[0], holder);
			if(view = Nil) {
				SetError(holder->Get());
				return Nil;
			};

			return view->ToTable("<rs>");
		}

		#~
		Runs an INSERT, UPDATE or DELETE on this table, or a CREATE INDEX or DROP INDEX:
		'CREATE INDEX [name] ON table (column) [USING HASH | SORTED]' (SORTED when USING is left
		out) and 'DROP INDEX name [ON table]' (see CreateIndex). A statement that fails changes
		nothing.
		@param statement SQL statement naming this table
		@return rows inserted, updated or deleted (0 for an index), -1 on error (see GetError)
		```
		table->Execute("update emp set dept = 'Ops' where name = 'Carol'");
		table->Execute("create index by_dept on emp (dept) using hash");
		```
		~#
		method : public : Execute(statement : String) ~ Int {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return -1;
			};

			holder := StringHolder->New();
			if(@store <> Nil) {
				@store->Begin();
			};
			changed := plan->Execute(@self, Compare->New[0], holder);
			SetError(holder->Get());
			if(@store <> Nil & <>@store->End()) {
				SetError(@store->GetError());
				return -1;
			};
			return changed;
		}

		#~
		Gets the last error of the calling thread's call on this table: several threads may query
		one table at once, and each reads its own error
		@return last query error, Nil if the calling thread's last query succeeded or none has run
		~#
		method : public : GetError() ~ String {
			return @errors->Get();
		}

		# the calling thread's error, Nil to clear it
		method : SetError(message : String) ~ Nil {
			@errors->Set(message);
		}

		# Sets one cell, recording it when the table is durable. Row->Set and UPDATE come
		# here. A durable table refuses a value its change log cannot hold (an OBJECT cell's
		# value must be an Int, Float, String, Date or Bool), rather than keep it only in memory.
		method : public : SetCell(row : Int, index : Int, value : Compare) ~ Bool {
			column := GetColumn(index);
			if(column = Nil | index = 0 | row < 0 | row >= @size) {
				return false;
			};

			if(<>IsLive(row)) {
				return false;
			};

			if(@store <> Nil & value <> Nil) {
				if(<>(value->TypeOf(IntRef) | value->TypeOf(FloatRef) | value->TypeOf(String) |
						value->TypeOf(Date) | value->TypeOf(BoolRef))) {
					SetError("a durable table records Int, Float, String, Date and Bool values; '{$(column->GetName())}' was given another kind");
					return false;
				};
			};

			if(<>column->Set(row, value)) {
				return false;
			};

			if(@store <> Nil) {
				if(<>@store->LogSet(@columns[0]->GetInt(row), index, value)) {
					SetError(@store->GetError());
				};
			};
			return true;
		}

		# set by TableStore while it records this table's changes
		method : public : SetStore(store : TableStore) ~ Nil {
			@store := store;
		}

		#~
		Whether the table records its changes to disk (it was opened with Table->Open or TableStore)
		@return true if durable
		~#
		method : public : IsDurable() ~ Bool {
			return @store <> Nil;
		}

		#~
		Folds a durable table's change log into a new save and empties it
		@return true if saved, false if the table is not durable or on error (see GetError)
		~#
		method : public : Checkpoint() ~ Bool {
			if(@store = Nil) {
				SetError("the table is not durable; open it with Table->Open or TableStore");
				return false;
			};
			if(<>@store->Checkpoint()) {
				SetError(@store->GetError());
				return false;
			};
			return true;
		}

		#~
		Stops recording a durable table's changes and releases its lock. Changes since the last
		checkpoint stay in the log for the next open.
		~#
		method : public : Close() ~ Nil {
			if(@store <> Nil) {
				@store->Close();
			};
		}

		#~
		Opens a table file for writing (see TableStore): takes its lock, loads it and replays
		its change log. Every change is then recorded as it happens.
		@param path .otab file, created earlier with Save
		@return table, Nil if it cannot be opened (TableStore->New(path)->GetError says why)
		```
		runs := Table->Open("runs.otab");
		if(runs <> Nil) {
		  runs->Execute("delete from runs where score < 0.5");
		  runs->Checkpoint();
		  runs->Close();
		};
		```
		~#
		function : Open(path : String) ~ Table {
			store := TableStore->New(path);
			return store->GetTable();
		}

		#~
		Inserts a new row into the table. After the row has been added its values will need to
		be set.
		@return newly inserted row
		```
		table := Query.Structured.Table->New("tasks", ["title", "done"]);
		row := table->Insert(); # add empty row
		row->Set("title", "Write tests");
		row->Set("done", Row->False());
		row->ToString()->PrintLine();
		```
		~#
		method : public : Insert() ~ Row {
			each(i : @columns) {
				@columns[i]->Append();
			};

			# primary keys are never reused, so they come from their own counter
			@columns[0]->Set(@size, IntRef->New(@next_pk));
			if(@deleted <> Nil & @deleted->Size() * 64 <= @size) {
				@deleted := Column->GrowInts(@deleted, @deleted->Size() * 2);
			};

			row := @size;
			key := @next_pk;
			@next_pk += 1;
			@size += 1;
			@count += 1;
			@version += 1;

			if(@store <> Nil & <>@store->LogInsert(key)) {
				SetError(@store->GetError());
			};

			return Row->New(@self, row);
		}

		#~
		Delete row by primary key
		@param pk primary key
		@return true if successful, false otherwise
		```
		table := Query.Structured.Table->New("items", ["name"]);
		row := table->Insert(); row->Set("name", "Temp");
		ok := table->Delete(0); # remove row with pk=0
		"deleted={$ok}"->PrintLine();
		```
		~#
		method : public : Delete(pk : Int) ~ Bool {
			row := FindRow(pk);
			if(row < 0) {
				return false;
			};

			if(@deleted = Nil) {
				@deleted := Int->New[(@size + 64) / 64 + 1];
			};

			@deleted[row >> 6] := @deleted[row >> 6] or (1 << (row and 63));
			@count -= 1;
			@version += 1;
			for(i := 1; i < @columns->Size(); i += 1;) {
				@columns[i]->IndexDeleted(row);
			};

			if(@store <> Nil & <>@store->LogDelete(pk)) {
				SetError(@store->GetError());
			};

			return true;
		}

		#~
		Removes the space deleted rows still occupy. Primary keys are unchanged; row cursors
		taken before the call find their rows again by key.
		~#
		method : public : Compact() ~ Nil {
			if(@deleted = Nil) {
				return;
			};

			keep := LiveRows();
			each(i : @columns) {
				@columns[i]->Compact(keep);
			};

			@size := keep->Size();
			@deleted := Nil;
			@compacted := true;
			@layout += 1;
			@version += 1;
		}

		#~
		Count of rows. Count(name) counts the numeric cells in one column.
		@return number of rows
		~#
		method : public : Count() ~ Int {
			return @count;
		}

		#~
		Count of rows
		@return number of rows
		~#
		method : public : Size() ~ Int {
			return @count;
		}

		#~
		Summarizes every column: its type, how many cells are filled and empty, how many distinct
		values it holds, and, for numeric columns, the minimum, maximum, mean and standard
		deviation (population).
		@return a table with one row per column
		```
		table := Query.Structured.Table->FromCsv("runs", "runs.csv");
		table->Describe()->ToString()->PrintLine();
		```
		~#
		method : public : Describe() ~ Table {
			summary := Table->New("describe",
				["column", "type", "count", "nulls", "distinct", "min", "max", "mean", "std"],
				[ColumnType->STRING, ColumnType->STRING, ColumnType->INT, ColumnType->INT, ColumnType->INT,
				 ColumnType->FLOAT, ColumnType->FLOAT, ColumnType->FLOAT, ColumnType->FLOAT]);

			rows := LiveRows();
			for(i := 1; i < @columns->Size(); i += 1;) {
				column := @columns[i];
				out := summary->Insert();
				out->Set("column", column->GetName());
				out->Set("type", Column->TypeName(column->GetType()));

				filled := 0;
				numeric := 0;
				sum := 0.0;
				low := 0.0;
				high := 0.0;
				each(j : rows) {
					row := rows[j];
					if(<>column->IsNull(row)) {
						filled += 1;
						if(column->IsNumeric(row)) {
							value := column->GetFloat(row);
							if(numeric = 0) {
								low := value;
								high := value;
							}
							else if(value < low) {
								low := value;
							}
							else if(value > high) {
								high := value;
							};
							sum += value;
							numeric += 1;
						};
					};
				};

				out->Set("count", IntRef->New(filled));
				out->Set("nulls", IntRef->New(rows->Size() - filled));
				out->Set("distinct", IntRef->New(UniqueRows(i, rows)->Size()));
				if(numeric > 0) {
					mean := sum / numeric->As(Float);
					squares := 0.0;
					each(j : rows) {
						if(column->IsNumeric(rows[j])) {
							diff := column->GetFloat(rows[j]) - mean;
							squares += diff * diff;
						};
					};
					out->Set("min", FloatRef->New(low));
					out->Set("max", FloatRef->New(high));
					out->Set("mean", FloatRef->New(mean));
					out->Set("std", FloatRef->New(Float->Sqrt(squares / numeric->As(Float))));
				};
			};

			return summary;
		}

		#~
		Writes the table's live rows as CSV (see View->ToCsv)
		@return CSV text
		```
		table->ToCsv()->PrintLine();
		```
		~#
		method : public : ToCsv() ~ String {
			return AsView()->ToCsv();
		}

		#~
		Writes the table's live rows as delimited text (see View->ToCsv)
		@param delimiter field delimiter, such as '\t'
		@return delimited text
		~#
		method : public : ToCsv(delimiter : Char) ~ String {
			return AsView()->ToCsv(delimiter);
		}

		#~
		Writes the table's live rows as CSV to a stream, a line at a time (see View->WriteCsv)
		@param out stream, such as a FileWriter or an HTTP response body
		@return true if written, false on error (see GetError)
		~#
		method : public : WriteCsv(out : System.IO.OutputStream) ~ Bool {
			view := AsView();
			if(<>view->WriteCsv(out)) {
				SetError(view->GetError());
				return false;
			};
			return true;
		}

		#~
		Writes the table's live rows as JSON, an array of objects (see View->ToJson)
		@return JSON text
		~#
		method : public : ToJson() ~ String {
			return AsView()->ToJson();
		}

		#~
		Writes the table's live rows as JSON to a stream, an object at a time (see View->WriteJson)
		@param out stream
		@return true if written, false on error (see GetError)
		~#
		method : public : WriteJson(out : System.IO.OutputStream) ~ Bool {
			view := AsView();
			if(<>view->WriteJson(out)) {
				SetError(view->GetError());
				return false;
			};
			return true;
		}

		#~
		Copies numeric columns into a matrix for System.ML (see View->ToMatrix); an empty cell
		is an error
		@param names columns to copy
		@return matrix, Nil on error (see GetError)
		~#
		method : public : ToMatrix(names : String[]) ~ Float[,] {
			view := AsView();
			matrix := view->ToMatrix(names);
			if(matrix = Nil) {
				SetError(view->GetError());
			};
			return matrix;
		}

		#~
		Copies numeric columns into a matrix, putting a fill value in empty cells (see
		View->ToMatrix)
		@param names columns to copy
		@param fill value for a missing cell
		@return matrix, Nil on error (see GetError)
		~#
		method : public : ToMatrix(names : String[], fill : Float) ~ Float[,] {
			view := AsView();
			matrix := view->ToMatrix(names, fill);
			if(matrix = Nil) {
				SetError(view->GetError());
			};
			return matrix;
		}

		#~
		Makes a table of FLOAT columns from a matrix, one row per matrix row
		@param name table name
		@param matrix values
		@param names one name per matrix column
		@return table, Nil if the names do not match the matrix's columns
		```
		table := Table->FromMatrix("features", model_input, ["x", "y"]);
		```
		~#
		function : FromMatrix(name : String, matrix : Float[,], names : String[]) ~ Table {
			if(matrix = Nil | names = Nil) {
				return Nil;
			};

			dims := matrix->Size();
			rows := dims[0];
			count := dims[1];
			if(names->Size() <> count) {
				return Nil;
			};

			types := ColumnType->New[count];
			each(j : count) {
				types[j] := ColumnType->FLOAT;
			};
			table := Table->New(name, names, types, true);
			table->Fill(rows);

			present := Bool->New[rows];
			each(i : rows) {
				present[i] := true;
			};
			each(j : count) {
				values := Float->New[rows];
				each(i : rows) {
					values[i] := matrix[i, j];
				};
				table->GetColumn(j + 1)->FillNumbers(ColumnType->FLOAT, Nil, values, present);
			};
			return table;
		}

		#~
		Reads CSV text into a table, typing each column as a whole the way CsvSource does: a
		column of whole numbers is INT, one with decimals FLOAT, one of '#MM/dd/yyyy#' dates
		DATE, and anything else STRING; an empty field is an empty cell. The first line names the
		columns. ToCsv's output reads back with the same values, except that Bools come back as
		the text 'true' and 'false' and a date loses its GMT flag.
		@param name table name
		@param text CSV text
		@return table, Nil if the text cannot be parsed
		```
		copy := Table->FromCsvText("runs", table->ToCsv());
		```
		~#
		function : FromCsvText(name : String, text : String) ~ Table {
			if(text = Nil) {
				return Nil;
			};
			return CsvSource->FromText(name, text, ',')->Read(Nil);
		}

		#~
		Reads JSON text, an array of objects, into a table, as JsonSource does: one row per
		object and one column per member, numbers typed by column, and a nested array or object
		becoming a child table (see JsonSource). JSON objects have no member order, so columns come
		out in name order; FromJson(name, text, names) puts them in a given order.
		@param name table name
		@param text JSON text
		@return table, Nil if the text is not JSON
		~#
		function : FromJson(name : String, text : String) ~ Table {
			if(text = Nil) {
				return Nil;
			};
			return JsonSource->FromText(name, text)->Read(Nil);
		}

		#~
		Reads JSON text into a table with its columns in a given order (see FromJson(name, text))
		@param name table name
		@param text JSON text
		@param names the columns, in order; a name the objects lack gives an empty column
		@return table, Nil if the text is not JSON
		~#
		function : FromJson(name : String, text : String, names : String[]) ~ Table {
			read := FromJson(name, text);
			if(read = Nil | names = Nil) {
				return read;
			};

			indexes := Int->New[names->Size()];
			each(i : names) {
				indexes[i] := read->GetIndex(names[i]);
			};
			return Table->Gather(name, read, indexes, names, read->LiveRows());
		}

		#~
		String representation of table
		@return all rows as a string
		~#
		method : public : ToString() ~ String {
			buffer := "";
			each(i : @size) {
				if(IsLive(i)) {
					buffer += Row->New(@self, i)->ToString();
					buffer += "\r\n";
				};
			};

			return buffer;
		}

		#~
		Loads a table from a CSV file. The first line names the columns. Each cell is typed on
		its own, as it always has been: a whole number ('42', '-3', '+3') becomes an IntRef; a
		decimal or exponent form ('3.5', '.5', '-0.5', '1e3') becomes a FloatRef; '#MM/dd/yyyy#'
		style cells become dates; anything else ('1-2', '3.', 'abc', '') stays a String. A file
		holding only the header line gives an empty table. CsvSource types each column as a whole
		instead, and treats an empty cell as empty.
		@param table_name table name
		@param path to CSV
		@return new table, Nil if the file cannot be read or parsed
		```
		table := Query.Structured.Table->FromCsv("orders", "orders.csv");
		if(table <> Nil) {
		  rs := table->Query("select * from orders where total > 100");
		  rs->ToString()->PrintLine();
		};
		```
		~#
		function : FromCsv(table_name : String, path : String) ~ Table {
			table := CsvToTable(table_name, FileReader->ReadFile(path));
			if(table = Nil) {
				"Unable to parse {$path}!"->ErrorLine();
			};

			return table;
		}

		function : private : CsvToTable(table_name : String, data : String) ~ Table {
			parsed := CsvSource->ParseText(data, ',');
			if(parsed = Nil) {
				return Nil;
			};
			csv := parsed->GetTable();

			headers := csv->Get(0);
			columns := String->New[headers->Size()];
			each(i : headers) {
				columns[i] := headers->Get(i);
			};

			# each cell keeps its own type, so every column holds objects
			types := ColumnType->New[columns->Size()];
			each(i : types) {
				types[i] := ColumnType->OBJECT;
			};
			table := Query.Structured.Table->New(table_name, columns, types, false);
			for(i := 1; i <= parsed->GetRows(); i += 1;) {
				csv_row := csv->Get(i);
				row1 := table->Insert();
				for(j := 0; j < columns->Size(); j += 1;) {
					# a short row leaves its missing cells Nil
					row1->Set(j + 1, Cell->FromText(csv_row->Get(j)));
				};
			};

			return table;
		}

		#~
		Loads a table from a directory file system. Columns are: name, path_name, create_date,
		owner, is_dir and is_readonly, with is_dir and is_readonly as Row->True() and
		Row->False(). FilesystemSource offers more columns and recursion.
		@param table_name table name
		@param path to directory
		@return new table
		```
		table := Query.Structured.Table->FromFilesystem("files", "/tmp/");
		rs := table->Query("select name from files where is_dir = false");
		rs->ToString()->PrintLine(); # list only files, not directories
		```
		~#
		function : FromFilesystem(table_name : String, path : String) ~ Table {
			table := Table->New(table_name, ["name", "path_name", "create_date", "owner", "is_dir", "is_readonly"]);

			source := FilesystemSource->New(path, false);
			listing := source->List(["name", "path", "created", "owner", "is_dir", "is_readonly"]);
			if(listing = Nil) {
				return table;
			};

			each(i : listing->GetRowCapacity()) {
				if(listing->IsLive(i)) {
					entry := listing->RowAt(i);
					row1 := table->Insert();
					row1->Set("name", entry->Get("name"));
					row1->Set("path_name", entry->Get("path"));
					row1->Set("create_date", entry->Get("created"));
					row1->Set("owner", entry->Get("owner"));
					is_dir := entry->Get("is_dir")->As(BoolRef)->Get();
					is_readonly := entry->Get("is_readonly")->As(BoolRef)->Get();
					row1->Set("is_dir", is_dir ? Row->True() : Row->False());
					row1->Set("is_readonly", is_readonly ? Row->True() : Row->False());
				};
			};

			return table;
		}
	}

	#~
	Conditional for filtering
	~#
	class : private : Conditional {
		@left : Int;
		@qualifier : Conditional->Qualifier;
		@value : Compare;
		
		#~
		Conditional comparisons 
		~#
		enum Qualifier {
			EQUAL,
			NOT_EQUAL,
			GREATER,
			LESS,
			GREATER_EQUAL,
			LESS_EQUAL,
			LIKE,
			NOT_LIKE
		}
		
		#~
		Constructor
		@param left index of column to compare
		@param qualifier comparison type
		@param value to compare against column
		~#
		New(left : Int, qualifier : Conditional->Qualifier, value : Compare) {
			@left := left;
			@qualifier := qualifier;
			@value := value;
		}
		
		#~
		Get the qualifying value
		@return qualifying value
		~#
		method : public : GetQualifier() ~ Qualifier {
			return @qualifier;
		}
		
		#~
		Gets the comparison value
		@return comparison value
		~#
		method : public : GetValue() ~ Compare {
			return @value;
		}
		
		#~
		Gets comparison index
		@return comparison index
		~#
		method : public : GetLeft() ~ Int {
			return @left;
		}
	}
	
	# Cell value helpers shared by Table and Query: numeric tests for the
	# aggregates, type-aware comparison for 'where' and 'order by', LIKE
	# matching and CSV text conversion.
	class : private : Cell {
		# a cell's text as Row->ToString shows it
		function : Text(value : Compare) ~ String {
			if(value->TypeOf(IntRef)) {
				return value->As(IntRef)->ToString();
			}
			else if(value->TypeOf(FloatRef)) {
				return value->As(FloatRef)->ToString();
			}
			else if(value->TypeOf(Date)) {
				return value->As(Date)->ToString();
			}
			else if(value->TypeOf(String)) {
				return value->As(String);
			}
			else if(value->TypeOf(BoolRef)) {
				return value->As(BoolRef)->Get() ? "true" : "false";
			};

			return value->GetClass()->GetName();
		}

		# Compare's result for two cells that cannot be ordered against each
		# other; the ordered results are only ever -1, 0 and 1
		function : NotComparable() ~ Int {
			return 2;
		}

		# true if the cell holds a number an aggregate can use
		function : IsNumeric(value : Compare) ~ Bool {
			if(value = Nil) {
				return false;
			};

			return value->TypeOf(IntRef) | value->TypeOf(FloatRef);
		}

		# a numeric cell as a Float; call IsNumeric first
		function : ToNumber(value : Compare) ~ Float {
			if(value->TypeOf(IntRef)) {
				return value->As(IntRef)->Get()->As(Float);
			};

			return value->As(FloatRef)->Get();
		}

		# Orders two cells: -1, 0 or 1, or NotComparable() when they cannot be
		# ordered against each other (a string and a number, a Nil cell). An
		# IntRef and a FloatRef compare by value; two cells of the same class use
		# that class's Compare, which casts its argument to its own class and so
		# must never see a different one.
		function : Compare(left : Compare, right : Compare) ~ Int {
			if(left = Nil | right = Nil) {
				return NotComparable();
			};

			if(left->TypeOf(IntRef) & right->TypeOf(IntRef)) {
				l := left->As(IntRef)->Get();
				r := right->As(IntRef)->Get();
				if(l < r) {
					return -1;
				}
				else if(l > r) {
					return 1;
				};
				return 0;
			};

			if(IsNumeric(left) & IsNumeric(right)) {
				l := ToNumber(left);
				r := ToNumber(right);
				# NaN cannot be ordered against any number
				if(l <> l | r <> r) {
					return NotComparable();
				};
				if(l < r) {
					return -1;
				}
				else if(l > r) {
					return 1;
				};
				return 0;
			};

			if(left->GetClassID() = right->GetClassID()) {
				result := left->Compare(right);
				if(result < 0) {
					return -1;
				}
				else if(result > 0) {
					return 1;
				};
				return 0;
			};

			return NotComparable();
		}

		# applies a comparison qualifier to a Compare result; cells that cannot
		# be compared are unequal, and satisfy no ordering
		function : Test(result : Int, qualifier : Conditional->Qualifier) ~ Bool {
			if(result = NotComparable()) {
				return qualifier = Conditional->Qualifier->NOT_EQUAL;
			};

			select(qualifier) {
				label Conditional->Qualifier->EQUAL: {
					return result = 0;
				}

				label Conditional->Qualifier->NOT_EQUAL: {
					return result <> 0;
				}

				label Conditional->Qualifier->GREATER: {
					return result > 0;
				}

				label Conditional->Qualifier->LESS: {
					return result < 0;
				}

				label Conditional->Qualifier->GREATER_EQUAL: {
					return result >= 0;
				}

				label Conditional->Qualifier->LESS_EQUAL: {
					return result <= 0;
				}
			};

			return false;
		}

		# Total order for 'order by': numbers, then strings, then dates, then
		# anything else (by class name), with Nil cells last. Within a kind the
		# cells compare as in Compare.
		function : Order(left : Compare, right : Compare) ~ Int {
			left_rank := Rank(left);
			right_rank := Rank(right);
			if(left_rank <> right_rank) {
				return left_rank < right_rank ? -1 : 1;
			};

			if(left = Nil) {
				return 0;
			};

			# NaN after every other number, and equal to itself
			if(left_rank = 0) {
				left_nan := IsNaN(left);
				right_nan := IsNaN(right);
				if(left_nan | right_nan) {
					if(left_nan & right_nan) {
						return 0;
					};
					return left_nan ? 1 : -1;
				};
			};

			result := Compare(left, right);
			if(result = NotComparable()) {
				return left->GetClass()->GetName()->Compare(right->GetClass()->GetName());
			};

			return result;
		}

		function : IsNaN(value : Compare) ~ Bool {
			if(value->TypeOf(FloatRef)) {
				number := value->As(FloatRef)->Get();
				return number <> number;
			};
			return false;
		}

		function : Rank(value : Compare) ~ Int {
			if(value = Nil) {
				return 4;
			}
			else if(IsNumeric(value)) {
				return 0;
			}
			else if(value->TypeOf(String)) {
				return 1;
			}
			else if(value->TypeOf(Date)) {
				return 2;
			};

			return 3;
		}

		# SQL LIKE: '%' matches any run of characters, '_' any one character,
		# everything else itself. Matched directly, not through a regex, so a
		# '.', '(' or '*' in the pattern is literal.
		function : MatchLike(check : String, pattern : String) ~ Bool {
			c := 0;
			p := 0;
			star_p := -1;
			star_c := 0;

			while(c < check->Size()) {
				if(p < pattern->Size() & pattern->Get(p) = '%') {
					star_p := p;
					star_c := c;
					p += 1;
				}
				else if(p < pattern->Size() & (pattern->Get(p) = '_' | pattern->Get(p) = check->Get(c))) {
					p += 1;
					c += 1;
				}
				else if(star_p > -1) {
					# let the last '%' absorb one more character and retry
					star_c += 1;
					c := star_c;
					p := star_p + 1;
				}
				else {
					return false;
				};
			};

			while(p < pattern->Size() & pattern->Get(p) = '%') {
				p += 1;
			};

			return p = pattern->Size();
		}

		# Classifies text as a number: 0 not a number, 1 a whole number, 2 a
		# decimal. Accepted: an optional sign, digits with an optional fraction
		# or a fraction alone ('.5'), then an optional exponent ('1e3', '2E-4').
		# A '.' must be followed by a digit, so '3.' is not a number.
		function : NumberKind(text : String) ~ Int {
			size := text->Size();
			i := 0;
			if(i < size & (text->Get(i) = '-' | text->Get(i) = '+')) {
				i += 1;
			};

			int_digits := 0;
			while(i < size & text->Get(i)->IsDigit()) {
				int_digits += 1;
				i += 1;
			};

			is_decimal := false;
			if(i < size & text->Get(i) = '.') {
				i += 1;
				frac_digits := 0;
				while(i < size & text->Get(i)->IsDigit()) {
					frac_digits += 1;
					i += 1;
				};

				if(frac_digits = 0) {
					return 0;
				};
				is_decimal := true;
			}
			else if(int_digits = 0) {
				return 0;
			};

			if(i < size & (text->Get(i) = 'e' | text->Get(i) = 'E')) {
				i += 1;
				if(i < size & (text->Get(i) = '-' | text->Get(i) = '+')) {
					i += 1;
				};

				exp_digits := 0;
				while(i < size & text->Get(i)->IsDigit()) {
					exp_digits += 1;
					i += 1;
				};

				if(exp_digits = 0) {
					return 0;
				};
				is_decimal := true;
			};

			if(i <> size) {
				return 0;
			};

			# more digits than an Int holds is kept as an approximate Float
			if(is_decimal | int_digits > 18) {
				return 2;
			};

			return 1;
		}

		# a CSV cell's text as a table value
		function : FromText(text : String) ~ Compare {
			if(text = Nil) {
				return Nil;
			};

			kind := NumberKind(text);
			if(kind = 1) {
				return IntRef->New(text->ToInt());
			}
			else if(kind = 2) {
				return FloatRef->New(text->ToFloat());
			};

			# date
			if(text->Size() > 1 & text->StartsWith('#') & text->EndsWith('#')) {
				str_value := text->SubString(1, text->Size() - 2);
				select(str_value->Size()) {
					label 8: {
						return DateUtility->Parse(str_value, "MM/dd/yy", false);
					}

					label 10: {
						return DateUtility->Parse(str_value, "MM/dd/yyyy", false);
					}

					label 17: {
						return DateUtility->Parse(str_value, "MM/dd/yy hh:mm:ss", false);
					}

					label 19: {
						return DateUtility->Parse(str_value, "MM/dd/yyyy hh:mm:ss", false);
					}
				};

				return str_value;
			};

			return text;
		}
	}
	

	#~
	A cursor over one row of a table: reading or writing it reads or writes the table's columns.
	~#
	class Row {
		@table : Table;
		@row : Int;
		@pk : Int;
		@layout : Int;
		@true_token : static : IntRef;
		@false_token : static : IntRef;

		#~
		Constructor. Use Table->Insert, Get or GetAll rather than this.
		@param table table
		@param row row slot
		~#
		New(table : Table, row : Int) {
			@table := table;
			@row := row;
			@pk := table->GetColumn(0)->GetInt(row);
			@layout := table->GetLayout();
		}

		# the row's slot now; Compact may have moved it since the cursor was made
		method : Slot() ~ Int {
			if(@layout <> @table->GetLayout()) {
				@row := @table->FindRow(@pk);
				@layout := @table->GetLayout();
			};

			return @row;
		}

		#~
		Gets the row's primary key
		@return primary key
		~#
		method : public : GetKey() ~ Int {
			return @pk;
		}

		#~
		Gets value by name
		@param name column name
		@return value
		~#
		method : public : Get(name : String) ~ Compare {
			return Get(@table->GetIndex(name));
		}

		#~
		Sets value by name
		@param name column name
		@param value value
		@return true if successful, false otherwise (an unknown column, or a declared column of another type)
		~#
		method : public : Set(name : String, value : Compare) ~ Bool {
			return Set(@table->GetIndex(name), value);
		}

		#~
		Gets value by index
		@param index column index
		@return value
		~#
		method : public : Get(index : Int) ~ Compare {
			column := @table->GetColumn(index);
			row := Slot();
			if(column = Nil | row < 0) {
				return Nil;
			};

			return column->Get(row);
		}

		#~
		Sets value by index
		@param index column index; 0, the primary key, cannot be set
		@param value value
		@return true if successful, false otherwise
		~#
		method : public : Set(index : Int, value : Compare) ~ Bool {
			row := Slot();
			if(index = 0 | row < 0) {
				return false;
			};

			return @table->SetCell(row, index, value);
		}

		#~
		Helper for setting 'true' column value
		@return 'true' value holder
		~#
		function : True() ~ IntRef {
			if(@true_token = Nil) {
				@true_token := IntRef->New(1);
			};

			return @true_token;
		}

		#~
		Helper for setting 'false' column value
		@return 'false' value holder
		~#
		function : False() ~ IntRef {
			if(@false_token = Nil) {
				@false_token := IntRef->New(0);
			};

			return @false_token;
		}

		#~
		Gets the next live row in insertion order
		@return next row, Nil at the end
		~#
		method : public : Next() ~ Row {
			row := Slot() + 1;
			while(row < @table->GetRowCapacity()) {
				if(@table->IsLive(row)) {
					return Row->New(@table, row);
				};
				row += 1;
			};

			return Nil;
		}

		#~
		Deprecated: rows follow insertion order, which cannot be changed. Does nothing.
		@param next ignored
		~#
		method : public : Next(next : Row) ~ Nil {
		}

		#~
		Gets the previous live row in insertion order
		@return previous row, Nil at the start
		~#
		method : public : Prev() ~ Row {
			row := Slot() - 1;
			while(row >= 0) {
				if(@table->IsLive(row)) {
					return Row->New(@table, row);
				};
				row -= 1;
			};

			return Nil;
		}

		#~
		Deprecated: rows follow insertion order, which cannot be changed. Does nothing.
		@param prev ignored
		~#
		method : public : Prev(prev : Row) ~ Nil {
		}

		#~
		Gets the number of columns
		@return number of columns
		~#
		method : public : Size() ~ Int {
			return @table->GetColumnCount();
		}

		#~
		String representation of the row
		@return row as string
		~#
		method : public : ToString() ~ String {
			buffer := "";
			size := @table->GetColumnCount();
			each(i : size) {
				value := Get(i);
				if(value <> Nil) {
					if(value->TypeOf(IntRef)) {
						buffer += value->As(IntRef)->ToString();
					}
					else if(value->TypeOf(FloatRef)) {
						buffer += value->As(FloatRef)->ToString();
					}
					else if(value->TypeOf(Date)) {
						buffer += value->As(Date)->ToString();
					}
					else if(value->TypeOf(String)) {
						buffer += value->As(String);
					}
					else if(value->TypeOf(BoolRef)) {
						buffer += value->As(BoolRef)->Get() ? "true" : "false";
					}
					else {
						buffer += value->GetClass()->GetName();
					};
				}
				else {
					buffer += "<Nil>";
				};

				buffer += ", ";
			};

			return buffer;
		}
	}

	# Runs one statement against a table. Public for compatibility only: use Table->Query or
	# Table->Prepare.
	class Query {
		@line : String;
		@table : Table;
		@error : String;

		New(line : String, table : Table) {
			@line := line;
			@table := table;
		}

		method : public : Query() ~ Table {
			result := @table->Query(@line);
			@error := @table->GetError();
			return result;
		}

		method : public : GetError() ~ String {
			return @error;
		}
	}

	#~
	A comparison or a way of combining conditions in a Predicate
	~#
	enum Op {
		EQ,
		NE,
		LT,
		LE,
		GT,
		GE,
		LIKE,
		NOT_LIKE,
		IS_NULL,
		NOT_NULL,
		AND,
		OR,
		NOT,
		MATCHES,
		NOT_MATCHES
	}

	#~
	Sort direction
	~#
	enum Order {
		ASC,
		DESC
	}

	#~
	A condition on a table's rows, built with Col and combined with AndAlso, OrElse and Negate. A
	condition names its columns, so the same one can be used on any table that has them.
	Comparisons are false for an empty cell; numbers compare by value whether Int or Float; a
	cell that cannot be ordered against the value (text and a number, say) satisfies only NE.

```
p := Col->Of("score")->Gt(0.5)->AndAlso(Col->Of("label")->Eq("cat"));
rs := table->Where(p)->OrderBy("score", Order->DESC)->Limit(10);
```
	~#
	class Predicate {
		@op : Op;
		@column : String;
		@value : Compare;
		@param : Int;
		@left : Predicate;
		@right : Predicate;

		#~
		Constructor for a comparison. Col builds these.
		@param op comparison
		@param column column name
		@param value value compared against, Nil for IS_NULL and NOT_NULL
		@param param placeholder number (1 based) whose bound value replaces 'value', 0 for none
		~#
		New(op : Op, column : String, value : Compare, param : Int) {
			@op := op;
			@column := column;
			@value := value;
			@param := param;
		}

		#~
		Constructor for AND, OR and NOT; NOT takes 'right' as Nil
		@param op AND, OR or NOT
		@param left first condition
		@param right second condition
		~#
		New(op : Op, left : Predicate, right : Predicate) {
			@op := op;
			@left := left;
			@right := right;
		}

		#~
		Both this condition and another
		@param condition other condition
		@return combined condition
		~#
		method : public : AndAlso(condition : Predicate) ~ Predicate {
			return Predicate->New(Op->AND, @self, condition);
		}

		#~
		Either this condition or another
		@param condition other condition
		@return combined condition
		~#
		method : public : OrElse(condition : Predicate) ~ Predicate {
			return Predicate->New(Op->OR, @self, condition);
		}

		#~
		The rows this condition does not select, empty cells included
		@return negated condition
		~#
		method : public : Negate() ~ Predicate {
			return Predicate->New(Op->NOT, @self, Nil);
		}

		#~
		Gets the operation
		@return operation
		~#
		method : public : GetOp() ~ Op {
			return @op;
		}

		#~
		Gets the column a comparison names
		@return column name, Nil for AND, OR and NOT
		~#
		method : public : GetColumn() ~ String {
			return @column;
		}

		#~
		Gets the value a comparison uses
		@return value
		~#
		method : public : GetValue() ~ Compare {
			return @value;
		}

		#~
		Gets the placeholder number a comparison takes its value from
		@return placeholder number (1 based), 0 for none
		~#
		method : public : GetParam() ~ Int {
			return @param;
		}

		#~
		Gets the first condition of AND, OR or NOT
		@return condition
		~#
		method : public : GetLeft() ~ Predicate {
			return @left;
		}

		#~
		Gets the second condition of AND or OR
		@return condition
		~#
		method : public : GetRight() ~ Predicate {
			return @right;
		}
	}

	#~
	Starts a condition on a column

```
p := Col->Of("value")->Gt(0.5)->AndAlso(Col->Of("grp")->Eq("g7"));
```
	~#
	class Col {
		@name : String;

		#~
		Constructor
		@param name column name
		~#
		New(name : String) {
			@name := name;
		}

		#~
		Starts a condition on a column
		@param name column name
		@return column reference
		~#
		function : Of(name : String) ~ Col {
			return Col->New(name);
		}

		#~
		Equal to a value
		@param value value
		@return condition
		~#
		method : public : Eq(value : Compare) ~ Predicate {
			return Predicate->New(Op->EQ, @name, value, 0);
		}

		#~
		Equal to an Int
		@param value value
		@return condition
		~#
		method : public : Eq(value : Int) ~ Predicate {
			return Eq(IntRef->New(value));
		}

		#~
		Equal to a Float
		@param value value
		@return condition
		~#
		method : public : Eq(value : Float) ~ Predicate {
			return Eq(FloatRef->New(value));
		}

		#~
		Equal to a Bool
		@param value value
		@return condition
		~#
		method : public : Eq(value : Bool) ~ Predicate {
			return Eq(BoolRef->New(value));
		}

		#~
		Not equal to a value; true for cells that cannot be compared with it
		@param value value
		@return condition
		~#
		method : public : Ne(value : Compare) ~ Predicate {
			return Predicate->New(Op->NE, @name, value, 0);
		}

		#~
		Not equal to an Int
		@param value value
		@return condition
		~#
		method : public : Ne(value : Int) ~ Predicate {
			return Ne(IntRef->New(value));
		}

		#~
		Not equal to a Float
		@param value value
		@return condition
		~#
		method : public : Ne(value : Float) ~ Predicate {
			return Ne(FloatRef->New(value));
		}

		#~
		Less than a value
		@param value value
		@return condition
		~#
		method : public : Lt(value : Compare) ~ Predicate {
			return Predicate->New(Op->LT, @name, value, 0);
		}

		#~
		Less than an Int
		@param value value
		@return condition
		~#
		method : public : Lt(value : Int) ~ Predicate {
			return Lt(IntRef->New(value));
		}

		#~
		Less than a Float
		@param value value
		@return condition
		~#
		method : public : Lt(value : Float) ~ Predicate {
			return Lt(FloatRef->New(value));
		}

		#~
		Less than or equal to a value
		@param value value
		@return condition
		~#
		method : public : Le(value : Compare) ~ Predicate {
			return Predicate->New(Op->LE, @name, value, 0);
		}

		#~
		Less than or equal to an Int
		@param value value
		@return condition
		~#
		method : public : Le(value : Int) ~ Predicate {
			return Le(IntRef->New(value));
		}

		#~
		Less than or equal to a Float
		@param value value
		@return condition
		~#
		method : public : Le(value : Float) ~ Predicate {
			return Le(FloatRef->New(value));
		}

		#~
		Greater than a value
		@param value value
		@return condition
		~#
		method : public : Gt(value : Compare) ~ Predicate {
			return Predicate->New(Op->GT, @name, value, 0);
		}

		#~
		Greater than an Int
		@param value value
		@return condition
		~#
		method : public : Gt(value : Int) ~ Predicate {
			return Gt(IntRef->New(value));
		}

		#~
		Greater than a Float
		@param value value
		@return condition
		~#
		method : public : Gt(value : Float) ~ Predicate {
			return Gt(FloatRef->New(value));
		}

		#~
		Greater than or equal to a value
		@param value value
		@return condition
		~#
		method : public : Ge(value : Compare) ~ Predicate {
			return Predicate->New(Op->GE, @name, value, 0);
		}

		#~
		Greater than or equal to an Int
		@param value value
		@return condition
		~#
		method : public : Ge(value : Int) ~ Predicate {
			return Ge(IntRef->New(value));
		}

		#~
		Greater than or equal to a Float
		@param value value
		@return condition
		~#
		method : public : Ge(value : Float) ~ Predicate {
			return Ge(FloatRef->New(value));
		}

		#~
		Between two values, both included
		@param low lowest value
		@param high highest value
		@return condition
		~#
		method : public : Between(low : Compare, high : Compare) ~ Predicate {
			return Ge(low)->AndAlso(Le(high));
		}

		#~
		Between two Floats, both included
		@param low lowest value
		@param high highest value
		@return condition
		~#
		method : public : Between(low : Float, high : Float) ~ Predicate {
			return Ge(low)->AndAlso(Le(high));
		}

		#~
		Equal to any of the values
		@param values values
		@return condition
		~#
		method : public : In(values : Compare[]) ~ Predicate {
			if(values->Size() = 0) {
				# nothing equals no value: a test that no cell passes
				return IsNull()->AndAlso(IsNotNull());
			};

			result := Eq(values[0]);
			for(i := 1; i < values->Size(); i += 1;) {
				result := result->OrElse(Eq(values[i]));
			};

			return result;
		}

		#~
		Equal to any of the strings
		@param values values
		@return condition
		~#
		method : public : In(values : String[]) ~ Predicate {
			boxed := Compare->New[values->Size()];
			each(i : values) {
				boxed[i] := values[i];
			};
			return In(boxed);
		}

		#~
		Equal to any of the Ints
		@param values values
		@return condition
		~#
		method : public : In(values : Int[]) ~ Predicate {
			boxed := Compare->New[values->Size()];
			each(i : values) {
				boxed[i] := IntRef->New(values[i]);
			};
			return In(boxed);
		}

		#~
		Equal to any of the Floats
		@param values values
		@return condition
		~#
		method : public : In(values : Float[]) ~ Predicate {
			boxed := Compare->New[values->Size()];
			each(i : values) {
				boxed[i] := FloatRef->New(values[i]);
			};
			return In(boxed);
		}

		#~
		Matches an SQL LIKE pattern: '%' any run of characters, '_' any one character
		@param pattern pattern
		@return condition
		~#
		method : public : Like(pattern : String) ~ Predicate {
			return Predicate->New(Op->LIKE, @name, pattern, 0);
		}

		#~
		Does not match an SQL LIKE pattern; only text cells take part
		@param pattern pattern
		@return condition
		~#
		method : public : NotLike(pattern : String) ~ Predicate {
			return Predicate->New(Op->NOT_LIKE, @name, pattern, 0);
		}

		#~
		The whole cell matches a regular expression (Query.RegEx); only text cells take part
		@param pattern regular expression
		@return condition
		~#
		method : public : Matches(pattern : String) ~ Predicate {
			return Predicate->New(Op->MATCHES, @name, pattern, 0);
		}

		#~
		The cell does not match a regular expression; only text cells take part
		@param pattern regular expression
		@return condition
		~#
		method : public : NotMatches(pattern : String) ~ Predicate {
			return Predicate->New(Op->NOT_MATCHES, @name, pattern, 0);
		}

		#~
		The cell is empty
		@return condition
		~#
		method : public : IsNull() ~ Predicate {
			return Predicate->New(Op->IS_NULL, @name, Nil, 0);
		}

		#~
		The cell is not empty
		@return condition
		~#
		method : public : IsNotNull() ~ Predicate {
			return Predicate->New(Op->NOT_NULL, @name, Nil, 0);
		}
	}

	# A Predicate bound to one table: column names resolved to arrays, constants converted
	# once to the column's type. Apply returns the matching row slots, ascending.
	class : private : Filter {
		@op : Op;
		@left : Filter;
		@right : Filter;
		@column : Column;
		@type : ColumnType;
		@nulls : Int[];
		@ints : Int[];
		@floats : Float[];
		@strings : String[];
		@objects : Compare[];
		@dict : String[];
		@value : Compare;
		@comparable : Bool;
		@int_value : Int;
		@float_value : Float;
		@exact_int : Bool;
		@text : String;
		@code : Int;
		@like_codes : Bool[];
		@never : Bool;
		@regex : RegEx;
		@bad_pattern : Bool;
		@plan : String;

		New(op : Op) {
			@op := op;
		}

		# how the last Apply over a whole table found its rows
		method : public : GetPlan() ~ String {
			return @plan;
		}

		# binds a predicate to a table; Nil with 'error' set if a column is unknown or a
		# placeholder has no value
		function : Bind(pred : Predicate, table : Table, params : Compare[], error : StringHolder) ~ Filter {
			if(pred = Nil) {
				error->Set("no condition");
				return Nil;
			};

			op := pred->GetOp();
			if(op = Op->AND | op = Op->OR | op = Op->NOT) {
				filter := Filter->New(op);
				left := Bind(pred->GetLeft(), table, params, error);
				if(left = Nil) {
					return Nil;
				};
				filter->SetLeft(left);
				if(op <> Op->NOT) {
					right := Bind(pred->GetRight(), table, params, error);
					if(right = Nil) {
						return Nil;
					};
					filter->SetRight(right);
				};
				return filter;
			};

			column := table->GetColumn(pred->GetColumn());
			if(column = Nil) {
				error->Set("unknown column '{$(pred->GetColumn())}'");
				return Nil;
			};

			value := pred->GetValue();
			if(pred->GetParam() > 0) {
				if(params = Nil | pred->GetParam() > params->Size()) {
					error->Set("no value bound for placeholder {$(pred->GetParam())}");
					return Nil;
				};
				# a bound NULL: a comparison no row passes
				value := params[pred->GetParam() - 1];
			};

			filter := Filter->New(op);
			filter->Prepare(column, value);
			if(filter->IsBadPattern()) {
				error->Set("'{$(value->As(String))}' is not a valid regular expression");
				return Nil;
			};
			return filter;
		}

		method : public : IsBadPattern() ~ Bool {
			return @bad_pattern;
		}

		function : IsMatchOp(op : Op) ~ Bool {
			return op = Op->MATCHES | op = Op->NOT_MATCHES;
		}

		function : IsTextOp(op : Op) ~ Bool {
			return op = Op->LIKE | op = Op->NOT_LIKE | op = Op->MATCHES | op = Op->NOT_MATCHES;
		}

		# whether text passes a LIKE or MATCHES test, before NOT_ is applied
		method : TextMatches(text : String) ~ Bool {
			if(@regex <> Nil) {
				return @regex->MatchExact(text);
			};

			return Cell->MatchLike(text, @text);
		}

		method : public : SetLeft(left : Filter) ~ Nil {
			@left := left;
		}

		method : public : SetRight(right : Filter) ~ Nil {
			@right := right;
		}

		# resolves the column's arrays and converts the constant to the column's type
		method : public : Prepare(column : Column, value : Compare) ~ Nil {
			@column := column;
			@type := column->GetType();
			@nulls := column->GetNullBits();
			@ints := column->GetIntArray();
			@floats := column->GetFloatArray();
			@strings := column->GetStringArray();
			@objects := column->GetObjectArray();
			@dict := column->GetDictionary();
			@value := value;
			@comparable := false;
			@code := -1;
			if(value = Nil) {
				# a comparison with NULL is false for every row; only IS [NOT] NULL tests for it
				@never := @op <> Op->IS_NULL & @op <> Op->NOT_NULL;
				return;
			};

			# a LIKE or MATCHES pattern, for STRING and OBJECT columns alike
			if(IsTextOp(@op) & value->TypeOf(String)) {
				@text := value->As(String);
			};

			if(IsMatchOp(@op) & value->TypeOf(String)) {
				@regex := RegEx->New(value->As(String));
				if(<>@regex->IsOk()) {
					@bad_pattern := true;
					return;
				};
			};

			select(@type) {
				label ColumnType->INT:
				label ColumnType->FLOAT: {
					if(value->TypeOf(IntRef)) {
						@comparable := true;
						@int_value := value->As(IntRef)->Get();
						@float_value := @int_value->As(Float);
						@exact_int := @type = ColumnType->INT;
					}
					else if(value->TypeOf(FloatRef)) {
						# NaN cannot be ordered against any number: only '<>' holds
						@float_value := value->As(FloatRef)->Get();
						@comparable := @float_value = @float_value;
					};
				}

				label ColumnType->DATE: {
					if(value->TypeOf(Date)) {
						@comparable := true;
						@int_value := DateCodec->ToMillis(value->As(Date));
						@float_value := @int_value->As(Float);
					};
				}

				label ColumnType->BOOL: {
					if(value->TypeOf(BoolRef)) {
						@comparable := true;
						@int_value := value->As(BoolRef)->Get() ? 1 : 0;
					}
					else if(value->TypeOf(IntRef)) {
						# the query words 'true' and 'false' arrive as 1 and 0
						number := value->As(IntRef)->Get();
						if(number = 0 | number = 1) {
							@comparable := true;
							@int_value := number;
						};
					};
				}

				label ColumnType->STRING: {
					if(value->TypeOf(String)) {
						@comparable := true;
						@text := value->As(String);
						if(column->IsEncoded()) {
							@code := column->FindCode(@text);
							if(IsTextOp(@op)) {
								size := column->GetDictionarySize();
								@like_codes := Bool->New[size];
								each(i : size) {
									@like_codes[i] := TextMatches(@dict[i]);
								};
							};
						};
					};
				}
			};
		}

		# The matching slots among 'rows', or among all live rows when 'rows' is Nil. For a whole
		# table the planner may read candidate slots through an index (see Choose); the whole
		# condition is then tested on those candidates, so the answer, and its order, is the one
		# a scan gives.
		method : public : Apply(table : Table, rows : Int[]) ~ Int[] {
			if(rows = Nil) {
				probe := Choose(table);
				if(probe <> Nil) {
					@plan := "where {$(table->GetName())}: {$(probe->Describe())}";
					return Eval(table, probe->Slots(table));
				};
				@plan := "where {$(table->GetName())}: scan";
			};

			return Eval(table, rows);
		}

		# how Apply would find the rows of a whole table, without finding them
		method : public : Describe(table : Table) ~ String {
			probe := Choose(table);
			if(probe = Nil) {
				return "where {$(table->GetName())}: scan";
			};

			return "where {$(table->GetName())}: {$(probe->Describe())}";
		}

		#
		# The planner, rule based (docs/QUERY_DESIGN.md, section 5). For an AND, the index-backed
		# term that reads fewest slots, preferring equality on a hash index; ranges on the same
		# sorted index are narrowed together, so BETWEEN reads one range. For an OR (and IN),
		# indexes only if every alternative has one. NOT, LIKE, MATCHES, '<>' and IS [NOT] NULL
		# are never read through an index. Nil means scan.
		#
		method : Choose(table : Table) ~ IndexProbe {
			if(@op = Op->AND) {
				parts := Vector->New()<Filter>;
				Flatten(Op->AND, parts);
				probes := Vector->New()<IndexProbe>;
				each(i : parts) {
					probe := parts->Get(i)->Choose(table);
					if(probe <> Nil) {
						merged := false;
						if(probe->IsRange()) {
							each(j : probes) {
								earlier := probes->Get(j);
								if(<>merged & earlier->IsRange() & earlier->GetIndex() = probe->GetIndex()) {
									earlier->Intersect(probe);
									merged := true;
								};
							};
						};

						if(<>merged) {
							probes->AddBack(probe);
						};
					};
				};

				return Best(probes);
			}
			else if(@op = Op->OR) {
				parts := Vector->New()<Filter>;
				Flatten(Op->OR, parts);
				probes := Vector->New()<IndexProbe>;
				each(i : parts) {
					probe := parts->Get(i)->Choose(table);
					if(probe = Nil) {
						return Nil;
					};
					probes->AddBack(probe);
				};

				return IndexProbe->New(probes);
			}
			else if(@op = Op->NOT) {
				return Nil;
			};

			return LeafProbe(table);
		}

		# the operands of a run of one operator: a AND (b AND c) gives a, b, c
		method : public : Flatten(op : Op, parts : Vector<Filter>) ~ Nil {
			if(@op = op) {
				@left->Flatten(op, parts);
				@right->Flatten(op, parts);
			}
			else {
				parts->AddBack(@self);
			};
		}

		# a probe that reads nothing, then hash probes, then the one reading fewest slots
		function : Best(probes : Vector<IndexProbe>) ~ IndexProbe {
			if(probes->Size() = 1) {
				return probes->Get(0);
			};

			best : IndexProbe;
			best_count := 0;
			each(i : probes) {
				probe := probes->Get(i);
				if(probe->IsEmpty()) {
					return probe;
				};

				count := probe->Count();
				better := best = Nil;
				if(<>better) {
					if(probe->IsHash() <> best->IsHash()) {
						better := probe->IsHash();
					}
					else {
						better := count < best_count;
					};
				};

				if(better) {
					best := probe;
					best_count := count;
				};
			};

			return best;
		}

		function : OpText(op : Op) ~ String {
			select(op) {
				label Op->EQ: { return "="; }
				label Op->LT: { return "<"; }
				label Op->LE: { return "<="; }
				label Op->GT: { return ">"; }
				label Op->GE: { return ">="; }
			};

			return "?";
		}

		# a comparison read through its column's index, or Nil
		method : LeafProbe(table : Table) ~ IndexProbe {
			if(@column = Nil) {
				return Nil;
			};

			index := @column->GetColumnIndex();
			if(index = Nil) {
				return Nil;
			};

			op := @op;
			is_range := op = Op->LT | op = Op->LE | op = Op->GT | op = Op->GE;
			if(op <> Op->EQ & <>(is_range & index->GetKind() = IndexKind->SORTED)) {
				return Nil;
			};

			if(<>index->Freshen(@column, table->GetDeletedBits())) {
				return Nil;
			};

			name := @column->GetName();
			text := OpText(op);
			if(@never) {
				return IndexProbe->Empty(index, name, text);
			};

			# bound to the column as it is now, or the arrays this filter reads are not the index's
			if(<>@comparable | @type <> @column->GetType() | (@dict <> Nil) <> @column->IsEncoded()) {
				return Nil;
			};

			# a NaN value is not comparable (only '<>' holds), so this is only a guard
			if((@type = ColumnType->FLOAT | (@type = ColumnType->INT & <>@exact_int)) & @float_value <> @float_value) {
				return Nil;
			};

			if(index->GetKind() = IndexKind->HASH) {
				key := 0;
				select(@type) {
					label ColumnType->INT: {
						if(@exact_int) {
							key := @int_value;
						}
						else {
							# a whole number Int cells can equal, or none can
							number := @float_value;
							if(number <> number->Floor()) {
								return IndexProbe->Empty(index, name, text);
							};
							if(number->Abs() >= 9.0e15) {
								return Nil;
							};
							key := number->As(Int);
						};
					}

					label ColumnType->FLOAT: {
						key := ColumnIndex->FloatKey(@float_value);
					}

					label ColumnType->STRING: {
						if(@dict <> Nil) {
							if(@code < 0) {
								return IndexProbe->Empty(index, name, text);
							};
							key := @code;
						}
						else {
							key := @text->HashID();
						};
					}

					other: {
						key := @int_value;
					}
				};

				return IndexProbe->Hash(index, name, text, key);
			};

			# a sorted index: the positions where the cell compares below, equal to and above
			# the value, by the comparison Test makes
			sorted := index->GetSorted();
			order := sorted->GetOrder();
			size := sorted->GetSize();
			low := Bound(order, size, false);
			high := Bound(order, size, true);
			select(op) {
				label Op->EQ: {
					return IndexProbe->Range(index, name, text, low, high);
				}

				label Op->LT: {
					return IndexProbe->Range(index, name, text, 0, low);
				}

				label Op->LE: {
					return IndexProbe->Range(index, name, text, 0, high);
				}

				label Op->GT: {
					return IndexProbe->Range(index, name, text, high, size);
				}
			};

			return IndexProbe->Range(index, name, text, low, size);
		}

		# the first position whose cell compares at or above the value (above, if 'after')
		method : Bound(order : Int[], size : Int, after : Bool) ~ Int {
			low := 0;
			high := size;
			while(low < high) {
				middle := (low + high) / 2;
				result := Order(order[middle]);
				if(result < 0 | (after & result = 0)) {
					low := middle + 1;
				}
				else {
					high := middle;
				};
			};

			return low;
		}

		# how a non-empty cell compares with the value: -1, 0 or 1, as Test compares them
		method : Order(row : Int) ~ Int {
			select(@type) {
				label ColumnType->INT: {
					if(@exact_int) {
						return Order3(@ints[row], @int_value);
					};
					return Order3F(@ints[row]->As(Float), @float_value);
				}

				label ColumnType->FLOAT: {
					return Order3F(@floats[row], @float_value);
				}

				label ColumnType->STRING: {
					if(@dict <> Nil) {
						return Sign(@dict[@ints[row]]->Compare(@text));
					};
					return Sign(@strings[row]->Compare(@text));
				}
			};

			return Order3(@ints[row], @int_value);
		}

		# the matching slots among 'rows', or among all live rows when 'rows' is Nil, by scanning
		method : Eval(table : Table, rows : Int[]) ~ Int[] {
			select(@op) {
				label Op->AND: {
					return @right->Eval(table, @left->Eval(table, rows));
				}

				label Op->OR: {
					return Union(@left->Eval(table, rows), @right->Eval(table, rows));
				}

				label Op->NOT: {
					all := rows <> Nil ? rows : table->LiveRows();
					return Difference(all, @left->Eval(table, all));
				}
			};

			if(rows <> Nil) {
				kept := Int->New[rows->Size()];
				n := 0;
				each(i : rows) {
					row := rows[i];
					if(Test(row)) {
						kept[n] := row;
						n += 1;
					};
				};
				return Trim(kept, n);
			};

			# a scan of the whole table, skipping row groups the zone maps rule out
			size := table->GetRowCapacity();
			deleted := table->GetDeletedBits();
			kept := Int->New[size];
			n := 0;
			group_rows := Column->GroupRows();
			groups := (size + group_rows - 1) / group_rows;
			for(group := 0; group < groups; group += 1;) {
				if(GroupMayMatch(group)) {
					start := group * group_rows;
					finish := start + group_rows;
					if(finish > size) {
						finish := size;
					};
					for(row := start; row < finish; row += 1;) {
						live := deleted = Nil;
						if(<>live) {
							live := (deleted[row >> 6] and (1 << (row and 63))) = 0;
						};
						if(live & Test(row)) {
							kept[n] := row;
							n += 1;
						};
					};
				};
			};

			return Trim(kept, n);
		}

		# whether any row in a group could match, by the group's minimum and maximum
		method : GroupMayMatch(group : Int) ~ Bool {
			if(<>@comparable | <>@column->HasZones()) {
				return true;
			};

			select(@op) {
				label Op->EQ:
				label Op->LT:
				label Op->LE:
				label Op->GT:
				label Op->GE: {
					if(<>@column->GroupHasValues(group)) {
						return false;
					};

					# The group's bounds are Floats. A whole number past 2^53 rounds when converted,
					# so 2^53 + 1 is kept as 2^53: where cells compare as whole numbers (INT against
					# an Int, DATE) the bounds can only rule a group out non-strictly.
					low := @column->GetGroupMin(group);
					high := @column->GetGroupMax(group);
					whole := @exact_int | @type = ColumnType->DATE;
					select(@op) {
						label Op->EQ: { return @float_value >= low & @float_value <= high; }
						label Op->LT: { return whole ? low <= @float_value : low < @float_value; }
						label Op->LE: { return low <= @float_value; }
						label Op->GT: { return whole ? high >= @float_value : high > @float_value; }
						label Op->GE: { return high >= @float_value; }
					};
				}
			};

			return true;
		}

		method : IsNullRow(row : Int) ~ Bool {
			return (@nulls[row >> 6] and (1 << (row and 63))) <> 0;
		}

		# whether one row's cell passes
		method : Test(row : Int) ~ Bool {
			if(@op = Op->IS_NULL) {
				return IsNullRow(row);
			}
			else if(@op = Op->NOT_NULL) {
				return <>IsNullRow(row);
			};

			if(@never | IsNullRow(row)) {
				return false;
			};

			if(IsTextOp(@op)) {
				is_like := @op = Op->LIKE | @op = Op->MATCHES;
				if(@type = ColumnType->STRING & @comparable) {
					if(@like_codes <> Nil) {
						return @like_codes[@ints[row]] = is_like;
					};
					return TextMatches(@strings[row]) = is_like;
				}
				else if(@type = ColumnType->OBJECT & @value <> Nil & @value->TypeOf(String)) {
					cell := @objects[row];
					if(cell->TypeOf(String)) {
						return TextMatches(cell->As(String)) = is_like;
					};
				};
				return false;
			};

			result := 0;
			select(@type) {
				label ColumnType->INT: {
					if(<>@comparable) {
						return @op = Op->NE;
					};
					if(@exact_int) {
						result := Order3(@ints[row], @int_value);
					}
					else {
						result := Order3F(@ints[row]->As(Float), @float_value);
					};
				}

				label ColumnType->FLOAT: {
					cell := @floats[row];
					if(<>@comparable | cell <> cell) {
						return @op = Op->NE;
					};
					result := Order3F(cell, @float_value);
				}

				label ColumnType->DATE:
				label ColumnType->BOOL: {
					if(<>@comparable) {
						return @op = Op->NE;
					};
					result := Order3(@ints[row], @int_value);
				}

				label ColumnType->STRING: {
					if(<>@comparable) {
						return @op = Op->NE;
					};
					if(@dict <> Nil) {
						if(@op = Op->EQ) {
							return @ints[row] = @code;
						}
						else if(@op = Op->NE) {
							return @ints[row] <> @code;
						};
						result := Sign(@dict[@ints[row]]->Compare(@text));
					}
					else {
						result := Sign(@strings[row]->Compare(@text));
					};
				}

				label ColumnType->OBJECT: {
					result := Cell->Compare(@objects[row], @value);
					if(result = Cell->NotComparable()) {
						return @op = Op->NE;
					};
				}

				other: {
					return false;
				}
			};

			select(@op) {
				label Op->EQ: { return result = 0; }
				label Op->NE: { return result <> 0; }
				label Op->LT: { return result < 0; }
				label Op->LE: { return result <= 0; }
				label Op->GT: { return result > 0; }
				label Op->GE: { return result >= 0; }
			};

			return false;
		}

		function : Order3(a : Int, b : Int) ~ Int {
			if(a < b) {
				return -1;
			}
			else if(a > b) {
				return 1;
			};
			return 0;
		}

		# a total order of Floats for sorting: NaN after every number, equal to itself
		function : OrderNaNLast(a : Float, b : Float) ~ Int {
			a_nan := a <> a;
			b_nan := b <> b;
			if(a_nan | b_nan) {
				if(a_nan & b_nan) {
					return 0;
				};
				return a_nan ? 1 : -1;
			};

			return Order3F(a, b);
		}

		function : Order3F(a : Float, b : Float) ~ Int {
			if(a < b) {
				return -1;
			}
			else if(a > b) {
				return 1;
			};
			return 0;
		}

		function : Sign(value : Int) ~ Int {
			if(value < 0) {
				return -1;
			}
			else if(value > 0) {
				return 1;
			};
			return 0;
		}

		function : Trim(values : Int[], size : Int) ~ Int[] {
			trimmed := Int->New[size];
			each(i : size) {
				trimmed[i] := values[i];
			};
			return trimmed;
		}

		# the slots in either ascending list, once each
		function : Union(left : Int[], right : Int[]) ~ Int[] {
			merged := Int->New[left->Size() + right->Size()];
			n := 0;
			l := 0;
			r := 0;
			while(l < left->Size() | r < right->Size()) {
				if(r >= right->Size()) {
					merged[n] := left[l];
					l += 1;
				}
				else if(l >= left->Size()) {
					merged[n] := right[r];
					r += 1;
				}
				else if(left[l] < right[r]) {
					merged[n] := left[l];
					l += 1;
				}
				else if(right[r] < left[l]) {
					merged[n] := right[r];
					r += 1;
				}
				else {
					merged[n] := left[l];
					l += 1;
					r += 1;
				};
				n += 1;
			};
			return Trim(merged, n);
		}

		# the slots in the first ascending list and not the second
		function : Difference(all : Int[], remove : Int[]) ~ Int[] {
			kept := Int->New[all->Size()];
			n := 0;
			r := 0;
			each(i : all) {
				while(r < remove->Size() & remove[r] < all[i]) {
					r += 1;
				};
				if(r >= remove->Size() | remove[r] <> all[i]) {
					kept[n] := all[i];
					n += 1;
				};
			};
			return Trim(kept, n);
		}
	}

	# a String a function can set for its caller
	class : private : StringHolder {
		@value : String;

		New() {
		}

		method : public : Set(value : String) ~ Nil {
			@value := value;
		}

		method : public : Get() ~ String {
			return @value;
		}
	}

	# Sorts row slots by one column with typed keys: numbers and dates as numbers, encoded text
	# by each code's rank in the sorted dictionary, objects by Cell->Order. Stable; empty
	# cells last in either direction.
	class : private : Sorter {
		@type : ColumnType;
		@descending : Bool;
		@nulls : Int[];
		@ints : Int[];
		@floats : Float[];
		@strings : String[];
		@objects : Compare[];
		@ranks : Int[];

		New(column : Column, descending : Bool) {
			@type := column->GetType();
			@descending := descending;
			@nulls := column->GetNullBits();
			@ints := column->GetIntArray();
			@floats := column->GetFloatArray();
			@strings := column->GetStringArray();
			@objects := column->GetObjectArray();
			if(column->IsEncoded()) {
				@ranks := column->GetDictionaryRanks();
			};
		}

		method : public : Sort(rows : Int[]) ~ Int[] {
			size := rows->Size();
			src := Int->New[size];
			each(i : size) {
				src[i] := rows[i];
			};
			dest := Int->New[size];

			width := 1;
			while(width < size) {
				start := 0;
				while(start < size) {
					middle := start + width;
					if(middle > size) {
						middle := size;
					};
					finish := start + width * 2;
					if(finish > size) {
						finish := size;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						take_left := l < middle;
						if(take_left & r < finish) {
							take_left := Compare(src[l], src[r]) <= 0;
						};

						if(take_left) {
							dest[k] := src[l];
							l += 1;
						}
						else {
							dest[k] := src[r];
							r += 1;
						};
						k += 1;
					};

					start := finish;
				};

				swap := src;
				src := dest;
				dest := swap;
				width *= 2;
			};

			return src;
		}

		method : public : Compare(a : Int, b : Int) ~ Int {
			a_null := (@nulls[a >> 6] and (1 << (a and 63))) <> 0;
			b_null := (@nulls[b >> 6] and (1 << (b and 63))) <> 0;
			if(a_null | b_null) {
				if(a_null & b_null) {
					return 0;
				};
				return a_null ? 1 : -1;
			};

			result := 0;
			select(@type) {
				label ColumnType->INT:
				label ColumnType->DATE:
				label ColumnType->BOOL: {
					result := Filter->Order3(@ints[a], @ints[b]);
				}

				label ColumnType->FLOAT: {
					result := Filter->OrderNaNLast(@floats[a], @floats[b]);
				}

				label ColumnType->STRING: {
					if(@ranks <> Nil) {
						result := Filter->Order3(@ranks[@ints[a]], @ranks[@ints[b]]);
					}
					else {
						result := Filter->Sign(@strings[a]->Compare(@strings[b]));
					};
				}

				label ColumnType->OBJECT: {
					result := Cell->Order(@objects[a], @objects[b]);
				}
			};

			return @descending ? -1 * result : result;
		}
	}

	#~
	Rows of a table, chosen and ordered without copying: the table, the columns to show and
	the row slots in order. Chaining Where, OrderBy, Limit and Select only makes new lists of
	slots. A view made before its table changes refuses to read it afterwards (see IsCurrent).

```
view := table->Where(Col->Of("score")->Gt(0.5))->OrderBy("score", Order->DESC)->Limit(10);
each(i : view->Count()) {
  view->Get(i)->ToString()->PrintLine();
};
```
	~#
	class View {
		@table : Table;
		@columns : Int[];
		@names : String[];
		@rows : Int[];
		@version : Int;
		@error : String;
		@plan : String;

		#~
		Constructor. Use Table->AsView, Where, Select or OrderBy rather than this.
		@param table table
		@param columns column indexes shown, 'pk' excluded
		@param rows row slots, in order
		~#
		New(table : Table, columns : Int[], rows : Int[]) {
			@table := table;
			@columns := columns;
			@rows := rows;
			@version := table->GetVersion();
			all := table->GetColumnNames();
			@names := String->New[columns->Size()];
			each(i : columns) {
				@names[i] := columns[i] > -1 ? all[columns[i]] : "";
			};
		}

		#~
		Constructor for a view whose columns may include names the table does not have; those
		read as empty cells. Use Table->Prepare rather than this.
		@param table table
		@param columns column indexes shown, -1 for an unknown name
		@param names column names shown
		@param rows row slots, in order
		~#
		New(table : Table, columns : Int[], names : String[], rows : Int[]) {
			@table := table;
			@columns := columns;
			@names := names;
			@rows := rows;
			@version := table->GetVersion();
		}

		#~
		Whether the table is unchanged since the view was made
		@return true if the view can be read
		~#
		method : public : IsCurrent() ~ Bool {
			if(@version <> @table->GetVersion()) {
				@error := "the table '{$(@table->GetName())}' changed after this view was made";
				return false;
			};

			return true;
		}

		#~
		Gets the reason the last operation failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Tells how the view's rows were found: for each table, whether its condition scanned it or
		read it through an index (naming the index), and which orderings came from a sorted index.
		Steps are separated by '; '.
		@return plan, Nil for a view made without a condition or a query
		```
		rs := table->Where(Col->Of("grp")->Eq("g7"));
		rs->GetPlan()->PrintLine(); # where runs: HASH index runs_grp on grp (=)
		```
		~#
		method : public : GetPlan() ~ String {
			return @plan;
		}

		#~
		Sets the plan GetPlan reports. Used by the query engine.
		@param plan plan text
		~#
		method : public : SetPlan(plan : String) ~ Nil {
			@plan := plan;
		}

		# a view of other rows of the same table, keeping the plan so far
		method : Derived(columns : Int[], names : String[], rows : Int[], step : String) ~ View {
			view := View->New(@table, columns, names, rows);
			if(step = Nil) {
				view->SetPlan(@plan);
			}
			else if(@plan = Nil) {
				view->SetPlan(step);
			}
			else {
				view->SetPlan("{$@plan}; {$step}");
			};
			return view;
		}

		#~
		Gets the table the view reads
		@return table
		~#
		method : public : GetTable() ~ Table {
			return @table;
		}

		#~
		Gets the row slots, in view order
		@return row slots
		~#
		method : public : GetRows() ~ Int[] {
			return @rows;
		}

		#~
		Gets the names of the columns shown
		@return column names
		~#
		method : public : GetColumnNames() ~ String[] {
			return @names;
		}

		#~
		Gets the number of rows
		@return number of rows
		~#
		method : public : Count() ~ Int {
			return @rows->Size();
		}

		#~
		Gets the number of rows
		@return number of rows
		~#
		method : public : Size() ~ Int {
			return @rows->Size();
		}

		#~
		Gets a row by its position in the view
		@param index position, 0 based
		@return row, Nil if out of range or the view is stale
		~#
		method : public : Get(index : Int) ~ Row {
			if(index < 0 | index >= @rows->Size() | <>IsCurrent()) {
				return Nil;
			};

			return Row->New(@table, @rows[index]);
		}

		#~
		Gets every row, in view order
		@return rows, empty if the view is stale
		~#
		method : public : GetAll() ~ Vector<Row> {
			rows := Vector->New()<Row>;
			if(IsCurrent()) {
				each(i : @rows) {
					rows->AddBack(Row->New(@table, @rows[i]));
				};
			};
			return rows;
		}

		#~
		The rows that also meet a condition
		@param condition condition
		@return new view, Nil if the condition names an unknown column (see GetError)
		~#
		method : public : Where(condition : Predicate) ~ View {
			if(<>IsCurrent()) {
				return Nil;
			};

			error := StringHolder->New();
			filter := Filter->Bind(condition, @table, Nil, error);
			if(filter = Nil) {
				@error := error->Get();
				return Nil;
			};

			return Derived(@columns, @names, filter->Apply(@table, @rows), Nil);
		}

		#~
		The same rows showing only some columns
		@param names column names
		@return new view, Nil if a name is unknown (see GetError)
		~#
		method : public : Select(names : String[]) ~ View {
			columns := Int->New[names->Size()];
			each(i : names) {
				index := @table->GetIndex(names[i]);
				if(index < 1) {
					@error := "unknown column '{$(names[i])}'";
					return Nil;
				};
				columns[i] := index;
			};

			view := View->New(@table, columns, @rows);
			view->SetPlan(@plan);
			return view;
		}

		#~
		The rows sorted by a column, ascending; empty cells last
		@param name column name
		@return new view, Nil if the column is unknown (see GetError)
		~#
		method : public : OrderBy(name : String) ~ View {
			return OrderBy(name, Order->ASC);
		}

		#~
		The rows sorted by a column; empty cells last in either direction. Rows with equal
		values keep their order.
		@param name column name
		@param order ASC or DESC
		@return new view, Nil if the column is unknown (see GetError)
		~#
		method : public : OrderBy(name : String, order : Order) ~ View {
			if(<>IsCurrent()) {
				return Nil;
			};

			column := @table->GetColumn(name);
			if(column = Nil) {
				@error := "unknown column '{$name}'";
				return Nil;
			};

			descending := order = Order->DESC;
			ordered := @table->IndexOrder(@table->GetIndex(name), @rows, descending);
			if(ordered <> Nil) {
				return Derived(@columns, @names, ordered, "order {$(@table->GetName())}.{$name}: SORTED index {$(column->GetIndexName())}");
			};

			sorter := Sorter->New(column, descending);
			return Derived(@columns, @names, sorter->Sort(@rows), Nil);
		}

		#~
		At most the first n rows
		@param n row limit
		@return new view
		~#
		method : public : Limit(n : Int) ~ View {
			return Slice(0, n);
		}

		#~
		The rows after the first n
		@param n rows to skip
		@return new view
		~#
		method : public : Offset(n : Int) ~ View {
			return Slice(n, @rows->Size());
		}

		method : Slice(start : Int, count : Int) ~ View {
			if(start < 0) {
				start := 0;
			};
			if(start > @rows->Size()) {
				start := @rows->Size();
			};
			if(count < 0 | start + count > @rows->Size()) {
				count := @rows->Size() - start;
			};

			rows := Int->New[count];
			each(i : count) {
				rows[i] := @rows[start + i];
			};

			return Derived(@columns, @names, rows, Nil);
		}

		#~
		The first row holding each distinct value of a column; empty cells are left out
		@param name column name
		@return new view, Nil if the column is unknown (see GetError)
		~#
		method : public : Distinct(name : String) ~ View {
			index := @table->GetIndex(name);
			if(index < 1) {
				@error := "unknown column '{$name}'";
				return Nil;
			};

			return Derived(@columns, @names, @table->UniqueRows(index, @rows), Nil);
		}

		#~
		Sums a column's numeric cells over the view's rows
		@param name column name
		@return sum, 0.0 if there are none
		~#
		method : public : Sum(name : String) ~ Float {
			column := @table->GetColumn(name);
			if(column = Nil | <>IsCurrent()) {
				return 0.0;
			};

			sum := 0.0;
			each(i : @rows) {
				if(column->IsNumeric(@rows[i])) {
					sum += column->GetFloat(@rows[i]);
				};
			};
			return sum;
		}

		#~
		Counts a column's numeric cells over the view's rows
		@param name column name
		@return count
		~#
		method : public : Count(name : String) ~ Int {
			column := @table->GetColumn(name);
			if(column = Nil | <>IsCurrent()) {
				return 0;
			};

			count := 0;
			each(i : @rows) {
				if(column->IsNumeric(@rows[i])) {
					count += 1;
				};
			};
			return count;
		}

		#~
		Averages a column's numeric cells over the view's rows
		@param name column name
		@return average, 0.0 if there are none
		~#
		method : public : Average(name : String) ~ Float {
			count := Count(name);
			if(count = 0) {
				return 0.0;
			};
			return Sum(name) / count->As(Float);
		}

		#~
		Gets the smallest numeric cell of a column over the view's rows
		@param name column name
		@return minimum, 0.0 if there are none
		~#
		method : public : Min(name : String) ~ Float {
			return MinMax(name, true);
		}

		#~
		Gets the largest numeric cell of a column over the view's rows
		@param name column name
		@return maximum, 0.0 if there are none
		~#
		method : public : Max(name : String) ~ Float {
			return MinMax(name, false);
		}

		method : MinMax(name : String, is_min : Bool) ~ Float {
			column := @table->GetColumn(name);
			if(column = Nil | <>IsCurrent()) {
				return 0.0;
			};

			found := false;
			result := 0.0;
			each(i : @rows) {
				if(column->IsNumeric(@rows[i])) {
					value := column->GetFloat(@rows[i]);
					if(<>found | (is_min & value < result) | (<>is_min & value > result)) {
						result := value;
						found := true;
					};
				};
			};
			return result;
		}

		#~
		Copies the view into a new, independent table
		@param name new table's name
		@return table, Nil if the view is stale
		~#
		method : public : ToTable(name : String) ~ Table {
			if(<>IsCurrent()) {
				return Nil;
			};

			return Table->Gather(name, @table, @columns, @names, @rows);
		}

		#~
		Writes the view as CSV: a header line of column names, then one line per row, quoted
		only where RFC 4180 needs it. Empty cells are empty fields; numbers are written exactly
		(a Float as the shortest text that reads back as the same value); dates as
		'#MM/dd/yyyy hh:mm:ss#', the form CsvSource reads back as dates; Bools as true and false.
		@return CSV text, Nil if the view is stale
		```
		results := table->Query("select id, score from runs where score > 0.5");
		results->ToCsv()->PrintLine();
		```
		~#
		method : public : ToCsv() ~ String {
			return ToCsv(',');
		}

		#~
		Writes the view as delimited text (see ToCsv())
		@param delimiter field delimiter, such as '\t'
		@return delimited text, Nil if the view is stale
		~#
		method : public : ToCsv(delimiter : Char) ~ String {
			if(<>IsCurrent()) {
				return Nil;
			};

			buffer := "";
			buffer->Append(Data.CSV.CsvTable->FormatRow(@names, delimiter));
			buffer->Append("\r\n");
			each(i : @rows) {
				buffer->Append(CsvLine(@rows[i], delimiter));
				buffer->Append("\r\n");
			};
			return buffer;
		}

		#~
		Writes the view as CSV to a stream, a line at a time, so a large result never has to be
		held as one string (see ToCsv())
		@param out stream, such as a FileWriter or an HTTP response body
		@return true if every line was written, false on error (see GetError)
		~#
		method : public : WriteCsv(out : System.IO.OutputStream) ~ Bool {
			return WriteCsv(out, ',');
		}

		#~
		Writes the view as delimited text to a stream (see ToCsv())
		@param out stream
		@param delimiter field delimiter
		@return true if every line was written, false on error (see GetError)
		~#
		method : public : WriteCsv(out : System.IO.OutputStream, delimiter : Char) ~ Bool {
			if(<>IsCurrent()) {
				return false;
			};

			if(<>Export->Write(out, Data.CSV.CsvTable->FormatRow(@names, delimiter) + "\r\n")) {
				@error := "the stream refused the CSV header";
				return false;
			};

			each(i : @rows) {
				if(<>Export->Write(out, CsvLine(@rows[i], delimiter) + "\r\n")) {
					@error := "the stream refused row {$(i + 1)}";
					return false;
				};
			};
			return true;
		}

		method : CsvLine(row : Int, delimiter : Char) ~ String {
			fields := String->New[@columns->Size()];
			each(j : @columns) {
				fields[j] := @columns[j] > -1 ? Export->CsvText(@table->GetColumn(@columns[j])->Get(row)) : "";
			};
			return Data.CSV.CsvTable->FormatRow(fields, delimiter);
		}

		#~
		Writes the view as JSON: an array with one object per row, members in column order.
		Numbers are written exactly; an empty cell is null, as is a Float that is not a finite
		number (JSON has none); a date is its ISO 8601 text, 'yyyy-MM-ddTHH:mm:ss', with a
		trailing 'Z' for a GMT date.
		@return JSON text, Nil if the view is stale
		```
		results := table->Query("select id, label from runs limit 3");
		results->ToJson()->PrintLine(); # [{"id":1,"label":"cat"},...]
		```
		~#
		method : public : ToJson() ~ String {
			if(<>IsCurrent()) {
				return Nil;
			};

			buffer := "[";
			each(i : @rows) {
				if(i > 0) {
					buffer->Append(',');
				};
				buffer->Append(JsonObject(@rows[i]));
			};
			buffer->Append(']');
			return buffer;
		}

		#~
		Writes the view as JSON to a stream, an object at a time (see ToJson())
		@param out stream
		@return true if everything was written, false on error (see GetError)
		~#
		method : public : WriteJson(out : System.IO.OutputStream) ~ Bool {
			if(<>IsCurrent()) {
				return false;
			};

			if(<>Export->Write(out, "[")) {
				@error := "the stream refused the JSON array";
				return false;
			};

			each(i : @rows) {
				text := JsonObject(@rows[i]);
				if(i > 0) {
					text := ",{$text}";
				};
				if(<>Export->Write(out, text)) {
					@error := "the stream refused row {$(i + 1)}";
					return false;
				};
			};

			if(<>Export->Write(out, "]")) {
				@error := "the stream refused the end of the JSON array";
				return false;
			};
			return true;
		}

		method : JsonObject(row : Int) ~ String {
			buffer := "{";
			each(j : @columns) {
				if(j > 0) {
					buffer->Append(',');
				};
				buffer->Append('"');
				buffer->Append(Data.JSON.JsonElement->Encode(@names[j]));
				buffer->Append("\":");
				value : Compare;
				if(@columns[j] > -1) {
					value := @table->GetColumn(@columns[j])->Get(row);
				};
				buffer->Append(Export->JsonText(value));
			};
			buffer->Append('}');
			return buffer;
		}

		#~
		Copies numeric columns into a matrix for System.ML, one row per view row, one column per
		name, in the order named. INT, FLOAT and BOOL cells are read as numbers (a Bool as 1 or
		0), and so are numbers in an OBJECT column. An empty cell, or one that is not a number,
		is an error: no value is invented without being asked for (see ToMatrix(names, fill)).
		@param names columns to copy
		@return matrix, Nil on error (see GetError)
		```
		features := table->AsView()->ToMatrix(["height", "weight"]);
		```
		~#
		method : public : ToMatrix(names : String[]) ~ Float[,] {
			return Matrix(names, false, 0.0);
		}

		#~
		Copies numeric columns into a matrix, putting a fill value where a cell is empty or not
		a number (see ToMatrix(names))
		@param names columns to copy
		@param fill value for a missing cell, such as 0.0 or a column mean
		@return matrix, Nil on error (see GetError)
		~#
		method : public : ToMatrix(names : String[], fill : Float) ~ Float[,] {
			return Matrix(names, true, fill);
		}

		method : Matrix(names : String[], filled : Bool, fill : Float) ~ Float[,] {
			if(<>IsCurrent()) {
				return Nil;
			};

			if(names = Nil | names->Size() = 0) {
				@error := "ToMatrix needs at least one column name";
				return Nil;
			};

			columns := Column->New[names->Size()];
			each(j : names) {
				index := @table->GetIndex(names[j]);
				if(index < 1) {
					@error := "no column '{$(names[j])}'";
					return Nil;
				};
				columns[j] := @table->GetColumn(index);
			};

			matrix := Float->New[@rows->Size(), names->Size()];
			each(i : @rows) {
				row := @rows[i];
				each(j : columns) {
					column := columns[j];
					if(<>column->IsNull(row) & (column->IsNumeric(row) | column->GetType() = ColumnType->BOOL)) {
						matrix[i, j] := column->GetFloat(row);
					}
					else if(filled) {
						matrix[i, j] := fill;
					}
					else {
						why := column->IsNull(row) ? "is empty" : "is not a number";
						@error := "column '{$(names[j])}', row {$(i + 1)} {$why}; pass a fill value to ToMatrix to replace such cells";
						return Nil;
					};
				};
			};
			return matrix;
		}

		#~
		String representation of the view's rows
		@return rows as a string
		~#
		method : public : ToString() ~ String {
			buffer := "";
			if(IsCurrent()) {
				each(i : @rows) {
					row := Row->New(@table, @rows[i]);
					each(j : @columns) {
						value := @columns[j] > -1 ? row->Get(@columns[j]) : Nil;
						buffer += value <> Nil ? Cell->Text(value) : "<Nil>";
						buffer += ", ";
					};
					buffer += "\r\n";
				};
			};
			return buffer;
		}
	}

	# one cell as CSV or JSON text, and writing text to a stream
	class : private : Export {
		function : CsvText(value : Compare) ~ String {
			if(value = Nil) {
				return "";
			}
			else if(value->TypeOf(IntRef)) {
				return value->As(IntRef)->Get()->ToString();
			}
			else if(value->TypeOf(FloatRef)) {
				return Number(value->As(FloatRef)->Get());
			}
			else if(value->TypeOf(BoolRef)) {
				return value->As(BoolRef)->Get() ? "true" : "false";
			}
			else if(value->TypeOf(Date)) {
				date := value->As(Date);
				return "#{$(Pad(date->GetMonth(), 2))}/{$(Pad(date->GetDay(), 2))}/{$(Pad(date->GetYear(), 4))} {$(Pad(date->GetHours(), 2))}:{$(Pad(date->GetMinutes(), 2))}:{$(Pad(date->GetSeconds(), 2))}#";
			}
			else if(value->TypeOf(String)) {
				return value->As(String);
			};

			return Cell->Text(value);
		}

		function : JsonText(value : Compare) ~ String {
			if(value = Nil) {
				return "null";
			}
			else if(value->TypeOf(IntRef)) {
				return value->As(IntRef)->Get()->ToString();
			}
			else if(value->TypeOf(FloatRef)) {
				number := value->As(FloatRef)->Get();
				# JSON has no NaN or infinity
				if(number - number <> 0.0) {
					return "null";
				};
				return Number(number);
			}
			else if(value->TypeOf(BoolRef)) {
				return value->As(BoolRef)->Get() ? "true" : "false";
			}
			else if(value->TypeOf(Date)) {
				date := value->As(Date);
				zone := date->IsGmt() ? "Z" : "";
				return "\"{$(Pad(date->GetYear(), 4))}-{$(Pad(date->GetMonth(), 2))}-{$(Pad(date->GetDay(), 2))}T{$(Pad(date->GetHours(), 2))}:{$(Pad(date->GetMinutes(), 2))}:{$(Pad(date->GetSeconds(), 2))}{$zone}\"";
			};

			text := value->TypeOf(String) ? value->As(String) : Cell->Text(value);
			return "\"" + Data.JSON.JsonElement->Encode(text) + "\"";
		}

		# a Float as the shortest text that reads back as the same value
		function : Number(value : Float) ~ String {
			return Float->ToShortString(value);
		}

		function : Pad(value : Int, width : Int) ~ String {
			text := value->ToString();
			while(text->Size() < width) {
				text := "0" + text;
			};
			return text;
		}

		# text as UTF-8; true only if the stream took every byte
		function : Write(out : System.IO.OutputStream, text : String) ~ Bool {
			if(out = Nil) {
				return false;
			};
			bytes := text->ToByteArray();
			if(bytes->Size() = 0) {
				return true;
			};
			return out->WriteBuffer(0, bytes->Size(), bytes) = bytes->Size();
		}
	}

	#~
	A statement parsed once and run many times, with '?' placeholders for values bound before
	each run. Placeholders are numbered from 1, left to right. A SELECT runs with Execute; an
	INSERT, UPDATE, DELETE or CREATE TABLE with ExecuteUpdate.

```
statement := table->Prepare("select id, score from runs where score > ? and label = ?");
statement->Bind(1, 0.5)->Bind(2, "cat");
results := statement->Execute();
```
	~#
	class Statement {
		@table : Table;
		@catalog : Catalog;
		@plan : Plan;
		@params : Compare[];
		@bound : Bool[];
		@error : String;

		#~
		Constructor. Use Table->Prepare rather than this.
		@param table table
		@param plan parsed statement
		~#
		New(table : Table, plan : Plan) {
			@table := table;
			@plan := plan;
			@params := Compare->New[plan->GetParamCount()];
			@bound := Bool->New[plan->GetParamCount()];
		}

		#~
		Constructor. Use Catalog->Prepare rather than this.
		@param catalog catalog
		@param plan parsed statement
		~#
		New(catalog : Catalog, plan : Plan) {
			@catalog := catalog;
			@plan := plan;
			@params := Compare->New[plan->GetParamCount()];
			@bound := Bool->New[plan->GetParamCount()];
		}

		#~
		Gets the number of placeholders
		@return placeholder count
		~#
		method : public : GetParamCount() ~ Int {
			return @params->Size();
		}

		#~
		Whether the statement is a SELECT, which Execute runs; INSERT, UPDATE, DELETE and CREATE
		TABLE run with ExecuteUpdate
		@return true for a SELECT
		~#
		method : public : IsQuery() ~ Bool {
			return @plan->IsQuery();
		}

		#~
		Binds a value to a placeholder
		@param index placeholder number, from 1
		@param value value
		@return this statement
		~#
		method : public : Bind(index : Int, value : Compare) ~ Statement {
			if(index >= 1 & index <= @params->Size()) {
				@params[index - 1] := value;
				@bound[index - 1] := true;
			};
			return @self;
		}

		#~
		Binds NULL to a placeholder: an empty cell in INSERT and UPDATE; in a condition, a
		comparison no row passes, as every comparison with an empty cell is false
		@param index placeholder number, from 1
		@return this statement
		~#
		method : public : BindNull(index : Int) ~ Statement {
			value : Compare;
			return Bind(index, value);
		}

		# the reason the statement cannot run yet, Nil if every placeholder has a value
		method : Unbound() ~ String {
			each(i : @bound) {
				if(<>@bound[i]) {
					return "no value bound for placeholder {$(i + 1)}";
				};
			};

			return Nil;
		}

		#~
		Binds an Int to a placeholder
		@param index placeholder number, from 1
		@param value value
		@return this statement
		~#
		method : public : Bind(index : Int, value : Int) ~ Statement {
			return Bind(index, IntRef->New(value)->As(Compare));
		}

		#~
		Binds a Float to a placeholder
		@param index placeholder number, from 1
		@param value value
		@return this statement
		~#
		method : public : Bind(index : Int, value : Float) ~ Statement {
			return Bind(index, FloatRef->New(value)->As(Compare));
		}

		#~
		Binds a Bool to a placeholder
		@param index placeholder number, from 1
		@param value value
		@return this statement
		~#
		method : public : Bind(index : Int, value : Bool) ~ Statement {
			return Bind(index, BoolRef->New(value)->As(Compare));
		}

		#~
		Runs the query, copying the result into a new table
		@return result table, Nil on error (see GetError)
		~#
		method : public : Execute() ~ Table {
			view := ExecuteView();
			if(view = Nil) {
				return Nil;
			};
			return view->ToTable("<rs>");
		}

		#~
		Runs the query without copying the result
		@return result view, Nil on error (see GetError)
		~#
		method : public : ExecuteView() ~ View {
			@error := Unbound();
			if(@error <> Nil) {
				return Nil;
			};

			error := StringHolder->New();
			view : View;
			if(@catalog <> Nil) {
				view := @plan->RunIn(@catalog, @params, error);
			}
			else {
				view := @plan->Run(@table, @params, error);
			};
			@error := error->Get();
			return view;
		}

		#~
		Runs an INSERT, UPDATE, DELETE, CREATE TABLE, CREATE INDEX or DROP INDEX (see Table->Execute). A statement that fails changes nothing.
		@return rows inserted, updated or deleted (0 for CREATE TABLE), -1 on error (see GetError)
		~#
		method : public : ExecuteUpdate() ~ Int {
			@error := Unbound();
			if(@error <> Nil) {
				return -1;
			};

			error := StringHolder->New();
			changed := 0;
			if(@catalog <> Nil) {
				changed := @plan->ExecuteIn(@catalog, @params, error);
			}
			else {
				changed := @plan->Execute(@table, @params, error);
			};
			@error := error->Get();
			return changed;
		}

		#~
		Tells how the statement reads its rows with the values bound now (see Table->Explain);
		a SELECT is run to find out, an UPDATE or DELETE is not
		@return plan, Nil on error (see GetError)
		```
		s := table->Prepare("select * from runs where score > ?");
		s->Bind(1, 0.9);
		s->Explain()->PrintLine(); # where runs: SORTED index runs_score on score (>)
		```
		~#
		method : public : Explain() ~ String {
			@error := Unbound();
			if(@error <> Nil) {
				return Nil;
			};

			error := StringHolder->New();
			text : String;
			if(@catalog <> Nil) {
				text := @plan->ExplainIn(@catalog, @params, error);
			}
			else {
				text := @plan->Explain(@table, @params, error);
			};
			@error := error->Get();
			return text;
		}

		#~
		Gets the reason the last run failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	# A parsed query: the table it names, its columns (Nil for '*'), an optional 'distinct'
	# column, its condition and its 'order by' column.
	#~
	How Save and ToBytes compress the blocks of an .otab file: NONE stores them as they are,
	FAST uses zlib at its quickest level and SMALL at its smallest. Each block keeps the codec it
	was written with, so a reader needs no option, and a block that compression would not
	shrink is stored as it is.
	~#
	enum Compression {
		NONE,
		FAST,
		SMALL
	}

	#
	# The .otab format (docs/QUERY_DESIGN.md, section 9). Numbers are little-endian 64-bit Ints
	# and Floats; text is a byte length (-1 for none) then its bytes.
	#
	#   header:  "OTAB", format version
	#   blocks:  for each row group, one block per column (the key column first), each stored
	#            as it is or zlib-compressed
	#   footer:  table name, next key, column count, then per column its name, type and whether
	#            it is declared; row group count, then per group its row count and per column
	#            the block's offset, stored and raw size, codec, CRC32 of the stored bytes, null
	#            count and zone (whether it has one, minimum, maximum); in version 2, then the
	#            index count and per index its name, column position and kind
	#   trailer: footer offset, footer size, footer CRC32, "OTAB"
	#
	# A table with no index is written as version 1, which every reader since phase 3 reads;
	# one with indexes as version 2, which older readers refuse by its version.
	#
	# A block holds its rows' null bitmap, then the values: Ints for INT and BOOL, Ints and GMT
	# bits for DATE, Floats for FLOAT, a dictionary and Int codes (or plain texts) for STRING,
	# and tagged values for OBJECT. Each block stands alone, so a reader takes only the columns
	# it needs, and appended row groups need no shared dictionary.
	#

	# little-endian fields onto a byte buffer
	class : private : OtabWriter {
		@buffer : ByteBuffer;

		New() {
			@buffer := ByteBuffer->New();
		}

		method : public : PutInt(value : Int) ~ Nil {
			values := Int->New[1];
			values[0] := value;
			@buffer->Append(Int->ToBytes(values));
		}

		method : public : PutFloat(value : Float) ~ Nil {
			values := Float->New[1];
			values[0] := value;
			@buffer->Append(Float->ToBytes(values));
		}

		method : public : PutInts(values : Int[], offset : Int, count : Int) ~ Nil {
			if(count > 0) {
				@buffer->Append(Int->ToBytes(values, offset, count));
			};
		}

		method : public : PutFloats(values : Float[], offset : Int, count : Int) ~ Nil {
			if(count > 0) {
				@buffer->Append(Float->ToBytes(values, offset, count));
			};
		}

		method : public : PutText(value : String) ~ Nil {
			if(value = Nil) {
				PutInt(-1);
				return;
			};

			bytes := value->ToByteArray();
			PutInt(bytes->Size());
			@buffer->Append(bytes);
		}

		method : public : PutBytes(bytes : Byte[]) ~ Nil {
			@buffer->Append(bytes);
		}

		method : public : Magic() ~ Nil {
			@buffer->Append("OTAB"->ToByteArray());
		}

		method : public : Size() ~ Int {
			return @buffer->Size();
		}

		method : public : ToByteArray() ~ Byte[] {
			return @buffer->ToByteArray();
		}
	}

	# fields read back from bytes; a read past the end sets IsBad and never runs off
	class : private : OtabReader {
		@bytes : Byte[];
		@pos : Int;
		@bad : Bool;

		New(bytes : Byte[]) {
			@bytes := bytes;
		}

		method : public : IsBad() ~ Bool {
			return @bad;
		}

		method : public : AtEnd() ~ Bool {
			return @pos = @bytes->Size();
		}

		method : Has(count : Int) ~ Bool {
			if(@bad | count < 0 | @pos + count > @bytes->Size()) {
				@bad := true;
				return false;
			};

			return true;
		}

		method : public : Skip(count : Int) ~ Nil {
			if(Has(count)) {
				@pos += count;
			};
		}

		method : public : GetInt() ~ Int {
			if(<>Has(8)) {
				return 0;
			};

			values := Byte->ToInts(@bytes, @pos, 1);
			@pos += 8;
			return values[0];
		}

		method : public : GetFloat() ~ Float {
			if(<>Has(8)) {
				return 0.0;
			};

			values := Byte->ToFloats(@bytes, @pos, 1);
			@pos += 8;
			return values[0];
		}

		method : public : GetInts(count : Int) ~ Int[] {
			if(count = 0) {
				return Int->New[0];
			};

			if(count < 0 | count > @bytes->Size() | <>Has(count * 8)) {
				@bad := true;
				return Int->New[0];
			};

			values := Byte->ToInts(@bytes, @pos, count);
			@pos += count * 8;
			return values;
		}

		method : public : GetFloats(count : Int) ~ Float[] {
			if(count = 0) {
				return Float->New[0];
			};

			if(count < 0 | count > @bytes->Size() | <>Has(count * 8)) {
				@bad := true;
				return Float->New[0];
			};

			values := Byte->ToFloats(@bytes, @pos, count);
			@pos += count * 8;
			return values;
		}

		method : public : GetText() ~ String {
			size := GetInt();
			if(size < 0 | @bad) {
				return Nil;
			};

			if(<>Has(size)) {
				return Nil;
			};

			part := Byte->New[size];
			Byte->Copy(part, 0, @bytes, @pos, size);
			@pos += size;
			return part->ToString();
		}
	}

	# column types and OBJECT cell kinds as the numbers the format stores
	class : private : OtabCodes {
		function : FromType(type : ColumnType) ~ Int {
			select(type) {
				label ColumnType->INT: { return 1; }
				label ColumnType->FLOAT: { return 2; }
				label ColumnType->STRING: { return 3; }
				label ColumnType->DATE: { return 4; }
				label ColumnType->BOOL: { return 5; }
				label ColumnType->OBJECT: { return 6; }
			};

			return 0;
		}

		# NONE for a code this version does not know
		function : ToType(code : Int, known : BoolRef) ~ ColumnType {
			known->Set(code >= 0 & code <= 6);
			select(code) {
				label 1: { return ColumnType->INT; }
				label 2: { return ColumnType->FLOAT; }
				label 3: { return ColumnType->STRING; }
				label 4: { return ColumnType->DATE; }
				label 5: { return ColumnType->BOOL; }
				label 6: { return ColumnType->OBJECT; }
			};

			return ColumnType->NONE;
		}

		# OBJECT cell kinds
		function : Empty() ~ Int { return 0; }
		function : Whole() ~ Int { return 1; }
		function : Number() ~ Int { return 2; }
		function : Text() ~ Int { return 3; }
		function : When() ~ Int { return 4; }
		function : Flag() ~ Int { return 5; }
	}

	# one column's values for one row group, as stored in a block
	class : private : OtabBlock {
		# the bytes of rows [start, start + count) of a column; Nil with the error set
		function : Encode(column : Column, start : Int, count : Int, error : StringHolder) ~ Byte[] {
			out := OtabWriter->New();

			# the null bitmap: groups start on a multiple of 64 rows, so whole words line up
			words := (count + 63) / 64;
			nulls := GroupBits(column->GetNullBits(), start, count, Nil);
			out->PutInt(words);
			out->PutInts(nulls, 0, words);

			# An emptied cell keeps whatever its slot last held, so every slot of an empty
			# cell is written as 0: a saved file never carries a value the user cleared, and
			# equal tables save to equal bytes.
			select(column->GetType()) {
				label ColumnType->INT:
				label ColumnType->BOOL: {
					out->PutInts(GroupInts(column->GetIntArray(), start, count, nulls), 0, count);
				}

				label ColumnType->DATE: {
					out->PutInts(GroupInts(column->GetIntArray(), start, count, nulls), 0, count);
					out->PutInts(GroupBits(column->GetGmtBits(), start, count, nulls), 0, words);
				}

				label ColumnType->FLOAT: {
					values := Float->New[count];
					Float->Copy(values, 0, column->GetFloatArray(), start, count);
					each(i : count) {
						if(IsSet(nulls, i)) {
							values[i] := 0.0;
						};
					};
					out->PutFloats(values, 0, count);
				}

				label ColumnType->STRING: {
					if(column->IsEncoded()) {
						# the block's own dictionary: just the texts its cells use, in order of first
						# use. The column's dictionary can hold texts no live row uses any more, and
						# a block should neither carry them nor repeat every other group's texts.
						dict := column->GetDictionary();
						codes := GroupInts(column->GetIntArray(), start, count, nulls);
						remap := Int->New[column->GetDictionarySize()];
						Int->Fill(remap, -1);
						used := Vector->New()<String>;
						each(i : count) {
							if(<>IsSet(nulls, i)) {
								code := codes[i];
								if(remap[code] < 0) {
									remap[code] := used->Size();
									used->AddBack(dict[code]);
								};
								codes[i] := remap[code];
							};
						};

						out->PutInt(1);
						out->PutInt(used->Size());
						each(i : used) {
							out->PutText(used->Get(i));
						};
						out->PutInts(codes, 0, count);
					}
					else {
						out->PutInt(0);
						strings := column->GetStringArray();
						for(i := start; i < start + count; i += 1;) {
							text : String;
							if(<>column->IsNull(i)) {
								text := strings[i];
							};
							out->PutText(text);
						};
					};
				}

				label ColumnType->OBJECT: {
					objects := column->GetObjectArray();
					for(i := start; i < start + count; i += 1;) {
						value : Compare;
						if(<>column->IsNull(i)) {
							value := objects[i];
						};
						if(<>WriteValue(out, value)) {
							error->Set("column '{$(column->GetName())}' holds a value that is not an Int, Float, String, Date or Bool, which an .otab file cannot store");
							return Nil;
						};
					};
				}
			};

			return out->ToByteArray();
		}

		# a group's words of a column bitmap, without the bits past its last row, and without
		# the bits of empty cells when 'nulls' is given
		function : GroupBits(bits : Int[], start : Int, count : Int, nulls : Int[]) ~ Int[] {
			words := (count + 63) / 64;
			group := Int->New[words];
			if(bits <> Nil & words > 0) {
				Int->Copy(group, 0, bits, start / 64, words);
				if(count % 64 <> 0) {
					group[words - 1] := group[words - 1] and ((1 << (count % 64)) - 1);
				};
				if(nulls <> Nil) {
					each(w : words) {
						group[w] := group[w] and (nulls[w] xor -1);
					};
				};
			};
			return group;
		}

		# a group's Int values, 0 in each empty cell
		function : GroupInts(values : Int[], start : Int, count : Int, nulls : Int[]) ~ Int[] {
			group := Int->New[count];
			Int->Copy(group, 0, values, start, count);
			each(i : count) {
				if(IsSet(nulls, i)) {
					group[i] := 0;
				};
			};
			return group;
		}

		function : IsSet(bits : Int[], i : Int) ~ Bool {
			return (bits[i >> 6] and (1 << (i and 63))) <> 0;
		}

		# one OBJECT cell, tagged by its kind; false for a kind the format cannot hold
		function : WriteValue(out : OtabWriter, value : Compare) ~ Bool {
			if(value = Nil) {
				out->PutInt(OtabCodes->Empty());
			}
			else if(value->TypeOf(IntRef)) {
				out->PutInt(OtabCodes->Whole());
				out->PutInt(value->As(IntRef)->Get());
			}
			else if(value->TypeOf(FloatRef)) {
				out->PutInt(OtabCodes->Number());
				out->PutFloat(value->As(FloatRef)->Get());
			}
			else if(value->TypeOf(String)) {
				out->PutInt(OtabCodes->Text());
				out->PutText(value->As(String));
			}
			else if(value->TypeOf(Date)) {
				date := value->As(Date);
				out->PutInt(OtabCodes->When());
				out->PutInt(DateCodec->ToMillis(date));
				out->PutInt(date->IsGmt() ? 1 : 0);
			}
			else if(value->TypeOf(BoolRef)) {
				out->PutInt(OtabCodes->Flag());
				out->PutInt(value->As(BoolRef)->Get() ? 1 : 0);
			}
			else {
				return false;
			};

			return true;
		}

		function : ReadValue(input : OtabReader) ~ Compare {
			tag := input->GetInt();
			if(tag = OtabCodes->Whole()) {
				return IntRef->New(input->GetInt());
			}
			else if(tag = OtabCodes->Number()) {
				return FloatRef->New(input->GetFloat());
			}
			else if(tag = OtabCodes->Text()) {
				return input->GetText();
			}
			else if(tag = OtabCodes->When()) {
				millis := input->GetInt();
				gmt := input->GetInt() = 1;
				return DateCodec->ToDate(millis, gmt);
			}
			else if(tag = OtabCodes->Flag()) {
				return BoolRef->New(input->GetInt() = 1);
			};

			return Nil;
		}

		# a block's rows added to a column being rebuilt; false if the bytes are malformed
		function : Decode(bytes : Byte[], type : ColumnType, count : Int, parts : OtabParts) ~ Bool {
			input := OtabReader->New(bytes);
			words := input->GetInt();
			if(words <> (count + 63) / 64) {
				return false;
			};
			nulls := input->GetInts(words);

			select(type) {
				label ColumnType->INT:
				label ColumnType->BOOL: {
					parts->AddInts(input->GetInts(count), nulls, Nil, count);
				}

				label ColumnType->DATE: {
					values := input->GetInts(count);
					gmt := input->GetInts(words);
					parts->AddInts(values, nulls, gmt, count);
				}

				label ColumnType->FLOAT: {
					parts->AddFloats(input->GetFloats(count), nulls, count);
				}

				label ColumnType->STRING: {
					if(input->GetInt() = 1) {
						size := input->GetInt();
						if(size < 0 | size > bytes->Size()) {
							return false;
						};
						dict := String->New[size];
						each(i : size) {
							dict[i] := input->GetText();
						};
						parts->AddCodes(dict, input->GetInts(count), nulls, count);
					}
					else {
						texts := String->New[count];
						each(i : count) {
							texts[i] := input->GetText();
						};
						parts->AddTexts(texts, nulls, count);
					};
				}

				label ColumnType->OBJECT: {
					values := Compare->New[count];
					each(i : count) {
						values[i] := ReadValue(input);
					};
					parts->AddObjects(values, nulls, count);
				}

				other: {
					parts->AddEmpty(nulls, count);
				}
			};

			return <>input->IsBad() & input->AtEnd();
		}
	}

	# an Int[] or Float[] held in a Vector
	class : private : IntArrayRef {
		@values : Int[];

		New(values : Int[]) {
			@values := values;
		}

		method : public : Get() ~ Int[] {
			return @values;
		}
	}

	class : private : FloatArrayRef {
		@values : Float[];

		New(values : Float[]) {
			@values := values;
		}

		method : public : Get() ~ Float[] {
			return @values;
		}
	}

	# a column rebuilt from its blocks in several row groups
	class : private : OtabParts {
		@type : ColumnType;
		@size : Int;
		@ints : Vector<IntArrayRef>;
		@floats : Vector<FloatArrayRef>;
		@nulls : Vector<IntArrayRef>;
		@gmt : Vector<IntArrayRef>;
		@counts : Vector<IntRef>;
		@objects : Vector<Compare>;
		@texts : Vector<String>;
		@codes : Vector<IntRef>;
		@dict : Vector<String>;
		@dict_index : Hash<String, IntRef>;
		@encoded : Bool;
		@plain : Bool;

		New(type : ColumnType) {
			@type := type;
			@ints := Vector->New()<IntArrayRef>;
			@floats := Vector->New()<FloatArrayRef>;
			@nulls := Vector->New()<IntArrayRef>;
			@gmt := Vector->New()<IntArrayRef>;
			@counts := Vector->New()<IntRef>;
			@objects := Vector->New()<Compare>;
			@texts := Vector->New()<String>;
			@codes := Vector->New()<IntRef>;
			@dict := Vector->New()<String>;
			@dict_index := Hash->New()<String, IntRef>;
		}

		method : Note(nulls : Int[], count : Int) ~ Nil {
			@nulls->AddBack(IntArrayRef->New(nulls));
			@counts->AddBack(IntRef->New(count));
			@size += count;
		}

		method : public : AddEmpty(nulls : Int[], count : Int) ~ Nil {
			Note(nulls, count);
		}

		method : public : AddInts(values : Int[], nulls : Int[], gmt : Int[], count : Int) ~ Nil {
			@ints->AddBack(IntArrayRef->New(values));
			if(gmt <> Nil) {
				@gmt->AddBack(IntArrayRef->New(gmt));
			};
			Note(nulls, count);
		}

		method : public : AddFloats(values : Float[], nulls : Int[], count : Int) ~ Nil {
			@floats->AddBack(FloatArrayRef->New(values));
			Note(nulls, count);
		}

		# codes against a block's own dictionary, mapped onto one dictionary for the column
		method : public : AddCodes(dict : String[], codes : Int[], nulls : Int[], count : Int) ~ Nil {
			@encoded := true;
			map := Int->New[dict->Size()];
			each(i : dict) {
				known := @dict_index->Find(dict[i]);
				if(known = Nil) {
					known := IntRef->New(@dict->Size());
					@dict_index->Insert(dict[i], known);
					@dict->AddBack(dict[i]);
				};
				map[i] := known->Get();
			};

			each(i : count) {
				code := 0;
				if((nulls[i >> 6] and (1 << (i and 63))) = 0 & codes[i] >= 0 & codes[i] < map->Size()) {
					code := map[codes[i]];
				};
				@codes->AddBack(IntRef->New(code));
				@texts->AddBack(Nil);
			};
			Note(nulls, count);
		}

		method : public : AddTexts(texts : String[], nulls : Int[], count : Int) ~ Nil {
			@plain := true;
			each(i : count) {
				@texts->AddBack(texts[i]);
				@codes->AddBack(IntRef->New(-1));
			};
			Note(nulls, count);
		}

		method : public : AddObjects(values : Compare[], nulls : Int[], count : Int) ~ Nil {
			each(i : count) {
				@objects->AddBack(values[i]);
			};
			Note(nulls, count);
		}

		# the rebuilt column
		method : public : Build(name : String, declared : Bool) ~ Column {
			n := @size;
			words := (n + 63) / 64 + 1;
			nulls := Int->New[words];
			gmt := Int->New[words];
			null_count := 0;

			# the null and GMT bits, group after group
			row := 0;
			each(g : @counts) {
				count := @counts->Get(g)->Get();
				group_nulls := @nulls->Get(g)->Get();
				group_gmt : Int[];
				if(g < @gmt->Size()) {
					group_gmt := @gmt->Get(g)->Get();
				};
				each(i : count) {
					r := row + i;
					if((group_nulls[i >> 6] and (1 << (i and 63))) <> 0) {
						nulls[r >> 6] := nulls[r >> 6] or (1 << (r and 63));
						null_count += 1;
					};
					if(group_gmt <> Nil) {
						if((group_gmt[i >> 6] and (1 << (i and 63))) <> 0) {
							gmt[r >> 6] := gmt[r >> 6] or (1 << (r and 63));
						};
					};
				};
				row += count;
			};

			ints : Int[];
			floats : Float[];
			strings : String[];
			objects : Compare[];
			dict : String[];
			encoded := false;

			select(@type) {
				label ColumnType->INT:
				label ColumnType->BOOL:
				label ColumnType->DATE: {
					ints := Int->New[n];
					offset := 0;
					each(g : @ints) {
						part := @ints->Get(g)->Get();
						Int->Copy(ints, offset, part, 0, part->Size());
						offset += part->Size();
					};
				}

				label ColumnType->FLOAT: {
					floats := Float->New[n];
					offset := 0;
					each(g : @floats) {
						part := @floats->Get(g)->Get();
						Float->Copy(floats, offset, part, 0, part->Size());
						offset += part->Size();
					};
				}

				label ColumnType->STRING: {
					if(@encoded & <>@plain) {
						encoded := true;
						ints := Int->New[n];
						each(i : n) {
							ints[i] := @codes->Get(i)->Get();
						};
						dict := String->New[@dict->Size()];
						each(i : dict) {
							dict[i] := @dict->Get(i);
						};
					}
					else {
						# groups written plain, or a mix of both: every cell as its text
						strings := String->New[n];
						each(i : n) {
							text := @texts->Get(i);
							code := @codes->Get(i)->Get();
							if(text = Nil & code > -1 & (nulls[i >> 6] and (1 << (i and 63))) = 0) {
								text := @dict->Get(code);
							};
							strings[i] := text;
						};
					};
				}

				label ColumnType->OBJECT: {
					objects := Compare->New[n];
					each(i : n) {
						objects[i] := @objects->Get(i);
					};
				}
			};

			column := Column->New(name, ColumnType->NONE, false);
			column->Restore(@type, declared, n, ints, floats, strings, objects, nulls, null_count, gmt, encoded, dict);
			return column;
		}
	}

	# An index definition as a version 2 footer stores it (docs/OTAB_FORMAT.md, "Indexes"): its
	# name, the column's position (1 or more; 0 is the key column) and its kind, 1 for HASH and
	# 2 for SORTED. Only the definition is stored; the entries are rebuilt from the column.
	class : private : OtabIndex {
		@name : String;
		@column : Int;
		@kind : Int;

		New(name : String, column : Int, kind : Int) {
			@name := name;
			@column := column;
			@kind := kind;
		}

		method : public : GetName() ~ String { return @name; }
		method : public : GetColumn() ~ Int { return @column; }
		method : public : GetKind() ~ Int { return @kind; }

		function : CodeOf(kind : IndexKind) ~ Int {
			return kind = IndexKind->HASH ? 1 : 2;
		}

		method : public : GetIndexKind() ~ IndexKind {
			return @kind = 1 ? IndexKind->HASH : IndexKind->SORTED;
		}

		method : public : Write(out : OtabWriter) ~ Nil {
			out->PutText(@name);
			out->PutInt(@column);
			out->PutInt(@kind);
		}

		# the index definitions of a table's columns, in column order
		function : Of(table : Table) ~ Vector<OtabIndex> {
			found := Vector->New()<OtabIndex>;
			for(c := 1; c < table->GetColumnCount(); c += 1;) {
				column := table->GetColumn(c);
				if(column->GetIndexKind() <> IndexKind->NONE) {
					found->AddBack(OtabIndex->New(column->GetIndexName(), c, CodeOf(column->GetIndexKind())));
				};
			};
			return found;
		}

		# A footer's index list; Nil with the error set if it is malformed. Every name is
		# text, no two are the same, every column is a data column holding at most one
		# index, and every kind is known: a version 2 reader meets no other kind.
		function : ReadAll(input : OtabReader, columns : Int, error : StringHolder) ~ OtabIndex[] {
			count := input->GetInt();
			if(input->IsBad() | count < 0 | count >= columns) {
				error->Set("the footer's index list is malformed");
				return Nil;
			};

			indexes := OtabIndex->New[count];
			each(i : count) {
				name := input->GetText();
				column := input->GetInt();
				kind := input->GetInt();
				if(input->IsBad() | name = Nil) {
					error->Set("the footer's index list is malformed");
					return Nil;
				};

				if(name->Size() = 0) {
					error->Set("the footer's index {$(i + 1)} has no name");
					return Nil;
				};

				if(column < 1 | column >= columns) {
					error->Set("the footer's index '{$name}' names column {$column}, which the file does not have");
					return Nil;
				};

				if(kind <> 1 & kind <> 2) {
					error->Set("the footer's index '{$name}' has kind {$kind}, which this library does not know");
					return Nil;
				};

				each(j : i) {
					if(indexes[j]->GetName()->Equals(name)) {
						error->Set("the footer names two indexes '{$name}'");
						return Nil;
					};
					if(indexes[j]->GetColumn() = column) {
						error->Set("the footer gives column {$column} two indexes");
						return Nil;
					};
				};

				indexes[i] := OtabIndex->New(name, column, kind);
			};

			return indexes;
		}
	}

	# where a block is and how it was stored
	class : private : OtabBlockInfo {
		@offset : Int;
		@stored : Int;
		@raw : Int;
		@codec : Int;
		@crc : Int;
		@null_count : Int;
		@has_zone : Bool;
		@low : Float;
		@high : Float;

		New(offset : Int, stored : Int, raw : Int, codec : Int, crc : Int, null_count : Int, has_zone : Bool, low : Float, high : Float) {
			@offset := offset;
			@stored := stored;
			@raw := raw;
			@codec := codec;
			@crc := crc;
			@null_count := null_count;
			@has_zone := has_zone;
			@low := low;
			@high := high;
		}

		method : public : GetOffset() ~ Int { return @offset; }
		method : public : GetStored() ~ Int { return @stored; }
		method : public : GetRaw() ~ Int { return @raw; }
		method : public : GetCodec() ~ Int { return @codec; }
		method : public : GetCrc() ~ Int { return @crc; }

		method : public : Write(out : OtabWriter) ~ Nil {
			out->PutInt(@offset);
			out->PutInt(@stored);
			out->PutInt(@raw);
			out->PutInt(@codec);
			out->PutInt(@crc);
			out->PutInt(@null_count);
			out->PutInt(@has_zone ? 1 : 0);
			out->PutFloat(@low);
			out->PutFloat(@high);
		}

		function : Read(input : OtabReader) ~ OtabBlockInfo {
			offset := input->GetInt();
			stored := input->GetInt();
			raw := input->GetInt();
			codec := input->GetInt();
			crc := input->GetInt();
			null_count := input->GetInt();
			has_zone := input->GetInt() = 1;
			low := input->GetFloat();
			high := input->GetFloat();
			return OtabBlockInfo->New(offset, stored, raw, codec, crc, null_count, has_zone, low, high);
		}
	}

	# writing .otab images
	class : private : Otab {
		# the newest format this library reads and writes: 2 adds index definitions
		function : Version() ~ Int {
			return 2;
		}

		# the format a footer with these index definitions needs: 1 without any, so a table
		# without indexes stays readable by libraries that know only version 1
		function : VersionFor(indexes : Vector<OtabIndex>) ~ Int {
			return indexes <> Nil & indexes->Size() > 0 ? 2 : 1;
		}

		function : HeaderSize() ~ Int {
			return 12;
		}

		function : TrailerSize() ~ Int {
			return 28;
		}

		function : CodecOf(compression : Compression) ~ Int {
			select(compression) {
				label Compression->FAST: { return 1; }
				label Compression->SMALL: { return 2; }
			};

			return 0;
		}

		# a block compressed with a codec, or as it is when that would not shrink it
		function : Pack(raw : Byte[], codec : Int, chosen : IntRef) ~ Byte[] {
			chosen->Set(0);
			if(codec = 0 | raw->Size() < 64) {
				return raw;
			};

			level := codec = 1 ? 1 : 9;
			packed := Byte->CompressZlib(raw, level);
			if(packed = Nil | packed->Size() >= raw->Size()) {
				return raw;
			};

			chosen->Set(codec);
			return packed;
		}

		# a stored block as it was before compression; Nil if it cannot be
		function : Unpack(stored : Byte[], codec : Int) ~ Byte[] {
			if(codec = 0) {
				return stored;
			};

			raw : Byte[];
			try {
				raw := stored->UncompressZlib();
			}
			on(e : Error) {
				return Nil;
			};

			return raw;
		}

		# a table's live rows, with their keys, as a table with no deleted rows
		function : Live(table : Table) ~ Table {
			if(table->Size() = table->GetRowCapacity()) {
				return table;
			};

			rows := table->LiveRows();
			copy := Table->Gather(table->GetName(), table, DataColumns(table), DataNames(table), rows);
			copy->KeepKeys(table, rows);
			return copy;
		}

		function : DataColumns(table : Table) ~ Int[] {
			columns := Int->New[table->GetColumnCount() - 1];
			each(i : columns) {
				columns[i] := i + 1;
			};
			return columns;
		}

		function : DataNames(table : Table) ~ String[] {
			all := table->GetColumnNames();
			names := String->New[all->Size() - 1];
			each(i : names) {
				names[i] := all[i + 1];
			};
			return names;
		}

		# a table's rows as row groups of blocks written to 'out'; false with the error set
		function : WriteGroups(out : OtabWriter, table : Table, codec : Int, counts : Vector<IntRef>,
				blocks : Vector<OtabBlockInfo>, error : StringHolder) ~ Bool {
			rows := table->GetRowCapacity();
			columns := table->GetColumnCount();
			group_rows := Column->GroupRows();
			groups := (rows + group_rows - 1) / group_rows;
			each(g : groups) {
				start := g * group_rows;
				count := rows - start < group_rows ? rows - start : group_rows;
				counts->AddBack(IntRef->New(count));
				each(c : columns) {
					column := table->GetColumn(c);
					raw := OtabBlock->Encode(column, start, count, error);
					if(raw = Nil) {
						return false;
					};

					chosen := IntRef->New(0);
					stored := Pack(raw, codec, chosen);
					has_zone := column->HasZones() & column->GroupHasValues(g);
					low := 0.0;
					high := 0.0;
					if(has_zone) {
						low := column->GetGroupMin(g);
						high := column->GetGroupMax(g);
					};
					nulls := 0;
					for(i := start; i < start + count; i += 1;) {
						if(column->IsNull(i)) {
							nulls += 1;
						};
					};
					blocks->AddBack(OtabBlockInfo->New(out->Size(), stored->Size(), raw->Size(), chosen->Get(), stored->CRC32(), nulls, has_zone, low, high));
					out->PutBytes(stored);
				};
			};

			return true;
		}

		# the footer and trailer after the blocks; the index list is written only in a version
		# 2 file, whose header said so
		function : WriteFooter(out : OtabWriter, name : String, next_key : Int, names : String[], types : ColumnType[],
				declared : Bool[], counts : Vector<IntRef>, blocks : Vector<OtabBlockInfo>, version : Int,
				indexes : Vector<OtabIndex>) ~ Nil {
			footer := OtabWriter->New();
			footer->PutText(name);
			footer->PutInt(next_key);
			columns := names->Size();
			footer->PutInt(columns);
			each(c : columns) {
				footer->PutText(names[c]);
				footer->PutInt(OtabCodes->FromType(types[c]));
				footer->PutInt(declared[c] ? 1 : 0);
			};

			footer->PutInt(counts->Size());
			each(g : counts) {
				footer->PutInt(counts->Get(g)->Get());
				each(c : columns) {
					blocks->Get(g * columns + c)->Write(footer);
				};
			};

			if(version >= 2) {
				count := indexes = Nil ? 0 : indexes->Size();
				footer->PutInt(count);
				each(i : count) {
					indexes->Get(i)->Write(footer);
				};
			};

			bytes := footer->ToByteArray();
			footer_offset := out->Size();
			out->PutBytes(bytes);
			out->PutInt(footer_offset);
			out->PutInt(bytes->Size());
			out->PutInt(bytes->CRC32());
			out->Magic();
		}

		# a table's live rows as an .otab image, with its index definitions when 'indexes' is
		# true; Nil with the error set
		function : Write(table : Table, compression : Compression, indexes : Bool, error : StringHolder) ~ Byte[] {
			# the definitions from the table itself: Live's copy has none
			definitions := indexes ? OtabIndex->Of(table) : Nil;
			version := VersionFor(definitions);
			source := Live(table);
			out := OtabWriter->New();
			out->Magic();
			out->PutInt(version);

			counts := Vector->New()<IntRef>;
			blocks := Vector->New()<OtabBlockInfo>;
			if(<>WriteGroups(out, source, CodecOf(compression), counts, blocks, error)) {
				return Nil;
			};

			columns := source->GetColumnCount();
			names := String->New[columns];
			types := ColumnType->New[columns];
			declared := Bool->New[columns];
			each(c : columns) {
				column := source->GetColumn(c);
				names[c] := column->GetName();
				types[c] := column->GetType();
				declared[c] := column->IsDeclared();
			};

			WriteFooter(out, source->GetName(), source->GetNextKey(), names, types, declared, counts, blocks, version, definitions);
			return out->ToByteArray();
		}

		# a file's bytes rewritten whole to a temporary name, then renamed over it, so a reader
		# sees the old file or the new one and never part of either
		function : Commit(path : String, bytes : Byte[], error : StringHolder) ~ Bool {
			temp := "{$path}.part";
			if(<>FileWriter->WriteFile(temp, bytes)) {
				error->Set("cannot write '{$temp}'");
				return false;
			};

			if(<>File->Rename(temp, path)) {
				File->Delete(temp);
				error->Set("cannot replace '{$path}'");
				return false;
			};

			return true;
		}
	}

	# A durable table's change log, 'path.log' beside its .otab file (docs/OTAB_FORMAT.md,
	# "The change log"). It begins with a header naming the save it follows -- that file's
	# footer CRC32 and size -- so a log left behind by a checkpoint that saved but did not get
	# to empty the log is recognized as already saved, not replayed twice. Each statement is
	# one record: its length, the length again with every bit inverted, a CRC32 of the payload,
	# and the payload, the statement's changes in order. A crash mid-write can only cut the file
	# short, so it leaves a last record that ends early, which opening drops; a statement is
	# never half replayed. Two lengths that disagree are damage, not a crash, and are refused:
	# with one length, a damaged one past the end would read as a torn tail and silently drop
	# every record after it.
	class : private : OtabLog {
		@path : String;
		@writer : FileWriter;
		@ops : OtabWriter;
		@op_count : Int;
		@depth : Int;
		@error : String;

		function : Version() ~ Int { return 1; }
		function : HeaderSize() ~ Int { return 28; }
		function : InsertOp() ~ Int { return 1; }
		function : SetOp() ~ Int { return 2; }
		function : DeleteOp() ~ Int { return 3; }
		function : AddColumnOp() ~ Int { return 4; }

		New(path : String) {
			@path := path;
			@ops := OtabWriter->New();
		}

		method : public : GetError() ~ String {
			return @error;
		}

		function : Header(base_crc : Int, base_size : Int) ~ Byte[] {
			out := OtabWriter->New();
			out->PutBytes("OLOG"->ToByteArray());
			out->PutInt(Version());
			out->PutInt(base_crc);
			out->PutInt(base_size);
			return out->ToByteArray();
		}

		# a fresh, empty log for the save named by base_crc and base_size, written to a
		# temporary name and renamed into place
		function : Create(path : String, base_crc : Int, base_size : Int, error : StringHolder) ~ Bool {
			return Otab->Commit(path, Header(base_crc, base_size), error);
		}

		method : public : Start() ~ Bool {
			@writer := FileWriter->New(@path, true);
			if(<>@writer->IsOpen()) {
				@error := "cannot write the change log '{$@path}'";
				return false;
			};
			return true;
		}

		method : public : Stop() ~ Nil {
			if(@writer <> Nil) {
				@writer->Close();
				@writer := Nil;
			};
		}

		# a statement: changes between Begin and the matching End are one record
		method : public : Begin() ~ Nil {
			@depth += 1;
		}

		# whether a statement's changes are being gathered
		method : public : InStatement() ~ Bool {
			return @depth > 0;
		}

		method : public : End() ~ Bool {
			@depth -= 1;
			if(@depth > 0 | @op_count = 0) {
				return true;
			};
			return Flush();
		}

		method : public : Insert(key : Int) ~ Bool {
			@ops->PutInt(InsertOp());
			@ops->PutInt(key);
			return Added();
		}

		method : public : Set(key : Int, column : Int, value : Compare) ~ Bool {
			@ops->PutInt(SetOp());
			@ops->PutInt(key);
			@ops->PutInt(column);
			OtabBlock->WriteValue(@ops, value);
			return Added();
		}

		method : public : Delete(key : Int) ~ Bool {
			@ops->PutInt(DeleteOp());
			@ops->PutInt(key);
			return Added();
		}

		method : public : AddColumn(name : String, type : ColumnType) ~ Bool {
			@ops->PutInt(AddColumnOp());
			@ops->PutText(name);
			@ops->PutInt(OtabCodes->FromType(type));
			return Added();
		}

		# a change outside any statement is a statement of its own
		method : Added() ~ Bool {
			@op_count += 1;
			if(@depth > 0) {
				return true;
			};
			return Flush();
		}

		# one record, written and flushed to the operating system in one piece
		method : Flush() ~ Bool {
			payload := OtabWriter->New();
			payload->PutInt(@op_count);
			payload->PutBytes(@ops->ToByteArray());
			bytes := payload->ToByteArray();
			@ops := OtabWriter->New();
			@op_count := 0;

			framed := OtabWriter->New();
			framed->PutInt(bytes->Size());
			framed->PutInt(bytes->Size() xor -1);
			framed->PutInt(bytes->CRC32());
			framed->PutBytes(bytes);
			image := framed->ToByteArray();
			if(@writer = Nil | @writer->WriteBuffer(image) <> image->Size()) {
				@error := "cannot write to the change log '{$@path}'";
				return false;
			};
			@writer->Flush();
			return true;
		}

		# Replays a log over a table loaded from the save named by base_crc and base_size.
		# Returns the statements applied, 0 for no log or one for an earlier save (stale is
		# set), or -1 with the error set. A torn last record is cut off the file.
		function : Replay(path : String, table : Table, base_crc : Int, base_size : Int, stale : BoolRef, error : StringHolder) ~ Int {
			stale->Set(false);
			if(<>File->Exists(path)) {
				stale->Set(true);
				return 0;
			};

			bytes := FileReader->ReadBinaryFile(path);
			if(bytes = Nil) {
				error->Set("cannot read the change log '{$path}'");
				return -1;
			};

			if(bytes->Size() < HeaderSize()) {
				# a log cut off before its header was whole holds no statements
				stale->Set(true);
				return 0;
			};

			magic := Byte->New[4];
			Byte->Copy(magic, 0, bytes, 0, 4);
			if(<>magic->ToString()->Equals("OLOG")) {
				error->Set("'{$path}' is not a change log");
				return -1;
			};

			input := OtabReader->New(bytes);
			input->Skip(4);
			version := input->GetInt();
			if(version < 1 | version > Version()) {
				error->Set("a change log of format {$version}; this library reads format {$(Version())}");
				return -1;
			};

			if(input->GetInt() <> base_crc | input->GetInt() <> base_size) {
				# written for an earlier save, whose changes the current file already holds
				stale->Set(true);
				return 0;
			};

			applied := 0;
			good := HeaderSize();
			pos := good;
			while(pos < bytes->Size()) {
				if(bytes->Size() - pos < 24) {
					return Truncate(path, bytes, good, applied, error);
				};

				head := OtabReader->New(bytes);
				head->Skip(pos);
				size := head->GetInt();
				check := head->GetInt();
				crc := head->GetInt();
				if(size < 0 | check <> (size xor -1)) {
					error->Set("the change log '{$path}' is damaged at byte {$pos}");
					return -1;
				};

				if(size > bytes->Size() - pos - 24) {
					return Truncate(path, bytes, good, applied, error);
				};

				payload := Byte->New[size];
				Byte->Copy(payload, 0, bytes, pos + 24, size);
				if(payload->CRC32() <> crc) {
					if(pos + 24 + size = bytes->Size()) {
						# the last record, torn by a crash while it was written
						return Truncate(path, bytes, good, applied, error);
					};
					error->Set("the change log '{$path}' is damaged at byte {$pos}");
					return -1;
				};

				if(<>Apply(payload, table, error)) {
					error->Set("the change log '{$path}', record at byte {$pos}: {$(error->Get())}");
					return -1;
				};

				applied += 1;
				pos += 24 + size;
				good := pos;
			};

			return applied;
		}

		# keeps the log's whole records and drops a torn tail
		function : Truncate(path : String, bytes : Byte[], good : Int, applied : Int, error : StringHolder) ~ Int {
			kept := Byte->New[good];
			Byte->Copy(kept, 0, bytes, 0, good);
			if(<>Otab->Commit(path, kept, error)) {
				return -1;
			};
			return applied;
		}

		# one statement's changes, applied to a table with no log attached
		function : Apply(payload : Byte[], table : Table, error : StringHolder) ~ Bool {
			input := OtabReader->New(payload);
			count := input->GetInt();
			each(i : count) {
				op := input->GetInt();
				if(op = InsertOp()) {
					key := input->GetInt();
					row := table->Insert();
					if(row->GetKey() <> key) {
						error->Set("an insert logged as key {$key} replays as key {$(row->GetKey())}");
						return false;
					};
				}
				else if(op = SetOp()) {
					key := input->GetInt();
					column := input->GetInt();
					value := OtabBlock->ReadValue(input);
					row := table->FindRow(key);
					if(row < 0 | column < 1 | column >= table->GetColumnCount()) {
						error->Set("a change to key {$key}, column {$column}, which the table does not have");
						return false;
					};
					if(<>table->GetColumn(column)->Set(row, value)) {
						error->Set("a change to key {$key} that the column refuses");
						return false;
					};
				}
				else if(op = DeleteOp()) {
					key := input->GetInt();
					if(<>table->Delete(key)) {
						error->Set("a delete of key {$key}, which the table does not have");
						return false;
					};
				}
				else if(op = AddColumnOp()) {
					name := input->GetText();
					known := BoolRef->New(false);
					type := OtabCodes->ToType(input->GetInt(), known);
					if(name = Nil | <>known->Get() | <>table->AddColumn(name, type)) {
						error->Set("a column the table cannot add");
						return false;
					};
				}
				else {
					error->Set("an unknown change, kind {$op}");
					return false;
				};

				if(input->IsBad()) {
					error->Set("a record that ends early");
					return false;
				};
			};

			if(<>input->AtEnd()) {
				error->Set("a record with bytes left over");
				return false;
			};
			return true;
		}
	}

	#~
	A table kept durable on disk: its .otab file, plus a change log beside it ('path.log')
	that records every insert, change, delete and added column as it happens, one record per
	statement, flushed before the statement returns. Opening loads the last save and replays
	the log, so a crash loses at most the statement in progress. Checkpoint folds the log
	into a new save and empties it.

	One process writes at a time: opening takes a lock file ('path.lock') naming this process.
	A second writer is refused with an error naming the holder, and a lock whose process is
	gone (a crash) is cleared. Readers open the file with Table->Load and see the last save or
	checkpoint. Create the file with Save first, then open it here.

```
store := TableStore->New("runs.otab");
if(store->IsOpen()) {
  runs := store->GetTable();
  row := runs->Insert();
  row->Set("score", FloatRef->New(0.93));
  store->Checkpoint();
  store->Close();
}
else {
  store->GetError()->ErrorLine();
};
```
	~#
	class TableStore {
		@path : String;
		@log_path : String;
		@lock_path : String;
		@table : Table;
		@log : OtabLog;
		@open : Bool;
		@error : String;
		@replayed : Int;
		@compression : Compression;
		@index_pending : Bool;

		#~
		Opens a table file for writing: takes its lock, loads the last save and replays the
		change log
		@param path .otab file, created earlier with Save
		~#
		New(path : String) {
			@path := path;
			@log_path := "{$path}.log";
			@lock_path := "{$path}.lock";
			@open := Open();
		}

		#~
		Whether the table is open for writing
		@return true if open
		~#
		method : public : IsOpen() ~ Bool {
			return @open;
		}

		#~
		Why opening, a checkpoint or a change failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Gets the table. Its changes are recorded until Close.
		@return table, Nil if not open
		~#
		method : public : GetTable() ~ Table {
			return @open ? @table : Nil;
		}

		#~
		Gets the number of statements replayed from the change log when the table was opened
		@return statements replayed
		~#
		method : public : GetReplayed() ~ Int {
			return @replayed;
		}

		method : Open() ~ Bool {
			if(@path = Nil | <>File->Exists(@path)) {
				@error := "no file '{$@path}'; create it with Save first";
				return false;
			};

			if(<>Lock()) {
				return false;
			};

			file := OtabFile->New(@path);
			table := file->IsOpen() ? file->Read() : Nil;
			if(table = Nil) {
				@error := "'{$@path}': {$(file->GetError())}";
				Unlock();
				return false;
			};

			holder := StringHolder->New();
			stale := BoolRef->New(false);
			@replayed := OtabLog->Replay(@log_path, table, file->GetFooterCrc(), file->GetFileSize(), stale, holder);
			if(@replayed < 0) {
				@error := holder->Get();
				Unlock();
				return false;
			};

			if(stale->Get() & <>OtabLog->Create(@log_path, file->GetFooterCrc(), file->GetFileSize(), holder)) {
				@error := holder->Get();
				Unlock();
				return false;
			};

			@log := OtabLog->New(@log_path);
			if(<>@log->Start()) {
				@error := @log->GetError();
				Unlock();
				return false;
			};

			# a checkpoint the table makes by itself (for an index change) compresses as the
			# file it replaces was compressed
			@compression := Compression->NONE;
			blocks := file->GetBlocks();
			each(b : blocks) {
				codec := blocks[b]->GetCodec();
				if(codec = 2) {
					@compression := Compression->SMALL;
				}
				else if(codec = 1 & @compression = Compression->NONE) {
					@compression := Compression->FAST;
				};
			};

			@table := table;
			@table->SetStore(@self);
			return true;
		}

		#~
		Folds the change log into a new save of the table and empties the log
		@return true if saved, false on error (see GetError)
		~#
		method : public : Checkpoint() ~ Bool {
			return Checkpoint(Compression->NONE);
		}

		#~
		Folds the change log into a new save, compressing its blocks, and empties the log
		@param compression NONE, FAST or SMALL
		@return true if saved, false on error (see GetError)
		~#
		method : public : Checkpoint(compression : Compression) ~ Bool {
			if(<>@open) {
				@error := "the table is not open";
				return false;
			};
			@compression := compression;
			@index_pending := false;

			# the save first: a crash before the new log is in place leaves a log whose header
			# names the old save, which opening then knows to skip
			if(<>@table->WriteFile(@path, compression)) {
				@error := @table->GetError();
				return false;
			};

			file := OtabFile->New(@path);
			if(<>file->IsOpen()) {
				@error := "'{$@path}': {$(file->GetError())}";
				return false;
			};

			@log->Stop();
			holder := StringHolder->New();
			if(<>OtabLog->Create(@log_path, file->GetFooterCrc(), file->GetFileSize(), holder)) {
				@error := holder->Get();
				return false;
			};

			@log := OtabLog->New(@log_path);
			if(<>@log->Start()) {
				@error := @log->GetError();
				return false;
			};

			return true;
		}

		#~
		Stops recording and releases the lock. The changes since the last checkpoint stay in
		the log, for the next open to replay. The table stays usable in memory.
		~#
		method : public : Close() ~ Nil {
			if(@open) {
				@log->Stop();
				@table->SetStore(Nil);
				Unlock();
				@open := false;
			};
		}

		# the file this store keeps, for Table->Save and Append to recognize
		method : public : GetPath() ~ String {
			return @path;
		}

		# Changes, called by the table. A failure to write closes nothing but is reported:
		# the change is in memory and not on disk.
		method : public : Begin() ~ Nil {
			@log->Begin();
		}

		method : public : End() ~ Bool {
			if(<>Logged(@log->End())) {
				return false;
			};

			# an index created or dropped by the statement: saved now that it is whole
			if(@index_pending & <>@log->InStatement()) {
				return Checkpoint(@compression);
			};
			return true;
		}

		# An index was created or dropped. The file holds index definitions and the log does
		# not, so it is saved by a checkpoint: now, or at the end of the statement making it,
		# since a checkpoint replaces the log the statement is writing to.
		method : public : IndexesChanged() ~ Bool {
			if(@log->InStatement()) {
				@index_pending := true;
				return true;
			};
			return Checkpoint(@compression);
		}

		method : public : LogInsert(key : Int) ~ Bool {
			return Logged(@log->Insert(key));
		}

		method : public : LogSet(key : Int, column : Int, value : Compare) ~ Bool {
			return Logged(@log->Set(key, column, value));
		}

		method : public : LogDelete(key : Int) ~ Bool {
			return Logged(@log->Delete(key));
		}

		method : public : LogAddColumn(name : String, type : ColumnType) ~ Bool {
			return Logged(@log->AddColumn(name, type));
		}

		method : Logged(ok : Bool) ~ Bool {
			if(<>ok) {
				@error := @log->GetError();
			};
			return ok;
		}

		# The lock: created only if absent, holding this process's id. One left by a process
		# that is gone is cleared. One just created and not yet written is waited for briefly.
		method : Lock() ~ Bool {
			pid := Runtime->GetProcessId();
			each(attempt : 20) {
				if(File->CreateNew(@lock_path)) {
					if(<>FileWriter->WriteFile(@lock_path, "{$pid}")) {
						File->Delete(@lock_path);
						@error := "cannot write the lock '{$@lock_path}'";
						return false;
					};
					return true;
				};

				text := FileReader->ReadFile(@lock_path);
				holder := 0;
				if(text <> Nil) {
					text := text->Trim();
					if(text->Size() > 0 & text->IsInt()) {
						holder := text->ToInt();
					};
				};

				if(holder > 0) {
					if(holder = pid) {
						@error := "'{$@path}' is already open for writing in this process";
						return false;
					};
					if(Runtime->IsProcessAlive(holder)) {
						@error := "'{$@path}' is open for writing by process {$holder}";
						return false;
					};
					# its writer is gone: a crash left it
					File->Delete(@lock_path);
				}
				else if(attempt >= 10) {
					# empty for a second: a writer that crashed between creating and writing it
					File->Delete(@lock_path);
				}
				else {
					System.Concurrency.Thread->Sleep(100);
				};
			};

			@error := "cannot take the lock '{$@lock_path}'";
			return false;
		}

		method : Unlock() ~ Nil {
			File->Delete(@lock_path);
		}
	}

	#~
	An .otab file, or an .otab image in memory, opened for reading. Opening reads only the
	footer; Read then takes just the columns asked for, each checked against its CRC32, and
	GetBytesRead tells how much a read touched.

```
file := OtabFile->New("runs.otab");
if(file->IsOpen()) {
  scores := file->Read(["id", "score"]);
};
```
	~#
	class OtabFile {
		@path : String;
		@image : Byte[];
		@open : Bool;
		@name : String;
		@next_key : Int;
		@names : String[];
		@types : ColumnType[];
		@declared : Bool[];
		@counts : Int[];
		@blocks : OtabBlockInfo[];
		@version : Int;
		@indexes : OtabIndex[];
		@size : Int;
		@footer_offset : Int;
		@footer_crc : Int;
		@file_size : Int;
		@bytes_read : Int;
		@requests : Int;
		@url : String;
		@error : String;

		#~
		Opens a file, reading only its trailer and footer. A path that starts with http:// or
		https:// is read over HTTP: with range requests when the server supports them, so only
		the footer and the blocks a Read asks for cross the network, and otherwise by
		downloading the file once.
		@param path .otab file, or its URL
		~#
		New(path : String) {
			@path := path;
			if(path <> Nil & UrlCache->IsUrl(path)) {
				@url := path;
				@open := OpenUrl();
			}
			else {
				@open := OpenPath();
			};
		}

		#~
		Opens an .otab image held in memory, as Table->ToBytes makes it
		@param bytes image
		~#
		New(bytes : Byte[]) {
			@image := bytes;
			@open := OpenImage();
		}

		#~
		Whether the file opened; GetError says why not
		@return true if open
		~#
		method : public : IsOpen() ~ Bool {
			return @open;
		}

		method : OpenPath() ~ Bool {
			if(@path = Nil | <>File->Exists(@path)) {
				@error := "no file '{$@path}'";
				return false;
			};

			return ParseEnds(File->Size(@path));
		}

		# The header by a range request. A server that answers 206 is read the same way from then
		# on; one that answers 200 sent the whole file, which is then read in memory.
		method : OpenUrl() ~ Bool {
			total := IntRef->New(0);
			header := Fetch(0, Otab->HeaderSize(), total);
			if(header = Nil) {
				return false;
			};

			if(@image <> Nil) {
				return ParseEnds(@image->Size());
			};
			return ParseEnds(total->Get());
		}

		# bytes [offset, offset + count) of the URL; on a whole-file answer, keeps the file as
		# the image and returns the part asked for. total gets the size Content-Range reports.
		method : Fetch(offset : Int, count : Int, total : IntRef) ~ Byte[] {
			client := Web.HTTP.HttpClient->New();
			client->AddHeader("Range", "bytes={$offset}-{$(offset + count - 1)}");
			response := client->Get(Web.HTTP.Url->New(@url));
			@requests += 1;
			code := 0;
			body := Byte->New[0];
			if(response <> Nil) {
				code := response->GetCode();
				if(response->GetContent() <> Nil) {
					body := response->GetContent();
				};
			};

			if(code = 200) {
				@image := body;
				if(offset < 0 | offset + count > body->Size()) {
					@error := "'{$@url}' ends early; it is truncated";
					return Nil;
				};
				part := Byte->New[count];
				Byte->Copy(part, 0, body, offset, count);
				@bytes_read += count;
				return part;
			};

			if(code <> 206) {
				if(code = 0) {
					@error := "'{$@url}': no response from the server";
				}
				else {
					@error := "'{$@url}': the server answered HTTP {$code}";
				};
				return Nil;
			};

			if(body->Size() <> count) {
				@error := "'{$@url}': a range request for {$count} bytes returned {$(body->Size())}";
				return Nil;
			};

			if(total <> Nil) {
				range := client->GetResponseHeaders()->Find("content-range");
				slash := range <> Nil ? range->FindLast('/') : -1;
				if(slash < 0 | <>range->SubString(slash + 1, range->Size() - slash - 1)->Trim()->IsInt()) {
					@error := "'{$@url}': the server's range answer gives no total size";
					return Nil;
				};
				total->Set(range->SubString(slash + 1, range->Size() - slash - 1)->Trim()->ToInt());
			};

			@bytes_read += count;
			return body;
		}

		#~
		Gets the number of HTTP requests made for a file read by URL
		@return requests, 0 for a local file or image
		~#
		method : public : GetRequests() ~ Int {
			return @requests;
		}

		method : OpenImage() ~ Bool {
			if(@image = Nil) {
				@error := "no image";
				return false;
			};

			return ParseEnds(@image->Size());
		}

		# the header, trailer and footer of a file or image of 'size' bytes
		method : ParseEnds(size : Int) ~ Bool {
			if(size < Otab->HeaderSize() + Otab->TrailerSize()) {
				@error := "too short to be an .otab file";
				return false;
			};

			header := ReadAt(0, Otab->HeaderSize());
			if(header = Nil) {
				return false;
			};

			if(<>IsMagic(header, 0)) {
				@error := "not an .otab file";
				return false;
			};

			header_in := OtabReader->New(header);
			header_in->Skip(4);
			version := header_in->GetInt();
			if(version < 1 | version > Otab->Version()) {
				@error := "an .otab file of format {$version}; this library reads formats 1 to {$(Otab->Version())}";
				return false;
			};
			@version := version;

			trailer := ReadAt(size - Otab->TrailerSize(), Otab->TrailerSize());
			if(trailer = Nil) {
				return false;
			};

			input := OtabReader->New(trailer);
			footer_offset := input->GetInt();
			footer_size := input->GetInt();
			footer_crc := input->GetInt();
			if(<>IsMagic(trailer, 24) | footer_offset < Otab->HeaderSize() | footer_size < 0 |
					footer_offset + footer_size + Otab->TrailerSize() <> size) {
				@error := "the end of the file is damaged or missing; it may be truncated";
				return false;
			};
			@footer_offset := footer_offset;
			@footer_crc := footer_crc;
			@file_size := size;

			footer := ReadAt(footer_offset, footer_size);
			if(footer = Nil) {
				return false;
			};

			if(footer->CRC32() <> footer_crc) {
				@error := "the footer is damaged (checksum mismatch)";
				return false;
			};

			return ParseFooter(footer);
		}

		function : IsMagic(bytes : Byte[], at : Int) ~ Bool {
			magic := "OTAB"->ToByteArray();
			each(i : 4) {
				if(bytes[at + i] <> magic[i]) {
					return false;
				};
			};
			return true;
		}

		method : ParseFooter(footer : Byte[]) ~ Bool {
			input := OtabReader->New(footer);
			@name := input->GetText();
			@next_key := input->GetInt();
			columns := input->GetInt();
			if(input->IsBad() | columns < 1 | columns > footer->Size()) {
				@error := "the footer is malformed";
				return false;
			};

			@names := String->New[columns];
			@types := ColumnType->New[columns];
			@declared := Bool->New[columns];
			each(c : columns) {
				@names[c] := input->GetText();
				known := BoolRef->New(false);
				@types[c] := OtabCodes->ToType(input->GetInt(), known);
				@declared[c] := input->GetInt() = 1;
				if(<>known->Get()) {
					@error := "column '{$(@names[c])}' has a type this library does not know";
					return false;
				};
			};

			groups := input->GetInt();
			if(input->IsBad() | groups < 0 | groups > footer->Size()) {
				@error := "the footer is malformed";
				return false;
			};

			@counts := Int->New[groups];
			@blocks := OtabBlockInfo->New[groups * columns];
			@size := 0;
			each(g : groups) {
				@counts[g] := input->GetInt();
				@size += @counts[g];
				each(c : columns) {
					@blocks[g * columns + c] := OtabBlockInfo->Read(input);
				};
			};

			if(input->IsBad()) {
				@error := "the footer is malformed";
				return false;
			};

			# version 2 adds the index definitions; a version 1 footer ends here
			if(@version >= 2) {
				holder := StringHolder->New();
				@indexes := OtabIndex->ReadAll(input, columns, holder);
				if(@indexes = Nil) {
					@error := holder->Get();
					return false;
				};
			}
			else {
				@indexes := OtabIndex->New[0];
			};

			if(input->IsBad() | <>input->AtEnd()) {
				@error := "the footer is malformed";
				return false;
			};

			return true;
		}

		# bytes at an offset; Nil with the error set
		method : ReadAt(offset : Int, count : Int) ~ Byte[] {
			if(@url <> Nil & @image = Nil) {
				if(count = 0) {
					return Byte->New[0];
				};
				return Fetch(offset, count, Nil);
			};

			part := Byte->New[count];
			if(@image <> Nil) {
				if(offset < 0 | offset + count > @image->Size()) {
					@error := "the image ends early; it is truncated";
					return Nil;
				};
				Byte->Copy(part, 0, @image, offset, count);
				@bytes_read += count;
				return part;
			};

			reader := FileReader->New(@path);
			if(<>reader->IsOpen()) {
				@error := "cannot read '{$@path}'";
				return Nil;
			};

			reader->Seek(offset);
			done := count > 0 ? reader->ReadBuffer(0, count, part) : 0;
			reader->Close();
			if(done <> count) {
				@error := "'{$@path}' ends early; it is truncated";
				return Nil;
			};

			@bytes_read += count;
			return part;
		}

		#~
		Gets the table's name as saved
		@return name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Gets the saved column names, without the key column
		@return names
		~#
		method : public : GetColumnNames() ~ String[] {
			if(@names = Nil) {
				return String->New[0];
			};

			names := String->New[@names->Size() - 1];
			each(i : names) {
				names[i] := @names[i + 1];
			};
			return names;
		}

		#~
		Gets the number of rows
		@return rows
		~#
		method : public : Size() ~ Int {
			return @size;
		}

		#~
		Gets the number of row groups
		@return row groups
		~#
		method : public : GetGroupCount() ~ Int {
			return @counts = Nil ? 0 : @counts->Size();
		}

		#~
		Gets how many bytes reads have taken so far, the header, trailer and footer included
		@return bytes read
		~#
		method : public : GetBytesRead() ~ Int {
			return @bytes_read;
		}

		#~
		Gets why opening or the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Reads every column
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			return Read(GetColumnNames());
		}

		#~
		Reads only the named columns, and the key column; no other block is read
		@param names column names
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(names : String[]) ~ Table {
			if(<>@open) {
				return Nil;
			};

			@error := Nil;
			wanted := Int->New[names->Size() + 1];
			each(i : names) {
				index := -1;
				for(c := 1; c < @names->Size(); c += 1;) {
					if(@names[c]->Equals(names[i])) {
						index := c;
					};
				};
				if(index < 0) {
					@error := "the file has no column '{$(names[i])}'";
					return Nil;
				};
				wanted[i + 1] := index;
			};

			total := @names->Size();
			columns := Column->New[wanted->Size()];
			each(w : wanted) {
				c := wanted[w];
				parts := OtabParts->New(@types[c]);
				each(g : @counts) {
					info := @blocks[g * total + c];
					stored := ReadAt(info->GetOffset(), info->GetStored());
					if(stored = Nil) {
						return Nil;
					};

					if(stored->CRC32() <> info->GetCrc()) {
						@error := "column '{$(@names[c])}', row group {$(g + 1)}: the block is damaged (checksum mismatch)";
						return Nil;
					};

					raw := Otab->Unpack(stored, info->GetCodec());
					if(raw = Nil) {
						@error := "column '{$(@names[c])}', row group {$(g + 1)}: the block cannot be decompressed";
						return Nil;
					};

					if(raw->Size() <> info->GetRaw() | <>OtabBlock->Decode(raw, @types[c], @counts[g], parts)) {
						@error := "column '{$(@names[c])}', row group {$(g + 1)}: the block is malformed";
						return Nil;
					};
				};
				columns[w] := parts->Build(@names[c], @declared[c]);
			};

			column_names := String->New[names->Size()];
			each(i : column_names) {
				column_names[i] := @names[wanted[i + 1]];
			};

			table := Table->Restore(@name, column_names, columns, @next_key);
			# the indexes of the columns read, built by the first query that uses each
			each(i : @indexes) {
				definition := @indexes[i];
				each(w : wanted) {
					if(w > 0 & wanted[w] = definition->GetColumn()) {
						table->AttachIndex(w, definition->GetName(), definition->GetIndexKind());
					};
				};
			};
			return table;
		}

		# Append: the file's bytes before its footer, its groups and blocks, and its schema
		method : public : GetNextKey() ~ Int { return @next_key; }
		method : public : GetFooterOffset() ~ Int { return @footer_offset; }
		method : public : GetFooterCrc() ~ Int { return @footer_crc; }
		method : public : GetFileSize() ~ Int { return @file_size; }
		method : public : GetTypes() ~ ColumnType[] { return @types; }
		method : public : GetDeclared() ~ Bool[] { return @declared; }
		method : public : GetAllNames() ~ String[] { return @names; }
		method : public : GetCounts() ~ Int[] { return @counts; }
		method : public : GetBlocks() ~ OtabBlockInfo[] { return @blocks; }
		method : public : GetIndexDefinitions() ~ OtabIndex[] { return @indexes; }

		#~
		Gets the file's format version: 1, or 2 for a file that stores index definitions
		@return version, 0 if the file did not open
		~#
		method : public : GetFormatVersion() ~ Int {
			return @version;
		}

		#~
		Gets the names of the indexes the file defines, which Read restores on the columns it
		reads
		@return index names, in column order
		~#
		method : public : GetIndexNames() ~ String[] {
			if(@indexes = Nil) {
				return String->New[0];
			};

			names := String->New[@indexes->Size()];
			each(i : names) {
				names[i] := @indexes[i]->GetName();
			};
			return names;
		}

		method : public : ReadPrefix() ~ Byte[] {
			return ReadAt(0, @footer_offset);
		}
	}

	#
	# SQL front end (docs/QUERY_DESIGN.md, section 4): a lexer, a statement tree and a
	# recursive-descent parser for the whole subset. Keywords are contextual: a word is a
	# keyword only where the grammar expects one, so a column named 'left' or 'values' still
	# works where a column is expected. A double-quoted name is never a keyword.
	#
	class : private : SqlToken {
		#~
		The kind of a token read by the SQL lexer.
		~#
		enum Kind {
			#~
			An unquoted word: a keyword where the grammar expects one, otherwise a name.
			~#
			WORD,
			#~
			A double-quoted name, never a keyword.
			~#
			NAME,
			#~
			A single-quoted string.
			~#
			TEXT,
			#~
			A number.
			~#
			NUMBER,
			#~
			A date between '#' marks.
			~#
			DATE,
			#~
			A '?' placeholder.
			~#
			PARAM,
			#~
			An operator or punctuation.
			~#
			SYMBOL,
			#~
			The end of the statement.
			~#
			EOS
		}

		@kind : SqlToken->Kind;
		@text : String;
		@value : Compare;
		@position : Int;

		New(kind : SqlToken->Kind, text : String, value : Compare, position : Int) {
			@kind := kind;
			@text := text;
			@value := value;
			@position := position;
		}

		method : public : GetKind() ~ SqlToken->Kind {
			return @kind;
		}

		method : public : GetText() ~ String {
			return @text;
		}

		method : public : GetValue() ~ Compare {
			return @value;
		}

		method : public : GetPosition() ~ Int {
			return @position;
		}

		# whether this is the given word, ignoring case
		method : public : IsWord(word : String) ~ Bool {
			return @kind = SqlToken->Kind->WORD & @text->ToLower()->Equals(word);
		}

		method : public : IsSymbol(symbol : String) ~ Bool {
			return @kind = SqlToken->Kind->SYMBOL & @text->Equals(symbol);
		}

		# a WORD or a quoted NAME: something that can name a column or a table
		method : public : IsName() ~ Bool {
			return @kind = SqlToken->Kind->WORD | @kind = SqlToken->Kind->NAME;
		}

		# how the token reads in an error message
		method : public : Describe() ~ String {
			select(@kind) {
				label SqlToken->Kind->EOS: {
					return "the end of the statement";
				}

				label SqlToken->Kind->TEXT: {
					return "'{$@text}'";
				}

				label SqlToken->Kind->NAME: {
					return "\"{$@text}\"";
				}

				label SqlToken->Kind->PARAM: {
					return "'?'";
				}
			};

			return "'{$@text}'";
		}
	}

	class : private : SqlLexer {
		@line : String;
		@error : String;

		New(line : String) {
			@line := line;
		}

		method : public : GetError() ~ String {
			return @error;
		}

		method : Peek(index : Int) ~ Char {
			if(index < @line->Size()) {
				return @line->Get(index);
			};

			return '\0';
		}

		method : IsNameChar(c : Char) ~ Bool {
			return c->IsChar() | c->IsDigit() | c = '_' | c = '.' | c = '$';
		}

		# a number starts with a digit, or a '-' or '.' that leads to one
		method : IsNumberStart(index : Int) ~ Bool {
			c := Peek(index);
			if(c->IsDigit()) {
				return true;
			};

			if(c = '-') {
				index += 1;
				c := Peek(index);
				if(c->IsDigit()) {
					return true;
				};
			};

			return c = '.' & Peek(index + 1)->IsDigit();
		}

		# the tokens, ending with EOS; Nil with GetError set
		method : public : Scan() ~ Vector<SqlToken> {
			tokens := Vector->New()<SqlToken>;
			params := 0;
			i := 0;
			size := @line->Size();
			while(i < size) {
				c := @line->Get(i);
				start := i;
				if(c = ' ' | c = '\t' | c = '\r' | c = '\n') {
					i += 1;
				}
				else if(c = '\'') {
					# a string; '' inside it is one quote
					text := "";
					i += 1;
					done := false;
					while(<>done) {
						if(i >= size) {
							@error := "unterminated string starting at position {$start}";
							return Nil;
						};

						if(@line->Get(i) = '\'') {
							if(Peek(i + 1) = '\'') {
								text->Append('\'');
								i += 2;
							}
							else {
								i += 1;
								done := true;
							};
						}
						else {
							text->Append(@line->Get(i));
							i += 1;
						};
					};
					tokens->AddBack(SqlToken->New(SqlToken->Kind->TEXT, text, text, start));
				}
				else if(c = '"') {
					# a quoted name, never a keyword
					text := "";
					i += 1;
					while(i < size & @line->Get(i) <> '"') {
						text->Append(@line->Get(i));
						i += 1;
					};
					if(i >= size) {
						@error := "unterminated quoted name starting at position {$start}";
						return Nil;
					};
					i += 1;
					tokens->AddBack(SqlToken->New(SqlToken->Kind->NAME, text, Nil, start));
				}
				else if(c = '#') {
					text := "";
					i += 1;
					while(i < size & @line->Get(i) <> '#') {
						text->Append(@line->Get(i));
						i += 1;
					};
					if(i >= size) {
						@error := "unterminated date starting at position {$start}";
						return Nil;
					};
					i += 1;

					date := ParseDate(text);
					if(date = Nil) {
						@error := "'#{$text}#' at position {$start} is not a date (MM/dd/yyyy, MM/dd/yyyy hh:mm:ss or yyyy-MM-dd)";
						return Nil;
					};
					tokens->AddBack(SqlToken->New(SqlToken->Kind->DATE, text, date, start));
				}
				else if(c->IsChar() | c = '_' | (c = '@' & (Peek(i + 1)->IsChar() | Peek(i + 1) = '_'))) {
					text := "";
					if(c = '@') {
						text->Append(c);
						i += 1;
					};
					while(i < size & IsNameChar(@line->Get(i))) {
						text->Append(@line->Get(i));
						i += 1;
					};
					tokens->AddBack(SqlToken->New(SqlToken->Kind->WORD, text, Nil, start));
				}
				else if(IsNumberStart(i)) {
					number := "";
					if(c = '-') {
						number->Append('-');
						i += 1;
					};

					while(i < size & (@line->Get(i)->IsDigit() | @line->Get(i) = '.')) {
						number->Append(@line->Get(i));
						i += 1;
					};

					if(i < size & (@line->Get(i) = 'e' | @line->Get(i) = 'E')) {
						number->Append(@line->Get(i));
						i += 1;
						if(i < size & (@line->Get(i) = '-' | @line->Get(i) = '+')) {
							number->Append(@line->Get(i));
							i += 1;
						};
						while(i < size & @line->Get(i)->IsDigit()) {
							number->Append(@line->Get(i));
							i += 1;
						};
					};

					kind := Cell->NumberKind(number);
					if(kind = 1) {
						tokens->AddBack(SqlToken->New(SqlToken->Kind->NUMBER, number, IntRef->New(number->ToInt()), start));
					}
					else if(kind = 2) {
						tokens->AddBack(SqlToken->New(SqlToken->Kind->NUMBER, number, FloatRef->New(number->ToFloat()), start));
					}
					else {
						@error := "'{$number}' at position {$start} is not a number";
						return Nil;
					};
				}
				else if(c = '?') {
					params += 1;
					tokens->AddBack(SqlToken->New(SqlToken->Kind->PARAM, "?", IntRef->New(params), start));
					i += 1;
				}
				else if(c = '<' & (Peek(i + 1) = '>' | Peek(i + 1) = '=')) {
					tokens->AddBack(SqlToken->New(SqlToken->Kind->SYMBOL, @line->SubString(i, 2), Nil, start));
					i += 2;
				}
				else if(c = '=' & Peek(i + 1) = '>') {
					tokens->AddBack(SqlToken->New(SqlToken->Kind->SYMBOL, "=>", Nil, start));
					i += 2;
				}
				else if((c = '>' | c = '!') & Peek(i + 1) = '=') {
					symbol := c = '!' ? "<>" : ">=";
					tokens->AddBack(SqlToken->New(SqlToken->Kind->SYMBOL, symbol, Nil, start));
					i += 2;
				}
				# a '.' that does not start a number or sit inside a name: between a quoted
				# archive or workbook and its member ('data.zip'.'runs.csv'). '+', '-', '/' and '%'
				# are arithmetic in the select list; a '-' that leads to a digit was taken as a
				# number's sign above
				else if(c = '*' | c = ',' | c = '(' | c = ')' | c = '=' | c = '<' | c = '>' | c = ';' | c = '.' |
						c = '+' | c = '-' | c = '/' | c = '%') {
					text := "";
					text->Append(c);
					tokens->AddBack(SqlToken->New(SqlToken->Kind->SYMBOL, text, Nil, start));
					i += 1;
				}
				else {
					@error := "unexpected character '{$c}' at position {$i}";
					return Nil;
				};
			};
			tokens->AddBack(SqlToken->New(SqlToken->Kind->EOS, "", Nil, size));

			return tokens;
		}

		function : ParseDate(text : String) ~ Date {
			if(text->Size() = 10 & text->Get(4) = '-') {
				return DateUtility->Parse(text, "yyyy-MM-dd", false);
			};

			select(text->Size()) {
				label 8: {
					return DateUtility->Parse(text, "MM/dd/yy", false);
				}

				label 10: {
					return DateUtility->Parse(text, "MM/dd/yyyy", false);
				}

				label 17: {
					return DateUtility->Parse(text, "MM/dd/yy hh:mm:ss", false);
				}

				label 19: {
					return DateUtility->Parse(text, "MM/dd/yyyy hh:mm:ss", false);
				}
			};

			return Nil;
		}
	}

	# one entry of a select list, or an aggregate named in HAVING or ORDER BY
	class : private : SqlItem {
		@is_aggregate : Bool;
		@name : String;
		@func : String;
		@alias_name : String;
		@expr : SqlExpr;

		New(name : String, func : String) {
			@name := name;
			@func := func;
			@is_aggregate := func <> Nil;
		}

		# an arithmetic expression; its name is its text, which is also its default label
		New(expr : SqlExpr) {
			@expr := expr;
			@name := expr->GetText();
			expr->Ordinals(IntRef->New(0));
		}

		# the expression, or Nil for a column or an aggregate
		method : public : GetExpr() ~ SqlExpr {
			return @expr;
		}

		method : public : IsAggregate() ~ Bool {
			return @is_aggregate;
		}

		# the column it reads; '*' for count(*)
		method : public : GetName() ~ String {
			return @name;
		}

		method : public : GetFunc() ~ String {
			return @func;
		}

		method : public : SetAlias(alias_name : String) ~ Nil {
			@alias_name := alias_name;
		}

		method : public : GetAlias() ~ String {
			return @alias_name;
		}

		# how an aggregate is written in HAVING and ORDER BY, and its default column name
		method : public : GetCall() ~ String {
			return "{$@func}({$@name})";
		}

		# the result column's name
		method : public : GetLabel() ~ String {
			if(@alias_name <> Nil) {
				return @alias_name;
			};

			return @is_aggregate ? GetCall() : @name;
		}
	}

	# An arithmetic expression in a select list (docs/QUERY_DESIGN.md, "Expressions in the
	# select list"): column references and numbers joined by + - * / %, with unary minus and
	# parentheses. Evaluated per row: whole numbers stay whole under + - * and %, '/' always
	# gives a Float, and an empty or non-numeric operand, or a zero divisor, gives an empty cell.
	class : private : SqlExpr {
		@kind : Int;
		@name : String;
		@value : Compare;
		@op : Char;
		@left : SqlExpr;
		@right : SqlExpr;
		@text : String;
		@ordinal : Int;

		function : ColumnKind() ~ Int { return 0; }
		function : NumberKind() ~ Int { return 1; }
		function : BinaryKind() ~ Int { return 2; }
		function : NegateKind() ~ Int { return 3; }

		New(kind : Int, text : String) {
			@kind := kind;
			@text := text;
		}

		function : Column(name : String) ~ SqlExpr {
			expr := SqlExpr->New(ColumnKind(), name);
			expr->SetName(name);
			return expr;
		}

		function : Number(text : String, value : Compare) ~ SqlExpr {
			expr := SqlExpr->New(NumberKind(), text);
			expr->SetValue(value);
			return expr;
		}

		function : Binary(op : Char, left : SqlExpr, right : SqlExpr) ~ SqlExpr {
			expr := SqlExpr->New(BinaryKind(), "{$(left->GetText())} {$op} {$(right->GetText())}");
			expr->SetParts(op, left, right);
			return expr;
		}

		function : Negate(operand : SqlExpr) ~ SqlExpr {
			expr := SqlExpr->New(NegateKind(), "-{$(operand->GetText())}");
			expr->SetParts('-', operand, Nil);
			return expr;
		}

		method : public : SetName(name : String) ~ Nil { @name := name; }
		method : public : SetValue(value : Compare) ~ Nil { @value := value; }
		method : public : SetParts(op : Char, left : SqlExpr, right : SqlExpr) ~ Nil {
			@op := op;
			@left := left;
			@right := right;
		}
		method : public : SetText(text : String) ~ Nil { @text := text; }
		method : public : GetText() ~ String { return @text; }
		method : public : GetKind() ~ Int { return @kind; }
		method : public : GetName() ~ String { return @name; }

		# a bare column reference: a plain select item, not an expression
		method : public : IsColumn() ~ Bool {
			return @kind = ColumnKind();
		}

		# the column names it reads, in order
		method : public : AddColumns(names : Vector<String>) ~ Nil {
			if(@kind = ColumnKind()) {
				names->AddBack(@name);
			}
			else if(@kind = BinaryKind()) {
				@left->AddColumns(names);
				@right->AddColumns(names);
			}
			else if(@kind = NegateKind()) {
				@left->AddColumns(names);
			};
		}

		# numbers the column references in AddColumns order, once, when the item is made
		method : public : Ordinals(next : IntRef) ~ Nil {
			if(@kind = ColumnKind()) {
				@ordinal := next->Get();
				next->Set(@ordinal + 1);
			}
			else if(@kind = BinaryKind()) {
				@left->Ordinals(next);
				@right->Ordinals(next);
			}
			else if(@kind = NegateKind()) {
				@left->Ordinals(next);
			};
		}

		# The value for one row; 'columns' gives each column reference's index in 'table', in
		# AddColumns order. Nil for an empty cell.
		method : public : Eval(table : Table, row : Int, columns : Int[]) ~ Compare {
			if(@kind = ColumnKind()) {
				value := table->GetColumn(columns[@ordinal])->Get(row);
				if(value <> Nil & (value->TypeOf(IntRef) | value->TypeOf(FloatRef))) {
					return value;
				};
				return Nil;
			}
			else if(@kind = NumberKind()) {
				return @value;
			}
			else if(@kind = NegateKind()) {
				value := @left->Eval(table, row, columns);
				if(value = Nil) {
					return Nil;
				};
				if(value->TypeOf(IntRef)) {
					return IntRef->New(0 - value->As(IntRef)->Get());
				};
				return FloatRef->New(0.0 - value->As(FloatRef)->Get());
			};

			a := @left->Eval(table, row, columns);
			b := @right->Eval(table, row, columns);
			if(a = Nil | b = Nil) {
				return Nil;
			};

			if(a->TypeOf(IntRef) & b->TypeOf(IntRef) & @op <> '/') {
				x := a->As(IntRef)->Get();
				y := b->As(IntRef)->Get();
				select(@op) {
					label '+': { return IntRef->New(x + y); }
					label '-': { return IntRef->New(x - y); }
					label '*': { return IntRef->New(x * y); }
				};
				# '%'
				if(y = 0) {
					return Nil;
				};
				return IntRef->New(x % y);
			};

			x := ToFloat(a);
			y := ToFloat(b);
			select(@op) {
				label '+': { return FloatRef->New(x + y); }
				label '-': { return FloatRef->New(x - y); }
				label '*': { return FloatRef->New(x * y); }
			};

			# '/' and '%': a zero divisor (which would raise) gives an empty cell
			if(y = 0.0) {
				return Nil;
			};
			if(@op = '/') {
				return FloatRef->New(x / y);
			};
			quotient := x / y;
			whole := quotient < 0.0 ? (0.0 - quotient)->Floor() * -1.0 : quotient->Floor();
			return FloatRef->New(x - whole * y);
		}

		function : ToFloat(value : Compare) ~ Float {
			if(value->TypeOf(IntRef)) {
				return value->As(IntRef)->Get()->As(Float);
			};
			return value->As(FloatRef)->Get();
		}
	}

	class : private : SqlJoin {
		@is_left : Bool;
		@table_name : String;
		@alias_name : String;
		@left_key : String;
		@right_key : String;
		@file : SqlFile;

		New(is_left : Bool, table_name : String, file : SqlFile, alias_name : String, left_key : String, right_key : String) {
			@is_left := is_left;
			@table_name := table_name;
			@file := file;
			@alias_name := alias_name;
			@left_key := left_key;
			@right_key := right_key;
		}

		method : public : IsLeft() ~ Bool {
			return @is_left;
		}

		method : public : GetTableName() ~ String {
			return @table_name;
		}

		# the file it reads, Nil for a table of the catalog
		method : public : GetFile() ~ SqlFile {
			return @file;
		}

		method : public : GetAlias() ~ String {
			return @alias_name;
		}

		method : public : GetLeftKey() ~ String {
			return @left_key;
		}

		method : public : GetRightKey() ~ String {
			return @right_key;
		}
	}

	class : private : SqlOrder {
		@name : String;
		@position : Int;
		@descending : Bool;

		New(name : String, position : Int, descending : Bool) {
			@name := name;
			@position := position;
			@descending := descending;
		}

		# a column name, an alias or an aggregate call; Nil when a position is given
		method : public : GetName() ~ String {
			return @name;
		}

		method : public : SetName(name : String) ~ Nil {
			@name := name;
		}

		# a select-list position from 1, or 0
		method : public : GetPosition() ~ Int {
			return @position;
		}

		method : public : IsDescending() ~ Bool {
			return @descending;
		}
	}

	# a literal or a placeholder in VALUES or SET
	class : private : SqlValue {
		@value : Compare;
		@param : Int;

		New(value : Compare, param : Int) {
			@value := value;
			@param := param;
		}

		# the value, or the bound value of its placeholder; 'ok' false if that is unbound
		method : public : Resolve(params : Compare[], ok : BoolRef) ~ Compare {
			if(@param > 0) {
				if(params = Nil | @param > params->Size()) {
					ok->Set(false);
					return Nil;
				};
				return params[@param - 1];
			};

			return @value;
		}

		method : public : GetParam() ~ Int {
			return @param;
		}

		# the literal; Nil for a placeholder or NULL
		method : public : GetValue() ~ Compare {
			return @value;
		}
	}

	class : private : SqlStatement {
		#~
		The kind of a parsed SQL statement.
		~#
		enum Kind {
			#~
			SELECT
			~#
			QUERY,
			#~
			INSERT
			~#
			INSERT,
			#~
			UPDATE
			~#
			UPDATE,
			#~
			DELETE
			~#
			DELETE,
			#~
			CREATE TABLE
			~#
			CREATE,
			#~
			CREATE INDEX
			~#
			CREATE_INDEX,
			#~
			DROP INDEX
			~#
			DROP_INDEX
		}

		@kind : SqlStatement->Kind;
		@distinct : Bool;
		@star : Bool;
		@items : Vector<SqlItem>;
		@extra : Vector<SqlItem>;
		@table_name : String;
		@file : SqlFile;
		@alias_name : String;
		@joins : Vector<SqlJoin>;
		@where : Predicate;
		@group : Vector<String>;
		@having : Predicate;
		@order : Vector<SqlOrder>;
		@limit : Int;
		@offset : Int;
		@columns : Vector<String>;
		@values : Vector<Vector<SqlValue>>;
		@types : Vector<String>;
		@params : Int;
		@index_name : String;

		New(kind : SqlStatement->Kind) {
			@kind := kind;
			@items := Vector->New()<SqlItem>;
			@extra := Vector->New()<SqlItem>;
			@joins := Vector->New()<SqlJoin>;
			@group := Vector->New()<String>;
			@order := Vector->New()<SqlOrder>;
			@columns := Vector->New()<String>;
			@values := Vector->New()<Vector<SqlValue>>;
			@types := Vector->New()<String>;
			@limit := -1;
		}

		method : public : GetKind() ~ SqlStatement->Kind { return @kind; }
		method : public : IsDistinct() ~ Bool { return @distinct; }
		method : public : SetDistinct() ~ Nil { @distinct := true; }
		method : public : IsStar() ~ Bool { return @star; }
		method : public : SetStar() ~ Nil { @star := true; }
		method : public : GetItems() ~ Vector<SqlItem> { return @items; }
		# aggregates named only in HAVING or ORDER BY
		method : public : GetExtra() ~ Vector<SqlItem> { return @extra; }
		method : public : GetTableName() ~ String { return @table_name; }
		method : public : SetTableName(name : String) ~ Nil { @table_name := name; }
		# the file FROM reads, Nil for a table of the catalog
		method : public : GetFile() ~ SqlFile { return @file; }
		method : public : SetFile(file : SqlFile) ~ Nil { @file := file; }
		method : public : GetAlias() ~ String { return @alias_name; }
		method : public : SetAlias(alias_name : String) ~ Nil { @alias_name := alias_name; }
		method : public : GetJoins() ~ Vector<SqlJoin> { return @joins; }
		method : public : GetWhere() ~ Predicate { return @where; }
		method : public : SetWhere(where : Predicate) ~ Nil { @where := where; }
		method : public : GetGroup() ~ Vector<String> { return @group; }
		method : public : GetHaving() ~ Predicate { return @having; }
		method : public : SetHaving(having : Predicate) ~ Nil { @having := having; }
		method : public : GetOrder() ~ Vector<SqlOrder> { return @order; }
		method : public : GetLimit() ~ Int { return @limit; }
		method : public : SetLimit(limit : Int) ~ Nil { @limit := limit; }
		method : public : GetOffset() ~ Int { return @offset; }
		method : public : SetOffset(offset : Int) ~ Nil { @offset := offset; }
		# INSERT's column list, UPDATE's assigned columns, CREATE's column names
		method : public : GetColumns() ~ Vector<String> { return @columns; }
		# INSERT's rows; UPDATE's values, one row
		method : public : GetValues() ~ Vector<Vector<SqlValue>> { return @values; }
		method : public : GetTypes() ~ Vector<String> { return @types; }
		method : public : GetParamCount() ~ Int { return @params; }
		method : public : SetParamCount(params : Int) ~ Nil { @params := params; }
		# CREATE INDEX's and DROP INDEX's index name, Nil if CREATE INDEX gave none
		method : public : GetIndexName() ~ String { return @index_name; }
		method : public : SetIndexName(index_name : String) ~ Nil { @index_name := index_name; }

		# whether the select list or HAVING uses an aggregate
		method : public : HasAggregates() ~ Bool {
			each(i : @items) {
				if(@items->Get(i)->IsAggregate()) {
					return true;
				};
			};

			return @extra->Size() > 0;
		}
	}

	class : private : SqlParser {
		@tokens : Vector<SqlToken>;
		@index : Int;
		@error : String;
		@statement : SqlStatement;
		@in_having : Bool;
		@ref_name : String;
		@ref_file : SqlFile;

		New() {
		}

		method : public : GetError() ~ String {
			return @error;
		}

		# a statement, or Nil with GetError set
		method : public : Parse(line : String) ~ SqlStatement {
			if(line = Nil) {
				@error := "no statement";
				return Nil;
			};

			lexer := SqlLexer->New(line);
			@tokens := lexer->Scan();
			if(@tokens = Nil) {
				@error := lexer->GetError();
				return Nil;
			};
			@index := 0;

			statement : SqlStatement;
			if(Current()->IsWord("select")) {
				Next();
				statement := ParseSelect(false);
			}
			else if(Current()->IsWord("from")) {
				# the old engine's short form, 'from t where ...', is 'select * from t where ...'
				statement := ParseSelect(true);
			}
			else if(Current()->IsWord("insert")) {
				Next();
				statement := ParseInsert();
			}
			else if(Current()->IsWord("update")) {
				Next();
				statement := ParseUpdate();
			}
			else if(Current()->IsWord("delete")) {
				Next();
				statement := ParseDelete();
			}
			else if(Current()->IsWord("create")) {
				Next();
				statement := ParseCreate();
			}
			else if(Current()->IsWord("drop")) {
				Next();
				statement := ParseDrop();
			}
			else {
				return Fail("SELECT, INSERT, UPDATE, DELETE, CREATE or DROP");
			};

			if(statement = Nil) {
				return Nil;
			};

			if(Current()->IsSymbol(";")) {
				Next();
			};

			if(Current()->GetKind() <> SqlToken->Kind->EOS) {
				return Fail("the end of the statement");
			};

			params := 0;
			each(i : @tokens) {
				if(@tokens->Get(i)->GetKind() = SqlToken->Kind->PARAM) {
					params += 1;
				};
			};
			statement->SetParamCount(params);

			return statement;
		}

		method : Current() ~ SqlToken {
			return @tokens->Get(@index);
		}

		method : Ahead(n : Int) ~ SqlToken {
			i := @index + n;
			if(i >= @tokens->Size()) {
				return @tokens->Get(@tokens->Size() - 1);
			};

			return @tokens->Get(i);
		}

		method : Next() ~ Nil {
			if(@index < @tokens->Size() - 1) {
				@index += 1;
			};
		}

		# records a syntax error at the current token; always Nil
		method : Fail(expected : String) ~ SqlStatement {
			if(@error = Nil) {
				token := Current();
				@error := "syntax error at position {$(token->GetPosition())}: expected {$expected}, found {$(token->Describe())}";
			};

			return Nil;
		}

		method : FailCondition(expected : String) ~ Predicate {
			Fail(expected);
			return Nil;
		}

		method : ExpectWord(word : String) ~ Bool {
			if(<>Current()->IsWord(word)) {
				Fail(word->ToUpper());
				return false;
			};
			Next();

			return true;
		}

		method : ExpectSymbol(symbol : String) ~ Bool {
			if(<>Current()->IsSymbol(symbol)) {
				Fail("'{$symbol}'");
				return false;
			};
			Next();

			return true;
		}

		# a column or table name; Nil (with the error set) if the token is not one
		method : ParseName(what : String) ~ String {
			token := Current();
			if(<>token->IsName()) {
				Fail(what);
				return Nil;
			};
			Next();

			return token->GetText();
		}

		function : IsAggregateName(word : String) ~ Bool {
			lower := word->ToLower();
			return lower->Equals("count") | lower->Equals("sum") | lower->Equals("avg") |
				lower->Equals("min") | lower->Equals("max") | lower->Equals("median") |
				lower->Equals("stddev");
		}

		# whether the current token starts an aggregate call: a function word then '('
		method : AtAggregate() ~ Bool {
			token := Current();
			return token->GetKind() = SqlToken->Kind->WORD & IsAggregateName(token->GetText()) & Ahead(1)->IsSymbol("(");
		}

		# a select-list expression: term (('+' | '-') term)*
		method : ParseSum() ~ SqlExpr {
			left := ParseProduct();
			while(left <> Nil) {
				token := Current();
				if(token->IsSymbol("+") | token->IsSymbol("-")) {
					Next();
					right := ParseProduct();
					if(right = Nil) {
						return Nil;
					};
					left := SqlExpr->Binary(token->GetText()->Get(0), left, right);
				}
				else if(token->GetKind() = SqlToken->Kind->NUMBER & token->GetText()->StartsWith("-")) {
					# 'n -1' scans as a name and a negative number: a subtraction
					Next();
					text := token->GetText()->SubString(1, token->GetText()->Size() - 1);
					value := token->GetValue();
					positive : Compare;
					if(value->TypeOf(IntRef)) {
						positive := IntRef->New(0 - value->As(IntRef)->Get());
					}
					else {
						positive := FloatRef->New(0.0 - value->As(FloatRef)->Get());
					};
					right := ParseProductFrom(SqlExpr->Number(text, positive));
					if(right = Nil) {
						return Nil;
					};
					left := SqlExpr->Binary('-', left, right);
				}
				else {
					return left;
				};
			};

			return left;
		}

		# factor (('*' | '/' | '%') factor)*
		method : ParseProduct() ~ SqlExpr {
			return ParseProductFrom(ParseFactor());
		}

		method : ParseProductFrom(left : SqlExpr) ~ SqlExpr {
			while(left <> Nil) {
				token := Current();
				if(token->IsSymbol("*") | token->IsSymbol("/") | token->IsSymbol("%")) {
					Next();
					right := ParseFactor();
					if(right = Nil) {
						return Nil;
					};
					left := SqlExpr->Binary(token->GetText()->Get(0), left, right);
				}
				else {
					return left;
				};
			};

			return left;
		}

		# a number, a column name, '-' factor, or '(' sum ')'
		method : ParseFactor() ~ SqlExpr {
			token := Current();
			if(token->GetKind() = SqlToken->Kind->NUMBER) {
				Next();
				return SqlExpr->Number(token->GetText(), token->GetValue());
			}
			else if(token->IsSymbol("-")) {
				Next();
				operand := ParseFactor();
				return operand <> Nil ? SqlExpr->Negate(operand) : Nil;
			}
			else if(token->IsSymbol("(")) {
				Next();
				inner := ParseSum();
				if(inner = Nil | <>ExpectSymbol(")")) {
					return Nil;
				};
				if(<>inner->IsColumn()) {
					inner->SetText("({$(inner->GetText())})");
				};
				return inner;
			};

			name := ParseName("a column name, an aggregate, a number or '*'");
			return name <> Nil ? SqlExpr->Column(name) : Nil;
		}

		# func '(' ('*' | name) ')'; only COUNT takes '*'
		method : ParseAggregate() ~ SqlItem {
			func := Current()->GetText()->ToLower();
			Next();
			Next();

			name : String;
			if(Current()->IsSymbol("*")) {
				if(<>func->Equals("count")) {
					Fail("a column name ({$func}(*) is not allowed)");
					return Nil;
				};
				name := "*";
				Next();
			}
			else {
				name := ParseName("a column name");
				if(name = Nil) {
					return Nil;
				};
			};

			if(<>ExpectSymbol(")")) {
				return Nil;
			};

			return SqlItem->New(name, func);
		}

		# the words that end a select item or a table reference, so they are never read as an
		# alias without AS
		function : IsClauseWord(token : SqlToken) ~ Bool {
			if(token->GetKind() <> SqlToken->Kind->WORD) {
				return false;
			};

			word := token->GetText()->ToLower();
			return word->Equals("from") | word->Equals("where") | word->Equals("group") |
				word->Equals("having") | word->Equals("order") | word->Equals("limit") |
				word->Equals("offset") | word->Equals("join") | word->Equals("inner") |
				word->Equals("left") | word->Equals("on") | word->Equals("set") |
				word->Equals("values");
		}

		function : IsFileFunction(word : String) ~ Bool {
			lower := word->ToLower();
			return lower->Equals("csv") | lower->Equals("tsv") | lower->Equals("json") |
				lower->Equals("jsonl") | lower->Equals("xml") | lower->Equals("xlsx");
		}

		# after a quoted path, '.' and a quoted member of an archive or worksheet of a
		# workbook: 'data.zip'.'runs/a.csv', 'book.xlsx'.'Q1'; false with the error set
		method : ParseMember(file : SqlFile) ~ Bool {
			if(<>Current()->IsSymbol(".")) {
				return true;
			};
			Next();

			member := Current();
			if(member->GetKind() <> SqlToken->Kind->TEXT) {
				Fail("a quoted member or sheet name after '.', as 'data.zip'.'runs.csv'");
				return false;
			};
			Next();

			if(member->GetText()->Size() = 0) {
				Fail("a member or sheet name, not ''");
				return false;
			};
			file->SetMember(member->GetText());
			return true;
		}

		# a table in FROM or JOIN: a catalog table's name, a quoted file path ('runs/*.csv'),
		# or a file read a given way: csv('f.txt', delimiter => ';', header => false),
		# tsv(...), json(...), jsonl(...), xml('f.xml', row => 'item') or
		# xlsx('book.xlsx', header => false, first_row => 3). A path to an archive or a
		# workbook may name a member or sheet: 'data.zip'.'runs.csv', 'book.xlsx'.'Q1'. Sets
		# @ref_name, and @ref_file for a file; false with the error set otherwise.
		method : ParseTable() ~ Bool {
			@ref_name := Nil;
			@ref_file := Nil;
			token := Current();
			if(token->GetKind() = SqlToken->Kind->TEXT) {
				Next();
				@ref_file := SqlFile->New(token->GetText(), "");
				if(<>ParseMember(@ref_file)) {
					return false;
				};
				@ref_name := @ref_file->GetDefaultName();
				return true;
			};

			if(token->GetKind() = SqlToken->Kind->WORD & IsFileFunction(token->GetText()) & Ahead(1)->IsSymbol("(")) {
				format := token->GetText()->ToLower();
				Next();
				Next();
				path := Current();
				if(path->GetKind() <> SqlToken->Kind->TEXT) {
					Fail("a quoted file path");
					return false;
				};
				Next();
				file := SqlFile->New(path->GetText(), format);
				if(<>ParseMember(file)) {
					return false;
				};

				while(Current()->IsSymbol(",")) {
					Next();
					option := Current();
					if(option->GetKind() <> SqlToken->Kind->WORD) {
						Fail("an option name");
						return false;
					};
					Next();
					if(<>ExpectSymbol("=>")) {
						return false;
					};

					name := option->GetText()->ToLower();
					value := Current();
					if(name->Equals("header") & (value->IsWord("true") | value->IsWord("false"))) {
						file->SetHeader(value->IsWord("true"));
					}
					else if(name->Equals("delimiter") & value->GetKind() = SqlToken->Kind->TEXT & (value->GetText()->Size() = 1 | value->GetText()->Equals("\\t"))) {
						if(value->GetText()->Size() = 1) {
							file->SetDelimiter(value->GetText()->Get(0));
						}
						else {
							file->SetDelimiter('\t');
						};
					}
					else if(name->Equals("row") & value->GetKind() = SqlToken->Kind->TEXT) {
						file->SetRow(value->GetText());
					}
					else if(name->Equals("first_row") & format->Equals("xlsx") & value->GetKind() = SqlToken->Kind->NUMBER &
							value->GetValue()->TypeOf(IntRef)) {
						file->SetFirstRow(value->GetValue()->As(IntRef)->Get());
					}
					else {
						Fail("an option: delimiter => 'c', header => true or false, row => 'element', first_row => n (xlsx)");
						return false;
					};
					Next();
				};

				if(<>ExpectSymbol(")")) {
					return false;
				};

				@ref_file := file;
				@ref_name := file->GetDefaultName();
				return true;
			};

			@ref_name := ParseName("a table name or a quoted file path");
			return @ref_name <> Nil;
		}

		# [AS] alias, or Nil when there is none
		method : ParseAlias() ~ String {
			if(Current()->IsWord("as")) {
				Next();
				return ParseName("an alias");
			};

			if(Current()->IsName() & <>IsClauseWord(Current())) {
				return ParseName("an alias");
			};

			return Nil;
		}

		method : ParseSelect(short_form : Bool) ~ SqlStatement {
			statement := SqlStatement->New(SqlStatement->Kind->QUERY);
			@statement := statement;
			if(short_form) {
				statement->SetStar();
			}
			else {
				if(Current()->IsWord("distinct")) {
					statement->SetDistinct();
					Next();
				};

				if(Current()->IsSymbol("*")) {
					statement->SetStar();
					Next();
				}
				else {
					done := false;
					while(<>done) {
						item : SqlItem;
						if(AtAggregate()) {
							item := ParseAggregate();
						}
						else {
							expr := ParseSum();
							if(expr <> Nil) {
								# a lone column is a plain item, as it always was
								item := expr->IsColumn() ? SqlItem->New(expr->GetName(), Nil) : SqlItem->New(expr);
							};
						};

						if(item = Nil) {
							return Nil;
						};

						alias_name := ParseAlias();
						if(@error <> Nil) {
							return Nil;
						};
						item->SetAlias(alias_name);
						statement->GetItems()->AddBack(item);

						if(Current()->IsSymbol(",")) {
							Next();
						}
						else {
							done := true;
						};
					};
				};
			};

			if(<>ExpectWord("from")) {
				return Nil;
			};

			if(<>ParseTable()) {
				return Nil;
			};
			statement->SetTableName(@ref_name);
			statement->SetFile(@ref_file);
			statement->SetAlias(ParseAlias());
			if(@error <> Nil) {
				return Nil;
			};

			# [INNER | LEFT [OUTER]] JOIN table [alias] ON a = b
			joining := true;
			while(joining) {
				is_left := false;
				if(Current()->IsWord("inner")) {
					Next();
					if(<>Current()->IsWord("join")) {
						return Fail("JOIN");
					};
				}
				else if(Current()->IsWord("left")) {
					is_left := true;
					Next();
					if(Current()->IsWord("outer")) {
						Next();
					};
					if(<>Current()->IsWord("join")) {
						return Fail("JOIN");
					};
				};

				if(Current()->IsWord("join")) {
					Next();
					if(<>ParseTable()) {
						return Nil;
					};
					join_table := @ref_name;
					join_file := @ref_file;
					join_alias := ParseAlias();
					if(@error <> Nil | <>ExpectWord("on")) {
						return Nil;
					};
					left_key := ParseName("a column name");
					if(left_key = Nil | <>ExpectSymbol("=")) {
						return Nil;
					};
					right_key := ParseName("a column name");
					if(right_key = Nil) {
						return Nil;
					};
					statement->GetJoins()->AddBack(SqlJoin->New(is_left, join_table, join_file, join_alias, left_key, right_key));
				}
				else {
					joining := false;
				};
			};

			if(Current()->IsWord("where")) {
				Next();
				where := ParseOr();
				if(where = Nil) {
					return Nil;
				};
				statement->SetWhere(where);
			};

			if(Current()->IsWord("group")) {
				Next();
				if(<>ExpectWord("by")) {
					return Nil;
				};

				grouping := true;
				while(grouping) {
					name := ParseName("a column name");
					if(name = Nil) {
						return Nil;
					};
					statement->GetGroup()->AddBack(name);

					if(Current()->IsSymbol(",")) {
						Next();
					}
					else {
						grouping := false;
					};
				};

				if(Current()->IsWord("having")) {
					Next();
					@in_having := true;
					having := ParseOr();
					@in_having := false;
					if(having = Nil) {
						return Nil;
					};
					statement->SetHaving(having);
				};
			};

			if(Current()->IsWord("order")) {
				Next();
				if(<>ExpectWord("by")) {
					return Nil;
				};

				ordering := true;
				while(ordering) {
					order_name : String;
					position := 0;
					if(Current()->GetKind() = SqlToken->Kind->NUMBER & Current()->GetValue()->TypeOf(IntRef)) {
						position := Current()->GetValue()->As(IntRef)->Get();
						if(position < 1) {
							return Fail("a select-list position from 1");
						};
						Next();
					}
					else if(AtAggregate()) {
						item := ParseAggregate();
						if(item = Nil) {
							return Nil;
						};
						NoteAggregate(item);
						order_name := item->GetCall();
					}
					else {
						order_name := ParseName("a column name, an aggregate or a position");
						if(order_name = Nil) {
							return Nil;
						};
					};

					descending := false;
					if(Current()->IsWord("desc")) {
						descending := true;
						Next();
					}
					else if(Current()->IsWord("asc")) {
						Next();
					};
					statement->GetOrder()->AddBack(SqlOrder->New(order_name, position, descending));

					if(Current()->IsSymbol(",")) {
						Next();
					}
					else {
						ordering := false;
					};
				};
			};

			if(Current()->IsWord("limit")) {
				Next();
				limit := ParseCount("a row count after LIMIT");
				if(limit < 0) {
					return Nil;
				};
				statement->SetLimit(limit);

				if(Current()->IsWord("offset")) {
					Next();
					offset := ParseCount("a row count after OFFSET");
					if(offset < 0) {
						return Nil;
					};
					statement->SetOffset(offset);
				};
			};

			return statement;
		}

		# a whole number of zero or more; -1 with the error set otherwise
		method : ParseCount(what : String) ~ Int {
			token := Current();
			if(token->GetKind() <> SqlToken->Kind->NUMBER | <>token->GetValue()->TypeOf(IntRef) | token->GetValue()->As(IntRef)->Get() < 0) {
				Fail(what);
				return -1;
			};
			Next();

			return token->GetValue()->As(IntRef)->Get();
		}

		# an aggregate named in HAVING or ORDER BY, remembered so it is computed even when the
		# select list does not show it
		method : NoteAggregate(item : SqlItem) ~ Nil {
			call := item->GetCall();
			extra := @statement->GetExtra();
			each(i : extra) {
				if(extra->Get(i)->GetCall()->Equals(call)) {
					return;
				};
			};
			extra->AddBack(item);
		}

		# or := and (OR and)*
		method : ParseOr() ~ Predicate {
			left := ParseAnd();
			if(left = Nil) {
				return Nil;
			};

			while(Current()->IsWord("or")) {
				Next();
				right := ParseAnd();
				if(right = Nil) {
					return Nil;
				};
				left := left->OrElse(right);
			};

			return left;
		}

		# and := unary (AND unary)*
		method : ParseAnd() ~ Predicate {
			left := ParseUnary();
			if(left = Nil) {
				return Nil;
			};

			while(Current()->IsWord("and")) {
				Next();
				right := ParseUnary();
				if(right = Nil) {
					return Nil;
				};
				left := left->AndAlso(right);
			};

			return left;
		}

		# unary := NOT unary | '(' or ')' | comparison
		method : ParseUnary() ~ Predicate {
			if(Current()->IsWord("not") & <>Ahead(1)->IsWord("like") & <>Ahead(1)->IsWord("matches") & <>Ahead(1)->IsWord("between") & <>Ahead(1)->IsWord("in")) {
				Next();
				inner := ParseUnary();
				if(inner = Nil) {
					return Nil;
				};
				return inner->Negate();
			};

			if(Current()->IsSymbol("(")) {
				Next();
				inner := ParseOr();
				if(inner = Nil | <>ExpectSymbol(")")) {
					return Nil;
				};
				return inner;
			};

			return ParseComparison();
		}

		# operand ([NOT] op value | [NOT] BETWEEN v AND v | [NOT] IN (v, ...) | IS [NOT] NULL)
		method : ParseComparison() ~ Predicate {
			name : String;
			if(AtAggregate()) {
				if(<>@in_having) {
					return FailCondition("a column name (aggregates belong in HAVING, not WHERE)");
				};
				item := ParseAggregate();
				if(item = Nil) {
					return Nil;
				};
				NoteAggregate(item);
				name := item->GetCall();
			}
			else {
				name := ParseName("a column name");
				if(name = Nil) {
					return Nil;
				};
			};

			if(Current()->IsWord("is")) {
				Next();
				negated := false;
				if(Current()->IsWord("not")) {
					negated := true;
					Next();
				};
				if(<>Current()->IsWord("null")) {
					return FailCondition("NULL");
				};
				Next();
				return Predicate->New(negated ? Op->NOT_NULL : Op->IS_NULL, name, Nil, 0);
			};

			negated := false;
			if(Current()->IsWord("not")) {
				negated := true;
				Next();
			};

			if(Current()->IsWord("between")) {
				Next();
				low := ParseConditionValue();
				if(low = Nil | <>ExpectWord("and")) {
					return Nil;
				};
				high := ParseConditionValue();
				if(high = Nil) {
					return Nil;
				};
				range := Predicate->New(Op->GE, name, low->GetValue(), low->GetParam())->AndAlso(Predicate->New(Op->LE, name, high->GetValue(), high->GetParam()));
				return negated ? range->Negate() : range;
			};

			if(Current()->IsWord("in")) {
				Next();
				if(<>ExpectSymbol("(")) {
					return Nil;
				};

				any : Predicate;
				listing := true;
				while(listing) {
					entry := ParseConditionValue();
					if(entry = Nil) {
						return Nil;
					};
					equal := Predicate->New(Op->EQ, name, entry->GetValue(), entry->GetParam());
					any := any = Nil ? equal : any->OrElse(equal);

					if(Current()->IsSymbol(",")) {
						Next();
					}
					else {
						listing := false;
					};
				};

				if(<>ExpectSymbol(")")) {
					return Nil;
				};
				return negated ? any->Negate() : any;
			};

			op := Op->AND;
			token := Current();
			if(token->IsWord("like")) {
				op := negated ? Op->NOT_LIKE : Op->LIKE;
			}
			else if(token->IsWord("matches")) {
				op := negated ? Op->NOT_MATCHES : Op->MATCHES;
			}
			else if(token->IsSymbol("=")) {
				op := negated ? Op->NE : Op->EQ;
			}
			else if(token->IsSymbol("<>")) {
				op := negated ? Op->EQ : Op->NE;
			}
			else if(token->IsSymbol("<")) {
				op := negated ? Op->GE : Op->LT;
			}
			else if(token->IsSymbol("<=")) {
				op := negated ? Op->GT : Op->LE;
			}
			else if(token->IsSymbol(">")) {
				op := negated ? Op->LE : Op->GT;
			}
			else if(token->IsSymbol(">=")) {
				op := negated ? Op->LT : Op->GE;
			}
			else {
				return FailCondition("a comparison (=, <>, <, <=, >, >=, LIKE, MATCHES, BETWEEN, IN or IS)");
			};
			Next();

			value := ParseConditionValue();
			if(value = Nil) {
				return Nil;
			};

			return Predicate->New(op, name, value->GetValue(), value->GetParam());
		}

		# a value in a condition. 'true' and 'false' read as 1 and 0, as the old engine read
		# them, so they match BOOL and INT columns; a bare word is a string, as it always was.
		method : ParseConditionValue() ~ SqlValue {
			token := Current();
			if(token->IsWord("true") | token->IsWord("false")) {
				Next();
				return SqlValue->New(IntRef->New(token->IsWord("true") ? 1 : 0), 0);
			};

			if(token->IsWord("null")) {
				Next();
				return SqlValue->New(Nil, 0);
			};

			if(token->GetKind() = SqlToken->Kind->WORD) {
				Next();
				return SqlValue->New(token->GetText(), 0);
			};

			return ParseLiteral();
		}

		# a value in VALUES or SET: 'true' and 'false' are Bool values, NULL is an empty cell
		method : ParseDataValue() ~ SqlValue {
			token := Current();
			if(token->IsWord("true") | token->IsWord("false")) {
				Next();
				return SqlValue->New(BoolRef->New(token->IsWord("true")), 0);
			};

			if(token->IsWord("null")) {
				Next();
				return SqlValue->New(Nil, 0);
			};

			return ParseLiteral();
		}

		method : ParseLiteral() ~ SqlValue {
			token := Current();
			select(token->GetKind()) {
				label SqlToken->Kind->TEXT:
				label SqlToken->Kind->NUMBER:
				label SqlToken->Kind->DATE: {
					Next();
					return SqlValue->New(token->GetValue(), 0);
				}

				label SqlToken->Kind->PARAM: {
					Next();
					return SqlValue->New(Nil, token->GetValue()->As(IntRef)->Get());
				}
			};

			Fail("a value");
			return Nil;
		}

		# INSERT INTO t [(cols)] VALUES (v, ...), ...
		method : ParseInsert() ~ SqlStatement {
			statement := SqlStatement->New(SqlStatement->Kind->INSERT);
			if(<>ExpectWord("into")) {
				return Nil;
			};

			table_name := ParseName("a table name");
			if(table_name = Nil) {
				return Nil;
			};
			statement->SetTableName(table_name);

			if(Current()->IsSymbol("(")) {
				Next();
				listing := true;
				while(listing) {
					name := ParseName("a column name");
					if(name = Nil) {
						return Nil;
					};
					statement->GetColumns()->AddBack(name);

					if(Current()->IsSymbol(",")) {
						Next();
					}
					else {
						listing := false;
					};
				};
				if(<>ExpectSymbol(")")) {
					return Nil;
				};
			};

			if(<>ExpectWord("values")) {
				return Nil;
			};

			rows := true;
			while(rows) {
				if(<>ExpectSymbol("(")) {
					return Nil;
				};

				row := Vector->New()<SqlValue>;
				listing := true;
				while(listing) {
					value := ParseDataValue();
					if(value = Nil) {
						return Nil;
					};
					row->AddBack(value);

					if(Current()->IsSymbol(",")) {
						Next();
					}
					else {
						listing := false;
					};
				};

				if(<>ExpectSymbol(")")) {
					return Nil;
				};
				statement->GetValues()->AddBack(row);

				if(Current()->IsSymbol(",")) {
					Next();
				}
				else {
					rows := false;
				};
			};

			return statement;
		}

		# UPDATE t SET c = v, ... [WHERE ...]
		method : ParseUpdate() ~ SqlStatement {
			statement := SqlStatement->New(SqlStatement->Kind->UPDATE);
			table_name := ParseName("a table name");
			if(table_name = Nil | <>ExpectWord("set")) {
				return Nil;
			};
			statement->SetTableName(table_name);

			row := Vector->New()<SqlValue>;
			listing := true;
			while(listing) {
				name := ParseName("a column name");
				if(name = Nil | <>ExpectSymbol("=")) {
					return Nil;
				};
				value := ParseDataValue();
				if(value = Nil) {
					return Nil;
				};
				statement->GetColumns()->AddBack(name);
				row->AddBack(value);

				if(Current()->IsSymbol(",")) {
					Next();
				}
				else {
					listing := false;
				};
			};
			statement->GetValues()->AddBack(row);

			if(Current()->IsWord("where")) {
				Next();
				where := ParseOr();
				if(where = Nil) {
					return Nil;
				};
				statement->SetWhere(where);
			};

			return statement;
		}

		# DELETE FROM t [WHERE ...]
		method : ParseDelete() ~ SqlStatement {
			statement := SqlStatement->New(SqlStatement->Kind->DELETE);
			if(<>ExpectWord("from")) {
				return Nil;
			};

			table_name := ParseName("a table name");
			if(table_name = Nil) {
				return Nil;
			};
			statement->SetTableName(table_name);

			if(Current()->IsWord("where")) {
				Next();
				where := ParseOr();
				if(where = Nil) {
					return Nil;
				};
				statement->SetWhere(where);
			};

			return statement;
		}

		# CREATE TABLE t (name type, ...) or CREATE INDEX
		method : ParseCreate() ~ SqlStatement {
			if(Current()->IsWord("index")) {
				Next();
				return ParseCreateIndex();
			};

			statement := SqlStatement->New(SqlStatement->Kind->CREATE);
			if(<>Current()->IsWord("table")) {
				return Fail("TABLE or INDEX");
			};
			Next();

			table_name := ParseName("a table name");
			if(table_name = Nil | <>ExpectSymbol("(")) {
				return Nil;
			};
			statement->SetTableName(table_name);

			listing := true;
			while(listing) {
				name := ParseName("a column name");
				if(name = Nil) {
					return Nil;
				};

				type_token := Current();
				if(type_token->GetKind() <> SqlToken->Kind->WORD | Plan->TypeFromName(type_token->GetText()) = ColumnType->NONE) {
					return Fail("a column type (INT, FLOAT, STRING, BOOL, DATE or OBJECT)");
				};
				Next();

				# VARCHAR(40) and the like: the length is accepted and ignored
				if(Current()->IsSymbol("(")) {
					Next();
					if(ParseCount("a length") < 0 | <>ExpectSymbol(")")) {
						return Nil;
					};
				};

				statement->GetColumns()->AddBack(name);
				statement->GetTypes()->AddBack(type_token->GetText());

				if(Current()->IsSymbol(",")) {
					Next();
				}
				else {
					listing := false;
				};
			};

			if(<>ExpectSymbol(")")) {
				return Nil;
			};

			return statement;
		}

		# CREATE INDEX [name] ON t (column) [USING HASH | SORTED]; SORTED when USING is left out
		method : ParseCreateIndex() ~ SqlStatement {
			statement := SqlStatement->New(SqlStatement->Kind->CREATE_INDEX);
			if(<>Current()->IsWord("on")) {
				index_name := ParseName("an index name or ON");
				if(index_name = Nil) {
					return Nil;
				};
				statement->SetIndexName(index_name);
			};

			if(<>ExpectWord("on")) {
				return Nil;
			};

			table_name := ParseName("a table name");
			if(table_name = Nil | <>ExpectSymbol("(")) {
				return Nil;
			};
			statement->SetTableName(table_name);

			column := ParseName("a column name");
			if(column = Nil | <>ExpectSymbol(")")) {
				return Nil;
			};
			statement->GetColumns()->AddBack(column);

			kind := "sorted";
			if(Current()->IsWord("using")) {
				Next();
				token := Current();
				if(token->IsWord("hash")) {
					kind := "hash";
				}
				else if(token->IsWord("sorted")) {
					kind := "sorted";
				}
				else if(token->IsWord("btree")) {
					return Fail("HASH or SORTED (a B+ tree index is not built yet; SORTED serves the same queries)");
				}
				else {
					return Fail("HASH or SORTED");
				};
				Next();
			};
			statement->GetTypes()->AddBack(kind);

			return statement;
		}

		# DROP INDEX name [ON t]
		method : ParseDrop() ~ SqlStatement {
			if(<>ExpectWord("index")) {
				return Nil;
			};

			statement := SqlStatement->New(SqlStatement->Kind->DROP_INDEX);
			index_name := ParseName("an index name");
			if(index_name = Nil) {
				return Nil;
			};
			statement->SetIndexName(index_name);

			if(Current()->IsWord("on")) {
				Next();
				table_name := ParseName("a table name");
				if(table_name = Nil) {
					return Nil;
				};
				statement->SetTableName(table_name);
			};

			return statement;
		}
	}

	# a file named in FROM or JOIN: its path (a glob may match several files), its format
	# ('' to take it from the extension) and the options a function form gave
	class : private : SqlFile {
		@path : String;
		@format : String;
		@delimiter : Char;
		@header : Bool;
		@row : String;
		@member : String;
		@first_row : Int;

		New(path : String, format : String) {
			@path := path;
			@format := format;
			@header := true;
		}

		# a member of an archive or a worksheet of a workbook ('data.zip'.'runs/a.csv',
		# 'book.xlsx'.'Q1'); Nil for the file itself
		method : public : GetMember() ~ String { return @member; }
		method : public : SetMember(member : String) ~ Nil { @member := member; }
		method : public : GetFirstRow() ~ Int { return @first_row; }
		method : public : SetFirstRow(row : Int) ~ Nil { @first_row := row; }
		method : public : GetPath() ~ String { return @path; }
		method : public : GetFormat() ~ String { return @format; }
		method : public : GetDelimiter() ~ Char { return @delimiter; }
		method : public : SetDelimiter(delimiter : Char) ~ Nil { @delimiter := delimiter; }
		method : public : HasHeader() ~ Bool { return @header; }
		method : public : SetHeader(header : Bool) ~ Nil { @header := header; }
		method : public : GetRow() ~ String { return @row; }
		method : public : SetRow(row : String) ~ Nil { @row := row; }

		# the cache key: the same path read another way is another table
		method : public : GetKey() ~ String {
			key := String->New(@format);
			key += "|";
			key += @delimiter->As(Int);
			key += @header ? "|h|" : "|n|";
			if(@row <> Nil) {
				key += @row;
			};
			key += "|";
			key += @first_row;
			key += "|";
			if(@member <> Nil) {
				# its length first, so no member and path can run together into another's
				key += @member->Size();
				key += ":";
				key += @member;
			};
			key += "|";
			key += @path;
			return key;
		}

		# a '?' in a URL starts its query string, so only a '*' in its path is a pattern
		method : public : IsGlob() ~ Bool {
			if(UrlCache->IsUrl(@path)) {
				return UrlCache->PathPart(@path)->Has('*');
			};

			return @path->Has('*') | @path->Has('?');
		}

		# the name a query uses for the table when it gives no alias: a member's or sheet's own
		# when it names one ('runs' for 'data.zip'.'2024/runs.csv', 'Q1' for 'book.xlsx'.'Q1')
		method : public : GetDefaultName() ~ String {
			base := SourceText->BaseName(@member <> Nil ? @member : @path, "file");
			if(@member <> Nil & FileTables->ContainerOf(@path)->Equals("xlsx")) {
				# a sheet name is not a file name: a '.' in it is not an extension
				base := @member;
			};
			name := "";
			each(i : base) {
				c := base->Get(i);
				if(c <> '*' & c <> '?') {
					name->Append(c);
				};
			};

			return name->Size() > 0 ? name : "files";
		}
	}

	# a file table a catalog has read, and the files' state when it read them. The stamp
	# tells a modification time in whole seconds, so a file rewritten within the second of
	# its last read, to the same size, keeps its stamp: an entry read while its files were
	# that recent (read_at within a second of the newest file: racy, as git calls it) also
	# keeps a digest of the files' bytes, and is served only while the files still digest
	# the same. An entry whose files were older when it was read needs none: a later write
	# lands in a later second and changes the stamp.
	class : private : FileEntry {
		@stamp : String;
		@table : Table;
		@read_at : Int;
		@digest : String;

		New(stamp : String, table : Table, read_at : Int, digest : String) {
			@stamp := stamp;
			@table := table;
			@read_at := read_at;
			@digest := digest;
		}

		method : public : GetStamp() ~ String {
			return @stamp;
		}

		method : public : GetTable() ~ Table {
			return @table;
		}

		# whether a write after this read could have kept the stamp: the newest file was
		# modified within a second of the read (a second either way for the clock the file
		# system stamps with, which may run a little behind)
		method : public : IsRacy(newest : Int) ~ Bool {
			return @read_at - newest <= 1;
		}

		method : public : GetDigest() ~ String {
			return @digest;
		}

		# the files digested the same at 'when': the entry is as good as read then
		method : public : SetReadAt(when : Int) ~ Nil {
			@read_at := when;
		}
	}

	# reading files named in SQL: globs, formats by extension, several files as one table
	class : private : FileTables {
		# the files a path names, sorted; a glob may match several, in its last part only
		function : Expand(path : String, error : StringHolder) ~ Vector<String> {
			files := Vector->New()<String>;
			if(path->Has('*') | path->Has('?')) {
				cut := -1;
				each(i : path) {
					c := path->Get(i);
					if(c = '/' | c = '\\') {
						cut := i;
					};
				};

				folder := cut < 0 ? "." : path->SubString(0, cut);
				pattern := path->SubString(cut + 1, path->Size() - cut - 1);
				if(folder->Has('*') | folder->Has('?')) {
					error->Set("'{$path}': a pattern may only be in the file name, not the folder");
					return Nil;
				};

				names := Directory->List(folder);
				if(names = Nil) {
					error->Set("'{$path}': cannot read folder '{$folder}'");
					return Nil;
				};

				matched := Vector->New()<String>;
				each(i : names) {
					name := names[i];
					if(<>name->Equals(".") & <>name->Equals("..") & GlobMatches(pattern, 0, name, 0)) {
						full := cut < 0 ? String->New(name) : "{$folder}/{$name}";
						if(<>Directory->Exists(full)) {
							matched->AddBack(full);
						};
					};
				};

				if(matched->Size() = 0) {
					error->Set("no files match '{$path}'");
					return Nil;
				};

				# in name order, so the rows come in a predictable order
				sorted := String->New[matched->Size()];
				each(i : sorted) {
					sorted[i] := matched->Get(i);
				};
				SortTexts(sorted);
				each(i : sorted) {
					files->AddBack(sorted[i]);
				};
			}
			else {
				if(<>File->Exists(path)) {
					error->Set("no file '{$path}'");
					return Nil;
				};
				files->AddBack(path);
			};

			return files;
		}

		# '*' matches any run of characters, '?' any one character
		function : GlobMatches(pattern : String, p : Int, text : String, t : Int) ~ Bool {
			while(p < pattern->Size()) {
				c := pattern->Get(p);
				if(c = '*') {
					for(k := t; k <= text->Size(); k += 1;) {
						if(GlobMatches(pattern, p + 1, text, k)) {
							return true;
						};
					};
					return false;
				};

				if(t >= text->Size() | (c <> '?' & c <> text->Get(t))) {
					return false;
				};
				p += 1;
				t += 1;
			};

			return t = text->Size();
		}

		function : SortTexts(values : String[]) ~ Nil {
			for(i := 1; i < values->Size(); i += 1;) {
				value := values[i];
				j := i - 1;
				while(j >= 0 & values[j]->Compare(value) > 0) {
					values[j + 1] := values[j];
					j -= 1;
				};
				values[j + 1] := value;
			};
		}

		# what a set of files looked like: names, sizes and modification times (in whole
		# seconds: see FileEntry for the write a stamp cannot tell)
		function : Stamp(files : Vector<String>) ~ String {
			stamp := "";
			each(i : files) {
				name := files->Get(i);
				size := File->Size(name);
				modified := File->ModifiedTime(name);
				when := modified <> Nil ? modified->ToString() : "";
				stamp += "{$name}|{$size}|{$when};";
			};

			return stamp;
		}

		# when the newest of the files was modified, in seconds since the Unix epoch
		function : Newest(files : Vector<String>) ~ Int {
			newest := 0;
			each(i : files) {
				modified := File->ModifiedTime(files->Get(i), true);
				if(modified <> Nil) {
					when := modified->GetUnixTime();
					if(when > newest) {
						newest := when;
					};
				};
			};

			return newest;
		}

		# the current time in seconds since the Unix epoch, on the clock file stamps use
		function : Now() ~ Int {
			return Date->New(true)->GetUnixTime();
		}

		# the files' bytes, digested: each file's size and CRC-32. Nil when one cannot be
		# read. Only a racy entry (FileEntry) is held to it, and only until its files are a
		# second old.
		function : Digest(files : Vector<String>) ~ String {
			digest := "";
			each(i : files) {
				data := FileReader->ReadBinaryFile(files->Get(i));
				if(data = Nil) {
					return Nil;
				};
				digest += "{$(data->Size())}:{$(Byte->CRC32(data))};";
			};

			return digest;
		}

		# the format of a file: the function form's, or its extension's (after any '.gz')
		function : FormatOf(file : SqlFile, path : String) ~ String {
			if(file->GetFormat()->Size() > 0) {
				return file->GetFormat();
			};

			lower := path->ToLower();
			if(UrlCache->IsUrl(lower)) {
				lower := UrlCache->PathPart(lower);
			};
			if(lower->EndsWith(".gz")) {
				lower := lower->SubString(0, lower->Size() - 3);
			};

			if(lower->EndsWith(".csv") | lower->EndsWith(".txt")) {
				return "csv";
			}
			else if(lower->EndsWith(".tsv")) {
				return "tsv";
			}
			else if(lower->EndsWith(".jsonl") | lower->EndsWith(".ndjson")) {
				return "jsonl";
			}
			else if(lower->EndsWith(".json")) {
				return "json";
			}
			else if(lower->EndsWith(".xml")) {
				return "xml";
			};

			return "";
		}

		# What a path names when it holds tables of its own: "archive" for a zip, tar or
		# gzipped tar, "xlsx" for a workbook, "" for a plain file. By name, as every file named
		# in SQL is read (ArchiveSource itself tells zip from tar by content).
		function : ContainerOf(path : String) ~ String {
			if(path = Nil) {
				return "";
			};

			lower := path->ToLower();
			if(UrlCache->IsUrl(lower)) {
				lower := UrlCache->PathPart(lower);
			};

			if(lower->EndsWith(".zip") | lower->EndsWith(".tar") | lower->EndsWith(".tgz") | lower->EndsWith(".tar.gz")) {
				return "archive";
			}
			else if(lower->EndsWith(".xlsx")) {
				return "xlsx";
			};

			return "";
		}

		# One file as a table. An archive alone is its listing; with a member, that member, read
		# by its extension or the function form's format; a workbook alone is its first
		# worksheet, and with a sheet that sheet. A member or sheet with '*' or '?' matches
		# several, read as one table with a '_member' or '_sheet' column. Archives and workbooks
		# are read within the limits given (bytes inflated per member, and in all).
		function : ReadOne(file : SqlFile, path : String, name : String, member_limit : Int, total_limit : Int, error : StringHolder) ~ Table {
			# by the file's own name: a glob's match, or a URL's path (its download's name is
			# the cache's)
			named := UrlCache->IsUrl(file->GetPath()) ? file->GetPath() : path;
			container := file->GetFormat()->Equals("xlsx") ? "xlsx" : ContainerOf(named);
			if(container->Equals("archive")) {
				return ReadArchive(file, path, name, member_limit, total_limit, error);
			}
			else if(container->Equals("xlsx")) {
				format := file->GetFormat();
				if(format->Size() > 0 & <>format->Equals("xlsx")) {
					error->Set("'{$(file->GetPath())}' is a workbook, which {$format}() does not read; name it plainly or with xlsx()");
					return Nil;
				};
				return ReadWorkbook(file, path, name, member_limit, total_limit, error);
			};

			if(file->GetMember() <> Nil) {
				error->Set("'{$(file->GetPath())}' is not an archive or a workbook, so it has no member '{$(file->GetMember())}': only .zip, .tar, .tar.gz, .tgz and .xlsx files have members");
				return Nil;
			};

			format := FormatOf(file, path);
			table : Table;
			reason : String;
			if(format->Equals("csv") | format->Equals("tsv")) {
				delimiter := file->GetDelimiter();
				if(delimiter = '\0') {
					delimiter := format->Equals("tsv") ? '\t' : ',';
				};
				source := CsvSource->New(path, name, delimiter);
				source->SetHeader(file->HasHeader());
				table := source->Read(Nil);
				reason := source->GetError();
			}
			else if(format->Equals("jsonl")) {
				source := JsonLinesSource->New(path, name);
				table := source->Read();
				reason := source->GetError();
			}
			else if(format->Equals("json")) {
				source := JsonSource->New(path, name);
				table := source->Read();
				reason := source->GetError();
			}
			else if(format->Equals("xml")) {
				if(file->GetRow() = Nil) {
					error->Set("'{$path}': an XML file needs its row element, as xml('{$path}', row => 'item')");
					return Nil;
				};
				source := XmlSource->New(path, name, file->GetRow());
				table := source->Read();
				reason := source->GetError();
			}
			else {
				error->Set("'{$path}': unknown file type; name it with csv(), tsv(), json(), jsonl(), xml() or xlsx()");
				return Nil;
			};

			if(table = Nil) {
				error->Set(reason);
			};

			return table;
		}

		function : IsPattern(text : String) ~ Bool {
			return text->Has('*') | text->Has('?');
		}

		# a source's error, pointing at what raises a limit from SQL
		function : ForSql(error : String) ~ String {
			if(error = Nil) {
				return Nil;
			};
			return error->ReplaceAll("(SetLimits raises it)", "(Catalog->SetArchiveLimits raises it)");
		}

		# an archive's listing, or members of it, through ArchiveSource and so with its checks:
		# unsafe paths, zip bombs, CRC32s and the limits
		function : ReadArchive(file : SqlFile, path : String, name : String, member_limit : Int, total_limit : Int, error : StringHolder) ~ Table {
			source := ArchiveSource->New(path);
			source->SetName(name);
			source->SetLimits(member_limit, total_limit);
			member := file->GetMember();
			format := file->GetFormat();
			if(member = Nil) {
				if(format->Size() > 0) {
					error->Set("'{$(file->GetPath())}' is an archive: name the member to read as {$format}, as {$format}('{$(file->GetPath())}'.'data.txt')");
					return Nil;
				};

				listing := source->List();
				if(listing = Nil) {
					error->Set(ForSql(source->GetError()));
				};
				return listing;
			};

			if(<>IsPattern(member)) {
				table := source->ReadMemberAs(member, format, file->GetDelimiter(), file->HasHeader(), file->GetRow(), name);
				if(table = Nil) {
					error->Set(ForSql(source->GetError()));
				};
				return table;
			};

			members := source->GetMembers();
			if(members = Nil) {
				error->Set(ForSql(source->GetError()));
				return Nil;
			};

			# each path once, in archive order: a tar may repeat one, and the last copy is read
			matched := Vector->New()<String>;
			each(i : members) {
				candidate := members[i];
				if(GlobMatches(member, 0, candidate, 0)) {
					seen := false;
					each(j : matched) {
						if(matched->Get(j)->Equals(candidate)) {
							seen := true;
						};
					};
					if(<>seen) {
						matched->AddBack(candidate);
					};
				};
			};

			if(matched->Size() = 0) {
				error->Set("no member of '{$(file->GetPath())}' matches '{$member}'");
				return Nil;
			};

			tables := Vector->New()<Table>;
			each(i : matched) {
				table := source->ReadMemberAs(matched->Get(i), format, file->GetDelimiter(), file->HasHeader(), file->GetRow(), name);
				if(table = Nil) {
					error->Set(ForSql(source->GetError()));
					return Nil;
				};
				tables->AddBack(table);
			};
			return Combine(name, tables, matched, "_member");
		}

		# a workbook's first worksheet, or the sheets named, through XlsxSource and so with
		# ArchiveSource's checks and the limits
		function : ReadWorkbook(file : SqlFile, path : String, name : String, member_limit : Int, total_limit : Int, error : StringHolder) ~ Table {
			if(file->GetFirstRow() < 0) {
				error->Set("'{$(file->GetPath())}': first_row is a sheet row number, from 1");
				return Nil;
			};

			sheet := file->GetMember();
			sheets := Vector->New()<String>;
			if(sheet = Nil | IsPattern(sheet)) {
				lister := XlsxSource->New(path);
				lister->SetLimits(member_limit, total_limit);
				names := lister->GetSheets();
				if(names = Nil) {
					error->Set(ForSql(lister->GetError()));
					return Nil;
				};

				each(i : names) {
					if(sheet = Nil) {
						if(sheets->Size() = 0) {
							sheets->AddBack(names[i]);
						};
					}
					else if(GlobMatches(sheet, 0, names[i], 0)) {
						sheets->AddBack(names[i]);
					};
				};

				if(sheets->Size() = 0) {
					if(sheet = Nil) {
						error->Set("'{$(file->GetPath())}' has no worksheets");
					}
					else {
						error->Set("no worksheet of '{$(file->GetPath())}' matches '{$sheet}'");
					};
					return Nil;
				};
			}
			else {
				sheets->AddBack(sheet);
			};

			tables := Vector->New()<Table>;
			each(i : sheets) {
				source := XlsxSource->New(path, sheets->Get(i));
				source->SetLimits(member_limit, total_limit);
				source->SetHeader(file->HasHeader());
				source->SetFirstRow(file->GetFirstRow());
				table := source->Read();
				if(table = Nil) {
					error->Set(ForSql(source->GetError()));
					return Nil;
				};
				tables->AddBack(table);
			};

			if(sheet <> Nil & IsPattern(sheet)) {
				return Combine(name, tables, sheets, "_sheet");
			};
			return Renamed(tables->Get(0), name);
		}

		# the rows of several tables as one, with a column ('_file', '_member' or '_sheet')
		# naming where each row came from, or none when 'tag' is Nil; a column some tables
		# lack is empty for their rows
		function : Combine(name : String, tables : Vector<Table>, files : Vector<String>, tag : String) ~ Table {
			names := Vector->New()<String>;
			each(t : tables) {
				columns := tables->Get(t)->GetColumnNames();
				for(c := 1; c < columns->Size(); c += 1;) {
					known := false;
					each(k : names) {
						if(names->Get(k)->Equals(columns[c])) {
							known := true;
						};
					};
					if(<>known) {
						names->AddBack(columns[c]);
					};
				};
			};
			if(tag <> Nil) {
				names->AddBack(tag);
			};

			column_names := String->New[names->Size()];
			each(i : column_names) {
				column_names[i] := names->Get(i);
			};

			combined := Table->New(name, column_names);
			file_column := column_names->Size();
			each(t : tables) {
				table := tables->Get(t);
				sources := Int->New[tag <> Nil ? column_names->Size() - 1 : column_names->Size()];
				each(c : sources) {
					sources[c] := table->GetIndex(column_names[c]);
				};

				rows := table->LiveRows();
				each(r : rows) {
					row := combined->Insert();
					each(c : sources) {
						if(sources[c] > 0) {
							value := table->GetColumn(sources[c])->Get(rows[r]);
							if(value <> Nil) {
								row->Set(c + 1, value);
							};
						};
					};
					if(tag <> Nil) {
						row->Set(file_column, files->Get(t));
					};
				};
			};

			return combined;
		}

		# a table under another name, sharing its columns
		function : Renamed(table : Table, name : String) ~ Table {
			names := table->GetColumnNames();
			data_names := String->New[names->Size() - 1];
			parts := Column->New[names->Size()];
			each(c : names) {
				parts[c] := table->GetColumn(c);
				if(c > 0) {
					data_names[c - 1] := names[c];
				};
			};

			return Table->Restore(name, data_names, parts, table->GetNextKey());
		}
	}

	# a parsed statement, cached by Table and Catalog and run as often as asked
	class : private : Plan {
		@statement : SqlStatement;

		New(statement : SqlStatement) {
			@statement := statement;
		}

		# parses a statement; Nil with 'error' set on a syntax error
		function : Parse(text : String, error : StringHolder) ~ Plan {
			parser := SqlParser->New();
			statement := parser->Parse(text);
			if(statement = Nil) {
				error->Set(parser->GetError());
				return Nil;
			};

			return Plan->New(statement);
		}

		method : public : GetParamCount() ~ Int {
			return @statement->GetParamCount();
		}

		# whether the statement is a SELECT, which returns rows
		method : public : IsQuery() ~ Bool {
			return @statement->GetKind() = SqlStatement->Kind->QUERY;
		}

		# a CREATE TABLE type name as a column type; NONE if it is not one
		function : TypeFromName(name : String) ~ ColumnType {
			lower := name->ToLower();
			if(lower->Equals("int") | lower->Equals("integer") | lower->Equals("bigint")) {
				return ColumnType->INT;
			}
			else if(lower->Equals("float") | lower->Equals("real") | lower->Equals("double")) {
				return ColumnType->FLOAT;
			}
			else if(lower->Equals("string") | lower->Equals("text") | lower->Equals("varchar") | lower->Equals("char")) {
				return ColumnType->STRING;
			}
			else if(lower->Equals("bool") | lower->Equals("boolean")) {
				return ColumnType->BOOL;
			}
			else if(lower->Equals("date") | lower->Equals("datetime") | lower->Equals("timestamp")) {
				return ColumnType->DATE;
			}
			else if(lower->Equals("object")) {
				return ColumnType->OBJECT;
			};

			return ColumnType->NONE;
		}

		# a SELECT over one table; a join needs a Catalog
		method : public : Run(table : Table, params : Compare[], error : StringHolder) ~ View {
			if(<>IsQuery()) {
				error->Set("only SELECT returns rows; run INSERT, UPDATE, DELETE and CREATE with Execute");
				return Nil;
			};

			if(@statement->GetJoins()->Size() > 0) {
				error->Set("a join reads more than one table; run it through a Catalog");
				return Nil;
			};

			if(@statement->GetFile() <> Nil) {
				error->Set("a file in FROM is read through a Catalog: Catalog->Run, or a catalog's Query");
				return Nil;
			};

			if(<>@statement->GetTableName()->Equals(table->GetName())) {
				error->Set("the query names table '{$(@statement->GetTableName())}', not '{$(table->GetName())}'");
				return Nil;
			};

			tables := Table->New[1];
			tables[0] := table;
			return SqlRun->New(@statement, tables, params, error)->Select();
		}

		# a SELECT over the tables of a catalog
		method : public : RunIn(catalog : Catalog, params : Compare[], error : StringHolder) ~ View {
			if(<>IsQuery()) {
				error->Set("only SELECT returns rows; run INSERT, UPDATE, DELETE and CREATE with Execute");
				return Nil;
			};

			joins := @statement->GetJoins();
			tables := Table->New[joins->Size() + 1];
			tables[0] := Source(catalog, @statement->GetTableName(), @statement->GetFile(), error);
			if(tables[0] = Nil) {
				return Nil;
			};

			each(i : joins) {
				join := joins->Get(i);
				tables[i + 1] := Source(catalog, join->GetTableName(), join->GetFile(), error);
				if(tables[i + 1] = Nil) {
					return Nil;
				};
			};

			return SqlRun->New(@statement, tables, params, error)->Select();
		}

		# INSERT, UPDATE or DELETE on one table: the number of rows changed, -1 on error
		method : public : Execute(table : Table, params : Compare[], error : StringHolder) ~ Int {
			if(IsQuery()) {
				error->Set("SELECT returns rows; run it with Query");
				return -1;
			};

			if(@statement->GetKind() = SqlStatement->Kind->CREATE) {
				error->Set("CREATE TABLE adds a table to a Catalog; run it through one");
				return -1;
			};

			# DROP INDEX may leave out the table
			name := @statement->GetTableName();
			if(name <> Nil & <>name->Equals(table->GetName())) {
				error->Set("the statement names table '{$name}', not '{$(table->GetName())}'");
				return -1;
			};

			return Change(table, params, error);
		}

		# how the statement reads its rows (see Table->Explain): a SELECT is run to find out; for
		# an UPDATE or DELETE the WHERE clause is planned but nothing changes
		method : public : Explain(table : Table, params : Compare[], error : StringHolder) ~ String {
			if(IsQuery()) {
				view := Run(table, params, error);
				if(view = Nil) {
					return Nil;
				};
				return view->GetPlan();
			};

			return ExplainChange(table, params, error);
		}

		# Explain, against a catalog's tables
		method : public : ExplainIn(catalog : Catalog, params : Compare[], error : StringHolder) ~ String {
			if(IsQuery()) {
				view := RunIn(catalog, params, error);
				if(view = Nil) {
					return Nil;
				};
				return view->GetPlan();
			};

			kind := @statement->GetKind();
			if(kind = SqlStatement->Kind->UPDATE | kind = SqlStatement->Kind->DELETE) {
				table := Lookup(catalog, @statement->GetTableName(), error);
				if(table = Nil) {
					return Nil;
				};
				return ExplainChange(table, params, error);
			};

			return ExplainChange(Nil, params, error);
		}

		method : ExplainChange(table : Table, params : Compare[], error : StringHolder) ~ String {
			kind := @statement->GetKind();
			if(kind = SqlStatement->Kind->UPDATE | kind = SqlStatement->Kind->DELETE) {
				where := @statement->GetWhere();
				if(where = Nil) {
					return "read {$(table->GetName())}: every row";
				};

				filter := Filter->Bind(where, table, params, error);
				if(filter = Nil) {
					return Nil;
				};
				return filter->Describe(table);
			};

			return "reads no rows";
		}

		# INSERT, UPDATE, DELETE or CREATE against a catalog
		method : public : ExecuteIn(catalog : Catalog, params : Compare[], error : StringHolder) ~ Int {
			if(IsQuery()) {
				error->Set("SELECT returns rows; run it with Query");
				return -1;
			};

			name := @statement->GetTableName();
			if(@statement->GetKind() = SqlStatement->Kind->CREATE) {
				if(catalog->Has(name)) {
					error->Set("a table named '{$name}' already exists");
					return -1;
				};

				columns := @statement->GetColumns();
				type_names := @statement->GetTypes();
				names := String->New[columns->Size()];
				types := ColumnType->New[columns->Size()];
				each(i : names) {
					names[i] := columns->Get(i);
					each(j : i) {
						if(names[j]->Equals(names[i])) {
							error->Set("column '{$(names[i])}' is named twice");
							return -1;
						};
					};
					types[i] := TypeFromName(type_names->Get(i));
				};
				# the check and the add are one step, so of threads creating one name at once one
				# succeeds
				if(<>catalog->AddNew(Table->New(name, names, types))) {
					error->Set("a table named '{$name}' already exists");
					return -1;
				};
				return 0;
			};

			# DROP INDEX without ON: the one table that has an index of that name
			if(@statement->GetKind() = SqlStatement->Kind->DROP_INDEX & name = Nil) {
				index_name := @statement->GetIndexName();
				found : Table;
				tables := catalog->GetNames();
				each(i : tables) {
					candidate := catalog->Get(tables[i]);
					if(candidate->FindIndex(index_name) <> Nil) {
						if(found <> Nil) {
							error->Set("tables '{$(found->GetName())}' and '{$(candidate->GetName())}' both have an index named '{$index_name}'; name the table with ON");
							return -1;
						};
						found := candidate;
					};
				};

				if(found = Nil) {
					error->Set("no index named '{$index_name}'");
					return -1;
				};

				return Change(found, params, error);
			};

			table := Lookup(catalog, name, error);
			if(table = Nil) {
				return -1;
			};

			return Change(table, params, error);
		}

		# a table of the catalog, or a file it reads through its cache
		method : Source(catalog : Catalog, name : String, file : SqlFile, error : StringHolder) ~ Table {
			if(file <> Nil) {
				return catalog->ReadFile(file, name, error);
			};

			return Lookup(catalog, name, error);
		}

		method : Lookup(catalog : Catalog, name : String, error : StringHolder) ~ Table {
			table := catalog->Get(name);
			if(table = Nil) {
				error->Set("no table named '{$name}'");
			};

			return table;
		}

		method : Change(table : Table, params : Compare[], error : StringHolder) ~ Int {
			select(@statement->GetKind()) {
				label SqlStatement->Kind->INSERT: {
					return Insert(table, params, error);
				}

				label SqlStatement->Kind->UPDATE: {
					return Update(table, params, error);
				}

				label SqlStatement->Kind->DELETE: {
					return Delete(table, params, error);
				}

				label SqlStatement->Kind->CREATE_INDEX: {
					kind := @statement->GetTypes()->Get(0)->Equals("hash") ? IndexKind->HASH : IndexKind->SORTED;
					if(<>table->CreateIndex(@statement->GetIndexName(), @statement->GetColumns()->Get(0), kind)) {
						error->Set(table->GetError());
						return -1;
					};
					return 0;
				}

				label SqlStatement->Kind->DROP_INDEX: {
					column := table->FindIndex(@statement->GetIndexName());
					if(column = Nil) {
						error->Set("table '{$(table->GetName())}' has no index named '{$(@statement->GetIndexName())}'");
						return -1;
					};
					table->DropIndex(column);
					return 0;
				}
			};

			error->Set("not a statement that changes a table");
			return -1;
		}

		# the rows a WHERE clause picks, or every live row; Nil on error
		method : Matching(table : Table, params : Compare[], error : StringHolder) ~ Int[] {
			where := @statement->GetWhere();
			if(where = Nil) {
				return table->LiveRows();
			};

			filter := Filter->Bind(where, table, params, error);
			if(filter = Nil) {
				return Nil;
			};

			return filter->Apply(table, Nil);
		}

		# column indexes for names, refusing unknown names and the key column; Nil on error
		method : Targets(table : Table, names : Vector<String>, error : StringHolder) ~ Int[] {
			indexes := Int->New[names->Size()];
			each(i : indexes) {
				index := table->GetIndex(names->Get(i));
				if(index < 0) {
					error->Set("unknown column '{$(names->Get(i))}'");
					return Nil;
				};

				if(index = 0) {
					error->Set("the key column 'pk' is assigned by the table and cannot be set");
					return Nil;
				};
				indexes[i] := index;
			};

			return indexes;
		}

		# all rows or none: a value a column refuses removes the rows already added
		method : Insert(table : Table, params : Compare[], error : StringHolder) ~ Int {
			# no column list: every column, in a list of its own; the statement's list belongs to a
			# cached plan, so filling it would fix this table's columns into the plan for good
			names := @statement->GetColumns();
			if(names->Size() = 0) {
				names := Vector->New()<String>;
				all := table->GetColumnNames();
				for(i := 1; i < all->Size(); i += 1;) {
					names->AddBack(all[i]);
				};
			};

			indexes := Targets(table, names, error);
			if(indexes = Nil) {
				return -1;
			};

			rows := @statement->GetValues();
			each(i : rows) {
				if(rows->Get(i)->Size() <> indexes->Size()) {
					error->Set("row {$(i + 1)} has {$(rows->Get(i)->Size())} values for {$(indexes->Size())} columns");
					return -1;
				};
			};

			added := Vector->New()<IntRef>;
			ok := BoolRef->New(true);
			each(i : rows) {
				values := rows->Get(i);
				row := table->Insert();
				added->AddBack(row->GetKey());
				each(j : indexes) {
					value := values->Get(j)->Resolve(params, ok);
					if(<>ok->Get()) {
						error->Set("no value bound for placeholder {$(values->Get(j)->GetParam())}");
						Undo(table, added);
						return -1;
					};

					if(<>row->Set(indexes[j], value)) {
						error->Set(table->GetColumn(indexes[j])->GetError());
						Undo(table, added);
						return -1;
					};
				};
			};

			return rows->Size();
		}

		method : Undo(table : Table, added : Vector<IntRef>) ~ Nil {
			each(i : added) {
				table->Delete(added->Get(i)->Get());
			};
		}

		# all cells or none: a value a column refuses puts back the cells already changed
		method : Update(table : Table, params : Compare[], error : StringHolder) ~ Int {
			indexes := Targets(table, @statement->GetColumns(), error);
			if(indexes = Nil) {
				return -1;
			};

			values := @statement->GetValues()->Get(0);
			resolved := Compare->New[indexes->Size()];
			ok := BoolRef->New(true);
			each(i : indexes) {
				resolved[i] := values->Get(i)->Resolve(params, ok);
				if(<>ok->Get()) {
					error->Set("no value bound for placeholder {$(values->Get(i)->GetParam())}");
					return -1;
				};
			};

			rows := Matching(table, params, error);
			if(rows = Nil) {
				return -1;
			};

			# the cells as they were, to put back if a later one is refused
			old_columns := Vector->New()<IntRef>;
			old_rows := Vector->New()<IntRef>;
			old_values := Vector->New()<Compare>;
			each(i : rows) {
				row := rows[i];
				each(j : indexes) {
					column := table->GetColumn(indexes[j]);
					old_columns->AddBack(indexes[j]);
					old_rows->AddBack(row);
					old_values->AddBack(column->Get(row));
					if(<>table->SetCell(row, indexes[j], resolved[j])) {
						error->Set(table->GetError() <> Nil ? table->GetError() : column->GetError());
						k := old_values->Size() - 1;
						while(k >= 0) {
							table->SetCell(old_rows->Get(k)->Get(), old_columns->Get(k)->Get(), old_values->Get(k));
							k -= 1;
						};
						return -1;
					};
				};
			};

			return rows->Size();
		}

		method : Delete(table : Table, params : Compare[], error : StringHolder) ~ Int {
			rows := Matching(table, params, error);
			if(rows = Nil) {
				return -1;
			};

			keys := table->GetColumn(0);
			each(i : rows) {
				table->Delete(keys->GetInt(rows[i]));
			};

			return rows->Size();
		}
	}

	# a list of row numbers, for code that needs an array of them
	class : private : SqlRows {
		@values : Int[];

		New(values : Int[]) {
			@values := values;
		}

		method : public : Get() ~ Int[] {
			return @values;
		}

		method : public : Set(values : Int[]) ~ Nil {
			@values := values;
		}
	}

	# a column a query names, found in one of the tables it reads
	class : private : SqlRef {
		@source : Int;
		@column : String;

		New(source : Int, column : String) {
			@source := source;
			@column := column;
		}

		method : public : GetSource() ~ Int {
			return @source;
		}

		method : public : GetColumn() ~ String {
			return @column;
		}
	}

	# one run of a SELECT: the pipeline is join, WHERE, GROUP BY and HAVING (or DISTINCT),
	# ORDER BY, LIMIT and OFFSET, then the select list
	class : private : SqlRun {
		@statement : SqlStatement;
		@tables : Table[];
		@aliases : String[];
		@params : Compare[];
		@error : StringHolder;
		@work : Table;
		@joined : Bool;
		@steps : Vector<String>;
		@computed : Int[];

		New(statement : SqlStatement, tables : Table[], params : Compare[], error : StringHolder) {
			@statement := statement;
			@tables := tables;
			@params := params;
			@error := error;
			@joined := tables->Size() > 1;
			@steps := Vector->New()<String>;

			joins := statement->GetJoins();
			@aliases := String->New[tables->Size()];
			@aliases[0] := statement->GetAlias() <> Nil ? statement->GetAlias() : statement->GetTableName();
			each(i : joins) {
				join := joins->Get(i);
				@aliases[i + 1] := join->GetAlias() <> Nil ? join->GetAlias() : join->GetTableName();
			};
		}

		method : Fail(message : String) ~ View {
			@error->Set(message);
			return Nil;
		}

		# a step of the plan View->GetPlan reports
		method : Note(step : String) ~ Nil {
			if(step <> Nil) {
				@steps->AddBack(step);
			};
		}

		method : PlanText() ~ String {
			text := "";
			each(i : @steps) {
				if(i > 0) {
					text += "; ";
				};
				text += @steps->Get(i);
			};
			return text;
		}

		# rows in a column's order, through its sorted index when it has one, else by sorting
		method : SortBy(index : Int, rows : Int[], descending : Bool) ~ Int[] {
			column := @work->GetColumn(index);
			ordered := @work->IndexOrder(index, rows, descending);
			if(ordered <> Nil) {
				Note("order {$(@work->GetName())}.{$(column->GetName())}: SORTED index {$(column->GetIndexName())}");
				return ordered;
			};

			return Sorter->New(column, descending)->Sort(rows);
		}

		# a name as a table and column: 'alias.column' when the alias is one of the query's
		# tables, otherwise a column name that exactly one table has (a dotted name such as a
		# flattened JSON field is a plain column name); Nil with the error set otherwise
		method : Resolve(name : String) ~ SqlRef {
			dot := name->Find('.');
			if(dot > 0) {
				prefix := name->SubString(0, dot);
				rest := name->SubString(dot + 1, name->Size() - dot - 1);
				each(s : @aliases) {
					if(@aliases[s]->Equals(prefix) & @tables[s]->GetIndex(rest) > -1) {
						return SqlRef->New(s, rest);
					};
				};
			};

			found : SqlRef;
			each(s : @tables) {
				if(@tables[s]->GetIndex(name) > -1) {
					if(found <> Nil) {
						@error->Set("column '{$name}' is in more than one table; name it as table.{$name}");
						return Nil;
					};
					found := SqlRef->New(s, name);
				};
			};

			if(found = Nil) {
				@error->Set("unknown column '{$name}'");
			};

			return found;
		}

		# the name a resolved column has in the working table
		method : WorkName(ref : SqlRef) ~ String {
			if(@joined) {
				return "{$(@aliases[ref->GetSource()])}.{$(ref->GetColumn())}";
			};

			return ref->GetColumn();
		}

		# a query's name for a column as its working-table index; -1 with the error set
		method : WorkIndex(name : String) ~ Int {
			ref := Resolve(name);
			if(ref = Nil) {
				return -1;
			};

			return @work->GetIndex(WorkName(ref));
		}

		# a condition with its column names replaced: by working-table names, or, for a
		# condition pushed below a join, by the plain names of that one table
		method : Rename(pred : Predicate, plain : Bool) ~ Predicate {
			op := pred->GetOp();
			if(op = Op->AND | op = Op->OR) {
				left := Rename(pred->GetLeft(), plain);
				right := Rename(pred->GetRight(), plain);
				if(left = Nil | right = Nil) {
					return Nil;
				};
				return Predicate->New(op, left, right);
			}
			else if(op = Op->NOT) {
				inner := Rename(pred->GetLeft(), plain);
				if(inner = Nil) {
					return Nil;
				};
				return inner->Negate();
			};

			ref := Resolve(pred->GetColumn());
			if(ref = Nil) {
				return Nil;
			};

			name := plain ? ref->GetColumn() : WorkName(ref);
			return Predicate->New(op, name, pred->GetValue(), pred->GetParam());
		}

		# the one table every column in a condition comes from; -1 for several, -2 on error
		method : SourceOf(pred : Predicate) ~ Int {
			op := pred->GetOp();
			if(op = Op->AND | op = Op->OR) {
				left := SourceOf(pred->GetLeft());
				right := SourceOf(pred->GetRight());
				if(left = -2 | right = -2) {
					return -2;
				};
				return left = right ? left : -1;
			}
			else if(op = Op->NOT) {
				return SourceOf(pred->GetLeft());
			};

			ref := Resolve(pred->GetColumn());
			if(ref = Nil) {
				return -2;
			};

			return ref->GetSource();
		}

		# the parts of a condition joined by AND
		function : Conjuncts(pred : Predicate, parts : Vector<Predicate>) ~ Nil {
			if(pred->GetOp() = Op->AND) {
				Conjuncts(pred->GetLeft(), parts);
				Conjuncts(pred->GetRight(), parts);
			}
			else {
				parts->AddBack(pred);
			};
		}

		method : public : Select() ~ View {
			# the tables need distinct names before columns can be told apart
			each(i : @aliases) {
				each(j : i) {
					if(@aliases[j]->Equals(@aliases[i])) {
						return Fail("table '{$(@aliases[i])}' appears twice; give each an alias");
					};
				};
			};

			where := @statement->GetWhere();
			rows : Int[];
			if(@joined) {
				where := Join(where);
				if(@work = Nil) {
					return Nil;
				};
			}
			else {
				@work := @tables[0];
			};

			if(where <> Nil) {
				renamed := Rename(where, false);
				if(renamed = Nil) {
					return Nil;
				};

				filter := Filter->Bind(renamed, @work, @params, @error);
				if(filter = Nil) {
					return Nil;
				};

				rows := filter->Apply(@work, Nil);
				Note(filter->GetPlan());
			}
			else {
				rows := @work->LiveRows();
				if(<>@joined) {
					Note("read {$(@work->GetName())}: every row");
				};
			};

			if(@statement->GetGroup()->Size() > 0 | @statement->HasAggregates()) {
				items := @statement->GetItems();
				each(i : items) {
					if(items->Get(i)->GetExpr() <> Nil) {
						return Fail("'{$(items->Get(i)->GetName())}': an expression in the select list of a grouped or aggregate query is not supported; compute it in a query over the grouped result");
					};
				};
				return Group(rows);
			};

			if(HasExpressions()) {
				rows := Computed(rows);
				if(rows = Nil) {
					return Nil;
				};
			};

			return Plain(rows);
		}

		method : HasExpressions() ~ Bool {
			if(@statement->IsStar()) {
				return false;
			};

			items := @statement->GetItems();
			each(i : items) {
				if(items->Get(i)->GetExpr() <> Nil) {
					return true;
				};
			};
			return false;
		}

		# the working-table index of a column an expression reads, or -1
		method : ExprIndex(name : String) ~ Int {
			index := -1;
			if(@joined) {
				index := WorkIndex(name);
			}
			else {
				index := @work->GetIndex(Strip(name));
			};
			@error->Set(Nil);
			return index;
		}

		# The select list's expressions computed over the rows that passed: the working table's
		# columns copied for those rows, in their order, with one column per expression after
		# them, which becomes the working table. Names and indexes of the copied columns are
		# the original's, so the rest of the query reads them as before. @computed gives each
		# item's column (-1 for a plain item). Nil with the error set.
		method : Computed(rows : Int[]) ~ Int[] {
			base := @work;
			names := base->GetColumnNames();
			columns := Int->New[names->Size() - 1];
			data_names := String->New[names->Size() - 1];
			each(i : columns) {
				columns[i] := i + 1;
				data_names[i] := names[i + 1];
			};

			items := @statement->GetItems();
			bound := Vector->New()<IntArrayRef>;
			each(i : items) {
				expr := items->Get(i)->GetExpr();
				indexes : Int[] := Nil;
				if(expr <> Nil) {
					reads := Vector->New()<String>;
					expr->AddColumns(reads);
					indexes := Int->New[reads->Size()];
					each(r : reads) {
						indexes[r] := ExprIndex(reads->Get(r));
						if(indexes[r] < 0) {
							Fail("unknown column '{$(reads->Get(r))}' in '{$(items->Get(i)->GetName())}'");
							return Nil;
						};
					};
				};
				bound->AddBack(IntArrayRef->New(indexes));
			};

			out := Table->Gather(base->GetName(), base, columns, data_names, rows);
			@computed := Int->New[items->Size()];
			each(i : items) {
				@computed[i] := -1;
				expr := items->Get(i)->GetExpr();
				if(expr <> Nil) {
					# a name no column has, so it shadows none
					slot := "#expr{$i}";
					while(out->GetIndex(slot) > -1) {
						slot += "#";
					};
					out->AddColumn(slot, ColumnType->NONE);
					index := out->GetIndex(slot);
					@computed[i] := index;
					indexes := bound->Get(i)->Get();
					each(r : rows) {
						value := expr->Eval(base, rows[r], indexes);
						if(value <> Nil) {
							out->SetCell(r, index, value);
						};
					};
				};
			};

			@work := out;
			return out->LiveRows();
		}

		#
		# Joins
		#

		# joins the tables into a working table of the columns the query uses, and returns the
		# part of the WHERE clause still to apply; @work stays Nil on error. A condition on one
		# table is applied to that table before the join, except on the right of a LEFT JOIN,
		# where an unmatched row must still reach the WHERE clause as empty cells.
		method : Join(where : Predicate) ~ Predicate {
			count := @tables->Size();
			joins := @statement->GetJoins();
			pushed := Predicate->New[count];
			remaining : Predicate;
			if(where <> Nil) {
				parts := Vector->New()<Predicate>;
				Conjuncts(where, parts);
				each(i : parts) {
					part := parts->Get(i);
					source := SourceOf(part);
					if(source = -2) {
						return Nil;
					};

					movable := source = 0 | (source > 0 & <>joins->Get(source - 1)->IsLeft());
					if(movable) {
						renamed := Rename(part, true);
						if(renamed = Nil) {
							return Nil;
						};
						pushed[source] := pushed[source] = Nil ? renamed : pushed[source]->AndAlso(renamed);
					}
					else {
						remaining := remaining = Nil ? part : remaining->AndAlso(part);
					};
				};
			};

			# each table's rows, after its own conditions
			base := SqlRows->New[count];
			each(s : base) {
				if(pushed[s] <> Nil) {
					filter := Filter->Bind(pushed[s], @tables[s], @params, @error);
					if(filter = Nil) {
						return Nil;
					};
					base[s] := SqlRows->New(filter->Apply(@tables[s], Nil));
					Note(filter->GetPlan());
				}
				else {
					Note("read {$(@tables[s]->GetName())}: every row");
					base[s] := SqlRows->New(@tables[s]->LiveRows());
				};
			};

			# positions: one row number per table, -1 where a LEFT JOIN found no match
			positions := SqlRows->New[count];
			positions[0] := base[0];
			size := base[0]->Get()->Size();
			each(k : joins) {
				join := joins->Get(k);
				right := k + 1;
				first := Resolve(join->GetLeftKey());
				second := Resolve(join->GetRightKey());
				if(first = Nil | second = Nil) {
					return Nil;
				};

				right_ref : SqlRef;
				left_ref : SqlRef;
				if(second->GetSource() = right & first->GetSource() < right) {
					left_ref := first;
					right_ref := second;
				}
				else if(first->GetSource() = right & second->GetSource() < right) {
					left_ref := second;
					right_ref := first;
				}
				else {
					@error->Set("the ON condition of the join with '{$(@aliases[right])}' must compare one of its columns with a column of an earlier table");
					return Nil;
				};

				matcher := SqlKeyMatcher->New(@tables[right]->GetColumn(right_ref->GetColumn()), base[right]->Get(),
					@tables[left_ref->GetSource()]->GetColumn(left_ref->GetColumn()));
				left_rows := positions[left_ref->GetSource()]->Get();

				# the matches of each position, kept in the left side's order, then the right's
				capacity := size > 16 ? size : 16;
				joined_rows := SqlRows->New[right + 1];
				each(s : joined_rows) {
					joined_rows[s] := SqlRows->New(Int->New[capacity]);
				};
				n := 0;
				for(i := 0; i < size; i += 1;) {
					start := -1;
					finish := -1;
					if(left_rows[i] > -1) {
						range := matcher->Find(left_rows[i]);
						if(range <> Nil) {
							start := range[0];
							finish := range[1];
						};
					};

					emit := finish - start;
					if(start < 0) {
						emit := join->IsLeft() ? 1 : 0;
					};

					if(n + emit > capacity) {
						while(n + emit > capacity) {
							capacity *= 2;
						};
						each(s : joined_rows) {
							joined_rows[s]->Set(Column->GrowInts(joined_rows[s]->Get(), capacity));
						};
					};

					for(e := 0; e < emit; e += 1;) {
						for(s := 0; s < right; s += 1;) {
							target := joined_rows[s]->Get();
							earlier := positions[s]->Get();
							target[n] := earlier[i];
						};
						target := joined_rows[right]->Get();
						target[n] := start < 0 ? -1 : matcher->RowAt(start + e);
						n += 1;
					};
				};

				each(s : joined_rows) {
					positions[s] := SqlRows->New(Filter->Trim(joined_rows[s]->Get(), n));
				};
				size := n;
			};

			# the working table holds only the columns the query reads
			wanted := Vector->New()<SqlRef>;
			if(<>Wanted(wanted, remaining)) {
				return Nil;
			};

			names := String->New[wanted->Size()];
			each(i : names) {
				names[i] := WorkName(wanted->Get(i));
			};

			work := Table->New("<join>", names);
			work->Fill(size);
			each(i : names) {
				ref := wanted->Get(i);
				source := @tables[ref->GetSource()];
				work->GetColumn(i + 1)->Gather(source->GetColumn(ref->GetColumn()), positions[ref->GetSource()]->Get());
			};
			@work := work;

			return remaining;
		}

		# adds a column to the working set once
		method : Want(wanted : Vector<SqlRef>, ref : SqlRef) ~ Nil {
			each(i : wanted) {
				known := wanted->Get(i);
				if(known->GetSource() = ref->GetSource() & known->GetColumn()->Equals(ref->GetColumn())) {
					return;
				};
			};
			wanted->AddBack(ref);
		}

		method : WantName(wanted : Vector<SqlRef>, name : String) ~ Bool {
			ref := Resolve(name);
			if(ref = Nil) {
				return false;
			};
			Want(wanted, ref);

			return true;
		}

		method : WantCondition(wanted : Vector<SqlRef>, pred : Predicate) ~ Bool {
			if(pred = Nil) {
				return true;
			};

			op := pred->GetOp();
			if(op = Op->AND | op = Op->OR) {
				return WantCondition(wanted, pred->GetLeft()) & WantCondition(wanted, pred->GetRight());
			}
			else if(op = Op->NOT) {
				return WantCondition(wanted, pred->GetLeft());
			};

			return WantName(wanted, pred->GetColumn());
		}

		# every column the rest of the query reads, in the order it shows them
		method : Wanted(wanted : Vector<SqlRef>, remaining : Predicate) ~ Bool {
			items := @statement->GetItems();
			if(@statement->IsStar()) {
				each(s : @tables) {
					names := @tables[s]->GetColumnNames();
					for(c := 1; c < names->Size(); c += 1;) {
						Want(wanted, SqlRef->New(s, names[c]));
					};
				};
			}
			else {
				each(i : items) {
					item := items->Get(i);
					expr := item->GetExpr();
					if(expr <> Nil) {
						reads := Vector->New()<String>;
						expr->AddColumns(reads);
						each(r : reads) {
							if(<>WantName(wanted, reads->Get(r))) {
								return false;
							};
						};
					}
					else if(<>item->GetName()->Equals("*") & <>WantName(wanted, item->GetName())) {
						return false;
					};
				};
			};

			extra := @statement->GetExtra();
			each(i : extra) {
				if(<>extra->Get(i)->GetName()->Equals("*") & <>WantName(wanted, extra->Get(i)->GetName())) {
					return false;
				};
			};

			group := @statement->GetGroup();
			each(i : group) {
				if(<>WantName(wanted, group->Get(i))) {
					return false;
				};
			};

			# an ORDER BY name may be a select-list label rather than a column
			order := @statement->GetOrder();
			each(i : order) {
				name := order->Get(i)->GetName();
				if(name <> Nil & ItemByLabel(name) < 0 & ItemByCall(name) < 0 & <>WantName(wanted, name)) {
					return false;
				};
			};

			return WantCondition(wanted, remaining);
		}

		# the select-list position whose label is 'name', or -1
		method : ItemByLabel(name : String) ~ Int {
			items := @statement->GetItems();
			each(i : items) {
				if(items->Get(i)->GetLabel()->Equals(name)) {
					return i;
				};
			};

			return -1;
		}

		# the select-list position of the aggregate written as 'call', or -1
		method : ItemByCall(call : String) ~ Int {
			items := @statement->GetItems();
			each(i : items) {
				item := items->Get(i);
				if(item->IsAggregate() & item->GetCall()->Equals(call)) {
					return i;
				};
			};

			return -1;
		}

		#
		# Results without grouping
		#

		method : Plain(rows : Int[]) ~ View {
			# the shown columns: working-table indexes and their labels
			columns : Int[];
			labels : String[];
			if(@statement->IsStar()) {
				if(@joined) {
					names := @work->GetColumnNames();
					columns := Int->New[names->Size() - 1];
					labels := String->New[columns->Size()];
					each(i : columns) {
						columns[i] := i + 1;
						labels[i] := names[i + 1];
					};
					Shorten(labels);
				}
				else {
					names := @work->GetColumnNames();
					columns := Int->New[names->Size() - 1];
					labels := String->New[columns->Size()];
					each(i : columns) {
						columns[i] := i + 1;
						labels[i] := names[i + 1];
					};
				};
			}
			else {
				items := @statement->GetItems();
				columns := Int->New[items->Size()];
				labels := String->New[items->Size()];
				each(i : items) {
					item := items->Get(i);
					if(item->GetExpr() <> Nil) {
						columns[i] := @computed[i];
					}
					else if(@joined) {
						columns[i] := WorkIndex(item->GetName());
						if(columns[i] < 0) {
							return Nil;
						};
					}
					else {
						# an unknown column reads as empty cells, as it always has
						columns[i] := @work->GetIndex(Strip(item->GetName()));
					};
					labels[i] := item->GetAlias() <> Nil ? item->GetAlias() : item->GetName();
				};

				if(@joined) {
					Shorten(labels);
				};
			};

			if(@statement->IsDistinct()) {
				if(<>@joined & columns->Size() = 1 & columns[0] > -1) {
					rows := @work->UniqueRows(columns[0], rows);
				}
				else {
					rows := Distinct(columns, rows);
				};
			};

			order := @statement->GetOrder();
			k := order->Size() - 1;
			while(k >= 0) {
				entry := order->Get(k);
				index := -1;
				if(entry->GetPosition() > 0) {
					if(entry->GetPosition() > columns->Size()) {
						return Fail("ORDER BY {$(entry->GetPosition())} is past the {$(columns->Size())} columns of the select list");
					};
					index := columns[entry->GetPosition() - 1];
				}
				else {
					position := LabelIndex(labels, entry->GetName());
					if(position > -1) {
						index := columns[position];
					}
					else if(@joined) {
						index := WorkIndex(entry->GetName());
						if(index < 0) {
							return Nil;
						};
					}
					else {
						# the old engine skipped an unknown ORDER BY column
						index := @work->GetIndex(Strip(entry->GetName()));
					};
				};

				if(index > -1) {
					rows := SortBy(index, rows, entry->IsDescending());
				};
				k -= 1;
			};

			view := View->New(@work, columns, labels, Slice(rows));
			view->SetPlan(PlanText());
			return view;
		}

		# 'alias.column' as 'column' when the alias names the one table, for a single table
		method : Strip(name : String) ~ String {
			if(@work->GetIndex(name) > -1) {
				return name;
			};

			ref := Resolve(name);
			if(ref = Nil) {
				# an unknown name stays as written; the caller decides what that means
				@error->Set(Nil);
				return name;
			};

			return ref->GetColumn();
		}

		function : LabelIndex(labels : String[], name : String) ~ Int {
			if(name = Nil) {
				return -1;
			};

			each(i : labels) {
				if(labels[i]->Equals(name)) {
					return i;
				};
			};

			return -1;
		}

		# 'alias.column' labels as 'column' where no other label has that column name
		method : Shorten(labels : String[]) ~ Nil {
			short := String->New[labels->Size()];
			each(i : labels) {
				short[i] := labels[i];
				ref := Resolve(labels[i]);
				if(ref <> Nil) {
					short[i] := ref->GetColumn();
				}
				else {
					@error->Set(Nil);
					dot := labels[i]->Find('.');
					if(dot > 0) {
						prefix := labels[i]->SubString(0, dot);
						each(s : @aliases) {
							if(@aliases[s]->Equals(prefix)) {
								short[i] := labels[i]->SubString(dot + 1, labels[i]->Size() - dot - 1);
							};
						};
					};
				};
			};

			each(i : labels) {
				clash := false;
				each(j : labels) {
					if(i <> j & short[i]->Equals(short[j])) {
						clash := true;
					};
				};

				if(<>clash) {
					labels[i] := short[i];
				};
			};
		}

		# LIMIT and OFFSET
		method : Slice(rows : Int[]) ~ Int[] {
			offset := @statement->GetOffset();
			limit := @statement->GetLimit();
			if(offset = 0 & (limit < 0 | limit >= rows->Size())) {
				return rows;
			};

			start := offset < rows->Size() ? offset : rows->Size();
			count := rows->Size() - start;
			if(limit > -1 & limit < count) {
				count := limit;
			};

			sliced := Int->New[count];
			each(i : count) {
				sliced[i] := rows[start + i];
			};

			return sliced;
		}

		# the first row of each distinct combination of the shown columns, in first-seen order
		method : Distinct(columns : Int[], rows : Int[]) ~ Int[] {
			sorters := Vector->New()<Sorter>;
			each(i : columns) {
				if(columns[i] > -1) {
					sorters->AddBack(Sorter->New(@work->GetColumn(columns[i]), false));
				};
			};

			ordered := rows;
			k := sorters->Size() - 1;
			while(k >= 0) {
				ordered := sorters->Get(k)->Sort(ordered);
				k -= 1;
			};

			firsts := Int->New[ordered->Size()];
			n := 0;
			each(i : ordered) {
				if(i = 0 | Differs(sorters, ordered[i - 1], ordered[i])) {
					firsts[n] := ordered[i];
					n += 1;
				};
			};

			# back to the order the rows came in
			return SortInts(Filter->Trim(firsts, n));
		}

		function : Differs(sorters : Vector<Sorter>, a : Int, b : Int) ~ Bool {
			each(i : sorters) {
				if(sorters->Get(i)->Compare(a, b) <> 0) {
					return true;
				};
			};

			return false;
		}

		# a stable merge sort of row numbers, smallest first
		function : SortInts(values : Int[]) ~ Int[] {
			size := values->Size();
			src := Int->New[size];
			each(i : size) {
				src[i] := values[i];
			};
			dest := Int->New[size];

			width := 1;
			while(width < size) {
				start := 0;
				while(start < size) {
					middle := start + width;
					if(middle > size) {
						middle := size;
					};
					finish := start + width * 2;
					if(finish > size) {
						finish := size;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						if(l < middle & (r >= finish | src[l] <= src[r])) {
							dest[k] := src[l];
							l += 1;
						}
						else {
							dest[k] := src[r];
							r += 1;
						};
						k += 1;
					};
					start := finish;
				};

				swap := src;
				src := dest;
				dest := swap;
				width *= 2;
			};

			return src;
		}

		#
		# GROUP BY, aggregates and HAVING
		#

		method : Group(rows : Int[]) ~ View {
			if(@statement->IsStar()) {
				return Fail("SELECT * cannot be grouped; name the columns");
			};

			# the grouping columns
			group := @statement->GetGroup();
			keys := Int->New[group->Size()];
			each(i : keys) {
				keys[i] := WorkIndex(group->Get(i));
				if(keys[i] < 0) {
					return Nil;
				};
			};

			# a plain column in the select list must be one of them
			items := @statement->GetItems();
			each(i : items) {
				item := items->Get(i);
				if(<>item->IsAggregate()) {
					index := WorkIndex(item->GetName());
					if(index < 0) {
						return Nil;
					};

					grouped := false;
					each(j : keys) {
						if(keys[j] = index) {
							grouped := true;
						};
					};

					if(<>grouped) {
						return Fail("column '{$(item->GetName())}' must be in GROUP BY or inside an aggregate");
					};
				};
			};

			# rows sorted by the grouping columns, so each group is a run
			sorters := Vector->New()<Sorter>;
			each(i : keys) {
				sorters->AddBack(Sorter->New(@work->GetColumn(keys[i]), false));
			};

			ordered := rows;
			k := sorters->Size() - 1;
			while(k >= 0) {
				ordered := SortBy(keys[k], ordered, false);
				k -= 1;
			};

			# a start per group and an end; with no rows there is still one group
			starts := Int->New[ordered->Size() + 2];
			groups := 0;
			each(i : ordered) {
				if(i = 0 | Differs(sorters, ordered[i - 1], ordered[i])) {
					starts[groups] := i;
					groups += 1;
				};
			};

			# without GROUP BY every row is one group, even no rows at all
			if(keys->Size() = 0) {
				groups := 1;
				starts[0] := 0;
			};
			starts[groups] := ordered->Size();

			# the result: the select list, then aggregates only HAVING or ORDER BY name
			extra := @statement->GetExtra();
			hidden := Vector->New()<SqlItem>;
			each(i : extra) {
				if(ItemByCall(extra->Get(i)->GetCall()) < 0) {
					hidden->AddBack(extra->Get(i));
				};
			};

			all := Vector->New()<SqlItem>;
			each(i : items) {
				all->AddBack(items->Get(i));
			};
			each(i : hidden) {
				all->AddBack(hidden->Get(i));
			};

			labels := String->New[all->Size()];
			each(i : labels) {
				labels[i] := all->Get(i)->GetLabel();
				if(<>@joined & <>all->Get(i)->IsAggregate() & all->Get(i)->GetAlias() = Nil) {
					labels[i] := Strip(labels[i]);
				};
			};
			if(@joined) {
				Shorten(labels);
			};

			out := Table->New("<rs>", labels);
			out->Fill(groups);
			firsts := Int->New[groups];
			each(g : groups) {
				firsts[g] := starts[g] < ordered->Size() ? ordered[starts[g]] : -1;
			};

			each(i : all) {
				item := all->Get(i);
				column := out->GetColumn(i + 1);
				if(item->IsAggregate()) {
					source : Column;
					if(<>item->GetName()->Equals("*")) {
						index := WorkIndex(item->GetName());
						if(index < 0) {
							return Nil;
						};
						source := @work->GetColumn(index);
					};
					Aggregate(column, item->GetFunc(), source, ordered, starts, groups);
				}
				else {
					column->Gather(@work->GetColumn(WorkIndex(item->GetName())), firsts);
				};
			};

			result := out->LiveRows();
			having := @statement->GetHaving();
			if(having <> Nil) {
				renamed := Relabel(having, labels);
				if(renamed = Nil) {
					return Nil;
				};

				filter := Filter->Bind(renamed, out, @params, @error);
				if(filter = Nil) {
					return Nil;
				};
				result := filter->Apply(out, result);
			};

			order := @statement->GetOrder();
			k := order->Size() - 1;
			while(k >= 0) {
				entry := order->Get(k);
				index := -1;
				if(entry->GetPosition() > 0) {
					if(entry->GetPosition() > items->Size()) {
						return Fail("ORDER BY {$(entry->GetPosition())} is past the {$(items->Size())} columns of the select list");
					};
					index := entry->GetPosition();
				}
				else {
					position := ResultIndex(entry->GetName(), labels);
					if(position < 0) {
						return Fail("ORDER BY '{$(entry->GetName())}' is not a column of the grouped result");
					};
					index := position + 1;
				};

				result := Sorter->New(out->GetColumn(index), entry->IsDescending())->Sort(result);
				k -= 1;
			};

			shown := Int->New[items->Size()];
			shown_labels := String->New[items->Size()];
			each(i : shown) {
				shown[i] := i + 1;
				shown_labels[i] := labels[i];
			};

			view := View->New(out, shown, shown_labels, Slice(result));
			view->SetPlan(PlanText());
			return view;
		}

		# where a HAVING or ORDER BY name is in the grouped result: a label, an aggregate call,
		# or a grouping column however it was written; -1 if none
		method : ResultIndex(name : String, labels : String[]) ~ Int {
			position := LabelIndex(labels, name);
			if(position > -1) {
				return position;
			};

			position := ItemByCall(name);
			if(position > -1) {
				return position;
			};

			extras := @statement->GetExtra();
			each(i : extras) {
				extra := extras->Get(i);
				if(extra->GetCall()->Equals(name)) {
					return LabelIndex(labels, extra->GetLabel());
				};
			};

			ref := Resolve(name);
			if(ref = Nil) {
				@error->Set(Nil);
				return -1;
			};

			items := @statement->GetItems();
			each(i : items) {
				item := items->Get(i);
				if(<>item->IsAggregate()) {
					other_ref := Resolve(item->GetName());
					if(other_ref <> Nil & other_ref->GetSource() = ref->GetSource() & other_ref->GetColumn()->Equals(ref->GetColumn())) {
						return i;
					};
				};
			};
			@error->Set(Nil);

			return -1;
		}

		# a HAVING condition with its names as result-column labels
		method : Relabel(pred : Predicate, labels : String[]) ~ Predicate {
			op := pred->GetOp();
			if(op = Op->AND | op = Op->OR) {
				left := Relabel(pred->GetLeft(), labels);
				right := Relabel(pred->GetRight(), labels);
				if(left = Nil | right = Nil) {
					return Nil;
				};
				return Predicate->New(op, left, right);
			}
			else if(op = Op->NOT) {
				inner := Relabel(pred->GetLeft(), labels);
				if(inner = Nil) {
					return Nil;
				};
				return inner->Negate();
			};

			position := ResultIndex(pred->GetColumn(), labels);
			if(position < 0) {
				@error->Set("HAVING names '{$(pred->GetColumn())}', which is not a column of the grouped result");
				return Nil;
			};

			return Predicate->New(op, labels[position], pred->GetValue(), pred->GetParam());
		}

		# one aggregate per group, into a result column. COUNT counts; the others read numbers
		# only and skip empty and non-numeric cells, so a group with none gets an empty cell.
		method : Aggregate(column : Column, func : String, source : Column, ordered : Int[], starts : Int[], groups : Int) ~ Nil {
			ints := Int->New[groups];
			floats := Float->New[groups];
			present := Bool->New[groups];

			if(func->Equals("count")) {
				each(g : groups) {
					if(source = Nil) {
						ints[g] := starts[g + 1] - starts[g];
					}
					else {
						n := 0;
						for(i := starts[g]; i < starts[g + 1]; i += 1;) {
							if(<>source->IsNull(ordered[i])) {
								n += 1;
							};
						};
						ints[g] := n;
					};
					present[g] := true;
				};
				column->FillNumbers(ColumnType->INT, ints, floats, present);
				return;
			};

			whole := source->GetType() = ColumnType->INT;
			integral := whole & (func->Equals("sum") | func->Equals("min") | func->Equals("max"));
			each(g : groups) {
				values := Float->New[starts[g + 1] - starts[g]];
				int_sum := 0;
				int_min := 0;
				int_max := 0;
				n := 0;
				for(i := starts[g]; i < starts[g + 1]; i += 1;) {
					row := ordered[i];
					if(source->IsNumeric(row)) {
						if(whole) {
							value := source->GetInt(row);
							if(n = 0 | value < int_min) {
								int_min := value;
							};
							if(n = 0 | value > int_max) {
								int_max := value;
							};
							int_sum += value;
						};
						values[n] := source->GetFloat(row);
						n += 1;
					};
				};

				if(n > 0) {
					if(integral) {
						present[g] := true;
						if(func->Equals("sum")) {
							ints[g] := int_sum;
						}
						else if(func->Equals("min")) {
							ints[g] := int_min;
						}
						else {
							ints[g] := int_max;
						};
					}
					else {
						result := Summarize(func, values, n);
						if(result <> Nil) {
							present[g] := true;
							floats[g] := result->Get();
						};
					};
				};
			};

			column->FillNumbers(integral ? ColumnType->INT : ColumnType->FLOAT, ints, floats, present);
		}

		# sum, avg, min, max, median or stddev (the sample deviation, which needs two values)
		# of the first n values; Nil when there is no answer
		function : Summarize(func : String, values : Float[], n : Int) ~ FloatRef {
			if(func->Equals("sum") | func->Equals("avg")) {
				total := 0.0;
				each(i : n) {
					total += values[i];
				};
				return FloatRef->New(func->Equals("sum") ? total : total / n->As(Float));
			}
			else if(func->Equals("min") | func->Equals("max")) {
				best := values[0];
				for(i := 1; i < n; i += 1;) {
					if(func->Equals("min") ? values[i] < best : values[i] > best) {
						best := values[i];
					};
				};
				return FloatRef->New(best);
			}
			else if(func->Equals("median")) {
				sorted := SortFloats(values, n);
				middle := n / 2;
				if(n % 2 = 1) {
					return FloatRef->New(sorted[middle]);
				};
				return FloatRef->New((sorted[middle - 1] + sorted[middle]) / 2.0);
			}
			else if(func->Equals("stddev")) {
				if(n < 2) {
					return Nil;
				};

				# Welford's running mean and squared deviation
				mean := 0.0;
				squares := 0.0;
				each(i : n) {
					delta := values[i] - mean;
					mean += delta / (i + 1)->As(Float);
					squares += delta * (values[i] - mean);
				};
				return FloatRef->New((squares / (n - 1)->As(Float))->Sqrt());
			};

			return Nil;
		}

		# the first n values, smallest first
		function : SortFloats(values : Float[], n : Int) ~ Float[] {
			src := Float->New[n];
			each(i : n) {
				src[i] := values[i];
			};
			dest := Float->New[n];

			width := 1;
			while(width < n) {
				start := 0;
				while(start < n) {
					middle := start + width;
					if(middle > n) {
						middle := n;
					};
					finish := start + width * 2;
					if(finish > n) {
						finish := n;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						if(l < middle & (r >= finish | src[l] <= src[r])) {
							dest[k] := src[l];
							l += 1;
						}
						else {
							dest[k] := src[r];
							r += 1;
						};
						k += 1;
					};
					start := finish;
				};

				swap := src;
				src := dest;
				dest := swap;
				width *= 2;
			};

			return src;
		}
	}

	# equality matching for a join: the right side's rows sorted by key, found by binary search.
	# Keys compare as whole numbers when both sides hold INT, BOOL or DATE values, as numbers
	# when one side holds FLOAT, and as text otherwise. Empty cells never match.
	class : private : SqlKeyMatcher {
		#~
		How a join compares its keys.
		~#
		enum Domain {
			#~
			As whole numbers: both sides hold INT, BOOL or DATE values.
			~#
			WHOLE,
			#~
			As numbers: one side holds FLOAT values.
			~#
			NUMBER,
			#~
			As text, otherwise.
			~#
			TEXT
		}

		@domain : SqlKeyMatcher->Domain;
		@left : Column;
		@rows : Int[];
		@int_keys : Int[];
		@float_keys : Float[];
		@size : Int;
		@ids : Hash<String, IntRef>;
		@code_ids : Int[];

		New(right : Column, right_rows : Int[], left : Column) {
			@left := left;
			right_type := right->GetType();
			left_type := left->GetType();
			if(IsWhole(right_type) & IsWhole(left_type)) {
				@domain := SqlKeyMatcher->Domain->WHOLE;
			}
			else if(IsNumber(right_type) & IsNumber(left_type)) {
				@domain := SqlKeyMatcher->Domain->NUMBER;
			}
			else {
				@domain := SqlKeyMatcher->Domain->TEXT;
				@ids := Hash->New()<String, IntRef>;
			};

			# the right side's keyed rows
			count := right_rows->Size();
			rows := Int->New[count];
			ints := Int->New[count];
			floats := Float->New[count];
			n := 0;
			each(i : count) {
				row := right_rows[i];
				if(<>right->IsNull(row)) {
					select(@domain) {
						label SqlKeyMatcher->Domain->WHOLE: {
							rows[n] := row;
							ints[n] := right->GetInt(row);
							n += 1;
						}

						label SqlKeyMatcher->Domain->NUMBER: {
							value := right->GetFloat(row);
							# NaN equals nothing, and would break the ordering
							if(value = value) {
								rows[n] := row;
								floats[n] := value;
								n += 1;
							};
						}

						label SqlKeyMatcher->Domain->TEXT: {
							text := KeyText(right, row);
							id := @ids->Find(text);
							if(id = Nil) {
								id := IntRef->New(@ids->Size());
								@ids->Insert(text, id);
							};
							rows[n] := row;
							ints[n] := id->Get();
							n += 1;
						}
					};
				};
			};
			@size := n;

			order := Order(ints, floats, n);
			@rows := Int->New[n];
			@int_keys := Int->New[n];
			@float_keys := Float->New[n];
			each(i : n) {
				@rows[i] := rows[order[i]];
				@int_keys[i] := ints[order[i]];
				@float_keys[i] := floats[order[i]];
			};

			if(@domain = SqlKeyMatcher->Domain->TEXT & left->IsEncoded()) {
				# a dictionary code's id, looked up once per code
				@code_ids := Int->New[left->GetDictionarySize()];
				each(i : @code_ids) {
					@code_ids[i] := -2;
				};
			};
		}

		function : IsWhole(type : ColumnType) ~ Bool {
			return type = ColumnType->INT | type = ColumnType->BOOL | type = ColumnType->DATE;
		}

		function : IsNumber(type : ColumnType) ~ Bool {
			return type = ColumnType->INT | type = ColumnType->FLOAT;
		}

		function : KeyText(column : Column, row : Int) ~ String {
			if(column->GetType() = ColumnType->STRING) {
				return column->GetString(row);
			};

			return Cell->Text(column->Get(row));
		}

		# positions 0..n-1 in key order, keeping row order among equal keys
		method : Order(ints : Int[], floats : Float[], n : Int) ~ Int[] {
			src := Int->New[n];
			each(i : n) {
				src[i] := i;
			};
			dest := Int->New[n];
			by_float := @domain = SqlKeyMatcher->Domain->NUMBER;

			width := 1;
			while(width < n) {
				start := 0;
				while(start < n) {
					middle := start + width;
					if(middle > n) {
						middle := n;
					};
					finish := start + width * 2;
					if(finish > n) {
						finish := n;
					};

					l := start;
					r := middle;
					k := start;
					while(k < finish) {
						take_left := l < middle;
						if(take_left & r < finish) {
							if(by_float) {
								take_left := floats[src[l]] <= floats[src[r]];
							}
							else {
								take_left := ints[src[l]] <= ints[src[r]];
							};
						};

						if(take_left) {
							dest[k] := src[l];
							l += 1;
						}
						else {
							dest[k] := src[r];
							r += 1;
						};
						k += 1;
					};
					start := finish;
				};

				swap := src;
				src := dest;
				dest := swap;
				width *= 2;
			};

			return src;
		}

		# the right row at a position Find returned
		method : public : RowAt(position : Int) ~ Int {
			return @rows[position];
		}

		# the [start, end) positions whose key equals the left row's, or Nil for none
		method : public : Find(left_row : Int) ~ Int[] {
			if(@left->IsNull(left_row) | @size = 0) {
				return Nil;
			};

			select(@domain) {
				label SqlKeyMatcher->Domain->WHOLE: {
					return RangeOf(@left->GetInt(left_row));
				}

				label SqlKeyMatcher->Domain->NUMBER: {
					key := @left->GetFloat(left_row);
					if(key <> key) {
						return Nil;
					};

					low := 0;
					high := @size;
					while(low < high) {
						middle := (low + high) / 2;
						if(@float_keys[middle] < key) {
							low := middle + 1;
						}
						else {
							high := middle;
						};
					};

					finish := low;
					while(finish < @size & @float_keys[finish] = key) {
						finish += 1;
					};

					if(finish = low) {
						return Nil;
					};
					return [low, finish];
				}
			};

			# text: the left value's id among the right side's texts
			id := -1;
			if(@code_ids <> Nil) {
				code := @left->GetCode(left_row);
				if(@code_ids[code] = -2) {
					found := @ids->Find(@left->GetString(left_row));
					@code_ids[code] := found = Nil ? -1 : found->Get();
				};
				id := @code_ids[code];
			}
			else {
				found := @ids->Find(KeyText(@left, left_row));
				if(found <> Nil) {
					id := found->Get();
				};
			};

			if(id < 0) {
				return Nil;
			};

			return RangeOf(id);
		}

		method : RangeOf(key : Int) ~ Int[] {
			low := 0;
			high := @size;
			while(low < high) {
				middle := (low + high) / 2;
				if(@int_keys[middle] < key) {
					low := middle + 1;
				}
				else {
					high := middle;
				};
			};

			finish := low;
			while(finish < @size & @int_keys[finish] = key) {
				finish += 1;
			};

			if(finish = low) {
				return Nil;
			};

			return [low, finish];
		}
	}


	class Parser {
		@line : String;
		@tokens : Vector<Token>;
		@tokens_index : Int;
		@cur_token : Token;
		@reserved : Map<String, Token>;

		New(line : String) {
			@line := line;

			@reserved := Map->New()<String, Token>;
			@reserved->Insert("select", Token->New(Token->Type->SELECT));
			@reserved->Insert("distinct", Token->New(Token->Type->DISTINCT));
			@reserved->Insert("from", Token->New(Token->Type->FROM));
			@reserved->Insert("where", Token->New(Token->Type->WHERE));
			@reserved->Insert("not", Token->New(Token->Type->NOT));
			@reserved->Insert("like", Token->New(Token->Type->LIKE));
			@reserved->Insert("between", Token->New(Token->Type->BETWEEN));
			@reserved->Insert("in", Token->New(Token->Type->IN));
			@reserved->Insert("and", Token->New(Token->Type->AND));
			@reserved->Insert("or", Token->New(Token->Type->OR));
			@reserved->Insert("true", Token->New(1));
			@reserved->Insert("false", Token->New(0));
			@reserved->Insert("order", Token->New(Token->Type->ORDER));
			@reserved->Insert("by", Token->New(Token->Type->BY));
		}
		
		method : public : Parse() ~ Term {
			@tokens := Scan();

			term : Term;
			if(@tokens = Nil)	{
				return Nil;
			};			
			NextToken();

			if(TokenType() = Token->Type->SELECT) {
				NextToken();		
				term := ParseSelect();
			}
			else if(TokenType() = Token->Type->FROM) {
				NextToken();
				term := ParseFrom();
			};

			if(term <> Nil & TokenType() = Token->Type->ORDER) {
				NextToken();

				if(TokenType() <> Token->Type->BY) {
					return Nil;
				};
				NextToken();

				if(TokenType() <> Token->Type->REF) {
					return Nil;
				};

				right := Term->New(TokenType());
				right->SetValue(TokenValue());
				term->SetRight(right);
				NextToken();
			};

			# anything left over is an error, not something to skip past
			if(TokenType() <> Token->Type->EOS) {
				return Nil;
			};
			
			return term;
		}
		
		method : ParseSelect() ~ Term {
# "--- Select ---"->PrintLine();		
			term := Term->New(Token->Type->SELECT);
			term->SetValue(TokenValue());
			
			if(TokenType() = Token->Type->STAR) {
				term->AddTerm(Term->New(TokenType()));
				NextToken();		
			}
			else if(TokenType() = Token->Type->DISTINCT) {
				term->AddTerm(Term->New(TokenType()));
				NextToken();
				
				if(TokenType() <> Token->Type->REF) {
					return Nil;
				};
				name := Term->New(TokenType());
				name->SetValue(TokenValue());
				term->AddTerm(name);
				NextToken();
			}
			else {
				do {
					if(TokenType() <> Token->Type->REF) {
						return Nil;
					};
					name := Term->New(TokenType());
					name->SetValue(TokenValue());
					term->AddTerm(name);
					NextToken();

				
					if(TokenType() = Token->Type->COMMA) {
						NextToken();
					};
				}
				while(TokenType() <> Token->Type->EOS & TokenType() <> Token->Type->FROM);
			};
			
			if(TokenType() <> Token->Type->FROM) {			
				return Nil;
			};
			
			NextToken();
			left := ParseFrom();
			if(left = Nil) {			
				return Nil;
			};
			term->SetLeft(left);

			return term;
		}

		method : ParseFrom() ~ Term {
# "--- From ---"->PrintLine();

			if(TokenType() <> Token->Type->REF) {
				return Nil;
			};
			term := Term->New(Token->Type->FROM);
			term->SetValue(TokenValue());
			NextToken();
			
			if(TokenType() = Token->Type->WHERE) {
				NextToken();
				left := ParseWhere();
				if(left = Nil) {
					return Nil;
				};
				term->SetLeft(left);
			};
			
			term->SetRight(Term->New(Token->Type->EOS));
			return term;
		}

		# where := or_expr
		# or_expr := and_expr ('or' and_expr)*
		# and_expr := primary ('and' primary)*
		# primary := '(' or_expr ')' | comparison
		# 'and' binds tighter than 'or', as in SQL.
		method : public : ParseWhere() ~ Term {
			left := ParseOr();
			if(left = Nil) {
				return Nil;
			};
			
			where := Term->New(Token->Type->WHERE);
			where->SetLeft(left);
			return where;
		}
		
		method : ParseOr() ~ Term {
			left := ParseAnd();
			if(left = Nil) {
				return Nil;
			};
			
			while(TokenType() = Token->Type->OR) {
				term := Term->New(TokenType());
				term->SetValue(TokenValue());
				NextToken();
				
				right := ParseAnd();
				if(right = Nil) {
					return Nil;
				};
				
				term->SetLeft(left);
				term->SetRight(right);
				left := term;
			};

			return left;
		}
		
		method : ParseAnd() ~ Term {
			left := ParsePrimary();
			if(left = Nil) {
				return Nil;
			};

			while(TokenType() = Token->Type->AND) {
				term := Term->New(TokenType());
				term->SetValue(TokenValue());
				NextToken();

				right := ParsePrimary();
				if(right = Nil) {
					return Nil;
				};

				term->SetLeft(left);
				term->SetRight(right);
				left := term;
			};

			return left;
		}

		method : ParsePrimary() ~ Term {
			if(TokenType() = Token->Type->OPRN) {
				NextToken();

				expr := ParseOr();
				if(expr = Nil | TokenType() <> Token->Type->CPRN) {
					return Nil;
				};
				NextToken();

				return expr;
			};

			return ParseTerm();
		}
		
		# column [not] operator value; the left side must name a column
		method : ParseTerm() ~ Term {
			if(TokenType() <> Token->Type->REF) {
				return Nil;
			};
			
			left := Term->New(TokenType());
			left->SetValue(TokenValue());
			NextToken();

			is_not := false;
			if(TokenType() = Token->Type->NOT) {
				is_not := true;
				NextToken();		
			};
			
			term : Term;
			select(TokenType()) {
				label Token->Type->LIKE:
				label Token->Type->EQUAL:
				label Token->Type->NOT_EQUAL:
				label Token->Type->LESS:
				label Token->Type->GREATER:
				label Token->Type->LESS_EQUAL:
				label Token->Type->GREATER_EQUAL: {				
					term := Term->New(TokenType());
					term->SetValue(TokenValue());
					term->SetNot(is_not);
					NextToken();
				}

				other: {
					return Nil;
				}
			};
			
			right : Term;			
			select(TokenType()) {
				label Token->Type->REF:
				label Token->Type->DATE:
				label Token->Type->INT:
				label Token->Type->PARAM:
				label Token->Type->FLOAT: {			
					right := Term->New(TokenType());					
					right->SetValue(TokenValue());
					NextToken();
				}
				
				other: {
					return Nil;
				}
			};
		
			term->SetLeft(left);
			term->SetRight(right);
			
			return term;
		}
		
		method : NextToken() ~ Bool {
			if(@tokens_index < @tokens->Size()) {
				@cur_token := @tokens->Get(@tokens_index);
				@tokens_index += 1;
				return true;
			};
			
			@cur_token := Nil;
			return false;
		}
		
		method : TokenType() ~ Token->Type {
			if(@cur_token <> Nil) {
				return @cur_token->GetType();
			};
			
			return Token->Type->EOS;
		}
		
		method : TokenValue() ~ Compare {
			if(@cur_token <> Nil) {
				return @cur_token->GetValue();
			};
			
			return "";
		}
		
		# the character at index, or '\0' past the end of the line
		method : Peek(index : Int) ~ Char {
			if(index < @line->Size()) {
				return @line->Get(index);
			};

			return '\0';
		}

		# a number starts with a digit, or a '-' or '.' that leads to one
		method : IsNumberStart(index : Int) ~ Bool {
			c := Peek(index);
			if(c->IsDigit()) {
				return true;
			};

			if(c = '-') {
				index += 1;
				c := Peek(index);
				if(c->IsDigit()) {
					return true;
				};
			};

			return c = '.' & Peek(index + 1)->IsDigit();
		}

		method : native : Scan() ~ Vector<Token> {
			i := 0;
			params := 0;
			tokens := Vector->New()<Token>;
			while(i < @line->Size()) { 			 			  
				# skip whitespace
				while(i < @line->Size() & (@line->Get(i) = ' ' | @line->Get(i) = '\t' | @line->Get(i) = '\r' | @line->Get(i) = '\n')) {
					i += 1;					
				};
				
				# parse the @line
				if(i < @line->Size()) {
					# string
					if(@line->Get(i) = '\'') {
						string := "";
						i += 1;
						while(i < @line->Size() & @line->Get(i) <> '\'') {
							string->Append(@line->Get(i));
							i += 1;
						};
						
						# unterminated
						if(i >= @line->Size()) {
							return Nil;
						};
						i += 1;
						
						tokens->AddBack(Token->New(string));
					}
					# date
					else if(@line->Get(i) = '#') {
						i += 1;					
						string := "";
						while(i < @line->Size() & @line->Get(i) <> '#') {
							string->Append(@line->Get(i));
							i += 1;
						};
					
						# unterminated
						if(i >= @line->Size()) {
							return Nil;
						};
						i += 1;
						
						date : Date;
						select(string->Size()) {
							label 8: {
								date := DateUtility->Parse(string, "MM/dd/yy", false);
							}
							
							label 10: {						
								date := DateUtility->Parse(string, "MM/dd/yyyy", false);	
							}
							
							label 17: {
								date := DateUtility->Parse(string, "MM/dd/yy hh:mm:ss", false);
							}
							
							label 19: {
								date := DateUtility->Parse(string, "MM/dd/yyyy hh:mm:ss", false);
							}
						};

						if(date = Nil) {
							return Nil;
						};
						tokens->AddBack(Token->New(date));
					}
					# word: a letter or '_', then letters, digits and '_'
					else if(@line->Get(i)->IsChar() | @line->Get(i) = '_') {
						string := "";
						while(i < @line->Size() & (@line->Get(i)->IsChar() | @line->Get(i)->IsDigit() | @line->Get(i) = '_')) {
							string->Append(@line->Get(i));
							i += 1;
						};

						result := @reserved->Find(string->ToLower());
						if(result <> Nil) {
							tokens->AddBack(result);
						}
						else {
							tokens->AddBack(Token->New(string));
						};
					}
					# number: optional '-', digits and '.', optional exponent
					else if(IsNumberStart(i)) {
						number := "";
						if(@line->Get(i) = '-') {
							number->Append('-');
							i += 1;
						};

						while(i < @line->Size() & (@line->Get(i)->IsDigit() | @line->Get(i) = '.')) {
							number->Append(@line->Get(i));
							i += 1;
						};

						if(i < @line->Size() & (@line->Get(i) = 'e' | @line->Get(i) = 'E')) {
							number->Append(@line->Get(i));
							i += 1;
							if(i < @line->Size() & (@line->Get(i) = '-' | @line->Get(i) = '+')) {
								number->Append(@line->Get(i));
								i += 1;
							};
							while(i < @line->Size() & @line->Get(i)->IsDigit()) {
								number->Append(@line->Get(i));
								i += 1;
							};
						};

						kind := Cell->NumberKind(number);
						if(kind = 1) {
							tokens->AddBack(Token->New(number->ToInt()));
						}
						else if(kind = 2) {
							tokens->AddBack(Token->New(number->ToFloat()));
						}
						else {
							return Nil;
						};
					}
					else {
						select(@line->Get(i)) {
							label '*': {
								tokens->AddBack(Token->New(Token->Type->STAR));
							}
							label '?': {
								params += 1;
								tokens->AddBack(Token->New(Token->Type->PARAM, IntRef->New(params)));
							}

							label ',': {
								tokens->AddBack(Token->New(Token->Type->COMMA));
							}
							
							label '(': {
								tokens->AddBack(Token->New(Token->Type->OPRN));
							}
							
							label ')': {
								tokens->AddBack(Token->New(Token->Type->CPRN));
							}
							
							label '=': {
								tokens->AddBack(Token->New(Token->Type->EQUAL));
							}
							
							label '<': {
								if(Peek(i + 1) = '>') {
									i += 1;
									tokens->AddBack(Token->New(Token->Type->NOT_EQUAL));
								}
								else if(Peek(i + 1) = '=') {
									i += 1;
									tokens->AddBack(Token->New(Token->Type->LESS_EQUAL));
								}
								else {
									tokens->AddBack(Token->New(Token->Type->LESS));
								};
							}
							
							label '!': {
								if(Peek(i + 1) <> '=') {
									return Nil;
								};
								i += 1;
								tokens->AddBack(Token->New(Token->Type->NOT_EQUAL));
							}

							label '>': {
								if(Peek(i + 1) = '=') {
									i += 1;
									tokens->AddBack(Token->New(Token->Type->GREATER_EQUAL));
								}
								else {
									tokens->AddBack(Token->New(Token->Type->GREATER));
								};
							}
              
							other: {
								return Nil;
							}
						};
						i += 1;
					};
				};			
			};			
			tokens->AddBack(Token->New(Token->Type->EOS));

			return tokens;
		}
	}
	
	class Term {
		@type : Token->Type;
		@oper : Conditional->Qualifier;
		@left : Term;
		@right : Term;
		@terms : Vector<Term>;
		@value : Compare;
		@is_not : Bool;

		
		New(type : Token->Type) {
			@type := type;
		}
		
		method : public : GetType() ~ Token->Type {
			return @type;
		}
		
		method : public : SetType(type : Token->Type) ~ Nil {
			@type := type;
		}

		method : public : GetNot() ~ Bool {
			return @is_not;
		}
		
		method : public : SetNot(is_not : Bool) ~ Nil {
			@is_not := is_not;
		}
		
		method : public : GetOperator() ~ Conditional->Qualifier {
			return @oper;
		}
		
		method : public : SetOperator(oper : Conditional->Qualifier) ~ Nil {
			@oper := oper;
		}
		
		method : public : SetValue(value : Compare) ~ Nil {
			@value := value;
		}
		
		method : public : GetValue() ~ Compare {
			return @value;
		}
		
		method : public : SetLeft(left : Term) ~ Nil {
			@left := left;
		}
		
		method : public : GetLeft() ~ Term {
			return @left;
		}
		
		method : public : SetRight(right : Term) ~ Nil {
			@right := right;
		}
		
		method : public : GetRight() ~ Term {
			return @right;
		}
		
		method : public : AddTerm(term : Term) ~ Nil {
			if(@terms = Nil) {
				@terms := Vector->New()<Term>;
			};
			
			@terms->AddBack(term);
		}
		
		method : public : GetTerms() ~ Vector<Term> {
			return @terms;
		}
	}
	
	class Token {
		@type : Type;
		@value : Compare;

		#~
		The kind of a token read by the filter Parser's scanner. Keywords are recognized without regard to case; 'true' and 'false' scan as the integers 1 and 0.
		~#
		enum Type {
			SELECT,
			DISTINCT,
			FROM,
			WHERE,
			LIKE,
			NOT,
			BETWEEN,
			IN,
			AND,
			OR,
			ORDER,
			BY,
			STAR,
			COMMA,
			OPRN,
			CPRN,
			EQUAL,
			NOT_EQUAL,
			LESS_EQUAL,
			LESS,
			GREATER_EQUAL,
			GREATER,
			#~
			A column name or a quoted string.
			~#
			REF,
			#~
			Not produced by the scanner.
			~#
			OPER,
			INT,
			FLOAT,
			DATE,
			#~
			Not produced by the scanner.
			~#
			TRUE,
			#~
			Not produced by the scanner.
			~#
			FASLE,
			#~
			The end of the input.
			~#
			EOS,
			#~
			A '?' placeholder, numbered in order.
			~#
			PARAM
		}
		
		New(value : String) {
			@type := Type->REF;
			@value := value;
		}
		
		New(value : Date) {
			@type := Type->DATE;
			@value := value;
		}
		
		New(type : Type) {
			@type := type;
			@value := "";
		}

		New(type : Type, value : Compare) {
			@type := type;
			@value := value;
		}
		
		New(value : Float) {
			@type := Type->FLOAT;
			@value := FloatRef->New(value);
		}

		New(value : Int) {
			@type := Type->INT;
			@value := IntRef->New(value);
		}
		
		method : public : GetType() ~ Type {
			return @type;
		}
		
		method : public : GetValue() ~ Compare {
			return @value;
		}

		method : public : ToString() ~ String {
			buffer := "";

			select(@type) {
				label Type->SELECT: {
					buffer += "SELECT";
				}

				label Type->DISTINCT: {
					buffer += "DISTINCT";
				}
				
				label Type->FROM: {
					buffer += "FROM";
				}

				label Type->WHERE: {
					buffer += "WHERE";
				}

				label Type->LIKE: {
					buffer += "LIKE";
				}

				label Type->NOT: {
					buffer += "NOT";
				}

				label Type->BETWEEN: {
					buffer += "BETWEEN";
				}

				label Type->IN: {
					buffer += "IN";
				}

				label Type->AND: {
					buffer += "AND";
				}

				label Type->OR: {
					buffer += "OR";
				}

				label Type->STAR: {
					buffer += "STAR";
				}

				label Type->ORDER: {
					buffer += "ORDER";
				}

				label Type->BY: {
					buffer += "BY";
				}

				label Type->COMMA: {
					buffer += "COMMA";
				}

				label Type->OPRN: {
					buffer += "OPRN";
				}
				
				label Type->CPRN: {
					buffer += "CPRN";
				}

				label Type->EQUAL: {
					buffer += "EQUAL";
				}

				label Type->NOT_EQUAL: {
					buffer += "NOT_EQUAL";
				}

				label Type->LESS_EQUAL: {
					buffer += "LESS_EQUAL";
				}

				label Type->LESS: {
					buffer += "LESS";
				}

				label Type->GREATER_EQUAL: {
					buffer += "GREATER_EQUAL";
				}

				label Type->GREATER: {
					buffer += "GREATER";
				}

				label Type->REF: {
					buffer += "REF, value='";
					buffer += @value->As(String);
					buffer += '"';
				}

				label Type->INT: {
					buffer += "INT, value=";
					buffer += @value->As(IntRef)->Get();
				}

				label Type->FLOAT: {
					buffer += "FLOAT, value=";
					f := @value->As(FloatRef);
					buffer += f->Get();
				}

				label Type->EOS: {
					buffer += "EOS";
				}
			};

			return buffer;
		}
	}

	#~
	The shape of a table a source provides: its name, column names and column types
	~#
	class TableSpec {
		@name : String;
		@columns : String[];
		@types : ColumnType[];

		#~
		Constructor
		@param name table name
		@param columns column names
		@param types column types, one per column
		~#
		New(name : String, columns : String[], types : ColumnType[]) {
			@name := name;
			@columns := columns;
			@types := types;
		}

		#~
		Gets the table name
		@return table name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Gets the column names
		@return column names
		~#
		method : public : GetColumns() ~ String[] {
			return @columns;
		}

		#~
		Gets the column types
		@return column types
		~#
		method : public : GetTypes() ~ ColumnType[] {
			return @types;
		}
	}

	#~
	What a query already knows, passed to a source so it can skip work: the columns the query
	needs and how many rows it can use. A source may ignore it; the engine still applies the
	query in full afterwards.
	~#
	class ScanHint {
		@columns : String[];
		@limit : Int;

		#~
		Constructor
		@param columns the columns needed, Nil for all of them
		@param limit the most rows needed, -1 for no limit
		~#
		New(columns : String[], limit : Int) {
			@columns := columns;
			@limit := limit;
		}

		#~
		Gets the columns needed
		@return column names, Nil for all
		~#
		method : public : GetColumns() ~ String[] {
			return @columns;
		}

		#~
		Gets the most rows needed
		@return row limit, -1 for none
		~#
		method : public : GetLimit() ~ Int {
			return @limit;
		}

		#~
		Whether a column is needed
		@param name column name
		@return true if needed
		~#
		method : public : Wants(name : String) ~ Bool {
			if(@columns = Nil) {
				return true;
			};

			each(i : @columns) {
				if(@columns[i]->Equals(name)) {
					return true;
				};
			};

			return false;
		}
	}

	#~
	Something that is not a table but can be read as tables: a file, a folder, a document, the
	program's own objects. A source declares its tables, then loads them into a catalog.
	~#
	interface Source {
		#~
		Gets the tables the source provides
		@return table shapes
		~#
		method : virtual : public : GetTables() ~ TableSpec[];

		#~
		Loads the source's tables into a catalog
		@param catalog catalog to add the tables to
		@param hint what the query needs, Nil for everything
		@return true if loaded, false on error (see GetError)
		~#
		method : virtual : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool;

		#~
		Gets the reason the last load failed
		@return error, Nil if none
		~#
		method : virtual : public : GetError() ~ String;
	}

	#~
	Named tables that queries can refer to. SQL run through a catalog can join its tables, and
	can create, change and delete them.

	Threads: one catalog may be shared by any number of threads that query through it at once
	(Query, Prepare, Explain, Get, GetNames), including queries that name files, which each
	thread finds in the catalog's cache or, when the files changed, waits for one thread to
	read again. GetError gives each thread its own last error. Add, Remove, Load and CREATE
	TABLE may run while other threads query: a query sees a table as it was before or after
	the change. INSERT, UPDATE, DELETE, CREATE INDEX and DROP INDEX write a table, so while
	one runs no other thread may use that table (as for any Table). SetFileAccess and
	SetArchiveLimits apply to the queries that start after them; set them before sharing the
	catalog. A Statement from Prepare belongs to the thread that binds it.

```
catalog := Catalog->New();
catalog->Load(CsvSource->New("runs.csv"));
catalog->Load(CsvSource->New("labels.csv"));
rs := catalog->Query("select r.id, r.score, l.label from runs r join labels l on r.id = l.id");
```
	~#
	class Catalog {
		@tables : Map<String, Table>;
		@plans : Map<String, Plan>;
		@files : Map<String, FileEntry>;
		@file_reads : Int;
		@no_files : Bool;
		@member_limit : Int;
		@total_limit : Int;
		@errors : ThreadErrors;

		#~
		Constructor
		~#
		New() {
			# made before any catalog exists to share, so threads never race to make them
			CatalogLocks->Prepare();
			@tables := Map->New()<String, Table>;
			@errors := ThreadErrors->New();
		}

		#~
		Whether queries may name files and URLs ('from 'runs.csv'', 'from 'https://...''), which
		they may by default. A catalog that answers queries from other people, as TableServer's
		does, turns this off: otherwise a query could read any file the process can, or make
		it fetch any URL. Archives and workbooks are files, so this refuses them too.
		@param allowed false to refuse files and URLs in queries
		~#
		method : public : SetFileAccess(allowed : Bool) ~ Nil {
			@no_files := <>allowed;
		}

		#~
		Sets how much an archive or workbook named in a query may decompress, as
		ArchiveSource->SetLimits does: a member larger than 'member_bytes' is refused, and so is a
		read that takes the archive's total past 'total_bytes'. The defaults are 256 MB and 1 GB.
		@param member_bytes most bytes one member or part may hold uncompressed
		@param total_bytes most bytes one archive or workbook may hold uncompressed in all
		~#
		method : public : SetArchiveLimits(member_bytes : Int, total_bytes : Int) ~ Nil {
			@member_limit := member_bytes;
			@total_limit := total_bytes;
		}

		# the limits for archives named in a query; 0 (never set) is the default
		method : MemberLimit() ~ Int {
			return @member_limit > 0 ? @member_limit : 256 * 1024 * 1024;
		}

		method : TotalLimit() ~ Int {
			return @total_limit > 0 ? @total_limit : 1024 * 1024 * 1024;
		}

		#~
		Adds a table under its name, replacing any table of that name
		@param table table
		~#
		method : public : Add(table : Table) ~ Nil {
			if(table <> Nil) {
				lock := CatalogLocks->Maps();
				critical(lock) {
					@tables->Insert(table->GetName(), table);
				};
			};
		}

		#~
		Adds a table unless one of its name exists: the check and the add are one step, so of
		threads adding tables of one name at once, exactly one succeeds (CREATE TABLE uses it)
		@param table table
		@return true if added, false if a table of that name exists
		~#
		method : public : AddNew(table : Table) ~ Bool {
			added := false;
			lock := CatalogLocks->Maps();
			critical(lock) {
				if(<>@tables->Has(table->GetName())) {
					@tables->Insert(table->GetName(), table);
					added := true;
				};
			};

			return added;
		}

		#~
		Gets a table by name
		@param name table name
		@return table, Nil if there is none
		~#
		method : public : Get(name : String) ~ Table {
			if(name = Nil) {
				return Nil;
			};

			table : Table := Nil;
			lock := CatalogLocks->Maps();
			critical(lock) {
				table := @tables->Find(name);
			};

			return table;
		}

		#~
		Whether a table of that name exists
		@param name table name
		@return true if it exists
		~#
		method : public : Has(name : String) ~ Bool {
			return Get(name) <> Nil;
		}

		#~
		Removes a table
		@param name table name
		@return true if removed
		~#
		method : public : Remove(name : String) ~ Bool {
			if(name = Nil) {
				return false;
			};

			removed := false;
			lock := CatalogLocks->Maps();
			critical(lock) {
				if(@tables->Has(name)) {
					@tables->Remove(name);
					removed := true;
				};
			};

			return removed;
		}

		#~
		Gets the table names
		@return table names
		~#
		method : public : GetNames() ~ String[] {
			keys : Vector<String> := Nil;
			lock := CatalogLocks->Maps();
			critical(lock) {
				keys := @tables->GetKeys()<String>;
			};

			names := String->New[keys->Size()];
			each(i : names) {
				names[i] := keys->Get(i);
			};

			return names;
		}

		#~
		Loads every table of a source
		@param source source
		@return true if loaded, false on error (see GetError)
		~#
		method : public : Load(source : Source) ~ Bool {
			return Load(source, Nil);
		}

		#~
		Loads a source's tables, passing what the caller needs
		@param source source
		@param hint columns and rows needed, Nil for everything
		@return true if loaded, false on error (see GetError)
		~#
		method : public : Load(source : Source, hint : ScanHint) ~ Bool {
			SetError(Nil);
			if(source = Nil) {
				SetError("no source");
				return false;
			};

			if(<>source->Load(@self, hint)) {
				SetError(source->GetError());
				return false;
			};

			return true;
		}

		#~
		Runs a SELECT that reads files named in it, with no catalog of tables. Each call reads
		the files again; a program that repeats a query keeps a Catalog and uses its Query,
		which reads a file again only after it changes.
		@param statement SQL SELECT
		@return result table, Nil on error (a Catalog's Query and GetError say why)
		```
		rs := Catalog->Run("select name, avg(score) from 'results/run_*.csv' group by name");
		```
		~#
		function : Run(statement : String) ~ Table {
			return Catalog->New()->Query(statement);
		}

		# A file named in a query, read once and again only when it changes (by name, size and
		# modification time, or for a URL by its server's validators); a glob's files become one
		# table with a '_file' column. Several threads may ask at once: the cache is read and
		# changed under the catalog lock, and a file that must be read is read under its file
		# lock (CatalogLocks), so threads that miss together read it once.
		method : public : ReadFile(file : SqlFile, name : String, error : StringHolder) ~ Table {
			if(@no_files) {
				error->Set("'{$(file->GetPath())}': this catalog does not read files or URLs named in a query");
				return Nil;
			};

			key := file->GetKey();
			path := file->GetPath();
			if(UrlCache->IsUrl(path)) {
				if(file->IsGlob()) {
					error->Set("'{$path}': a URL cannot be a pattern");
					return Nil;
				};

				# revalidated over the network with no lock held
				fetched := UrlCache->Fetch(path, error);
				if(fetched = Nil) {
					return Nil;
				};

				known := CachedFile(key, fetched->GetStamp());
				if(known <> Nil) {
					return known;
				};

				# a miss: read the local copy under the URL's lock, which every writer of the
				# copy holds too, so the copy cannot change while it is read and the stamp it
				# is cached under is the copy's own
				downloaded : Table := Nil;
				lock := CatalogLocks->ForFile(path);
				critical(lock) {
					stamp := UrlCache->CurrentStamp(path);
					if(stamp = Nil) {
						stamp := fetched->GetStamp();
					};

					downloaded := CachedFile(key, stamp);
					if(downloaded = Nil) {
						CountRead();
						downloaded := FileTables->ReadOne(file, fetched->GetPath(), name, MemberLimit(), TotalLimit(), error);
						if(downloaded <> Nil) {
							StoreFile(key, stamp, downloaded);
						};
					};
				};

				return downloaded;
			};

			files := FileTables->Expand(path, error);
			if(files = Nil) {
				return Nil;
			};

			stamp := FileTables->Stamp(files);
			newest := FileTables->Newest(files);
			known := CachedLocal(key, stamp, files, newest);
			if(known <> Nil) {
				return known;
			};

			table : Table := Nil;
			lock := CatalogLocks->ForFile(key);
			critical(lock) {
				# another thread may have read it while this one waited
				table := CachedLocal(key, stamp, files, newest);
				if(table = Nil) {
					# a file this recent may be rewritten within its stamp's second: digest it
					# before the read, so a write between the two is seen by the next query
					read_at := FileTables->Now();
					digest : String := Nil;
					if(read_at - newest <= 1) {
						digest := FileTables->Digest(files);
					};
					table := ReadFiles(file, files, name, error);
					if(table <> Nil) {
						StoreFile(key, stamp, table, read_at, digest);
					};
				};
			};

			return table;
		}

		# the cached table for local files, if it was read when they had this stamp and, for a
		# racy entry, if they still digest the same (FileEntry). The digest is taken with no
		# lock held: it only reads the files.
		method : CachedLocal(key : String, stamp : String, files : Vector<String>, newest : Int) ~ Table {
			entry := CachedEntry(key, stamp);
			if(entry = Nil) {
				return Nil;
			};

			if(entry->IsRacy(newest)) {
				if(entry->GetDigest() = Nil) {
					return Nil;
				};

				now := FileTables->Now();
				digest := FileTables->Digest(files);
				if(digest = Nil | <>digest->Equals(entry->GetDigest())) {
					return Nil;
				};
				entry->SetReadAt(now);
			};

			return entry->GetTable();
		}

		method : CachedEntry(key : String, stamp : String) ~ FileEntry {
			entry : FileEntry := Nil;
			lock := CatalogLocks->Maps();
			critical(lock) {
				if(@files <> Nil) {
					found := @files->Find(key);
					if(found <> Nil & found->GetStamp()->Equals(stamp)) {
						entry := found;
					};
				};
			};

			return entry;
		}

		# the files a path matched, read as one table; Nil with the error set
		method : ReadFiles(file : SqlFile, files : Vector<String>, name : String, error : StringHolder) ~ Table {
			if(file->IsGlob()) {
				tables := Vector->New()<Table>;
				each(i : files) {
					CountRead();
					one := FileTables->ReadOne(file, files->Get(i), name, MemberLimit(), TotalLimit(), error);
					if(one = Nil) {
						return Nil;
					};
					tables->AddBack(one);
				};
				return FileTables->Combine(name, tables, files, "_file");
			};

			CountRead();
			return FileTables->ReadOne(file, files->Get(0), name, MemberLimit(), TotalLimit(), error);
		}

		# the cached table for a URL's copy, if it was read when the copy had this stamp (a
		# copy's stamp is its server's validators or its own bytes, never a second)
		method : CachedFile(key : String, stamp : String) ~ Table {
			entry := CachedEntry(key, stamp);
			return entry <> Nil ? entry->GetTable() : Nil;
		}

		method : StoreFile(key : String, stamp : String, table : Table) ~ Nil {
			StoreFile(key, stamp, table, FileTables->Now(), Nil);
		}

		method : StoreFile(key : String, stamp : String, table : Table, read_at : Int, digest : String) ~ Nil {
			lock := CatalogLocks->Maps();
			critical(lock) {
				if(@files = Nil | @files->Size() >= 32) {
					@files := Map->New()<String, FileEntry>;
				};
				@files->Insert(key, FileEntry->New(stamp, table, read_at, digest));
			};
		}

		method : CountRead() ~ Nil {
			lock := CatalogLocks->Maps();
			critical(lock) {
				@file_reads += 1;
			};
		}

		#~
		Gets how many times queries have read a file, for checking that unchanged files come
		from the cache
		@return file reads
		~#
		method : public : GetFileReads() ~ Int {
			reads := 0;
			lock := CatalogLocks->Maps();
			critical(lock) {
				reads := @file_reads;
			};

			return reads;
		}

		#~
		Runs a SELECT over the catalog's tables, which it can join, and over files named in it
		@param statement SQL SELECT
		@return result table, Nil on error (see GetError)
		```
		rs := catalog->Query("select dept, count(*) as n from emp group by dept having count(*) > 1");
		```
		~#
		method : public : Query(statement : String) ~ Table {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return Nil;
			};

			error := StringHolder->New();
			view := plan->RunIn(@self, Compare->New[0], error);
			if(view = Nil) {
				SetError(error->Get());
				return Nil;
			};

			return view->ToTable("<rs>");
		}

		#~
		Runs an INSERT, UPDATE, DELETE, CREATE TABLE, CREATE INDEX or DROP INDEX (see Table->Execute). A statement that fails changes nothing.
		@param statement SQL statement
		@return rows inserted, updated or deleted (0 for CREATE TABLE), -1 on error (see GetError)
		```
		catalog->Execute("create table runs (id int, score float, label string)");
		catalog->Execute("insert into runs values (1, 0.5, 'cat'), (2, 0.9, 'dog')");
		```
		~#
		method : public : Execute(statement : String) ~ Int {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return -1;
			};

			error := StringHolder->New();
			changed := plan->ExecuteIn(@self, Compare->New[0], error);
			SetError(error->Get());
			return changed;
		}

		#~
		Parses a statement once, for running many times with different values
		@param statement SQL with '?' placeholders
		@return statement, Nil on a syntax error (see GetError)
		~#
		method : public : Prepare(statement : String) ~ Statement {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return Nil;
			};

			return Statement->New(@self, plan);
		}

		#~
		Tells how a statement reads its rows (see Table->Explain); a SELECT is run to find out
		@param statement SQL statement
		@return plan, Nil on error (see GetError)
		```
		catalog->Explain("select * from runs r join meta m on r.id = m.id where r.score > 0.9")->PrintLine();
		```
		~#
		method : public : Explain(statement : String) ~ String {
			SetError(Nil);
			plan := FindPlan(statement);
			if(plan = Nil) {
				return Nil;
			};

			error := StringHolder->New();
			text := plan->ExplainIn(@self, Compare->New[0], error);
			SetError(error->Get());
			return text;
		}

		# A parsed plan for a statement, from a small cache of recent ones. Threads sharing the
		# catalog share the cache, a Map, read and changed under the catalog lock; parsing, the
		# slow part, is not, so two threads may parse one statement and the later insert wins
		# (a plan does not change once parsed, so either serves).
		method : FindPlan(statement : String) ~ Plan {
			plan : Plan := Nil;
			lock := CatalogLocks->Maps();
			if(statement <> Nil) {
				critical(lock) {
					if(@plans <> Nil) {
						plan := @plans->Find(statement);
					};
				};
			};

			if(plan = Nil) {
				holder := StringHolder->New();
				plan := Plan->Parse(statement, holder);
				if(plan = Nil) {
					SetError(holder->Get());
					return Nil;
				};

				if(statement <> Nil) {
					critical(lock) {
						if(@plans = Nil | @plans->Size() >= 64) {
							@plans := Map->New()<String, Plan>;
						};
						@plans->Insert(statement, plan);
					};
				};
			};

			return plan;
		}

		#~
		Gets the reason the calling thread's last load, query or statement failed: several
		threads may share a catalog, and each reads its own error
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @errors->Get();
		}

		# the calling thread's error, Nil to clear it
		method : SetError(message : String) ~ Nil {
			@errors->Set(message);
		}
	}

	#~
	A CSV file as a table. Each column is typed by reading all of it: whole numbers make an INT
	column, numbers with a fraction or exponent a FLOAT column, '#MM/dd/yyyy#' cells a DATE
	column, and anything else, including any mix of numbers and text, a STRING column. An empty
	cell is empty, not an empty string. Quoting follows RFC 4180 through Data.CSV.

```
catalog := Catalog->New();
if(catalog->Load(CsvSource->New("runs.csv"))) {
  catalog->Get("runs")->Describe()->ToString()->PrintLine();
};
```
	~#
	class CsvSource implements Source {
		@path : String;
		@name : String;
		@delimiter : Char;
		@no_header : Bool;
		@text : String;
		@error : String;

		#~
		Constructor. The table is named after the file, without its directory or extension.
		@param path CSV file
		~#
		New(path : String) {
			@path := path;
			@name := SourceText->BaseName(path, "csv");
			@delimiter := ',';
		}

		#~
		Constructor
		@param path CSV file
		@param name table name
		@param delimiter field delimiter, such as ',', ';' or '\t'
		~#
		New(path : String, name : String, delimiter : Char) {
			@path := path;
			@name := name;
			@delimiter := delimiter;
		}

		#~
		Sets whether the first line names the columns (the default). Without a header every
		line is data and the columns are named c1, c2 and so on.
		@param header true if the first line is a header
		~#
		method : public : SetHeader(header : Bool) ~ Nil {
			@no_header := <>header;
		}

		#~
		Makes a source over CSV text already in memory
		@param name table name
		@param text CSV text
		@param delimiter field delimiter
		@return source
		~#
		function : FromText(name : String, text : String, delimiter : Char) ~ CsvSource {
			source := CsvSource->New(Nil, name, delimiter);
			source->SetText(text);
			return source;
		}

		method : public : SetText(text : String) ~ Nil {
			@text := text;
		}

		#~
		Gets the table the file provides; its column types are known only after reading it
		@return one table shape
		~#
		method : public : GetTables() ~ TableSpec[] {
			table := Read(Nil);
			specs := TableSpec->New[1];
			if(table = Nil) {
				specs[0] := TableSpec->New(@name, String->New[0], ColumnType->New[0]);
				return specs;
			};

			names := table->GetColumnNames();
			columns := String->New[names->Size() - 1];
			types := ColumnType->New[names->Size() - 1];
			each(i : columns) {
				columns[i] := names[i + 1];
				types[i] := table->GetColumn(i + 1)->GetType();
			};
			specs[0] := TableSpec->New(@name, columns, types);

			return specs;
		}

		#~
		Loads the file into a catalog
		@param catalog catalog
		@param hint columns and rows needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			table := Read(hint);
			if(table = Nil) {
				return false;
			};

			catalog->Add(table);
			return true;
		}

		#~
		Reads the file as a table
		@param hint columns and rows needed, Nil for everything
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(hint : ScanHint) ~ Table {
			@error := Nil;
			text := @text;
			if(text = Nil) {
				if(@path = Nil) {
					@error := "no file and no text";
					return Nil;
				};
				reason := StringHolder->New();
				text := SourceText->Read(@path, reason);
				if(text = Nil) {
					@error := reason->Get();
					return Nil;
				};
			};

			parsed := ParseText(text, @delimiter);
			if(parsed = Nil) {
				@error := "'{$@name}': ";
				error := Data.CSV.CsvTable->New(text, @delimiter)->GetError();
				@error += error <> Nil ? error : "not a CSV table";
				return Nil;
			};
			csv := parsed->GetTable();

			# the column names: the first line's, or c1, c2 ... when every line is data
			first_line := csv->Get(0);
			headers := Vector->New()<String>;
			each(i : first_line) {
				headers->AddBack(@no_header ? "c{$(i + 1)}" : first_line->Get(i));
			};

			wanted := Vector->New()<IntRef>;
			each(i : headers) {
				if(hint = Nil | hint->Wants(headers->Get(i))) {
					wanted->AddBack(i);
				};
			};

			first := @no_header ? 0 : 1;
			limit := parsed->GetRows() + 1 - first;
			if(hint <> Nil & hint->GetLimit() > -1 & hint->GetLimit() < limit) {
				limit := hint->GetLimit();
			};

			names := String->New[wanted->Size()];
			types := ColumnType->New[wanted->Size()];
			each(i : names) {
				column := wanted->Get(i)->Get();
				names[i] := headers->Get(column);
				types[i] := ScanType(csv, column, first, limit);
			};

			table := Table->New(@name, names, types, false);
			for(r := first; r < first + limit; r += 1;) {
				row := table->Insert();
				csv_row := csv->Get(r);
				each(i : names) {
					text_value := csv_row->Get(wanted->Get(i)->Get());
					if(text_value <> Nil & text_value->Size() > 0) {
						row->Set(i + 1, Convert(text_value, types[i]));
					};
				};
			};

			return table;
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		Parses CSV text, accepting a header with no rows as an empty table
		@param text CSV text
		@param delimiter field delimiter
		@return parsed table and its number of data rows, Nil if the text is not CSV
		~#
		function : ParseText(text : String, delimiter : Char) ~ ParsedCsv {
			if(text = Nil) {
				return Nil;
			};

			csv := Data.CSV.CsvTable->New(text, delimiter);
			if(csv->IsParsed()) {
				return ParsedCsv->New(csv, csv->Size() - 1);
			};

			# a header alone is a valid table with no rows; parse the lone line as a
			# header and a copy of itself, so quoting follows the CSV rules, and use
			# only the header
			line := text->Trim();
			if(line->IsEmpty() | line->Has('\n') | line->Has('\r')) {
				return Nil;
			};

			doubled := String->New(line);
			doubled += "\n";
			doubled += line;
			csv := Data.CSV.CsvTable->New(doubled, "\n", delimiter);
			if(<>csv->IsParsed() | csv->Size() < 2) {
				return Nil;
			};

			return ParsedCsv->New(csv, 0);
		}

		# the type a whole column calls for, over 'count' records from 'first'
		function : ScanType(csv : Data.CSV.CsvTable, column : Int, first : Int, count : Int) ~ ColumnType {
			has_int := false;
			has_float := false;
			has_date := false;
			has_text := false;
			for(r := first; r < first + count; r += 1;) {
				text := csv->Get(r)->Get(column);
				if(text <> Nil & text->Size() > 0) {
					kind := Cell->NumberKind(text);
					if(kind = 1) {
						has_int := true;
					}
					else if(kind = 2) {
						has_float := true;
					}
					else if(IsDate(text)) {
						has_date := true;
					}
					else {
						has_text := true;
					};
				};
			};

			if(has_text | (has_date & (has_int | has_float))) {
				return ColumnType->STRING;
			}
			else if(has_date) {
				return ColumnType->DATE;
			}
			else if(has_float) {
				return ColumnType->FLOAT;
			}
			else if(has_int) {
				return ColumnType->INT;
			};

			return ColumnType->STRING;
		}

		function : IsDate(text : String) ~ Bool {
			if(text->Size() < 2 | <>text->StartsWith('#') | <>text->EndsWith('#')) {
				return false;
			};

			value := Cell->FromText(text);
			return value <> Nil & value->TypeOf(Date);
		}

		function : Convert(text : String, type : ColumnType) ~ Compare {
			select(type) {
				label ColumnType->INT: {
					return IntRef->New(text->ToInt());
				}

				label ColumnType->FLOAT: {
					return FloatRef->New(text->ToFloat());
				}

				label ColumnType->DATE: {
					return Cell->FromText(text);
				}
			};

			return text;
		}

		function : BaseName(path : String) ~ String {
			if(path = Nil) {
				return "csv";
			};

			start := 0;
			each(i : path) {
				c := path->Get(i);
				if(c = '/' | c = '\\') {
					start := i + 1;
				};
			};

			name := path->SubString(start, path->Size() - start);
			dot := name->FindLast('.');
			if(dot > 0) {
				name := name->SubString(0, dot);
			};

			return name;
		}
	}

	#~
	A folder as a table named 'files', optionally with everything below it. Columns: id,
	parent_id (empty at the top), depth (0 at the top), name, path, ext, is_dir, size, modified,
	created, owner, is_readonly and is_hidden. A name starting with '.' counts as hidden. With a
	scan hint, the costly columns (size, modified, created, owner, is_readonly) are only read
	when asked for.

```
catalog := Catalog->New();
catalog->Load(FilesystemSource->New("results", true));
files := catalog->Get("files");
```
	~#
	class FilesystemSource implements Source {
		@root : String;
		@recursive : Bool;
		@max_depth : Int;
		@include_hidden : Bool;
		@name : String;
		@error : String;

		#~
		Constructor
		@param root folder
		@param recursive true to include everything below the folder
		~#
		New(root : String, recursive : Bool) {
			@root := root;
			@recursive := recursive;
			@max_depth := -1;
			@include_hidden := true;
			@name := "files";
		}

		#~
		Constructor
		@param root folder
		@param recursive true to include everything below the folder
		@param max_depth deepest level to include, 0 for the folder's own entries, -1 for no limit
		@param include_hidden false to leave out, and not descend into, entries whose names start with '.'
		~#
		New(root : String, recursive : Bool, max_depth : Int, include_hidden : Bool) {
			@root := root;
			@recursive := recursive;
			@max_depth := max_depth;
			@include_hidden := include_hidden;
			@name := "files";
		}

		#~
		Sets the table name
		@param name table name
		~#
		method : public : SetName(name : String) ~ Nil {
			@name := name;
		}

		#~
		Gets the column names
		@return column names
		~#
		function : ColumnNames() ~ String[] {
			return ["id", "parent_id", "depth", "name", "path", "ext", "is_dir", "size", "modified", "created", "owner", "is_readonly", "is_hidden"];
		}

		function : ColumnTypes() ~ ColumnType[] {
			types := ColumnType->New[13];
			types[0] := ColumnType->INT;
			types[1] := ColumnType->INT;
			types[2] := ColumnType->INT;
			types[3] := ColumnType->STRING;
			types[4] := ColumnType->STRING;
			types[5] := ColumnType->STRING;
			types[6] := ColumnType->BOOL;
			types[7] := ColumnType->INT;
			types[8] := ColumnType->DATE;
			types[9] := ColumnType->DATE;
			types[10] := ColumnType->STRING;
			types[11] := ColumnType->BOOL;
			types[12] := ColumnType->BOOL;
			return types;
		}

		#~
		Gets the table the folder provides
		@return one table shape
		~#
		method : public : GetTables() ~ TableSpec[] {
			specs := TableSpec->New[1];
			specs[0] := TableSpec->New(@name, ColumnNames(), ColumnTypes());
			return specs;
		}

		#~
		Loads the listing into a catalog
		@param catalog catalog
		@param hint columns and rows needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			columns : String[];
			limit := -1;
			if(hint <> Nil) {
				columns := hint->GetColumns();
				limit := hint->GetLimit();
			};

			table := List(columns, limit);
			if(table = Nil) {
				return false;
			};

			catalog->Add(table);
			return true;
		}

		#~
		Lists the folder as a table, with every column
		@return table, Nil if the folder cannot be read (see GetError)
		~#
		method : public : List() ~ Table {
			all : String[];
			return List(all, -1);
		}

		#~
		Lists the folder as a table, reading only the given columns' costly values
		@param columns columns needed
		@return table, Nil if the folder cannot be read (see GetError)
		~#
		method : public : List(columns : String[]) ~ Table {
			return List(columns, -1);
		}

		#~
		Lists the folder as a table, reading only the given columns' costly values
		@param columns columns needed, Nil for all
		@param limit the most rows to list, -1 for all
		@return table, Nil if the folder cannot be read (see GetError)
		~#
		method : public : List(columns : String[], limit : Int) ~ Table {
			@error := Nil;
			if(@root = Nil | <>Directory->Exists(@root)) {
				@error := "'{$@root}' is not a folder";
				return Nil;
			};

			hint := ScanHint->New(columns, limit);
			table := Table->New(@name, ColumnNames(), ColumnTypes());
			Walk(table, hint, Folder(@root), -1, 0);

			return table;
		}

		#~
		Gets the reason the last listing failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		# lists one folder, then (when recursive) each subfolder right after its own row
		method : Walk(table : Table, hint : ScanHint, folder : String, parent : Int, depth : Int) ~ Nil {
			names := Directory->List(folder);
			if(names = Nil) {
				return;
			};

			each(i : names) {
				if(hint->GetLimit() > -1 & table->Size() >= hint->GetLimit()) {
					return;
				};

				name := names[i];
				hidden := name->StartsWith('.');
				# '.' and '..' are the folder and its parent, never entries
				is_link := name->Equals(".") | name->Equals("..");
				if(<>is_link & (@include_hidden | <>hidden)) {
					path := String->New(folder);
					path += name;
					is_dir := Directory->Exists(path);

					row := table->Insert();
					id := row->GetKey();
					row->Set("id", IntRef->New(id));
					if(parent > -1) {
						row->Set("parent_id", IntRef->New(parent));
					};
					row->Set("depth", IntRef->New(depth));
					row->Set("name", name);
					row->Set("path", path);
					row->Set("ext", Extension(name, is_dir));
					row->Set("is_dir", BoolRef->New(is_dir));
					row->Set("is_hidden", BoolRef->New(hidden));
					if(hint->Wants("size") & <>is_dir) {
						row->Set("size", IntRef->New(File->Size(path)));
					};
					if(hint->Wants("modified")) {
						row->Set("modified", File->ModifiedTime(path));
					};
					if(hint->Wants("created")) {
						row->Set("created", File->CreateTime(path));
					};
					if(hint->Wants("owner")) {
						row->Set("owner", File->Owner(path));
					};
					if(hint->Wants("is_readonly")) {
						row->Set("is_readonly", BoolRef->New(File->IsReadOnly(path)));
					};

					if(is_dir & @recursive & (@max_depth < 0 | depth < @max_depth)) {
						Walk(table, hint, Folder(path), id, depth + 1);
					};
				};
			};
		}

		function : Folder(path : String) ~ String {
			if(path->EndsWith('/') | path->EndsWith('\\')) {
				return path;
			};

			folder := String->New(path);
			folder += '/';
			return folder;
		}

		function : Extension(name : String, is_dir : Bool) ~ String {
			if(is_dir) {
				return Nil;
			};

			dot := name->FindLast('.');
			if(dot < 1 | dot = name->Size() - 1) {
				return Nil;
			};

			return name->SubString(dot + 1, name->Size() - dot - 1)->ToLower();
		}
	}

	#~
	The program's own objects as a table: one row per object, one column per function that reads
	a value from an object. Each function's return type sets its column's type.

```
source := ObjectSource->New("runs", runs)<Run>;
source->AddString("name", \(Run) ~ String : (r) => r->GetName());
source->AddFloat("score", \(Run) ~ Float : (r) => r->GetScore());
source->AddInt("epochs", \(Run) ~ Int : (r) => r->GetEpochs());
catalog := Catalog->New();
catalog->Load(source);
```
	~#
	class ObjectSource<T> implements Source {
		@name : String;
		@objects : Vector<T>;
		@names : Vector<String>;
		@readers : Vector<ObjectReader<T>>;
		@error : String;

		#~
		Constructor
		@param name table name
		@param objects objects, one per row
		~#
		New(name : String, objects : Vector<T>) {
			@name := name;
			@objects := objects;
			@names := Vector->New()<String>;
			@readers := Vector->New()<ObjectReader<T>>;
		}

		#~
		Adds an Int column
		@param name column name
		@param reader reads the value from an object
		@return this source
		~#
		method : public : AddInt(name : String, reader : (T) ~ Int) ~ ObjectSource<T> {
			@names->AddBack(name);
			@readers->AddBack(ObjectReader->New()<T>->SetInt(reader));
			return @self;
		}

		#~
		Adds a Float column
		@param name column name
		@param reader reads the value from an object
		@return this source
		~#
		method : public : AddFloat(name : String, reader : (T) ~ Float) ~ ObjectSource<T> {
			@names->AddBack(name);
			@readers->AddBack(ObjectReader->New()<T>->SetFloat(reader));
			return @self;
		}

		#~
		Adds a String column; a Nil string is an empty cell
		@param name column name
		@param reader reads the value from an object
		@return this source
		~#
		method : public : AddString(name : String, reader : (T) ~ String) ~ ObjectSource<T> {
			@names->AddBack(name);
			@readers->AddBack(ObjectReader->New()<T>->SetString(reader));
			return @self;
		}

		#~
		Adds a Bool column
		@param name column name
		@param reader reads the value from an object
		@return this source
		~#
		method : public : AddBool(name : String, reader : (T) ~ Bool) ~ ObjectSource<T> {
			@names->AddBack(name);
			@readers->AddBack(ObjectReader->New()<T>->SetBool(reader));
			return @self;
		}

		#~
		Adds a Date column; a Nil date is an empty cell
		@param name column name
		@param reader reads the value from an object
		@return this source
		~#
		method : public : AddDate(name : String, reader : (T) ~ Date) ~ ObjectSource<T> {
			@names->AddBack(name);
			@readers->AddBack(ObjectReader->New()<T>->SetDate(reader));
			return @self;
		}

		#~
		Gets the table the objects provide
		@return one table shape
		~#
		method : public : GetTables() ~ TableSpec[] {
			specs := TableSpec->New[1];
			specs[0] := TableSpec->New(@name, Names(), Types());
			return specs;
		}

		#~
		Loads the objects into a catalog
		@param catalog catalog
		@param hint columns and rows needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			table := ToTable(hint);
			if(table = Nil) {
				return false;
			};

			catalog->Add(table);
			return true;
		}

		#~
		Reads the objects into a table
		@param hint columns and rows needed, Nil for everything
		@return table
		~#
		method : public : ToTable(hint : ScanHint) ~ Table {
			@error := Nil;
			if(@objects = Nil) {
				@error := "no objects";
				return Nil;
			};

			names := Names();
			table := Table->New(@name, names, Types());
			limit := @objects->Size();
			if(hint <> Nil & hint->GetLimit() > -1 & hint->GetLimit() < limit) {
				limit := hint->GetLimit();
			};

			each(i : limit) {
				object := @objects->Get(i);
				row := table->Insert();
				each(j : names) {
					if(hint = Nil | hint->Wants(names[j])) {
						row->Set(j + 1, @readers->Get(j)->Read(object));
					};
				};
			};

			return table;
		}

		#~
		Gets the reason the last load failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		method : Names() ~ String[] {
			names := String->New[@names->Size()];
			each(i : names) {
				names[i] := @names->Get(i);
			};

			return names;
		}

		method : Types() ~ ColumnType[] {
			types := ColumnType->New[@readers->Size()];
			each(i : types) {
				types[i] := @readers->Get(i)->GetType();
			};

			return types;
		}
	}

	# one column's reader for ObjectSource; a function per return type, since function
	# references cannot be told apart by their return type when overloading
	class : private : ObjectReader<T> {
		@type : ColumnType;
		@int_reader : (T) ~ Int;
		@float_reader : (T) ~ Float;
		@string_reader : (T) ~ String;
		@bool_reader : (T) ~ Bool;
		@date_reader : (T) ~ Date;

		New() {
			@type := ColumnType->NONE;
		}

		method : public : SetInt(reader : (T) ~ Int) ~ ObjectReader<T> {
			@type := ColumnType->INT;
			@int_reader := reader;
			return @self;
		}

		method : public : SetFloat(reader : (T) ~ Float) ~ ObjectReader<T> {
			@type := ColumnType->FLOAT;
			@float_reader := reader;
			return @self;
		}

		method : public : SetString(reader : (T) ~ String) ~ ObjectReader<T> {
			@type := ColumnType->STRING;
			@string_reader := reader;
			return @self;
		}

		method : public : SetBool(reader : (T) ~ Bool) ~ ObjectReader<T> {
			@type := ColumnType->BOOL;
			@bool_reader := reader;
			return @self;
		}

		method : public : SetDate(reader : (T) ~ Date) ~ ObjectReader<T> {
			@type := ColumnType->DATE;
			@date_reader := reader;
			return @self;
		}

		method : public : GetType() ~ ColumnType {
			return @type;
		}

		method : public : Read(object : T) ~ Compare {
			select(@type) {
				label ColumnType->INT: {
					return IntRef->New(@int_reader(object));
				}

				label ColumnType->FLOAT: {
					return FloatRef->New(@float_reader(object));
				}

				label ColumnType->STRING: {
					return @string_reader(object);
				}

				label ColumnType->BOOL: {
					return BoolRef->New(@bool_reader(object));
				}

				label ColumnType->DATE: {
					return @date_reader(object);
				}
			};

			return Nil;
		}
	}

	# Reads a source file's text; a name ending in '.gz' is decompressed first
	# a downloaded file: where its copy is, and what identifies this version of it
	class : private : UrlFile {
		@path : String;
		@stamp : String;

		New(path : String, stamp : String) {
			@path := path;
			@stamp := stamp;
		}

		method : public : GetPath() ~ String {
			return @path;
		}

		method : public : GetStamp() ~ String {
			return @stamp;
		}
	}

	#
	# Reading files over HTTP (docs/QUERY_DESIGN.md, section 10). A download is kept in a
	# cache folder under the system's temporary folder, keyed by URL, beside a note of the
	# server's ETag and Last-Modified. A later fetch asks the server whether it changed
	# (If-None-Match, If-Modified-Since); a 304 answer reuses the copy. A new copy is written
	# to a temporary file and renamed into place, so a reader never sees half a file.
	#
	class : private : UrlCache {
		function : IsUrl(path : String) ~ Bool {
			if(path = Nil) {
				return false;
			};

			lower := path->ToLower();
			return lower->StartsWith("http://") | lower->StartsWith("https://");
		}

		# the URL without its query string or fragment, for its file name and extension
		function : PathPart(url : String) ~ String {
			end := url->Size();
			each(i : url) {
				c := url->Get(i);
				if((c = '?' | c = '#') & i < end) {
					end := i;
				};
			};

			return url->SubString(0, end);
		}

		function : Folder() ~ String {
			folder := Runtime->GetTempDir();
			if(folder = Nil) {
				folder := ".";
			};

			last := folder->Size() > 0 ? folder->Get(folder->Size() - 1) : ' ';
			folder := String->New(folder);
			if(last <> '/' & last <> '\\') {
				folder += "/";
			};
			folder += "objeck_query_cache";
			if(<>Directory->Exists(folder)) {
				Directory->Create(folder);
			};

			return folder;
		}

		# a 64-bit FNV-1a hash of the URL, as hex, so different URLs get different files
		function : Hash(text : String) ~ String {
			hash := -3750763034362895579;
			each(i : text) {
				hash := hash xor text->Get(i)->As(Int);
				hash := hash * 1099511628211;
			};

			digits := "0123456789abcdef";
			out := "";
			each(i : 16) {
				out->Append(digits->Get((hash >> (60 - i * 4)) and 15));
			};

			return out;
		}

		# the local copy's file name: the hash, then the URL's own file name, so the
		# extension (and a '.gz') still says how to read it
		function : LocalPath(url : String) ~ String {
			path := PathPart(url);
			start := 0;
			each(i : path) {
				if(path->Get(i) = '/') {
					start := i + 1;
				};
			};

			base := path->SubString(start, path->Size() - start);
			if(base->Size() = 0) {
				base := "index";
			};

			name := Folder();
			name += "/";
			name += Hash(url);
			name += "_";
			name += base;
			return name;
		}

		# The current copy of a URL, fetched or revalidated; Nil with the error set. Several
		# threads may fetch one URL at once: the request goes out with no lock held, and the
		# copy and its note are read and replaced only under the URL's file lock (CatalogLocks),
		# which a catalog also holds while it reads the copy. A new copy is written to a file of
		# this process and thread's own, then renamed over the old, and so is its note, which
		# records the copy's stamp; the note's two validator lines are those earlier versions
		# wrote, so either reads the other's cache.
		function : Fetch(url : String, error : StringHolder) ~ UrlFile {
			local := LocalPath(url);
			meta := String->New(local);
			meta += ".meta";

			etag := "";
			modified := "";
			lock := CatalogLocks->ForFile(url);
			critical(lock) {
				lines := Notes(local, meta);
				if(lines <> Nil) {
					etag := lines->Get(0)->Trim();
					modified := lines->Get(1)->Trim();
				};
			};

			client := Web.HTTP.HttpClient->New();
			if(etag <> Nil & etag->Size() > 0) {
				client->AddHeader("If-None-Match", etag);
			};
			if(modified <> Nil & modified->Size() > 0) {
				client->AddHeader("If-Modified-Since", modified);
			};

			response := client->Get(Web.HTTP.Url->New(url));
			code := response <> Nil ? response->GetCode() : 0;
			if(code = 304 & File->Exists(local)) {
				return UrlFile->New(local, "{$etag}|{$modified}");
			};

			if(code < 200 | code > 299) {
				if(code = 0) {
					error->Set("'{$url}': no response from the server");
				}
				else {
					error->Set("'{$url}': the server answered HTTP {$code}");
				};
				return Nil;
			};

			body := response->GetContent();
			if(body = Nil) {
				body := Byte->New[0];
			};

			headers := client->GetResponseHeaders();
			etag := headers->Find("etag");
			modified := headers->Find("last-modified");
			# trimmed, as they are when read back from the note beside the copy
			etag := etag = Nil ? "" : etag->Trim();
			modified := modified = Nil ? "" : modified->Trim();

			# without a validator the content itself tells versions apart
			stamp := "{$etag}|{$modified}";
			if(etag->Size() = 0 & modified->Size() = 0) {
				size := body->Size();
				check := body->CRC32();
				stamp := "{$size}|{$check}";
			};

			# a new copy, and then its note, each beside the old and renamed over it, under a
			# name no other process or thread writes
			mine := ".{$(Runtime->GetProcessId())}_{$(System.Concurrency.Thread->GetCurrentId())}.part";
			partial := String->New(local);
			partial += mine;
			note := String->New(meta);
			note += mine;
			written := false;
			critical(lock) {
				if(FileWriter->WriteFile(partial, body) & File->Rename(partial, local)) {
					if(FileWriter->WriteFile(note, "{$etag}\n{$modified}\n{$stamp}\n")) {
						File->Rename(note, meta);
					};
					written := true;
				};
			};

			if(<>written) {
				File->Delete(partial);
				error->Set("'{$url}': cannot write its copy to '{$local}'");
				return Nil;
			};

			return UrlFile->New(local, stamp);
		}

		# the lines of a URL's note, Nil if it or the copy is missing; the caller holds the
		# URL's lock
		function : Notes(local : String, meta : String) ~ Vector<String> {
			if(<>File->Exists(local) | <>File->Exists(meta)) {
				return Nil;
			};

			notes := FileReader->ReadFile(meta);
			if(notes = Nil) {
				return Nil;
			};

			lines := SourceText->Lines(notes);
			return lines->Size() > 1 ? lines : Nil;
		}

		# The stamp of a URL's local copy as it is now, Nil if there is none: the note's third
		# line, or for a note an earlier version wrote, its validators. The caller holds the
		# URL's lock, so the copy cannot change until it has read it.
		function : CurrentStamp(url : String) ~ String {
			local := LocalPath(url);
			meta := String->New(local);
			meta += ".meta";
			lines := Notes(local, meta);
			if(lines = Nil) {
				return Nil;
			};

			if(lines->Size() > 2) {
				stamp := lines->Get(2)->Trim();
				if(stamp->Size() > 0) {
					return stamp;
				};
			};

			etag := lines->Get(0)->Trim();
			modified := lines->Get(1)->Trim();
			return "{$etag}|{$modified}";
		}
	}

	#~
	A table published by a TableServer (in the query_server library) on another machine, read as
	if it were local. Queries go to the server's /query endpoint as SQL, and results come back
	as .otab, so every type and empty cell arrives exactly. Load sends only the columns and row
	limit the scan hint asks for, and the condition given to SetWhere, so only the rows a query
	needs cross the network; the server applies them, and the local query applies its own WHERE
	again, so pushing a condition down never changes an answer.

```
runs := RemoteSource->New("http://lab-server:8090", "runs");
runs->SetWhere("score > 0.9");
catalog := Catalog->New();
if(catalog->Load(runs)) {
  catalog->Query("select label, count(*) from runs group by label")->ToCsv()->PrintLine();
};
```
	~#
	class RemoteSource implements Source {
		@base : String;
		@name : String;
		@where : String;
		@error : String;

		#~
		Constructor
		@param base server address, such as 'http://localhost:8090'
		@param name published table's name
		~#
		New(base : String, name : String) {
			@base := base;
			while(@base <> Nil & @base->EndsWith('/')) {
				@base := @base->SubString(0, @base->Size() - 1);
			};
			@name := name;
		}

		#~
		Sets a condition for the server to apply before sending rows, as SQL after WHERE
		@param condition condition, such as "score > 0.9 and label = 'cat'"; Nil for none
		~#
		method : public : SetWhere(condition : String) ~ Nil {
			@where := condition;
		}

		#~
		Gets the table's shape, by asking the server for none of its rows
		@return table shapes, Nil on error (see GetError)
		~#
		method : public : GetTables() ~ TableSpec[] {
			empty := Run("select * from {$(Quoted(@name))} limit 0");
			if(empty = Nil) {
				return Nil;
			};

			names := empty->GetColumnNames();
			data_names := String->New[names->Size() - 1];
			types := ColumnType->New[names->Size() - 1];
			for(c := 1; c < names->Size(); c += 1;) {
				data_names[c - 1] := names[c];
				types[c - 1] := empty->GetColumn(c)->GetType();
			};

			specs := TableSpec->New[1];
			specs[0] := TableSpec->New(@name, data_names, types);
			return specs;
		}

		#~
		Loads the table into a catalog under its name
		@param catalog catalog
		@param hint columns and rows needed, Nil for everything
		@return true if loaded, false on error (see GetError)
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			table := Read(hint);
			if(table = Nil) {
				return false;
			};

			catalog->Add(table);
			return true;
		}

		#~
		Reads the table, or the part of it the hint and SetWhere ask for
		@param hint columns and rows needed, Nil for everything
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(hint : ScanHint) ~ Table {
			columns := "*";
			limit := -1;
			if(hint <> Nil) {
				if(hint->GetColumns() <> Nil & hint->GetColumns()->Size() > 0) {
					wanted := hint->GetColumns();
					columns := "";
					each(i : wanted) {
						if(i > 0) {
							columns += ", ";
						};
						columns += Quoted(wanted[i]);
					};
				};
				limit := hint->GetLimit();
			};

			sql := "select {$columns} from {$(Quoted(@name))}";
			if(@where <> Nil & @where->Size() > 0) {
				sql += " where {$@where}";
			};
			if(limit > -1) {
				sql += " limit {$limit}";
			};

			table := Run(sql);
			if(table = Nil) {
				return Nil;
			};

			# under the published name, without copying the columns
			names := table->GetColumnNames();
			data_names := String->New[names->Size() - 1];
			parts := Column->New[names->Size()];
			each(c : names) {
				parts[c] := table->GetColumn(c);
				if(c > 0) {
					data_names[c - 1] := names[c];
				};
			};
			return Table->Restore(@name, data_names, parts, table->GetNextKey());
		}

		#~
		Reads the whole table, or the part SetWhere asks for
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			return Read(Nil);
		}

		#~
		Runs a SELECT on the server, over any of the tables it publishes
		@param statement SQL SELECT
		@return result, Nil on error (see GetError)
		~#
		method : public : Query(statement : String) ~ Table {
			return Run(statement);
		}

		#~
		Gets the reason the last request failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		# a name as SQL, quoted so any column or table name works
		function : Quoted(name : String) ~ String {
			return "\"" + name->ReplaceAll("\"", "\"\"") + "\"";
		}

		# the statement as a UTF-8 POST body, so any text survives; the answer as .otab
		method : Run(statement : String) ~ Table {
			@error := Nil;
			if(@base = Nil) {
				@error := "no server address";
				return Nil;
			};

			client := Web.HTTP.HttpClient->New();
			client->AddHeader("Accept", "application/x-otab");
			response := client->Post(Web.HTTP.Url->New("{$@base}/query"), statement->ToByteArray(), "text/plain; charset=utf-8");
			code := 0;
			body : Byte[];
			if(response <> Nil) {
				code := response->GetCode();
				body := response->GetContent();
			};
			if(code <> 200) {
				if(code = 0) {
					@error := "'{$@base}': no response from the server";
				}
				else {
					text := "HTTP {$code}";
					if(body <> Nil & body->Size() > 0) {
						text := body->ToString();
					};
					@error := "'{$@base}': {$text}";
				};
				return Nil;
			};

			table : Table;
			if(body <> Nil) {
				table := Table->FromBytes(body);
			};
			if(table = Nil) {
				@error := "'{$@base}': the answer is not an .otab table";
			};
			return table;
		}
	}

	#~
	A JSON web service as tables: the array of objects at 'records_path' in each response
	becomes rows, mapped as JsonSource maps them (nested arrays become child tables). Paging
	follows a next-page link found in each response, or adds an offset to the URL, until a
	page is short, the link is missing or repeats, or the row limit is reached. Responses go
	through the same download cache as files named in SQL, so an unchanged page is not
	downloaded again.

```
source := HttpJsonSource->New("https://api.example.org/runs", "runs", "data.items");
source->SetNextLink("links.next");
runs := source->Read();
```
	~#
	class HttpJsonSource implements Source {
		@url : String;
		@name : String;
		@records_path : String;
		@next_path : String;
		@offset_param : String;
		@page_size : Int;
		@limit : Int;
		@pages : Int;
		@error : String;
		@tables : Vector<Table>;

		#~
		Constructor
		@param url first page's URL
		@param name table name
		@param records_path dotted path to the array of records in a response ('data.items');
		an empty path means the response itself is the array
		~#
		New(url : String, name : String, records_path : String) {
			@url := url;
			@name := name;
			@records_path := records_path;
			@limit := -1;
		}

		#~
		Follows a next-page URL found at a dotted path in each response; a missing or null
		value ends paging
		@param path dotted path to the next page's URL
		~#
		method : public : SetNextLink(path : String) ~ Nil {
			@next_path := path;
		}

		#~
		Pages by adding an offset parameter to the URL (offset 0 first); a page with fewer
		than 'page_size' records is the last
		@param param query parameter name, such as 'offset'
		@param page_size records per page
		~#
		method : public : SetOffsetPaging(param : String, page_size : Int) ~ Nil {
			@offset_param := param;
			@page_size := page_size;
		}

		#~
		Stops after this many rows
		@param rows row limit, -1 for none
		~#
		method : public : SetLimit(rows : Int) ~ Nil {
			@limit := rows;
		}

		#~
		Gets how many pages the last Read fetched
		@return pages
		~#
		method : public : GetPageCount() ~ Int {
			return @pages;
		}

		#~
		Gets the tables the service provides, the main table first; they are known only after
		reading it
		@return table shapes
		~#
		method : public : GetTables() ~ TableSpec[] {
			Read();
			return TableShapes->Of(@tables, @name);
		}

		#~
		Loads the service's tables into a catalog
		@param catalog catalog
		@param hint columns and rows of the main table needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			if(Read(hint) = Nil) {
				return false;
			};

			each(i : @tables) {
				catalog->Add(@tables->Get(i));
			};
			return true;
		}

		#~
		Reads every page into the main table; GetChildTables then has the others
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			none : ScanHint;
			return Read(none);
		}

		#~
		Reads every page into the main table; GetChildTables then has the others
		@param hint columns and rows of the main table needed, Nil for everything
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(hint : ScanHint) ~ Table {
			@error := Nil;
			@tables := Nil;
			@pages := 0;
			limit := @limit;
			if(hint <> Nil & hint->GetLimit() > -1 & (limit < 0 | hint->GetLimit() < limit)) {
				limit := hint->GetLimit();
			};

			builder := JsonTableBuilder->New(@name, false);
			seen := Hash->New()<String, BoolRef>;
			offset := 0;
			url := @offset_param <> Nil ? WithParam(@url, @offset_param, 0) : @url;
			while(url <> Nil & (limit < 0 | builder->Size() < limit)) {
				seen->Insert(url, BoolRef->New(true));
				error := StringHolder->New();
				fetched := UrlCache->Fetch(url, error);
				if(fetched = Nil) {
					@error := error->Get();
					return Nil;
				};

				text := SourceText->Read(fetched->GetPath());
				parser := Data.JSON.JsonParser->New(text <> Nil ? text : "");
				if(text = Nil | <>parser->Parse()) {
					@error := "'{$url}': the response is not valid JSON";
					return Nil;
				};
				@pages += 1;

				root := parser->GetRoot();
				records := Navigate(root, @records_path);
				if(records = Nil | records->GetType() <> Data.JSON.JsonElement->JsonType->ARRAY) {
					@error := "'{$url}': no array at '{$@records_path}'";
					return Nil;
				};

				count := records->Size();
				each(i : count) {
					if(limit < 0 | builder->Size() < limit) {
						item := records->Get(i);
						if(item->GetType() <> Data.JSON.JsonElement->JsonType->OBJECT) {
							@error := "'{$url}': record {$(i + 1)} is not an object";
							return Nil;
						};
						builder->AddObject(item, 0);
					};
				};

				next_url : String;
				if(@next_path <> Nil) {
					link := Navigate(root, @next_path);
					if(link <> Nil & link->GetType() = Data.JSON.JsonElement->JsonType->STRING) {
						next_url := Data.JSON.JsonElement->Decode(link->GetString());
					};
				}
				else if(@offset_param <> Nil & count >= @page_size & @page_size > 0) {
					offset += @page_size;
					next_url := WithParam(@url, @offset_param, offset);
				};

				# a link back to a page already read ends paging rather than looping
				if(next_url <> Nil & seen->Has(next_url)) {
					next_url := Nil;
				};
				url := next_url;
			};

			@tables := Vector->New()<Table>;
			builder->Build(hint, @tables);
			return @tables->Get(0);
		}

		# the value at a dotted path, Nil if a step is missing; an empty path is the root
		function : Navigate(root : Data.JSON.JsonElement, path : String) ~ Data.JSON.JsonElement {
			if(path = Nil | path->Size() = 0) {
				return root;
			};

			node := root;
			part := "";
			each(i : path) {
				c := path->Get(i);
				if(c = '.') {
					node := Step(node, part);
					if(node = Nil) {
						return Nil;
					};
					part := "";
				}
				else {
					part->Append(c);
				};
			};

			return Step(node, part);
		}

		function : Step(node : Data.JSON.JsonElement, name : String) ~ Data.JSON.JsonElement {
			if(node = Nil | node->GetType() <> Data.JSON.JsonElement->JsonType->OBJECT) {
				return Nil;
			};

			child := node->Get(name);
			if(child = Nil | child->GetType() = Data.JSON.JsonElement->JsonType->NULL) {
				return Nil;
			};

			return child;
		}

		# the URL with a query parameter added
		function : WithParam(url : String, param : String, value : Int) ~ String {
			separator := url->Has('?') ? "&" : "?";
			return "{$url}{$separator}{$param}={$value}";
		}

		#~
		Gets the child tables the last Read made
		@return child tables, empty if there are none
		~#
		method : public : GetChildTables() ~ Vector<Table> {
			children := Vector->New()<Table>;
			if(@tables <> Nil) {
				for(i := 1; i < @tables->Size(); i += 1;) {
					children->AddBack(@tables->Get(i));
				};
			};

			return children;
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	class : private : SourceText {
		function : Read(path : String) ~ String {
			reason := StringHolder->New();
			return Read(path, reason);
		}

		# a file's text, or a URL's through the download cache; '.gz' is decompressed. Nil
		# with 'error' set when it cannot be read.
		function : Read(path : String, error : StringHolder) ~ String {
			if(path = Nil) {
				error->Set("no file and no text");
				return Nil;
			};

			if(UrlCache->IsUrl(path)) {
				fetched := UrlCache->Fetch(path, error);
				if(fetched = Nil) {
					return Nil;
				};

				text := ReadLocal(fetched->GetPath());
				if(text = Nil) {
					if(UrlCache->PathPart(path)->EndsWith(".gz")) {
						error->Set("'{$path}' is not valid gzip data, or is truncated");
					}
					else {
						error->Set("'{$path}': its downloaded copy cannot be read");
					};
				};
				return text;
			};

			text := ReadLocal(path);
			if(text = Nil) {
				error->Set(Failure(path));
			};
			return text;
		}

		function : ReadLocal(path : String) ~ String {

			if(path->EndsWith(".gz")) {
				bytes := FileReader->ReadBinaryFile(path);
				if(bytes = Nil) {
					return Nil;
				};

				raw : Byte[];
				try {
					raw := bytes->UncompressGzip();
				}
				on(e : Error) {
					return Nil;
				};

				if(raw = Nil) {
					return Nil;
				};

				return raw->ToString();
			};

			return FileReader->ReadFile(path);
		}

		# why Read() gave Nil
		function : Failure(path : String) ~ String {
			if(path <> Nil & path->EndsWith(".gz") & File->Exists(path)) {
				return "'{$path}' is not valid gzip data, or is truncated";
			};

			return "cannot read '{$path}'";
		}

		# a file's name without its folder, '.gz' or extension; a URL's without its query
		function : BaseName(path : String, fallback : String) ~ String {
			if(path = Nil) {
				return fallback;
			};

			if(UrlCache->IsUrl(path)) {
				path := UrlCache->PathPart(path);
			};

			start := 0;
			each(i : path) {
				c := path->Get(i);
				if(c = '/' | c = '\\') {
					start := i + 1;
				};
			};

			name := path->SubString(start, path->Size() - start);
			if(name->EndsWith(".gz")) {
				name := name->SubString(0, name->Size() - 3);
			};

			dot := name->FindLast('.');
			if(dot > 0) {
				name := name->SubString(0, dot);
			};

			return name;
		}

		# the text split into lines, without their line endings
		function : Lines(text : String) ~ Vector<String> {
			lines := Vector->New()<String>;
			start := 0;
			size := text->Size();
			i := 0;
			while(i < size) {
				c := text->Get(i);
				if(c = '\n' | c = '\r') {
					lines->AddBack(text->SubString(start, i - start));
					if(c = '\r' & i + 1 < size) {
						if(text->Get(i + 1) = '\n') {
							i += 1;
						};
					};
					start := i + 1;
				};
				i += 1;
			};

			if(start < size) {
				lines->AddBack(text->SubString(start, size - start));
			};

			return lines;
		}

		# the column type a list of text values calls for: INT, FLOAT, DATE or STRING
		function : ScanType(values : Vector<String>) ~ ColumnType {
			has_int := false;
			has_float := false;
			has_date := false;
			has_text := false;
			each(i : values) {
				text := values->Get(i);
				if(text <> Nil & text->Size() > 0) {
					kind := Cell->NumberKind(text);
					if(kind = 1) {
						has_int := true;
					}
					else if(kind = 2) {
						has_float := true;
					}
					else if(CsvSource->IsDate(text)) {
						has_date := true;
					}
					else {
						has_text := true;
					};
				};
			};

			if(has_text | (has_date & (has_int | has_float))) {
				return ColumnType->STRING;
			}
			else if(has_date) {
				return ColumnType->DATE;
			}
			else if(has_float) {
				return ColumnType->FLOAT;
			}
			else if(has_int) {
				return ColumnType->INT;
			};

			return ColumnType->STRING;
		}
	}

	#~
	A text file read with a regular expression: each line (or each multi-line record) is
	searched for the pattern, and its numbered capture groups become the named columns. Columns
	are typed by reading all their values, as CsvSource types CSV columns. Lines that do not
	match are counted, and can be kept in a second table '<name>_unmatched' with the line number
	and text. Training logs, server logs and instrument output are the usual inputs. A name
	ending in '.gz' is decompressed first.

```
# epoch 3 loss 0.4123 acc 0.871
source := TextSource->New("train.log", "epoch (\\d+) loss ([0-9.]+) acc ([0-9.]+)", ["epoch", "loss", "acc"]);
log := source->Read();
log->Query("select epoch, loss from train where acc > 0.85")->ToString()->PrintLine();
```
	~#
	class TextSource implements Source {
		@path : String;
		@name : String;
		@pattern : String;
		@names : String[];
		@record_start : String;
		@keep_unmatched : Bool;
		@unmatched : Table;
		@unmatched_count : Int;
		@error : String;

		#~
		Constructor; the table is named after the file
		@param path text file
		@param pattern regular expression with one capture group per column
		@param names column names, one per capture group in order
		~#
		New(path : String, pattern : String, names : String[]) {
			@path := path;
			@name := SourceText->BaseName(path, "text");
			@pattern := pattern;
			@names := names;
		}

		#~
		Constructor
		@param path text file
		@param name table name
		@param pattern regular expression with one capture group per column
		@param names column names, one per capture group in order
		@param record_start a regular expression a line matches at its start when it begins a new record; lines up to the next such line are joined with '\n'. Empty for one record per line.
		@param keep_unmatched true to keep lines that do not match in a second table
		~#
		New(path : String, name : String, pattern : String, names : String[], record_start : String, keep_unmatched : Bool) {
			@path := path;
			@name := name;
			@pattern := pattern;
			@names := names;
			if(record_start <> Nil & record_start->Size() > 0) {
				@record_start := record_start;
			};
			@keep_unmatched := keep_unmatched;
		}

		#~
		Gets the tables the file provides; column types are known only after reading it
		@return the table, and the unmatched-lines table when kept
		~#
		method : public : GetTables() ~ TableSpec[] {
			table := Read();
			specs := TableSpec->New[@keep_unmatched ? 2 : 1];
			types := ColumnType->New[@names->Size()];
			each(i : types) {
				types[i] := ColumnType->NONE;
				if(table <> Nil) {
					types[i] := table->GetColumn(i + 1)->GetType();
				};
			};
			specs[0] := TableSpec->New(@name, @names, types);
			if(@keep_unmatched) {
				specs[1] := TableSpec->New(@name + "_unmatched", ["line", "text"], UnmatchedTypes());
			};

			return specs;
		}

		#~
		Loads the file into a catalog, with the unmatched-lines table when kept
		@param catalog catalog
		@param hint columns and rows needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			table := Read(hint);
			if(table = Nil) {
				return false;
			};

			catalog->Add(table);
			if(@keep_unmatched) {
				catalog->Add(@unmatched);
			};

			return true;
		}

		#~
		Reads the file as a table
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			none : ScanHint;
			return Read(none);
		}

		#~
		Reads the file as a table
		@param hint columns and rows needed, Nil for everything
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(hint : ScanHint) ~ Table {
			@error := Nil;
			@unmatched_count := 0;
			@unmatched := Table->New(@name + "_unmatched", ["line", "text"], UnmatchedTypes());

			reason := StringHolder->New();
			text := SourceText->Read(@path, reason);
			if(text = Nil) {
				@error := reason->Get();
				return Nil;
			};

			regex := RegEx->New(@pattern);
			if(<>regex->IsOk()) {
				@error := "the pattern '{$@pattern}' is not a valid regular expression";
				return Nil;
			};

			start_regex : RegEx;
			if(@record_start <> Nil) {
				start_regex := RegEx->New(@record_start);
				if(<>start_regex->IsOk()) {
					@error := "the record start '{$@record_start}' is not a valid regular expression";
					return Nil;
				};
			};

			# records, with the line each began on
			records := Vector->New()<String>;
			record_lines := Vector->New()<IntRef>;
			lines := SourceText->Lines(text);
			current : String;
			current_line := 0;
			each(i : lines) {
				line := lines->Get(i);
				if(start_regex = Nil) {
					if(line->Size() > 0) {
						records->AddBack(line);
						record_lines->AddBack(i + 1);
					};
				}
				else {
					found := start_regex->FindFirst(line);
					if(found <> Nil & found->GetStart() = 0) {
						if(current <> Nil) {
							records->AddBack(current);
							record_lines->AddBack(current_line);
						};
						current := String->New(line);
						current_line := i + 1;
					}
					else if(current <> Nil) {
						current += '\n';
						current += line;
					}
					else if(line->Size() > 0) {
						NoteUnmatched(i + 1, line);
					};
				};
			};
			if(current <> Nil) {
				records->AddBack(current);
				record_lines->AddBack(current_line);
			};

			limit := -1;
			if(hint <> Nil) {
				limit := hint->GetLimit();
			};

			# the capture groups of every matching record
			width := @names->Size();
			matched := Vector->New()<String>;
			matched_rows := 0;
			each(i : records) {
				if(limit < 0 | matched_rows < limit) {
					text_value := records->Get(i);
					result := regex->FindFirst(text_value);
					if(result = Nil) {
						NoteUnmatched(record_lines->Get(i)->Get(), text_value);
					}
					else {
						if(result->GroupCount() < @names->Size()) {
							@error := "the pattern has {$(result->GroupCount())} capture groups but {$(@names->Size())} column names";
							return Nil;
						};
						each(j : width) {
							matched->AddBack(result->GetGroup(j + 1));
						};
						matched_rows += 1;
					};
				};
			};

			# columns typed by all their values
			wanted := Vector->New()<IntRef>;
			each(j : @names) {
				if(hint = Nil | hint->Wants(@names[j])) {
					wanted->AddBack(j);
				};
			};

			names := String->New[wanted->Size()];
			types := ColumnType->New[wanted->Size()];
			each(k : names) {
				j := wanted->Get(k)->Get();
				names[k] := @names[j];
				column_values := Vector->New()<String>;
				each(r : matched_rows) {
					column_values->AddBack(matched->Get(r * width + j));
				};
				types[k] := SourceText->ScanType(column_values);
			};

			table := Table->New(@name, names, types, false);
			each(r : matched_rows) {
				row := table->Insert();
				each(k : names) {
					value := matched->Get(r * width + wanted->Get(k)->Get());
					if(value <> Nil & value->Size() > 0) {
						row->Set(k + 1, CsvSource->Convert(value, types[k]));
					};
				};
			};

			return table;
		}

		function : UnmatchedTypes() ~ ColumnType[] {
			types := ColumnType->New[2];
			types[0] := ColumnType->INT;
			types[1] := ColumnType->STRING;
			return types;
		}

		method : NoteUnmatched(line : Int, text : String) ~ Nil {
			@unmatched_count += 1;
			if(@keep_unmatched) {
				row := @unmatched->Insert();
				row->Set("line", IntRef->New(line));
				row->Set("text", text);
			};
		}

		#~
		Gets the lines that did not match, when they are kept
		@return table of line numbers and text
		~#
		method : public : GetUnmatched() ~ Table {
			return @unmatched;
		}

		#~
		Gets how many lines or records did not match in the last read
		@return count
		~#
		method : public : GetUnmatchedCount() ~ Int {
			return @unmatched_count;
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	#~
	A JSON Lines file (one JSON object per line, '.jsonl' or '.ndjson') as a table. Nested
	objects become dotted column names ('address.city'), and each nested array becomes a
	child table, as JsonSource makes them: an array member 'tags' of table 'runs' is the table
	'runs_tags', joined back through '_parent_id' = '_id'. Columns are typed by all their
	values: whole numbers INT, any decimal FLOAT, true and false BOOL, and any mix, or text,
	STRING. null and a missing key are empty cells. A line that is not a JSON object is an
	error naming the line. Columns appear in the order keys are first seen, alphabetical
	within an object. A name ending in '.gz' is decompressed first.

```
runs := JsonLinesSource->New("eval.jsonl")->Read();
runs->Describe()->ToString()->PrintLine();
```
	~#
	class JsonLinesSource implements Source {
		@path : String;
		@name : String;
		@text : String;
		@error : String;
		@tables : Vector<Table>;

		#~
		Constructor; the table is named after the file
		@param path JSON Lines file
		~#
		New(path : String) {
			@path := path;
			@name := SourceText->BaseName(path, "jsonl");
		}

		#~
		Constructor
		@param path JSON Lines file
		@param name table name
		~#
		New(path : String, name : String) {
			@path := path;
			@name := name;
		}

		#~
		Makes a source over JSON Lines text already in memory
		@param name table name
		@param text JSON Lines text
		@return source
		~#
		function : FromText(name : String, text : String) ~ JsonLinesSource {
			source := JsonLinesSource->New(Nil, name);
			source->SetText(text);
			return source;
		}

		method : public : SetText(text : String) ~ Nil {
			@text := text;
		}

		#~
		Gets the tables the file provides, the main table first; they are known only after
		reading it
		@return table shapes
		~#
		method : public : GetTables() ~ TableSpec[] {
			Read();
			return TableShapes->Of(@tables, @name);
		}

		#~
		Loads the file's tables into a catalog
		@param catalog catalog
		@param hint columns and rows of the main table needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			if(Read(hint) = Nil) {
				return false;
			};

			each(i : @tables) {
				catalog->Add(@tables->Get(i));
			};
			return true;
		}

		#~
		Gets the child tables the last Read made, in the order their arrays were first seen
		@return child tables, empty if there are none
		~#
		method : public : GetChildTables() ~ Vector<Table> {
			children := Vector->New()<Table>;
			if(@tables <> Nil) {
				for(i := 1; i < @tables->Size(); i += 1;) {
					children->AddBack(@tables->Get(i));
				};
			};

			return children;
		}

		#~
		Reads the file as a table
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			none : ScanHint;
			return Read(none);
		}

		#~
		Reads the file as a table
		@param hint columns and rows needed, Nil for everything
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(hint : ScanHint) ~ Table {
			@error := Nil;
			@tables := Nil;
			text := @text;
			if(text = Nil) {
				reason := StringHolder->New();
				text := SourceText->Read(@path, reason);
				if(text = Nil) {
					@error := reason->Get();
					return Nil;
				};
			};

			limit := -1;
			if(hint <> Nil) {
				limit := hint->GetLimit();
			};

			builder := JsonTableBuilder->New(@name, false);
			lines := SourceText->Lines(text);
			each(i : lines) {
				line := lines->Get(i)->Trim();
				if(line->Size() > 0 & (limit < 0 | builder->Size() < limit)) {
					element := Data.JSON.JsonParser->TextToElement(line);
					if(element = Nil | element->GetType() <> Data.JSON.JsonElement->JsonType->OBJECT) {
						@error := "line {$(i + 1)}: not a JSON object";
						return Nil;
					};
					builder->AddObject(element, 0);
				};
			};

			@tables := Vector->New()<Table>;
			builder->Build(hint, @tables);
			return @tables->Get(0);
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	#
	# Hierarchies as related tables (docs/QUERY_DESIGN.md, section 6): a nested repeated part
	# of a record becomes a child table whose '_parent_id' is the record's '_id'. A table has
	# an '_id' column exactly when some child table refers to it, and a child table always
	# has '_parent_id'. Both count from 1 within their table.
	#

	# one table of a JSON document and its child tables, built record by record
	class : private : JsonTableBuilder {
		@name : String;
		@is_child : Bool;
		@order : Vector<String>;
		@positions : Hash<String, IntRef>;
		@records : Vector<Hash<String, JsonCell>>;
		@parents : Vector<IntRef>;
		@children : Vector<JsonTableBuilder>;
		@child_index : Hash<String, JsonTableBuilder>;

		New(name : String, is_child : Bool) {
			@name := name;
			@is_child := is_child;
			@order := Vector->New()<String>;
			@positions := Hash->New()<String, IntRef>;
			@records := Vector->New()<Hash<String, JsonCell>>;
			@parents := Vector->New()<IntRef>;
			@children := Vector->New()<JsonTableBuilder>;
			@child_index := Hash->New()<String, JsonTableBuilder>;
		}

		method : public : Size() ~ Int {
			return @records->Size();
		}

		# adds an object as a row; its nested arrays go to child tables
		method : public : AddObject(element : Data.JSON.JsonElement, parent : Int) ~ Nil {
			id := @records->Size() + 1;
			cells := Hash->New()<String, JsonCell>;
			Flatten(element, "", cells, id);
			@records->AddBack(cells);
			@parents->AddBack(IntRef->New(parent));
		}

		# adds a value that is not an object as a row with one 'value' column
		method : public : AddValue(element : Data.JSON.JsonElement, parent : Int) ~ Nil {
			cells := Hash->New()<String, JsonCell>;
			cell := ToCell(element);
			if(cell <> Nil) {
				Note("value");
				cells->Insert("value", cell);
			};
			@records->AddBack(cells);
			@parents->AddBack(IntRef->New(parent));
		}

		method : Note(name : String) ~ Nil {
			if(<>@positions->Has(name)) {
				@positions->Insert(name, IntRef->New(@order->Size()));
				@order->AddBack(name);
			};
		}

		# a scalar as a cell; an array inside an array is kept as its JSON text; Nil for null
		function : ToCell(element : Data.JSON.JsonElement) ~ JsonCell {
			type := element->GetType();
			if(type = Data.JSON.JsonElement->JsonType->STRING) {
				return JsonCell->New(JsonCell->Kind->TEXT, Data.JSON.JsonElement->Decode(element->GetString()));
			}
			else if(type = Data.JSON.JsonElement->JsonType->NUMBER) {
				return JsonCell->New(JsonCell->Kind->NUMBER, element->GetValue());
			}
			else if(type = Data.JSON.JsonElement->JsonType->TRUE) {
				return JsonCell->New(JsonCell->Kind->BOOL, "true");
			}
			else if(type = Data.JSON.JsonElement->JsonType->FALSE) {
				return JsonCell->New(JsonCell->Kind->BOOL, "false");
			}
			else if(type = Data.JSON.JsonElement->JsonType->ARRAY | type = Data.JSON.JsonElement->JsonType->OBJECT) {
				return JsonCell->New(JsonCell->Kind->TEXT, element->ToString());
			};

			return Nil;
		}

		# an object's members as cells, nested objects under dotted names, arrays as child rows
		method : Flatten(element : Data.JSON.JsonElement, prefix : String, cells : Hash<String, JsonCell>, id : Int) ~ Nil {
			names := element->GetNames();
			each(i : names) {
				key := names->Get(i);
				name := String->New(prefix);
				name += key;
				child := element->Get(key);
				type := child->GetType();
				if(type = Data.JSON.JsonElement->JsonType->OBJECT) {
					nested := String->New(name);
					nested += '.';
					Flatten(child, nested, cells, id);
				}
				else if(type = Data.JSON.JsonElement->JsonType->ARRAY) {
					table := Child(name);
					count := child->Size();
					each(j : count) {
						item := child->Get(j);
						if(item->GetType() = Data.JSON.JsonElement->JsonType->OBJECT) {
							table->AddObject(item, id);
						}
						else {
							table->AddValue(item, id);
						};
					};
				}
				else {
					cell := ToCell(child);
					if(cell <> Nil) {
						Note(name);
						cells->Insert(name, cell);
					};
				};
			};
		}

		# the child table for an array member; 'tags' of table 'runs' is 'runs_tags'
		method : Child(member : String) ~ JsonTableBuilder {
			table := @child_index->Find(member);
			if(table = Nil) {
				name := String->New(@name);
				name += '_';
				each(i : member) {
					c := member->Get(i);
					name->Append(c = '.' ? '_' : c);
				};
				table := JsonTableBuilder->New(name, true);
				@child_index->Insert(member, table);
				@children->AddBack(table);
			};

			return table;
		}

		# this table, then its child tables, depth first; the hint applies to this table only
		method : public : Build(hint : ScanHint, tables : Vector<Table>) ~ Nil {
			names := Vector->New()<String>;
			keyed := @children->Size() > 0;
			if(keyed) {
				names->AddBack("_id");
			};
			if(@is_child) {
				names->AddBack("_parent_id");
			};

			first_data := names->Size();
			each(i : @order) {
				name := @order->Get(i);
				if(hint = Nil | hint->Wants(name)) {
					names->AddBack(name);
				};
			};

			column_names := String->New[names->Size()];
			column_types := ColumnType->New[names->Size()];
			each(i : column_names) {
				column_names[i] := names->Get(i);
				column_types[i] := i < first_data ? ColumnType->INT : ColumnTypeOf(@records, column_names[i]);
			};

			table := Table->New(@name, column_names, column_types, false);
			each(r : @records) {
				cells := @records->Get(r);
				row := table->Insert();
				c := 0;
				if(keyed) {
					row->Set(c + 1, IntRef->New(r + 1));
					c += 1;
				};
				if(@is_child) {
					row->Set(c + 1, IntRef->New(@parents->Get(r)->Get()));
				};

				for(k := first_data; k < column_names->Size(); k += 1;) {
					cell := cells->Find(column_names[k]);
					if(cell <> Nil) {
						row->Set(k + 1, cell->ToValue(column_types[k]));
					};
				};
			};
			tables->AddBack(table);

			none : ScanHint;
			each(i : @children) {
				@children->Get(i)->Build(none, tables);
			};
		}

		# the type a column calls for over every record
		function : ColumnTypeOf(records : Vector<Hash<String, JsonCell>>, name : String) ~ ColumnType {
			has_int := false;
			has_float := false;
			has_bool := false;
			has_text := false;
			each(r : records) {
				cell := records->Get(r)->Find(name);
				if(cell <> Nil) {
					select(cell->GetKind()) {
						label JsonCell->Kind->NUMBER: {
							if(Cell->NumberKind(cell->GetText()) = 1) {
								has_int := true;
							}
							else {
								has_float := true;
							};
						}

						label JsonCell->Kind->BOOL: {
							has_bool := true;
						}

						label JsonCell->Kind->TEXT: {
							has_text := true;
						}
					};
				};
			};

			if(has_text | (has_bool & (has_int | has_float))) {
				return ColumnType->STRING;
			}
			else if(has_bool) {
				return ColumnType->BOOL;
			}
			else if(has_float) {
				return ColumnType->FLOAT;
			}
			else if(has_int) {
				return ColumnType->INT;
			};

			return ColumnType->STRING;
		}
	}

	# the shapes of tables, for Source->GetTables
	class : private : TableShapes {
		function : Of(tables : Vector<Table>, fallback : String) ~ TableSpec[] {
			if(tables = Nil | tables->Size() = 0) {
				specs := TableSpec->New[1];
				specs[0] := TableSpec->New(fallback, String->New[0], ColumnType->New[0]);
				return specs;
			};

			specs := TableSpec->New[tables->Size()];
			each(t : specs) {
				table := tables->Get(t);
				names := table->GetColumnNames();
				columns := String->New[names->Size() - 1];
				types := ColumnType->New[names->Size() - 1];
				each(i : columns) {
					columns[i] := names[i + 1];
					types[i] := table->GetColumn(i + 1)->GetType();
				};
				specs[t] := TableSpec->New(table->GetName(), columns, types);
			};

			return specs;
		}
	}

	#~
	A JSON document as tables: an array of objects (or one object) becomes a table, nested
	objects become dotted column names ('address.city'), and each nested array becomes a child
	table joined back through '_parent_id' = '_id'; an array member 'tags' of table 'runs' is
	the table 'runs_tags'. Array items that are not objects become a child table with one
	'value' column. Columns are typed as JsonLinesSource types them. A name ending in '.gz' is
	decompressed first.

```
catalog := Catalog->New();
catalog->Load(JsonSource->New("runs.json"));
rs := catalog->Query("select r.name, t.value from runs r join runs_tags t on t._parent_id = r._id");
```
	~#
	class JsonSource implements Source {
		@path : String;
		@name : String;
		@text : String;
		@error : String;
		@tables : Vector<Table>;

		#~
		Constructor; the table is named after the file
		@param path JSON file
		~#
		New(path : String) {
			@path := path;
			@name := SourceText->BaseName(path, "json");
		}

		#~
		Constructor
		@param path JSON file
		@param name table name
		~#
		New(path : String, name : String) {
			@path := path;
			@name := name;
		}

		#~
		Makes a source over JSON text already in memory
		@param name table name
		@param text JSON text
		@return source
		~#
		function : FromText(name : String, text : String) ~ JsonSource {
			source := JsonSource->New(Nil, name);
			source->SetText(text);
			return source;
		}

		method : public : SetText(text : String) ~ Nil {
			@text := text;
		}

		#~
		Gets the tables the document provides, the main table first; they are known only after
		reading it
		@return table shapes
		~#
		method : public : GetTables() ~ TableSpec[] {
			Read();
			return TableShapes->Of(@tables, @name);
		}

		#~
		Loads the document's tables into a catalog
		@param catalog catalog
		@param hint columns and rows of the main table needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			if(Read(hint) = Nil) {
				return false;
			};

			each(i : @tables) {
				catalog->Add(@tables->Get(i));
			};
			return true;
		}

		#~
		Reads the document's main table; GetChildTables then has the others
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			none : ScanHint;
			return Read(none);
		}

		#~
		Reads the document's main table; GetChildTables then has the others
		@param hint columns and rows of the main table needed, Nil for everything
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(hint : ScanHint) ~ Table {
			@error := Nil;
			@tables := Nil;
			text := @text;
			if(text = Nil) {
				reason := StringHolder->New();
				text := SourceText->Read(@path, reason);
				if(text = Nil) {
					@error := reason->Get();
					return Nil;
				};
			};

			parser := Data.JSON.JsonParser->New(text);
			if(<>parser->Parse()) {
				@error := "'{$@name}' is not valid JSON";
				reason := parser->GetError();
				if(reason <> Nil) {
					@error += ": ";
					@error += reason->Trim();
				};
				return Nil;
			};
			root := parser->GetRoot();

			limit := hint <> Nil ? hint->GetLimit() : -1;
			builder := JsonTableBuilder->New(@name, false);
			type := root->GetType();
			if(type = Data.JSON.JsonElement->JsonType->OBJECT) {
				builder->AddObject(root, 0);
			}
			else if(type = Data.JSON.JsonElement->JsonType->ARRAY) {
				count := root->Size();
				each(i : count) {
					if(limit < 0 | builder->Size() < limit) {
						item := root->Get(i);
						if(item->GetType() <> Data.JSON.JsonElement->JsonType->OBJECT) {
							@error := "'{$@name}': element {$(i + 1)} of the array is not an object";
							return Nil;
						};
						builder->AddObject(item, 0);
					};
				};
			}
			else {
				@error := "'{$@name}': the document is not an object or an array of objects";
				return Nil;
			};

			@tables := Vector->New()<Table>;
			builder->Build(hint, @tables);
			return @tables->Get(0);
		}

		#~
		Gets the child tables the last Read made: depth first, in the order their arrays were
		first seen, an object's members taken alphabetically
		@return child tables, empty if there are none
		~#
		method : public : GetChildTables() ~ Vector<Table> {
			children := Vector->New()<Table>;
			if(@tables <> Nil) {
				for(i := 1; i < @tables->Size(); i += 1;) {
					children->AddBack(@tables->Get(i));
				};
			};

			return children;
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	# one table of an XML document and its child tables: the elements that are its rows
	class : private : XmlTableBuilder {
		@name : String;
		@is_child : Bool;
		@rows : Vector<XmlElement>;
		@parents : Vector<IntRef>;

		New(name : String, is_child : Bool) {
			@name := name;
			@is_child := is_child;
			@rows := Vector->New()<XmlElement>;
			@parents := Vector->New()<IntRef>;
		}

		method : public : Size() ~ Int {
			return @rows->Size();
		}

		method : public : Add(element : XmlElement, parent : Int) ~ Nil {
			@rows->AddBack(element);
			@parents->AddBack(IntRef->New(parent));
		}

		function : IsElement(element : XmlElement) ~ Bool {
			type := element->GetType();
			return type = XmlElement->Type->ELEMENT | type = XmlElement->Type->UNARY_ELEMENT;
		}

		# the element children of an element
		function : Elements(element : XmlElement) ~ Vector<XmlElement> {
			found := Vector->New()<XmlElement>;
			children := element->GetChildren();
			if(children <> Nil) {
				each(i : children) {
					child := children->Get(i);
					if(IsElement(child)) {
						found->AddBack(child);
					};
				};
			};

			return found;
		}

		# whether an element is only text: no attributes and no element children
		function : IsSimple(element : XmlElement) ~ Bool {
			return element->GetAttributes()->Size() = 0 & Elements(element)->Size() = 0;
		}

		function : TextOf(element : XmlElement) ~ String {
			text := element->GetDecodedContent();
			if(text = Nil) {
				return Nil;
			};

			text := text->Trim();
			return text->Size() > 0 ? text : Nil;
		}

		# this table, then its child tables, depth first; the hint applies to this table only
		method : public : Build(hint : ScanHint, tables : Vector<Table>) ~ Nil {
			# a child element name is a column when, in every row, it appears at most once and
			# holds only text; otherwise its elements are rows of a child table
			order := Vector->New()<String>;
			seen := Hash->New()<String, IntRef>;
			nested := Hash->New()<String, BoolRef>;
			each(r : @rows) {
				row := @rows->Get(r);
				attributes := row->GetAttributes();
				each(a : attributes) {
					attribute_name := attributes->Get(a)->GetName();
					Remember("@{$attribute_name}", order, seen);
				};

				counts := Hash->New()<String, IntRef>;
				elements := Elements(row);
				each(e : elements) {
					element := elements->Get(e);
					name := element->GetName();
					count := counts->Find(name);
					if(count = Nil) {
						counts->Insert(name, IntRef->New(1));
					}
					else {
						count->Set(count->Get() + 1);
						nested->Insert(name, BoolRef->New(true));
					};

					if(<>IsSimple(element)) {
						nested->Insert(name, BoolRef->New(true));
					};
					Remember(name, order, seen);
				};

				if(elements->Size() = 0 & TextOf(row) <> Nil) {
					Remember("_text", order, seen);
				};
			};

			# the child tables, one per nested element name, in the order first seen
			children := Vector->New()<XmlTableBuilder>;
			child_index := Hash->New()<String, XmlTableBuilder>;
			each(i : order) {
				name := order->Get(i);
				if(nested->Has(name)) {
					child := XmlTableBuilder->New("{$@name}_{$name}", true);
					children->AddBack(child);
					child_index->Insert(name, child);
				};
			};

			names := Vector->New()<String>;
			keyed := children->Size() > 0;
			if(keyed) {
				names->AddBack("_id");
			};
			if(@is_child) {
				names->AddBack("_parent_id");
			};
			first_data := names->Size();
			each(i : order) {
				name := order->Get(i);
				if(<>nested->Has(name) & (hint = Nil | hint->Wants(name))) {
					names->AddBack(name);
				};
			};

			# every cell as text, then each column typed by all of its values
			column_names := String->New[names->Size()];
			each(i : column_names) {
				column_names[i] := names->Get(i);
			};

			cells := Vector->New()<Hash<String, String>>;
			each(r : @rows) {
				row := @rows->Get(r);
				values := Hash->New()<String, String>;
				attributes := row->GetAttributes();
				each(a : attributes) {
					attribute := attributes->Get(a);
					value := attribute->GetValue();
					if(value <> Nil) {
						attribute_name := attribute->GetName();
						values->Insert("@{$attribute_name}", XmlElement->DecodeString(value));
					};
				};

				elements := Elements(row);
				each(e : elements) {
					element := elements->Get(e);
					child := child_index->Find(element->GetName());
					if(child <> Nil) {
						child->Add(element, r + 1);
					}
					else {
						text := TextOf(element);
						if(text <> Nil) {
							values->Insert(element->GetName(), text);
						};
					};
				};

				if(elements->Size() = 0) {
					text := TextOf(row);
					if(text <> Nil) {
						values->Insert("_text", text);
					};
				};
				cells->AddBack(values);
			};

			column_types := ColumnType->New[column_names->Size()];
			each(c : column_names) {
				if(c < first_data) {
					column_types[c] := ColumnType->INT;
				}
				else {
					texts := Vector->New()<String>;
					each(r : cells) {
						texts->AddBack(cells->Get(r)->Find(column_names[c]));
					};
					column_types[c] := SourceText->ScanType(texts);
				};
			};

			table := Table->New(@name, column_names, column_types, false);
			each(r : cells) {
				values := cells->Get(r);
				row := table->Insert();
				c := 0;
				if(keyed) {
					row->Set(c + 1, IntRef->New(r + 1));
					c += 1;
				};
				if(@is_child) {
					row->Set(c + 1, IntRef->New(@parents->Get(r)->Get()));
				};

				for(k := first_data; k < column_names->Size(); k += 1;) {
					text := values->Find(column_names[k]);
					if(text <> Nil) {
						row->Set(k + 1, CsvSource->Convert(text, column_types[k]));
					};
				};
			};
			tables->AddBack(table);

			none : ScanHint;
			each(i : children) {
				children->Get(i)->Build(none, tables);
			};
		}

		function : Remember(name : String, order : Vector<String>, seen : Hash<String, IntRef>) ~ Nil {
			if(<>seen->Has(name)) {
				seen->Insert(name, IntRef->New(order->Size()));
				order->AddBack(name);
			};
		}
	}

	#~
	An XML document as tables: each element named 'row_element' is a row. Its attributes are
	columns named '@name', and child elements that hold only text and appear at most once in
	a row are columns named after the element. A child element that repeats, or has
	attributes or children of its own, becomes a row of a child table ('runs_tag' for 'tag'
	elements under rows of table 'runs'), joined back through '_parent_id' = '_id'. An element
	with no element children keeps its text in a '_text' column. Text is trimmed, entities are
	decoded, and columns are typed as CSV columns are. Rows inside rows are not searched for.
	A name ending in '.gz' is decompressed first.

```
catalog := Catalog->New();
catalog->Load(XmlSource->New("books.xml", "book"));
rs := catalog->Query("select title, @lang from books where year > 2000");
```
	~#
	class XmlSource implements Source {
		@path : String;
		@name : String;
		@row_element : String;
		@text : String;
		@error : String;
		@tables : Vector<Table>;

		#~
		Constructor; the table is named after the file
		@param path XML file
		@param row_element name of the elements that are rows
		~#
		New(path : String, row_element : String) {
			@path := path;
			@name := SourceText->BaseName(path, "xml");
			@row_element := row_element;
		}

		#~
		Constructor
		@param path XML file
		@param name table name
		@param row_element name of the elements that are rows
		~#
		New(path : String, name : String, row_element : String) {
			@path := path;
			@name := name;
			@row_element := row_element;
		}

		#~
		Makes a source over XML text already in memory
		@param name table name
		@param text XML text
		@param row_element name of the elements that are rows
		@return source
		~#
		function : FromText(name : String, text : String, row_element : String) ~ XmlSource {
			source := XmlSource->New(Nil, name, row_element);
			source->SetText(text);
			return source;
		}

		method : public : SetText(text : String) ~ Nil {
			@text := text;
		}

		#~
		Gets the tables the document provides, the main table first; they are known only after
		reading it
		@return table shapes
		~#
		method : public : GetTables() ~ TableSpec[] {
			Read();
			return TableShapes->Of(@tables, @name);
		}

		#~
		Loads the document's tables into a catalog
		@param catalog catalog
		@param hint columns and rows of the main table needed, Nil for everything
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			if(Read(hint) = Nil) {
				return false;
			};

			each(i : @tables) {
				catalog->Add(@tables->Get(i));
			};
			return true;
		}

		#~
		Reads the document's main table; GetChildTables then has the others
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			none : ScanHint;
			return Read(none);
		}

		#~
		Reads the document's main table; GetChildTables then has the others
		@param hint columns and rows of the main table needed, Nil for everything
		@return table, Nil on error (see GetError)
		~#
		method : public : Read(hint : ScanHint) ~ Table {
			@error := Nil;
			@tables := Nil;
			if(@row_element = Nil | @row_element->Size() = 0) {
				@error := "no row element named";
				return Nil;
			};

			text := @text;
			if(text = Nil) {
				reason := StringHolder->New();
				text := SourceText->Read(@path, reason);
				if(text = Nil) {
					@error := reason->Get();
					return Nil;
				};
			};

			parser := XmlParser->New(text);
			if(<>parser->Parse()) {
				@error := "'{$@name}' is not well-formed XML";
				reason := parser->GetError();
				if(reason <> Nil) {
					@error += ": ";
					@error += reason;
				};
				return Nil;
			};

			limit := hint <> Nil ? hint->GetLimit() : -1;
			builder := XmlTableBuilder->New(@name, false);
			Collect(parser->GetRoot(), builder, limit);

			@tables := Vector->New()<Table>;
			builder->Build(hint, @tables);
			return @tables->Get(0);
		}

		# the row elements under 'element', in document order, without searching inside a row
		method : Collect(element : XmlElement, builder : XmlTableBuilder, limit : Int) ~ Nil {
			if(element = Nil | (limit > -1 & builder->Size() >= limit)) {
				return;
			};

			if(XmlTableBuilder->IsElement(element) & element->GetName()->Equals(@row_element)) {
				builder->Add(element, 0);
				return;
			};

			children := element->GetChildren();
			if(children <> Nil) {
				each(i : children) {
					Collect(children->Get(i), builder, limit);
				};
			};
		}

		#~
		Gets the child tables the last Read made, depth first in the order their elements were
		first seen
		@return child tables, empty if there are none
		~#
		method : public : GetChildTables() ~ Vector<Table> {
			children := Vector->New()<Table>;
			if(@tables <> Nil) {
				for(i := 1; i < @tables->Size(); i += 1;) {
					children->AddBack(@tables->Get(i));
				};
			};

			return children;
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}
	}

	#~
	A zip or tar archive as tables, without extracting it: a listing of its members as a tree
	(like FilesystemSource's), and each member in a format the library reads as a table of its
	own, named by the member's path ('data/runs.csv'; in SQL, "data/runs.csv" in double
	quotes). Members are read by extension: '.csv', '.tsv', '.jsonl' and '.ndjson', '.json',
	'.otab', and '.xml' once SetRowElement names the row element, each also with '.gz'. Other
	members, '.txt' included, are listed only; ReadBytes and ReadText read any of them.

	The archive is a '.zip' (stored and deflate members, ZIP64, a self-extracting prefix), a
	'.tar' (POSIX ustar, pax and GNU long names) or a gzipped tar ('.tar.gz', '.tgz'), told
	apart by content rather than name, from a file, an https:// URL or bytes in memory.

	Untrusted archives are safe to read. Nothing is written to disk. A member whose path is
	absolute or climbs out with '..' is refused, as are duplicate names in a zip and members
	whose data overlap. Each zip member is inflated to at most the size its header states and
	checked against its CRC32, so a zip bomb or a damaged member is an error naming it, never
	wrong data. Reading stops at 256 MB for one member and 1 GB for the whole archive unless
	SetLimits says otherwise. Encrypted members, compression other than deflate, and archives
	split across disks are reported as unsupported. Links are listed but never followed.

	The listing table is named after the archive ('results' for 'results.zip'), with columns
	id, parent_id (empty at the top), depth (0 at the top), name, path, ext, is_dir, type
	('file', 'dir', 'symlink', 'hardlink' or 'other'), size, compressed_size and method (zip
	only; method is 'stored', 'deflate' or the name of another), crc32 (zip only), modified
	and link (a link's target). Folders that the archive implies but does not list get rows
	too, so every member has a parent. A tar member repeated later in the archive replaces
	the earlier one's table, as extracting would.

```
catalog := Catalog->New();
if(catalog->Load(ArchiveSource->New("results.zip"))) {
  rs := catalog->Query("select path, size from results where ext = 'csv' order by size desc");
  runs := catalog->Query("select name, avg(score) from \"2026/runs.csv\" group by name");
};
```
	~#
	class ArchiveSource implements Source {
		@path : String;
		@image : Byte[];
		@title : String;
		@name : String;
		@pattern : String;
		@row_element : String;
		@member_limit : Int;
		@total_limit : Int;
		@error : String;

		#~
		Constructor; the listing table is named after the archive
		@param path archive file or URL ('.zip', '.tar', '.tar.gz' or '.tgz')
		~#
		New(path : String) {
			@path := path;
			@title := path;
			@name := SourceText->BaseName(path, "archive");
			@pattern := "*";
			@member_limit := 256 * 1024 * 1024;
			@total_limit := 1024 * 1024 * 1024;
		}

		#~
		Makes a source over an archive already in memory
		@param name the listing table's name
		@param bytes archive bytes
		@return source
		~#
		function : FromBytes(name : String, bytes : Byte[]) ~ ArchiveSource {
			source := ArchiveSource->New(Nil);
			source->SetBytes(name, bytes);
			return source;
		}

		method : public : SetBytes(name : String, bytes : Byte[]) ~ Nil {
			@image := bytes;
			@title := name;
			@name := name;
		}

		#~
		Sets the listing table's name
		@param name table name
		~#
		method : public : SetName(name : String) ~ Nil {
			@name := name;
		}

		#~
		Sets which members become tables: a pattern over member paths, where '*' matches any
		run of characters (slashes included) and '?' any one. All readable members by default.
		@param pattern pattern, such as 'runs/*.csv'
		~#
		method : public : SetPattern(pattern : String) ~ Nil {
			@pattern := pattern <> Nil ? pattern : "*";
		}

		#~
		Names the element that is a row in XML members; without it XML members are listed only
		@param row_element element name
		~#
		method : public : SetRowElement(row_element : String) ~ Nil {
			@row_element := row_element;
		}

		#~
		Sets how much may be decompressed: a member larger than 'member_bytes' is refused, and
		so is a read that would take the archive's total past 'total_bytes'. The defaults are
		256 MB and 1 GB.
		@param member_bytes most bytes one member may hold uncompressed
		@param total_bytes most bytes all members read together may hold uncompressed
		~#
		method : public : SetLimits(member_bytes : Int, total_bytes : Int) ~ Nil {
			@member_limit := member_bytes;
			@total_limit := total_bytes;
		}

		#~
		Gets the listing's column names
		@return column names
		~#
		function : ColumnNames() ~ String[] {
			return ["id", "parent_id", "depth", "name", "path", "ext", "is_dir", "type", "size", "compressed_size", "method", "crc32", "modified", "link"];
		}

		function : ColumnTypes() ~ ColumnType[] {
			types := ColumnType->New[14];
			types[0] := ColumnType->INT;
			types[1] := ColumnType->INT;
			types[2] := ColumnType->INT;
			types[3] := ColumnType->STRING;
			types[4] := ColumnType->STRING;
			types[5] := ColumnType->STRING;
			types[6] := ColumnType->BOOL;
			types[7] := ColumnType->STRING;
			types[8] := ColumnType->INT;
			types[9] := ColumnType->INT;
			types[10] := ColumnType->STRING;
			types[11] := ColumnType->INT;
			types[12] := ColumnType->DATE;
			types[13] := ColumnType->STRING;
			return types;
		}

		#~
		Gets the tables the archive provides, the listing first; the members' columns are
		known only after reading them
		@return table shapes
		~#
		method : public : GetTables() ~ TableSpec[] {
			return TableShapes->Of(ReadAll(), @name);
		}

		#~
		Loads the listing and every member readable as a table into a catalog. Nothing is
		added unless every member reads. The scan hint is not pushed into members.
		@param catalog catalog
		@param hint ignored; the engine applies the query afterwards
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			tables := ReadAll();
			if(tables = Nil) {
				return false;
			};

			each(i : tables) {
				catalog->Add(tables->Get(i));
			};
			return true;
		}

		#~
		Lists the archive's members as a table
		@return listing, Nil if the archive cannot be read (see GetError)
		~#
		method : public : List() ~ Table {
			@error := Nil;
			reader := Open();
			if(reader = Nil) {
				return Nil;
			};

			return Listing(reader);
		}

		#~
		Gets the paths of the archive's files, in archive order
		@return member paths, Nil if the archive cannot be read (see GetError)
		~#
		method : public : GetMembers() ~ String[] {
			@error := Nil;
			reader := Open();
			if(reader = Nil) {
				return Nil;
			};

			files := Vector->New()<String>;
			entries := reader->GetEntries();
			each(i : entries) {
				entry := entries->Get(i);
				if(entry->GetType()->Equals("file")) {
					files->AddBack(entry->GetPath());
				};
			};

			paths := String->New[files->Size()];
			each(i : paths) {
				paths[i] := files->Get(i);
			};
			return paths;
		}

		#~
		Reads one member's bytes, checked against its CRC32 and limits
		@param member member path, as the listing gives it
		@return bytes, Nil if missing or unreadable (see GetError)
		~#
		method : public : ReadBytes(member : String) ~ Byte[] {
			@error := Nil;
			reader := Open();
			if(reader = Nil) {
				return Nil;
			};

			entry := reader->Find(member);
			if(entry = Nil) {
				@error := "'{$@title}' has no member '{$member}'";
				return Nil;
			};

			error := StringHolder->New();
			bytes := reader->Read(entry, error);
			if(bytes = Nil) {
				@error := error->Get();
			};
			return bytes;
		}

		#~
		Reads one member as UTF-8 text
		@param member member path, as the listing gives it
		@return text, Nil if missing or unreadable (see GetError)
		~#
		method : public : ReadText(member : String) ~ String {
			bytes := ReadBytes(member);
			if(bytes = Nil) {
				return Nil;
			};

			return bytes->ToString();
		}

		#~
		Reads one member as a table, by its extension, whether or not it matches the pattern
		@param member member path, as the listing gives it
		@return the member's table (a JSON or XML member's child tables are left out), Nil if
		it cannot be read as one (see GetError)
		~#
		method : public : ReadTable(member : String) ~ Table {
			@error := Nil;
			reader := Open();
			if(reader = Nil) {
				return Nil;
			};

			entry := reader->Find(member);
			if(entry = Nil) {
				@error := "'{$@title}' has no member '{$member}'";
				return Nil;
			};

			if(FormatOf(member)->Size() = 0 | (FormatOf(member)->Equals("xml") & @row_element = Nil)) {
				@error := "'{$@title}': member '{$member}' is not in a format read as a table";
				return Nil;
			};

			error := StringHolder->New();
			tables := ReadMember(reader, entry, "", '\0', true, @row_element, error);
			if(tables = Nil) {
				@error := error->Get();
				return Nil;
			};

			return tables->Get(0);
		}

		# One member as a table, read as a query names it (FileTables): in 'format' ("" for its
		# extension), with a delimiter ('\0' for the format's) and header for delimited text and
		# a row element for XML, under 'name'. Nil with GetError set.
		method : public : ReadMemberAs(member : String, format : String, delimiter : Char, header : Bool,
				row : String, name : String) ~ Table {
			@error := Nil;
			reader := Open();
			if(reader = Nil) {
				return Nil;
			};

			entry := reader->Find(member);
			if(entry = Nil | <>entry->GetType()->Equals("file")) {
				@error := "'{$@title}' has no member '{$member}'";
				return Nil;
			};

			chosen := format->Size() > 0 ? format : FormatOf(member);
			if(chosen->Size() = 0) {
				@error := "'{$@title}': member '{$member}' is not in a format read as a table; name it with csv(), tsv(), json(), jsonl() or xml()";
				return Nil;
			};

			element := row <> Nil ? row : @row_element;
			if(chosen->Equals("xml") & element = Nil) {
				@error := "'{$@title}': XML member '{$member}' needs its row element, as xml('archive'.'{$member}', row => 'item')";
				return Nil;
			};

			error := StringHolder->New();
			tables := ReadMember(reader, entry, chosen, delimiter, header, element, error);
			if(tables = Nil) {
				@error := error->Get();
				return Nil;
			};

			return Renamed(tables->Get(0), name);
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		# the listing, then every matching readable member's tables; Nil with @error set
		method : ReadAll() ~ Vector<Table> {
			@error := Nil;
			reader := Open();
			if(reader = Nil) {
				return Nil;
			};

			tables := Vector->New()<Table>;
			tables->AddBack(Listing(reader));

			# a tar may hold a path more than once; the last copy is the one extracting keeps
			entries := reader->GetEntries();
			last := Map->New()<String, IntRef>;
			each(i : entries) {
				entry := entries->Get(i);
				if(entry->GetType()->Equals("file")) {
					if(last->Has(entry->GetPath())) {
						last->Remove(entry->GetPath());
					};
					last->Insert(entry->GetPath(), IntRef->New(i));
				};
			};

			error := StringHolder->New();
			each(i : entries) {
				entry := entries->Get(i);
				path := entry->GetPath();
				if(entry->GetType()->Equals("file") & last->Find(path)->Get() = i & IsTable(path)) {
					member_tables := ReadMember(reader, entry, "", '\0', true, @row_element, error);
					if(member_tables = Nil) {
						@error := error->Get();
						return Nil;
					};

					each(t : member_tables) {
						tables->AddBack(member_tables->Get(t));
					};
				};
			};

			return tables;
		}

		# whether a member becomes a table: a known format, matching the pattern
		method : IsTable(path : String) ~ Bool {
			format := FormatOf(path);
			if(format->Size() = 0 | (format->Equals("xml") & @row_element = Nil)) {
				return false;
			};

			return FileTables->GlobMatches(@pattern, 0, path, 0);
		}

		# the archive opened and its directory read; Nil with @error set
		method : Open() ~ ArchiveReader {
			error := StringHolder->New();
			path := @path;
			if(@image = Nil) {
				if(path = Nil) {
					@error := "no archive and no bytes";
					return Nil;
				};

				if(UrlCache->IsUrl(path)) {
					fetched := UrlCache->Fetch(path, error);
					if(fetched = Nil) {
						@error := error->Get();
						return Nil;
					};
					path := fetched->GetPath();
				};
			};

			reader := ArchiveReader->Open(@title, path, @image, @member_limit, @total_limit, error);
			if(reader = Nil) {
				@error := error->Get();
			};
			return reader;
		}

		# a member's tables: its own, then any child tables a JSON or XML member makes. 'format'
		# is "" for the member's extension; 'delimiter' '\0' for the format's.
		method : ReadMember(reader : ArchiveReader, entry : ArchiveEntry, format : String, delimiter : Char, header : Bool,
				row_element : String, error : StringHolder) ~ Vector<Table> {
			bytes := reader->Read(entry, error);
			if(bytes = Nil) {
				return Nil;
			};

			path := entry->GetPath();
			where := "'{$@title}', member '{$path}'";
			if(path->ToLower()->EndsWith(".gz")) {
				packed := bytes;
				bytes := Nil;
				try {
					bytes := Byte->UncompressGzip(packed, reader->GetRemaining());
				}
				on(e : Error) {
					error->Set("{$where} is not valid gzip data, or is truncated");
					return Nil;
				};

				if(bytes = Nil) {
					error->Set("{$where} inflates past the archive's limit of {$@total_limit} bytes");
					return Nil;
				};
				reader->Count(bytes->Size());
			};

			tables := Vector->New()<Table>;
			if(format->Size() = 0) {
				format := FormatOf(path);
			};
			if(format->Equals("otab")) {
				file := OtabFile->New(bytes);
				table := file->Read();
				if(table = Nil) {
					error->Set("{$where}: {$(file->GetError())}");
					return Nil;
				};
				tables->AddBack(Renamed(table, path));
				return tables;
			};

			text := bytes->ToString();
			table : Table;
			reason : String;
			if(format->Equals("csv") | format->Equals("tsv")) {
				if(delimiter = '\0') {
					delimiter := format->Equals("tsv") ? '\t' : ',';
				};
				csv := CsvSource->FromText(path, text, delimiter);
				csv->SetHeader(header);
				table := csv->Read(Nil);
				reason := csv->GetError();
				if(table <> Nil) {
					tables->AddBack(table);
				};
			}
			else if(format->Equals("jsonl")) {
				lines := JsonLinesSource->FromText(path, text);
				table := lines->Read();
				reason := lines->GetError();
				if(table <> Nil) {
					tables->AddBack(table);
					AddAll(tables, lines->GetChildTables());
				};
			}
			else if(format->Equals("json")) {
				json := JsonSource->FromText(path, text);
				table := json->Read();
				reason := json->GetError();
				if(table <> Nil) {
					tables->AddBack(table);
					AddAll(tables, json->GetChildTables());
				};
			}
			else if(format->Equals("xml")) {
				xml := XmlSource->FromText(path, text, row_element);
				table := xml->Read();
				reason := xml->GetError();
				if(table <> Nil) {
					tables->AddBack(table);
					AddAll(tables, xml->GetChildTables());
				};
			};

			if(table = Nil) {
				error->Set(reason <> Nil ? "{$where}: {$reason}" : "{$where} cannot be read as a table");
				return Nil;
			};

			return tables;
		}

		function : AddAll(tables : Vector<Table>, more : Vector<Table>) ~ Nil {
			each(i : more) {
				tables->AddBack(more->Get(i));
			};
		}

		# a table under another name, sharing its columns
		function : Renamed(table : Table, name : String) ~ Table {
			names := table->GetColumnNames();
			data_names := String->New[names->Size() - 1];
			parts := Column->New[names->Size()];
			each(c : names) {
				parts[c] := table->GetColumn(c);
				if(c > 0) {
					data_names[c - 1] := names[c];
				};
			};

			return Table->Restore(name, data_names, parts, table->GetNextKey());
		}

		# the table format a member's extension names, after any '.gz'; empty for none
		function : FormatOf(path : String) ~ String {
			lower := path->ToLower();
			if(lower->EndsWith(".gz")) {
				lower := lower->SubString(0, lower->Size() - 3);
			};

			if(lower->EndsWith(".csv")) {
				return "csv";
			}
			else if(lower->EndsWith(".tsv")) {
				return "tsv";
			}
			else if(lower->EndsWith(".jsonl") | lower->EndsWith(".ndjson")) {
				return "jsonl";
			}
			else if(lower->EndsWith(".json")) {
				return "json";
			}
			else if(lower->EndsWith(".xml")) {
				return "xml";
			}
			else if(lower->EndsWith(".otab")) {
				return "otab";
			};

			return "";
		}

		# the members as a tree: implied folders get rows, and each row names its parent
		method : Listing(reader : ArchiveReader) ~ Table {
			table := Table->New(@name, ColumnNames(), ColumnTypes());
			folders := Map->New()<String, IntRef>;
			entries := reader->GetEntries();
			row : Row := Nil;
			each(i : entries) {
				entry := entries->Get(i);
				path := entry->GetPath();
				is_dir := entry->GetType()->Equals("dir");
				parent := AddFolders(table, folders, path);
				known := folders->Find(path);
				if(is_dir & known <> Nil) {
					# a folder listed after a member inside it already gave it a row
					row := table->Get(known->Get());
				}
				else {
					row := table->Insert();
					row->Set("id", IntRef->New(row->GetKey()));
					if(parent > -1) {
						row->Set("parent_id", IntRef->New(parent));
					};
					row->Set("depth", IntRef->New(Depth(path)));
					row->Set("name", LastPart(path));
					row->Set("path", path);
					row->Set("ext", FilesystemSource->Extension(LastPart(path), is_dir));
					row->Set("is_dir", BoolRef->New(is_dir));
					if(is_dir) {
						folders->Insert(path, IntRef->New(row->GetKey()));
					};
				};

				row->Set("type", entry->GetType());
				row->Set("size", IntRef->New(entry->GetSize()));
				if(entry->GetPacked() > -1) {
					row->Set("compressed_size", IntRef->New(entry->GetPacked()));
				};
				if(entry->GetMethod() > -1) {
					row->Set("method", ArchiveReader->MethodName(entry->GetMethod()));
				};
				if(entry->GetCrc() > -1) {
					row->Set("crc32", IntRef->New(entry->GetCrc()));
				};
				if(entry->GetModified() <> Nil) {
					row->Set("modified", entry->GetModified());
				};
				if(entry->GetLink() <> Nil & entry->GetLink()->Size() > 0) {
					row->Set("link", entry->GetLink());
				};
			};

			return table;
		}

		# rows for the folders above a path that have none yet; the parent's id, -1 at the top
		function : AddFolders(table : Table, folders : Map<String, IntRef>, path : String) ~ Int {
			parent := -1;
			depth := 0;
			each(i : path) {
				if(path->Get(i) = '/') {
					folder := path->SubString(0, i);
					known := folders->Find(folder);
					if(known = Nil) {
						row := table->Insert();
						id := row->GetKey();
						row->Set("id", IntRef->New(id));
						if(parent > -1) {
							row->Set("parent_id", IntRef->New(parent));
						};
						row->Set("depth", IntRef->New(depth));
						row->Set("name", LastPart(folder));
						row->Set("path", folder);
						row->Set("is_dir", BoolRef->New(true));
						row->Set("type", "dir");
						folders->Insert(folder, IntRef->New(id));
						parent := id;
					}
					else {
						parent := known->Get();
					};
					depth += 1;
				};
			};

			return parent;
		}

		function : Depth(path : String) ~ Int {
			depth := 0;
			each(i : path) {
				if(path->Get(i) = '/') {
					depth += 1;
				};
			};
			return depth;
		}

		function : LastPart(path : String) ~ String {
			slash := path->FindLast('/');
			if(slash < 0) {
				return path;
			};

			return path->SubString(slash + 1, path->Size() - slash - 1);
		}
	}

	# one member of an archive, as a zip's central directory or a tar header describes it
	class : private : ArchiveEntry {
		@raw_name : String;
		@path : String;
		@type : String;
		@size : Int;
		@packed : Int;
		@codec : Int;
		@flags : Int;
		@crc : Int;
		@modified : Date;
		@offset : Int;
		@link : String;

		New(raw_name : String, path : String, type : String, size : Int, offset : Int) {
			@raw_name := raw_name;
			@path := path;
			@type := type;
			@size := size;
			@offset := offset;
			@packed := -1;
			@codec := -1;
			@crc := -1;
		}

		method : public : SetZip(packed : Int, codec : Int, flags : Int, crc : Int) ~ Nil {
			@packed := packed;
			@codec := codec;
			@flags := flags;
			@crc := crc;
		}

		method : public : SetModified(modified : Date) ~ Nil { @modified := modified; }
		method : public : SetLink(link : String) ~ Nil { @link := link; }
		method : public : GetRawName() ~ String { return @raw_name; }
		method : public : GetPath() ~ String { return @path; }
		method : public : GetType() ~ String { return @type; }
		method : public : GetSize() ~ Int { return @size; }
		method : public : GetPacked() ~ Int { return @packed; }
		method : public : GetMethod() ~ Int { return @codec; }
		method : public : GetFlags() ~ Int { return @flags; }
		method : public : GetCrc() ~ Int { return @crc; }
		method : public : GetModified() ~ Date { return @modified; }
		method : public : GetOffset() ~ Int { return @offset; }
		method : public : GetLink() ~ String { return @link; }
	}

	# reads a zip, tar or gzipped tar: its directory when opened, then members on request,
	# each checked and within the limits. A file is read in pieces; bytes are read in place.
	class : private : ArchiveReader {
		@title : String;
		@path : String;
		@image : Byte[];
		@file_size : Int;
		@is_zip : Bool;
		@data_end : Int;
		@entries : Vector<ArchiveEntry>;
		@member_limit : Int;
		@total_limit : Int;
		@total_read : Int;

		New(title : String, path : String, image : Byte[], member_limit : Int, total_limit : Int) {
			@title := title;
			@path := path;
			@image := image;
			@member_limit := member_limit;
			@total_limit := total_limit;
		}

		# the archive with its directory read, Nil with 'error' set
		function : Open(title : String, path : String, image : Byte[], member_limit : Int, total_limit : Int, error : StringHolder) ~ ArchiveReader {
			reader := ArchiveReader->New(title, path, image, member_limit, total_limit);
			if(reader->Scan(error)) {
				return reader;
			};

			return Nil;
		}

		method : public : GetEntries() ~ Vector<ArchiveEntry> {
			return @entries;
		}

		# the last entry with a path, Nil if there is none
		method : public : Find(path : String) ~ ArchiveEntry {
			found : ArchiveEntry := Nil;
			if(path <> Nil) {
				each(i : @entries) {
					entry := @entries->Get(i);
					if(entry->GetPath()->Equals(path)) {
						found := entry;
					};
				};
			};

			return found;
		}

		# how many more bytes reads may produce
		method : public : GetRemaining() ~ Int {
			remaining := @total_limit - @total_read;
			return remaining > 0 ? remaining : 0;
		}

		method : public : Count(bytes : Int) ~ Nil {
			@total_read += bytes;
		}

		method : Scan(error : StringHolder) ~ Bool {
			raw : Byte[] := Nil;
			if(@image = Nil) {
				if(@path = Nil | <>File->Exists(@path)) {
					error->Set("no file '{$@title}'");
					return false;
				};
				@file_size := File->Size(@path);
			}
			else {
				@file_size := @image->Size();
			};

			head := Bytes(0, @file_size < 512 ? @file_size : 512);
			if(head = Nil) {
				error->Set("cannot read '{$@title}'");
				return false;
			};

			# a gzipped tar is inflated whole, within the archive's total limit
			if(head->Size() >= 2 & head[0] = 0x1f & head[1] = 0x8b) {
				packed := Bytes(0, @file_size);
				if(packed = Nil) {
					error->Set("cannot read '{$@title}'");
					return false;
				};

				try {
					raw := Byte->UncompressGzip(packed, @total_limit);
				}
				on(e : Error) {
					error->Set("'{$@title}' is not valid gzip data, or is truncated");
					return false;
				};

				if(raw = Nil) {
					error->Set("'{$@title}' inflates past the limit of {$@total_limit} bytes (SetLimits raises it)");
					return false;
				};

				@image := raw;
				@path := Nil;
				@file_size := raw->Size();
				head := Bytes(0, @file_size < 512 ? @file_size : 512);
				if(<>IsTarHeader(head)) {
					error->Set("'{$@title}' is gzipped, but what it holds is not a tar archive");
					return false;
				};
				return ScanTar(error);
			};

			if(IsTarHeader(head)) {
				return ScanTar(error);
			};

			if(head->Size() = 512 & IsUstar(head)) {
				error->Set("'{$@title}': the tar header at byte 0 is damaged (its checksum does not match)");
				return false;
			};

			return ScanZip(error);
		}

		# 'count' bytes from 'offset', Nil past the end or when the file cannot be read
		method : Bytes(offset : Int, count : Int) ~ Byte[] {
			if(offset < 0 | count < 0 | offset + count > @file_size) {
				return Nil;
			};

			part := Byte->New[count];
			if(count = 0) {
				return part;
			};

			if(@image <> Nil) {
				Byte->Copy(part, 0, @image, offset, count);
				return part;
			};

			reader := FileReader->New(@path);
			if(<>reader->IsOpen()) {
				return Nil;
			};

			reader->Seek(offset);
			done := reader->ReadBuffer(0, count, part);
			reader->Close();
			if(done <> count) {
				return Nil;
			};

			return part;
		}

		function : U16(b : Byte[], at : Int) ~ Int {
			return b[at]->As(Int) + (b[at + 1]->As(Int) << 8);
		}

		function : U32(b : Byte[], at : Int) ~ Int {
			return U16(b, at) + (U16(b, at + 2) << 16);
		}

		function : U64(b : Byte[], at : Int) ~ Int {
			return U32(b, at) + (U32(b, at + 4) << 32);
		}

		function : MethodName(codec : Int) ~ String {
			select(codec) {
				label 0: { return "stored"; }
				label 8: { return "deflate"; }
				label 9: { return "deflate64"; }
				label 12: { return "bzip2"; }
				label 14: { return "lzma"; }
				label 93: { return "zstd"; }
				label 95: { return "xz"; }
				label 98: { return "ppmd"; }
				label 99: { return "aes"; }
			};

			return "method {$codec}";
		}

		# a member's path with '\' as '/', no '.' or empty parts and no trailing '/'; "" for
		# the archive's own folder ('./'); Nil, with 'error' set, for an absolute path or one
		# that climbs out of the archive
		method : Normalize(raw : String, error : StringHolder) ~ String {
			if(raw = Nil | raw->Size() = 0) {
				error->Set("'{$@title}' has a member with no name");
				return Nil;
			};

			text := "";
			each(i : raw) {
				c := raw->Get(i);
				if(c = '\0') {
					error->Set("'{$@title}' has a member whose name holds a NUL character; refused");
					return Nil;
				};
				text->Append(c = '\\' ? '/' : c);
			};

			if(text->StartsWith('/') | (text->Size() > 1 & text->Get(1) = ':' & text->Get(0)->IsChar())) {
				error->Set("'{$@title}': member '{$raw}' has an absolute path; refused");
				return Nil;
			};

			path := "";
			start := 0;
			for(i := 0; i <= text->Size(); i += 1;) {
				if(i = text->Size() | text->Get(i) = '/') {
					part := text->SubString(start, i - start);
					if(part->Equals("..")) {
						error->Set("'{$@title}': member '{$raw}' climbs out of the archive with '..'; refused");
						return Nil;
					};

					if(part->Size() > 0 & <>part->Equals(".")) {
						if(path->Size() > 0) {
							path->Append('/');
						};
						path += part;
					};
					start := i + 1;
				};
			};

			return path;
		}

		#
		# zip
		#

		method : ScanZip(error : StringHolder) ~ Bool {
			@is_zip := true;
			not_archive := "'{$@title}' is not a zip, tar or gzipped tar archive";
			if(@file_size < 22) {
				error->Set(not_archive);
				return false;
			};

			# the end record is the last 22 bytes, before a comment of up to 64K
			tail_size := @file_size < 22 + 65535 ? @file_size : 22 + 65535;
			tail_start := @file_size - tail_size;
			tail := Bytes(tail_start, tail_size);
			if(tail = Nil) {
				error->Set("cannot read '{$@title}'");
				return false;
			};

			at := -1;
			for(i := tail_size - 22; i >= 0 & at < 0; i -= 1;) {
				if(tail[i] = 0x50 & tail[i + 1] = 0x4b & tail[i + 2] = 0x05 & tail[i + 3] = 0x06) {
					if(i + 22 + U16(tail, i + 20) <= tail_size) {
						at := i;
					};
				};
			};

			if(at < 0) {
				error->Set(not_archive);
				return false;
			};

			disk := U16(tail, at + 4);
			cd_disk := U16(tail, at + 6);
			count := U16(tail, at + 10);
			cd_size := U32(tail, at + 12);
			cd_offset := U32(tail, at + 16);
			end := tail_start + at;

			# ZIP64: a locator just before the end record points at a 64-bit end record
			locator : Byte[] := Nil;
			if(end >= 20) {
				locator := Bytes(end - 20, 20);
			};
			if(locator <> Nil & U32(locator, 0) = 0x07064b50) {
				record_at := U64(locator, 8);
				zip64_end := Bytes(record_at, 56);
				if(zip64_end = Nil | U32(zip64_end, 0) <> 0x06064b50) {
					error->Set("'{$@title}': its ZIP64 end record is missing or damaged");
					return false;
				};

				disk := U32(zip64_end, 16);
				cd_disk := U32(zip64_end, 20);
				count := U64(zip64_end, 32);
				cd_size := U64(zip64_end, 40);
				cd_offset := U64(zip64_end, 48);
				end := record_at;
			}
			else if(cd_size = 0xFFFFFFFF | cd_offset = 0xFFFFFFFF) {
				error->Set("'{$@title}' needs ZIP64 but has no ZIP64 end record; it is damaged");
				return false;
			};

			if(disk <> 0 | cd_disk <> 0) {
				error->Set("'{$@title}' is split across several disks, which is not supported");
				return false;
			};

			# offsets count from the archive's start, which a self-extracting prefix moves
			base := end - cd_size - cd_offset;
			if(cd_size < 0 | cd_offset < 0 | base < 0) {
				error->Set("'{$@title}': its central directory is out of place; the archive is damaged or truncated");
				return false;
			};

			if(count < 0 | count * 46 > cd_size) {
				error->Set("'{$@title}' claims {$count} members in a central directory of {$cd_size} bytes; it is damaged");
				return false;
			};

			cd := Bytes(base + cd_offset, cd_size);
			if(cd = Nil) {
				error->Set("'{$@title}': its central directory cannot be read; the archive is truncated");
				return false;
			};

			@data_end := base + cd_offset;
			@entries := Vector->New()<ArchiveEntry>;
			seen := Map->New()<String, IntRef>;
			spans := Map->New()<IntRef, IntRef>;
			pos := 0;
			for(n := 0; n < count; n += 1;) {
				if(pos + 46 > cd_size) {
					error->Set("'{$@title}': its central directory is damaged at member {$(n + 1)}");
					return false;
				};
				if(U32(cd, pos) <> 0x02014b50) {
					error->Set("'{$@title}': its central directory is damaged at member {$(n + 1)}");
					return false;
				};

				made := U16(cd, pos + 4);
				flags := U16(cd, pos + 8);
				codec := U16(cd, pos + 10);
				modified := DosDate(U16(cd, pos + 14), U16(cd, pos + 12));
				crc := U32(cd, pos + 16);
				packed := U32(cd, pos + 20);
				size := U32(cd, pos + 24);
				name_size := U16(cd, pos + 28);
				extra_size := U16(cd, pos + 30);
				comment_size := U16(cd, pos + 32);
				attributes := U32(cd, pos + 38);
				offset := U32(cd, pos + 42);
				next := pos + 46 + name_size + extra_size + comment_size;
				if(next > cd_size) {
					error->Set("'{$@title}': its central directory is damaged at member {$(n + 1)}");
					return false;
				};

				name_bytes := Byte->New[name_size];
				Byte->Copy(name_bytes, 0, cd, pos + 46, name_size);
				raw := name_bytes->ToString();

				# extra fields: ZIP64 sizes and offset, and a UTC modification time
				e := pos + 46 + name_size;
				e_end := e + extra_size;
				while(e + 4 <= e_end) {
					id := U16(cd, e);
					length := U16(cd, e + 2);
					f := e + 4;
					f_end := f + length;
					if(f_end <= e_end) {
						if(id = 0x0001) {
							if(size = 0xFFFFFFFF & f + 8 <= f_end) {
								size := U64(cd, f);
								f += 8;
							};
							if(packed = 0xFFFFFFFF & f + 8 <= f_end) {
								packed := U64(cd, f);
								f += 8;
							};
							if(offset = 0xFFFFFFFF & f + 8 <= f_end) {
								offset := U64(cd, f);
							};
						}
						else if(id = 0x5455 & length >= 5) {
							if((cd[f]->As(Int) and 1) = 1) {
								seconds := U32(cd, f + 1);
								if(seconds >= 0x80000000) {
									seconds -= 0x100000000;
								};
								modified := DateCodec->ToDate(seconds * 1000, true);
							};
						};
					};
					e := f_end;
				};

				if(size = 0xFFFFFFFF | packed = 0xFFFFFFFF | offset = 0xFFFFFFFF | size < 0 | packed < 0) {
					error->Set("'{$@title}': member '{$raw}' needs ZIP64 sizes it does not have; the archive is damaged");
					return false;
				};

				path := Normalize(raw, error);
				if(path = Nil) {
					return false;
				};

				type := "file";
				host := made >> 8;
				if(raw->EndsWith('/') | raw->EndsWith('\\') | (host = 0 & (attributes and 0x10) <> 0)) {
					type := "dir";
				}
				else if(host = 3 & ((attributes >> 16) and 0xF000) = 0xA000) {
					type := "symlink";
				};

				if(path->Size() = 0) {
					if(<>type->Equals("dir")) {
						error->Set("'{$@title}' has a member with no name");
						return false;
					};
				}
				else {
					if(seen->Has(path)) {
						error->Set("'{$@title}': member '{$path}' appears twice; a zip with duplicate names is ambiguous, so it is refused");
						return false;
					};
					seen->Insert(path, IntRef->New(n));

					# the least room a member takes: its local header, name and data
					start := base + offset;
					span_end := start + 30 + name_size + packed;
					if(span_end > @data_end) {
						error->Set("'{$@title}': member '{$path}' runs past the central directory; the archive is damaged or truncated");
						return false;
					};
					if(spans->Has(IntRef->New(start))) {
						error->Set("'{$@title}': members overlap at byte {$start}; refused");
						return false;
					};
					spans->Insert(IntRef->New(start), IntRef->New(span_end));

					entry := ArchiveEntry->New(raw, path, type, size, start);
					entry->SetZip(packed, codec, flags, crc);
					entry->SetModified(modified);
					@entries->AddBack(entry);
				};

				pos := next;
			};

			# members' data must not overlap, or a few bytes could be read as many members
			starts := spans->GetKeys();
			previous_end := 0;
			each(i : starts) {
				start := starts->Get(i);
				if(start->Get() < previous_end) {
					error->Set("'{$@title}': members overlap at byte {$(start->Get())}; refused");
					return false;
				};
				previous_end := spans->Find(start)->Get();
			};

			return true;
		}

		# an MS-DOS date and time (local time, two-second steps), Nil if not a real one
		function : DosDate(date : Int, time : Int) ~ Date {
			day := date and 0x1F;
			month := (date >> 5) and 0xF;
			year := (date >> 9) + 1980;
			hours := time >> 11;
			mins := (time >> 5) and 0x3F;
			secs := (time and 0x1F) * 2;
			if(day < 1 | month < 1 | month > 12 | hours > 23 | mins > 59 | secs > 59) {
				return Nil;
			};

			return Date->New(day, month, year, hours, mins, secs, false);
		}

		# a member's contents: within the limits, inflated to no more than its stated size,
		# and matching its CRC32; Nil with 'error' set
		method : public : Read(entry : ArchiveEntry, error : StringHolder) ~ Byte[] {
			where := "'{$@title}', member '{$(entry->GetPath())}'";
			type := entry->GetType();
			if(type->Equals("dir")) {
				error->Set("{$where} is a folder");
				return Nil;
			};

			if(type->Equals("symlink") | type->Equals("hardlink")) {
				error->Set("{$where} is a link; links are not followed");
				return Nil;
			};

			if(<>type->Equals("file")) {
				error->Set("{$where} is not a regular file");
				return Nil;
			};

			size := entry->GetSize();
			if(size > @member_limit) {
				error->Set("{$where} is {$size} bytes uncompressed, over the limit of {$@member_limit} (SetLimits raises it)");
				return Nil;
			};

			if(@total_read + size > @total_limit) {
				error->Set("{$where}: reading it would take the archive past its limit of {$@total_limit} bytes uncompressed (SetLimits raises it)");
				return Nil;
			};

			if(<>@is_zip) {
				bytes := Bytes(entry->GetOffset(), size);
				if(bytes = Nil) {
					error->Set("{$where} cannot be read");
					return Nil;
				};
				@total_read += size;
				return bytes;
			};

			if((entry->GetFlags() and 1) <> 0) {
				error->Set("{$where} is encrypted; encrypted members are not supported");
				return Nil;
			};

			codec := entry->GetMethod();
			if(codec <> 0 & codec <> 8) {
				error->Set("{$where} is compressed with {$(MethodName(codec))}, which is not supported (only stored and deflate are)");
				return Nil;
			};

			offset := entry->GetOffset();
			local := Bytes(offset, 30);
			if(local = Nil) {
				error->Set("{$where}: its local header is missing; the archive is truncated");
				return Nil;
			};
			if(U32(local, 0) <> 0x04034b50) {
				error->Set("{$where}: its local header is missing or damaged");
				return Nil;
			};

			name_size := U16(local, 26);
			extra_size := U16(local, 28);
			local_name := Bytes(offset + 30, name_size);
			if(local_name = Nil | <>local_name->ToString()->Equals(entry->GetRawName())) {
				error->Set("{$where}: its local header names a different member; the archive is damaged or crafted");
				return Nil;
			};

			start := offset + 30 + name_size + extra_size;
			packed := entry->GetPacked();
			if(start + packed > @data_end) {
				error->Set("{$where}: its data runs into the central directory; the archive is damaged");
				return Nil;
			};

			data := Bytes(start, packed);
			if(data = Nil) {
				error->Set("{$where} cannot be read");
				return Nil;
			};

			raw : Byte[];
			if(codec = 0) {
				if(packed <> size) {
					error->Set("{$where} is stored, but its stored size ({$packed}) is not its size ({$size})");
					return Nil;
				};
				raw := data;
			}
			else {
				try {
					raw := Byte->UncompressDeflate(data, size);
				}
				on(e : Error) {
					error->Set("{$where}: its deflate data is damaged or truncated");
					return Nil;
				};

				if(raw = Nil) {
					error->Set("{$where} expands past the {$size} bytes its header states (a zip bomb, or a damaged header); refused");
					return Nil;
				};

				if(raw->Size() <> size) {
					error->Set("{$where} inflates to {$(raw->Size())} bytes, not the {$size} its header states");
					return Nil;
				};
			};

			if(Byte->CRC32(raw) <> entry->GetCrc()) {
				error->Set("{$where} fails its CRC32 check; the data is damaged");
				return Nil;
			};

			@total_read += size;
			return raw;
		}

		#
		# tar
		#

		# a tar header block: its checksum holds, or it is the zero block of an empty archive
		function : IsTarHeader(head : Byte[]) ~ Bool {
			if(head = Nil | head->Size() < 512) {
				return false;
			};

			return IsZero(head) | ChecksumHolds(head);
		}

		# the ustar magic ('ustar' and a NUL, or GNU's 'ustar' and a space)
		function : IsUstar(header : Byte[]) ~ Bool {
			return header[257] = 0x75 & header[258] = 0x73 & header[259] = 0x74 & header[260] = 0x61 & header[261] = 0x72 & (header[262] = 0 | header[262] = 0x20);
		}

		function : IsZero(block : Byte[]) ~ Bool {
			each(i : block) {
				if(block[i] <> 0) {
					return false;
				};
			};
			return true;
		}

		# the header's sum with its checksum field read as spaces, unsigned or (as old tars
		# wrote it) signed
		function : ChecksumHolds(header : Byte[]) ~ Bool {
			stored := TarNumber(header, 148, 8);
			if(stored < 0) {
				return false;
			};

			unsigned := 0;
			signed := 0;
			for(i := 0; i < 512; i += 1;) {
				value := (i >= 148 & i < 156) ? 32 : header[i]->As(Int);
				unsigned += value;
				signed += value > 127 ? value - 256 : value;
			};

			return stored = unsigned | stored = signed;
		}

		# an octal number field (NUL or space ended), or base-256 when its top bit is set;
		# -1 if malformed
		function : TarNumber(header : Byte[], at : Int, size : Int) ~ Int {
			first := header[at]->As(Int);
			if((first and 0x80) <> 0) {
				if((first and 0x40) <> 0) {
					return -1;
				};

				value := first and 0x3F;
				for(i := 1; i < size; i += 1;) {
					value := (value << 8) + header[at + i]->As(Int);
				};
				return value;
			};

			value := 0;
			digits := 0;
			done := false;
			for(i := 0; i < size & <>done; i += 1;) {
				c := header[at + i]->As(Int);
				if(c >= 0x30 & c <= 0x37) {
					value := value * 8 + (c - 0x30);
					digits += 1;
				}
				else if(c = 0 | c = 0x20) {
					if(digits > 0) {
						done := true;
					};
				}
				else {
					return -1;
				};
			};

			return value;
		}

		# NUL-ended text in a field
		function : FieldText(bytes : Byte[], at : Int, size : Int) ~ String {
			length := 0;
			while(length < size & bytes[at + length] <> 0) {
				length += 1;
			};

			part := Byte->New[length];
			Byte->Copy(part, 0, bytes, at, length);
			return part->ToString();
		}

		method : ScanTar(error : StringHolder) ~ Bool {
			@is_zip := false;
			@entries := Vector->New()<ArchiveEntry>;
			long_name : String := Nil;
			long_link : String := Nil;
			pax : Map<String, String> := Nil;
			pos := 0;
			done := false;
			while(<>done) {
				if(pos + 512 > @file_size) {
					# an archive cut at a block boundary has lost only its end marker
					if(pos <> @file_size) {
						error->Set("'{$@title}' ends inside a header; it is truncated");
						return false;
					};
					done := true;
				}
				else {
					header := Bytes(pos, 512);
					if(header = Nil) {
						error->Set("cannot read '{$@title}'");
						return false;
					};

					if(IsZero(header)) {
						done := true;
					}
					else {
						if(<>ChecksumHolds(header)) {
							error->Set("'{$@title}': the tar header at byte {$pos} is damaged (its checksum does not match)");
							return false;
						};

						type := header[156]->As(Int);
						size := TarNumber(header, 124, 12);
						if(size < 0) {
							error->Set("'{$@title}': the tar header at byte {$pos} has a malformed size");
							return false;
						};

						data := pos + 512;
						if(type = 0x78 | type = 0x67) {
							# pax extended headers: 'x' for the next member, 'g' for all after
							if(size > 1024 * 1024 | data + size > @file_size) {
								error->Set("'{$@title}': the extended header at byte {$pos} is too large or truncated");
								return false;
							};

							records := PaxRecords(Bytes(data, size));
							if(records = Nil) {
								error->Set("'{$@title}': the extended header at byte {$pos} is malformed");
								return false;
							};
							if(type = 0x78) {
								pax := records;
							};
						}
						else if(type = 0x4c | type = 0x4b) {
							# GNU long name ('L') or long link target ('K') for the next member
							if(size > 64 * 1024 | data + size > @file_size) {
								error->Set("'{$@title}': the long name at byte {$pos} is too large or truncated");
								return false;
							};

							text := FieldText(Bytes(data, size), 0, size);
							if(type = 0x4c) {
								long_name := text;
							}
							else {
								long_link := text;
							};
						}
						else {
							raw := FieldText(header, 0, 100);
							if(header[257] = 0x75 & header[258] = 0x73 & header[259] = 0x74 & header[260] = 0x61 & header[261] = 0x72 & header[262] = 0) {
								prefix := FieldText(header, 345, 155);
								if(prefix->Size() > 0) {
									raw := "{$prefix}/{$raw}";
								};
							};
							link := FieldText(header, 157, 100);
							mtime := TarNumber(header, 136, 12);
							if(long_name <> Nil) {
								raw := long_name;
							};
							if(long_link <> Nil) {
								link := long_link;
							};
							if(pax <> Nil) {
								value := pax->Find("path");
								if(value <> Nil) {
									raw := value;
								};
								value := pax->Find("linkpath");
								if(value <> Nil) {
									link := value;
								};
								value := pax->Find("size");
								if(value <> Nil) {
									size := Cell->NumberKind(value) = 1 ? value->ToInt() : -1;
								};
								value := pax->Find("mtime");
								if(value <> Nil) {
									dot := value->Find('.');
									whole := dot < 0 ? value : value->SubString(0, dot);
									mtime := Cell->NumberKind(whole) = 1 ? whole->ToInt() : -1;
								};
							};

							if(size < 0) {
								error->Set("'{$@title}': member '{$raw}' has a malformed size");
								return false;
							};

							kind := "other";
							if(type = 0x35) {
								kind := "dir";
							}
							else if(type = 0x32) {
								kind := "symlink";
							}
							else if(type = 0x31) {
								kind := "hardlink";
							}
							else if(type = 0x30 | type = 0 | type = 0x37) {
								kind := raw->EndsWith('/') ? "dir" : "file";
							};

							# links and folders hold no data whatever the size says
							if(<>kind->Equals("file") & <>kind->Equals("other")) {
								size := 0;
							};

							path := Normalize(raw, error);
							if(path = Nil) {
								return false;
							};

							if(data + size > @file_size) {
								error->Set("'{$@title}': member '{$path}' runs past the end of the archive; it is truncated");
								return false;
							};

							if(path->Size() = 0) {
								if(<>kind->Equals("dir")) {
									error->Set("'{$@title}' has a member with no name");
									return false;
								};
							}
							else {
								entry := ArchiveEntry->New(raw, path, kind, size, data);
								if(mtime > -1) {
									entry->SetModified(DateCodec->ToDate(mtime * 1000, true));
								};
								entry->SetLink(link);
								@entries->AddBack(entry);
							};

							long_name := Nil;
							long_link := Nil;
							pax := Nil;
						};

						pos := data + ((size + 511) / 512) * 512;
					};
				};
			};

			@data_end := @file_size;
			return true;
		}

		# pax records, each 'LENGTH key=value\n' with LENGTH counting the whole record;
		# Nil if malformed
		function : PaxRecords(bytes : Byte[]) ~ Map<String, String> {
			if(bytes = Nil) {
				return Nil;
			};

			records := Map->New()<String, String>;
			pos := 0;
			while(pos < bytes->Size()) {
				length := 0;
				digits := 0;
				while(pos + digits < bytes->Size() & bytes[pos + digits] >= 0x30 & bytes[pos + digits] <= 0x39) {
					length := length * 10 + (bytes[pos + digits]->As(Int) - 0x30);
					digits += 1;
				};

				if(digits = 0 | length <= digits + 1 | pos + length > bytes->Size() | bytes[pos + digits] <> 0x20 | bytes[pos + length - 1] <> 0x0a) {
					return Nil;
				};

				text := Byte->New[length - digits - 2];
				Byte->Copy(text, 0, bytes, pos + digits + 1, text->Size());
				pax_text := text->ToString();
				equals := pax_text->Find('=');
				if(equals < 1) {
					return Nil;
				};

				key := pax_text->SubString(0, equals);
				if(records->Has(key)) {
					records->Remove(key);
				};
				records->Insert(key, pax_text->SubString(equals + 1, pax_text->Size() - equals - 1));
				pos += length;
			};

			return records;
		}
	}

	#~
	An Excel workbook (.xlsx) as tables, one per worksheet, named after the sheet. Cells keep
	their types: numbers, text (shared or inline, rich text joined, whitespace kept), booleans,
	dates, and error values (as their text, such as '#DIV/0!'). A formula cell is its last
	calculated value. A column is typed by reading all of it, as CsvSource types CSV columns:
	whole numbers make an INT column, other numbers a FLOAT column, dates a DATE column,
	booleans a BOOL column, and any mix, or text, a STRING column holding each cell as it
	would display ('1.5', 'TRUE', '2026-03-15'). An empty cell is empty.

	Dates are numbers in a date or time format, built in or custom ('yyyy-mm-dd', 'h:mm'),
	counted from 1900 or, when the workbook says so, 1904. In the 1900 system Excel counts a 29
	February 1900 that never was (Lotus 1-2-3's leap-year bug): serials below 60 are moved a day
	so they read as Excel shows them, and 60 itself reads as 28 February 1900. Elapsed-time
	formats ('[h]:mm') stay numbers, in days. Times are wall-clock, read to the second.

	The table is the sheet's used range: its columns run from the first used column to the
	last, and its rows from the first row holding a value (the header, by default) to the last.
	Rows and cells a sheet leaves out are empty, so the table's rows line up with the sheet's.
	Header cells name the columns; an empty one takes its column letter ('C'), and a repeated
	name gets '_2', '_3'. Without a header the columns are named by letter.

	A merged range keeps its value in its top-left cell and leaves the rest empty, as Excel
	stores it; SetFillMerged copies the value into every cell of the range instead.

	The workbook is read with ArchiveSource's zip reader, so the same limits and checks apply:
	every part is checked against its CRC32 and inflated no further than it says, within 256 MB
	a part and 1 GB in all unless SetLimits says otherwise.

```
catalog := Catalog->New();
if(catalog->Load(XlsxSource->New("budget.xlsx"))) {
  rs := catalog->Query("select dept, sum(amount) as total from \"Q1 2026\" group by dept");
};
```
	~#
	class XlsxSource implements Source {
		@path : String;
		@image : Byte[];
		@title : String;
		@sheet : String;
		@prefix : String;
		@no_header : Bool;
		@first_row : Int;
		@fill_merged : Bool;
		@member_limit : Int;
		@total_limit : Int;
		@error : String;

		#~
		Constructor; every worksheet becomes a table
		@param path workbook file or URL
		~#
		New(path : String) {
			@path := path;
			@title := path;
			@prefix := "";
			@member_limit := 256 * 1024 * 1024;
			@total_limit := 1024 * 1024 * 1024;
		}

		#~
		Constructor for one worksheet
		@param path workbook file or URL
		@param sheet worksheet name
		~#
		New(path : String, sheet : String) {
			@path := path;
			@title := path;
			@sheet := sheet;
			@prefix := "";
			@member_limit := 256 * 1024 * 1024;
			@total_limit := 1024 * 1024 * 1024;
		}

		#~
		Makes a source over a workbook already in memory
		@param bytes .xlsx bytes
		@return source
		~#
		function : FromBytes(bytes : Byte[]) ~ XlsxSource {
			source := XlsxSource->New(Nil->As(String));
			source->SetBytes(bytes);
			return source;
		}

		method : public : SetBytes(bytes : Byte[]) ~ Nil {
			@image := bytes;
			@title := "workbook";
		}

		#~
		Sets whether the first row names the columns (the default). Without a header every row
		is data and the columns are named by letter: A, B, C ...
		@param header true if the first row is a header
		~#
		method : public : SetHeader(header : Bool) ~ Nil {
			@no_header := <>header;
		}

		#~
		Sets the sheet row the table starts at (the header, if there is one), for sheets with
		a title or notes above the data. By default the table starts at the first row holding
		a value.
		@param row sheet row number, from 1; 0 for the default
		~#
		method : public : SetFirstRow(row : Int) ~ Nil {
			@first_row := row;
		}

		#~
		Sets whether a merged range's value fills every cell of the range, rather than only its
		top-left cell (the default, which is how Excel stores it)
		@param fill true to fill merged ranges
		~#
		method : public : SetFillMerged(fill : Bool) ~ Nil {
			@fill_merged := fill;
		}

		#~
		Sets a prefix for the table names, so two workbooks' 'Sheet1' can share a catalog
		@param prefix prefix, such as 'budget.'
		~#
		method : public : SetPrefix(prefix : String) ~ Nil {
			@prefix := prefix <> Nil ? prefix : "";
		}

		#~
		Sets how much may be decompressed: a part of the workbook larger than 'member_bytes' is
		refused, and so is a read that takes the total past 'total_bytes'. The defaults are 256
		MB and 1 GB.
		@param member_bytes most bytes one part may hold uncompressed
		@param total_bytes most bytes all parts read may hold uncompressed
		~#
		method : public : SetLimits(member_bytes : Int, total_bytes : Int) ~ Nil {
			@member_limit := member_bytes;
			@total_limit := total_bytes;
		}

		#~
		Gets the workbook's worksheet names, in workbook order
		@return sheet names, Nil if the workbook cannot be read (see GetError)
		~#
		method : public : GetSheets() ~ String[] {
			@error := Nil;
			workbook := Open();
			if(workbook = Nil) {
				return Nil;
			};

			names := workbook->GetSheetNames();
			sheets := String->New[names->Size()];
			each(i : sheets) {
				sheets[i] := names->Get(i);
			};
			return sheets;
		}

		#~
		Gets the tables the workbook provides; their columns are known only after reading them
		@return table shapes
		~#
		method : public : GetTables() ~ TableSpec[] {
			return TableShapes->Of(ReadAll(), @prefix);
		}

		#~
		Loads the worksheets into a catalog; nothing is added unless every sheet reads. The scan
		hint is not used.
		@param catalog catalog
		@param hint ignored; the engine applies the query afterwards
		@return true if loaded
		~#
		method : public : Load(catalog : Catalog, hint : ScanHint) ~ Bool {
			tables := ReadAll();
			if(tables = Nil) {
				return false;
			};

			each(i : tables) {
				catalog->Add(tables->Get(i));
			};
			return true;
		}

		#~
		Reads one worksheet: the one named in the constructor, or else the first
		@return table, Nil on error (see GetError)
		~#
		method : public : Read() ~ Table {
			tables := ReadAll();
			if(tables = Nil | tables->Size() = 0) {
				return Nil;
			};

			return tables->Get(0);
		}

		#~
		Reads every worksheet, or the one named in the constructor
		@return tables in workbook order, Nil on error (see GetError)
		~#
		method : public : ReadAll() ~ Vector<Table> {
			@error := Nil;
			workbook := Open();
			if(workbook = Nil) {
				return Nil;
			};

			names := workbook->GetSheetNames();
			tables := Vector->New()<Table>;
			error := StringHolder->New();
			each(i : names) {
				name := names->Get(i);
				if(@sheet = Nil | @sheet->Equals(name)) {
					table := workbook->ReadSheet(i, @prefix + name, <>@no_header, @first_row, @fill_merged, error);
					if(table = Nil) {
						@error := error->Get();
						return Nil;
					};
					tables->AddBack(table);
				};
			};

			if(@sheet <> Nil & tables->Size() = 0) {
				@error := "'{$@title}' has no worksheet '{$@sheet}'";
				return Nil;
			};

			return tables;
		}

		#~
		Gets the reason the last read failed
		@return error, Nil if none
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		method : Open() ~ XlsxWorkbook {
			error := StringHolder->New();
			path := @path;
			if(@image = Nil) {
				if(path = Nil) {
					@error := "no workbook and no bytes";
					return Nil;
				};

				if(UrlCache->IsUrl(path)) {
					fetched := UrlCache->Fetch(path, error);
					if(fetched = Nil) {
						@error := error->Get();
						return Nil;
					};
					path := fetched->GetPath();
				};
			};

			reader := ArchiveReader->Open(@title, path, @image, @member_limit, @total_limit, error);
			if(reader = Nil) {
				@error := error->Get();
				return Nil;
			};

			workbook := XlsxWorkbook->Open(@title, reader, error);
			if(workbook = Nil) {
				@error := error->Get();
			};
			return workbook;
		}
	}

	# one cell of a worksheet as read: where it is, its kind and its text
	class : private : XlsxCell {
		@row : Int;
		@column : Int;
		@kind : Int;
		@text : String;
		@date : Date;

		New(row : Int, column : Int, kind : Int, text : String, date : Date) {
			@row := row;
			@column := column;
			@kind := kind;
			@text := text;
			@date := date;
		}

		method : public : GetRow() ~ Int { return @row; }
		method : public : GetColumn() ~ Int { return @column; }
		method : public : GetKind() ~ Int { return @kind; }
		method : public : GetText() ~ String { return @text; }
		method : public : GetDate() ~ Date { return @date; }

		method : public : At(row : Int, column : Int) ~ XlsxCell {
			return XlsxCell->New(row, column, @kind, @text, @date);
		}
	}

	# a workbook's parts: sheet names and where they are, shared strings, which styles are
	# dates, and its date system
	class : private : XlsxWorkbook {
		@title : String;
		@reader : ArchiveReader;
		@names : Vector<String>;
		@parts : Vector<String>;
		@strings : Vector<String>;
		@date_styles : Vector<BoolRef>;
		@date1904 : Bool;

		# cell kinds
		function : KindText() ~ Int { return 0; }
		function : KindNumber() ~ Int { return 1; }
		function : KindBool() ~ Int { return 2; }
		function : KindDate() ~ Int { return 3; }
		function : KindError() ~ Int { return 4; }

		New(title : String, reader : ArchiveReader) {
			@title := title;
			@reader := reader;
			@names := Vector->New()<String>;
			@parts := Vector->New()<String>;
			@strings := Vector->New()<String>;
			@date_styles := Vector->New()<BoolRef>;
		}

		function : Open(title : String, reader : ArchiveReader, error : StringHolder) ~ XlsxWorkbook {
			workbook := XlsxWorkbook->New(title, reader);
			if(workbook->ReadParts(error)) {
				return workbook;
			};

			return Nil;
		}

		method : public : GetSheetNames() ~ Vector<String> {
			return @names;
		}

		# a part's XML, parsed; Nil with 'error' set. A missing optional part is Nil with no error.
		method : Part(path : String, required : Bool, error : StringHolder) ~ XmlElement {
			entry := @reader->Find(path);
			if(entry = Nil) {
				if(required) {
					error->Set("'{$@title}' is not an .xlsx workbook: it has no part '{$path}'");
				};
				return Nil;
			};

			bytes := @reader->Read(entry, error);
			if(bytes = Nil) {
				return Nil;
			};

			parser := XmlParser->New(bytes->ToString());
			if(<>parser->Parse()) {
				reason := parser->GetError();
				error->Set("'{$@title}': part '{$path}' is not well-formed XML" + (reason <> Nil ? ": {$reason}" : ""));
				return Nil;
			};

			return parser->GetRoot();
		}

		# the relationships of a part: Id to [Type, resolved Target]
		method : Relations(rels_path : String, base : String, error : StringHolder) ~ Map<String, Vector<String>> {
			relations := Map->New()<String, Vector<String>>;
			root := Part(rels_path, false, error);
			if(root = Nil) {
				return relations;
			};

			children := XmlTableBuilder->Elements(root);
			each(i : children) {
				child := children->Get(i);
				if(child->GetName()->Equals("Relationship")) {
					id := Attribute(child, "Id");
					type := Attribute(child, "Type");
					target := Attribute(child, "Target");
					mode := Attribute(child, "TargetMode");
					if(id <> Nil & target <> Nil & (mode = Nil | <>mode->Equals("External"))) {
						pair := Vector->New()<String>;
						pair->AddBack(type <> Nil ? type : "");
						pair->AddBack(Resolve(base, target));
						relations->Insert(id, pair);
					};
				};
			};

			return relations;
		}

		# a relationship target as a path from the package root: '/x' is absolute, and
		# anything else is relative to 'base', a folder ('' or 'xl/')
		function : Resolve(base : String, target : String) ~ String {
			path := String->New(base);
			path += target;
			if(target->StartsWith('/')) {
				path := target->SubString(1, target->Size() - 1);
			};
			parts := Vector->New()<String>;
			start := 0;
			for(i := 0; i <= path->Size(); i += 1;) {
				if(i = path->Size() | path->Get(i) = '/') {
					part := path->SubString(start, i - start);
					if(part->Equals("..")) {
						if(parts->Size() > 0) {
							parts->RemoveBack();
						};
					}
					else if(part->Size() > 0 & <>part->Equals(".")) {
						parts->AddBack(part);
					};
					start := i + 1;
				};
			};

			out := "";
			each(i : parts) {
				if(i > 0) {
					out += "/";
				};
				out += parts->Get(i);
			};
			return out;
		}

		function : Attribute(element : XmlElement, name : String) ~ String {
			attribute := element->GetAttribute(name);
			if(attribute = Nil) {
				return Nil;
			};

			return attribute->GetDecodedValue();
		}

		function : Child(element : XmlElement, name : String) ~ XmlElement {
			children := XmlTableBuilder->Elements(element);
			each(i : children) {
				if(children->Get(i)->GetName()->Equals(name)) {
					return children->Get(i);
				};
			};

			return Nil;
		}

		# the text of a string item: its <t>, or its runs' <t> joined; phonetic runs are skipped
		function : ItemText(item : XmlElement) ~ String {
			text := "";
			children := XmlTableBuilder->Elements(item);
			each(i : children) {
				child := children->Get(i);
				name := child->GetName();
				if(name->Equals("t")) {
					text += Text(child);
				}
				else if(name->Equals("r")) {
					t := Child(child, "t");
					if(t <> Nil) {
						text += Text(t);
					};
				};
			};

			return text;
		}

		# an element's text, whitespace kept, with any CDATA sections
		function : Text(element : XmlElement) ~ String {
			text := element->GetDecodedText();
			children := element->GetChildren();
			each(i : children) {
				child := children->Get(i);
				if(child->GetType() = XmlElement->Type->CDATA) {
					text += child->GetContent();
				};
			};

			return text;
		}

		method : ReadParts(error : StringHolder) ~ Bool {
			# the workbook part, from the package relationships
			workbook_path := "xl/workbook.xml";
			package := Relations("_rels/.rels", "", error);
			if(error->Get() <> Nil) {
				return false;
			};
			keys := package->GetKeys();
			each(i : keys) {
				pair := package->Find(keys->Get(i));
				if(pair->Get(0)->EndsWith("/officeDocument")) {
					workbook_path := pair->Get(1);
				};
			};

			root := Part(workbook_path, true, error);
			if(root = Nil) {
				return false;
			};

			slash := workbook_path->FindLast('/');
			base := slash < 0 ? "" : workbook_path->SubString(0, slash + 1);
			cut := workbook_path->Size() - slash - 1;
			rels_path := base + "_rels/" + workbook_path->SubString(slash + 1, cut) + ".rels";
			relations := Relations(rels_path, base, error);
			if(error->Get() <> Nil) {
				return false;
			};

			properties := Child(root, "workbookPr");
			if(properties <> Nil) {
				system := Attribute(properties, "date1904");
				@date1904 := system <> Nil & (system->Equals("1") | system->Equals("true"));
			};

			# worksheets, in workbook order; chart sheets and the like are left out
			sheets := Child(root, "sheets");
			if(sheets <> Nil) {
				children := XmlTableBuilder->Elements(sheets);
				each(i : children) {
					sheet := children->Get(i);
					name := Attribute(sheet, "name");
					id := Attribute(sheet, "id");
					if(name <> Nil & id <> Nil) {
						pair := relations->Find(id);
						if(pair = Nil) {
							error->Set("'{$@title}': sheet '{$name}' names a part the workbook does not list");
							return false;
						};
						if(pair->Get(0)->EndsWith("/worksheet")) {
							@names->AddBack(name);
							@parts->AddBack(pair->Get(1));
						};
					};
				};
			};

			strings_path := base + "sharedStrings.xml";
			styles_path := base + "styles.xml";
			keys := relations->GetKeys();
			each(i : keys) {
				pair := relations->Find(keys->Get(i));
				if(pair->Get(0)->EndsWith("/sharedStrings")) {
					strings_path := pair->Get(1);
				}
				else if(pair->Get(0)->EndsWith("/styles")) {
					styles_path := pair->Get(1);
				};
			};

			strings := Part(strings_path, false, error);
			if(error->Get() <> Nil) {
				return false;
			};
			if(strings <> Nil) {
				items := XmlTableBuilder->Elements(strings);
				each(i : items) {
					if(items->Get(i)->GetName()->Equals("si")) {
						@strings->AddBack(ItemText(items->Get(i)));
					};
				};
			};

			styles := Part(styles_path, false, error);
			if(error->Get() <> Nil) {
				return false;
			};
			if(styles <> Nil) {
				ReadStyles(styles);
			};

			return true;
		}

		# which cell formats (the 's' index of a cell) show a date or time
		method : ReadStyles(styles : XmlElement) ~ Nil {
			custom := Map->New()<IntRef, BoolRef>;
			formats := Child(styles, "numFmts");
			if(formats <> Nil) {
				children := XmlTableBuilder->Elements(formats);
				each(i : children) {
					format := children->Get(i);
					id := Attribute(format, "numFmtId");
					code := Attribute(format, "formatCode");
					if(id <> Nil & code <> Nil & Cell->NumberKind(id) = 1) {
						custom->Insert(IntRef->New(id->ToInt()), BoolRef->New(IsDateCode(code)));
					};
				};
			};

			cell_formats := Child(styles, "cellXfs");
			if(cell_formats <> Nil) {
				children := XmlTableBuilder->Elements(cell_formats);
				each(i : children) {
					xf := children->Get(i);
					if(xf->GetName()->Equals("xf")) {
						id_text := Attribute(xf, "numFmtId");
						id := id_text <> Nil & Cell->NumberKind(id_text) = 1 ? id_text->ToInt() : 0;
						is_date := false;
						known := custom->Find(IntRef->New(id));
						if(known <> Nil) {
							is_date := known->Get();
						}
						else {
							is_date := IsDateFormat(id);
						};
						@date_styles->AddBack(BoolRef->New(is_date));
					};
				};
			};
		}

		# Excel's built-in date and time formats (46, '[h]:mm:ss', is elapsed time)
		function : IsDateFormat(id : Int) ~ Bool {
			return (id >= 14 & id <= 22) | (id >= 27 & id <= 36) | id = 45 | id = 47 | (id >= 50 & id <= 58);
		}

		# whether a custom format code shows a date or time: a d, m, y, h or s outside quotes,
		# escapes and brackets; an elapsed-time bracket ('[h]') makes it a number
		function : IsDateCode(code : String) ~ Bool {
			i := 0;
			size := code->Size();
			while(i < size) {
				c := code->Get(i);
				if(c = '"') {
					i += 1;
					while(i < size & code->Get(i) <> '"') {
						i += 1;
					};
				}
				else if(c = '\\' | c = '_' | c = '*') {
					i += 1;
				}
				else if(c = '[') {
					close := i + 1;
					while(close < size & code->Get(close) <> ']') {
						close += 1;
					};
					inside := code->SubString(i + 1, close - i - 1)->ToLower();
					if(inside->Size() > 0 & (inside->Get(0) = 'h' | inside->Get(0) = 'm' | inside->Get(0) = 's')) {
						return false;
					};
					i := close;
				}
				else if(c = ';') {
					# only the first section, for positive numbers, decides
					return false;
				}
				else {
					lower := c->ToLower();
					if(lower = 'd' | lower = 'm' | lower = 'y' | lower = 'h' | lower = 's') {
						return true;
					};
				};
				i += 1;
			};

			return false;
		}

		# a cell reference's column ('C7' is 3) and row (7); Nil if malformed
		function : ParseReference(reference : String) ~ Int[] {
			column := 0;
			i := 0;
			while(i < reference->Size() & reference->Get(i)->ToUpper() >= 'A' & reference->Get(i)->ToUpper() <= 'Z') {
				column := column * 26 + (reference->Get(i)->ToUpper()->As(Int) - 'A'->As(Int) + 1);
				i += 1;
			};

			row := 0;
			digits := 0;
			while(i < reference->Size() & reference->Get(i)->IsDigit()) {
				row := row * 10 + (reference->Get(i)->As(Int) - '0'->As(Int));
				digits += 1;
				i += 1;
				if(row > 1048576) {
					return Nil;
				};
			};

			if(i <> reference->Size() | column < 1 | column > 16384 | (digits > 0 & row < 1)) {
				return Nil;
			};

			position := Int->New[2];
			position[0] := column;
			position[1] := digits > 0 ? row : 0;
			return position;
		}

		# a column's letters: 1 is A, 27 is AA
		function : Letters(column : Int) ~ String {
			letters := "";
			while(column > 0) {
				column -= 1;
				letters := "{$(('A'->As(Int) + column % 26)->As(Char))}{$letters}";
				column := column / 26;
			};
			return letters;
		}

		# an Excel serial date as a date, in the 1900 or 1904 system, to the second
		function : SerialToDate(serial : Float, date1904 : Bool) ~ Date {
			days := Float->Floor(serial)->As(Int);
			seconds := Float->Floor((serial - days) * 86400.0 + 0.5)->As(Int);
			if(seconds >= 86400) {
				days += 1;
				seconds -= 86400;
			};

			base := 0;
			if(date1904) {
				base := DateCodec->DaysFromCivil(1904, 1, 1);
			}
			else {
				base := DateCodec->DaysFromCivil(1899, 12, 30);
				# serials before 1 March 1900 are a day behind Excel's phantom 29 February
				if(days >= 0 & days < 60) {
					days += 1;
				};
			};

			return DateCodec->ToDate(((base + days) * 86400 + seconds) * 1000, false);
		}

		# an ISO 8601 date as a 'd' cell holds it ('2026-03-15', '2026-03-15T10:20:30'); Nil if
		# it is not one
		function : IsoDate(text : String) ~ Date {
			if(text->Size() < 10 | text->Get(4) <> '-' | text->Get(7) <> '-') {
				return Nil;
			};

			year := text->SubString(0, 4);
			month := text->SubString(5, 2);
			day := text->SubString(8, 2);
			if(Cell->NumberKind(year) <> 1 | Cell->NumberKind(month) <> 1 | Cell->NumberKind(day) <> 1) {
				return Nil;
			};

			hours := 0;
			mins := 0;
			secs := 0;
			if(text->Size() >= 19 & text->Get(10) = 'T' & text->Get(13) = ':' & text->Get(16) = ':') {
				hours := text->SubString(11, 2)->ToInt();
				mins := text->SubString(14, 2)->ToInt();
				secs := text->SubString(17, 2)->ToInt();
			};

			days := DateCodec->DaysFromCivil(year->ToInt(), month->ToInt(), day->ToInt());
			return DateCodec->ToDate(((days * 24 + hours) * 60 + mins) * 60 * 1000 + secs * 1000, false);
		}

		# a date as a STRING column shows it
		function : DateText(date : Date) ~ String {
			text := "{$(date->GetYear())}-{$(Two(date->GetMonth()))}-{$(Two(date->GetDay()))}";
			if(date->GetHours() <> 0 | date->GetMinutes() <> 0 | date->GetSeconds() <> 0) {
				text += " {$(Two(date->GetHours()))}:{$(Two(date->GetMinutes()))}:{$(Two(date->GetSeconds()))}";
			};
			return text;
		}

		function : Two(value : Int) ~ String {
			return value < 10 ? "0{$value}" : "{$value}";
		}

		# one worksheet as a table; Nil with 'error' set
		method : public : ReadSheet(index : Int, name : String, header : Bool, first_row : Int, fill_merged : Bool, error : StringHolder) ~ Table {
			sheet_name := @names->Get(index);
			where := "'{$@title}', sheet '{$sheet_name}'";
			root := Part(@parts->Get(index), true, error);
			if(root = Nil) {
				return Nil;
			};

			cells := Vector->New()<XlsxCell>;
			data := Child(root, "sheetData");
			if(data <> Nil) {
				rows := XmlTableBuilder->Elements(data);
				row_number := 0;
				each(r : rows) {
					row := rows->Get(r);
					if(row->GetName()->Equals("row")) {
						number := Attribute(row, "r");
						if(number <> Nil) {
							if(Cell->NumberKind(number) <> 1 | number->ToInt() < 1 | number->ToInt() > 1048576) {
								error->Set("{$where}: row number '{$number}' is not one");
								return Nil;
							};
							row_number := number->ToInt();
						}
						else {
							row_number += 1;
						};

						column := 0;
						row_cells := XmlTableBuilder->Elements(row);
						each(c : row_cells) {
							element := row_cells->Get(c);
							if(element->GetName()->Equals("c")) {
								reference := Attribute(element, "r");
								if(reference <> Nil) {
									position := ParseReference(reference);
									if(position = Nil | (position[1] > 0 & position[1] <> row_number)) {
										error->Set("{$where}: cell reference '{$reference}' is not a cell of row {$row_number}");
										return Nil;
									};
									column := position[0];
								}
								else {
									column += 1;
									if(column > 16384) {
										error->Set("{$where}: row {$row_number} has more than 16,384 cells");
										return Nil;
									};
								};

								cell := ReadCell(element, row_number, column, where, error);
								if(error->Get() <> Nil) {
									return Nil;
								};
								if(cell <> Nil) {
									cells->AddBack(cell);
								};
							};
						};
					};
				};
			};

			if(fill_merged) {
				merged := Child(root, "mergeCells");
				if(merged <> Nil) {
					cells := FillMerged(cells, XmlTableBuilder->Elements(merged), where, error);
					if(cells = Nil) {
						return Nil;
					};
				};
			};

			return Build(name, cells, header, first_row, where, error);
		}

		# a cell's kind and value; Nil for a cell with no value
		method : ReadCell(element : XmlElement, row : Int, column : Int, where : String, error : StringHolder) ~ XlsxCell {
			type := Attribute(element, "t");
			if(type = Nil) {
				type := "n";
			};

			if(type->Equals("inlineStr")) {
				inline := Child(element, "is");
				if(inline = Nil) {
					return Nil;
				};
				return XlsxCell->New(row, column, KindText(), ItemText(inline), Nil);
			};

			value_element := Child(element, "v");
			if(value_element = Nil) {
				return Nil;
			};
			# a formula not yet calculated may carry an empty value
			value := Text(value_element);
			if(value->Size() = 0) {
				return Nil;
			};
			reference := "{$(Letters(column))}{$row}";

			if(type->Equals("s")) {
				if(Cell->NumberKind(value->Trim()) <> 1 | value->Trim()->ToInt() < 0 | value->Trim()->ToInt() >= @strings->Size()) {
					error->Set("{$where}, cell {$reference}: shared string '{$value}' does not exist");
					return Nil;
				};
				return XlsxCell->New(row, column, KindText(), @strings->Get(value->Trim()->ToInt()), Nil);
			}
			else if(type->Equals("str")) {
				return XlsxCell->New(row, column, KindText(), value, Nil);
			}
			else if(type->Equals("b")) {
				flag := value->Trim();
				if(<>flag->Equals("0") & <>flag->Equals("1")) {
					error->Set("{$where}, cell {$reference}: '{$value}' is not a boolean");
					return Nil;
				};
				return XlsxCell->New(row, column, KindBool(), flag, Nil);
			}
			else if(type->Equals("e")) {
				return XlsxCell->New(row, column, KindError(), value, Nil);
			}
			else if(type->Equals("d")) {
				date := IsoDate(value->Trim());
				if(date = Nil) {
					error->Set("{$where}, cell {$reference}: '{$value}' is not an ISO 8601 date");
					return Nil;
				};
				return XlsxCell->New(row, column, KindDate(), DateText(date), date);
			};

			# a number, or a date when its style is a date format
			number := value->Trim();
			if(Cell->NumberKind(number) = 0) {
				error->Set("{$where}, cell {$reference}: '{$value}' is not a number");
				return Nil;
			};

			style_text := Attribute(element, "s");
			style := style_text <> Nil & Cell->NumberKind(style_text) = 1 ? style_text->ToInt() : 0;
			if(style >= 0 & style < @date_styles->Size()) {
				if(@date_styles->Get(style)->Get()) {
					date := SerialToDate(number->ToFloat(), @date1904);
					return XlsxCell->New(row, column, KindDate(), DateText(date), date);
				};
			};

			return XlsxCell->New(row, column, KindNumber(), number, Nil);
		}

		# the cells with each merged range's top-left value copied into the rest of the range
		method : FillMerged(cells : Vector<XlsxCell>, ranges : Vector<XmlElement>, where : String, error : StringHolder) ~ Vector<XlsxCell> {
			at := Map->New()<IntRef, XlsxCell>;
			each(i : cells) {
				cell := cells->Get(i);
				at->Insert(IntRef->New(cell->GetRow() * 16385 + cell->GetColumn()), cell);
			};

			added := 0;
			each(i : ranges) {
				range := Attribute(ranges->Get(i), "ref");
				colon := range <> Nil ? range->Find(':') : -1;
				if(colon > 0) {
					corner_at := ParseReference(range->SubString(0, colon));
					end_at := ParseReference(range->SubString(colon + 1, range->Size() - colon - 1));
					if(corner_at = Nil | end_at = Nil | corner_at[1] < 1 | end_at[1] < corner_at[1] | end_at[0] < corner_at[0]) {
						error->Set("{$where}: merged range '{$range}' is not a range");
						return Nil;
					};

					added += (end_at[1] - corner_at[1] + 1) * (end_at[0] - corner_at[0] + 1);
					if(added > 10000000) {
						error->Set("{$where}: merged ranges cover more than 10,000,000 cells");
						return Nil;
					};

					corner := at->Find(IntRef->New(corner_at[1] * 16385 + corner_at[0]));
					if(corner <> Nil) {
						for(r := corner_at[1]; r <= end_at[1]; r += 1;) {
							for(c := corner_at[0]; c <= end_at[0]; c += 1;) {
								key := IntRef->New(r * 16385 + c);
								if(r <> corner_at[1] | c <> corner_at[0]) {
									if(at->Has(key)) {
										at->Remove(key);
									};
									at->Insert(key, corner->At(r, c));
								};
							};
						};
					};
				};
			};

			filled := Vector->New()<XlsxCell>;
			keys := at->GetKeys();
			each(i : keys) {
				filled->AddBack(at->Find(keys->Get(i)));
			};
			return filled;
		}

		# the used range as a typed table
		method : Build(name : String, cells : Vector<XlsxCell>, header : Bool, first_row : Int, where : String, error : StringHolder) ~ Table {
			# the rows and columns in use, from the first row
			top := first_row > 0 ? first_row : -1;
			if(top < 0) {
				each(i : cells) {
					row := cells->Get(i)->GetRow();
					if(top < 0 | row < top) {
						top := row;
					};
				};
			};

			bottom := -1;
			left := -1;
			right := -1;
			each(i : cells) {
				cell := cells->Get(i);
				if(cell->GetRow() >= top) {
					if(cell->GetRow() > bottom) {
						bottom := cell->GetRow();
					};
					if(left < 0 | cell->GetColumn() < left) {
						left := cell->GetColumn();
					};
					if(cell->GetColumn() > right) {
						right := cell->GetColumn();
					};
				};
			};

			if(bottom < 0) {
				return Table->New(name, String->New[0]);
			};

			width := right - left + 1;
			data_top := header ? top + 1 : top;
			height := bottom - data_top + 1;
			if(height < 0) {
				height := 0;
			};
			if(height * width > 50000000) {
				error->Set("{$where}: its used range ({$width} columns by {$height} rows) is too large to read; SetFirstRow can skip rows above the data");
				return Nil;
			};

			# column names: the header row's cells, or the column letters
			names := String->New[width];
			each(c : names) {
				names[c] := Letters(left + c);
			};
			if(header) {
				each(i : cells) {
					cell := cells->Get(i);
					if(cell->GetRow() = top) {
						text := Value(cell, ColumnType->STRING)->As(String)->Trim();
						if(text->Size() > 0) {
							names[cell->GetColumn() - left] := text;
						};
					};
				};
				Unique(names);
			};

			# each column's type, from all its data cells
			kinds := Int->New[width * 5];
			whole := Bool->New[width];
			each(c : whole) {
				whole[c] := true;
			};
			each(i : cells) {
				cell := cells->Get(i);
				if(cell->GetRow() >= data_top) {
					c := cell->GetColumn() - left;
					kinds[c * 5 + cell->GetKind()] += 1;
					if(cell->GetKind() = KindNumber() & Cell->NumberKind(cell->GetText()) <> 1) {
						whole[c] := false;
					};
				};
			};

			types := ColumnType->New[width];
			each(c : types) {
				texts := kinds[c * 5 + KindText()] + kinds[c * 5 + KindError()];
				numbers := kinds[c * 5 + KindNumber()];
				bools := kinds[c * 5 + KindBool()];
				dates := kinds[c * 5 + KindDate()];
				types[c] := ColumnType->STRING;
				if(texts = 0) {
					if(numbers > 0 & bools = 0 & dates = 0) {
						types[c] := whole[c] ? ColumnType->INT : ColumnType->FLOAT;
					}
					else if(bools > 0 & numbers = 0 & dates = 0) {
						types[c] := ColumnType->BOOL;
					}
					else if(dates > 0 & numbers = 0 & bools = 0) {
						types[c] := ColumnType->DATE;
					};
				};
			};

			table := Table->New(name, names, types, false);
			each(r : height) {
				table->Insert();
			};

			each(i : cells) {
				cell := cells->Get(i);
				if(cell->GetRow() >= data_top) {
					c := cell->GetColumn() - left;
					table->Get(cell->GetRow() - data_top)->Set(c + 1, Value(cell, types[c]));
				};
			};

			return table;
		}

		# a cell's value in a column of a type
		function : Value(cell : XlsxCell, type : ColumnType) ~ Compare {
			select(type) {
				label ColumnType->INT: {
					return IntRef->New(cell->GetText()->ToInt());
				}

				label ColumnType->FLOAT: {
					return FloatRef->New(cell->GetText()->ToFloat());
				}

				label ColumnType->BOOL: {
					return BoolRef->New(cell->GetText()->Equals("1"));
				}

				label ColumnType->DATE: {
					return cell->GetDate();
				}
			};

			if(cell->GetKind() = KindBool()) {
				return cell->GetText()->Equals("1") ? "TRUE" : "FALSE";
			};

			return cell->GetText();
		}

		# names made unique: a repeat gets '_2', '_3' ...
		function : Unique(names : String[]) ~ Nil {
			seen := Map->New()<String, IntRef>;
			each(i : names) {
				seen->Insert(names[i], IntRef->New(1));
			};

			used := Map->New()<String, IntRef>;
			each(i : names) {
				name := names[i];
				if(used->Has(name)) {
					n := 2;
					while(seen->Has("{$name}_{$n}") | used->Has("{$name}_{$n}")) {
						n += 1;
					};
					names[i] := "{$name}_{$n}";
				};
				used->Insert(names[i], IntRef->New(1));
			};
		}
	}

	# one JSON value as its text and kind, converted when the column's type is known
	class : private : JsonCell {
		@kind : JsonCell->Kind;
		@text : String;

		#~
		The kind of a JSON value read into a table cell.
		~#
		enum Kind {
			#~
			A string.
			~#
			TEXT,
			#~
			A number.
			~#
			NUMBER,
			#~
			true or false.
			~#
			BOOL
		}

		New(kind : JsonCell->Kind, text : String) {
			@kind := kind;
			@text := text;
		}

		method : public : GetKind() ~ JsonCell->Kind {
			return @kind;
		}

		method : public : GetText() ~ String {
			return @text;
		}

		method : public : ToValue(type : ColumnType) ~ Compare {
			select(type) {
				label ColumnType->INT: {
					return IntRef->New(@text->ToInt());
				}

				label ColumnType->FLOAT: {
					return FloatRef->New(@text->ToFloat());
				}

				label ColumnType->BOOL: {
					return BoolRef->New(@text->Equals("true"));
				}
			};

			return @text;
		}
	}

	# a parsed CSV table and how many of its records are data rows (0 for a header alone)
	class : private : ParsedCsv {
		@table : Data.CSV.CsvTable;
		@rows : Int;

		New(table : Data.CSV.CsvTable, rows : Int) {
			@table := table;
			@rows := rows;
		}

		method : public : GetTable() ~ Data.CSV.CsvTable {
			return @table;
		}

		method : public : GetRows() ~ Int {
			return @rows;
		}
	}

	#~
	Finds files whose full path matches a regular expression, searching a folder and everything
	below it. Entries whose names start with '.' are skipped, and hidden folders are not
	entered.
	~#
	class Finder {
		@regex : RegEx;

		#~
		Default constructor
		@param expr regex expression
		```
		finder := Query.Structured.Finder->New(".*\\.obs$"); # match .obs files
		matches := finder->FindFiles("/home/user/src");
		each(i : matches) { matches->Get(i)->PrintLine(); };
		```
		~#
		New(expr : String) {
			@regex := RegEx->New(expr);
		}

		#~
		Finds matching files in a given directory
		@param path root directory to start searching
		@return matching file names, as full paths
		```
		finder := Query.Structured.Finder->New(".*\\.json$"); # find JSON files
		results := finder->FindFiles("/etc/");
		each(i : results) {
		  results->Get(i)->PrintLine();
		};
		```
		~#
		method : public : FindFiles(path : String) ~ Vector<String> {
			matches := Vector->New()<String>;
			if(<>@regex->IsOk()) {
				return matches;
			};

			source := FilesystemSource->New(path, true, -1, false);
			listing := source->List(["path", "is_dir"]);
			if(listing = Nil) {
				return matches;
			};

			paths := listing->GetColumn("path");
			dirs := listing->GetColumn("is_dir");
			each(row : listing->GetRowCapacity()) {
				if(dirs->GetInt(row) = 0) {
					full_name := File->GetFullName(paths->GetString(row));
					if(full_name <> Nil & @regex->MatchExact(full_name)) {
						matches->AddBack(full_name);
					};
				};
			};

			return matches;
		}

		#~
		Finds matching files as a view over the filesystem table, so the result can be filtered,
		sorted, grouped or joined. The rows are the files FindFiles returns; the columns are
		FilesystemSource's.
		@param path root directory to start searching
		@return matching files, Nil if the pattern is invalid or the directory cannot be read
		```
		finder := Query.Structured.Finder->New(".*\\.obs$");
		big := finder->FindTable("src")->Where(Col->Of("size")->Gt(10000))->OrderBy("size", Order->DESC);
		```
		~#
		method : public : FindTable(path : String) ~ View {
			if(<>@regex->IsOk()) {
				return Nil;
			};

			files := FilesystemSource->New(path, true, -1, false)->List();
			if(files = Nil) {
				return Nil;
			};

			paths := files->GetColumn("path");
			dirs := files->GetColumn("is_dir");
			live := files->LiveRows();
			rows := Int->New[live->Size()];
			n := 0;
			each(i : live) {
				row := live[i];
				if(dirs->GetInt(row) = 0) {
					full_name := File->GetFullName(paths->GetString(row));
					if(full_name <> Nil & @regex->MatchExact(full_name)) {
						rows[n] := row;
						n += 1;
					};
				};
			};

			columns := Int->New[files->GetColumnCount() - 1];
			each(i : columns) {
				columns[i] := i + 1;
			};

			return View->New(files, columns, Filter->Trim(rows, n));
		}
	}
}
