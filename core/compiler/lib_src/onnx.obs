	#~
	DeepLab segmentation results containing masked/overlay images and per-class classifications
	~#
	class DeepLabResult {
		@masked_dims : Int[];
		@masked : API.OpenCV.Image;

		@overlay_dims : Int[];
		@overlay : API.OpenCV.Image;

		@classifications : DeepLabClassification[];

		#~
		Gets an array of classifications
		@return array of classifications
		~#
		method : public : GetClassifications() ~ DeepLabClassification[] {
			return @classifications;
		}

		New : private () {}

		#~
		Gets the masked image
		@return masked image
		~#
		method : public : GetMaskedImage() ~ API.OpenCV.Image {
			return @masked;
		}

		#~
		Gets the overlay image
		@return overlay image
		~#
		method : public : GetOverlayImage() ~ API.OpenCV.Image {
			return @overlay;
		}

		#~
		Gets the masked image dimensions
		@return masked image dimensions
		~#
		method : public : GetMaskedDimensions() ~ Int[] {
			return @masked_dims;
		}

		#~
		Gets the overlay image dimensions
		@return overlay image dimensions
		~#
		method : public : GetOverlayDimensions() ~ Int[] {
			return @overlay_dims;
		}

		#~
		JSON representation 
		@return JSON representation 
		~#
		method : public : ToJson() ~ JsonElement {
			elem_json := JsonElement->New(JsonElement->JsonType->ARRAY);

			each(classification in @classifications) {
				elem_json->Add(classification->ToJson());
			};

			return elem_json;
		}

		#~
		Get string representation
		@return string representation
		~#
		method : public : ToString() ~ String {
			buffer := "masked-image-size=";

			if(@masked = Nil) {
				buffer += "<nil>, overlay-image-size=";
			}
			else {
				output_size := @masked->Size();
				buffer += "{$output_size}, overlay-image-size=";
			};

			if(@overlay = Nil) {
				buffer += "<nil>, classifications=";
			}
			else {
				output_size := @overlay->Size();
				buffer += "{$output_size}, classifications=";
			};

			if(@classifications = Nil) {
				buffer += 0;
			}
			else {
				classifications_size := @classifications->Size();
				buffer += classifications_size;
			};

			return buffer;
		}
	}

	#~
	DeepLab classification result for a single segmented class with coverage and polygons
	~#
	class DeepLabClassification {
		@id : Int;
		@name : String;
		@confidence : Float;

		@polygons : Collection.Tuple.Pair[]<IntRef, IntRef>;

		New : private () {
		}

		#~
		Get classification ID
		@return classification ID
		~#
		method : public : GetId() ~ Int {
			return @id;
		}

		#~
		Get identified polygons 
		@return identified polygons
		~#
		method : public : GetPolygons() ~ Collection.Tuple.Pair[]<IntRef, IntRef> {
			return @polygons;
		}

		#~
		Get classification name
		@return classification name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Get classification confidence
		@return classification confidence
		~#
		method : public : GetConfidence() ~ Float {
			return @confidence;
		}

		#~
		JSON representation 
		@return JSON representation 
		~#
		method : public : ToJson() ~ JsonElement {
			elem_json := JsonElement->New(JsonElement->JsonType->OBJECT);

			elem_json->Insert("id", @id);
			elem_json->Insert("name", @name);

			if(#~@polygons <> Nil~# false) {
				polygons_json := JsonElement->New(JsonElement->JsonType->ARRAY);
				each(polygon in @polygons) {
					polygon_json := JsonElement->New(JsonElement->JsonType->ARRAY);
					polygon_json->Add(polygon->GetFirst()->Get());
					polygon_json->Add(polygon->GetSecond()->Get());

					polygons_json->Add(polygon_json);
				};

				elem_json->Insert("polygons", polygons_json);
			};

			return elem_json;
		}

		#~
		Get string representation
		@return string representation
		~#
		method : public : ToString() ~ String {
			poly_count := 0;
			if(@polygons <> Nil) {
				poly_count := @polygons->Size();
			};

			return "[id={$@id}, name={$@name}, conf={$@confidence}, poly_count={$poly_count}]";
		}
	}

	#~
	OpenPose inference session for human pose estimation (17-keypoint COCO skeleton).
	Uses letterbox preprocessing with inverse keypoint mapping for accurate coordinates.
	Supports 18/19/25/26/57-channel output configurations.

	```
	labels := ["nose", "left_eye", "right_eye", "left_ear", "right_ear",
	  "left_shoulder", "right_shoulder", "left_elbow", "right_elbow",
	  "left_wrist", "right_wrist", "left_hip", "right_hip",
	  "left_knee", "right_knee", "left_ankle", "right_ankle"];
	session := OpenPoseSession->New("openpose.onnx");
	result := session->Inference(image_bytes, labels);
	each(kp in result->GetClassifications()) {
	  if(kp->GetConfidence() > 0) {
	    "{kp->GetName()}: [{kp->GetNormalizedX()}, {kp->GetNormalizedY()}]"->PrintLine();
	  };
	};
	session->Close();
	```
	~#
	class OpenPoseSession {
		# Native entry-point names, held rather than written at each call
		# site: a string literal is materialised into a fresh String every
		# time it is evaluated, which on a hot path is an allocation and a
		# copy per call. Static because these are class-wide constants and a
		# static function cannot read an instance field.
		@fn_onnx_close_session : static : String;
		@fn_onnx_new_session : static : String;
		@fn_onnx_openpose_image_inf : static : String;
		@session : Int;

		#~
		Constructor.
		@param model OpenPose model path
		~#
		New(model : String) {
			Init(model, Nil);
		}

		#~
		Constructor.
		@param model OpenPose model path
		@param config session configuration parameters
		~#
		New(model : String, config : Map<String, String>) {
			Init(model, config);
		}

		method : Init(model : String, config : Map<String, String>) ~ Nil {
			keys := Vector->New()<String>;
			values := Vector->New()<String>;

			if(config <> Nil) {
				key_values := config->GetKeyValues()<Pair<String, String>>;
				each(key_value in key_values) {
					keys->AddBack(key_value->GetFirst());
					values->AddBack(key_value->GetSecond());
				};
			};

			keys_array := keys->ToArray();
			values_array := values->ToArray();

			array_args := Base->New[5];

			array_args[0] := IntRef->New();
			array_args[1] := StringArrayRef->New(keys_array);
			array_args[2] := StringArrayRef->New(values_array);
			array_args[3] := model;
						
			if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
			value := array_args[0]->As(IntRef);
			@session := value->Get();
		}

		#~
		Closes the session
		~#
		#~
		Whether the model loaded.
		
		A session that failed to open is not an error at construction -- the
		constructor returns an object either way, and the reason was written to
		stderr while it happened. Test this before inferring: a closed session
		returns Nil from every inference method, which is otherwise
		indistinguishable from a model that found nothing.
		@return true when the model is loaded and inference can run
		~#

		method : public : IsOpen() ~ Bool {
			return @session <> 0;
		}

		method : public : Close() ~ Nil {
			# Zeroing the handle is what makes this idempotent. close_session deletes
			# the Ort::Session and nulls its own LOCAL copy, which the caller never
			# sees, so a handle left here is a pointer to freed memory: a second Close
			# used to be a double free (0xC0000374 / 0xC0000005) and IsOpen() reported
			# true forever after -- which #1028 made the documented way to tell a live
			# session from a dead one. #1046.
			if(@session = 0) {
				return;
			};
			array_args := Base->New[1];
			array_args[0] := IntRef->New(@session);

			if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
			@session := 0;
		}

		#~
		OpenPose image inference
		@param image image bytes
		@param height image height
		@param image width width

```
labels := ["nose", "left_eye", "right_eye", "left_ear", "right_ear",
  "left_shoulder", "right_shoulder", "left_elbow", "right_elbow",
  "left_wrist", "right_wrist", "left_hip", "right_hip",
  "left_knee", "right_knee", "left_ankle", "right_ankle"];
session := OpenPoseSession->New("openpose.onnx");
image := FileReader->ReadBinaryFile("person.jpg");
result := session->Inference(image, labels);
each(kp in result->GetClassifications()) {
  if(kp->GetConfidence() > 0) {
    "{$kp->GetName()}: ({$kp->GetNormalizedX()},{$kp->GetNormalizedY()})"->PrintLine();
  };
};
session->Close();
```
		~#
		method : public : Inference(image : Byte[], labels : String[]) ~ API.Onnx.OpenPoseResult {
			if(image = Nil) {
				return Nil;
			};

			array_args := Base->New[4];

			array_args[0] := Nil;
			array_args[1] := IntRef->New(@session);
			array_args[2] := ByteArrayRef->New(image);
			array_args[3] := StringArrayRef->New(labels);
			
			if(@fn_onnx_openpose_image_inf = Nil) { @fn_onnx_openpose_image_inf := "onnx_openpose_image_inf"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_openpose_image_inf, array_args);
			
			results := array_args[0]->As(API.Onnx.OpenPoseResult);

			return results;
		}
	}

	#~
	OpenPose results containing a visualization image, normalized bounding box, and keypoint classifications
	~#
	class OpenPoseResult {
		@norm_x : Float;
		@norm_y : Float;
		@norm_w : Float;
		@norm_h : Float;

		@masked_dims : Int[];
		@masked : API.OpenCV.Image;

		@classifications : OpenPoseClassification[];
		
		New : private () {}

		#~
		Gets an array of classifications
		@return array of classifications
		~#
		method : public : GetClassifications() ~ OpenPoseClassification[] {
			return @classifications;
		}

		#~
		Gets the masked image
		@return masked image
		~#
		method : public : GetMaskedImage() ~ API.OpenCV.Image {
			return @masked;
		}

		#~
		Gets the masked image dimensions
		@return masked image dimensions
		~#
		method : public : GetMaskedDimensions() ~ Int[] {
			return @masked_dims;
		}

		#~
		Get normalized X-coordinate 
		@return normalized X-coordinate 
		~#
		method : public : GetNormalizedX() ~ Float {
			return @norm_x;
		}

		#~
		Get normalized y-coordinate 
		@return normalized y-coordinate
		~#
		method : public : GetNormalizedY() ~ Float {
			return @norm_y;
		}

		#~
		Get normalized height
		@return normalized height
		~#
		method : public : GetNormalizedHeight() ~ Float {
			return @norm_h;
		}

		#~
		Get normalized width
		@return normalized width
		~#
		method : public : GetNormalizedWidth() ~ Float {
			return @norm_w;
		}

		#~
		JSON representation 
		@return JSON representation 
		~#
		method : public : ToJson() ~ JsonElement {
			elem_json := JsonElement->New(JsonElement->JsonType->OBJECT);

			norms_json := JsonElement->New(JsonElement->JsonType->ARRAY);
			norms_json->Add(@norm_x);
			norms_json->Add(@norm_y);
			norms_json->Add(@norm_w);
			norms_json->Add(@norm_h);
			elem_json->Insert("norms", norms_json);

			classes_json := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(classification in @classifications) {
				classes_json->Add(classification->ToJson());
			};
			elem_json->Insert("classifications", classes_json);

			return elem_json;
		}

		#~
		Get string representation
		@return string representation
		~#
		method : public : ToString() ~ String {
			buffer := "masked-image-size=";

			if(@masked = Nil) {
				buffer += "<nil>, ";
			}
			else {
				output_size := @masked->Size();
				buffer += "{$output_size}, ";
			};

			buffer += "normalized=["
			buffer += @norm_x;
			buffer += ',';
			buffer += @norm_y;
			buffer += ',';
			buffer += @norm_w;
			buffer += ',';
			buffer += @norm_h;
			buffer += "], num_classes=";

			if(@classifications = Nil) {
				buffer += 0;
			}
			else {
				classifications_size := @classifications->Size();
				buffer += classifications_size;
			};

			return buffer;
		}
	}

	#~
	Phi-3 tokenizer for encoding text to token IDs and decoding token IDs back to text.
	Loads a HuggingFace tokenizer.json file and supports BPE encoding/decoding.

	```
	tokenizer := Phi3Tokenizer->New("phi3-mini/tokenizer.json");
	ids := tokenizer->Encode("What is 2+2?");
	text := tokenizer->Decode(ids);
	text->PrintLine();
	```
	~#
	class Phi3Tokenizer {
		@id_to_token : String[];
		@token_to_id : Hash<String, IntRef>;
		@merge_rank : Hash<String, IntRef>;
		@vocab_size : Int;
		@byte_token_prefix : String;
		@added_tokens : String[];

		#~
		Constructor.
		@param tokenizer_path path to tokenizer.json file
		~#
		New(tokenizer_path : String) {
			@byte_token_prefix := "<0x";
			@token_to_id := Hash->New()<String, IntRef>;
			@merge_rank := Hash->New()<String, IntRef>;

			json_text := FileReader->ReadFile(tokenizer_path);
			if(json_text = Nil) {
				return;
			};

			parser := JsonParser->New(json_text);
			if(parser->Parse() = false) {
				return;
			};

			root := parser->GetRoot();
			if(root = Nil) {
				return;
			};

			model := root->Get("model");
			if(model = Nil) {
				return;
			};

			# Parse vocab
			vocab := model->Get("vocab");
			if(vocab <> Nil) {
				@vocab_size := vocab->Size();
				@id_to_token := String->New[@vocab_size + 100];

				names := vocab->GetNames();
				each(i : names) {
					name := names->Get(i);
					id_elem := vocab->Get(name);
					if(id_elem <> Nil) {
						id := id_elem->GetInt();
						@token_to_id->Insert(name, IntRef->New(id));
						if(id >= 0 & id < @id_to_token->Size()) {
							@id_to_token[id] := name;
						};
					};
				};
			};

			# Parse added tokens
			added := root->Get("added_tokens");
			if(added <> Nil) {
				added_vec := Vector->New()<String>;
				each(i : added) {
					token_elem := added->Get(i);
					if(token_elem <> Nil) {
						id := token_elem->Get("id")->GetInt();
						content := token_elem->Get("content")->GetString();
						if(content <> Nil) {
							@token_to_id->Insert(content, IntRef->New(id));
							if(id >= 0 & id < @id_to_token->Size()) {
								@id_to_token[id] := content;
							};
							added_vec->AddBack(content);
						};
					};
				};
				@added_tokens := String->New[added_vec->Size()];
				each(i : added_vec) {
					@added_tokens[i] := added_vec->Get(i);
				};
			};

			# Parse merges
			merges := model->Get("merges");
			if(merges <> Nil) {
				each(i : merges) {
					merge_str := merges->Get(i)->GetString();
					if(merge_str <> Nil) {
						@merge_rank->Insert(merge_str, IntRef->New(i));
					};
				};
			};
		}

		#~
		Checks if the tokenizer was loaded successfully
		@return true if loaded

```
tokenizer := Phi3Tokenizer->New("phi3-mini/tokenizer.json");
if(tokenizer->IsLoaded()) {
  "Tokenizer ready, vocab={$tokenizer->GetVocabSize()}"->PrintLine();
};
```
		~#
		method : public : IsLoaded() ~ Bool {
			return @id_to_token <> Nil & @vocab_size > 0;
		}

		#~
		Decode token IDs to human-readable text
		@param token_ids array of token IDs
		@return decoded text string

```
tokenizer := Phi3Tokenizer->New("phi3-mini/tokenizer.json");
ids := [1, 3148, 1001, 29901];
text := tokenizer->Decode(ids);
text->PrintLine();
```
		~#
		method : public : Decode(token_ids : Int[]) ~ String {
			if(token_ids = Nil | @id_to_token = Nil) {
				return "";
			};

			buffer := String->New();
			each(i : token_ids) {
				id := token_ids[i];
				if(id >= 0 & id < @id_to_token->Size()) {
					token := @id_to_token[id];
					if(token <> Nil) {
						# Skip special tokens
						if(token->StartsWith("<|") & token->EndsWith("|>")) {
							# skip
						}
						# Handle byte tokens <0xHH>
						else if(token->StartsWith(@byte_token_prefix) & token->EndsWith(">") & token->Size() = 6) {
							hex := token->SubString(3, 2);
							byte_val := hex->ToInt(16);
							buffer->Append(byte_val->As(Char));
						}
						else {
							buffer->Append(token);
						};
					};
				};
			};

			# Replace SentencePiece space marker with actual space
			result := buffer->ToString()->ReplaceAll("\u2581", " ");

			# Trim leading space
			if(result->Size() > 0 & result->Get(0) = ' ') {
				result := result->SubString(1, result->Size() - 1);
			};

			return result;
		}

		#~
		Encode text to token IDs using BPE with special token handling.
		Added/special tokens are matched as whole strings before BPE is applied.
		@param text input text to tokenize
		@return array of token IDs

```
tokenizer := Phi3Tokenizer->New("phi3-mini/tokenizer.json");
ids := tokenizer->Encode("What is 2+2?");
"Tokens: {$ids->Size()}"->PrintLine();
```
		~#
		method : public : Encode(text : String) ~ Int[] {
			if(text = Nil | text->Size() = 0 | @token_to_id->Size() = 0) {
				return Int->New[0];
			};

			# If no added tokens, fall back to pure BPE
			if(@added_tokens = Nil | @added_tokens->Size() = 0) {
				return EncodeBPE(text);
			};

			# Split text on added/special tokens, then BPE-encode regular segments
			ids := Vector->New()<IntRef>;
			pos := 0;

			while(pos < text->Size()) {
				# Try to match an added token at current position (longest match)
				best_match : String;
				best_len := 0;
				each(i : @added_tokens) {
					st := @added_tokens[i];
					st_len := st->Size();
					if(st_len > best_len & pos + st_len <= text->Size()) {
						if(text->SubString(pos, st_len)->Equals(st)) {
							best_match := st;
							best_len := st_len;
						};
					};
				};

				if(best_len > 0) {
					# Found an added token - emit its ID directly
					st_id := @token_to_id->Find(best_match);
					if(st_id <> Nil) {
						ids->AddBack(st_id);
					};
					pos += best_len;
				}
				else {
					# Accumulate regular text until next added token or end
					seg_start := pos;
					found := false;
					while(pos < text->Size() & found = false) {
						each(j : @added_tokens) {
							st := @added_tokens[j];
							st_len := st->Size();
							if(found = false & pos + st_len <= text->Size()) {
								if(text->SubString(pos, st_len)->Equals(st)) {
									found := true;
								};
							};
						};
						if(found = false) {
							pos += 1;
						};
					};

					# BPE-encode the regular text segment
					if(pos > seg_start) {
						segment := text->SubString(seg_start, pos - seg_start);
						seg_ids := EncodeBPE(segment);
						each(k : seg_ids) {
							ids->AddBack(IntRef->New(seg_ids[k]));
						};
					};
				};
			};

			result := Int->New[ids->Size()];
			each(i : ids) {
				result[i] := ids->Get(i)->Get();
			};

			return result;
		}

		#~
		Encode text to token IDs using BPE (no special token handling)
		@param text input text to tokenize
		@return array of token IDs
		~#
		method : EncodeBPE(text : String) ~ Int[] {
			if(text = Nil | text->Size() = 0) {
				return Int->New[0];
			};

			# Replace spaces with SentencePiece marker
			buffer := String->New();
			buffer->Append("\u2581");
			each(i : text) {
				ch := text->Get(i);
				if(ch = ' ') {
					buffer->Append("\u2581");
				}
				else {
					buffer->Append(ch);
				};
			};
			processed := buffer->ToString();

			# Split into individual characters
			tokens := Vector->New()<String>;
			each(i : processed) {
				tokens->AddBack(processed->Get(i)->ToString());
			};

			# Build reusable pair buffer for merge lookups
			pair_buffer := String->New();

			# Apply BPE merges iteratively
			changed := true;
			while(changed & tokens->Size() > 1) {
				changed := false;

				# Find the best (lowest rank) merge pair
				best_rank := -1;
				best_idx := -1;
				limit := tokens->Size() - 1;
				for(i := 0; i < limit; i += 1;) {
					pair_buffer->Clear();
					pair_buffer->Append(tokens->Get(i));
					pair_buffer->Append(' ');
					pair_buffer->Append(tokens->Get(i + 1));
					rank_ref := @merge_rank->Find(pair_buffer->ToString());
					if(rank_ref <> Nil) {
						rank := rank_ref->Get();
						if(best_rank < 0 | rank < best_rank) {
							best_rank := rank;
							best_idx := i;
						};
					};
				};

				if(best_idx >= 0) {
					# Merge all occurrences of this pair
					merged := tokens->Get(best_idx) + tokens->Get(best_idx + 1);
					pair_first := tokens->Get(best_idx);
					pair_second := tokens->Get(best_idx + 1);

					new_tokens := Vector->New()<String>;
					j := 0;
					while(j < tokens->Size()) {
						if(j < tokens->Size() - 1 & tokens->Get(j)->Equals(pair_first) & tokens->Get(j + 1)->Equals(pair_second)) {
							new_tokens->AddBack(merged);
							j += 2;
						}
						else {
							new_tokens->AddBack(tokens->Get(j));
							j += 1;
						};
					};
					tokens := new_tokens;
					changed := true;
				};
			};

			# Look up token IDs
			ids := Vector->New()<IntRef>;
			each(i : tokens) {
				token := tokens->Get(i);
				id_ref := @token_to_id->Find(token);
				if(id_ref <> Nil) {
					ids->AddBack(id_ref);
				}
				else {
					# Byte-level fallback for unknown characters
					bytes := token->ToByteArray();
					each(b : bytes) {
						hex := Byte->ToHexString(bytes[b])->ToUpper();
						if(hex->Size() = 1) {
							hex := "0" + hex;
						};
						byte_token := "<0x" + hex + ">";
						byte_id_ref := @token_to_id->Find(byte_token);
						if(byte_id_ref <> Nil) {
							ids->AddBack(byte_id_ref);
						};
					};
				};
			};

			result := Int->New[ids->Size()];
			each(i : ids) {
				result[i] := ids->Get(i)->Get();
			};

			return result;
		}

		#~
		Gets the vocabulary size
		@return vocabulary size
		~#
		method : public : GetVocabSize() ~ Int {
			return @vocab_size;
		}
	}

	#~
	Phi-3 / SLM inference session for text generation.
	Supports autoregressive generation with KV-cache management,
	temperature-based sampling, and configurable EOS tokens.

	```
	session := Phi3Session->New("phi3-mini/model.onnx");
	token_ids := [1, 3148, 1001, 29901, 825, 338, 29871, 29906, 718, 29871, 29906, 29973];
	eos_tokens := [2, 32007];
	result := session->Generate(token_ids, 128, 0.7, eos_tokens);
	each(token in result->GetTokens()) {
	  token->PrintLine();
	};
	session->Close();
	```
	~#
	class Phi3Session {
		# Native entry-point names, held rather than written at each call
		# site: a string literal is materialised into a fresh String every
		# time it is evaluated, which on a hot path is an allocation and a
		# copy per call. Static because these are class-wide constants and a
		# static function cannot read an instance field.
		@fn_onnx_close_session : static : String;
		@fn_onnx_new_session : static : String;
		@fn_onnx_phi3_text_inf : static : String;
		@session : Int;

		#~
		Constructor.
		@param model Phi-3/SLM ONNX model path
		~#
		New(model : String) {
			Init(model, Nil);
		}

		#~
		Constructor.
		@param model Phi-3/SLM ONNX model path
		@param config session configuration parameters
		~#
		New(model : String, config : Map<String, String>) {
			Init(model, config);
		}

		method : Init(model : String, config : Map<String, String>) ~ Nil {
			keys := Vector->New()<String>;
			values := Vector->New()<String>;

			if(config <> Nil) {
				key_values := config->GetKeyValues()<Pair<String, String>>;
				each(key_value in key_values) {
					keys->AddBack(key_value->GetFirst());
					values->AddBack(key_value->GetSecond());
				};
			};

			keys_array := keys->ToArray();
			values_array := values->ToArray();

			array_args := Base->New[4];

			array_args[0] := IntRef->New();
			array_args[1] := StringArrayRef->New(keys_array);
			array_args[2] := StringArrayRef->New(values_array);
			array_args[3] := model;

			if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
			value := array_args[0]->As(IntRef);
			@session := value->Get();
		}

		#~
		Closes the session
		~#
		#~
		Whether the model loaded.
		
		A session that failed to open is not an error at construction -- the
		constructor returns an object either way, and the reason was written to
		stderr while it happened. Test this before inferring: a closed session
		returns Nil from every inference method, which is otherwise
		indistinguishable from a model that found nothing.
		@return true when the model is loaded and inference can run
		~#

		method : public : IsOpen() ~ Bool {
			return @session <> 0;
		}

		method : public : Close() ~ Nil {
			# Zeroing the handle is what makes this idempotent. close_session deletes
			# the Ort::Session and nulls its own LOCAL copy, which the caller never
			# sees, so a handle left here is a pointer to freed memory: a second Close
			# used to be a double free (0xC0000374 / 0xC0000005) and IsOpen() reported
			# true forever after -- which #1028 made the documented way to tell a live
			# session from a dead one. #1046.
			if(@session = 0) {
				return;
			};
			array_args := Base->New[1];
			array_args[0] := IntRef->New(@session);

			if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
			@session := 0;
		}

		#~
		Generate text tokens from input token IDs
		@param token_ids input token IDs (prompt)
		@param max_tokens maximum number of tokens to generate
		@param temperature sampling temperature (0.0 for greedy)
		@param eos_tokens array of end-of-sequence token IDs
		@return generation result with output token IDs

```
session := Phi3Session->New("phi3-mini/model.onnx");
tokenizer := Phi3Tokenizer->New("phi3-mini/tokenizer.json");
ids := tokenizer->Encode("<|user|>\nWhat is 2+2?<|end|>");
eos := [32007, 32000];
result := session->Generate(ids, 128, 0.0, eos);
tokenizer->Decode(result->GetTokens())->PrintLine();
session->Close();
```
		~#
		method : public : Generate(token_ids : Int[], max_tokens : Int, temperature : Float, eos_tokens : Int[]) ~ API.Onnx.Phi3Result {
			if(token_ids = Nil | eos_tokens = Nil) {
				return Nil;
			};

			array_args := Base->New[6];

			array_args[0] := Nil;
			array_args[1] := IntRef->New(@session);
			array_args[2] := IntArrayRef->New(token_ids);
			array_args[3] := IntRef->New(max_tokens);
			array_args[4] := FloatRef->New(temperature);
			array_args[5] := IntArrayRef->New(eos_tokens);

			if(@fn_onnx_phi3_text_inf = Nil) { @fn_onnx_phi3_text_inf := "onnx_phi3_text_inf"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_phi3_text_inf, array_args);

			return array_args[0]->As(API.Onnx.Phi3Result);
		}
	}

	#~
	Phi-3 / SLM generation result containing output token IDs
	~#
	class Phi3Result {
		@generated_tokens : Int[];

		New : private () {}

		#~
		Gets the generated token IDs (excluding prompt tokens)
		@return array of generated token IDs

```
result := session->Generate(ids, 128, 0.0, eos);
text := tokenizer->Decode(result->GetTokens());
text->PrintLine();
```
		~#
		method : public : GetTokens() ~ Int[] {
			return @generated_tokens;
		}

		#~
		Gets the number of generated tokens
		@return token count
		~#
		method : public : GetTokenCount() ~ Int {
			if(@generated_tokens = Nil) {
				return 0;
			};
			return @generated_tokens->Size();
		}

		#~
		Get string representation
		@return string representation
		~#
		method : public : ToString() ~ String {
			count := GetTokenCount();
			return "generated_tokens={$count}";
		}
	}

	#~
	Phi-3 Vision multimodal session for image understanding and generation.
	Uses three separate ONNX models: vision encoder, text embedding, and text decoder.
	Accepts raw image bytes (JPEG/PNG) and pre-tokenized prompt tokens split into
	prefix (before image placeholder) and suffix (after image placeholder) segments.

	```
	model_dir := "phi3v-directml/";
	session := Phi3VisionSession->New(
	  model_dir + "phi-3-v-128k-instruct-vision.onnx",
	  model_dir + "phi-3-v-128k-instruct-text-embedding.onnx",
	  model_dir + "model.onnx");
	image_bytes := System.IO.File.FileReader->ReadBinaryFile("photo.jpg");
	prefix := [32010, 29871];
	suffix := [32007, 32001];
	eos := [32000, 32007];
	result := session->Generate(image_bytes, prefix, suffix, 256, 0.0, eos);
	each(token in result->GetTokens()) {
	  token->PrintLine();
	};
	session->Close();
	```
	~#
	class Phi3VisionSession {
		# Native entry-point names, held rather than written at each call
		# site: a string literal is materialised into a fresh String every
		# time it is evaluated, which on a hot path is an allocation and a
		# copy per call. Static because these are class-wide constants and a
		# static function cannot read an instance field.
		@fn_onnx_close_session : static : String;
		@fn_onnx_new_session : static : String;
		@fn_onnx_phi3_vision_inf : static : String;
		@vision_session : Int;
		@embed_session : Int;
		@decoder_session : Int;

		#~
		Constructor.
		@param vision_model path to vision encoder ONNX model
		@param embed_model path to text embedding ONNX model
		@param decoder_model path to text decoder ONNX model
		~#
		New(vision_model : String, embed_model : String, decoder_model : String) {
			Init(vision_model, embed_model, decoder_model, Nil);
		}

		#~
		Constructor with configuration.
		@param vision_model path to vision encoder ONNX model
		@param embed_model path to text embedding ONNX model
		@param decoder_model path to text decoder ONNX model
		@param config session configuration parameters
		~#
		New(vision_model : String, embed_model : String, decoder_model : String, config : Map<String, String>) {
			Init(vision_model, embed_model, decoder_model, config);
		}

		method : Init(vision_model : String, embed_model : String, decoder_model : String, config : Map<String, String>) ~ Nil {
			keys := Vector->New()<String>;
			values := Vector->New()<String>;

			if(config <> Nil) {
				key_values := config->GetKeyValues()<Pair<String, String>>;
				each(key_value in key_values) {
					keys->AddBack(key_value->GetFirst());
					values->AddBack(key_value->GetSecond());
				};
			};

			keys_array := keys->ToArray();
			values_array := values->ToArray();

			# Create vision session
			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := StringArrayRef->New(keys_array);
			array_args[2] := StringArrayRef->New(values_array);
			array_args[3] := vision_model;
			if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
			value := array_args[0]->As(IntRef);
			@vision_session := value->Get();

			# Create embedding session
			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := StringArrayRef->New(keys_array);
			array_args[2] := StringArrayRef->New(values_array);
			array_args[3] := embed_model;
			if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
			value := array_args[0]->As(IntRef);
			@embed_session := value->Get();

			# Create decoder session
			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := StringArrayRef->New(keys_array);
			array_args[2] := StringArrayRef->New(values_array);
			array_args[3] := decoder_model;
			if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
			value := array_args[0]->As(IntRef);
			@decoder_session := value->Get();
		}

		#~
		Closes all three sessions (vision, embedding, decoder)
		~#
		#~
		Whether the model loaded.
		
		A session that failed to open is not an error at construction -- the
		constructor returns an object either way, and the reason was written to
		stderr while it happened. Test this before inferring: a closed session
		returns Nil from every inference method, which is otherwise
		indistinguishable from a model that found nothing.
		
		All three sessions -- vision, embedding and decoder -- must have loaded;
		any one of them missing leaves generation unable to run.
		@return true when the model is loaded and inference can run
		~#

		method : public : IsOpen() ~ Bool {
			return @vision_session <> 0 & @embed_session <> 0 & @decoder_session <> 0;
		}

		method : public : Close() ~ Nil {
			# Zeroing the handle is what makes this idempotent. close_session deletes
			# the Ort::Session and nulls its own LOCAL copy, which the caller never
			# sees, so a handle left here is a pointer to freed memory: a second Close
			# used to be a double free (0xC0000374 / 0xC0000005) and IsOpen() reported
			# true forever after -- which #1028 made the documented way to tell a live
			# session from a dead one. #1046.
			if(@vision_session = 0 & @embed_session = 0 & @decoder_session = 0) {
				return;
			};
			array_args := Base->New[1];

			array_args[0] := IntRef->New(@vision_session);
			if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
			@vision_session := 0;

			array_args[0] := IntRef->New(@embed_session);
			if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
			@embed_session := 0;

			array_args[0] := IntRef->New(@decoder_session);
			if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
			@decoder_session := 0;
		}

		#~
		Generate text tokens from an image and prompt tokens.
		The prompt is split into prefix tokens (before the image) and suffix tokens (after the image).
		@param image_bytes raw image file bytes (JPEG/PNG)
		@param prefix_tokens token IDs before the image placeholder
		@param suffix_tokens token IDs after the image placeholder
		@param max_tokens maximum number of tokens to generate
		@param temperature sampling temperature (0.0 for greedy)
		@param eos_tokens array of end-of-sequence token IDs
		@return generation result with output token IDs
		~#
		method : public : Generate(image_bytes : Byte[], prefix_tokens : Int[], suffix_tokens : Int[], max_tokens : Int, temperature : Float, eos_tokens : Int[]) ~ API.Onnx.Phi3Result {
			if(image_bytes = Nil | prefix_tokens = Nil | suffix_tokens = Nil | eos_tokens = Nil) {
				return Nil;
			};

			array_args := Base->New[10];

			array_args[0] := Nil;
			array_args[1] := IntRef->New(@vision_session);
			array_args[2] := IntRef->New(@embed_session);
			array_args[3] := IntRef->New(@decoder_session);
			array_args[4] := ByteArrayRef->New(image_bytes);
			array_args[5] := IntArrayRef->New(prefix_tokens);
			array_args[6] := IntArrayRef->New(suffix_tokens);
			array_args[7] := IntRef->New(max_tokens);
			array_args[8] := FloatRef->New(temperature);
			array_args[9] := IntArrayRef->New(eos_tokens);

			if(@fn_onnx_phi3_vision_inf = Nil) { @fn_onnx_phi3_vision_inf := "onnx_phi3_vision_inf"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_phi3_vision_inf, array_args);

			return array_args[0]->As(API.Onnx.Phi3Result);
		}
	}

	#~
	OpenPose keypoint result with normalized coordinates and confidence.
	Undetected keypoints have normalized coordinates of -1.
	~#
	class OpenPoseClassification {
		@id : OpenPoseClassification->Type;
		@name : String;
		@norm_x : Float;
		@norm_y : Float;
		@confidence : Float;

		enum Type {
			NOSE, 
			LEFT_EYE,
			RIGHT_EYE,
			LEFT_EAR,
			RIGHT_EAR,
			LEFT_SHOULDER,
			RIGHT_SHOULDER,
			LEFT_ELBOW,
			RIGHT_ELBOW,
			LEFT_WRIST,
			RIGHT_WRIST,
			LEFT_HIP,
			RIGHT_HIP,
			LEFT_KNEE,
			RIGHT_KNEE,
			LEFT_ANKLE,
			RIGHT_ANKLE
		}

		New : private () {
		}

		#~
		Get classification ID
		@return classification ID
		~#
		method : public : GetId() ~ OpenPoseClassification->Type {
			return @id;
		}

		#~
		Get classification name
		@return classification name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Get classification confidence
		@return classification confidence
		~#
		method : public : GetConfidence() ~ Float {
			return @confidence;
		}

		#~
		Get normalized X-coordinate 
		@return normalized X-coordinate
		~#
		method : public : GetNormalizedX() ~ Float {
			return @norm_x;
		}

		#~
		Get normalized y-coordinate 
		@return normalized y-coordinate
		~#
		method : public : GetNormalizedY() ~ Float {
			return @norm_y;
		}

		#~
		JSON representation 
		@return JSON representation 
		~#
		method : public : ToJson() ~ JsonElement {
			elem_json := JsonElement->New(JsonElement->JsonType->OBJECT);

			id := @id->As(Int);
			elem_json->Insert("id", id);
			elem_json->Insert("name", @name);
			elem_json->Insert("confidence", @confidence);

			norms_json := JsonElement->New(JsonElement->JsonType->ARRAY);
			norms_json->Add(@norm_x);
			norms_json->Add(@norm_y);

			return elem_json;
		}

		#~
		Get string representation
		@return string representation
		~#
		method : public : ToString() ~ String {
			id := @id->As(Int);
			name := @name <> Nil ? @name : "<unknown>";

			return "[id={$id}, name={$name}, normalized=[{$@norm_x},{$@norm_y}], confidence={$@confidence}]";
		}
	}

	#~
	Collection of face detections returned by FaceSession->Detect().
	Mirrors the OpenPoseResult pattern - C++ fills the detections field directly.
	~#
	class FaceDetectionResult {
		@detections : FaceDetection[];

		New : private() {}

		#~
		Array of detected faces (bounding boxes + landmarks).
		@return face detection array
		~#
		method : public : GetDetections() ~ FaceDetection[] {
			return @detections;
		}

		#~
		Number of detected faces.
		@return face count
		~#
		method : public : GetSize() ~ Int {
			if(@detections = Nil) { return 0; };
			return @detections->Size();
		}
	}

	#~
	Collection of face recognition results returned by FaceSession->Recognize().
	Each entry contains a FaceDetection plus a 512-dim ArcFace embedding.
	~#
	class FaceRecognitionResult {
		@results : FaceResult[];

		New : private() {}

		#~
		Array of face results (detection + embedding).
		@return face result array
		~#
		method : public : GetResults() ~ FaceResult[] {
			return @results;
		}

		#~
		Number of recognised faces.
		@return face count
		~#
		method : public : GetSize() ~ Int {
			if(@results = Nil) { return 0; };
			return @results->Size();
		}
	}

	#~
	Single face detection result from SCRFD, containing the bounding box,
	confidence score, and five facial landmarks.
	~#
	class FaceDetection {
		@score : Float;
		@bounds : Rect;
		@landmarks : Float[];

		New : private() {}

		#~
		Detection confidence score [0, 1].
		@return confidence score
		~#
		method : public : GetScore() ~ Float {
			return @score;
		}

		#~
		Bounding box in original image coordinates.
		@return bounding rectangle
		~#
		method : public : GetBounds() ~ Rect {
			return @bounds;
		}

		#~
		Five facial landmarks as flat array [x0,y0, x1,y1, x2,y2, x3,y3, x4,y4]:
		left-eye, right-eye, nose, left-mouth, right-mouth.
		@return landmark array (10 floats)
		~#
		method : public : GetLandmarks() ~ Float[] {
			return @landmarks;
		}

		#~
		String representation
		@return string representation
		~#
		method : public : ToString() ~ String {
			x := @bounds->GetX(); y := @bounds->GetY();
			w := @bounds->GetWidth(); h := @bounds->GetHeight();
			return "score={$@score}, bounds=[{$x},{$y},{$w},{$h}]";
		}
	}

	#~
	Face recognition result: detection plus 512-dim ArcFace embedding.
	Use FaceSession->Compare() to measure similarity between two embeddings.
	~#
	class FaceResult {
		@detection : FaceDetection;
		@embedding : Float[];

		New : private() {}

		#~
		The face detection (bounding box + landmarks).
		@return face detection
		~#
		method : public : GetDetection() ~ FaceDetection {
			return @detection;
		}

		#~
		L2-normalised 512-dimensional ArcFace embedding.
		@return embedding array (512 floats)
		~#
		method : public : GetEmbedding() ~ Float[] {
			return @embedding;
		}

		#~
		String representation
		@return string representation
		~#
		method : public : ToString() ~ String {
			det_str := @detection <> Nil ? @detection->ToString() : "nil";
			emb_size := @embedding <> Nil ? @embedding->Size() : 0;
			return "detection=[{$det_str}], embedding-size={$emb_size}";
		}
	}

	#~
	Face recognition session wrapping an SCRFD detector and an ArcFace recognizer.
	Detect() returns bounding boxes and landmarks; Recognize() additionally extracts
	512-dim embeddings for identity comparison via Compare().

	```
	session := FaceSession->New("det_10g.onnx", "w600k_r50.onnx");

	r1 := session->Recognize(image1_bytes, 0.5);
	r2 := session->Recognize(image2_bytes, 0.5);

	if(r1->GetSize() > 0 & r2->GetSize() > 0) {
	  faces1 := r1->GetResults();
	  faces2 := r2->GetResults();
	  sim := FaceSession->Compare(faces1[0]->GetEmbedding(), faces2[0]->GetEmbedding());
	  "Similarity: {$sim}"->PrintLine();   # >0.35 = same person
	};
	session->Close();
	```
	~#
	class FaceSession {
		# Native entry-point names, held rather than written at each call
		# site: a string literal is materialised into a fresh String every
		# time it is evaluated, which on a hot path is an allocation and a
		# copy per call. Static because these are class-wide constants and a
		# static function cannot read an instance field.
		@fn_onnx_close_session : static : String;
		@fn_onnx_face_detect_inf : static : String;
		@fn_onnx_face_recognize_inf : static : String;
		@fn_onnx_new_session : static : String;
		@det_session : Int;
		@rec_session : Int;

		#~
		Constructor - detection only (no recognizer loaded).
		@param det_model path to SCRFD detector ONNX model (e.g. det_10g.onnx)
		~#
		New(det_model : String) {
			Init(det_model, Nil, Nil);
		}

		#~
		Constructor - detection + recognition.
		@param det_model path to SCRFD detector ONNX model (e.g. det_10g.onnx)
		@param rec_model path to ArcFace recognizer ONNX model (e.g. w600k_r50.onnx)
		~#
		New(det_model : String, rec_model : String) {
			Init(det_model, rec_model, Nil);
		}

		#~
		Constructor with configuration options.
		@param det_model path to SCRFD detector ONNX model
		@param rec_model path to ArcFace recognizer ONNX model
		@param config key/value execution-provider options (e.g. "ep"->"cpu")
		~#
		New(det_model : String, rec_model : String, config : Map<String, String>) {
			Init(det_model, rec_model, config);
		}

		method : Init(det_model : String, rec_model : String, config : Map<String, String>) ~ Nil {
			keys := Vector->New()<String>;
			values := Vector->New()<String>;

			if(config <> Nil) {
				key_values := config->GetKeyValues()<Pair<String, String>>;
				each(key_value in key_values) {
					keys->AddBack(key_value->GetFirst());
					values->AddBack(key_value->GetSecond());
				};
			};

			keys_array := keys->ToArray();
			values_array := values->ToArray();

			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := StringArrayRef->New(keys_array);
			array_args[2] := StringArrayRef->New(values_array);
			array_args[3] := det_model;
			if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
			@det_session := array_args[0]->As(IntRef)->Get();

			if(rec_model <> Nil) {
				array_args := Base->New[4];
				array_args[0] := IntRef->New();
				array_args[1] := StringArrayRef->New(keys_array);
				array_args[2] := StringArrayRef->New(values_array);
				array_args[3] := rec_model;
				if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
				Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
				@rec_session := array_args[0]->As(IntRef)->Get();
			};
		}

		#~
		Closes all loaded sessions and releases resources.
		~#
		#~
		Whether the model loaded.
		
		A session that failed to open is not an error at construction -- the
		constructor returns an object either way, and the reason was written to
		stderr while it happened. Test this before inferring: a closed session
		returns Nil from every inference method, which is otherwise
		indistinguishable from a model that found nothing.
		@return true when the model is loaded and inference can run
		~#

		method : public : IsOpen() ~ Bool {
			return @det_session <> 0;
		}

		#~
		Whether a recognizer model loaded.
		
		Separate from IsOpen because the recognizer is optional: the
		detection-only constructor leaves it unset by design, so a false here
		is not necessarily a failure.
		@return true when a recognizer is loaded and Recognize can run
		~#
		method : public : IsRecognizerOpen() ~ Bool {
			return @rec_session <> 0;
		}

		method : public : Close() ~ Nil {
			# Zeroing the handle is what makes this idempotent. close_session deletes
			# the Ort::Session and nulls its own LOCAL copy, which the caller never
			# sees, so a handle left here is a pointer to freed memory: a second Close
			# used to be a double free (0xC0000374 / 0xC0000005) and IsOpen() reported
			# true forever after -- which #1028 made the documented way to tell a live
			# session from a dead one. #1046.
			if(@det_session = 0 & @rec_session = 0) {
				return;
			};
			array_args := Base->New[1];

			array_args[0] := IntRef->New(@det_session);
			if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
			@det_session := 0;

			if(@rec_session <> 0) {
				array_args[0] := IntRef->New(@rec_session);
				if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
				Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
				@rec_session := 0;
			};
		}

		#~
		Detect all faces in an image.
		@param image raw image bytes (JPEG/PNG)
		@param conf_threshold detection confidence threshold [0, 1]
		@return array of FaceDetection results

```
session := FaceSession->New("det_10g.onnx");
image := FileReader->ReadBinaryFile("group.jpg");
result := session->Detect(image, 0.5);
"Faces found: {$result->GetSize()}"->PrintLine();
session->Close();
```
		~#
		method : public : Detect(image : Byte[], conf_threshold : Float) ~ FaceDetectionResult {
			if(image = Nil) {
				return Nil;
			};

			array_args := Base->New[4];
			array_args[0] := Nil;
			array_args[1] := IntRef->New(@det_session);
			array_args[2] := ByteArrayRef->New(image);
			array_args[3] := FloatRef->New(conf_threshold);

			if(@fn_onnx_face_detect_inf = Nil) { @fn_onnx_face_detect_inf := "onnx_face_detect_inf"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_face_detect_inf, array_args);

			return array_args[0]->As(FaceDetectionResult);
		}

		#~
		Detect faces and extract ArcFace embeddings for each.
		Requires the recognizer model to have been loaded.
		@param image raw image bytes (JPEG/PNG)
		@param conf_threshold detection confidence threshold [0, 1]
		@return array of FaceResult (detection + 512-dim embedding)

```
session := FaceSession->New("det_10g.onnx", "w600k_r50.onnx");
image := FileReader->ReadBinaryFile("portrait.jpg");
result := session->Recognize(image, 0.5);
each(face in result->GetResults()) {
  "Face score: {$face->GetDetection()->GetScore()}"->PrintLine();
};
session->Close();
```
		~#
		method : public : Recognize(image : Byte[], conf_threshold : Float) ~ FaceRecognitionResult {
			if(image = Nil | @rec_session = 0) {
				return Nil;
			};

			array_args := Base->New[5];
			array_args[0] := Nil;
			array_args[1] := IntRef->New(@det_session);
			array_args[2] := IntRef->New(@rec_session);
			array_args[3] := ByteArrayRef->New(image);
			array_args[4] := FloatRef->New(conf_threshold);

			if(@fn_onnx_face_recognize_inf = Nil) { @fn_onnx_face_recognize_inf := "onnx_face_recognize_inf"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_face_recognize_inf, array_args);

			return array_args[0]->As(FaceRecognitionResult);
		}

		#~
		Compute cosine similarity between two L2-normalised ArcFace embeddings.
		Returns a value in [-1, 1]; typically >0.35 indicates the same person.
		@param emb1 first embedding (512 floats)
		@param emb2 second embedding (512 floats)
		@return cosine similarity score

```
r1 := session->Recognize(image1, 0.5);
r2 := session->Recognize(image2, 0.5);
sim := FaceSession->Compare(r1->GetResults()[0]->GetEmbedding(), r2->GetResults()[0]->GetEmbedding());
"Same person? {$sim > 0.35}"->PrintLine();
```
		~#
		function : Compare(emb1 : Float[], emb2 : Float[]) ~ Float {
			if(emb1 = Nil | emb2 = Nil | emb1->Size() <> emb2->Size()) {
				return 0.0;
			};

			dot := 0.0;
			for(i := 0; i < emb1->Size(); i += 1;) {
				dot += emb1[i] * emb2[i];
			};
			return dot;
		}
	}



	#~
	What a model takes in and gives back.

	Worth reading once before building inputs. The alternative is guessing at
	names and shapes, and a mismatch is reported by the runtime in terms of the
	graph rather than of anything the caller wrote.

	```
	session := Session->New("model.onnx");
	info := session->GetModelInfo();
	each(spec in info->GetInputs()) {
	  spec->ToString()->PrintLine();
	};
	```
	~#
	class ModelInfo {
		# Field order is the native layout (onnx_model_info); do not reorder.
		@input_names : String[];
		@input_types : String[];
		@input_ranks : Int[];
		@input_dims : Int[];
		@output_names : String[];
		@output_types : String[];
		@output_ranks : Int[];
		@output_dims : Int[];

		New : private () {}

		#~
		The model's inputs, in the order the graph declares them.
		@return input specifications
		~#
		method : public : GetInputs() ~ Vector<TensorSpec> {
			return Unflatten(@input_names, @input_types, @input_ranks, @input_dims);
		}

		#~
		The model's outputs, in the order the graph declares them.
		@return output specifications
		~#
		method : public : GetOutputs() ~ Vector<TensorSpec> {
			return Unflatten(@output_names, @output_types, @output_ranks, @output_dims);
		}

		#~
		Input names, for a run that names a subset.
		@return input names
		~#
		method : public : GetInputNames() ~ String[] {
			return @input_names;
		}

		#~
		Output names, for a run that asks for a subset.
		@return output names
		~#
		method : public : GetOutputNames() ~ String[] {
			return @output_names;
		}

		#~
		One input or output by name, whichever side it is on.
		@param name the tensor name
		@return the specification, or Nil when the model has no such tensor
		~#
		method : public : Find(name : String) ~ TensorSpec {
			specs := GetInputs();
			each(spec in specs) {
				if(spec->GetName()->Equals(name)) {
					return spec;
				};
			};

			specs := GetOutputs();
			each(spec in specs) {
				if(spec->GetName()->Equals(name)) {
					return spec;
				};
			};

			return Nil;
		}

		# The native side sends four parallel arrays with the dimensions
		# concatenated, which is one crossing instead of one per tensor. Splitting
		# them back apart is this method, in one place.
		method : Unflatten(names : String[], types : String[], ranks : Int[], dims : Int[]) ~ Vector<TensorSpec> {
			specs := Vector->New()<TensorSpec>;
			if(names = Nil | types = Nil | ranks = Nil | dims = Nil) {
				return specs;
			};

			at := 0;
			for(i := 0; i < ranks->Size(); i += 1;) {
				rank := ranks[i];
				shape := Int->New[rank];
				for(d := 0; d < rank; d += 1;) {
					shape[d] := dims[at];
					at += 1;
				};

				specs->AddBack(TensorSpec->New(names[i], types[i], shape));
			};

			return specs;
		}

		method : public : ToString() ~ String {
			text := "inputs:";
			# a typed local, not each(... in GetInputs()): the element type of a
			# Vector returned straight from a call does not resolve
			specs := GetInputs();
			each(spec in specs) {
				line := spec->ToString();
				text += "\n  {$line}";
			};
			text += "\noutputs:";
			specs := GetOutputs();
			each(spec in specs) {
				line := spec->ToString();
				text += "\n  {$line}";
			};

			return text;
		}
	}

	#~
	The tensors a run produced.

	`Session->Run` returns these as a Vector<Tensor> and most callers want that.
	This is the same data before it is split apart, for a caller that would rather
	read one output out of many without building objects for the rest.
	~#
	class RunResult {
		# Field order is the native layout (onnx_run); do not reorder.
		@names : String[];
		@types : String[];
		@ranks : Int[];
		@dims : Int[];
		@data : Float[];

		New : private () {}

		#~
		How many tensors the run produced.
		@return output count
		~#
		method : public : GetCount() ~ Int {
			if(@ranks = Nil) {
				return 0;
			};

			return @ranks->Size();
		}

		#~
		Output names, in the order they were produced.
		@return names
		~#
		method : public : GetNames() ~ String[] {
			return @names;
		}

		#~
		Every output as a tensor.
		@return output tensors
		~#
		method : public : GetTensors() ~ Vector<Tensor> {
			tensors := Vector->New()<Tensor>;
			if(@names = Nil | @types = Nil | @ranks = Nil | @dims = Nil | @data = Nil) {
				return tensors;
			};

			dim_at := 0;
			data_at := 0;
			for(i := 0; i < @ranks->Size(); i += 1;) {
				rank := @ranks[i];
				shape := Int->New[rank];
				elements := 1;
				for(d := 0; d < rank; d += 1;) {
					shape[d] := @dims[dim_at];
					elements *= @dims[dim_at];
					dim_at += 1;
				};

				values := Float->New[elements];
				for(e := 0; e < elements; e += 1;) {
					values[e] := @data[data_at];
					data_at += 1;
				};

				tensors->AddBack(Tensor->New(@names[i], @types[i], shape, values));
			};

			return tensors;
		}

		#~
		One output by name.
		@param name the output name
		@return the tensor, or Nil when the run produced no such output
		~#
		method : public : Get(name : String) ~ Tensor {
			tensors := GetTensors();
			each(tensor in tensors) {
				if(tensor->GetName()->Equals(name)) {
					return tensor;
				};
			};

			return Nil;
		}
	}

	#~
	A model session that runs any ONNX graph, without knowing what family it
	belongs to.

	The seven session classes above each own one model family: they letterbox or
	normalise an image, run it, and decode the result into YOloResult,
	ResNetResult and the rest. Use them when they fit -- they are less work and
	they are what the examples use.

	Use this one when they do not: a model with several inputs, a model whose
	outputs you want to decode yourself, a text or audio model, or anything the
	eight families do not cover. Preprocessing and decoding are then yours to
	write, in Objeck, where they can be reused rather than added to the native
	library as a ninth vertical (docs/INFERENCE_ENGINES_PLAN.md).

	```
	session := Session->New("model.onnx");
	if(<>session->IsOpen()) {
	  return;
	};

	inputs := Vector->New()<Tensor>;
	inputs->AddBack(Tensor->New("data", [1, 3, 224, 224], pixels));

	outputs := session->Run(inputs);
	each(tensor in outputs) {
	  tensor->ToString()->PrintLine();
	};
	session->Close();
	```
	~#
	class Session {
		# Native entry-point names, held rather than written at each call site: a
		# string literal is materialised into a fresh String every time it is
		# evaluated, which on a hot path is an allocation and a copy per call.
		@fn_onnx_new_session : static : String;
		@fn_onnx_close_session : static : String;
		@fn_onnx_model_info : static : String;
		@fn_onnx_run : static : String;
		@session : Int;
		@info : ModelInfo;

		#~
		Constructor.
		@param model model path
		~#
		New(model : String) {
			Init(model, Nil);
		}

		#~
		Constructor.
		@param model model path
		@param config session configuration parameters, e.g. ep
		~#
		New(model : String, config : Map<String, String>) {
			Init(model, config);
		}

		method : Init(model : String, config : Map<String, String>) ~ Nil {
			keys := Vector->New()<String>;
			values := Vector->New()<String>;

			if(config <> Nil) {
				key_values := config->GetKeyValues()<Pair<String, String>>;
				each(key_value in key_values) {
					keys->AddBack(key_value->GetFirst());
					values->AddBack(key_value->GetSecond());
				};
			};

			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := StringArrayRef->New(keys->ToArray());
			array_args[2] := StringArrayRef->New(values->ToArray());
			array_args[3] := model;

			if(@fn_onnx_new_session = Nil) { @fn_onnx_new_session := "onnx_new_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_new_session, array_args);
			@session := array_args[0]->As(IntRef)->Get();
		}

		#~
		Whether the model loaded.

		A session that failed to open is not an error at construction -- the
		constructor returns an object either way, and the reason was written to
		stderr while it happened. Test this before running: a closed session
		returns Nil from Run, which is otherwise indistinguishable from a model
		that produced nothing.
		@return true when the model is loaded and a run can proceed
		~#
		method : public : IsOpen() ~ Bool {
			return @session <> 0;
		}

		#~
		Releases the model.

		Zeroing the handle afterwards is what makes a second Close safe and makes
		IsOpen report the truth from then on.
		~#
		method : public : Close() ~ Nil {
			if(@session = 0) {
				return;
			};

			array_args := Base->New[1];
			array_args[0] := IntRef->New(@session);

			if(@fn_onnx_close_session = Nil) { @fn_onnx_close_session := "onnx_close_session"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_close_session, array_args);
			@session := 0;
		}

		#~
		What the model takes in and gives back. Read once and cached: a model's
		signature does not change under us.
		@return the signature, or Nil when the session is not open
		~#
		method : public : GetModelInfo() ~ ModelInfo {
			if(@info <> Nil) {
				return @info;
			};
			if(@session = 0) {
				return Nil;
			};

			array_args := Base->New[2];
			array_args[0] := Nil;
			array_args[1] := IntRef->New(@session);

			if(@fn_onnx_model_info = Nil) { @fn_onnx_model_info := "onnx_model_info"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_model_info, array_args);

			@info := array_args[0]->As(API.Onnx.ModelInfo);
			return @info;
		}

		#~
		Runs the model, asking for every output it has.
		@param inputs the model's inputs as named tensors
		@return the outputs, or Nil when the run was refused
		~#
		method : public : Run(inputs : Vector<Tensor>) ~ Vector<Tensor> {
			every_output := String->New[0];
			return Run(inputs, every_output);
		}

		#~
		Runs the model for named outputs.
		@param inputs the model's inputs as named tensors
		@param output_names the outputs wanted; empty for all of them
		@return the outputs, or Nil when the run was refused
		~#
		method : public : Run(inputs : Vector<Tensor>, output_names : String[]) ~ Vector<Tensor> {
			result := RunTensors(inputs, output_names);
			if(result = Nil) {
				return Nil;
			};

			return result->GetTensors();
		}

		#~
		Runs the model and returns the result before it is split into tensors, for
		a caller reading one output out of many.
		@param inputs the model's inputs as named tensors
		@param output_names the outputs wanted; empty or Nil for all of them
		@return the raw result, or Nil when the run was refused
		~#
		method : public : RunTensors(inputs : Vector<Tensor>, output_names : String[]) ~ RunResult {
			# The caller's own arguments first, the session second. The two are
			# independent problems and either order reports both, so the order is
			# chosen for a reason that is not arbitrary: argument validation is then
			# reachable without a live session, and so testable by a suite that ships
			# no model. Checking the session first made every such assertion pass for
			# the wrong reason.
			if(inputs = Nil | inputs->Size() = 0) {
				">>> ONNX: a run needs at least one input tensor. <<<"->ErrorLine();
				return Nil;
			};

			count := inputs->Size();
			names := String->New[count];
			ranks := Int->New[count];

			# Two passes: size the flat arrays, then fill them. One crossing with
			# four arrays beats one crossing per tensor, and the shapes have to be
			# summed before anything can be allocated anyway.
			dim_total := 0;
			data_total := 0;
			for(i := 0; i < count; i += 1;) {
				tensor := inputs->Get(i);
				if(tensor = Nil) {
					">>> ONNX: input tensor {$i} is Nil. <<<"->ErrorLine();
					return Nil;
				};

				shape := tensor->GetShape();
				if(shape = Nil | shape->Size() = 0) {
					name := tensor->GetName();
					">>> ONNX: input tensor '{$name}' has no shape. <<<"->ErrorLine();
					return Nil;
				};

				# Checked here as well as natively, because only here can the
				# message name the tensor the caller built.
				if(<>tensor->IsConsistent()) {
					name := tensor->GetName();
					held := tensor->GetCount();
					wanted := tensor->GetShapeProduct();
					">>> ONNX: input tensor '{$name}' holds {$held} element(s) but its shape calls for {$wanted}. <<<"->ErrorLine();
					return Nil;
				};

				names[i] := tensor->GetName();
				ranks[i] := shape->Size();
				dim_total += shape->Size();
				data_total += tensor->GetCount();
			};

			dims := Int->New[dim_total];
			data := Float->New[data_total];

			dim_at := 0;
			data_at := 0;
			for(i := 0; i < count; i += 1;) {
				tensor := inputs->Get(i);
				shape := tensor->GetShape();
				for(d := 0; d < shape->Size(); d += 1;) {
					dims[dim_at] := shape[d];
					dim_at += 1;
				};

				# AsFloats, not GetFloats: an integer tensor is stored as integers and
				# only this crossing needs floats. The conversion refuses past 2^53
				# rather than rounding, and returns Nil when it does.
				values := tensor->AsFloats();
				if(values = Nil) {
					name := tensor->GetName();
					EndPoint->SetLastError("input tensor '{$name}' holds a value no Float can carry");
					return Nil;
				};
				for(e := 0; e < values->Size(); e += 1;) {
					data[data_at] := values[e];
					data_at += 1;
				};
			};

			wanted := output_names;
			if(wanted = Nil) {
				wanted := String->New[0];
			};

			if(@session = 0) {
				">>> ONNX: run on a session that is not open. <<<"->ErrorLine();
				return Nil;
			};

			array_args := Base->New[7];
			array_args[0] := Nil;
			array_args[1] := IntRef->New(@session);
			array_args[2] := StringArrayRef->New(names);
			array_args[3] := IntArrayRef->New(ranks);
			array_args[4] := IntArrayRef->New(dims);
			array_args[5] := FloatArrayRef->New(data);
			array_args[6] := StringArrayRef->New(wanted);

			if(@fn_onnx_run = Nil) { @fn_onnx_run := "onnx_run"; };
			Proxy->GetDllProxy()->CallFunction(@fn_onnx_run, array_args);

			# Nil here is a refusal the native side has already explained on
			# stderr, not an empty result. It writes this slot on every exit, so
			# this does not depend on how the slot was initialised (#1028).
			return array_args[0]->As(API.Onnx.RunResult);
		}
	}
	#~
	API.Onnx as an Engine: a model run in-process.
	
	A thin wrapper over Session, which is the whole reason the generic run came
	first -- without onnx_run there was nothing for an Engine to call, and the
	eight per-family entry points could not supply one.
	
	Use it when calling code should not choose a backend at every call site.
	Session itself is the better choice when the code is ONNX-specific anyway:
	GetModelInfo has no equivalent on a remote engine, so it is not on the
	interface, and this class exposes the Session for that reason.
	
	```
	engine := OnnxEngine->New("model.onnx");
	if(<>engine->IsOpen()) {
	  EndPoint->GetLastError()->PrintLine();
	  return;
	};
	
	outputs := engine->Run(inputs);
	engine->Close();
	```
	~#
	class OnnxEngine implements API.Models.Engine {
		@session : Session;

		#~
		Constructor.
		@param model model path
		~#
		New(model : String) {
			@session := Session->New(model);
		}

		#~
		Constructor.
		@param model model path
		@param config session configuration parameters, e.g. ep
		~#
		New(model : String, config : Map<String, String>) {
			@session := Session->New(model, config);
		}

		#~
		Runs the model, asking for every output it has.
		@param inputs the model's inputs as named tensors
		@return the outputs, or Nil when the run was refused
		~#
		method : public : Run(inputs : Vector<Tensor>) ~ Vector<Tensor> {
			return @session->Run(inputs);
		}

		#~
		Whether the model loaded.
		@return true when a run can proceed
		~#
		method : public : IsOpen() ~ Bool {
			return @session->IsOpen();
		}

		#~
		Releases the model. Safe to call more than once.
		~#
		method : public : Close() ~ Nil {
			@session->Close();
		}

		#~
		The underlying session, for what the Engine interface deliberately does
		not carry -- GetModelInfo above all, which has no remote equivalent.
		@return the session
		~#
		method : public : GetSession() ~ Session {
			return @session;
		}
	}
}
