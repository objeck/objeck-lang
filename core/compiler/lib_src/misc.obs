use Web.HTTP, Collection, Data.JSON, System.Time, System.IO.Filesystem;

#~
Date string parsing and formatting (DateUtility) and network time retrieval. Date and Timer are in lang.obl; this bundle is built as misc.obl, so compile with -lib misc.
~#
bundle System.Time {
	#~
	Utilities for handling dates

```
date := DateUtility->Parse("12/25/2024", "MM/dd/yyyy", false);
date->GetMonth()->PrintLine();
date->GetDay()->PrintLine();
date->GetYear()->PrintLine();
```
	~#
	class DateUtility {
		#~
		Parses a date from a String.
		@param date_str date
		@param format date string format <p>options: <ul> <li>month=MM</li><li>day=dd</li><li>year=yy(yy)</li><li>hour=hh</li><li>minutes=mm</li><li>seconds=ss</p><ul>
		@param gmt true is GMT, false otherwise
		@return Date instance

```
date := DateUtility->Parse("06/15/2025", "MM/dd/yyyy", false);
Console->Print("Year: ")->PrintLine(date->GetYear());
Console->Print("Month: ")->PrintLine(date->GetMonth());
Console->Print("Day: ")->PrintLine(date->GetDay());
```
		~#
		function : Parse(date_str : String, format : String, gmt : Bool) ~ Date {
			parts := Map->New()<IntRef, DatePart>;

			# month
			month := format->Find("MM");
			if(month > -1) {
				parts->Insert(month, DatePart->New(month, DatePart->Type->Month));
			};

			# day
			day := format->Find("dd");
			if(day > -1) {
				parts->Insert(day, DatePart->New(day, DatePart->Type->Day));
			};

			# year
			long_year_format := true;
			year := format->Find("yyyy");
			if(year > -1) {
				parts->Insert(year, DatePart->New(year, DatePart->Type->Year));
			}
			else {
				year := format->Find("yy");
				if(year > -1) {
					parts->Insert(year, DatePart->New(year, DatePart->Type->Year));
					long_year_format := false;
				};
			};

			# hour
			hours := format->Find("hh");
			if(hours > -1) {
				parts->Insert(hours, DatePart->New(hours, DatePart->Type->Hour));
			};

			# mins
			mins := format->Find("mm");
			if(mins > -1) {
				parts->Insert(mins, DatePart->New(mins, DatePart->Type->Min));
			};

			# secs
			secs := format->Find("ss");
			if(secs > -1) {
				parts->Insert(secs, DatePart->New(secs, DatePart->Type->Sec));
			};

			date_month := 0; date_day := 0; date_year := 0;
			date_hours := 0; date_mins := 0; date_secs := 0;

			offset := 0;
			values := parts->GetValues()<DatePart>;
			each(part in values) {
				type := part->GetType();

				select(type) {
					label DatePart->Type->Month: {
						pos := month + offset + 1;
						if(pos > -1 & pos < date_str->Size()) {
							if(date_str->Get(pos)->IsDigit()) {
								date_month := date_str->SubString(month + offset, 2)->ToInt();
							}
							else {
								date_month := date_str->SubString(month + offset, 1)->ToInt();
								offset -= 1;
							};
						};
					}

					label DatePart->Type->Day: {
						pos := day + offset + 1;
						if(pos > -1 & pos < date_str->Size()) {
							if(date_str->Get(pos)->IsDigit()) {
								date_day := date_str->SubString(day + offset, 2)->ToInt();
							}
							else {
								date_day := date_str->SubString(day + offset, 1)->ToInt();
								offset -= 1;
							};
						};
					}

					label DatePart->Type->Year: {
						pos := year + offset;
						if(pos > -1 & pos < date_str->Size()) {
							if(long_year_format) {
								date_year := date_str->SubString(year + offset, 4)->ToInt();
							}
							else {
								date_year := 2000;
								date_year += date_str->SubString(year + offset, 2)->ToInt();
							};
						};
					}

					label DatePart->Type->Hour: {
						pos := hours + offset + 1;
						if(pos > -1 & pos < date_str->Size()) {
							if(date_str->Get(pos)->IsDigit()) {
								date_hours := date_str->SubString(hours + offset, 2)->ToInt();
							}
							else {
								date_hours := date_str->SubString(hours + offset, 1)->ToInt();
								offset -= 1;
							};
						};
					}

					label DatePart->Type->Min: {
						pos := mins + offset + 1;
						if(pos > -1 & pos < date_str->Size()) {
							if(date_str->Get(pos)->IsDigit()) {
								date_mins := date_str->SubString(mins + offset, 2)->ToInt();
							}
							else {
								date_mins := date_str->SubString(mins + offset, 1)->ToInt();
								offset -= 1;
							};
						};
					}

					label DatePart->Type->Sec: {
						pos := secs + offset + 1;
						if(pos > -1 & pos < date_str->Size()) {
							if(date_str->Get(pos)->IsDigit()) {
								date_secs := date_str->SubString(secs + offset, 2)->ToInt();
							}
							else {
								date_secs := date_str->SubString(secs + offset, 1)->ToInt();
								offset -= 1;
							};
						};
					}
				};
			};

			date := Date->New(date_day, date_month, date_year, gmt);
			date->AddHours(date_hours);
			date->AddMinutes(date_mins);
			date->AddSeconds(date_secs);

			return date;
		}

		#~
		Formats date into a string
		@param date date
		@param format date string format <p>options: <ul> <li>month=MM</li><li>day=dd</li><li>year=yy(yy)</li><li>hour=hh</li><li>minutes=mm</li><li>seconds=ss</p><ul>
		@return Date instance

```
date := DateUtility->Parse("01/20/2025", "MM/dd/yyyy", false);
formatted := DateUtility->Format(date, "dd-MM-yyyy");
formatted->PrintLine();
```
		~#
		function : Format(date : System.Time.Date, format : String) ~ String {
			day := date->GetDay();
			hours := date->GetHours();
			mins := date->GetMinutes();
			mon := date->GetMonth();
			secs := date->GetSeconds();
			year := date->GetYear();

			buffer := "";

			for(i := 0; i < format->Size(); i += 1;) {
				cur_char := format->Get(i);
				next_char := '\0';
				if(i + 1 < format->Size()) {
					next_char := format->Get(i + 1);
				};

				# day
				if(cur_char = 'd' & next_char = 'd') {
					AppendTwoDigits(buffer, day);
					i += 1;
				}
				# month
				else if(cur_char = 'M' & next_char = 'M') {
					AppendTwoDigits(buffer, mon);
					i += 1;
				}
				# year
				else if(cur_char = 'y' & next_char = 'y') {
					if(i + 3 < format->Size() & format->Get(i + 2) = 'y' & format->Get(i + 3) = 'y') {
						next_char := format->Get(i + 1);
						i += 3;
						buffer->Append(year);
					}
					else {
						i += 1;
						AppendTwoDigits(buffer, year % 100);
					};
				}
				# hours
				else if(cur_char = 'h' & next_char = 'h') {
					AppendTwoDigits(buffer, hours);
					i += 1;
				}
				# minutes
				else if(cur_char = 'm' & next_char = 'm') {
					AppendTwoDigits(buffer, mins);
					i += 1;
				}
				# seconds
				else if(cur_char = 's' & next_char = 's') {
					AppendTwoDigits(buffer, secs);
					i += 1;
				}
				# other
				else {
					buffer->Append(cur_char);
				}
			};

			return buffer;
		}

		# a two-digit field, zero padded: Format wrote 7 for 'MM' where July is 07
		# (#1179)
		function : AppendTwoDigits(buffer : String, value : Int) ~ Nil {
			if(value < 10) {
				buffer->Append('0');
			};
			buffer->Append(value);
		}

		#~
		Get the network time
		@return triplet with: unix time, UTC time and local time

```
triplet := DateUtility->GetNetworkTime();
if(triplet <> Nil) {
  utc := triplet->GetSecond();
  Console->Print("UTC year: ")->PrintLine(utc->GetYear());
};
```
		~#
		function : GetNetworkTime() ~ Collection.Tuple.Triplet<IntRef, Date, Date> {
			response := HttpClient->QuickGet(Url->New("http://worldtimeapi.org/api/ip"));
			if(response <> Nil & response->GetCode() = 200 & response->GetContent() <> Nil) {
				response_json := JsonParser->TextToElement(response->GetContent()->ToString());
				if(response_json <> Nil) {
					unix_time_json := response_json->Get("unixtime");
					utc_time_json := response_json->Get("utc_datetime");
					dst_time_json := response_json->Get("datetime");
					if(unix_time_json <> Nil & utc_time_json <> Nil & dst_time_json <> Nil) {
						utc_date := System.Time.DateUtility->Parse(utc_time_json->GetString(), "yyyy-MM-ddThh:mm:ss", false);
						dst_date := System.Time.DateUtility->Parse(dst_time_json->GetString(), "yyyy-MM-ddThh:mm:ss", false);

						return Collection.Tuple.Triplet->New(IntRef->New(unix_time_json->GetInt()), utc_date, dst_date)<IntRef, Date, Date>;
					};
				};
			};

			return Nil;
		}
	}

	class : private : DatePart {
		@index : Int;
		@type : Type;

		#~
		Which field of a date a part of a DateUtility format string reads.
		~#
		enum Type {
			#~
			MM
			~#
			Month,
			#~
			dd
			~#
			Day,
			#~
			yy or yyyy
			~#
			Year,
			#~
			hh
			~#
			Hour,
			#~
			mm
			~#
			Min,
			#~
			ss
			~#
			Sec
		}

		New(index : Int, type : Type) {
			@index := index;
			@type := type;
		}

		method : public : GetType() ~ Type {
			return @type;
		}

		method : public : GetIndex() ~ Int {
			return @index;
		}
	}
}

#~
Miscellaneous utilities: a string tokenizer (Parser), a console spinner (Spinner) and a source code formatter (CodeFormatter). Built as misc.obl, not part of lang.obl: compile with -lib misc.
~#
bundle System.Utility {
	#~
	Utilities for parsing
	~#
	class Parser {
		#~
		Simple tokenizer
		@param stream_in source input
		@return vector of string tokens

```
tokens := Parser->Tokenize("foo + bar * 42");
each(tok := tokens) {
  tok->PrintLine();
};
```
		~#
		function : Tokenize(stream_in : String) ~ Vector<String> {
			tokens := Vector->New()<String>;

			each(i : stream_in) {
				# identifier
				if(stream_in->Get(i)->IsChar()) {
					start := i;
					while(stream_in->Get(i)->IsChar() | stream_in->Get(i)->IsDigit() | stream_in->Get(i) = '_') {
						i += 1;
					};
					tokens->AddBack(stream_in->SubString(start, i - start));
					i -= 1;
				}
				# number
				else if(stream_in->Get(i)->IsDigit()) {
					start := i;
					while(stream_in->Get(i)->IsDigit() | stream_in->Get(i) = '.') {
						i += 1;
					};
					tokens->AddBack(stream_in->SubString(start, i - start));
					i -= 1;
				}
				# other
				else {
					value := stream_in->Get(i);
					if(value <> ' ' & value <> '\t' & value <> '\r' & value <> '\n') {
						tokens->AddBack(value->ToString());
					};
				};
			};

			return tokens;
		}

		#~
		Command line parser
		@param args command line arguments
		@return name/value pairs

```
args := ["-out=report.txt", "-verbose"];
params := Parser->CommandParameters(args);
out_file := params->Find("-out");
if(out_file <> Nil) {
  out_file->PrintLine();
};
```
		~#
		function : CommandParameters(args : String[]) ~ Hash<String, String> {
			params := Hash->New()<String, String>;

			each(arg := args) {
				name := "";
				value := "";

				index := arg->Find('=');
				if(index > 0) {
					name += arg->SubString(index);
					index += 1;
					value += arg->SubString(index, arg->Size() - index);
				}
				else {
					name := arg;
				};

				params->Insert(name, value);
			};

			return params;
		}
	}

	#~
	Console spinner
	~#
	class Spinner {
		@state : static : Int;
		@count : static : Int;

		#~
		Prints and advances the spinner to the next state

```
for(i := 0; i < 20; i += 1;) {
  Spinner->Next();
};
Spinner->Last();
```
		~#
		function : Next() ~ Nil {
			select(@state) {
				label 0 {
					"⋅\r"->Print();
					@state += 1;
				}

				label 1 {
					"•\r"->Print();
					@state += 1;
				}

				label 2 {
					"●\r"->Print();
					@state += 1;
				}

				label 3 {
					"⬤\r"->Print();
					@state := 0;
				}
			};

			@count += 1;
			Console->Flush();
		}

		#~
		Prints the final state

```
Spinner->Next();
Spinner->Next();
Spinner->Last();
"done"->PrintLine();
```
		~#
		function : Last() ~ Nil {
			"\r·"->Print();
			Console->Flush();
		}
	}

	# formatter:begin (written by tools/cicd/check_formatter_sync.py from tools/lsp/server/format_code; change it there)
	#~
	Code formatter. Formats Objeck source text: indentation, one statement to a line, spacing around
	operators. The text it returns has the same tokens as the text it was given, so it compiles to the
	same program; formatting its own output changes nothing.
	```
	options := Map->New()<String, String>;
	options->Insert("ident-space", "2");
	options->Insert("trim-trailing", "true");
	formatted := System.Utility.CodeFormatter->New(options)->Format(source, false);
	```
	~#
	class CodeFormatter {
		@token : Token;
		@prev_token : Token;
		@next_token : Token;
		@skip_space : Bool;

		@stmt_space : Bool;
		@ident_space : Int;

		@buffer : String;
		@start_range : Int;
		@end_range : Int;

		@trim_trailing : Bool;
		@braces : String;
		@hold_space : Bool;

		#~
		Constructor
		@param options options

		<p>Support for following options:<p>
		<ul>
		  <li>"function-space" - (true|false)</li>
		  <li>"ident-space" - (number|0 for tabs)</li>
		  <li>"trim-trailing" - (true|false)</li>
		  <li>"start-line" - (optional|number)</li>
		  <li>"end-line" - (optional|number)</li>
		</ul>
		```
		opts := Map->New()<String, String>;
		opts->Insert("ident-space", "2");
		opts->Insert("trim-trailing", "true");
		formatter := CodeFormatter->New(opts);
		```
		~#
		New(options : Map<String, String>) {
			# get options
			stmt_space_check := options->Find("function-space");
			@stmt_space := stmt_space_check <> Nil & stmt_space_check->Equals("true");

			# trim trailing
			trim_trailing_check := options->Find("trim-trailing");
			@trim_trailing := trim_trailing_check <> Nil & trim_trailing_check->Equals("true");

			@ident_space := 0;
			ident_space_check := options->Find("ident-space");
			if(ident_space_check <> Nil & <>ident_space_check->IsEmpty()) {
				@ident_space := ident_space_check->ToInt() - 1;
			};

			# get start and end range
			@start_range := -1;
			start_line_check := options->Find("start-line");
			if(start_line_check <> Nil & <>start_line_check->IsEmpty()) {
				@start_range := start_line_check->ToInt();
			};

			@end_range := -1;
			end_line_check := options->Find("end-line");
			if(end_line_check <> Nil & <>end_line_check->IsEmpty()) {
				@end_range := end_line_check->ToInt();
			};

	# "ranges: ({$@start_range},{$@end_range})"->PrintLine();

			@buffer := "";
		}

		method : AppendBuffer(str : String) ~ Nil {
			if(InRange() & str->Size() > 0) {
				if(@hold_space) {
					@hold_space := false;
				}
				else if(@buffer->EndsWith("; ") | @buffer->EndsWith("} ")) {
					@buffer->Pop();
				};

				KeepApart(str->Get(0));
				@buffer += str;
			};
		}

		method : AppendBuffer(char : Char) ~ Nil {
			if(InRange()) {
				if(@hold_space) {
					@hold_space := false;
				}
				else if(@buffer->EndsWith("; ") | @buffer->EndsWith("} ")) {
					@buffer->Pop();
				};

				KeepApart(char);
				@buffer += char;
			};
		}

		# Text that is written exactly as given: a literal or a comment, whose first
		# and last characters are its own and are never joined to or parted from.
		method : AppendVerbatim(str : String) ~ Nil {
			if(InRange()) {
				if(@hold_space) {
					@hold_space := false;
				}
				else if(@buffer->EndsWith("; ") | @buffer->EndsWith("} ")) {
					@buffer->Pop();
				};

				@buffer += str;
			};
		}

		# Two tokens written with nothing between them must still read as two. The
		# layout rules below remove the space before or after a token in many
		# places, and each one that did so without looking joined something:
		# "classB", "a<" then ">b" as "a<>b", ":" then "=" as ":=". Wherever the
		# end of the text and the start of what is added would read as one token, a
		# space goes between them, so no rule can change what a program means by
		# closing a gap.
		method : KeepApart(first : Char) ~ Nil {
			size := @buffer->Size();
			if(size = 0) {
				return;
			};

			last := @buffer->Get(size - 1);
			if(IsWordChar(last) & IsWordChar(first)) {
				@buffer += ' ';
				return;
			};

			joins := false;
			select(last) {
				label ':' { joins := first = '='; }
				label '-' { joins := first = '>' | first = '=' | first = '-'; }
				label '+' { joins := first = '=' | first = '+'; }
				label '*' { joins := first = '='; }
				label '/' { joins := first = '='; }
				label '<' { joins := first = '>' | first = '=' | first = '<'; }
				label '>' { joins := first = '=' | first = '>'; }
				label '=' { joins := first = '>' | first = '='; }
				label '!' { joins := first = '='; }
				label '&' { joins := first = '&'; }
				label '|' { joins := first = '|'; }
				label '#' { joins := first = '~'; }
				# "??"; a '?' followed by "->" is the Nil-safe call "?->", which is
				# read as those two tokens and written back joined
				label '?' { joins := first = '?'; }
				# a digit after a '.' would make the '.' part of a number
				label '.' { joins := first->IsDigit(); }
			};

			if(joins) {
				@buffer += ' ';
			};
		}

		method : IsWordChar(c : Char) ~ Bool {
			return c->IsChar() | c->IsDigit() | c = '_' | c = '@' | c = '$' | c = '.' | c->As(Int) > 127;
		}

		# Removes the space the loop writes after each token, where a rule wants the
		# next token against the one before it. Only that space: this popped whatever
		# character came last, so where no space had been written (after '(' or '[',
		# at the start of a line) it took the last character of the token before it,
		# or a character of the line's indentation.
		method : PopBuffer() ~ Nil {
			if(InRange()) {
				size := @buffer->Size();
				if(size > 1) {
					if(@buffer->Get(size - 1) = ' ') {
						before := @buffer->Get(size - 2);
						if(before <> ' ' & before <> '\t' & before <> '\n') {
							@buffer->Pop();
						};
					};
				};
			};
		}

		# Starts a line at this depth, unless the text is already at the start of
		# one: a comment ends its own line, and a second newline after it left a
		# line of nothing but indentation behind.
		method : StartLine(tab_space : Int) ~ Nil {
			TrimIndent();
			if(InRange() & @buffer->Size() > 0 & <>@buffer->EndsWith('\n')) {
				AppendVerbatim("\n");
			};
			TabSpace(tab_space, @ident_space);
		}

		# Whether the '{' at 'at' opens a map or JSON literal: its first entry is a
		# string key and a ':', or it is empty and stands where a value does.
		method : IsLiteralBrace(tokens : Vector<Token>, at : Int) ~ Bool {
			if(at + 2 < tokens->Size()) {
				if(tokens->Get(at + 1)->GetType() = System.Utility.Token->Type->STRING_LIT & tokens->Get(at + 2)->GetType() = System.Utility.Token->Type->COLON) {
					return true;
				};
			};

			if(at + 1 < tokens->Size() & at > 0) {
				if(tokens->Get(at + 1)->GetType() = System.Utility.Token->Type->CCBRACE) {
					select(tokens->Get(at - 1)->GetType()) {
						label System.Utility.Token->Type->ASGN
						label System.Utility.Token->Type->COMMA
						label System.Utility.Token->Type->OPREN
						label System.Utility.Token->Type->OBRACE
						label System.Utility.Token->Type->RETURN_ID {
							return true;
						}

						# an entry's value, inside a literal
						label System.Utility.Token->Type->COLON {
							return @braces->EndsWith('L');
						}
					};
				};
			};

			return false;
		}

		# Whether a token that starts a line in the source, inside a statement,
		# starts one here. The ones that do not have rules of their own for where
		# they go, as does anything after a brace or a comment.
		method : KeepsLineBreak(token : Token, before : Token) ~ Bool {
			select(token->GetType()) {
				label System.Utility.Token->Type->OCBRACE
				label System.Utility.Token->Type->CCBRACE
				label System.Utility.Token->Type->SEMI
				label System.Utility.Token->Type->ELSE_ID
				label System.Utility.Token->Type->VTAB
				label System.Utility.Token->Type->LINE_COMMENT
				label System.Utility.Token->Type->TRAIL_COMMENT
				label System.Utility.Token->Type->MULTI_COMMENT
				label System.Utility.Token->Type->INLINE_COMMENT {
					return false;
				}
			};

			select(before->GetType()) {
				label System.Utility.Token->Type->OCBRACE
				label System.Utility.Token->Type->CCBRACE
				label System.Utility.Token->Type->SEMI
				label System.Utility.Token->Type->VTAB
				label System.Utility.Token->Type->LINE_COMMENT
				label System.Utility.Token->Type->TRAIL_COMMENT
				label System.Utility.Token->Type->MULTI_COMMENT {
					return false;
				}
			};

			return true;
		}

		# whether nothing but indentation has been written on the current line
		method : AtLineStart() ~ Bool {
			for(k := @buffer->Size() - 1; k > -1; k -= 1;) {
				c := @buffer->Get(k);
				if(c = '\n') {
					return true;
				};

				if(c <> ' ' & c <> '\t') {
					return false;
				};
			};

			return true;
		}

		# removes the indentation at the end of the buffer
		method : TrimIndent() ~ Nil {
			if(InRange()) {
				while(@buffer->EndsWith(' ') | @buffer->EndsWith('\t')) {
					@buffer->Pop();
				};
			};
		}

		method : InRange() ~ Bool {
			return (@start_range < 0 & @end_range < 0) | (@token <> Nil & @start_range <= @token->GetLine() & @end_range >= @token->GetLine());
		}	

		#~
		Formats source code
		@param source source code
		@return formatted code
		```
		opts := Map->New()<String, String>;
		opts->Insert("ident-space", "3");
		formatter := CodeFormatter->New(opts);
		formatter->Format("class Foo{method:public:Bar()~Nil{x:=1;}}")->PrintLine();
		```
		~#
		method : public : Format(source : String) ~ String {
			scanner := Scanner->New(source);
			if(scanner->Scan()) {
				tab_space := 0;
				insert_tabs := false;

				@skip_space := false;
				in_label := false;
				in_for := false;
				in_consts := false;
				generic_depth := 0;
				# how many '(', '[' and literal '{' are open, and for each open '{'
				# whether it is a block ('B') or a map or JSON literal ('L')
				open_depth := 0;
				@braces := "";
				@hold_space := false;

				@prev_token := Token->New(-1, System.Utility.Token->Type->OTHER, "other");

				tokens := scanner->GetTokens();
				each(i : tokens) {
					if(insert_tabs) {
						TabSpace(tab_space, @ident_space);
						insert_tabs := false;
					};

					# set current, previous and next tokens
					if(@token <> Nil) {
						@prev_token := @token;
					};

					if(@next_token <> Nil) {
						@token := @next_token;
					}
					else {
						@token := tokens->Get(i);
					};

					if(i + 1 < tokens->Size()) {
						@next_token := tokens->Get(i + 1);
					}
					else {
						@next_token := Token->New(-1, System.Utility.Token->Type->OTHER, "other");
					};

					# A line break inside a statement is the author's and is kept: the
					# arguments of a long call, the entries of a literal, the arms of a
					# match. (Everything between two ';' used to be joined into one
					# line.) The tokens that place themselves, and whatever follows a
					# brace, are left to their own rules.
					if(@prev_token->GetLine() > -1 & @token->GetLine() > @prev_token->GetLine()) {
						if(KeepsLineBreak(@token, @prev_token) & <>AtLineStart()) {
							if(open_depth = 0 & @prev_token->GetType() = System.Utility.Token->Type->COMMA) {
								StartLine(tab_space);
							}
							else {
								StartLine(tab_space + 1);
							};
						};
					};

					select(@token->GetType()) {
						label System.Utility.Token->Type->CLASS_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("class");
							@skip_space := false;
						}

						label System.Utility.Token->Type->FUNCTION_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);

							AppendBuffer("function");
							@skip_space := false;
						}

						label System.Utility.Token->Type->METHOD_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("method");
							@skip_space := false;
						}

						label System.Utility.Token->Type->PUBLIC_ID {
							AppendBuffer("public");
						}

						label System.Utility.Token->Type->PRIVATE_ID {
							AppendBuffer("private");
						}

						label System.Utility.Token->Type->IF_ID {
							AppendBuffer("if");
						}

						label System.Utility.Token->Type->ELSE_ID {
							StartLine(tab_space);
							AppendBuffer("else");
						}					

						label System.Utility.Token->Type->DO_ID {
							AppendBuffer("do");
						}

						label System.Utility.Token->Type->WHILE_ID {
							AppendBuffer("while");
						}

						label System.Utility.Token->Type->FOR_ID {
							AppendBuffer("for");
							in_for := true;
						}

						label System.Utility.Token->Type->EACH_ID {
							AppendBuffer("each");
						}

						label System.Utility.Token->Type->BREAK_ID {
							AppendBuffer("break");
						}

						label System.Utility.Token->Type->CONTINUE_ID {
							AppendBuffer("continue");
						}

						label System.Utility.Token->Type->RETURN_ID {
							AppendBuffer("return");
						}

						label System.Utility.Token->Type->ALIAS_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("alias");
							@skip_space := false;
						}

						label System.Utility.Token->Type->LEAVING_ID {
							AppendBuffer("leaving");
						}

						label System.Utility.Token->Type->USE_ID {
							AppendBuffer("use");
						}

						label System.Utility.Token->Type->NATIVE_ID {
							AppendBuffer("native");
						}

						label System.Utility.Token->Type->STATIC_ID {
							AppendBuffer("static");
						}

						label System.Utility.Token->Type->SELECT_ID {
							AppendBuffer("select");
						}

						label System.Utility.Token->Type->LABEL_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("label");
							in_label := true;
							@skip_space := false;
						}

						label System.Utility.Token->Type->OTHER_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("other");
							in_label := true;
							@skip_space := false;
						}

						label System.Utility.Token->Type->OTHERWISE_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("otherwise");
							in_label := true;
							@skip_space := false;
						}

						label System.Utility.Token->Type->ASGN {
							AppendBuffer(":=");
						}

						label System.Utility.Token->Type->ASSESSOR {
							PopBuffer();
							AppendBuffer("->");
							@skip_space := true;
						}

						# a comment on a line of its own keeps one, also after a '(' or '['
						label System.Utility.Token->Type->LINE_COMMENT {
							if(<>AtLineStart()) {
								StartLine(tab_space);
							};
							comment := "#";
							comment += @token->GetValue();
							comment += '\n';
							AppendVerbatim(comment);
							@skip_space := insert_tabs := true;
						}

						# A comment after code on its line stays on that line. The rule for
						# the token before it may already have ended the line (a ';', a
						# '{'); that is taken back, and the line ends after the comment.
						label System.Utility.Token->Type->TRAIL_COMMENT {
							TrimIndent();
							if(@buffer->EndsWith('\n') & <>@buffer->EndsWith("\n\n")) {
								@buffer->Pop();
							};
							comment := " #";
							comment += @token->GetValue();
							comment += '\n';
							AppendVerbatim(comment);
							@skip_space := insert_tabs := true;
						}

						# A block comment on lines of its own keeps them: what follows it
						# starts a new line. (It did not, and a file's header comment came
						# back with the first 'use' on its last line.) One written inside a
						# line of code stays inside it.
						label System.Utility.Token->Type->MULTI_COMMENT {
							if(<>AtLineStart()) {
								StartLine(tab_space);
							};
							comment := "#~";
							comment += @token->GetValue();
							comment += "~#\n";
							AppendVerbatim(comment);
							@skip_space := insert_tabs := true;
						}

						label System.Utility.Token->Type->INLINE_COMMENT {
							comment := "#~";
							comment += @token->GetValue();
							comment += "~#";
							AppendVerbatim(comment);
						}

						label System.Utility.Token->Type->SEMI {
							PopBuffer();
							AppendBuffer(';');

							if(@next_token->GetType() <> System.Utility.Token->Type->CCBRACE & @next_token->GetType() <> System.Utility.Token->Type->VTAB & <>in_for) {
								AppendBuffer('\n');

								@skip_space := true;
								if(<>in_for) {
									insert_tabs := true;
								};
							};

							# "for(i := 0; i < n; i += 1;)": the parts are set apart, but
							# nothing stands between the last ';' and the ')'
							if(in_for) {
								if(@next_token->GetType() = System.Utility.Token->Type->CPREN) {
									@skip_space := true;
								}
								else {
									@hold_space := true;
								};
							};

						}

						# A '<' that opens type arguments ("Vector<String>", "New()<Int>",
						# "class Box<T : Stringify>") sits against the name before it and
						# the type after it; a comparison is spaced like any operator. It
						# was neither: every '<' lost the space after it and kept the one
						# before, "a <b" and "Vector <String >".
						label System.Utility.Token->Type->LESS {
							if(IsTypeArguments(tokens, i)) {
								PopBuffer();
								AppendBuffer('<');
								@skip_space := true;
								generic_depth += 1;
							}
							else {
								AppendBuffer('<');
							};
						}

						label System.Utility.Token->Type->GTR {
							if(generic_depth > 0) {
								PopBuffer();
							};

							# ">>" and ">>>" are written back unbroken: see the scanner
							if(@buffer->EndsWith('>') & @prev_token->GetType() = System.Utility.Token->Type->GTR & @prev_token->GetValue()->Equals("joined")) {
								AppendVerbatim(">");
							}
							else {
								AppendBuffer('>');
							};

							if(generic_depth > 0) {
								generic_depth -= 1;
							};

							if(@token->GetValue()->Equals("joined")) {
								@skip_space := true;
							};
						}

						label System.Utility.Token->Type->COMMA {
							PopBuffer();
							AppendBuffer(',');

							if(in_consts) {
								AppendBuffer('\n');
								insert_tabs := @skip_space := true;
							};
						}

						# "a <> b" is a comparison; "<>done" is 'not', against its operand
						label System.Utility.Token->Type->NEQL {
							AppendBuffer("<>");
							@skip_space := <>EndsOperand(@prev_token);
						}

						label System.Utility.Token->Type->AND {
							AppendBuffer('&');
						}

						label System.Utility.Token->Type->OR {
							AppendBuffer('|');
						}

						# "a ? b : c" is spaced; the '?' of the Nil-safe call "a?->F()" sits
						# against what it guards, and the "->" against it
						label System.Utility.Token->Type->QUESTION {
							if(@next_token->GetType() = System.Utility.Token->Type->ASSESSOR) {
								PopBuffer();
								@skip_space := true;
							};
							AppendBuffer('?');
						}

						label System.Utility.Token->Type->QUESTION_QUESTION {
							AppendBuffer("??");
						}

						label System.Utility.Token->Type->IDENT {
							if(@prev_token->GetType() = System.Utility.Token->Type->ASSESSOR | 
									@prev_token->GetType() = System.Utility.Token->Type->ADD_ADD | 
									@prev_token->GetType() = System.Utility.Token->Type->SUB_SUB) {
								PopBuffer();
							};
							value := @token->GetValue();
							AppendBuffer("{$value}");
						}

						# A literal is written in one piece. Written as a quote, the text and
						# a quote, the text went through the rule that drops the space after
						# a ';' or '}': a string that ended "; " or "} " lost its last space,
						# and the program printed something else.
						label System.Utility.Token->Type->STRING_LIT {
							literal := "\"";
							literal += @token->GetValue();
							literal += '"';
							AppendVerbatim(literal);
						}

						label System.Utility.Token->Type->CHAR_LIT {
							literal := "'";
							literal += @token->GetValue();
							literal += '\'';
							AppendVerbatim(literal);
						}

						label System.Utility.Token->Type->NUM_LIT {
							AppendBuffer(@token->GetValue());
						}

						label System.Utility.Token->Type->STRING_ID {
							AppendBuffer("String");
						}

						label System.Utility.Token->Type->INT_ID {
							AppendBuffer("Int");
						}

						label System.Utility.Token->Type->FLOAT_ID {
							AppendBuffer("Float");
						}

						label System.Utility.Token->Type->CHAR_ID {
							AppendBuffer("Char");
						}

						label System.Utility.Token->Type->BOOL_ID {
							AppendBuffer("Bool");
						}

						label System.Utility.Token->Type->BYTE_ID {
							AppendBuffer("Byte");
						}

						label System.Utility.Token->Type->NIL_ID {
							AppendBuffer("Nil");
						}

						label System.Utility.Token->Type->AND_ID {
							AppendBuffer("and");
						}

						label System.Utility.Token->Type->OR_ID {
							AppendBuffer("or");
						}

						label System.Utility.Token->Type->XOR_ID {
							AppendBuffer("xor");
						}

						label System.Utility.Token->Type->VIRTUAL_ID {
							AppendBuffer("virtual");
						}

						label System.Utility.Token->Type->BUNDLE_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("bundle");
							@skip_space := false;
						}

						label System.Utility.Token->Type->INTERFACE_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("interface");
							@skip_space := false;
						}

						label System.Utility.Token->Type->IMPLEMENTS_ID {
							AppendBuffer("implements");
						}

						label System.Utility.Token->Type->ENUM_ID {
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("enum");
							@skip_space := false;
						}

						label System.Utility.Token->Type->CONSTS_ID {
							in_consts := true;
							VerticalSpace(@prev_token, tab_space, @ident_space);
							AppendBuffer("consts");
							@skip_space := false;
						}

						label System.Utility.Token->Type->REVERSE_ID {
							AppendBuffer("reverse");
						}

						# the keyword is 'Parent'; written 'parent' it is a name, and a
						# constructor's "Parent();" came back as a call to nothing
						label System.Utility.Token->Type->PARENT_ID {
							AppendBuffer("Parent");
						}

						label System.Utility.Token->Type->FROM_ID {
							AppendBuffer("from");
						}

						label System.Utility.Token->Type->TRUE_ID {
							AppendBuffer("true");
						}

						label System.Utility.Token->Type->FALSE_ID {
							AppendBuffer("false");
						}

						label System.Utility.Token->Type->NEW_ID {
							# "->New": drop the space after the arrow. A constructor's
							# "New" starts a line, and popping there took a character
							# of its indentation.
							if(@prev_token->GetType() = System.Utility.Token->Type->ASSESSOR) {
								PopBuffer();
							};
							AppendBuffer("New");
							@skip_space := true;
						}

						label System.Utility.Token->Type->AS_ID {
							AppendBuffer("As");
						}

						label System.Utility.Token->Type->TYPE_OF_ID {
							AppendBuffer("TypeOf");
						}

						label System.Utility.Token->Type->CRITICAL_ID {
							AppendBuffer("critical");
						}

						label System.Utility.Token->Type->COLON {
							# "label 1:" and a literal's "key": value
							if(in_label | @braces->EndsWith('L')) {
								PopBuffer();
							};
							AppendBuffer(':');
						}

						# A '+' or '-' with no operand before it is a sign and stays against
						# its operand ("x := -1", "F(-n)"); between two operands it is spaced
						# like any other operator.
						label System.Utility.Token->Type->ADD {
							AppendBuffer('+');
							@skip_space := IsSign();
						}

						label System.Utility.Token->Type->SUB {
							AppendBuffer('-');
							@skip_space := IsSign();
						}

						label System.Utility.Token->Type->MUL {
							AppendBuffer('*');
						}

						label System.Utility.Token->Type->DIV {
							AppendBuffer('/');
						}

						label System.Utility.Token->Type->MOD {
							AppendBuffer('%');
						}

						# the '\' of a function type or a lambda stays against what it starts
						label System.Utility.Token->Type->FWD_SLASH {
							AppendBuffer('\\');
							@skip_space := true;
						}

						# a token with no rule of its own is written as it was read
						label System.Utility.Token->Type->SYMBOL {
							symbol := @token->GetValue();
							if(symbol->Equals("^") & @prev_token->GetType() = System.Utility.Token->Type->FWD_SLASH) {
								# "\^(a : Int) ~ Int => ..."
								AppendBuffer(symbol);
								@skip_space := true;
							}
							else if(symbol->Equals("!")) {
								AppendBuffer(symbol);
								@skip_space := true;
							}
							else {
								AppendBuffer(symbol);
							};
						}

						label System.Utility.Token->Type->EQL {
							AppendBuffer('=');
						}

						label System.Utility.Token->Type->LESS_EQL {
							AppendBuffer("<=");
						}

						label System.Utility.Token->Type->GTR_EQL {
							AppendBuffer(">=");
						}

						label System.Utility.Token->Type->ADD_ASN {
							AppendBuffer("+=");
						}

						label System.Utility.Token->Type->SUB_ASN {
							AppendBuffer("-=");
						}

						# "i++" and "++i": against the operand on whichever side has one
						label System.Utility.Token->Type->ADD_ADD {
							if(EndsOperand(@prev_token)) {
								PopBuffer();
							}
							else {
								@skip_space := true;
							};
							AppendBuffer("++");
						}

						label System.Utility.Token->Type->SUB_SUB {
							if(EndsOperand(@prev_token)) {
								PopBuffer();
							}
							else {
								@skip_space := true;
							};
							AppendBuffer("--");
						}

						label System.Utility.Token->Type->MUL_ASN {
							AppendBuffer("*=");
						}

						label System.Utility.Token->Type->DIV_ASN {
							AppendBuffer("/=");
						}

						label System.Utility.Token->Type->LAMBDA {
							AppendBuffer("=>");
						}

						label System.Utility.Token->Type->TILDE {
							AppendBuffer('~');
						}

						label System.Utility.Token->Type->OBRACE {
							# "values[i]" and "String[]": against a name or a type
							if(@prev_token->GetType() = System.Utility.Token->Type->IDENT | IsTypeName(@prev_token)) {
								PopBuffer();
							};
							AppendBuffer('[');
							@skip_space := true;
							open_depth += 1;
						}

						label System.Utility.Token->Type->CBRACE {
							if(@prev_token->GetType() <> System.Utility.Token->Type->OBRACE) {
								PopBuffer();
							};
							AppendBuffer(']');
							if(open_depth > 0) {
								open_depth -= 1;
							};
						}

						label System.Utility.Token->Type->OPREN {
							if(<>@stmt_space) {
								select(@prev_token->GetType()) {
									label System.Utility.Token->Type->IDENT
									label System.Utility.Token->Type->IF_ID
									label System.Utility.Token->Type->FOR_ID
									label System.Utility.Token->Type->EACH_ID
									label System.Utility.Token->Type->SELECT_ID
									label System.Utility.Token->Type->PARENT_ID
									label System.Utility.Token->Type->CRITICAL_ID
									label System.Utility.Token->Type->AS_ID
									label System.Utility.Token->Type->TYPE_OF_ID
									label System.Utility.Token->Type->REVERSE_ID
									label System.Utility.Token->Type->CPREN
									label System.Utility.Token->Type->WHILE_ID {
										PopBuffer();
									}
								};
							};

							AppendBuffer('(');
							@skip_space := true;
							open_depth += 1;
						}

						label System.Utility.Token->Type->CPREN {
							if(@prev_token->GetType() <> System.Utility.Token->Type->OPREN) {
								PopBuffer();
							};

							if(in_for) {
								in_for := false;
							};

							AppendBuffer(')');
							if(open_depth > 0) {
								open_depth -= 1;
							};
						}

						# A '{' opens a block, which gets lines of its own, or a map or JSON
						# literal ({"name": "x", "n": 1}, {}), which is an expression and
						# stays in its line like a '[' does.
						label System.Utility.Token->Type->OCBRACE {
							if(IsLiteralBrace(tokens, i)) {
								AppendBuffer('{');
								@skip_space := true;
								open_depth += 1;
								@braces += 'L';
							}
							else {
								AppendBuffer("{\n");
								@skip_space := true;
								tab_space += 1;
								insert_tabs := true;
								@braces += 'B';
							};

							if(in_label) {
								in_label := false;
							};
						}

						label System.Utility.Token->Type->CCBRACE {
							closes_literal := @braces->EndsWith('L');
							if(@braces->Size() > 0) {
								@braces->Pop();
							};

							if(closes_literal) {
								if(@prev_token->GetType() <> System.Utility.Token->Type->OCBRACE) {
									PopBuffer();
								};
								AppendBuffer('}');
								if(open_depth > 0) {
									open_depth -= 1;
								};
							}
							else {
							# an empty block closes on the line after its '{', with no
							# line of indentation left between the two
							tab_space -= 1;
							StartLine(tab_space);
							AppendBuffer('}');

							if(in_consts) {
								in_consts := false;
							};

							# What follows the brace. AppendBuffer joins the next token to
							# a '}', which is right for the few that belong on its line and
							# wrong for a constructor, field, comment or statement with no
							# blank line before it: they came out as "}New() {", "}@y : Int;"
							# and "}# note".
							select(@next_token->GetType()) {
								# stay on the brace's line
								label System.Utility.Token->Type->TRAIL_COMMENT
								label System.Utility.Token->Type->SEMI
								label System.Utility.Token->Type->CPREN
								label System.Utility.Token->Type->CBRACE
								label System.Utility.Token->Type->COMMA
								label System.Utility.Token->Type->ASSESSOR
								label System.Utility.Token->Type->WHILE_ID
								# start a line of their own, or are given one by VerticalSpace
								label System.Utility.Token->Type->CCBRACE
								label System.Utility.Token->Type->VTAB
								label System.Utility.Token->Type->ELSE_ID
								label System.Utility.Token->Type->CLASS_ID
								label System.Utility.Token->Type->FUNCTION_ID
								label System.Utility.Token->Type->METHOD_ID
								label System.Utility.Token->Type->LABEL_ID
								label System.Utility.Token->Type->OTHER_ID
								label System.Utility.Token->Type->ENUM_ID
								label System.Utility.Token->Type->CONSTS_ID
								label System.Utility.Token->Type->ALIAS_ID
								label System.Utility.Token->Type->BUNDLE_ID
								label System.Utility.Token->Type->INTERFACE_ID
								# end of the source
								label System.Utility.Token->Type->OTHER {
								}

								# a constructor is set apart like a method
								label System.Utility.Token->Type->NEW_ID {
									AppendBuffer("\n\n");
									TabSpace(tab_space, @ident_space);
									@skip_space := true;
								}

								other {
									AppendBuffer('\n');
									TabSpace(tab_space, @ident_space);
									@skip_space := true;
								}
							};
							};
						}

						# A blank line in the source is one blank line here, however many
						# there were and whatever came before: the line that is ended has
						# no indentation left on it, and the blank one is empty. Written as
						# "\n\n" after whatever was there, a blank line after a '{' or a
						# comment left a line of tabs behind and came back as two on the
						# next pass, three on the one after.
						label System.Utility.Token->Type->VTAB {
							if(@next_token->GetType() <> System.Utility.Token->Type->CCBRACE & @next_token->GetType() <> System.Utility.Token->Type->VTAB) {
								TrimIndent();
								if(@buffer->EndsWith("\n\n")) {
									# already one blank line
								}
								else if(@buffer->EndsWith('\n')) {
									AppendVerbatim("\n");
								}
								else {
									AppendVerbatim("\n\n");
								};
								TabSpace(tab_space, @ident_space);
							};
							@skip_space := true;
						}

						# no rule: written as it was read, never dropped
						other {
							AppendBuffer(@token->GetValue());
						}
					};

					if(<>@skip_space) {
						if(InRange()) {
							@buffer += ' ';
						};
					}
					else {
						@skip_space := false;
					};
				};
			};

			# clean up output
			offset_start := 0;
			each(i : @buffer) {
				if(@buffer->Get(i) = '\n' | @buffer->Get(i) = '\r') {
					offset_start += 1;
				}
				else {
					break;
				};
			};

			offset_end := 0;
			reverse(i : @buffer) {
				if(@buffer->Get(i) = ' ' | @buffer->Get(i) = '\t') {
					offset_end += 1;
				}
				else {
					break;
				};
			};

			formatted := @buffer->SubString(offset_start, @buffer->Size() - offset_start - offset_end);

			if(@trim_trailing) {
				formatted := formatted->Trim();
			};

			return formatted;
		}

		#
		# The nesting depth the formatter indents each line of 'source' to: one level
		# per open '{', one fewer for a line that starts with '}'. Index 1 is the
		# first line. A blank line has the depth the code around it is at, which is
		# where a new line typed there belongs; a line a multi-line comment runs
		# over is -1, because the formatter leaves a comment's text alone. Nil when
		# the source does not scan.
		#
		# The scanner's line numbers are not the source's, and this undoes how: a
		# line comment ends at its newline without counting it, so every token after
		# one is a line short, and a multi-line comment is numbered by the line it
		# ends on. The formatter itself never reads the numbers (only a range format
		# does), which is why they were never corrected there.
		#
		#~
		The nesting depth each line of the source is indented to
		@param source source code
		@param line_count number of lines in the source
		@return depth of each line, index 1 is the first line; -1 for a line a multi-line comment runs over
		~#
		method : public : LineDepths(source : String, line_count : Int) ~ Int[] {
			scanner := Scanner->New(source);
			scanner->SetLenient();
			if(<>scanner->Scan()) {
				return Nil;
			};

			depths := Int->New[line_count + 2];
			depth := 0;
			line := 1;
			drift := 0;
			tokens := scanner->GetTokens();
			each(token in tokens) {
				type := token->GetType();

				# the blank-line marker shares a line with the token after it
				if(type = System.Utility.Token->Type->VTAB) {
					continue;
				};

				token_line := token->GetLine() + drift;
				start_line := token_line;
				comment_end := token_line;
				if(type = System.Utility.Token->Type->MULTI_COMMENT | type = System.Utility.Token->Type->INLINE_COMMENT) {
					comment := token->GetValue();
					each(j : comment) {
						if(comment->Get(j) = '\n') {
							start_line -= 1;
						};
					};
				};

				# lines with no token take the depth the code before them left
				while(line < start_line & line <= line_count) {
					depths[line] := depth;
					line += 1;
				};

				# the first token on a line sets its depth
				if(line = start_line & line <= line_count) {
					if(start_line < comment_end) {
						depths[line] := -1;
					}
					else if(type = System.Utility.Token->Type->CCBRACE & depth > 0) {
						depths[line] := depth - 1;
					}
					else {
						depths[line] := depth;
					};
					line += 1;
				};

				select(type) {
					label System.Utility.Token->Type->OCBRACE {
						depth += 1;
					}

					label System.Utility.Token->Type->CCBRACE {
						if(depth > 0) {
							depth -= 1;
						};
					}

					label System.Utility.Token->Type->LINE_COMMENT
					label System.Utility.Token->Type->TRAIL_COMMENT {
					}

					label System.Utility.Token->Type->MULTI_COMMENT
					label System.Utility.Token->Type->INLINE_COMMENT {
						while(line <= comment_end & line <= line_count) {
							depths[line] := -1;
							line += 1;
						};
					}

					other {
					}
				};
			};

			while(line <= line_count) {
				depths[line] := depth;
				line += 1;
			};

			return depths;
		}

		method : IsTypeName(token : Token) ~ Bool {
			type := token->GetType();
			return type = System.Utility.Token->Type->STRING_ID | type = System.Utility.Token->Type->INT_ID | type = System.Utility.Token->Type->FLOAT_ID |
				type = System.Utility.Token->Type->CHAR_ID | type = System.Utility.Token->Type->BOOL_ID | type = System.Utility.Token->Type->BYTE_ID;
		}

		# Whether the '<' at 'at' opens type arguments: from it to the '>' that closes
		# it there are only type names, commas, a bound's ':' and what a function
		# type is written with. A comparison has an operand, an operator or a ';'
		# before any '>' closes it.
		method : IsTypeArguments(tokens : Vector<Token>, at : Int) ~ Bool {
			depth := 0;
			for(k := at; k < tokens->Size(); k += 1;) {
				select(tokens->Get(k)->GetType()) {
					label System.Utility.Token->Type->LESS {
						depth += 1;
					}

					label System.Utility.Token->Type->GTR {
						depth -= 1;
						if(depth = 0) {
							return k > at + 1;
						};
					}

					label System.Utility.Token->Type->IDENT
					label System.Utility.Token->Type->STRING_ID
					label System.Utility.Token->Type->INT_ID
					label System.Utility.Token->Type->FLOAT_ID
					label System.Utility.Token->Type->CHAR_ID
					label System.Utility.Token->Type->BOOL_ID
					label System.Utility.Token->Type->BYTE_ID
					label System.Utility.Token->Type->NIL_ID
					label System.Utility.Token->Type->COMMA
					label System.Utility.Token->Type->COLON
					label System.Utility.Token->Type->OBRACE
					label System.Utility.Token->Type->CBRACE
					label System.Utility.Token->Type->FWD_SLASH
					label System.Utility.Token->Type->TILDE
					label System.Utility.Token->Type->OPREN
					label System.Utility.Token->Type->CPREN {
					}

					other {
						return false;
					}
				};
			};

			return false;
		}

		# whether the '+' or '-' being written is a sign: nothing that can end an operand comes before it
		method : IsSign() ~ Bool {
			return <>EndsOperand(@prev_token);
		}

		method : EndsOperand(token : Token) ~ Bool {
			select(token->GetType()) {
				label System.Utility.Token->Type->IDENT
				label System.Utility.Token->Type->NUM_LIT
				label System.Utility.Token->Type->STRING_LIT
				label System.Utility.Token->Type->CHAR_LIT
				label System.Utility.Token->Type->CPREN
				label System.Utility.Token->Type->CBRACE
				label System.Utility.Token->Type->TRUE_ID
				label System.Utility.Token->Type->FALSE_ID
				label System.Utility.Token->Type->NIL_ID {
					return true;
				}
			};

			return false;
		}

		# the whitespace the formatter writes before a line at this depth
		#~
		The whitespace written before a line at a nesting depth
		@param depth nesting depth
		@return indentation
		~#
		method : public : IndentFor(depth : Int) ~ String {
			indent := "";
			if(@ident_space > 0) {
				each(i : depth) {
					each(j : @ident_space) {
						indent += ' ';
					};
					indent += ' ';
				};
			}
			else {
				each(i : depth) {
					indent += '\t';
				};
			};

			return indent;
		}

		# A declaration that follows a '}' starts on a line of its own, after a blank
		# one. @skip_space is set for the caller, which clears it once the keyword is
		# written: left set, it dropped the space AFTER the keyword, and a second class
		# in a file came back as 'classB', which does not compile.
		method : VerticalSpace(@prev_token : Token, tab_space : Int, @ident_space : Int) ~ Nil {
			if(@prev_token->GetType() = System.Utility.Token->Type->CCBRACE) {
				AppendBuffer("\n\n");
				TabSpace(tab_space, @ident_space);
				@skip_space := true;
			};
		}

		method : TabSpace(tab_space : Int, @ident_space : Int) ~ Nil {
			if(@ident_space > 0) {
				c := c2 := ' ';
	# c := '·'; c2 := '•';
				each(i : tab_space) {

					each(j : @ident_space) {
						AppendBuffer(c);
					};
					AppendBuffer(c2);
				};
			}
			else {
				each(i : tab_space) {
					AppendBuffer('\t');
				};
			};
		}
		#~
		Formats source code, optionally with ANSI colors for a terminal
		@param source source code
		@param is_color true for ascii color formatting, false otherwise
		@return formatted code
		```
		opts := Map->New()<String, String>;
		opts->Insert("ident-space", "3");
		formatter := CodeFormatter->New(opts);
		src := "class Foo{method:public:Bar()~Nil{x:=1;}}";
		formatter->Format(src, false)->PrintLine();
		```
		~#
		method : public : Format(source : String, is_color : Bool) ~ String {
			formatted := Format(source);
			if(is_color & formatted <> Nil) {
				return Colorize(formatted);
			};

			return formatted;
		}

		# The formatted text with a color around each token, for a terminal. It is read
		# again here, after formatting, so that the colors are never part of what the
		# layout rules measure and trim.
		method : Colorize(formatted : String) ~ String {
			scanner := Scanner->New(formatted);
			scanner->Scan();
			tokens := scanner->GetTokens();

			colored := "";
			at := 0;
			each(token in tokens) {
				start := token->GetStart();
				end := token->GetEnd();
				if(start >= at & end > start & end <= formatted->Size()) {
					colored += formatted->SubString(at, start - at);

					color := "";
					select(token->GetType()) {
						label System.Utility.Token->Type->LINE_COMMENT
						label System.Utility.Token->Type->TRAIL_COMMENT
						label System.Utility.Token->Type->MULTI_COMMENT
						label System.Utility.Token->Type->INLINE_COMMENT {
							color := "\e[90m";
						}

						label System.Utility.Token->Type->STRING_LIT
						label System.Utility.Token->Type->CHAR_LIT
						label System.Utility.Token->Type->NUM_LIT
						label System.Utility.Token->Type->TRUE_ID
						label System.Utility.Token->Type->FALSE_ID
						label System.Utility.Token->Type->NIL_ID {
							color := "\e[36m";
						}

						label System.Utility.Token->Type->STRING_ID
						label System.Utility.Token->Type->INT_ID
						label System.Utility.Token->Type->FLOAT_ID
						label System.Utility.Token->Type->CHAR_ID
						label System.Utility.Token->Type->BOOL_ID
						label System.Utility.Token->Type->BYTE_ID {
							color := "\e[94m";
						}

						label System.Utility.Token->Type->OPREN
						label System.Utility.Token->Type->CPREN
						label System.Utility.Token->Type->OBRACE
						label System.Utility.Token->Type->CBRACE
						label System.Utility.Token->Type->OCBRACE
						label System.Utility.Token->Type->CCBRACE {
							color := "\e[31m";
						}

						label System.Utility.Token->Type->IDENT
						label System.Utility.Token->Type->VTAB
						label System.Utility.Token->Type->SEMI
						label System.Utility.Token->Type->COMMA {
						}

						other {
							# a keyword is a word; everything else left is an operator
							if(formatted->Get(start)->IsChar()) {
								color := "\e[33m";
							}
							else {
								color := "\e[32m";
							};
						}
					};

					if(color->Size() > 0) {
						colored += color;
						colored += formatted->SubString(start, end - start);
						colored += "\e[0m";
					}
					else {
						colored += formatted->SubString(start, end - start);
					};
					at := end;
				};
			};
			colored += formatted->SubString(at, formatted->Size() - at);

			return colored;
		}
	}

	class : private : Scanner {
		@buffer : Char[];
		@buffer_index : Int;
		@cur_char : Char;
		@next_char : Char;
		@line_num : Int;
		@line_pos : Int;
		@keywords : Hash<String, Token>;
		@tokens : Vector<Token>;
		@lenient : Bool;
		@code_on_line : Bool;

		New(input : String) {
			@buffer := input->ToCharArray();
			@line_num := @line_pos := 1;
			@tokens := Vector->New()<Token>;

			@keywords := Hash->New()<String, Token>;

			@keywords->Insert("and", Token->New(@line_num, System.Utility.Token->Type->AND_ID, "and_id"));
			@keywords->Insert("or", Token->New(@line_num, System.Utility.Token->Type->OR_ID, "or_id"));
			@keywords->Insert("xor", Token->New(@line_num, System.Utility.Token->Type->XOR_ID, "xor_id"));
			@keywords->Insert("virtual", Token->New(@line_num, System.Utility.Token->Type->VIRTUAL_ID, "virtual_id"));
			@keywords->Insert("bundle", Token->New(@line_num, System.Utility.Token->Type->BUNDLE_ID, "bundle_id"));
			@keywords->Insert("interface", Token->New(@line_num, System.Utility.Token->Type->INTERFACE_ID, "interface_id"));
			@keywords->Insert("implements", Token->New(@line_num, System.Utility.Token->Type->IMPLEMENTS_ID, "implements_id"));
			@keywords->Insert("enum", Token->New(@line_num, System.Utility.Token->Type->ENUM_ID, "enum_id"));
			@keywords->Insert("consts", Token->New(@line_num, System.Utility.Token->Type->CONSTS_ID, "consts_id"));
			@keywords->Insert("reverse", Token->New(@line_num, System.Utility.Token->Type->REVERSE_ID, "reverse_id"));
			@keywords->Insert("Parent", Token->New(@line_num, System.Utility.Token->Type->PARENT_ID, "parent_id"));
			@keywords->Insert("from", Token->New(@line_num, System.Utility.Token->Type->FROM_ID, "from_id"));
			@keywords->Insert("true", Token->New(@line_num, System.Utility.Token->Type->TRUE_ID, "true_id"));
			@keywords->Insert("false", Token->New(@line_num, System.Utility.Token->Type->FALSE_ID, "false_id"));
			@keywords->Insert("New", Token->New(@line_num, System.Utility.Token->Type->NEW_ID, "new_id"));
			@keywords->Insert("As", Token->New(@line_num, System.Utility.Token->Type->AS_ID, "as_id"));
			@keywords->Insert("TypeOf", Token->New(@line_num, System.Utility.Token->Type->TYPE_OF_ID, "typeof_id"));
			@keywords->Insert("critical", Token->New(@line_num, System.Utility.Token->Type->CRITICAL_ID, "critical_id"));
			@keywords->Insert("use", Token->New(@line_num, System.Utility.Token->Type->USE_ID, "use_id"));
			@keywords->Insert("class", Token->New(@line_num, System.Utility.Token->Type->CLASS_ID, "class_id"));
			@keywords->Insert("function", Token->New(@line_num, System.Utility.Token->Type->FUNCTION_ID, "function_id"));
			@keywords->Insert("alias", Token->New(@line_num, System.Utility.Token->Type->ALIAS_ID, "alias_id"));
			@keywords->Insert("method", Token->New(@line_num, System.Utility.Token->Type->METHOD_ID, "method_id"));
			@keywords->Insert("public", Token->New(@line_num, System.Utility.Token->Type->PUBLIC_ID, "public_id"));
			@keywords->Insert("private", Token->New(@line_num, System.Utility.Token->Type->PRIVATE_ID, "private_id"));
			@keywords->Insert("native", Token->New(@line_num, System.Utility.Token->Type->NATIVE_ID, "native_id"));
			@keywords->Insert("static", Token->New(@line_num, System.Utility.Token->Type->STATIC_ID, "static_id"));
			@keywords->Insert("if", Token->New(@line_num, System.Utility.Token->Type->IF_ID, "if_id"));
			@keywords->Insert("else", Token->New(@line_num, System.Utility.Token->Type->ELSE_ID, "else_id"));
			@keywords->Insert("for", Token->New(@line_num, System.Utility.Token->Type->FOR_ID, "for_id"));
			@keywords->Insert("each", Token->New(@line_num, System.Utility.Token->Type->EACH_ID, "each_id"));
			@keywords->Insert("do", Token->New(@line_num, System.Utility.Token->Type->DO_ID, "do_id"));
			@keywords->Insert("while", Token->New(@line_num, System.Utility.Token->Type->WHILE_ID, "while_id"));
			@keywords->Insert("select", Token->New(@line_num, System.Utility.Token->Type->SELECT_ID, "select_id"));
			@keywords->Insert("label", Token->New(@line_num, System.Utility.Token->Type->LABEL_ID, "label_id"));
			@keywords->Insert("break", Token->New(@line_num, System.Utility.Token->Type->BREAK_ID, "break_id"));
			@keywords->Insert("continue", Token->New(@line_num, System.Utility.Token->Type->CONTINUE_ID, "continue_id"));
			@keywords->Insert("return", Token->New(@line_num, System.Utility.Token->Type->RETURN_ID, "return_id"));
			@keywords->Insert("leaving", Token->New(@line_num, System.Utility.Token->Type->LEAVING_ID, "leaving_id"));
			@keywords->Insert("String", Token->New(@line_num, System.Utility.Token->Type->STRING_ID, "string_id"));
			@keywords->Insert("Int", Token->New(@line_num, System.Utility.Token->Type->INT_ID, "int_id"));
			@keywords->Insert("Float", Token->New(@line_num, System.Utility.Token->Type->FLOAT_ID, "float_id"));
			@keywords->Insert("Char", Token->New(@line_num, System.Utility.Token->Type->CHAR_ID, "char_id"));
			@keywords->Insert("Bool", Token->New(@line_num, System.Utility.Token->Type->BOOL_ID, "bool_id"));
			@keywords->Insert("Byte", Token->New(@line_num, System.Utility.Token->Type->BYTE_ID, "byte_id"));
			@keywords->Insert("Nil", Token->New(@line_num, System.Utility.Token->Type->NIL_ID, "nil_id"));
			@keywords->Insert("other", Token->New(@line_num, System.Utility.Token->Type->OTHER_ID, "other_id"));
			@keywords->Insert("otherwise", Token->New(@line_num, System.Utility.Token->Type->OTHERWISE_ID, "otherwise_id"));
		}

		method : NextChar() ~ Nil {
			if(@buffer_index < @buffer->Size()) {
				@cur_char := @buffer[@buffer_index++];
				@line_pos += 1;

				if(@buffer_index < @buffer->Size()) {
					@next_char := @buffer[@buffer_index];
				}
				else {
					@next_char := '\0';
				};
			}
			else {
				# '\0' is the end of the text: every loop below stops at it. They
				# did not, and an unterminated string, character or block comment,
				# or a line comment on the last line, spun the language server
				# forever on a formatting request. (This assigned a stray local,
				# 'next_char', not the field.)
				@cur_char := '\0';
				@next_char := '\0';
			};
		}

		# the text from 'start' up to the current character; all of the rest at the
		# end of the text, where the current character is not part of it
		method : TextFrom(start : Int) ~ String {
			if(@cur_char = '\0' & @buffer_index >= @buffer->Size()) {
				return String->New(@buffer, start, @buffer->Size() - start);
			};

			return String->New(@buffer, start, @buffer_index - 1 - start);
		}

		method : Whitespace() ~ Nil {
			new_line_count := 0;

			while(@cur_char = ' ' | @cur_char = '\t' | @cur_char = '\r' | @cur_char = '\n') {
				if(@cur_char = '\n') {
					@line_num += 1;
					new_line_count += 1;
					@line_pos := 1;
					@code_on_line := false;
				};

				NextChar();
			};

			if(new_line_count > 1) {
				for(i := 0; i < new_line_count; i += 2;) {
					@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->VTAB, "vtab"));
				};
			};
		}

		# leave out the characters that are tokens of their own (for a caller that only counts braces)
		method : public : SetLenient() ~ Nil {
			@lenient := true;
		}

		# What a name may start with, as the compiler reads one: a letter of any
		# script (a name such as "Δ" stopped the formatter), '_', '@' for a field
		# and '$'. The five characters that are operators in the alternative
		# spelling are not letters.
		method : IsWordStart(c : Char) ~ Bool {
			if(c->IsChar() | c = '_' | c = '@' | c = '$') {
				return true;
			};

			if(c->As(Int) > 127) {
				return c <> '→' & c <> '←' & c <> '≠' & c <> '≥' & c <> '≤';
			};

			return false;
		}

		method : public : GetTokens() ~ Vector<Token> {
			return @tokens;
		}

		method : public : Scan() ~ Bool {
			NextChar();
			token_count := 0;

			while(@cur_char <> '\0') {
				# what was read last time round is on the line a comment may now follow
				if(@tokens->Size() > token_count) {
					@code_on_line := true;
				};
				token_count := @tokens->Size();
				Whitespace();
				token_count := @tokens->Size();
				span_start := Position();

				# comment
				if(@cur_char = '#') {
					after_hash := @buffer_index;
					NextChar();

					if(@cur_char = '~') {
						start := @buffer_index;
						NextChar();
						while(@cur_char <> '\0' & <>(@cur_char = '~' & @next_char = '#')) {
							if(@cur_char = '\n') {
								@line_num += 1;
								@line_pos := 1;
							};

							NextChar();
						};
						comment := TextFrom(start);
						NextChar();
						NextChar();

						# one that starts after code on its line is part of that line
						if(@code_on_line) {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->INLINE_COMMENT, comment));
						}
						else {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->MULTI_COMMENT, comment));
						};
					}
					else {
						start := after_hash;
						while(@cur_char <> '\0' & @cur_char <> '\n') {
							NextChar();
						};
						comment := TextFrom(start);
						if(comment->EndsWith('\r')) {
							comment->Pop();
						};

						# The newline that ends the comment is left for Whitespace to count.
						# It was taken here, uncounted: every token after a line comment was
						# numbered a line short, and a blank line after a comment was not
						# seen as one (it takes two newlines), so it was dropped. A comment
						# that follows code on its line is told apart from one on a line of
						# its own, so that the formatter can leave it where it is.
						if(@code_on_line) {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->TRAIL_COMMENT, comment));
						}
						else {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->LINE_COMMENT, comment));
						};
					};
				}
				# string literal; a '$' directly before the quote ($"C:\\temp") is part of it
				else if(@cur_char = '"' | (@cur_char = '$' & @next_char = '"')) {
					is_raw := @cur_char = '$';
					if(is_raw) {
						NextChar();
					};
					start := @buffer_index;
					NextChar();
					is_escape := false;

					while(@cur_char <> '\0' & (is_escape | @cur_char <> '"')) {
						if(is_escape) {
							is_escape := false;
						}
						else if(@cur_char = '\\') {
							is_escape := true;
						};

						NextChar();
					};
					string_lit := TextFrom(start);
					# a string the text ends inside has no closing quote, and is not given one
					unterminated := @cur_char = '\0';
					NextChar();

					if(unterminated) {
						open_lit := is_raw ? "$\"" : "\"";
						open_lit += string_lit;
						@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, open_lit));
					}
					else if(is_raw) {
						# written back whole, with its '$' against the quote
						raw_lit := "$\"";
						raw_lit += string_lit;
						raw_lit += '"';
						@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, raw_lit));
					}
					else {
						@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->STRING_LIT, string_lit));
					};
				}
				# char const
				else if(@cur_char = '\'') {
					start := @buffer_index;
					NextChar();
					is_escape := false;

					while(@cur_char <> '\0' & (is_escape | @cur_char <> '\'')) {
						if(is_escape) {
							is_escape := false;
						}
						else if(@cur_char = '\\') {
							is_escape := true;
						};

						NextChar();
					};
					string_lit := TextFrom(start);
					unterminated := @cur_char = '\0';
					NextChar();

					if(unterminated) {
						open_lit := "'";
						open_lit += string_lit;
						@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, open_lit));
					}
					else {
						@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->CHAR_LIT, string_lit));
					};
				}
				# keyword or variable
				else if(IsWordStart(@cur_char)) {
					start := @buffer_index - 1;
					while(IsWordStart(@cur_char) | @cur_char->IsDigit() | @cur_char = '.') {
						NextChar();
					};
					word := TextFrom(start);

					keyword := @keywords->Find(word);
					if(keyword = Nil) {
	# "|{$word}"->Print();
						@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->IDENT, word));
					}
					else {
						@tokens->AddBack(keyword->Copy(@line_num));
					};
				}
				# A number, read as the compiler reads one (core/compiler/scanner.cpp): it
				# starts with a digit, or a '.' that a digit follows, and never with a sign
				# (a sign is an operator of its own). Digits, '_' separators, a 0x, 0b or
				# 0o prefix, one '.', an exponent with its sign, and a 'u' suffix that ends
				# it. The literal is one token and is written back as it was read: split
				# anywhere, "1.5e-3", "1_000" or "0o17" came back as two tokens with a
				# space between them, which is not the number.
				else if(@cur_char->IsDigit() | (@cur_char = '.' & @next_char->IsDigit())) {
					start := @buffer_index - 1;
					radix_prefix := false;
					is_float := false;
					after_exponent := false;
					count := 0;
					done := false;

					while(<>done) {
						c := @cur_char;
						if(c = 'u' | c = 'U') {
							NextChar();
							done := true;
						}
						else if(after_exponent & (c = '+' | c = '-') & @next_char->IsDigit()) {
							after_exponent := false;
							NextChar();
						}
						else if(c->IsDigit() | c = '_' | (c >= 'a' & c <= 'f') | (c >= 'A' & c <= 'F')) {
							after_exponent := is_float & <>radix_prefix & (c = 'e' | c = 'E');
							NextChar();
						}
						else if(c = '.') {
							# a second '.', or one in a literal with a prefix, is not part of it
							if(is_float | radix_prefix) {
								done := true;
							}
							else {
								is_float := true;
								after_exponent := false;
								NextChar();
							};
						}
						else if(count = 1 & (c = 'x' | c = 'X' | c = 'o' | c = 'O') & @buffer[start] = '0') {
							radix_prefix := true;
							after_exponent := false;
							NextChar();
						}
						else {
							done := true;
						};
						count += 1;
					};

					# "0b..." needs no case above ('b' is a hex digit); it has no exponent either
					num_lit := TextFrom(start);
					@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->NUM_LIT, num_lit));
				}
				else {
					select(@cur_char) {
						label '{' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->OCBRACE, "ocbrace"));
							NextChar();
						}

						label '}' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->CCBRACE, "ccbrace"));
							NextChar();
						}

						label '(' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->OPREN, "opern"));
							NextChar();
						}

						label ')' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->CPREN, "cpren"));
							NextChar();
						}

						label '[' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->OBRACE, "obrace"));
							NextChar();
						}

						label ']' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->CBRACE, "cbrace"));
							NextChar();
						}

						label ',' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->COMMA, "COMMA"));
							NextChar();
						}

						label ':' {
							if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->ASGN, "asgn"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->COLON, "colon"));
							};
							NextChar();
						}

						label '~' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->TILDE, "tilde"));
							NextChar();
						}

						label ';' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SEMI, "semi"));
							NextChar();
						}

						label '+' {
							if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->ADD_ASN, "add_asn"));
								NextChar();
							}
							else if(@next_char = '+') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->ADD_ADD, "add_add"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->ADD, "add"));
							};
							NextChar();
						}

						label '-' {
							if(@next_char = '>') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->ASSESSOR, "assessor"));
								NextChar();
							}
							else if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SUB_ASN, "sub_asn"));
								NextChar();
							}
							else if(@next_char = '-') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SUB_SUB, "sub_sub"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SUB, "sub"));
							};
							NextChar();
						}

						label '→' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->ASSESSOR, "assessor"));
							NextChar();
						}

						label '←' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->ASGN, "asgn"));
							NextChar();
						}

						label '≠' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->NEQL, "neql"));
							NextChar();
						}

						label '≥' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->GTR_EQL, "gtr_eql"));
							NextChar();
						}

						label '≤' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->LESS_EQL, "less_eql"));
							NextChar();
						}

						label '*' {
							if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->MUL_ASN, "mul_asn"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->MUL, "mul"));
							};
							NextChar();
						}

						label '/' {
							if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->DIV_ASN, "div_asn"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->DIV, "div"));
							};
							NextChar();
						}

						label '%' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->MOD, "mod"));
							NextChar();
						}

						label '&' {
							if(@next_char = '&') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, "&&"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->AND, "and"));
							};
							NextChar();
						}

						label '|' {
							if(@next_char = '|') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, "||"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->OR, "or"));
							};
							NextChar();
						}

						label '?' {
							# '??' must scan as one token; emitting two QUESTIONs makes
							# the formatter write '? ?', which no longer compiles.
							# '?->' needs nothing here: it scans as QUESTION followed by
							# ASSESSOR, and neither adds a space between them.
							if(@next_char = '?') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->QUESTION_QUESTION, "question_question"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->QUESTION, "question"));
							};
							NextChar();
						}

						# The '\' that starts a function type ("\Int ~ Int") or a lambda
						# ("\^(a : Int) ~ Int => a + 1", "\Func->New(...)"). The label here
						# read '\'', a quote, which the character-literal case above always
						# takes first, so a backslash had no token and the formatter stopped
						# at the first one in a file.
						label '\\' {
							@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->FWD_SLASH, "back_slash"));
							NextChar();
						}

						label '=' {
							# '=>' (a lambda's body, a 'match' arm) is one token. It was scanned
							# as '<>' with the '>' left behind, so formatting wrote '<> >'.
							if(@next_char = '>') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->LAMBDA, "lambda"));
								NextChar();
								NextChar();
							}
							else if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, "=="));
								NextChar();
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->EQL, "eql"));
								NextChar();
							};
						}

						label '<' {
							if(@next_char = '>') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->NEQL, "neql"));
								NextChar();
							}
							else if(@next_char = '<') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, "<<"));
								NextChar();
							}
							else if(@next_char = '=') {
								# '<=' was given the lambda's token, and formatting wrote '=>'
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->LESS_EQL, "less_eql"));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->LESS, "less"));
							};
							NextChar();
						}

						label '>' {
							if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->GTR_EQL, "gtr_eql"));
								NextChar();
							}
							else {
								# One '>' at a time, also for ">>" and ">>>". The compiler reads
								# those as shifts and its parser takes them apart again when they
								# close type arguments ("Map<String, Vector<Int>>"), so which they
								# are is not known here. Each carries whether the next character
								# is another '>', and the formatter writes the run back unbroken.
								if(@next_char = '>') {
									@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->GTR, "joined"));
								}
								else {
									@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->GTR, "gtr"));
								};
							};
							NextChar();
						}

						# the alternative spellings: '==', '!=', '&&', '||', and '!'
						label '!' {
							if(@next_char = '=') {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, "!="));
								NextChar();
							}
							else {
								@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, "!"));
							};
							NextChar();
						}

						other {
							if(@cur_char <> '\0') {
								# Every other character is a token of its own and is written back
								# as it is: '^' (a lambda's "\^"), a '.' that stands alone, '`',
								# and anything a later compiler gives a meaning to. This used to
								# end the process ("--- [Other ...] ---" and exit 1): a formatter
								# cannot write what it did not read, but stopping lost the whole
								# file for one character. The line-depth scan (SetLenient) still
								# steps over them, since it counts braces and nothing else.
								if(<>@lenient) {
									@tokens->AddBack(Token->New(@line_num, System.Utility.Token->Type->SYMBOL, @cur_char->ToString()));
								};
								NextChar();
							};
						}
					};
				};

				# where in the text the token just read starts and ends
				span_end := Position();
				for(k := token_count; k < @tokens->Size(); k += 1;) {
					@tokens->Get(k)->SetSpan(span_start, span_end);
				};
			};

			return true;
		}

		# the index of the current character; the length of the text at its end
		method : Position() ~ Int {
			if(@cur_char = '\0' & @buffer_index >= @buffer->Size()) {
				return @buffer->Size();
			};

			return @buffer_index - 1;
		}
	}

	class : private : Token {
		@line_num : Int;
		@type : Token->Type;
		@value : String;
		@start : Int;
		@end : Int;

		enum Type := -128 {
			AND_ID,
			OR_ID,
			XOR_ID,
			VIRTUAL_ID,
			BUNDLE_ID,
			INTERFACE_ID,
			IMPLEMENTS_ID,
			ENUM_ID,
			CONSTS_ID,
			REVERSE_ID,
			PARENT_ID,
			FROM_ID,
			TRUE_ID,
			FALSE_ID,
			NEW_ID,
			AS_ID,
			TYPE_OF_ID,
			CRITICAL_ID,
			LAMBDA,
	# ---
			USE_ID,
			DO_ID,
			FOR_ID,
			EACH_ID,
			BREAK_ID,
			CONTINUE_ID,
			ALIAS_ID,
			RETURN_ID,
			LEAVING_ID,
			NIL_ID,
			STRING_ID,
			INT_ID,
			FLOAT_ID,
			CHAR_ID,
			BOOL_ID,
			BYTE_ID,
			CLASS_ID,
			FUNCTION_ID,
			METHOD_ID,
			PUBLIC_ID,
			PRIVATE_ID,
			NATIVE_ID,
			STATIC_ID,
			STRING_LIT,
			CHAR_LIT,
			NUM_LIT,
			ELSE_ID,
			IF_ID,
			WHILE_ID,
			SELECT_ID,
			LABEL_ID,
			OTHER_ID,
			OTHERWISE_ID,
			ASGN,
			CHAR,
			STR,
			VAR,
			OPREN,
			CPREN,
			OBRACE,
			CBRACE,
			OCBRACE,
			CCBRACE,
			ASSESSOR,
			AND,
			OR,
			QUESTION,
			QUESTION_QUESTION,
			DIV,
			MOD,
			MUL,
			ADD,
			SUB,
			DIV_ASN,
			MUL_ASN,
			ADD_ASN,
			SUB_ASN,
			ADD_ADD,
			SUB_SUB,
			COLON,
			SEMI,
			COMMA,
			TILDE,
			FWD_SLASH,
			LESS,
			LESS_EQL,
			GTR,
			GTR_EQL,
			EQL,
			NEQL,
			NOT,
			SYMBOL,
			IDENT,
			VTAB,
			LINE_COMMENT,
			TRAIL_COMMENT,
			MULTI_COMMENT,
			INLINE_COMMENT,
			EOS,
			OTHER
		}

		New(line_num : Int, type : Token->Type, value : String) {
			@line_num := line_num;
			@type := type;
			@value := value;
		}

		method : public : Copy(line_num : Int) ~ Token {
			return Token->New(line_num, @type, @value);
		}

		method : public : GetLine() ~ Int {
			return @line_num;
		}

		method : public : GetType() ~ Token->Type {
			return @type;
		}

		method : public : GetValue() ~ String {
			return @value;
		}

		# the token's place in the text it was read from: [start, end)
		method : public : SetSpan(start : Int, end : Int) ~ Nil {
			@start := start;
			@end := end;
		}

		method : public : GetStart() ~ Int {
			return @start;
		}

		method : public : GetEnd() ~ Int {
			return @end;
		}
	}
	# formatter:end
}
