use Data.JSON, Collection, System.IO.Net;

#~
JSON-RPC 2.0 client and server. Client sends method calls to a remote endpoint and returns typed results; Server dispatches incoming requests to registered handlers. Compile with -lib json_rpc.
~#
bundle Data.JSON.RPC {
	#~
	JSON RPC server
	~#
	class Server {
		@server : TCPSocketServer;
		@port : Int;
		@funcs : Hash<String, Func2Ref<JsonElement, JsonElement>>;
		@listening : Bool;

		#~
		Constructor
		@param funcs collection of named function calls
		@param port server port; 0 takes a free port the system chooses, which GetPort() reports
		```
		funcs := Hash->New()<String, Func2Ref<JsonElement, JsonElement>>;
		# register an "add" method
		funcs->Insert("add", Func2Ref->New(\
		  method(params : JsonElement) ~ JsonElement {
		    a := params->Get("a")->GetInt();
		    b := params->Get("b")->GetInt();
		    return JsonElement->New(a + b);
		  }));
		server := Data.JSON.RPC.Server->New(funcs, 9090);
		server->Process(); # blocks, accepts connections
		```
		~#
		New(funcs : Hash<String, Func2Ref<JsonElement, JsonElement>>, port : Int) {
			@funcs := funcs;
			@port := port;

			@server := TCPSocketServer->New(@port);
			@port := @server->GetPort();
		}

		#~
		Gets the port the server is bound to: the port given to the constructor
		or, for a port of 0, the free one the system chose. A program that needs
		no fixed number (a test, say) binds port 0 and reads the port back here, so
		it cannot collide with a port another program, or an outgoing connection
		of its own, already holds. Whether the bind and listen worked is IsListening().
		@return bound port
		```
		server := Data.JSON.RPC.Server->New(funcs, 0);
		port := server->GetPort(); # the port the system chose
		```
		~#
		method : public : GetPort() ~ Int {
			return @port;
		}

		#~
		Tells whether Process() is listening, so connections are accepted. False
		until Process() has begun listening, and for good if the port could not be
		bound or listened on. A caller that runs Process() in a thread waits on
		this, up to a deadline, rather than for a fixed time.
		@return true if listening
		```
		thread->Execute(Nil); # runs server->Process()
		waited := 0;
		while(<>server->IsListening() & waited < 10000) {
		  System.Concurrency.Thread->Sleep(10);
		  waited += 10;
		};
		```
		~#
		method : public : IsListening() ~ Bool {
			return @listening;
		}

		#~
		Start the server to accept requests
		```
		funcs := Hash->New()<String, Func2Ref<JsonElement, JsonElement>>;
		server := Data.JSON.RPC.Server->New(funcs, 9090);
		server->Process(); # listen on port 9090 for incoming RPC calls
		```
		~#
		method : public : Process() ~ Nil {
			while(@server->Listen(8)) {
				@listening := true;
				client := @server->Accept();

				thread := System.Concurrency.Thread->New() {
					New() {
						Parent()
					}

					method : public : Run(arg : System.Base) ~ Nil {
						client_funs := arg->As(Collection.Tuple.Pair<TCPSocket, Hash<String, Func2Ref<JsonElement, JsonElement>>>);
						client := client_funs->GetFirst();
						funcs := client_funs->GetSecond();
						
						response_str := client->ReadLine();
						if(response_str <> Nil) {
							response_json := JsonParser->TextToElement(response_str);
							if(response_json <> Nil) {
								method_json := response_json->Get("method");
								if(method_json <> Nil) {
									method_str := method_json->GetString();
									func_ref := funcs->Find(method_str);
									if(func_ref <> Nil) {
										func := func_ref->Get();

										# "params" may be left out of a request (JSON-RPC 2.0): the handler
										# gets an empty object, not Nil, so a handler that reads its
										# parameters does not end the server with a Nil dereference
										call_params := response_json->Get("params");
										if(call_params = Nil) {
											call_params := JsonElement->New(JsonElement->JsonType->OBJECT);
										};
										result_params_json := func(call_params);
									 	result_id_json := response_json->Get("id");
									 	if(result_params_json = Nil | result_id_json = Nil) {
											client->WriteString("null\r\n");
									 	}
									 	else {
											# The id is echoed as it was sent, a string id included
											# (JSON-RPC 2.0 section 5). This wrote the id read as an
											# Int, plus one: a string id came back as 1.
											reply_json := JsonElement->New(JsonElement->JsonType->OBJECT);
											reply_json->Insert("jsonrpc", "2.0");
											reply_json->Insert("result", result_params_json);
											reply_json->Insert("id", result_id_json);

											buffer := reply_json->ToString();
									 		buffer += "\r\n";
											client->WriteString(buffer);
										};

									 }
									 else {
										err_msg := "{\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32601, \"message\": \"Method not found\"}, \"id\": null}";
										client->WriteString(err_msg + "\r\n");
									 };
								}
								else {
									err_msg := "{\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32600, \"message\": \"Invalid Request\"}, \"id\": null}";
									client->WriteString(err_msg + "\r\n");
								};
							}
							else {
								err_msg := "{\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32700, \"message\": \"Parse error\"}, \"id\": null}";
								client->WriteString(err_msg + "\r\n");
							};
						}
						else {
							err_msg := "{\"jsonrpc\": \"2.0\", \"error\": {\"code\": -32600, \"message\": \"Invalid Request\"}, \"id\": null}";
							client->WriteString(err_msg + "\r\n");
						};

						# Hold the connection until the client has read the reply and
						# closed its end, then close. Closing first lost the reply on
						# Windows loopback, where the peer that tears down first has
						# the unread bytes discarded (#669); Accept's receive timeout
						# bounds the wait. Every reply above ends its line, so the
						# client's ReadLine returns without waiting for the close.
						client->ReadLine();
						client->Close();
					}
				};

				params := Collection.Tuple.Pair->New(client, @funcs)<TCPSocket, Hash<String, Func2Ref<JsonElement, JsonElement>>>;
				thread->Execute(params);
			}
		}
	}

	#~
	JSON RPC client
	~#
	class Client {
		@address : String;
		@port : Int;
		@last_error : Collection.Tuple.Pair<IntRef, String>;
		@id : Int;

		#~
		Constructor
		@param address server address
		@param port server port
		```
		client := Data.JSON.RPC.Client->New("localhost", 9090);
		params := JsonParser->TextToElement("{\"a\": 3, \"b\": 4}");
		result := client->Call("add", params);
		if(result <> Nil) { result->GetInt()->PrintLine(); }; # 7
		```
		~#
		New(address : String, port : Int) {
			@address := address;
			@port := port;
			@id := 1;
		}

		#~
		Call remote procedure
		@param func_name name of function to call
		@param func_params function call parameters
		@return JSON response
		```
		client := Data.JSON.RPC.Client->New("localhost", 9090);
		params := JsonParser->TextToElement("{\"x\": 10}");
		result := client->Call("square", params); # invoke remote method
		if(result <> Nil) {
		  result->GetInt()->PrintLine(); # print returned value
		};
		```
		~#
		method : public : Call(func_name : String,  func_params: JsonElement) ~ JsonElement {
			# One connection per call, closed on every path. It was '@server', a
			# field the client never declared, so each call made a new local
			# socket and left it open (#1184 now rejects the undeclared field).
			socket := TCPSocket->New(@address, @port);
			if(socket->IsOpen()) {
				# built by the serializer: the method name was pasted in unescaped
				request_json := JsonElement->New(JsonElement->JsonType->OBJECT);
				request_json->Insert("jsonrpc", "2.0");
				request_json->Insert("method", func_name);
				request_json->Insert("params", func_params);
				request_json->Insert("id", @id);

				buffer := request_json->ToString();
				buffer += "\r\n";
				socket->WriteString(buffer);

				# each call carries its own id, which the reply must echo; the ids cycle
				# from 1 to 512, and a call is answered before the next one is sent
				sent_id := @id;
				@id += 1;
				if(@id > 512) {
					@id := 1;
				};

				response_str := socket->ReadLine();
				socket->Close();

				if(response_str <> Nil) {
					response_json := JsonParser->TextToElement(response_str);
					if(response_json <> Nil) {
						# the reply is for this request: it echoes the id that was sent. An error
						# reply may carry a null id (the server could not read the request's id)
						reply_id := response_json->Get("id");
						id_echoed := false;
						id_null := reply_id = Nil;
						if(reply_id <> Nil) {
							id_null := reply_id->GetType() = JsonElement->JsonType->NULL;
							id_echoed := reply_id->GetType() = JsonElement->JsonType->NUMBER & reply_id->GetInt() = sent_id;
						};

						result_json := response_json->Get("result");
						if(result_json <> Nil) {
							if(<>id_echoed) {
								@last_error := Collection.Tuple.Pair->New(IntRef->New(-32600), "Invalid Response: the id does not match the request")<IntRef, String>;
								return Nil;
							};
							return result_json;
						};

						error_json := response_json->Get("error");
						if(error_json <> Nil) {
							if(<>id_echoed & <>id_null) {
								@last_error := Collection.Tuple.Pair->New(IntRef->New(-32600), "Invalid Response: the id does not match the request")<IntRef, String>;
								return Nil;
							};
							# the server's error need not be an object with a code and a message
							err_id := -32000;
							err_msg := "Server error";
							if(error_json->GetType() = JsonElement->JsonType->OBJECT) {
								code_json := error_json->Get("code");
								if(code_json <> Nil) {
									err_id := code_json->GetInt();
								};

								message_json := error_json->Get("message");
								if(message_json <> Nil) {
									err_msg := message_json->GetString();
								};
							}
							else if(error_json->GetType() = JsonElement->JsonType->STRING) {
								err_msg := error_json->GetString();
							};

							@last_error := Collection.Tuple.Pair->New(err_id, err_msg)<IntRef, String>;
							return Nil;
						};
					}
					else {
						@last_error := Collection.Tuple.Pair->New(IntRef->New(-32700), "Parse error")<IntRef, String>;
						return Nil;
					};
				}
				else {
					@last_error := Collection.Tuple.Pair->New(IntRef->New(-32600), "Invalid Request")<IntRef, String>;
					return Nil;
				};
			};

			@last_error := Collection.Tuple.Pair->New(IntRef->New(-32000), "Server error")<IntRef, String>;
			return Nil;
		}

		#~
		Get the last error
		@return last error
		```
		client := Data.JSON.RPC.Client->New("localhost", 9090);
		params := JsonParser->TextToElement("{}");
		result := client->Call("missing_method", params);
		if(result = Nil) {
		  err := client->GetLastError(); # retrieve error code and message
		  err->GetSecond()->PrintLine();
		};
		```
		~#
		method : public : GetLastError() ~ Collection.Tuple.Pair<IntRef, String> {
			return @last_error;
		}
	}
}
