use Game.SDL2;
use System.API;
use Collection;

#~
OpenGL 3.3 core rendering on top of SDL2. Builds on sdl2.obl for the window and
context; this bundle is the GL side. Compile with -lib sdl2.

Targets the **3.3 core profile**, forward-compatible. That is the highest common
denominator across the platforms Objeck ships: Windows, Linux and macOS desktop
all reach it, and macOS caps at 4.1 core so nothing above 4.1 is portable there.
GLES-only hardware (Raspberry Pi and similar) is out of scope by construction.

Layers, from thinnest to friendliest -- all public, so nothing is capped:

* GL          -- static state operations. Thin, but never per-vertex.
* Shader      -- a linked program from vertex + fragment source.
* Mesh        -- geometry uploaded once into buffer objects, drawn many times.
* Box, Scene  -- a world of boxes: draws itself, and answers collision.

## Why the API is shaped this way

The native call boundary is expensive: the VM resolves each native symbol by
string on EVERY call (GetProcAddress/dlsym) and boxes every argument into a
fresh holder. A 1:1 mapping of OpenGL onto that would be thousands of lookups
and allocations per frame.

So each call here does real work -- 'compile a program from two sources' is one
call, not the five GL calls it decomposes into -- and bulk data crosses as whole
arrays, never element by element. This happens to be exactly what GL 3.3 core
wants anyway: upload geometry once, then draw with few calls.

## Adding a call

One `void fn(VMContext&)` in the OpenGL section of core/lib/sdl/sdl.cpp, and one
method here that names it. See that file's header for the two rules that matter
(positional slot indices, and keeping each call coarse).
~#
bundle Game.OpenGL {
	class : private : Proxy {
		@lib_proxy : static : DllProxy;

		function : GetDllProxy() ~ DllProxy {
			if(@lib_proxy = Nil) {
				@lib_proxy := DllProxy->New("libobjk_sdl");
			};

			return @lib_proxy;
		}
	}

	#~
	Buffer bits for GL->Clear, combined with 'or'.
	~#
	consts ClearBit {
		GL_DEPTH_BUFFER_BIT := 0x00000100,
		GL_STENCIL_BUFFER_BIT := 0x00000400,
		GL_COLOR_BUFFER_BIT := 0x00004000
	}

	#~
	Values returned by GL->GetError.
	~#
	consts ErrorCode {
		GL_NO_ERROR := 0,
		GL_INVALID_ENUM := 0x0500,
		GL_INVALID_VALUE := 0x0501,
		GL_INVALID_OPERATION := 0x0502,
		GL_OUT_OF_MEMORY := 0x0505,
		GL_INVALID_FRAMEBUFFER_OPERATION := 0x0506
	}

	#~
	Capabilities for GL->Enable / GL->Disable.
	~#
	consts Capability {
		GL_CULL_FACE := 0x0B44,
		GL_DEPTH_TEST := 0x0B71,
		GL_BLEND := 0x0BE2,
		GL_SCISSOR_TEST := 0x0C11
	}

	#~
	OpenGL state operations.

	Every method needs a current context (Window->GLCreateContext), and GL state
	is per-context, so these all act on whichever context is current on this
	thread.
	~#
	class GL {
		#~
		Resolve the OpenGL 2.0+ entry points. Call once, after the context is
		current and before creating any Shader, Mesh or Texture2D.

		Everything above GL 1.1 has to be looked up at runtime; that happens in
		native code and is cached, so this is a one-off cost rather than per call.
		@return an empty string on success, or a comma-separated list of the
		functions that could not be resolved -- which is what a context older than
		3.3 looks like from here
		~#
		function : LoadFunctions() ~ String {
			array_args := Base->New[1];
			array_args[0] := Nil;

			Proxy->GetDllProxy()->CallFunction("sdl_gl_load_functions", array_args);

			return array_args[0]->As(String);
		}

		#~
		Enable a capability, e.g. Capability->GL_DEPTH_TEST.
		@param capability the capability to enable
		~#
		function : Enable(capability : Int) ~ Nil {
			array_args := Base->New[1];
			array_args[0] := IntRef->New(capability);

			Proxy->GetDllProxy()->CallFunction("sdl_gl_enable", array_args);
		}

		#~
		Disable a capability.
		@param capability the capability to disable
		~#
		function : Disable(capability : Int) ~ Nil {
			array_args := Base->New[1];
			array_args[0] := IntRef->New(capability);

			Proxy->GetDllProxy()->CallFunction("sdl_gl_disable", array_args);
		}
		#~
		Set the color the next Clear fills the color buffer with. Components are
		clamped to 0.0-1.0.
		@param r red
		@param g green
		@param b blue
		@param a alpha
		~#
		function : ClearColor(r : Float, g : Float, b : Float, a : Float) ~ Nil {
			array_args := Base->New[4];
			array_args[0] := FloatRef->New(r);
			array_args[1] := FloatRef->New(g);
			array_args[2] := FloatRef->New(b);
			array_args[3] := FloatRef->New(a);

			Proxy->GetDllProxy()->CallFunction("sdl_gl_clear_color", array_args);
		}

		#~
		Clear the given buffers.
		@param mask ClearBit values combined with 'or'
		~#
		function : Clear(mask : Int) ~ Nil {
			array_args := Base->New[1];
			array_args[0] := IntRef->New(mask);

			Proxy->GetDllProxy()->CallFunction("sdl_gl_clear", array_args);
		}

		#~
		Clear the color buffer only. Convenience for the common 2D case.
		~#
		function : ClearColorBuffer() ~ Nil {
			Clear(ClearBit->GL_COLOR_BUFFER_BIT);
		}

		#~
		Set the drawable region, in pixels.

		Use Window->GLGetDrawableSize rather than the size passed to Window->New:
		on a high-DPI display the drawable is larger than the window, and using the
		window size renders to a corner.
		@param x left
		@param y bottom (GL's origin is bottom-left, not top-left)
		@param width width in pixels
		@param height height in pixels
		~#
		function : Viewport(x : Int, y : Int, width : Int, height : Int) ~ Nil {
			array_args := Base->New[4];
			array_args[0] := IntRef->New(x);
			array_args[1] := IntRef->New(y);
			array_args[2] := IntRef->New(width);
			array_args[3] := IntRef->New(height);

			Proxy->GetDllProxy()->CallFunction("sdl_gl_viewport", array_args);
		}

		#~
		Read one pixel from the current framebuffer.

		The point of this is assertion: it lets a program (or a test) check that
		something was actually DRAWN, rather than only that nothing crashed. Read
		before swapping buffers, since the swap may discard the back buffer.

		GL's origin is bottom-left, so y counts up from the bottom of the drawable.
		@param x pixel column
		@param y pixel row, counted from the bottom
		@return the pixel packed as 0xAARRGGBB
		~#
		function : ReadPixel(x : Int, y : Int) ~ Int {
			array_args := Base->New[3];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(x);
			array_args[2] := IntRef->New(y);

			Proxy->GetDllProxy()->CallFunction("sdl_gl_read_pixel", array_args);

			value := array_args[0]->As(IntRef);
			return value->Get();
		}

		#~
		Take one error off the GL error queue.

		GL queues errors and each call removes only one, so a single check can hide
		others -- use DrainErrors to empty the queue.
		@return an ErrorCode; GL_NO_ERROR when the queue is empty
		~#
		function : GetError() ~ Int {
			array_args := Base->New[1];
			array_args[0] := IntRef->New();

			Proxy->GetDllProxy()->CallFunction("sdl_gl_get_error", array_args);

			value := array_args[0]->As(IntRef);
			return value->Get();
		}

		#~
		Empty the GL error queue, returning everything that was in it.
		@return the queued error codes, empty when there were none
		~#
		function : DrainErrors() ~ Int[] {
			# GL guarantees the queue drains, but cap the loop anyway: a lost context
			# can make glGetError report a sticky error forever.
			found := Int->New[16];
			count := 0;
			done := false;

			while(<>done & count < 16) {
				code := GetError();
				if(code = ErrorCode->GL_NO_ERROR) {
					done := true;
				}
				else {
					found[count] := code;
					count += 1;
				};
			};

			result := Int->New[count];
			for(i := 0; i < count; i += 1;) {
				result[i] := found[i];
			};

			return result;
		}
	}

	#~
	A linked shader program, built from vertex and fragment source.

	One native call does the whole compile-and-link, so a failure comes back as a
	log rather than as five separate error checks. Check IsOk() before drawing;
	GetLog() carries the compiler's message when it is false.

	```
	shader := Shader->New(vertex_source, fragment_source);
	if(<>shader->IsOk()) {
		shader->GetLog()->ErrorLine();
		return;
	};
	shader->Use();
	```
	~#
	class Shader {
		@program : Int;
		@log : String;

		#~
		Compile and link a program.
		@param vertex_source GLSL vertex shader source, starting with "#version 330 core"
		@param fragment_source GLSL fragment shader source
		~#
		New(vertex_source : String, fragment_source : String) {
			@program := 0;
			@log := "";

			if(vertex_source = Nil | fragment_source = Nil) {
				@log := "shader source was Nil";
				return;
			};

			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := vertex_source;
			array_args[2] := fragment_source;
			array_args[3] := Nil;

			Proxy->GetDllProxy()->CallFunction("sdl_gl_program_create", array_args);

			value := array_args[0]->As(IntRef);
			@program := value->Get();
			@log := array_args[3]->As(String);
		}

		#~
		@return true when the program compiled and linked
		~#
		method : public : IsOk() ~ Bool {
			return @program <> 0;
		}

		#~
		@return the compile/link log; empty when IsOk() is true
		~#
		method : public : GetLog() ~ String {
			return @log;
		}

		#~
		Make this program current for subsequent draws.
		~#
		method : public : Use() ~ Nil {
			if(@program <> 0) {
				array_args := Base->New[1];
				array_args[0] := IntRef->New(@program);
				Proxy->GetDllProxy()->CallFunction("sdl_gl_program_use", array_args);
			};
		}

		#~
		Set a mat4 uniform.
		@param name the uniform's name in the shader
		@param matrix 16 floats in column-major order, as Matrix4 produces
		~#
		method : public : SetMatrix4(name : String, matrix : Float[]) ~ Nil {
			if(@program <> 0 & name <> Nil & matrix <> Nil & matrix->Size() >= 16) {
				array_args := Base->New[3];
				array_args[0] := IntRef->New(@program);
				array_args[1] := name;
				array_args[2] := FloatArrayRef->New(matrix);

				Proxy->GetDllProxy()->CallFunction("sdl_gl_uniform_matrix4", array_args);
			};
		}

		#~
		Set an int uniform. Also how a sampler is pointed at a texture unit.
		@param name the uniform's name in the shader
		@param value the value
		~#
		method : public : SetInt(name : String, value : Int) ~ Nil {
			if(@program <> 0 & name <> Nil) {
				array_args := Base->New[3];
				array_args[0] := IntRef->New(@program);
				array_args[1] := name;
				array_args[2] := IntRef->New(value);

				Proxy->GetDllProxy()->CallFunction("sdl_gl_uniform_int", array_args);
			};
		}

		#~
		Release the program. GL objects are invisible to the collector.
		~#
		method : public : Free() ~ Nil {
			if(@program <> 0) {
				array_args := Base->New[1];
				array_args[0] := IntRef->New(@program);
				Proxy->GetDllProxy()->CallFunction("sdl_gl_program_delete", array_args);
				@program := 0;
			};
		}
	}

	#~
	Geometry uploaded to the GPU once and drawn many times.

	Vertices are interleaved and described by a layout: [3, 2] means each vertex
	is three floats of position followed by two of texture coordinate, bound to
	shader locations 0 and 1 in that order. Indices select vertices, so shared
	corners are stored once.

	Upload cost is paid at construction; Draw() is a single native call regardless
	of how many triangles it draws. That is deliberate -- per-vertex calls across
	the native boundary would be orders of magnitude slower.

	```
	# a unit quad: position(3) + texcoord(2)
	vertices := [-0.5, -0.5, 0.0, 0.0, 0.0,
	              0.5, -0.5, 0.0, 1.0, 0.0,
	              0.5,  0.5, 0.0, 1.0, 1.0,
	             -0.5,  0.5, 0.0, 0.0, 1.0];
	indices := [0, 1, 2, 2, 3, 0];
	mesh := Mesh->New(vertices, indices, [3, 2]);
	```
	~#
	class Mesh {
		@mesh : Int;

		#~
		Upload geometry.
		@param vertices interleaved vertex data
		@param indices triangle indices into the vertex list
		@param layout component count per attribute, in shader location order
		~#
		New(vertices : Float[], indices : Int[], layout : Int[]) {
			@mesh := 0;

			if(vertices = Nil | indices = Nil | layout = Nil) {
				return;
			};

			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := FloatArrayRef->New(vertices);
			array_args[2] := IntArrayRef->New(indices);
			array_args[3] := IntArrayRef->New(layout);

			Proxy->GetDllProxy()->CallFunction("sdl_gl_mesh_create", array_args);

			value := array_args[0]->As(IntRef);
			@mesh := value->Get();
		}

		#~
		@return true when the geometry uploaded
		~#
		method : public : IsOk() ~ Bool {
			return @mesh <> 0;
		}

		#~
		Draw the whole mesh. Bind a Shader first.
		~#
		method : public : Draw() ~ Nil {
			if(@mesh <> 0) {
				array_args := Base->New[1];
				array_args[0] := IntRef->New(@mesh);
				Proxy->GetDllProxy()->CallFunction("sdl_gl_mesh_draw", array_args);
			};
		}

		#~
		Release the buffers.
		~#
		method : public : Free() ~ Nil {
			if(@mesh <> 0) {
				array_args := Base->New[1];
				array_args[0] := IntRef->New(@mesh);
				Proxy->GetDllProxy()->CallFunction("sdl_gl_mesh_delete", array_args);
				@mesh := 0;
			};
		}
	}

	#~
	A 2D texture.

	Built from an SDL Surface, so image decoding stays SDL's job -- Game.SDL2's
	Image->Load already reads PNG and JPEG, and this adds no new dependency.

	```
	surface := Image->Load("crate.png");
	texture := Texture2D->New(surface);
	surface->Free();          # the pixels are on the GPU now
	```
	~#
	class Texture2D {
		@texture : Int;

		#~
		Upload a surface's pixels as a texture. The surface is converted to 32-bit
		RGBA internally, so any format Image->Load produces works.
		@param surface the source surface; still owned by the caller
		~#
		New(surface : Surface) {
			@texture := 0;

			if(surface = Nil | surface->IsNull()) {
				return;
			};

			array_args := Base->New[2];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(surface->GetSurface());

			Proxy->GetDllProxy()->CallFunction("sdl_gl_texture_from_surface", array_args);

			value := array_args[0]->As(IntRef);
			@texture := value->Get();
		}

		#~
		@return true when the texture uploaded
		~#
		method : public : IsOk() ~ Bool {
			return @texture <> 0;
		}

		#~
		Bind to a texture unit, to be read by a sampler uniform set to the same
		unit number.
		@param unit the texture unit, 0 for the first
		~#
		method : public : Bind(unit : Int) ~ Nil {
			if(@texture <> 0) {
				array_args := Base->New[2];
				array_args[0] := IntRef->New(@texture);
				array_args[1] := IntRef->New(unit);
				Proxy->GetDllProxy()->CallFunction("sdl_gl_texture_bind", array_args);
			};
		}

		#~
		Release the texture.
		~#
		method : public : Free() ~ Nil {
			if(@texture <> 0) {
				array_args := Base->New[1];
				array_args[0] := IntRef->New(@texture);
				Proxy->GetDllProxy()->CallFunction("sdl_gl_texture_delete", array_args);
				@texture := 0;
			};
		}
	}

	#~
	4x4 matrices for the usual transform stack, as flat Float[16] in
	COLUMN-MAJOR order -- the layout GL expects, so no transpose happens on
	upload.

	Static functions returning new arrays, following Vector2's style in
	Game.Framework. Multiply is 'apply rhs, then lhs', so a model-view-projection
	is Multiply(projection, Multiply(view, model)).
	~#
	class Matrix4 {
		#~
		@return a new identity matrix
		~#
		function : Identity() ~ Float[] {
			m := Float->New[16];
			m[0] := 1.0; m[5] := 1.0; m[10] := 1.0; m[15] := 1.0;

			return m;
		}

		#~
		Matrix product.
		@param lhs applied second
		@param rhs applied first
		@return lhs * rhs
		~#
		function : Multiply(lhs : Float[], rhs : Float[]) ~ Float[] {
			out := Float->New[16];
			MultiplyInto(out, lhs, rhs);

			return out;
		}

		#~
		Matrix product written into a buffer the caller owns.

		Exists so a draw loop can avoid allocating. Multiply returns a fresh
		Float[16] every call, which at one or two matrices per object per frame is
		hundreds of arrays a second -- enough to trigger a collection mid-frame,
		the classic stutter. Scene uses this with a scratch buffer it keeps.
		@param out destination, at least 16 elements; may not alias lhs or rhs
		@param lhs applied second
		@param rhs applied first
		~#
		function : MultiplyInto(out : Float[], lhs : Float[], rhs : Float[]) ~ Nil {
			if(out = Nil | lhs = Nil | rhs = Nil) {
				return;
			};

			for(col := 0; col < 4; col += 1;) {
				for(row := 0; row < 4; row += 1;) {
					sum := 0.0;
					for(i := 0; i < 4; i += 1;) {
						# column-major: element (row, i) is lhs[i * 4 + row]
						sum += lhs[i * 4 + row] * rhs[col * 4 + i];
					};
					out[col * 4 + row] := sum;
				};
			};
		}

		#~
		Translation matrix.
		@param x x offset
		@param y y offset
		@param z z offset
		@return the matrix
		~#
		function : Translation(x : Float, y : Float, z : Float) ~ Float[] {
			m := Identity();
			m[12] := x; m[13] := y; m[14] := z;

			return m;
		}

		#~
		Uniform scale matrix.
		@param s scale factor
		@return the matrix
		~#
		function : Scale(s : Float) ~ Float[] {
			m := Float->New[16];
			m[0] := s; m[5] := s; m[10] := s; m[15] := 1.0;

			return m;
		}

		#~
		Non-uniform scale. This is what lets one unit-cube mesh become every box in
		a scene -- walls, floors and obstacles -- instead of uploading a separate
		mesh per shape.
		@param x scale along x
		@param y scale along y
		@param z scale along z
		@return the matrix
		~#
		function : ScaleXYZ(x : Float, y : Float, z : Float) ~ Float[] {
			m := Float->New[16];
			m[0] := x; m[5] := y; m[10] := z; m[15] := 1.0;

			return m;
		}

		#~
		Rotation about the X axis.
		@param radians angle in radians
		@return the matrix
		~#
		function : RotationX(radians : Float) ~ Float[] {
			c := radians->Cos();
			s := radians->Sin();

			m := Identity();
			m[5] := c;  m[6] := s;
			m[9] := s * -1.0; m[10] := c;

			return m;
		}

		#~
		Rotation about the Y axis.
		@param radians angle in radians
		@return the matrix
		~#
		function : RotationY(radians : Float) ~ Float[] {
			c := radians->Cos();
			s := radians->Sin();

			m := Identity();
			m[0] := c; m[2] := s * -1.0;
			m[8] := s; m[10] := c;

			return m;
		}

		#~
		Rotation about the Z axis.
		@param radians angle in radians
		@return the matrix
		~#
		function : RotationZ(radians : Float) ~ Float[] {
			c := radians->Cos();
			s := radians->Sin();

			m := Identity();
			m[0] := c;  m[1] := s;
			m[4] := s * -1.0; m[5] := c;

			return m;
		}

		#~
		Right-handed perspective projection, mapping to GL's -1..1 depth range.
		@param fov_radians vertical field of view
		@param aspect width divided by height
		@param near near clip distance; must be greater than 0
		@param far far clip distance
		@return the matrix
		~#
		function : Perspective(fov_radians : Float, aspect : Float, near : Float, far : Float) ~ Float[] {
			m := Float->New[16];

			f := 1.0 / (fov_radians / 2.0)->Tan();
			m[0] := f / aspect;
			m[5] := f;
			m[10] := (far + near) / (near - far);
			m[11] := -1.0;
			m[14] := (2.0 * far * near) / (near - far);

			return m;
		}

		#~
		A view matrix that steps back along +Z and looks at the origin. The
		smallest useful camera; use LookAt for one that can move.
		@param distance how far back to stand
		@return the matrix
		~#
		function : LookAtOrigin(distance : Float) ~ Float[] {
			return Translation(0.0, 0.0, distance * -1.0);
		}

		#~
		A right-handed view matrix for a camera anywhere, looking anywhere.

		This is what lets a camera orbit or track a subject rather than sit on the
		+Z axis. Degenerate input -- eye equal to target, or an up vector parallel
		to the view direction -- yields identity rather than NaNs.
		@param eye where the camera is
		@param target what it looks at
		@param up which way is up, usually (0, 1, 0)
		@return the view matrix
		~#
		function : LookAt(eye : Vector3, target : Vector3, up : Vector3) ~ Float[] {
			if(eye = Nil | target = Nil | up = Nil) {
				return Identity();
			};

			# forward points FROM the target TO the eye in a right-handed system
			forward := Vector3->Subtract(eye, target);
			if(forward->Length() = 0.0) {
				return Identity();
			};
			forward := forward->Normalized();

			side := Vector3->Cross(up, forward);
			if(side->Length() = 0.0) {
				# up was parallel to the view direction; no valid basis exists
				return Identity();
			};
			side := side->Normalized();

			# recomputed so the basis is orthonormal even if 'up' was not square on
			true_up := Vector3->Cross(forward, side);

			m := Float->New[16];
			m[0] := side->GetX();    m[4] := side->GetY();    m[8]  := side->GetZ();
			m[1] := true_up->GetX(); m[5] := true_up->GetY(); m[9]  := true_up->GetZ();
			m[2] := forward->GetX(); m[6] := forward->GetY(); m[10] := forward->GetZ();

			m[12] := Vector3->Dot(side, eye) * -1.0;
			m[13] := Vector3->Dot(true_up, eye) * -1.0;
			m[14] := Vector3->Dot(forward, eye) * -1.0;
			m[15] := 1.0;

			return m;
		}
	}

	#~
	A 3D vector, for camera and scene math.

	Mirrors Game.Framework's Vector2: mutating methods on an instance, plus
	static functions that return new values. Immutable-style helpers are named
	with a past participle (Normalized) to distinguish them from the in-place
	form (Normalize).
	~#
	class Vector3 {
		@x : Float;
		@y : Float;
		@z : Float;

		New(x : Float, y : Float, z : Float) {
			@x := x;
			@y := y;
			@z := z;
		}

		method : public : GetX() ~ Float { return @x; }
		method : public : GetY() ~ Float { return @y; }
		method : public : GetZ() ~ Float { return @z; }

		method : public : Set(x : Float, y : Float, z : Float) ~ Nil {
			@x := x;
			@y := y;
			@z := z;
		}

		#~
		@return the vector's length
		~#
		method : public : Length() ~ Float {
			return (@x * @x + @y * @y + @z * @z)->Sqrt();
		}

		#~
		Scale to unit length in place. A zero vector is left alone.
		~#
		method : public : Normalize() ~ Nil {
			length := Length();
			if(length <> 0.0) {
				@x /= length;
				@y /= length;
				@z /= length;
			};
		}

		#~
		@return a new unit-length copy; a zero vector comes back unchanged
		~#
		method : public : Normalized() ~ Vector3 {
			length := Length();
			if(length = 0.0) {
				return Vector3->New(@x, @y, @z);
			};

			return Vector3->New(@x / length, @y / length, @z / length);
		}

		#~
		@return the vector as a flat array, e.g. for a vec3 uniform
		~#
		method : public : ToArray() ~ Float[] {
			# built element-wise on purpose: an array literal in this language takes
			# literals, so [@x, @y, @z] does not parse
			values := Float->New[3];
			values[0] := @x;
			values[1] := @y;
			values[2] := @z;

			return values;
		}

		#~
		@param lhs first vector
		@param rhs second vector
		@return lhs + rhs
		~#
		function : Add(lhs : Vector3, rhs : Vector3) ~ Vector3 {
			return Vector3->New(lhs->GetX() + rhs->GetX(), lhs->GetY() + rhs->GetY(), lhs->GetZ() + rhs->GetZ());
		}

		#~
		@param lhs first vector
		@param rhs second vector
		@return lhs - rhs
		~#
		function : Subtract(lhs : Vector3, rhs : Vector3) ~ Vector3 {
			return Vector3->New(lhs->GetX() - rhs->GetX(), lhs->GetY() - rhs->GetY(), lhs->GetZ() - rhs->GetZ());
		}

		#~
		@param v the vector
		@param scale the factor
		@return v * scale
		~#
		function : Scale(v : Vector3, scale : Float) ~ Vector3 {
			return Vector3->New(v->GetX() * scale, v->GetY() * scale, v->GetZ() * scale);
		}

		#~
		@param lhs first vector
		@param rhs second vector
		@return the dot product
		~#
		function : Dot(lhs : Vector3, rhs : Vector3) ~ Float {
			return lhs->GetX() * rhs->GetX() + lhs->GetY() * rhs->GetY() + lhs->GetZ() * rhs->GetZ();
		}

		#~
		@param lhs first vector
		@param rhs second vector
		@return the cross product, lhs x rhs
		~#
		function : Cross(lhs : Vector3, rhs : Vector3) ~ Vector3 {
			cx := lhs->GetY() * rhs->GetZ() - lhs->GetZ() * rhs->GetY();
			cy := lhs->GetZ() * rhs->GetX() - lhs->GetX() * rhs->GetZ();
			cz := lhs->GetX() * rhs->GetY() - lhs->GetY() * rhs->GetX();

			return Vector3->New(cx, cy, cz);
		}
	}

	#~
	A first-person camera: a position plus a yaw/pitch heading, producing the view
	matrix each frame.

	Yaw and pitch are held instead of a look-at target because that is what input
	drives -- turning is a change in yaw, not a new target point. Pitch is clamped
	just short of straight up/down, since at exactly vertical the view direction
	becomes parallel to 'up' and no camera basis exists.

	Movement is horizontal: MoveForward walks along the heading with the pitch
	ignored, so looking down does not sink you into the floor. That is what a
	walking character wants; a flying one would use ForwardVector directly.

	```
	camera := Camera->New(Vector3->New(0.0, 1.7, 5.0));   # eye height
	camera->Turn(0.03);
	camera->MoveForward(0.1);
	shader->SetMatrix4("view", camera->GetViewMatrix());
	```
	~#
	class Camera {
		@position : Vector3;
		@yaw : Float;
		@pitch : Float;

		#~
		@param position where the eye starts
		~#
		New(position : Vector3) {
			@position := position;
			@yaw := 0.0;
			@pitch := 0.0;
		}

		method : public : GetPosition() ~ Vector3 {
			return @position;
		}

		method : public : GetYaw() ~ Float {
			return @yaw;
		}

		method : public : GetPitch() ~ Float {
			return @pitch;
		}

		#~
		Place the eye directly.
		@param position the new position
		~#
		method : public : SetPosition(position : Vector3) ~ Nil {
			@position := position;
		}

		#~
		Turn left or right.
		@param radians positive turns one way, negative the other
		~#
		method : public : Turn(radians : Float) ~ Nil {
			@yaw += radians;
		}

		#~
		Look up or down. Clamped to just under +/- 90 degrees, because at exactly
		vertical the view direction is parallel to 'up' and the camera basis
		collapses.
		@param radians positive looks up
		~#
		method : public : Look(radians : Float) ~ Nil {
			limit := Float->Pi() / 2.0 - 0.01;
			@pitch += radians;
			if(@pitch > limit) {
				@pitch := limit;
			};
			if(@pitch < limit * -1.0) {
				@pitch := limit * -1.0;
			};
		}

		#~
		The direction the camera is looking, including pitch.
		@return a unit vector
		~#
		method : public : ForwardVector() ~ Vector3 {
			cos_pitch := @pitch->Cos();

			return Vector3->New(@yaw->Sin() * cos_pitch, @pitch->Sin(), @yaw->Cos() * cos_pitch * -1.0);
		}

		#~
		The heading on the ground plane, pitch ignored.
		@return a unit vector with no vertical component
		~#
		method : public : GroundForward() ~ Vector3 {
			return Vector3->New(@yaw->Sin(), 0.0, @yaw->Cos() * -1.0);
		}

		#~
		The camera's right-hand direction on the ground plane.
		@return a unit vector with no vertical component
		~#
		method : public : GroundRight() ~ Vector3 {
			return Vector3->New(@yaw->Cos(), 0.0, @yaw->Sin());
		}

		#~
		Walk along the heading. Vertical component ignored, so looking down does not
		push the eye through the floor.
		@param distance how far; negative walks backwards
		~#
		method : public : MoveForward(distance : Float) ~ Nil {
			step := Vector3->Scale(GroundForward(), distance);
			@position := Vector3->Add(@position, step);
		}

		#~
		Strafe sideways.
		@param distance how far; negative goes left
		~#
		method : public : MoveRight(distance : Float) ~ Nil {
			step := Vector3->Scale(GroundRight(), distance);
			@position := Vector3->Add(@position, step);
		}

		#~
		The view matrix for this frame.
		@return a 4x4 view matrix, column-major
		~#
		method : public : GetViewMatrix() ~ Float[] {
			target := Vector3->Add(@position, ForwardVector());

			return Matrix4->LookAt(@position, target, Vector3->New(0.0, 1.0, 0.0));
		}
	}


	#~
	An axis-aligned box in the world: where it is, how big it is, what it looks
	like, and whether you can walk through it.

	The unit cube mesh is shared by every Box; the box only supplies a transform.
	That is what keeps a scene of hundreds of boxes down to one uploaded mesh.

	The model matrix is computed once and cached, because a static prop's
	transform does not change between frames. Moving the box invalidates it.
	~#
	class Box {
		@center : Vector3;
		@half : Vector3;
		@texture : Texture2D;
		@solid : Bool;
		@model : Float[];

		#~
		@param center the box's centre
		@param half half-extents on each axis, so a 2x2x2 cube has half 1,1,1
		@param texture the texture to draw it with; may be Nil
		~#
		New(center : Vector3, half : Vector3, texture : Texture2D) {
			@center := center;
			@half := half;
			@texture := texture;
			@solid := true;
			@model := Nil;
		}

		method : public : GetCenter() ~ Vector3 { return @center; }
		method : public : GetHalf() ~ Vector3 { return @half; }
		method : public : GetTexture() ~ Texture2D { return @texture; }

		#~
		Whether this box blocks movement. Floors and ceilings are usually set
		non-solid: they are drawn but should not stop a walking character.
		@return true when the box blocks
		~#
		method : public : IsSolid() ~ Bool { return @solid; }

		#~
		@param solid false to make the box scenery that does not block
		~#
		method : public : SetSolid(solid : Bool) ~ Nil { @solid := solid; }

		#~
		Move the box, discarding the cached transform.
		@param center the new centre
		~#
		method : public : SetCenter(center : Vector3) ~ Nil {
			@center := center;
			@model := Nil;
		}

		#~
		The box's model matrix: translate then scale, cached after the first call.
		@return a 4x4 model matrix, column-major
		~#
		method : public : GetModelMatrix() ~ Float[] {
			if(@model = Nil) {
				translation := Matrix4->Translation(@center->GetX(), @center->GetY(), @center->GetZ());
				scale := Matrix4->ScaleXYZ(@half->GetX(), @half->GetY(), @half->GetZ());
				@model := Matrix4->Multiply(translation, scale);
			};

			return @model;
		}

		#~
		Whether a circle in plan view overlaps this box.

		Deliberately 2D: a walking character should not be blocked by something
		overhead, and testing the full 3D box would do exactly that. Corners are
		treated conservatively -- a near-miss at a corner counts as a hit, which is
		the right way to be wrong about a wall.
		@param x circle centre x
		@param z circle centre z
		@param radius circle radius
		@return true when they overlap
		~#
		method : public : OverlapsXZ(x : Float, z : Float, radius : Float) ~ Bool {
			gap_x := (x - @center->GetX())->Abs() - @half->GetX();
			gap_z := (z - @center->GetZ())->Abs() - @half->GetZ();

			return gap_x < radius & gap_z < radius;
		}
	}

	#~
	A world of boxes that draws itself and answers collision queries.

	This is the layer that keeps a 3D program from hand-rolling parallel arrays
	and index arithmetic. Add boxes, then call Draw once per frame and Blocked
	whenever something wants to move.

	```
	scene := Scene->New(cube_mesh, shader);
	scene->AddBox(Vector3->New(0.0, 1.0, -4.0), Vector3->New(1.0, 1.0, 1.0), crate);
	...
	scene->Draw(view_projection);
	if(<>scene->Blocked(new_x, new_z, 0.35)) { ... };
	```

	## Two things it does that a naive loop would not

	It only rebinds a texture when the next box uses a different one, so a scene
	grouped by texture costs a handful of binds rather than one per box.

	It draws through Matrix4->MultiplyInto with a scratch buffer it owns, so a
	frame allocates nothing. The obvious version -- Multiply per box per frame --
	returns a fresh Float[16] each time, which is hundreds of arrays a second and
	enough to collect mid-frame. Objeck's SDL renderer already had to be rewritten
	once for exactly this reason.
	~#
	class Scene {
		@boxes : Vector<Box>;
		@mesh : Mesh;
		@shader : Shader;
		# scratch for the per-box model-view-projection, reused every draw
		@mvp : Float[];

		#~
		@param mesh the shared unit-cube mesh every box is drawn with
		@param shader the program to draw with; Draw sets its "mvp" mat4 uniform
		~#
		New(mesh : Mesh, shader : Shader) {
			@mesh := mesh;
			@shader := shader;
			@boxes := Vector->New()<Box>;
			@mvp := Float->New[16];
		}

		#~
		@return how many boxes are in the scene
		~#
		method : public : GetCount() ~ Int {
			return @boxes->Size();
		}

		#~
		@param index which box
		@return the box, or Nil when out of range
		~#
		method : public : Get(index : Int) ~ Box {
			if(index < 0 | index >= @boxes->Size()) {
				return Nil;
			};

			return @boxes->Get(index);
		}

		#~
		Add an existing box.
		@param box the box
		@return the same box, for chaining
		~#
		method : public : Add(box : Box) ~ Box {
			if(box <> Nil) {
				@boxes->AddBack(box);
			};

			return box;
		}

		#~
		Build and add a box.
		@param center the box's centre
		@param half half-extents on each axis
		@param texture the texture to draw it with
		@return the new box, so it can be made non-solid or moved later
		~#
		method : public : AddBox(center : Vector3, half : Vector3, texture : Texture2D) ~ Box {
			return Add(Box->New(center, half, texture));
		}

		#~
		Draw every box.

		Binds the shader, then for each box sets the "mvp" uniform and draws the
		shared mesh. Rebinds a texture only when it changes from the previous box.
		@param view_projection the combined view and projection matrix for this frame
		~#
		method : public : Draw(view_projection : Float[]) ~ Nil {
			if(@mesh = Nil | @shader = Nil | view_projection = Nil) {
				return;
			};

			@shader->Use();

			# Nil on its own infers as Nil, not as Texture2D, so the comparison below
			# will not type-check without the cast.
			last_texture := Nil->As(Texture2D);
			each(i : @boxes) {
				box := @boxes->Get(i);

				texture := box->GetTexture();
				if(texture <> Nil & texture <> last_texture) {
					texture->Bind(0);
					last_texture := texture;
				};

				Matrix4->MultiplyInto(@mvp, view_projection, box->GetModelMatrix());
				@shader->SetMatrix4("mvp", @mvp);
				@mesh->Draw();
			};
		}

		#~
		Whether a circle in plan view hits any SOLID box.
		@param x circle centre x
		@param z circle centre z
		@param radius circle radius
		@return true when the position is blocked
		~#
		method : public : Blocked(x : Float, z : Float, radius : Float) ~ Bool {
			each(i : @boxes) {
				box := @boxes->Get(i);
				if(box->IsSolid() & box->OverlapsXZ(x, z, radius)) {
					return true;
				};
			};

			return false;
		}

		#~
		Drop every box. Does NOT free the shared mesh, shader or textures -- those
		were passed in and belong to the caller.
		~#
		method : public : Clear() ~ Nil {
			@boxes->Empty();
		}
	}

}
