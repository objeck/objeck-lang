use Collection;
use System.API;
use System.ML;
use System.ML.Lab;

#~
Convolutional neural networks on the CPU: layers with forward and backward passes, the Adam and SGD optimizers, an image dataset with train, validation and test splits and on-the-fly augmentation, and a training loop that records the metrics of every epoch. The layers are native (libobjk_ml, Eigen plus a small thread pool); this library holds the model API, the dataset and the trainer. Compile with -lib ml_cnn,ml,ml_lab,opencv,csv,json,cipher,gen_collect. Design, validation and measurements: docs/AI.md, "Convolutional networks (System.ML.Cnn)".
~#
bundle System.ML.Cnn {
	class : private : Proxy {
		@lib_proxy : static : DllProxy;

		function : GetDllProxy() ~ DllProxy {
			if(@lib_proxy = Nil) {
				@lib_proxy := DllProxy->New("libobjk_ml");
			};

			return @lib_proxy;
		}
	}

	#~
	How a convolution treats the image border. VALID uses no padding, so the output is smaller than the input; SAME pads so that, with a stride of 1, the output is as large as the input.
	~#
	enum Padding {
		VALID,
		SAME
	}

	#~
	How the weights of a Conv and Dense layer start out. GLOROT is Glorot (Xavier) uniform, the default of Keras: limit sqrt(6 / (fan_in + fan_out)). KAIMING is He uniform, limit sqrt(6 / fan_in), for ReLU networks. Biases always start at zero. The draws come from the model's seed, so the same seed gives the same weights on every platform.
	~#
	enum Initializer {
		GLOROT,
		KAIMING
	}

	#~
	Process-wide settings of the native layers and a seeded shuffle.
	~#
	class CnnRuntime {
		@fn_ml_cnn_threads : static : String;
		@fn_ml_cnn_permutation : static : String;

		#~
		Sets how many threads the layers use (the batch is spread over them, one sample per task). The default is the number of hardware threads, at most 8.
		@param count threads, 1 to 64
		@return the thread count now in force
		~#
		function : SetThreads(count : Int) ~ Int {
			if(count < 1) {
				return GetThreads();
			};

			array_args := Base->New[2];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(count);
			if(@fn_ml_cnn_threads = Nil) { @fn_ml_cnn_threads := "ml_cnn_threads"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_threads, array_args);

			return array_args[0]->As(IntRef)->Get();
		}

		#~
		The number of threads the layers use.
		@return thread count
		~#
		function : GetThreads() ~ Int {
			array_args := Base->New[2];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(0);
			if(@fn_ml_cnn_threads = Nil) { @fn_ml_cnn_threads := "ml_cnn_threads"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_threads, array_args);

			return array_args[0]->As(IntRef)->Get();
		}

		#~
		A seeded shuffle of 0 .. n - 1 (Fisher-Yates), the same on every platform.
		@param n how many values, 1 or more
		@param seed shuffle seed
		@return the permutation, or Nil when n is below 1
		~#
		function : Permutation(n : Int, seed : Int) ~ Int[] {
			array_args := Base->New[3];
			array_args[0] := IntArrayRef->New();
			array_args[1] := IntRef->New(n);
			array_args[2] := IntRef->New(seed);
			if(@fn_ml_cnn_permutation = Nil) { @fn_ml_cnn_permutation := "ml_cnn_permutation"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_permutation, array_args);

			return array_args[0]->As(IntArrayRef)->Get();
		}
	}

	#~
	The random changes applied to a TRAINING image as it is loaded: a horizontal flip, a rotation by a small random angle (bilinear, zeros outside) and a brightness factor (the pixels are multiplied and clipped to 0 .. 1). Each fires with its own probability. Whether it fires, and its value, depend only on the seed and the image's position in the epoch, so a run repeats exactly.

```
aug := Augmentation->New();
aug->SetFlip(0.5);                  # half the images are mirrored
aug->SetRotation(0.3, 10.0);        # 30% are turned by up to +-10 degrees
aug->SetBrightness(0.3, 0.8, 1.2);  # 30% are scaled by 0.8 .. 1.2
```
	~#
	class Augmentation {
		@config : Float[];

		#~
		Creates a configuration that changes nothing.
		~#
		New() {
			@config := Float->New[9];
			@config[5] := 1.0;
			@config[6] := 1.0;
		}

		#~
		Horizontal flip.
		@param probability chance for each image, 0.0 to 1.0
		~#
		method : public : SetFlip(probability : Float) ~ Nil {
			@config[1] := Clamp(probability, 0.0, 1.0);
			@config[0] := 1.0;
		}

		#~
		Rotation about the centre by an angle drawn uniformly from -max_degrees .. max_degrees.
		@param probability chance for each image, 0.0 to 1.0
		@param max_degrees the largest angle in degrees
		~#
		method : public : SetRotation(probability : Float, max_degrees : Float) ~ Nil {
			@config[2] := Clamp(probability, 0.0, 1.0);
			@config[3] := Float->Abs(max_degrees);
			@config[0] := 1.0;
		}

		#~
		Brightness: the pixels are multiplied by a factor drawn uniformly from min_factor .. max_factor, then clipped to 0 .. 1.
		@param probability chance for each image, 0.0 to 1.0
		@param min_factor the smallest factor, above 0
		@param max_factor the largest factor
		~#
		method : public : SetBrightness(probability : Float, min_factor : Float, max_factor : Float) ~ Nil {
			@config[4] := Clamp(probability, 0.0, 1.0);
			@config[5] := Float->Min(min_factor, max_factor);
			@config[6] := Float->Max(min_factor, max_factor);
			@config[0] := 1.0;
		}

		#~
		The seed of the random draws.
		@param seed seed
		~#
		method : public : SetSeed(seed : Int) ~ Nil {
			@config[7] := seed->As(Float);
		}

		#~
		Is any augmentation switched on?
		@return true if so
		~#
		method : public : IsEnabled() ~ Bool {
			return @config[0] <> 0.0;
		}

		# the nine values the native stage call reads, with this image's key
		method : public : GetConfig(key : Int) ~ Float[] {
			@config[8] := key->As(Float);
			return @config;
		}

		function : Clamp(v : Float, lo : Float, hi : Float) ~ Float {
			if(v < lo) {
				return lo;
			};
			if(v > hi) {
				return hi;
			};

			return v;
		}
	}

	#~
	A convolutional network for binary classification: a stack of layers, in NCHW float32, ending in one logit per image, trained with binary cross-entropy on logits and the Adam or SGD optimizer. Build it with the Add methods, then Compile.

	Layers: Conv (stride, VALID or SAME padding, bias; im2col and a matrix multiply), MaxPool, ReLU, Flatten, Dense and Dropout (inverted: the survivors are scaled by 1 / (1 - rate) in training, and evaluation is the identity). The last layer must give one value per image, so a model ends in AddDense(1). Predict returns sigmoid of that logit, the probability of class 1.

	Images are Float[] of whole images laid end to end, each channels x height x width (planes, not interleaved) with values in 0 .. 1; labels are 0.0 or 1.0. Nothing here ends the program on bad input: a method answers false, -1.0 or Nil (or 0 for a count), and GetError() says why.

	A model holds native memory, so call Close() when done with it. Not thread-safe: one thread at a time per model.

```
model := CnnModel->New(3, 64, 64, 42);
model->AddConv(16, 3, 1, Padding->VALID);
model->AddReLU();
model->AddMaxPool(2);
model->AddFlatten();
model->AddDense(1);
model->Compile(0.001);
loss := model->TrainBatch(images, labels);
probabilities := model->Predict(images);
```
	~#
	class CnnModel {
		@fn_ml_cnn_create : static : String;
		@fn_ml_cnn_release : static : String;
		@fn_ml_cnn_add : static : String;
		@fn_ml_cnn_compile : static : String;
		@fn_ml_cnn_set : static : String;
		@fn_ml_cnn_info : static : String;
		@fn_ml_cnn_text : static : String;
		@fn_ml_cnn_train : static : String;
		@fn_ml_cnn_predict : static : String;
		@fn_ml_cnn_vector : static : String;
		@fn_ml_cnn_set_weights : static : String;
		@fn_ml_cnn_file : static : String;
		@fn_ml_cnn_stage : static : String;
		@fn_ml_cnn_staged : static : String;
		@fn_ml_cnn_staged_predict : static : String;
		@handle : Int;
		@channels : Int;
		@height : Int;
		@width : Int;
		@seed : Int;
		@init : Initializer;
		@error : String;
		@no_augment : Augmentation;

		#~
		Creates an empty float32 model.
		@param channels input channels: 1 (grayscale) or 3 (RGB) for images staged from files or pixels, up to 4096 for Float[] batches
		@param height image height
		@param width image width
		@param seed seed of the weights and of the dropout masks
		~#
		New(channels : Int, height : Int, width : Int, seed : Int) {
			Create(channels, height, width, seed, false);
		}

		New(channels : Int, height : Int, width : Int, seed : Int, reference : Bool) {
			Create(channels, height, width, seed, reference);
		}

		method : Create(channels : Int, height : Int, width : Int, seed : Int, reference : Bool) ~ Nil {
			@channels := channels;
			@height := height;
			@width := width;
			@seed := seed;
			@init := Initializer->GLOROT;
			@error := "";
			@no_augment := Augmentation->New();

			array_args := Base->New[6];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(channels);
			array_args[2] := IntRef->New(height);
			array_args[3] := IntRef->New(width);
			array_args[4] := IntRef->New(seed);
			array_args[5] := IntRef->New(reference ? 1 : 0);
			if(@fn_ml_cnn_create = Nil) { @fn_ml_cnn_create := "ml_cnn_create"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_create, array_args);
			@handle := array_args[0]->As(IntRef)->Get();
			if(@handle = 0) {
				@error := "the input must have 1 to 4096 channels, at least 1 x 1, and at most 100M values";
			};
		}

		#~
		Creates an empty float64 model. It is the same code in double precision, slower, meant for checking gradients: in float32 a central difference cannot resolve a gradient better than about 1e-3, in float64 it agrees with backpropagation to about 1e-8.
		@param channels input channels
		@param height image height
		@param width image width
		@param seed seed of the weights and of the dropout masks
		@return the model
		~#
		function : NewReference(channels : Int, height : Int, width : Int, seed : Int) ~ CnnModel {
			return CnnModel->New(channels, height, width, seed, true);
		}

		#~
		The baseline of the deepfake-detection study, compiled and ready to train: conv_blocks blocks of Conv(3x3, VALID) + ReLU + MaxPool(2) with 16, 32, 64, ... filters, then Flatten, Dense(dense_units) + ReLU, Dropout and Dense(1), trained with Adam. At 224 x 224 with three blocks and 128 dense units it has 5,561,633 parameters.
		@param image_size images are image_size x image_size RGB
		@param conv_blocks number of convolution blocks, 1 or more
		@param dropout dropout rate in [0, 1)
		@param dense_units width of the hidden dense layer
		@param learning_rate Adam learning rate
		@param seed seed
		@return the model, or Nil when the architecture does not fit the image size
		~#
		function : Baseline(image_size : Int, conv_blocks : Int, dropout : Float, dense_units : Int, learning_rate : Float, seed : Int) ~ CnnModel {
			model := CnnModel->New(3, image_size, image_size, seed);
			filters := 16;
			ok := conv_blocks > 0;
			for(i := 0; ok & i < conv_blocks; i += 1;) {
				ok := model->AddConv(filters, 3, 1, Padding->VALID);
				ok := ok & model->AddReLU();
				ok := ok & model->AddMaxPool(2);
				filters *= 2;
			};
			ok := ok & model->AddFlatten();
			ok := ok & model->AddDense(dense_units);
			ok := ok & model->AddReLU();
			ok := ok & model->AddDropout(dropout);
			ok := ok & model->AddDense(1);
			ok := ok & model->Compile(learning_rate);
			if(ok = false) {
				model->Close();
				return Nil;
			};

			return model;
		}

		#~
		Is the model usable (was the native model created)?
		@return true if valid
		~#
		method : public : IsValid() ~ Bool {
			return @handle <> 0;
		}

		#~
		Why the last call answered false, -1.0 or Nil.
		@return the reason, empty before any refusal
		~#
		method : public : GetError() ~ String {
			if(@handle = 0) {
				return @error;
			};

			return Text(0);
		}

		method : Text(what : Int) ~ String {
			array_args := Base->New[3];
			array_args[0] := Nil;
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(what);
			if(@fn_ml_cnn_text = Nil) { @fn_ml_cnn_text := "ml_cnn_text"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_text, array_args);
			text := array_args[0]->As(String);

			return text = Nil ? "" : text;
		}

		method : Info(what : Int) ~ Int {
			array_args := Base->New[3];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(what);
			if(@fn_ml_cnn_info = Nil) { @fn_ml_cnn_info := "ml_cnn_info"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_info, array_args);

			return array_args[0]->As(IntRef)->Get();
		}

		method : AddLayer(kind : Int, a : Int, b : Int, c : Int, d : Int, rate : Float) ~ Bool {
			if(@handle = 0) {
				return false;
			};

			array_args := Base->New[8];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(kind);
			array_args[3] := IntRef->New(a);
			array_args[4] := IntRef->New(b);
			array_args[5] := IntRef->New(c);
			array_args[6] := IntRef->New(d);
			array_args[7] := FloatRef->New(rate);
			if(@fn_ml_cnn_add = Nil) { @fn_ml_cnn_add := "ml_cnn_add"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_add, array_args);

			return array_args[0]->As(IntRef)->Get() <> 0;
		}

		#~
		Adds a 2D convolution (cross-correlation) with a square kernel and a bias per filter.
		@param filters output channels
		@param kernel kernel height and width
		@param stride step between windows
		@param padding VALID or SAME
		@return true if added, false if refused (see GetError)
		~#
		method : public : AddConv(filters : Int, kernel : Int, stride : Int, padding : Padding) ~ Bool {
			return AddLayer(0, filters, kernel, stride, padding = Padding->SAME ? 1 : 0, 0.0);
		}

		#~
		Adds a convolution with stride 1 and no padding.
		@param filters output channels
		@param kernel kernel height and width
		@return true if added
		~#
		method : public : AddConv(filters : Int, kernel : Int) ~ Bool {
			return AddConv(filters, kernel, 1, Padding->VALID);
		}

		#~
		Adds max pooling over size x size windows that step by the window size.
		@param size window size
		@return true if added
		~#
		method : public : AddMaxPool(size : Int) ~ Bool {
			return AddLayer(1, size, size, 0, 0, 0.0);
		}

		#~
		Adds max pooling.
		@param size window size
		@param stride step between windows
		@return true if added
		~#
		method : public : AddMaxPool(size : Int, stride : Int) ~ Bool {
			return AddLayer(1, size, stride, 0, 0, 0.0);
		}

		#~
		Adds a ReLU activation.
		@return true if added
		~#
		method : public : AddReLU() ~ Bool {
			return AddLayer(2, 0, 0, 0, 0, 0.0);
		}

		#~
		Adds a flatten layer: channels x height x width become one vector per image.
		@return true if added
		~#
		method : public : AddFlatten() ~ Bool {
			return AddLayer(3, 0, 0, 0, 0, 0.0);
		}

		#~
		Adds a fully connected layer. Any input shape is read as one flat vector per image.
		@param units output width
		@return true if added
		~#
		method : public : AddDense(units : Int) ~ Bool {
			return AddLayer(4, units, 0, 0, 0, 0.0);
		}

		#~
		Adds inverted dropout. Its masks come from the model seed, so training repeats exactly.
		@param rate fraction of activations to zero, in [0, 1)
		@return true if added
		~#
		method : public : AddDropout(rate : Float) ~ Bool {
			return AddLayer(5, 0, 0, 0, 0, rate);
		}

		#~
		Chooses how the weights start. Call it before Compile; it has no effect afterwards.
		@param init GLOROT (the default) or KAIMING
		~#
		method : public : SetInitializer(init : Initializer) ~ Nil {
			@init := init;
		}

		#~
		Initializes the weights from the seed and sets the Adam optimizer (beta1 0.9, beta2 0.999, epsilon 1e-8, as in PyTorch and Keras).
		@param learning_rate step size, above 0
		@return true if compiled, false if the model is empty, does not end in one value per image, or was compiled already
		~#
		method : public : Compile(learning_rate : Float) ~ Bool {
			return CompileWith(1, learning_rate, 0.9, 0.999, 1.0e-8, 0.0);
		}

		#~
		Compiles with Adam and the given moment decays.
		@param learning_rate step size, above 0
		@param beta1 first-moment decay, [0, 1)
		@param beta2 second-moment decay, [0, 1)
		@param epsilon added to the denominator, above 0
		@return true if compiled
		~#
		method : public : CompileAdam(learning_rate : Float, beta1 : Float, beta2 : Float, epsilon : Float) ~ Bool {
			return CompileWith(1, learning_rate, beta1, beta2, epsilon, 0.0);
		}

		#~
		Compiles with stochastic gradient descent.
		@param learning_rate step size, above 0
		@param momentum momentum in [0, 1), 0.0 for plain SGD
		@return true if compiled
		~#
		method : public : CompileSgd(learning_rate : Float, momentum : Float) ~ Bool {
			return CompileWith(0, learning_rate, 0.9, 0.999, 1.0e-8, momentum);
		}

		method : CompileWith(optimizer : Int, lr : Float, b1 : Float, b2 : Float, eps : Float, momentum : Float) ~ Bool {
			if(@handle = 0) {
				return false;
			};

			array_args := Base->New[9];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(optimizer);
			array_args[3] := IntRef->New(@init = Initializer->KAIMING ? 1 : 0);
			array_args[4] := FloatRef->New(lr);
			array_args[5] := FloatRef->New(b1);
			array_args[6] := FloatRef->New(b2);
			array_args[7] := FloatRef->New(eps);
			array_args[8] := FloatRef->New(momentum);
			if(@fn_ml_cnn_compile = Nil) { @fn_ml_cnn_compile := "ml_cnn_compile"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_compile, array_args);

			return array_args[0]->As(IntRef)->Get() <> 0;
		}

		method : Set(what : Int, value : Float) ~ Bool {
			if(@handle = 0) {
				return false;
			};

			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(what);
			array_args[3] := FloatRef->New(value);
			if(@fn_ml_cnn_set = Nil) { @fn_ml_cnn_set := "ml_cnn_set"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_set, array_args);

			return array_args[0]->As(IntRef)->Get() <> 0;
		}

		#~
		Changes the learning rate of the optimizer, keeping its moments.
		@param learning_rate step size, above 0
		@return true if changed
		~#
		method : public : SetLearningRate(learning_rate : Float) ~ Bool {
			return Set(0, learning_rate);
		}

		#~
		Switches the mode Predict and the staged predictions run in. In training mode dropout is active; in evaluation mode (the default) it is the identity. TrainBatch and TrainStaged always train, and EvaluateBatch always evaluates.
		@param training true for training mode
		@return true if set
		~#
		method : public : SetTraining(training : Bool) ~ Bool {
			return Set(1, training ? 1.0 : 0.0);
		}

		#~
		Restarts the dropout masks, so the next forward pass draws the same masks as the first one did. Gradient checks need this to evaluate one loss twice with one mask.
		@return true if done
		~#
		method : public : ResetDropout() ~ Bool {
			return Set(2, 0.0);
		}

		#~
		The number of trainable parameters: for a convolution filters x (channels x k x k) + filters, for a dense layer units x inputs + units.
		@return parameter count, 0 for a model that is not valid
		~#
		method : public : GetParameterCount() ~ Int {
			return Info(0);
		}

		#~
		Is the model compiled?
		@return true if so
		~#
		method : public : IsCompiled() ~ Bool {
			return Info(1) <> 0;
		}

		#~
		How many images of the last TrainBatch, EvaluateBatch, TrainStaged or EvaluateStaged call were classified correctly at the 0.5 threshold.
		@return count
		~#
		method : public : GetCorrect() ~ Int {
			return Info(2);
		}

		#~
		A listing of the layers with output shapes and parameter counts.
		@return the summary
		~#
		method : public : GetSummary() ~ String {
			return Text(1);
		}

		#~
		Gets the input channels.
		@return channels
		~#
		method : public : GetChannels() ~ Int {
			return @channels;
		}

		#~
		Gets the input height.
		@return height
		~#
		method : public : GetHeight() ~ Int {
			return @height;
		}

		#~
		Gets the input width.
		@return width
		~#
		method : public : GetWidth() ~ Int {
			return @width;
		}

		method : Batch(mode : Int, images : Float[], labels : Float[]) ~ Float {
			if(@handle = 0 | images = Nil | labels = Nil) {
				return -1.0;
			};

			array_args := Base->New[5];
			array_args[0] := FloatRef->New(-1.0);
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(mode);
			array_args[3] := FloatArrayRef->New(images);
			array_args[4] := FloatArrayRef->New(labels);
			if(@fn_ml_cnn_train = Nil) { @fn_ml_cnn_train := "ml_cnn_train"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_train, array_args);

			return array_args[0]->As(FloatRef)->Get();
		}

		#~
		One optimizer step on a batch: forward pass in training mode (dropout on), loss, backward pass, update.
		@param images the batch, whole images of channels x height x width values end to end
		@param labels 0.0 or 1.0 per image
		@return the mean loss of the batch before the update, or -1.0 if refused (an empty batch, a wrong size, not compiled)
		~#
		method : public : TrainBatch(images : Float[], labels : Float[]) ~ Float {
			return Batch(0, images, labels);
		}

		#~
		The mean loss of a batch in evaluation mode, without changing the model.
		@param images the batch
		@param labels 0.0 or 1.0 per image
		@return loss, or -1.0 if refused
		~#
		method : public : EvaluateBatch(images : Float[], labels : Float[]) ~ Float {
			return Batch(1, images, labels);
		}

		#~
		Forward and backward pass without the update, in evaluation mode; GetGradients then returns the parameter gradients. Used to check backpropagation.
		@param images the batch
		@param labels 0.0 or 1.0 per image
		@return the loss, or -1.0 if refused
		~#
		method : public : Gradients(images : Float[], labels : Float[]) ~ Float {
			return Batch(2, images, labels);
		}

		#~
		Forward and backward pass without the update, in training mode (dropout on, drawing the next masks); see ResetDropout.
		@param images the batch
		@param labels 0.0 or 1.0 per image
		@return the loss, or -1.0 if refused
		~#
		method : public : GradientsTraining(images : Float[], labels : Float[]) ~ Float {
			return Batch(3, images, labels);
		}

		#~
		Like Gradients, in evaluation mode, and also keeps the gradient of the loss with respect to the input pixels for GetInputGradient.
		@param images the batch
		@param labels 0.0 or 1.0 per image
		@return the loss, or -1.0 if refused
		~#
		method : public : GradientsWithInput(images : Float[], labels : Float[]) ~ Float {
			return Batch(4, images, labels);
		}

		method : Predicted(logits : Bool, images : Float[]) ~ Float[] {
			if(@handle = 0 | images = Nil) {
				return Nil;
			};

			array_args := Base->New[4];
			array_args[0] := FloatArrayRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(logits ? 1 : 0);
			array_args[3] := FloatArrayRef->New(images);
			if(@fn_ml_cnn_predict = Nil) { @fn_ml_cnn_predict := "ml_cnn_predict"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_predict, array_args);

			return array_args[0]->As(FloatArrayRef)->Get();
		}

		#~
		The probability of class 1 for each image of a batch (sigmoid of the logit). Dropout is off unless SetTraining(true) was called.
		@param images whole images end to end, any number of them
		@return one probability per image, or Nil if refused (not compiled, or not a whole number of images)
		~#
		method : public : Predict(images : Float[]) ~ Float[] {
			return Predicted(false, images);
		}

		#~
		The raw logit for each image of a batch.
		@param images whole images end to end
		@return one logit per image, or Nil if refused
		~#
		method : public : PredictLogits(images : Float[]) ~ Float[] {
			return Predicted(true, images);
		}

		method : Vector(what : Int, layer : Int) ~ Float[] {
			if(@handle = 0) {
				return Nil;
			};

			array_args := Base->New[4];
			array_args[0] := FloatArrayRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(what);
			array_args[3] := IntRef->New(layer);
			if(@fn_ml_cnn_vector = Nil) { @fn_ml_cnn_vector := "ml_cnn_vector"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_vector, array_args);

			return array_args[0]->As(FloatArrayRef)->Get();
		}

		#~
		Every trainable value in one array, layer by layer, each layer's weights then its biases. A convolution's weights are filters x channels x kh x kw and a dense layer's are units x inputs, both row-major (the layouts of PyTorch).
		@return the values, or Nil if the model is not compiled
		~#
		method : public : GetWeights() ~ Float[] {
			return Vector(0, 0);
		}

		#~
		Replaces every trainable value; the array must have the layout and length GetWeights returns.
		@param weights the values
		@return true if set, false if the length is wrong
		~#
		method : public : SetWeights(weights : Float[]) ~ Bool {
			if(@handle = 0 | weights = Nil) {
				return false;
			};

			array_args := Base->New[3];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := FloatArrayRef->New(weights);
			if(@fn_ml_cnn_set_weights = Nil) { @fn_ml_cnn_set_weights := "ml_cnn_set_weights"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_set_weights, array_args);

			return array_args[0]->As(IntRef)->Get() <> 0;
		}

		#~
		The gradient of the last Gradients, GradientsTraining, GradientsWithInput or training call, in the layout of GetWeights.
		@return the gradients, or Nil before any pass
		~#
		method : public : GetGradients() ~ Float[] {
			return Vector(1, 0);
		}

		#~
		The output of a layer for the last forward pass over the whole batch.
		@param layer layer index, from 0
		@return the activations, or Nil if there is no such layer or no pass yet
		~#
		method : public : GetActivation(layer : Int) ~ Float[] {
			return Vector(2, layer);
		}

		#~
		The gradient of the loss with respect to the input pixels, after GradientsWithInput.
		@return the gradient, one value per input value, or Nil
		~#
		method : public : GetInputGradient() ~ Float[] {
			return Vector(3, 0);
		}

		method : File(save : Bool, path : String) ~ Bool {
			if(@handle = 0 | path = Nil) {
				return false;
			};

			array_args := Base->New[4];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(save ? 1 : 0);
			array_args[3] := path;
			if(@fn_ml_cnn_file = Nil) { @fn_ml_cnn_file := "ml_cnn_file"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_file, array_args);

			return array_args[0]->As(IntRef)->Get() <> 0;
		}

		#~
		Writes the weights to a file: a header with the architecture's signature, then every value exactly as it is held, so Load gives back bit-identical weights. The optimizer's moments are not saved.
		@param path file to write
		@return true if written
		~#
		method : public : Save(path : String) ~ Bool {
			return File(true, path);
		}

		#~
		Reads weights back into this model, which must be compiled and have the same architecture and scalar type as the one that wrote the file. A file from another architecture, a truncated file or a file that is not a weights file is refused and leaves the model unchanged.
		@param path file to read
		@return true if loaded
		~#
		method : public : Load(path : String) ~ Bool {
			return File(false, path);
		}

		#~
		Decodes one 8-bit image into slot `slot` of the staging batch: BGR (as OpenCV holds it) to RGB, scaled to 0 .. 1, and augmented if the configuration says so. Staging avoids building a Float[] of the whole batch in Objeck. Stage `total` images into slots 0 .. total - 1, then call TrainStaged, EvaluateStaged or PredictStaged.
		@param pixels rows x cols x channels bytes, interleaved, channels 1, 3 or 4
		@param rows image rows, must equal the model height
		@param cols image columns, must equal the model width
		@param slot index in the batch
		@param total images in the batch
		@param aug the augmentation, or Nil for none
		@param key distinguishes this image's random draws, see Augmentation
		@return true if staged
		~#
		method : public : StageImage(pixels : Byte[], rows : Int, cols : Int, slot : Int, total : Int, aug : Augmentation, key : Int) ~ Bool {
			if(@handle = 0 | pixels = Nil) {
				return false;
			};
			if(aug = Nil) {
				aug := @no_augment;
			};

			array_args := Base->New[8];
			array_args[0] := IntRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := ByteArrayRef->New(pixels);
			array_args[3] := IntRef->New(rows);
			array_args[4] := IntRef->New(cols);
			array_args[5] := IntRef->New(slot);
			array_args[6] := IntRef->New(total);
			array_args[7] := FloatArrayRef->New(aug->GetConfig(key));
			if(@fn_ml_cnn_stage = Nil) { @fn_ml_cnn_stage := "ml_cnn_stage"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_stage, array_args);

			return array_args[0]->As(IntRef)->Get() <> 0;
		}

		method : Staged(mode : Int, labels : Float[]) ~ Float {
			if(@handle = 0 | labels = Nil) {
				return -1.0;
			};

			array_args := Base->New[4];
			array_args[0] := FloatRef->New(-1.0);
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(mode);
			array_args[3] := FloatArrayRef->New(labels);
			if(@fn_ml_cnn_staged = Nil) { @fn_ml_cnn_staged := "ml_cnn_staged"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_staged, array_args);

			return array_args[0]->As(FloatRef)->Get();
		}

		#~
		TrainBatch on the staged images.
		@param labels one per staged image
		@return the loss, or -1.0 if refused (the label count must equal the staged image count)
		~#
		method : public : TrainStaged(labels : Float[]) ~ Float {
			return Staged(0, labels);
		}

		#~
		EvaluateBatch on the staged images.
		@param labels one per staged image
		@return the loss, or -1.0 if refused
		~#
		method : public : EvaluateStaged(labels : Float[]) ~ Float {
			return Staged(1, labels);
		}

		#~
		Predicts the staged images.
		@param count how many images were staged
		@param logits true for logits, false for probabilities
		@return one value per image, or Nil if refused
		~#
		method : public : PredictStaged(count : Int, logits : Bool) ~ Float[] {
			if(@handle = 0) {
				return Nil;
			};

			array_args := Base->New[4];
			array_args[0] := FloatArrayRef->New();
			array_args[1] := IntRef->New(@handle);
			array_args[2] := IntRef->New(logits ? 1 : 0);
			array_args[3] := IntRef->New(count);
			if(@fn_ml_cnn_staged_predict = Nil) { @fn_ml_cnn_staged_predict := "ml_cnn_staged_predict"; };
			Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_staged_predict, array_args);

			return array_args[0]->As(FloatArrayRef)->Get();
		}

		#~
		Releases the native model. The object is not usable afterwards; every method answers as for an invalid model.
		~#
		method : public : Close() ~ Nil {
			if(@handle <> 0) {
				array_args := Base->New[2];
				array_args[0] := Nil;
				array_args[1] := IntRef->New(@handle);
				if(@fn_ml_cnn_release = Nil) { @fn_ml_cnn_release := "ml_cnn_release"; };
				Proxy->GetDllProxy()->CallFunction(@fn_ml_cnn_release, array_args);
				@handle := 0;
				@error := "the model was closed";
			};
		}
	}

	#~
	A set of labelled images for CnnTrainer: file paths (decoded and resized when a batch needs them) or in-memory pixels, each with a class label of 0 or 1. Every image is resized to size x size. A bad file is reported by Load and counted, never fatal.

	Split(train, validation, seed) deals the images into three ImageSubsets by a seeded shuffle, so the same seed gives the same split on every platform, and the remainder is the test set. Only the training subset is augmented. When the data is already split into folders, make one dataset per folder and use All.

```
data := ImageDataset->New(64, 3);
data->AddDirectory("real", 0);
data->AddDirectory("fake", 1);
splits := data->Split(0.7, 0.15, 42);     # train, validation, test
train := splits[0];
train->SetAugmentation(aug);
```
	~#
	class ImageDataset {
		@size : Int;
		@channels : Int;
		@paths : Vector<String>;
		@pixels : Vector<ByteArrayRef>;
		@labels : Vector<IntRef>;
		@cache : Bool;
		@error : String;

		#~
		Creates an empty dataset.
		@param size images are resized to size x size
		@param channels channels the model takes, 1 or 3 (informational: the model converts)
		~#
		New(size : Int, channels : Int) {
			@size := size;
			@channels := channels;
			@paths := Vector->New()<String>;
			@pixels := Vector->New()<ByteArrayRef>;
			@labels := Vector->New()<IntRef>;
			@cache := false;
			@error := "";
		}

		#~
		A procedurally generated two-class set for demos and tests, with no files. Every image is a random-orientation, random-phase sine texture plus noise on a coloured background: class 0 has a low spatial frequency (1 to 3 cycles across the image), class 1 a high one (6 to 10 cycles), so a convolutional network learns to tell them apart in seconds. The images alternate class 0, 1, 0, 1, ..., and the same seed gives the same images on every platform (it uses an integer generator, not the VM's random numbers).
		@param size image side in pixels, 8 or more
		@param per_class images of each class, 1 or more
		@param seed generator seed
		@return the dataset (3 channels, in memory), or Nil for arguments out of range
		~#
		function : Synthetic(size : Int, per_class : Int, seed : Int) ~ ImageDataset {
			if(size < 8 | size > 1024 | per_class < 1) {
				return Nil;
			};

			data := ImageDataset->New(size, 3);
			state := (seed % 2147483647 + 2147483647) % 2147483647 + 12345;
			two_pi := 2.0 * Float->Pi();
			plane := size * size;
			count := per_class * 2;
			for(n := 0; n < count; n += 1;) {
				cls := n % 2;
				# five draws in [0, 1): frequency, angle, phase, background colour, then noise per pixel
				draws := Float->New[8];
				each(k : 8) {
					state := (state * 1103515245 + 12345) % 2147483648;
					draws[k] := state->As(Float) / 2147483648.0;
				};

				frequency := cls = 0 ? 1.0 + draws[0] * 2.0 : 6.0 + draws[0] * 4.0;
				angle := draws[1] * Float->Pi();
				fx := Float->Cos(angle) * frequency * two_pi / size->As(Float);
				fy := Float->Sin(angle) * frequency * two_pi / size->As(Float);
				phase := draws[2] * two_pi;
				base_b := 0.35 + draws[3] * 0.3;
				base_g := 0.35 + draws[4] * 0.3;
				base_r := 0.35 + draws[5] * 0.3;

				pixels := Byte->New[plane * 3];
				for(y := 0; y < size; y += 1;) {
					for(x := 0; x < size; x += 1;) {
						wave := 0.3 * Float->Sin(fx * x->As(Float) + fy * y->As(Float) + phase);
						at := (y * size + x) * 3;
						state := (state * 1103515245 + 12345) % 2147483648;
						noise := (state->As(Float) / 2147483648.0 - 0.5) * 0.1;
						pixels[at] := ToByte(base_b + wave + noise);
						pixels[at + 1] := ToByte(base_g + wave + noise);
						pixels[at + 2] := ToByte(base_r + wave + noise);
					};
				};
				data->AddPixels(pixels, cls);
			};

			return data;
		}

		function : ToByte(v : Float) ~ Byte {
			scaled := (v * 255.0 + 0.5)->As(Int);
			if(scaled < 0) {
				scaled := 0;
			};
			if(scaled > 255) {
				scaled := 255;
			};

			return scaled->As(Byte);
		}

		#~
		Keep decoded images in memory after the first load (fast epochs, but size x size x 3 bytes per image). Off by default.
		@param cache true to cache
		~#
		method : public : SetCache(cache : Bool) ~ Nil {
			@cache := cache;
		}

		#~
		The image side length.
		@return size
		~#
		method : public : GetSize() ~ Int {
			return @size;
		}

		#~
		Why the last call refused.
		@return the reason
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		The number of images.
		@return count
		~#
		method : public : Count() ~ Int {
			return @labels->Size();
		}

		#~
		The class label of an image.
		@param index image index
		@return 0 or 1, or -1 for no such image
		~#
		method : public : GetLabel(index : Int) ~ Int {
			if(index < 0 | index >= @labels->Size()) {
				return -1;
			};

			return @labels->Get(index)->Get();
		}

		#~
		Adds an image file. It is decoded on use, so a missing or bad file shows up as a refused batch, or earlier with Check.
		@param path image file
		@param cls the class label, 0 or 1
		@return true if added
		~#
		method : public : AddFile(path : String, cls : Int) ~ Bool {
			if(path = Nil | path->Size() = 0 | (cls <> 0 & cls <> 1)) {
				@error := "a Nil or empty path, or a label other than 0 or 1";
				return false;
			};

			@paths->AddBack(path);
			@pixels->AddBack(ByteArrayRef->New());
			@labels->AddBack(IntRef->New(cls));
			return true;
		}

		#~
		Adds an image held in memory.
		@param pixels size x size x channels bytes, interleaved BGR (or one gray channel; 1, 3 or 4 channels)
		@param cls the class label, 0 or 1
		@return true if added, false if the length does not fit size x size x (1, 3 or 4)
		~#
		method : public : AddPixels(pixels : Byte[], cls : Int) ~ Bool {
			if(pixels = Nil | (cls <> 0 & cls <> 1)) {
				@error := "Nil pixels, or a label other than 0 or 1";
				return false;
			};

			plane := @size * @size;
			if(plane < 1 | pixels->Size() % plane <> 0 | (pixels->Size() <> plane & pixels->Size() <> plane * 3 & pixels->Size() <> plane * 4)) {
				@error := "image has {$pixels->Size()} bytes, expected {$@size} x {$@size} x 1, 3 or 4";
				return false;
			};

			@paths->AddBack("");
			@pixels->AddBack(ByteArrayRef->New(pixels));
			@labels->AddBack(IntRef->New(cls));
			return true;
		}

		#~
		Adds every .jpg, .jpeg, .png and .bmp file of a folder (not its subfolders), in name order so the same folder always gives the same indexes.
		@param directory folder
		@param cls the class label, 0 or 1 for all of them
		@return how many were added, 0 if the folder is missing
		~#
		method : public : AddDirectory(directory : String, cls : Int) ~ Int {
			if(directory = Nil | cls < 0 | cls > 1 | <>System.IO.Filesystem.Directory->Exists(directory)) {
				@error := "no such folder, or a label other than 0 or 1";
				return 0;
			};

			names := System.IO.Filesystem.Directory->List(directory);
			if(names = Nil) {
				return 0;
			};

			files := Vector->New()<String>;
			each(i : names) {
				name := names[i];
				lower := name->ToLower();
				if(lower->EndsWith(".jpg") | lower->EndsWith(".jpeg") | lower->EndsWith(".png") | lower->EndsWith(".bmp")) {
					files->AddBack(name);
				};
			};
			files->Sort(\(a, b) => a->Compare(b));

			sep := directory->EndsWith('/') | directory->EndsWith('\\') ? "" : "/";
			added := 0;
			each(i : files) {
				if(AddFile(directory + sep + files->Get(i), cls)) {
					added += 1;
				};
			};

			return added;
		}

		# decoded pixels of image `index` at size x size, or Nil
		method : public : GetPixels(index : Int) ~ Byte[] {
			if(index < 0 | index >= @labels->Size()) {
				return Nil;
			};

			held := @pixels->Get(index)->Get();
			if(held <> Nil) {
				return held;
			};

			decoded := Decode(@paths->Get(index));
			if(decoded = Nil) {
				@error := "cannot decode {$@paths->Get(index)}";
				return Nil;
			};

			if(@cache) {
				@pixels->Get(index)->Set(decoded);
			};

			return decoded;
		}

		method : Decode(path : String) ~ Byte[] {
			image := API.OpenCV.Image->Load(path);
			if(image = Nil | image->IsEmpty()) {
				return Nil;
			};

			if(image->Rows() <> @size | image->Columns() <> @size) {
				image := image->Resize(API.OpenCV.Size->New(@size, @size));
				if(image = Nil | image->IsEmpty()) {
					return Nil;
				};
			};

			bytes := image->Bytes();
			plane := @size * @size;
			if(bytes = Nil | bytes->Size() % plane <> 0) {
				return Nil;
			};
			channels := bytes->Size() / plane;
			if(channels <> 1 & channels <> 3 & channels <> 4) {
				return Nil;
			};

			return bytes;
		}

		#~
		Decodes every image once and reports how many failed.
		@return the number of images that cannot be decoded
		~#
		method : public : Check() ~ Int {
			bad := 0;
			each(i : @labels) {
				if(GetPixels(i) = Nil) {
					bad += 1;
				};
			};

			return bad;
		}

		#~
		All the images as one subset.
		@param augment augment them as they are loaded (for a training set)
		@return the subset
		~#
		method : public : All(augment : Bool) ~ ImageSubset {
			indexes := Int->New[@labels->Size()];
			each(i : indexes) {
				indexes[i] := i;
			};

			return ImageSubset->New(@self, indexes, augment);
		}

		#~
		Deals the images into training, validation and test subsets by a seeded shuffle. The training subset is the one that is augmented, once SetAugmentation is called on it.
		@param train_fraction share for training, above 0
		@param validation_fraction share for validation, 0 or more; what is left over is the test set
		@param seed shuffle seed
		@return three subsets: training, validation, test (Nil if the fractions are not valid or there are no images)
		~#
		method : public : Split(train_fraction : Float, validation_fraction : Float, seed : Int) ~ ImageSubset[] {
			n := @labels->Size();
			if(n < 1 | train_fraction <= 0.0 | validation_fraction < 0.0 | train_fraction + validation_fraction > 1.0) {
				@error := "no images, or fractions that are not in (0, 1] and sum above 1";
				return Nil;
			};

			order := CnnRuntime->Permutation(n, seed);
			if(order = Nil) {
				return Nil;
			};

			n_train := (n->As(Float) * train_fraction)->As(Int);
			n_valid := (n->As(Float) * validation_fraction)->As(Int);
			if(n_train < 1) {
				n_train := 1;
			};
			if(n_train + n_valid > n) {
				n_valid := n - n_train;
			};
			n_test := n - n_train - n_valid;

			train := Int->New[n_train];
			valid := Int->New[n_valid];
			test := Int->New[n_test];
			each(i : order) {
				if(i < n_train) {
					train[i] := order[i];
				}
				else if(i < n_train + n_valid) {
					valid[i - n_train] := order[i];
				}
				else {
					test[i - n_train - n_valid] := order[i];
				};
			};

			splits := ImageSubset->New[3];
			splits[0] := ImageSubset->New(@self, train, true);
			splits[1] := ImageSubset->New(@self, valid, false);
			splits[2] := ImageSubset->New(@self, test, false);
			return splits;
		}
	}

	#~
	A list of images of an ImageDataset, in a fixed order, that CnnTrainer batches over. Only a subset made for training augments; Augmentation is applied on the fly while a batch is staged and never changes the stored images.
	~#
	class ImageSubset {
		@data : ImageDataset;
		@indexes : Int[];
		@augment : Bool;
		@aug : Augmentation;

		New(data : ImageDataset, indexes : Int[], augment : Bool) {
			@data := data;
			@indexes := indexes;
			@augment := augment;
			@aug := Augmentation->New();
		}

		#~
		Sets the augmentation used when this subset is a training subset (it is ignored for subsets made with augment = false).
		@param aug the configuration
		~#
		method : public : SetAugmentation(aug : Augmentation) ~ Nil {
			if(aug <> Nil) {
				@aug := aug;
			};
		}

		#~
		Gets the augmentation.
		@return the configuration
		~#
		method : public : GetAugmentation() ~ Augmentation {
			return @aug;
		}

		#~
		Is this subset augmented?
		@return true for a training subset
		~#
		method : public : IsAugmented() ~ Bool {
			return @augment & @aug->IsEnabled();
		}

		#~
		The number of images.
		@return count
		~#
		method : public : Count() ~ Int {
			return @indexes->Size();
		}

		#~
		The index in the dataset of the image at a position.
		@param position position in this subset
		@return dataset index, -1 if out of range
		~#
		method : public : GetIndex(position : Int) ~ Int {
			if(position < 0 | position >= @indexes->Size()) {
				return -1;
			};

			return @indexes[position];
		}

		#~
		The class label of the image at a position.
		@param position position in this subset
		@return 0 or 1, -1 if out of range
		~#
		method : public : GetLabel(position : Int) ~ Int {
			if(position < 0 | position >= @indexes->Size()) {
				return -1;
			};

			return @data->GetLabel(@indexes[position]);
		}

		#~
		Counts the images of class 1.
		@return count
		~#
		method : public : CountPositives() ~ Int {
			count := 0;
			each(i : @indexes) {
				if(@data->GetLabel(@indexes[i]) = 1) {
					count += 1;
				};
			};

			return count;
		}

		#~
		Stages the image at a position into a slot of the model's batch.
		@param model the model
		@param position position in this subset
		@param slot index in the batch
		@param total images in the batch
		@param key varies the random draws, e.g. epoch * count + position
		@return true if staged
		~#
		method : public : Stage(model : CnnModel, position : Int, slot : Int, total : Int, key : Int) ~ Bool {
			if(model = Nil | position < 0 | position >= @indexes->Size()) {
				return false;
			};

			pixels := @data->GetPixels(@indexes[position]);
			if(pixels = Nil) {
				return false;
			};

			size := @data->GetSize();
			aug : Augmentation := @augment ? @aug : Nil;
			return model->StageImage(pixels, size, size, slot, total, aug, key);
		}
	}

	#~
	What a CnnTrainer.Fit recorded, one value per finished epoch: loss and accuracy on the training batches (as Keras reports them: running means over the epoch, in training mode, so dropout and augmentation are on and the weights change during the epoch), loss and accuracy on the validation subset (evaluation mode, after the epoch) and the wall time of the epoch.
	~#
	class TrainingHistory {
		@epochs : Int;
		@train_loss : Float[];
		@train_accuracy : Float[];
		@validation_loss : Float[];
		@validation_accuracy : Float[];
		@seconds : Float[];
		@error : String;

		New(epochs : Int) {
			@epochs := 0;
			@train_loss := Float->New[epochs];
			@train_accuracy := Float->New[epochs];
			@validation_loss := Float->New[epochs];
			@validation_accuracy := Float->New[epochs];
			@seconds := Float->New[epochs];
			@error := "";
		}

		method : public : Record(train_loss : Float, train_accuracy : Float, validation_loss : Float, validation_accuracy : Float, seconds : Float) ~ Nil {
			if(@epochs < @train_loss->Size()) {
				@train_loss[@epochs] := train_loss;
				@train_accuracy[@epochs] := train_accuracy;
				@validation_loss[@epochs] := validation_loss;
				@validation_accuracy[@epochs] := validation_accuracy;
				@seconds[@epochs] := seconds;
				@epochs += 1;
			};
		}

		method : public : SetError(error : String) ~ Nil {
			@error := error;
		}

		#~
		Why training stopped early, empty if it ran to the end.
		@return the reason
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		#~
		The number of finished epochs.
		@return epochs
		~#
		method : public : GetEpochs() ~ Int {
			return @epochs;
		}

		#~
		Mean training loss of an epoch.
		@param epoch epoch from 0
		@return loss, 0.0 if there is no such epoch
		~#
		method : public : GetTrainLoss(epoch : Int) ~ Float {
			return epoch >= 0 & epoch < @epochs ? @train_loss[epoch] : 0.0;
		}

		#~
		Training accuracy of an epoch, 0.0 to 1.0.
		@param epoch epoch from 0
		@return accuracy
		~#
		method : public : GetTrainAccuracy(epoch : Int) ~ Float {
			return epoch >= 0 & epoch < @epochs ? @train_accuracy[epoch] : 0.0;
		}

		#~
		Validation loss after an epoch.
		@param epoch epoch from 0
		@return loss
		~#
		method : public : GetValidationLoss(epoch : Int) ~ Float {
			return epoch >= 0 & epoch < @epochs ? @validation_loss[epoch] : 0.0;
		}

		#~
		Validation accuracy after an epoch, 0.0 to 1.0.
		@param epoch epoch from 0
		@return accuracy
		~#
		method : public : GetValidationAccuracy(epoch : Int) ~ Float {
			return epoch >= 0 & epoch < @epochs ? @validation_accuracy[epoch] : 0.0;
		}

		#~
		Wall-clock seconds an epoch took, training and validation together.
		@param epoch epoch from 0
		@return seconds
		~#
		method : public : GetEpochSeconds(epoch : Int) ~ Float {
			return epoch >= 0 & epoch < @epochs ? @seconds[epoch] : 0.0;
		}

		#~
		Total wall-clock seconds of all epochs.
		@return seconds
		~#
		method : public : GetTotalSeconds() ~ Float {
			total := 0.0;
			each(i : @epochs) {
				total += @seconds[i];
			};

			return total;
		}

		#~
		The history as a System.ML.Lab ResultTable, one row per epoch, for the Lab's text, Markdown, CSV, JSON and chart output.
		@param title table title
		@return the table
		~#
		method : public : ToResultTable(title : String) ~ ResultTable {
			table := ResultTable->New(title, "epoch");
			table->AddColumn("train_loss", 6);
			table->AddColumn("train_acc", 4);
			table->AddColumn("val_loss", 6);
			table->AddColumn("val_acc", 4);
			table->AddColumn("seconds", 2);
			each(i : @epochs) {
				cells := [@train_loss[i], @train_accuracy[i], @validation_loss[i], @validation_accuracy[i], @seconds[i]];
				table->AddRow("{$(i + 1)}", (i + 1)->As(Float), cells);
			};

			return table;
		}

		#~
		The history as CSV text with a header row: epoch, train_loss, train_acc, val_loss, val_acc, seconds.
		@return the text
		~#
		method : public : ToCsv() ~ String {
			out := "epoch,train_loss,train_acc,val_loss,val_acc,seconds\n";
			each(i : @epochs) {
				out += "{$(i + 1)},{$@train_loss[i]},{$@train_accuracy[i]},{$@validation_loss[i]},{$@validation_accuracy[i]},{$@seconds[i]}\n";
			};

			return out;
		}

		#~
		Writes the CSV to a file.
		@param path file to write
		@return true if written
		~#
		method : public : SaveCsv(path : String) ~ Bool {
			if(path = Nil | path->Size() = 0) {
				return false;
			};

			return System.IO.Filesystem.FileWriter->WriteFile(path, ToCsv());
		}
	}

	#~
	The result of CnnTrainer.Evaluate on a subset, with class 1 as the positive class. Precision, recall and F1 are System.ML.Metrics, and the confusion matrix is its layout: [actual, predicted] with [0, 0] true negatives, [0, 1] false positives, [1, 0] false negatives and [1, 1] true positives.
	~#
	class CnnEvaluation {
		@count : Int;
		@loss : Float;
		@accuracy : Float;
		@precision : Float;
		@recall : Float;
		@f1 : Float;
		@confusion : Int[,];

		New(count : Int, loss : Float, predictions : Bool[], actuals : Bool[]) {
			@count := count;
			@loss := loss;
			@accuracy := Metrics->Accuracy(predictions, actuals);
			@precision := Metrics->Precision(predictions, actuals);
			@recall := Metrics->Recall(predictions, actuals);
			@f1 := Metrics->F1Score(predictions, actuals);
			@confusion := Metrics->ConfusionMatrix(predictions, actuals);
		}

		method : public : GetCount() ~ Int { return @count; }
		method : public : GetLoss() ~ Float { return @loss; }
		method : public : GetAccuracy() ~ Float { return @accuracy; }
		method : public : GetPrecision() ~ Float { return @precision; }
		method : public : GetRecall() ~ Float { return @recall; }
		method : public : GetF1() ~ Float { return @f1; }
		method : public : GetConfusion() ~ Int[,] { return @confusion; }

		method : public : ToString() ~ String {
			return "n={$@count} loss={$@loss} accuracy={$@accuracy} precision={$@precision} recall={$@recall} f1={$@f1}";
		}
	}

	#~
	The training loop. Fit shuffles the training subset every epoch (seeded), trains on mini-batches (the last one may be smaller), then evaluates the validation subset, and records the metrics of every epoch in a TrainingHistory. Evaluate scores a subset (the test set) after training.

```
trainer := CnnTrainer->New(model, train, validation, 64, 42);
history := trainer->Fit(10);
history->SaveCsv("history.csv");
test_result := trainer->Evaluate(test);
test_result->GetAccuracy()->PrintLine();
```
	~#
	class CnnTrainer {
		@model : CnnModel;
		@train : ImageSubset;
		@validation : ImageSubset;
		@batch : Int;
		@seed : Int;
		@verbose : Bool;
		@error : String;

		#~
		Creates a trainer.
		@param model a compiled model
		@param train training subset
		@param validation validation subset, or Nil for none (its columns then read 0)
		@param batch_size images per step, 1 or more
		@param seed seed of the per-epoch shuffle
		~#
		New(model : CnnModel, train : ImageSubset, validation : ImageSubset, batch_size : Int, seed : Int) {
			@model := model;
			@train := train;
			@validation := validation;
			@batch := batch_size;
			@seed := seed;
			@verbose := false;
			@error := "";
		}

		#~
		Print one line per epoch while training.
		@param verbose true to print
		~#
		method : public : SetVerbose(verbose : Bool) ~ Nil {
			@verbose := verbose;
		}

		#~
		Why the last call refused.
		@return the reason
		~#
		method : public : GetError() ~ String {
			return @error;
		}

		# stages images order[start .. start + count) of a subset into the model; the labels, or Nil if an image fails
		method : Load(subset : ImageSubset, order : Int[], start : Int, count : Int, key_base : Int) ~ Float[] {
			labels := Float->New[count];
			each(j : count) {
				position := order[start + j];
				if(<>subset->Stage(@model, position, j, count, key_base + position)) {
					@error := "image {$subset->GetIndex(position)} could not be loaded: {$@model->GetError()}";
					return Nil;
				};
				labels[j] := subset->GetLabel(position)->As(Float);
			};

			return labels;
		}

		#~
		Trains for a number of epochs.
		@param epochs epochs to run, 1 or more
		@return the history; it holds the epochs that finished and GetError says why it stopped early (the history is Nil only for unusable arguments)
		~#
		method : public : Fit(epochs : Int) ~ TrainingHistory {
			if(@model = Nil | @train = Nil | epochs < 1 | @batch < 1 | @train->Count() < 1 | <>@model->IsCompiled()) {
				@error := "a Nil or uncompiled model, no training images, or epochs and batch size below 1";
				return Nil;
			};

			history := TrainingHistory->New(epochs);
			n := @train->Count();
			timer := System.Time.Timer->New();
			for(epoch := 0; epoch < epochs; epoch += 1;) {
				timer->Start();
				order := CnnRuntime->Permutation(n, @seed + epoch);
				loss_sum := 0.0;
				correct := 0;
				for(start := 0; start < n; start += @batch;) {
					count := Int->Min(@batch, n - start);
					labels := Load(@train, order, start, count, epoch * n);
					if(labels = Nil) {
						history->SetError(@error);
						return history;
					};

					loss := @model->TrainStaged(labels);
					if(loss < 0.0) {
						history->SetError(@model->GetError());
						return history;
					};
					loss_sum += loss * count->As(Float);
					correct += @model->GetCorrect();
				};

				val_loss := 0.0;
				val_acc := 0.0;
				if(@validation <> Nil & @validation->Count() > 0) {
					result := Evaluate(@validation);
					if(result = Nil) {
						history->SetError(@error);
						return history;
					};
					val_loss := result->GetLoss();
					val_acc := result->GetAccuracy();
				};

				timer->End();
				seconds := timer->GetElapsedTime();
				history->Record(loss_sum / n->As(Float), correct->As(Float) / n->As(Float), val_loss, val_acc, seconds);
				if(@verbose) {
					"epoch {$(epoch + 1)}/{$epochs}  loss {$(loss_sum / n->As(Float))}  acc {$(correct->As(Float) / n->As(Float))}  val_loss {$val_loss}  val_acc {$val_acc}  {$seconds}s"->PrintLine();
				};
			};

			return history;
		}

		#~
		Scores a subset in evaluation mode (no dropout, no augmentation): loss, accuracy, precision, recall, F1 and the confusion matrix, with class 1 positive and a 0.5 threshold.
		@param subset the images to score
		@return the evaluation, or Nil if the subset is empty or an image cannot be loaded
		~#
		method : public : Evaluate(subset : ImageSubset) ~ CnnEvaluation {
			if(@model = Nil | subset = Nil | subset->Count() < 1 | @batch < 1 | <>@model->IsCompiled()) {
				@error := "a Nil or uncompiled model, or an empty subset";
				return Nil;
			};

			@model->SetTraining(false);
			n := subset->Count();
			order := Int->New[n];
			each(i : n) {
				order[i] := i;
			};

			predictions := Bool->New[n];
			actuals := Bool->New[n];
			loss_sum := 0.0;
			for(start := 0; start < n; start += @batch;) {
				count := Int->Min(@batch, n - start);
				labels := Load(subset, order, start, count, 0);
				if(labels = Nil) {
					return Nil;
				};

				logits := @model->PredictStaged(count, true);
				if(logits = Nil) {
					@error := @model->GetError();
					return Nil;
				};

				each(j : count) {
					z := logits[j];
					y := labels[j];
					# the numerically stable binary cross-entropy on a logit
					loss_sum += Float->Max(z, 0.0) - z * y + Float->Log(1.0 + Float->Exp(0.0 - Float->Abs(z)));
					predictions[start + j] := z > 0.0;
					actuals[start + j] := y > 0.5;
				};
			};

			return CnnEvaluation->New(n, loss_sum / n->As(Float), predictions, actuals);
		}
	}
}
