# Text embeddings from BERT-family ONNX models
~~#

use Collection;
use API.Models;
use API.Onnx;
use System.NLP;
use Data.JSON;

#~
Sentence embeddings from a pretrained BERT-family encoder exported to ONNX: the text is
tokenized with WordPieceTokenizer, run through API.Onnx, and pooled into one vector per text.

A library of its own because it needs both System.NLP and API.Onnx, and the compiler resolves
every class a linked library names: an embedder inside onnx.obl would make every ONNX program
link nlp too, and one inside nlp.obl would make every NLP program need ONNX Runtime
(docs/ML_BERT_DESIGN.md). Compile with -lib models,opencv,cipher,json,onnx,nlp,nlp_onnx.
~#
bundle System.NLP.Onnx {
	#~
	Sentence embeddings from a BERT-family ONNX model: Embed(texts) gives one row of hidden-size
	numbers per text.

	The model is a Hugging Face export (optimum-cli export onnx, or torch.onnx.export) taking
	input_ids, and usually attention_mask and token_type_ids, as INT64[batch, sequence], and
	giving last_hidden_state FP32[batch, sequence, hidden] and, for BERT though not for
	DistilBERT, pooler_output FP32[batch, hidden]. The model's own signature decides what is
	sent: an input it does not declare is not built, and the one output the pooling needs is
	the only one asked for.

	With no session options, the build's default provider runs the model, and the CPU when
	that provider cannot open it (DirectML needs a display adapter): see IsCpuFallback.

	Pooling: CLS takes the hidden state of the first token; MEAN averages the hidden states of
	the real tokens, padding excluded, as sentence-transformers does; POOLER is the model's
	pooler_output, when it has one.

	Every text is padded to max_len, not to the longest text in its batch, so a text's
	embedding does not depend on which texts share its batch.

	The encoder is frozen: this computes embeddings, it does not train the model. A classifier
	trained on them (System.ML's EmbeddingClassifier) is the frozen-encoder alternative to
	fine-tuning.

```
embedder := BertEmbedder->New("model.onnx", "vocab.txt", 128);
if(<>embedder->IsOpen()) {
  embedder->GetError()->PrintLine();
  return;
};
embedder->SetPooling(BertEmbedder->Pooling->MEAN);
X := embedder->Embed(["first text", "second text"]);   # Float[2, hidden]
embedder->Close();
```
	~#
	class BertEmbedder {
		#~
		How a text's token vectors become one vector.
		~#
		enum Pooling {
			#~
			The hidden state of the first token, [CLS].
			~#
			CLS,
			#~
			The mean of the hidden states of the real tokens, padding excluded.
			~#
			MEAN,
			#~
			The model's pooler_output: tanh of a dense layer over [CLS], as BERT was pretrained.
			~#
			POOLER
		}

		@session : Session;
		@tokenizer : WordPieceTokenizer;
		@max_len : Int;
		@batch_size : Int;
		@batch_limit : Int;
		@pooling : BertEmbedder->Pooling;
		@ids_name : String;
		@mask_name : String;
		@types_name : String;
		@hidden_name : String;
		@pooler_name : String;
		@hidden_size : Int;
		@cpu_fallback : Bool;
		@open_error : String;
		@error : String;

		#~
		Opens a model with the vocabulary of an uncased model: lowercase, strip accents.
		@param model_path the .onnx file
		@param vocab_path the model's vocab.txt
		@param max_len the sequence length every text is truncated and padded to
		~#
		New(model_path : String, vocab_path : String, max_len : Int) {
			Open(model_path, WordPieceTokenizer->New(vocab_path), max_len, Nil);
		}

		#~
		Opens a model with a tokenizer configured by the caller, and session options.
		@param model_path the .onnx file
		@param tokenizer the model's tokenizer, e.g. a cased one
		@param max_len the sequence length every text is truncated and padded to
		@param config session options, e.g. "ep" to "cpu"; may be Nil
		~#
		New(model_path : String, tokenizer : WordPieceTokenizer, max_len : Int, config : Map<String, String>) {
			Open(model_path, tokenizer, max_len, config);
		}

		#~
		Opens a model with the vocabulary of an uncased model.
		@param model_path the .onnx file
		@param vocab_path the model's vocab.txt
		@param max_len the sequence length every text is truncated and padded to
		@return the embedder; test IsOpen before using it
		~#
		function : Load(model_path : String, vocab_path : String, max_len : Int) ~ BertEmbedder {
			return BertEmbedder->New(model_path, vocab_path, max_len);
		}

		method : Open(model_path : String, tokenizer : WordPieceTokenizer, max_len : Int, config : Map<String, String>) ~ Nil {
			@tokenizer := tokenizer;
			@max_len := max_len;
			@batch_size := 8;
			@batch_limit := -1;
			@pooling := BertEmbedder->Pooling->CLS;
			@hidden_size := -1;

			if(tokenizer = Nil | <>tokenizer->IsLoaded()) {
				reason := "no tokenizer";
				if(tokenizer <> Nil) {
					reason := tokenizer->GetError();
				};
				OpenFail("the vocabulary did not load: {$reason}");
				return;
			};
			if(max_len < 2) {
				OpenFail("max_len must be at least 2, for [CLS] and [SEP]");
				return;
			};

			if(config = Nil) {
				@session := Session->New(model_path);
				# The build's own provider -- DirectML on Windows, CoreML on macOS -- can fail
				# where the CPU would not: a machine with no display adapter has no DirectML.
				# With no provider asked for, any provider will do, so try the CPU.
				if(<>@session->IsOpen() & System.IO.Filesystem.File->Exists(model_path)) {
					cpu := Map->New()<String, String>;
					cpu->Insert("ep", "cpu");
					@session := Session->New(model_path, cpu);
					@cpu_fallback := @session->IsOpen();
				};
			}
			else {
				@session := Session->New(model_path, config);
			};
			if(<>@session->IsOpen()) {
				OpenFail("the model '{$model_path}' did not open");
				return;
			};

			info := @session->GetModelInfo();
			if(info = Nil) {
				OpenFail("the model '{$model_path}' reported no signature");
				Close();
				return;
			};

			# inputs, by the names exports use
			inputs := info->GetInputs();
			each(spec in inputs) {
				name := spec->GetName();
				if(name->Equals("input_ids")) {
					@ids_name := name;
					if(<>CheckSequenceAxis(spec)) {
						Close();
						return;
					};
				}
				else if(name->Equals("attention_mask")) {
					@mask_name := name;
				}
				else if(name->Equals("token_type_ids")) {
					@types_name := name;
				}
				else {
					OpenFail("the model takes an input this embedder does not know how to fill: '{$name}'");
					Close();
					return;
				};
			};
			if(@ids_name = Nil) {
				OpenFail("the model has no 'input_ids' input");
				Close();
				return;
			};

			# outputs: by name, else the first FP32 output of rank 3 (hidden) or 2 (pooler)
			outputs := info->GetOutputs();
			each(spec in outputs) {
				name := spec->GetName();
				if(name->Equals("last_hidden_state")) {
					@hidden_name := name;
				}
				else if(name->Equals("pooler_output")) {
					@pooler_name := name;
				};
			};
			each(spec in outputs) {
				rank := spec->GetShape()->Size();
				if(spec->GetDatatype()->Equals("FP32")) {
					if(@hidden_name = Nil & rank = 3) {
						@hidden_name := spec->GetName();
					}
					else if(@pooler_name = Nil & rank = 2 & <>spec->GetName()->Equals(@hidden_name)) {
						@pooler_name := spec->GetName();
					};
				};
			};
			if(@hidden_name = Nil) {
				OpenFail("the model has no last_hidden_state output (FP32, rank 3)");
				Close();
				return;
			};

			hidden_spec := info->Find(@hidden_name);
			shape := hidden_spec->GetShape();
			if(shape[2] > 0) {
				@hidden_size := shape[2];
			};
		}

		# A fixed sequence axis must be max_len: running another length would change the
		# experiment without saying so. A fixed batch axis caps the batch size.
		method : CheckSequenceAxis(spec : TensorSpec) ~ Bool {
			shape := spec->GetShape();
			if(shape->Size() <> 2) {
				declared := spec->ToString();
				OpenFail("input_ids should be [batch, sequence]; the model declares {$declared}");
				return false;
			};

			if(shape[1] > 0 & shape[1] <> @max_len) {
				fixed := shape[1];
				OpenFail("the model fixes the sequence length at {$fixed}, but max_len is {$@max_len}");
				return false;
			};

			if(shape[0] > 0) {
				@batch_limit := shape[0];
				if(@batch_size > @batch_limit) {
					@batch_size := @batch_limit;
				};
			};

			return true;
		}

		method : OpenFail(reason : String) ~ Nil {
			@open_error := reason;
			Fail(reason);
		}

		method : Fail(reason : String) ~ Nil {
			@error := reason;
			EndPoint->SetLastError(reason);
		}

		#~
		Whether the model and vocabulary loaded and the model has the inputs and outputs of a
		BERT-family encoder.
		@return true when Embed can run
		~#
		method : public : IsOpen() ~ Bool {
			return @session <> Nil & @session->IsOpen() & @hidden_name <> Nil & @open_error = Nil;
		}

		#~
		Why the embedder did not open, or why the last Embed returned Nil.
		@return the reason, or Nil
		~#
		method : public : GetError() ~ String {
			if(@open_error <> Nil) {
				return @open_error;
			};
			return @error;
		}

		#~
		Releases the model. Safe to call more than once.
		~#
		method : public : Close() ~ Nil {
			if(@session <> Nil) {
				@session->Close();
			};
		}

		#~
		Whether the build's default provider failed to open the model and the CPU provider
		was used instead. Only when no session options were given.
		@return true when running on the CPU as a fallback
		~#
		method : public : IsCpuFallback() ~ Bool {
			return @cpu_fallback;
		}

		#~
		The length of each embedding: the model's hidden size. A model whose hidden axis is
		symbolic reports it after the first Embed.
		@return hidden size, or -1 when not yet known
		~#
		method : public : GetHiddenSize() ~ Int {
			return @hidden_size;
		}

		#~
		The sequence length every text is truncated and padded to.
		@return max_len
		~#
		method : public : GetMaxLength() ~ Int {
			return @max_len;
		}

		#~
		Texts run through the model at once.
		@return batch size
		~#
		method : public : GetBatchSize() ~ Int {
			return @batch_size;
		}

		#~
		Sets how many texts run through the model at once. Larger batches are faster per text
		and hold more memory: a batch's hidden states are batch x max_len x hidden numbers. A
		model with a fixed batch axis caps it.
		@param batch_size texts per run, at least 1
		~#
		method : public : SetBatchSize(batch_size : Int) ~ Nil {
			@batch_size := batch_size;
			if(@batch_size < 1) {
				@batch_size := 1;
			};
			if(@batch_limit > 0 & @batch_size > @batch_limit) {
				@batch_size := @batch_limit;
			};
		}

		#~
		The pooling Embed uses.
		@return pooling
		~#
		method : public : GetPooling() ~ BertEmbedder->Pooling {
			return @pooling;
		}

		#~
		Sets the pooling Embed uses; CLS by default.
		@param pooling CLS, MEAN or POOLER
		~#
		method : public : SetPooling(pooling : BertEmbedder->Pooling) ~ Nil {
			@pooling := pooling;
		}

		#~
		Whether the model has a pooler_output, so POOLER pooling is available.
		@return true when it has one
		~#
		method : public : HasPooler() ~ Bool {
			return @pooler_name <> Nil;
		}

		#~
		The tokenizer, e.g. to inspect what a text becomes.
		@return the tokenizer
		~#
		method : public : GetTokenizer() ~ WordPieceTokenizer {
			return @tokenizer;
		}

		#~
		The ONNX session, for what this class does not cover.
		@return the session
		~#
		method : public : GetSession() ~ Session {
			return @session;
		}

		#~
		Embeds texts with the configured pooling.
		@param texts the texts
		@return one row per text, hidden-size columns; Nil on failure (see GetError)
		~#
		method : public : Embed(texts : String[]) ~ Float[,] {
			return Embed(texts, @pooling);
		}

		#~
		Embeds texts with a given pooling.
		@param texts the texts
		@param pooling CLS, MEAN or POOLER
		@return one row per text, hidden-size columns; Nil on failure (see GetError)
		~#
		method : public : Embed(texts : String[], pooling : BertEmbedder->Pooling) ~ Float[,] {
			if(texts = Nil) {
				Fail("no texts");
				return Nil;
			};
			if(<>IsOpen()) {
				return Nil;
			};

			encodings := TokenEncoding->New[texts->Size()];
			each(i : texts) {
				encodings[i] := @tokenizer->Encode(texts[i], @max_len);
				if(encodings[i] = Nil) {
					reason := @tokenizer->GetError();
					Fail("text {$i} could not be encoded: {$reason}");
					return Nil;
				};
			};

			return EmbedEncoded(encodings, pooling);
		}

		#~
		Embeds texts already encoded, with the configured pooling: for a caller with its own
		tokenizer or cached encodings. Every encoding must be max_len long.
		@param encodings the encoded texts
		@return one row per text, hidden-size columns; Nil on failure (see GetError)
		~#
		method : public : EmbedEncoded(encodings : TokenEncoding[]) ~ Float[,] {
			return EmbedEncoded(encodings, @pooling);
		}

		#~
		Embeds texts already encoded, with a given pooling.
		@param encodings the encoded texts, each max_len long
		@param pooling CLS, MEAN or POOLER
		@return one row per text, hidden-size columns; Nil on failure (see GetError)
		~#
		method : public : EmbedEncoded(encodings : TokenEncoding[], pooling : BertEmbedder->Pooling) ~ Float[,] {
			if(<>IsOpen()) {
				return Nil;
			};
			if(encodings = Nil) {
				Fail("no encodings");
				return Nil;
			};
			if(pooling = BertEmbedder->Pooling->POOLER & @pooler_name = Nil) {
				Fail("POOLER pooling needs a pooler_output, and this model has none; use CLS or MEAN");
				return Nil;
			};
			each(i : encodings) {
				if(encodings[i] = Nil | encodings[i]->GetSize() <> @max_len) {
					Fail("encoding {$i} is not {$@max_len} tokens long");
					return Nil;
				};
			};

			count := encodings->Size();
			out : Float[,] := Nil;
			start := 0;
			while(start < count) {
				rows := count - start;
				if(rows > @batch_size) {
					rows := @batch_size;
				};

				pooled := RunBatch(encodings, start, rows, pooling);
				if(pooled = Nil) {
					return Nil;
				};

				if(out = Nil) {
					out := Float->New[count, @hidden_size];
				};
				for(r := 0; r < rows; r += 1;) {
					for(j := 0; j < @hidden_size; j += 1;) {
						out[start + r, j] := pooled[r, j];
					};
				};
				start += rows;
			};

			if(out = Nil) {
				size := @hidden_size;
				if(size < 0) {
					size := 0;
				};
				out := Float->New[0, size];
			};
			@error := Nil;
			return out;
		}

		method : RunBatch(encodings : TokenEncoding[], start : Int, rows : Int, pooling : BertEmbedder->Pooling) ~ Float[,] {
			length := @max_len;
			ids := Int->New[rows * length];
			mask := Int->New[rows * length];
			types := Int->New[rows * length];
			for(r := 0; r < rows; r += 1;) {
				encoding := encodings[start + r];
				row_ids := encoding->GetIds();
				row_mask := encoding->GetAttentionMask();
				row_types := encoding->GetTokenTypeIds();
				for(s := 0; s < length; s += 1;) {
					ids[r * length + s] := row_ids[s];
					mask[r * length + s] := row_mask[s];
					types[r * length + s] := row_types[s];
				};
			};

			inputs := Vector->New()<Tensor>;
			inputs->AddBack(Tensor->New(@ids_name, [rows, length], ids));
			if(@mask_name <> Nil) {
				inputs->AddBack(Tensor->New(@mask_name, [rows, length], mask));
			};
			if(@types_name <> Nil) {
				inputs->AddBack(Tensor->New(@types_name, [rows, length], types));
			};

			wanted := String->New[1];
			if(pooling = BertEmbedder->Pooling->POOLER) {
				wanted[0] := @pooler_name;
			}
			else {
				wanted[0] := @hidden_name;
			};

			outputs := @session->Run(inputs, wanted);
			if(outputs = Nil | outputs->Size() = 0) {
				reason := EndPoint->GetLastError();
				Fail("the model run failed: {$reason}");
				return Nil;
			};

			tensor := outputs->Get(0);
			shape := tensor->GetShape();
			values := tensor->GetFloats();
			if(values = Nil) {
				values := tensor->AsFloats();
			};

			if(pooling = BertEmbedder->Pooling->POOLER) {
				if(shape->Size() <> 2 | shape[0] <> rows) {
					got := tensor->ToString();
					Fail("pooler_output came back as {$got}, not [{$rows}, hidden]");
					return Nil;
				};
				if(<>KnowHidden(shape[1])) {
					return Nil;
				};

				pooled := Float->New[rows, @hidden_size];
				for(r := 0; r < rows; r += 1;) {
					for(j := 0; j < @hidden_size; j += 1;) {
						pooled[r, j] := values[r * @hidden_size + j];
					};
				};
				return pooled;
			};

			if(shape->Size() <> 3 | shape[0] <> rows | shape[1] <> length) {
				got := tensor->ToString();
				Fail("last_hidden_state came back as {$got}, not [{$rows}, {$length}, hidden]");
				return Nil;
			};
			if(<>KnowHidden(shape[2])) {
				return Nil;
			};

			if(pooling = BertEmbedder->Pooling->MEAN) {
				return MeanPool(values, rows, length, @hidden_size, mask);
			};
			return ClsPool(values, rows, length, @hidden_size);
		}

		method : KnowHidden(size : Int) ~ Bool {
			if(@hidden_size < 0) {
				@hidden_size := size;
			}
			else if(@hidden_size <> size) {
				Fail("the model returned hidden size {$size}, after {$@hidden_size} before");
				return false;
			};
			return true;
		}

		#~
		Mean pooling: for each row, the mean of the token vectors whose mask is 1. A row with no
		real token pools to zeros.
		@param hidden token vectors, flat and row-major: [batch, sequence, dim]
		@param batch rows
		@param sequence tokens per row
		@param dim length of each token vector
		@param mask attention mask, flat: [batch, sequence]
		@return [batch, dim]

```
pooled := BertEmbedder->MeanPool(values, 2, 128, 768, mask);
```
		~#
		function : MeanPool(hidden : Float[], batch : Int, sequence : Int, dim : Int, mask : Int[]) ~ Float[,] {
			pooled := Float->New[batch, dim];
			for(b := 0; b < batch; b += 1;) {
				count := 0;
				for(s := 0; s < sequence; s += 1;) {
					if(mask[b * sequence + s] <> 0) {
						count += 1;
						base := (b * sequence + s) * dim;
						for(j := 0; j < dim; j += 1;) {
							pooled[b, j] := pooled[b, j] + hidden[base + j];
						};
					};
				};

				if(count > 0) {
					for(j := 0; j < dim; j += 1;) {
						pooled[b, j] := pooled[b, j] / count->As(Float);
					};
				};
			};

			return pooled;
		}

		#~
		CLS pooling: for each row, the vector of the first token.
		@param hidden token vectors, flat and row-major: [batch, sequence, dim]
		@param batch rows
		@param sequence tokens per row
		@param dim length of each token vector
		@return [batch, dim]
		~#
		function : ClsPool(hidden : Float[], batch : Int, sequence : Int, dim : Int) ~ Float[,] {
			pooled := Float->New[batch, dim];
			for(b := 0; b < batch; b += 1;) {
				base := b * sequence * dim;
				for(j := 0; j < dim; j += 1;) {
					pooled[b, j] := hidden[base + j];
				};
			};

			return pooled;
		}
	}

	#~
	One text's classification: the top label, its score, and every label's score in label
	order.
	~#
	class Prediction {
		@top_label : String;
		@index : Int;
		@score : Float;
		@scores : Float[];
		@truncated : Bool;

		#~
		Constructor, for a classifier of the program's own.
		@param top_label the top label
		@param index the top label's index
		@param score the top label's score
		@param scores every label's score, in label order
		@param truncated whether text was dropped to fit the model
		~#
		New(top_label : String, index : Int, score : Float, scores : Float[], truncated : Bool) {
			@top_label := top_label;
			@index := index;
			@score := score;
			@scores := scores;
			@truncated := truncated;
		}

		#~
		The top label, from the model's id2label.
		@return label
		~#
		method : public : GetLabel() ~ String {
			return @top_label;
		}

		#~
		The top label's index.
		@return index
		~#
		method : public : GetIndex() ~ Int {
			return @index;
		}

		#~
		The top label's score: a probability under SOFTMAX or SIGMOID, the raw logit under NONE.
		@return score
		~#
		method : public : GetScore() ~ Float {
			return @score;
		}

		#~
		Every label's score, in label order.
		@return scores
		~#
		method : public : GetScores() ~ Float[] {
			return @scores;
		}

		#~
		Whether the text was longer than the model's maximum length and was cut to fit.
		@return true when truncated
		~#
		method : public : IsTruncated() ~ Bool {
			return @truncated;
		}

		#~
		The label and its score, e.g. "POSITIVE 0.9998".
		@return text form
		~#
		method : public : ToString() ~ String {
			return "{$@top_label} {$@score}";
		}
	}

	#~
	Text classification with a fine-tuned BERT-family model, as Python's
	pipeline("text-classification"): a sentiment model, a topic classifier, a malware
	classifier fine-tuned on Colab.

	The model is a Hugging Face model folder (what save_pretrained writes, with an ONNX
	export beside it), or a Hub repository's files downloaded as they are:

	- the model: model.onnx, else onnx/model.onnx; or the file the "model" option names,
	  relative to the folder;
	- the tokenizer: tokenizer.json (WordPiece), else vocab.txt with tokenizer_config.json's
	  do_lower_case (true when absent, as BertTokenizer defaults);
	- the labels: config.json's id2label, else LABEL_0, LABEL_1, ...

	The model's own signature decides what is sent: input_ids always, attention_mask and
	token_type_ids only when declared (DistilBERT and RoBERTa exports have no
	token_type_ids). The output is logits FP32[batch, labels].

	Scores follow transformers: SIGMOID when config.json's problem_type is
	multi_label_classification or there is one label, else SOFTMAX. SetFunction overrides it.

	Texts longer than the maximum length are truncated, and the Prediction says so. The
	maximum length is the smallest of 512, the model's max_position_embeddings and the
	tokenizer's model_max_length, or the model's fixed sequence axis. Each batch is padded to
	its longest text. With an fp32 model a text's scores do not depend on which texts share
	its batch. With a dynamically quantized one (model_quantized.onnx, model_int8.onnx) they
	do, slightly: activations are quantized with a scale taken from the whole batch.
	SetBatchSize(1) gives what Python's pipeline gives one text at a time.

	With no session options, the build's default provider runs the model, and the CPU when
	that provider cannot open it: see IsCpuFallback. Any option other than "model" is a
	session option, e.g. "ep" to "cpu".

```
classifier := TextClassifier->New("distilbert-sst2");
if(<>classifier->IsOpen()) {
  classifier->GetError()->ErrorLine();
  return;
};
each(p in classifier->Classify(["I loved it", "Not worth the ticket"])) {
  p->ToString()->PrintLine();   # POSITIVE 0.9998, then NEGATIVE 0.9991
};
classifier->Close();
```
	~#
	class TextClassifier {
		#~
		How logits become scores, as transformers' function_to_apply.
		~#
		enum Function {
			#~
			Probabilities over the labels, summing to 1: single-label classification.
			~#
			SOFTMAX,
			#~
			An independent probability per label: multi-label classification, or one label.
			~#
			SIGMOID,
			#~
			The raw logits.
			~#
			NONE
		}

		@session : Session;
		@tokenizer : WordPieceTokenizer;
		@labels : String[];
		@function : TextClassifier->Function;
		@max_len : Int;
		@fixed_len : Int;
		@batch_size : Int;
		@batch_limit : Int;
		@ids_name : String;
		@mask_name : String;
		@types_name : String;
		@logits_name : String;
		@model_path : String;
		@cpu_fallback : Bool;
		@default_provider : Bool;
		@open_error : String;
		@error : String;

		#~
		Opens a model folder.
		@param folder the folder holding the model, tokenizer and config.json
		~#
		New(folder : String) {
			Open(folder, Nil);
		}

		#~
		Opens a model folder with options: "model" for the ONNX file inside the folder (e.g.
		onnx/model_quantized.onnx); anything else is a session option, e.g. "ep" to "cpu".
		@param folder the folder holding the model, tokenizer and config.json
		@param options options; may be Nil
		~#
		New(folder : String, options : Map<String, String>) {
			Open(folder, options);
		}

		method : Open(folder : String, options : Map<String, String>) ~ Nil {
			@batch_size := 8;
			@batch_limit := -1;
			@fixed_len := -1;
			@function := TextClassifier->Function->SOFTMAX;

			model_folder := ModelFolder->New(folder);
			if(<>model_folder->Exists()) {
				OpenFail(model_folder->GetError());
				return;
			};

			model_file : String;
			session_options : Map<String, String>;
			if(options <> Nil) {
				model_file := options->Find("model");
				keys := options->GetKeys()<String>;
				each(key in keys) {
					if(<>key->Equals("model")) {
						if(session_options = Nil) {
							session_options := Map->New()<String, String>;
						};
						session_options->Insert(key, options->Find(key));
					};
				};
			};

			@model_path := model_folder->FindModel(model_file);
			if(@model_path = Nil) {
				OpenFail(model_folder->GetError());
				return;
			};

			@tokenizer := model_folder->LoadWordPiece();
			if(@tokenizer = Nil) {
				OpenFail(model_folder->GetError());
				return;
			};

			config := model_folder->ReadJson("config.json");
			if(config = Nil & model_folder->GetError() <> Nil) {
				OpenFail(model_folder->GetError());
				return;
			};

			@max_len := 512;
			if(config <> Nil) {
				positions := config->Get("max_position_embeddings");
				if(positions <> Nil & positions->GetInt() > 1 & positions->GetInt() < @max_len) {
					@max_len := positions->GetInt();
				};
			};
			tokenizer_config := model_folder->ReadJson("tokenizer_config.json");
			if(tokenizer_config <> Nil) {
				model_max := tokenizer_config->Get("model_max_length");
				# transformers writes a huge sentinel (1e30) when there is no limit
				if(model_max <> Nil & model_max->GetType() = JsonElement->JsonType->NUMBER) {
					text := model_max->GetString();
					if(<>text->Has('e') & <>text->Has('E') & text->Size() < 10 & model_max->GetInt() > 1 & model_max->GetInt() < @max_len) {
						@max_len := model_max->GetInt();
					};
				};
			};

			@default_provider := session_options = Nil;
			if(session_options = Nil) {
				@session := Session->New(@model_path);
				# The build's own provider -- DirectML on Windows, CoreML on macOS -- can fail
				# where the CPU would not: a machine with no display adapter has no DirectML.
				# With no provider asked for, any provider will do, so try the CPU.
				if(<>@session->IsOpen()) {
					cpu := Map->New()<String, String>;
					cpu->Insert("ep", "cpu");
					@session := Session->New(@model_path, cpu);
					@cpu_fallback := @session->IsOpen();
				};
			}
			else {
				@session := Session->New(@model_path, session_options);
			};
			if(<>@session->IsOpen()) {
				OpenFail("the model '{$@model_path}' did not open");
				return;
			};

			if(<>ReadSignature()) {
				Close();
				return;
			};

			if(<>ReadLabels(config)) {
				Close();
				return;
			};
		}

		method : ReadSignature() ~ Bool {
			info := @session->GetModelInfo();
			if(info = Nil) {
				OpenFail("the model '{$@model_path}' reported no signature");
				return false;
			};

			inputs := info->GetInputs();
			each(spec in inputs) {
				name := spec->GetName();
				if(name->Equals("input_ids")) {
					@ids_name := name;
					shape := spec->GetShape();
					if(shape->Size() <> 2) {
						declared := spec->ToString();
						OpenFail("input_ids should be [batch, sequence]; the model declares {$declared}");
						return false;
					};
					if(shape[0] > 0) {
						@batch_limit := shape[0];
						if(@batch_size > @batch_limit) {
							@batch_size := @batch_limit;
						};
					};
					if(shape[1] > 0) {
						@fixed_len := shape[1];
						@max_len := shape[1];
					};
				}
				else if(name->Equals("attention_mask")) {
					@mask_name := name;
				}
				else if(name->Equals("token_type_ids")) {
					@types_name := name;
				}
				else {
					OpenFail("the model takes an input a text classifier does not know how to fill: '{$name}'");
					return false;
				};
			};
			if(@ids_name = Nil) {
				OpenFail("the model has no 'input_ids' input");
				return false;
			};
			if(@max_len < 2) {
				OpenFail("the model's sequence length {$@max_len} leaves no room for [CLS] and [SEP]");
				return false;
			};

			outputs := info->GetOutputs();
			each(spec in outputs) {
				if(spec->GetName()->Equals("logits")) {
					@logits_name := spec->GetName();
				};
			};
			if(@logits_name = Nil) {
				each(spec in outputs) {
					if(@logits_name = Nil & spec->GetDatatype()->Equals("FP32") & spec->GetShape()->Size() = 2) {
						@logits_name := spec->GetName();
					};
				};
			};
			if(@logits_name = Nil) {
				OpenFail("the model has no logits output (FP32, [batch, labels]): is it a sequence-classification export?");
				return false;
			};

			return true;
		}

		method : ReadLabels(config : JsonElement) ~ Bool {
			declared := -1;
			shape := @session->GetModelInfo()->Find(@logits_name)->GetShape();
			if(shape->Size() = 2 & shape[1] > 0) {
				declared := shape[1];
			};

			id2label : JsonElement;
			if(config <> Nil) {
				id2label := config->Get("id2label");
				problem := config->Get("problem_type");
				if(problem <> Nil & problem->GetString()->Equals("multi_label_classification")) {
					@function := TextClassifier->Function->SIGMOID;
				};
			};

			count := declared;
			if(id2label <> Nil & id2label->GetType() = JsonElement->JsonType->OBJECT) {
				count := id2label->Size();
				if(declared > 0 & declared <> count) {
					OpenFail("config.json names {$count} labels, but the model gives {$declared} logits");
					return false;
				};
			};
			if(count < 1) {
				OpenFail("the number of labels is unknown: config.json has no id2label and the model's logits axis is not fixed");
				return false;
			};

			@labels := String->New[count];
			for(i := 0; i < count; i += 1;) {
				@labels[i] := "LABEL_{$i}";
				if(id2label <> Nil) {
					named := id2label->Get(i->ToString());
					if(named <> Nil) {
						@labels[i] := named->GetString();
					};
				};
			};

			if(count = 1) {
				@function := TextClassifier->Function->SIGMOID;
			};

			return true;
		}

		method : ReopenOnCpu() ~ Bool {
			cpu := Map->New()<String, String>;
			cpu->Insert("ep", "cpu");
			session := Session->New(@model_path, cpu);
			if(<>session->IsOpen()) {
				return false;
			};

			@session->Close();
			@session := session;
			@cpu_fallback := true;
			return true;
		}

		method : OpenFail(reason : String) ~ Nil {
			@open_error := reason;
			Fail(reason);
		}

		method : Fail(reason : String) ~ Nil {
			@error := reason;
			EndPoint->SetLastError(reason);
		}

		#~
		Whether the model, tokenizer and labels loaded.
		@return true when Classify can run
		~#
		method : public : IsOpen() ~ Bool {
			return @session <> Nil & @session->IsOpen() & @labels <> Nil & @open_error = Nil;
		}

		#~
		Why the classifier did not open, or why the last call returned Nil.
		@return the reason, or Nil
		~#
		method : public : GetError() ~ String {
			if(@open_error <> Nil) {
				return @open_error;
			};
			return @error;
		}

		#~
		Releases the model. Safe to call more than once.
		~#
		method : public : Close() ~ Nil {
			if(@session <> Nil) {
				@session->Close();
			};
		}

		#~
		Whether the build's default provider failed to open or to run the model and the CPU
		provider was used instead. Only when no session options were given.
		@return true when running on the CPU as a fallback
		~#
		method : public : IsCpuFallback() ~ Bool {
			return @cpu_fallback;
		}

		#~
		The labels, in the order of the model's logits.
		@return labels
		~#
		method : public : GetLabels() ~ String[] {
			return @labels;
		}

		#~
		The ONNX file that was opened.
		@return path
		~#
		method : public : GetModelPath() ~ String {
			return @model_path;
		}

		#~
		How logits become scores.
		@return SOFTMAX, SIGMOID or NONE
		~#
		method : public : GetFunction() ~ TextClassifier->Function {
			return @function;
		}

		#~
		Sets how logits become scores, overriding what config.json implies.
		@param scoring SOFTMAX, SIGMOID or NONE
		~#
		method : public : SetFunction(scoring : TextClassifier->Function) ~ Nil {
			@function := scoring;
		}

		#~
		The length, in tokens, a text is truncated to, [CLS] and [SEP] included.
		@return maximum length
		~#
		method : public : GetMaxLength() ~ Int {
			return @max_len;
		}

		#~
		Sets the length, in tokens, a text is truncated to, e.g. the MAX_SEQ_LENGTH a model was
		fine-tuned with. A model with a fixed sequence axis keeps its own.
		@param max_len tokens, at least 2
		@return true when set
		~#
		method : public : SetMaxLength(max_len : Int) ~ Bool {
			if(max_len < 2) {
				Fail("max_len must be at least 2, for [CLS] and [SEP]");
				return false;
			};
			if(@fixed_len > 0 & max_len <> @fixed_len) {
				Fail("the model fixes the sequence length at {$@fixed_len}");
				return false;
			};
			@max_len := max_len;
			return true;
		}

		#~
		Texts run through the model at once.
		@return batch size
		~#
		method : public : GetBatchSize() ~ Int {
			return @batch_size;
		}

		#~
		Sets how many texts run through the model at once. A model with a fixed batch axis
		caps it. With a dynamically quantized model, 1 reproduces one-at-a-time results.
		@param batch_size texts per run, at least 1
		~#
		method : public : SetBatchSize(batch_size : Int) ~ Nil {
			@batch_size := batch_size;
			if(@batch_size < 1) {
				@batch_size := 1;
			};
			if(@batch_limit > 0 & @batch_size > @batch_limit) {
				@batch_size := @batch_limit;
			};
		}

		#~
		The tokenizer, e.g. to inspect what a text becomes.
		@return the tokenizer
		~#
		method : public : GetTokenizer() ~ WordPieceTokenizer {
			return @tokenizer;
		}

		#~
		The ONNX session, for what this class does not cover.
		@return the session
		~#
		method : public : GetSession() ~ Session {
			return @session;
		}

		#~
		Classifies one text.
		@param text the text
		@return the prediction; Nil on failure (see GetError)
		~#
		method : public : Classify(text : String) ~ Prediction {
			if(text = Nil) {
				Fail("no text");
				return Nil;
			};

			predictions := Classify([text]);
			if(predictions = Nil) {
				return Nil;
			};
			return predictions[0];
		}

		#~
		Classifies texts.
		@param texts the texts
		@return one prediction per text; Nil on failure (see GetError)
		~#
		method : public : Classify(texts : String[]) ~ Prediction[] {
			encodings := Encode(texts);
			if(encodings = Nil) {
				return Nil;
			};

			scores := Score(RunEncoded(encodings));
			if(scores = Nil) {
				return Nil;
			};

			count := @labels->Size();
			predictions := Prediction->New[texts->Size()];
			each(i : predictions) {
				row := Float->New[count];
				best := 0;
				for(j := 0; j < count; j += 1;) {
					row[j] := scores[i, j];
					if(row[j] > row[best]) {
						best := j;
					};
				};
				predictions[i] := Prediction->New(@labels[best], best, row[best], row, encodings[i]->IsTruncated());
			};

			return predictions;
		}

		#~
		Every label's score for each text, with the configured function.
		@param texts the texts
		@return [texts, labels]; Nil on failure (see GetError)
		~#
		method : public : Scores(texts : String[]) ~ Float[,] {
			encodings := Encode(texts);
			if(encodings = Nil) {
				return Nil;
			};
			return Score(RunEncoded(encodings));
		}

		#~
		The raw logits for each text.
		@param texts the texts
		@return [texts, labels]; Nil on failure (see GetError)
		~#
		method : public : Logits(texts : String[]) ~ Float[,] {
			encodings := Encode(texts);
			if(encodings = Nil) {
				return Nil;
			};
			return RunEncoded(encodings);
		}

		method : Encode(texts : String[]) ~ TokenEncoding[] {
			if(texts = Nil) {
				Fail("no texts");
				return Nil;
			};
			if(<>IsOpen()) {
				return Nil;
			};

			encodings := TokenEncoding->New[texts->Size()];
			each(i : texts) {
				if(texts[i] = Nil) {
					Fail("text {$i} is Nil");
					return Nil;
				};
				encodings[i] := @tokenizer->Encode(texts[i], @max_len);
				if(encodings[i] = Nil) {
					reason := @tokenizer->GetError();
					Fail("text {$i} could not be encoded: {$reason}");
					return Nil;
				};
			};

			return encodings;
		}

		method : RunEncoded(encodings : TokenEncoding[]) ~ Float[,] {
			count := encodings->Size();
			labels := @labels->Size();
			logits := Float->New[count, labels];

			start := 0;
			while(start < count) {
				rows := count - start;
				if(rows > @batch_size) {
					rows := @batch_size;
				};

				batch := RunBatch(encodings, start, rows);
				if(batch = Nil) {
					return Nil;
				};
				for(r := 0; r < rows; r += 1;) {
					for(j := 0; j < labels; j += 1;) {
						logits[start + r, j] := batch[r * labels + j];
					};
				};
				start += rows;
			};

			@error := Nil;
			return logits;
		}

		method : RunBatch(encodings : TokenEncoding[], start : Int, rows : Int) ~ Float[] {
			# pad to the longest text of the batch, or to a fixed sequence axis
			length := @fixed_len;
			if(length < 0) {
				length := 2;
				for(r := 0; r < rows; r += 1;) {
					used := encodings[start + r]->GetLength();
					if(used > length) {
						length := used;
					};
				};
			};

			ids := Int->New[rows * length];
			mask := Int->New[rows * length];
			types := Int->New[rows * length];
			for(r := 0; r < rows; r += 1;) {
				encoding := encodings[start + r];
				row_ids := encoding->GetIds();
				row_mask := encoding->GetAttentionMask();
				row_types := encoding->GetTokenTypeIds();
				for(s := 0; s < length; s += 1;) {
					ids[r * length + s] := row_ids[s];
					mask[r * length + s] := row_mask[s];
					types[r * length + s] := row_types[s];
				};
			};

			inputs := Vector->New()<Tensor>;
			inputs->AddBack(Tensor->New(@ids_name, [rows, length], ids));
			if(@mask_name <> Nil) {
				inputs->AddBack(Tensor->New(@mask_name, [rows, length], mask));
			};
			if(@types_name <> Nil) {
				inputs->AddBack(Tensor->New(@types_name, [rows, length], types));
			};

			outputs := @session->Run(inputs, [@logits_name]);
			# The build's provider can open a model and still fail to run it: CoreML on macOS
			# refuses some nodes of a torch.export-based export only when they execute. With no
			# provider asked for, any provider will do, so run on the CPU, as opening does.
			if((outputs = Nil | outputs->Size() = 0) & @default_provider & <>@cpu_fallback & ReopenOnCpu()) {
				outputs := @session->Run(inputs, [@logits_name]);
			};
			if(outputs = Nil | outputs->Size() = 0) {
				Fail("the model run failed; ONNX Runtime's reason is on standard error");
				return Nil;
			};

			tensor := outputs->Get(0);
			shape := tensor->GetShape();
			labels := @labels->Size();
			if(shape->Size() <> 2 | shape[0] <> rows | shape[1] <> labels) {
				got := tensor->ToString();
				Fail("logits came back as {$got}, not [{$rows}, {$labels}]");
				return Nil;
			};

			values := tensor->GetFloats();
			if(values = Nil) {
				values := tensor->AsFloats();
			};
			return values;
		}

		method : Score(logits : Float[,]) ~ Float[,] {
			if(logits = Nil) {
				return Nil;
			};

			dims := logits->Size();
			count := dims[0];
			labels := dims[1];
			if(@function = TextClassifier->Function->NONE) {
				return logits;
			};

			scores := Float->New[count, labels];
			for(i := 0; i < count; i += 1;) {
				if(@function = TextClassifier->Function->SIGMOID) {
					for(j := 0; j < labels; j += 1;) {
						scores[i, j] := Sigmoid(logits[i, j]);
					};
				}
				else {
					# softmax, shifted by the row's maximum so exp cannot overflow
					top := logits[i, 0];
					for(j := 1; j < labels; j += 1;) {
						if(logits[i, j] > top) {
							top := logits[i, j];
						};
					};
					sum := 0.0;
					for(j := 0; j < labels; j += 1;) {
						scores[i, j] := (logits[i, j] - top)->Exp();
						sum += scores[i, j];
					};
					for(j := 0; j < labels; j += 1;) {
						scores[i, j] := scores[i, j] / sum;
					};
				};
			};

			return scores;
		}

		function : Sigmoid(z : Float) ~ Float {
			if(z >= 0.0) {
				return 1.0 / (1.0 + (0.0 - z)->Exp());
			};
			e := z->Exp();
			return e / (1.0 + e);
		}
	}

	# A Hugging Face model folder: finds the ONNX file, reads its JSON files and builds its
	# tokenizer. Shared by the task classes; not API.
	class : private : ModelFolder {
		@folder : String;
		@error : String;

		New(folder : String) {
			@folder := folder;
		}

		method : public : GetError() ~ String {
			return @error;
		}

		method : public : Exists() ~ Bool {
			if(@folder = Nil | <>System.IO.Filesystem.Directory->Exists(@folder)) {
				@error := "the model folder '{$@folder}' does not exist";
				return false;
			};
			return true;
		}

		method : public : Path(name : String) ~ String {
			path := @folder->Clone();
			if(<>path->EndsWith("/") & <>path->EndsWith("\\")) {
				path += '/';
			};
			path += name;
			return path;
		}

		# the named file, else model.onnx, else onnx/model.onnx -- the fp32 export, so results
		# match the framework's; a quantized variant is used only when named
		method : public : FindModel(name : String) ~ String {
			if(name <> Nil) {
				path := Path(name);
				if(<>System.IO.Filesystem.File->Exists(path)) {
					@error := "the model file '{$path}' does not exist";
					return Nil;
				};
				return path;
			};

			candidates := ["model.onnx", "onnx/model.onnx"];
			each(candidate in candidates) {
				path := Path(candidate);
				if(System.IO.Filesystem.File->Exists(path)) {
					return path;
				};
			};

			@error := "no model.onnx or onnx/model.onnx in '{$@folder}'; name the file with the \"model\" option";
			return Nil;
		}

		# a JSON file of the folder; Nil with no error when it is absent, Nil with an error
		# when it does not parse
		method : public : ReadJson(name : String) ~ JsonElement {
			@error := Nil;
			path := Path(name);
			if(<>System.IO.Filesystem.File->Exists(path)) {
				return Nil;
			};

			text := System.IO.Filesystem.FileReader->ReadFile(path);
			if(text = Nil) {
				@error := "cannot read '{$path}'";
				return Nil;
			};

			root := JsonParser->TextToElement(text);
			if(root = Nil | root->GetType() <> JsonElement->JsonType->OBJECT) {
				@error := "'{$path}' is not a JSON object";
				return Nil;
			};
			return root;
		}

		# tokenizer.json when present, else vocab.txt with tokenizer_config.json
		method : public : LoadWordPiece() ~ WordPieceTokenizer {
			root := ReadJson("tokenizer.json");
			if(root <> Nil) {
				return FromTokenizerJson(root);
			};
			if(@error <> Nil) {
				return Nil;
			};

			vocab := Path("vocab.txt");
			if(<>System.IO.Filesystem.File->Exists(vocab)) {
				@error := "no tokenizer.json or vocab.txt in '{$@folder}'";
				return Nil;
			};

			# BertTokenizer's defaults: lowercase, and strip accents when lowercasing
			lower_case := true;
			strip_accents := true;
			config := ReadJson("tokenizer_config.json");
			if(@error <> Nil) {
				return Nil;
			};
			if(config <> Nil) {
				lower := config->Get("do_lower_case");
				if(lower <> Nil & IsBool(lower)) {
					lower_case := lower->GetType() = JsonElement->JsonType->TRUE;
				};
				strip_accents := lower_case;
				strip := config->Get("strip_accents");
				if(strip <> Nil & IsBool(strip)) {
					strip_accents := strip->GetType() = JsonElement->JsonType->TRUE;
				};
			};

			tokenizer := WordPieceTokenizer->New(vocab, lower_case, strip_accents);
			if(<>tokenizer->IsLoaded()) {
				@error := tokenizer->GetError();
				return Nil;
			};
			return tokenizer;
		}

		method : FromTokenizerJson(root : JsonElement) ~ WordPieceTokenizer {
			path := Path("tokenizer.json");
			model := root->Get("model");
			if(model = Nil | model->Get("type") = Nil) {
				@error := "'{$path}' has no model";
				return Nil;
			};

			type := model->Get("type")->GetString();
			if(<>type->Equals("WordPiece")) {
				@error := "'{$path}' is a {$type} tokenizer; this release reads WordPiece (BERT, DistilBERT, MiniLM) only";
				return Nil;
			};

			prefix := model->Get("continuing_subword_prefix");
			if(prefix <> Nil & prefix->GetType() = JsonElement->JsonType->STRING & <>prefix->GetString()->Equals("##")) {
				text := prefix->GetString();
				@error := "'{$path}' marks word continuations with '{$text}', not '##'";
				return Nil;
			};

			pre := root->Get("pre_tokenizer");
			if(pre <> Nil & pre->GetType() = JsonElement->JsonType->OBJECT) {
				pre_type := pre->Get("type");
				if(pre_type <> Nil & <>pre_type->GetString()->Equals("BertPreTokenizer")) {
					text := pre_type->GetString();
					@error := "'{$path}' splits words with {$text}; this release reads BertPreTokenizer only";
					return Nil;
				};
			};

			# BertNormalizer: strip_accents null means "as lowercase does"
			lower_case := false;
			strip_accents := false;
			normalizer := root->Get("normalizer");
			if(normalizer <> Nil & normalizer->GetType() = JsonElement->JsonType->OBJECT) {
				norm_type := normalizer->Get("type");
				if(norm_type = Nil | <>norm_type->GetString()->Equals("BertNormalizer")) {
					text := "?";
					if(norm_type <> Nil) {
						text := norm_type->GetString();
					};
					@error := "'{$path}' normalizes with {$text}; this release reads BertNormalizer only";
					return Nil;
				};
				lower := normalizer->Get("lowercase");
				if(lower <> Nil & IsBool(lower)) {
					lower_case := lower->GetType() = JsonElement->JsonType->TRUE;
				};
				strip_accents := lower_case;
				strip := normalizer->Get("strip_accents");
				if(strip <> Nil & IsBool(strip)) {
					strip_accents := strip->GetType() = JsonElement->JsonType->TRUE;
				};
			};

			vocab := model->Get("vocab");
			if(vocab = Nil | vocab->GetType() <> JsonElement->JsonType->OBJECT) {
				@error := "'{$path}' has no WordPiece vocabulary";
				return Nil;
			};

			names := vocab->GetNames();
			top := -1;
			each(name in names) {
				id := vocab->Get(name)->GetInt();
				if(id > top) {
					top := id;
				};
			};
			if(top < 0) {
				@error := "'{$path}' has an empty vocabulary";
				return Nil;
			};

			# ids are the vocabulary's indexes; an id with no token stays Nil
			tokens := String->New[top + 1];
			each(name in names) {
				id := vocab->Get(name)->GetInt();
				if(id >= 0) {
					tokens[id] := name;
				};
			};

			tokenizer := WordPieceTokenizer->New(tokens, lower_case, strip_accents);
			if(<>tokenizer->IsLoaded()) {
				@error := tokenizer->GetError();
				return Nil;
			};
			return tokenizer;
		}

		function : IsBool(value : JsonElement) ~ Bool {
			return value->GetType() = JsonElement->JsonType->TRUE | value->GetType() = JsonElement->JsonType->FALSE;
		}
	}
}
