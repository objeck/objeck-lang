use Collection;
use Data.CSV;
use Data.JSON;
use System.ML;

#~
Experiment support for a parameter sweep: a deterministic stratified hold-out split, class-ratio resampling of the training half against a fixed test set, a wall-clock stopwatch and label helpers. Compile with -lib ml,ml_lab,csv,json, or with the ai alias group. Design: docs/ML_LAB_SUPPORT_DESIGN.md.
~#
bundle System.ML.Lab {
	#~
	Raised by every System.ML.Lab function that is handed input it cannot act on,
	with a message naming the problem. Uncaught, the program ends printing it;
	catch it with try { } on(e : LabError) { }.
	~#
	class LabError from Error {
		#~
		Constructor
		@param message what was refused and why
		~#
		New(message : String) {
			Parent(message);
		}
	}

	#~
	The row indexes of a train/test split, each half in ascending order.
	~#
	class IndexSplit {
		@train : Int[];
		@test : Int[];

		#~
		Constructor
		@param train training row indexes, ascending
		@param test test row indexes, ascending
		~#
		New(train : Int[], test : Int[]) {
			@train := train;
			@test := test;
		}

		#~
		Training row indexes, ascending.
		@return row indexes
		~#
		method : public : GetTrain() ~ Int[] {
			return @train;
		}

		#~
		Test row indexes, ascending.
		@return row indexes
		~#
		method : public : GetTest() ~ Int[] {
			return @test;
		}
	}

	#~
	The matrices and labels of a train/test split, plus the source row of every
	row in each half so predictions can be joined back to the original table.
	~#
	class DataSplit {
		@train_x : Float[,];
		@train_y : Bool[];
		@test_x : Float[,];
		@test_y : Bool[];
		@train_rows : Int[];
		@test_rows : Int[];

		#~
		Constructor
		@param train_x training rows x features
		@param train_y one label per training row
		@param test_x test rows x features
		@param test_y one label per test row
		@param train_rows source row of each training row
		@param test_rows source row of each test row
		~#
		New(train_x : Float[,], train_y : Bool[], test_x : Float[,], test_y : Bool[], train_rows : Int[], test_rows : Int[]) {
			@train_x := train_x;
			@train_y := train_y;
			@test_x := test_x;
			@test_y := test_y;
			@train_rows := train_rows;
			@test_rows := test_rows;
		}

		#~
		Training features.
		@return training rows x features
		~#
		method : public : GetTrainX() ~ Float[,] {
			return @train_x;
		}

		#~
		Training labels.
		@return one label per training row
		~#
		method : public : GetTrainY() ~ Bool[] {
			return @train_y;
		}

		#~
		Test features.
		@return test rows x features
		~#
		method : public : GetTestX() ~ Float[,] {
			return @test_x;
		}

		#~
		Test labels.
		@return one label per test row
		~#
		method : public : GetTestY() ~ Bool[] {
			return @test_y;
		}

		#~
		Source row of each training row, ascending.
		@return row indexes into the matrix that was split
		~#
		method : public : GetTrainRows() ~ Int[] {
			return @train_rows;
		}

		#~
		Source row of each test row, ascending.
		@return row indexes into the matrix that was split
		~#
		method : public : GetTestRows() ~ Int[] {
			return @test_rows;
		}

		#~
		Rows in the training half.
		@return training row count
		~#
		method : public : GetTrainSize() ~ Int {
			return @train_y->Size();
		}

		#~
		Rows in the test half.
		@return test row count
		~#
		method : public : GetTestSize() ~ Int {
			return @test_y->Size();
		}
	}

	#~
	A deterministic, stratified train/test hold-out split.

	Allocation is per stratum and exact: a stratum of n rows contributes
	Float->Round(n * test_fraction) rows to the test half, clamped so that every
	stratum has at least one row in each half. Within a stratum the rows are
	shuffled from the seed (Fisher-Yates over a MINSTD generator), so the same
	inputs and seed select the same rows on every platform. Each half comes back
	in ascending source-row order.

	Named Partition rather than Split because System.ML already has a Split
	class (a tree's split point), and a program that uses both bundles would
	find the name ambiguous.

```
split := Partition->TrainTest(X, y, 0.3, 42, true);
model->Fit(split->GetTrainX(), split->GetTrainY());
preds := model->PredictClass(split->GetTestX());
```
	~#
	class Partition {
		#~
		Splits features and binary labels, optionally stratified by the label.
		@param X rows x features
		@param y one label per row, true for the positive class
		@param test_fraction share of each stratum that goes to the test half, in (0, 1)
		@param seed seeds the shuffle; the same seed reproduces the same split
		@param stratify true keeps the positive rate equal in both halves
		@return the split; raises LabError on bad input or a stratum with fewer than 2 rows
		~#
		function : TrainTest(X : Float[,], y : Bool[], test_fraction : Float, seed : Int, stratify : Bool) ~ DataSplit {
			if(y = Nil) {
				Refuse("y is Nil");
			};

			strata := Float->New[y->Size()];
			if(stratify) {
				each(i : y) {
					if(y[i]) {
						strata[i] := 1.0;
					};
				};
			};

			return TrainTest(X, y, strata, test_fraction, seed);
		}

		#~
		Splits features and binary labels, stratified by caller-supplied codes.

		The codes can be anything the test half should keep in proportion: the
		attack family behind a binary label, a device model, a day of capture.
		One code per row; a stratum is every row sharing a code.
		@param X rows x features
		@param y one label per row, true for the positive class
		@param strata one code per row
		@param test_fraction share of each stratum that goes to the test half, in (0, 1)
		@param seed seeds the shuffle
		@return the split; raises LabError on bad input or a stratum with fewer than 2 rows
		~#
		function : TrainTest(X : Float[,], y : Bool[], strata : Float[], test_fraction : Float, seed : Int) ~ DataSplit {
			if(X = Nil) {
				Refuse("X is Nil");
			};
			if(y = Nil) {
				Refuse("y is Nil");
			};

			dims := X->Size();
			rows := dims[0];
			if(y->Size() <> rows) {
				ys := y->Size();
				Refuse("X has {$rows} rows but y has {$ys} labels");
			};

			idx := Indices(strata, test_fraction, seed);
			train := idx->GetTrain();
			test := idx->GetTest();

			return DataSplit->New(Take(X, train), Take(y, train), Take(X, test), Take(y, test), train, test);
		}

		#~
		The row indexes of a stratified split, without copying any data.

		Strata holding a single distinct value give an unstratified split of
		Float->Round(rows * test_fraction) test rows.
		@param strata one code per row
		@param test_fraction share of each stratum that goes to the test half, in (0, 1)
		@param seed seeds the shuffle
		@return the indexes, each half ascending; raises LabError on bad input or a stratum with fewer than 2 rows
		~#
		function : Indices(strata : Float[], test_fraction : Float, seed : Int) ~ IndexSplit {
			if(strata = Nil) {
				Refuse("strata is Nil");
			};

			rows := strata->Size();
			if(rows < 2) {
				Refuse("{$rows} row(s); at least 2 are needed to split");
			};

			if(test_fraction <= 0.0 | test_fraction >= 1.0) {
				Refuse("test_fraction must be in (0, 1), got {$test_fraction}");
			};

			# Hoisted: a local declared inside a nested block and read outside it
			# is a known way to fault in this compiler.
			found : Int;
			n : Int;
			p : Int;
			k : Int;
			j : Int;
			t : Int;
			code : String;
			idx : Int[];

			# distinct codes in first-seen order, and each row's code index
			class_values := Float->New[rows];
			class_of := Int->New[rows];
			class_count := 0;
			each(i : rows) {
				found := -1;
				each(c : class_count) {
					if(class_values[c] = strata[i]) {
						found := c;
					};
				};

				if(found < 0) {
					class_values[class_count] := strata[i];
					found := class_count;
					class_count += 1;
				};

				class_of[i] := found;
			};

			in_test := Bool->New[rows];
			test_total := 0;
			rnd := Random->New(seed);

			each(c : class_count) {
				n := 0;
				each(i : rows) {
					if(class_of[i] = c) {
						n += 1;
					};
				};

				if(n < 2) {
					code := FormatCode(class_values[c]);
					Refuse("stratum {$code} has {$n} row; at least 2 are needed to put one in each half");
				};

				idx := Int->New[n];
				p := 0;
				each(i : rows) {
					if(class_of[i] = c) {
						idx[p] := i;
						p += 1;
					};
				};

				# exact share, then at least one row in each half
				k := Float->Round(n->As(Float) * test_fraction)->As(Int);
				if(k < 1) {
					k := 1;
				};
				if(k > n - 1) {
					k := n - 1;
				};

				# Fisher-Yates, downward, from the seeded generator
				for(i := n - 1; i > 0; i -= 1;) {
					j := rnd->NextInt(i + 1);
					t := idx[i];
					idx[i] := idx[j];
					idx[j] := t;
				};

				each(i : k) {
					in_test[idx[i]] := true;
				};
				test_total += k;
			};

			train := Int->New[rows - test_total];
			test := Int->New[test_total];
			ti := 0;
			si := 0;
			each(i : rows) {
				if(in_test[i]) {
					test[si] := i;
					si += 1;
				}
				else {
					train[ti] := i;
					ti += 1;
				};
			};

			return IndexSplit->New(train, test);
		}

		#~
		Gathers rows of a matrix, in the order given.
		@param X rows x features
		@param rows row indexes to take
		@return a new matrix of rows->Size() rows; raises LabError on a bad index
		~#
		function : Take(X : Float[,], rows : Int[]) ~ Float[,] {
			if(X = Nil | rows = Nil) {
				Refuse("Take: X or rows is Nil");
			};

			dims := X->Size();
			count := dims[0];
			cols := dims[1];
			result := Float->New[rows->Size(), cols];
			r : Int;
			each(i : rows) {
				r := rows[i];
				if(r < 0 | r >= count) {
					Refuse("Take: row {$r} is outside 0..{$count}");
				};
				each(c : cols) {
					result[i, c] := X[r, c];
				};
			};

			return result;
		}

		#~
		Gathers labels, in the order given.
		@param y one label per row
		@param rows row indexes to take
		@return a new array of rows->Size() labels; raises LabError on a bad index
		~#
		function : Take(y : Bool[], rows : Int[]) ~ Bool[] {
			if(y = Nil | rows = Nil) {
				Refuse("Take: y or rows is Nil");
			};

			count := y->Size();
			result := Bool->New[rows->Size()];
			r : Int;
			each(i : rows) {
				r := rows[i];
				if(r < 0 | r >= count) {
					Refuse("Take: row {$r} is outside 0..{$count}");
				};
				result[i] := y[r];
			};

			return result;
		}

		#~
		Gathers values, in the order given.
		@param y one value per row
		@param rows row indexes to take
		@return a new array of rows->Size() values; raises LabError on a bad index
		~#
		function : Take(y : Float[], rows : Int[]) ~ Float[] {
			if(y = Nil | rows = Nil) {
				Refuse("Take: y or rows is Nil");
			};

			count := y->Size();
			result := Float->New[rows->Size()];
			r : Int;
			each(i : rows) {
				r := rows[i];
				if(r < 0 | r >= count) {
					Refuse("Take: row {$r} is outside 0..{$count}");
				};
				result[i] := y[r];
			};

			return result;
		}

		# a stratum code as a reader would write it: 2 rather than 2.000000
		function : FormatCode(code : Float) ~ String {
			if(code = Float->Floor(code) & Float->Abs(code) < 1.0e15) {
				return code->As(Int)->ToString();
			};

			return code->ToString();
		}

		function : Refuse(message : String) ~ Nil {
			Runtime->Raise(LabError->New("Partition: " + message));
		}
	}

	#~
	A resampled training set: features, labels and the source row of every row,
	so duplicates from oversampling are visible.
	~#
	class Sample {
		@x : Float[,];
		@y : Bool[];
		@rows : Int[];

		#~
		Constructor
		@param x rows x features
		@param y one label per row
		@param rows source row of each row
		~#
		New(x : Float[,], y : Bool[], rows : Int[]) {
			@x := x;
			@y := y;
			@rows := rows;
		}

		#~
		Features.
		@return rows x features
		~#
		method : public : GetX() ~ Float[,] {
			return @x;
		}

		#~
		Labels.
		@return one label per row
		~#
		method : public : GetY() ~ Bool[] {
			return @y;
		}

		#~
		Source row of each row of the sample. A row drawn twice by oversampling
		appears twice.
		@return row indexes into the matrix that was resampled
		~#
		method : public : GetRows() ~ Int[] {
			return @rows;
		}

		#~
		Rows in the sample.
		@return row count
		~#
		method : public : Size() ~ Int {
			return @y->Size();
		}

		#~
		Share of positive rows actually achieved; report this, not the request.
		@return positives over rows
		~#
		method : public : GetPositiveRatio() ~ Float {
			return Resample->PositiveRatio(@y);
		}
	}

	#~
	Changes the class balance of a TRAINING set to a requested positive ratio.

	The class-imbalance experiment trains at ratios from 0.001 to 0.5 and must
	measure every run on the same test set. These functions take only the
	training half, so the order is fixed by construction: Partition->TrainTest
	first, then resample what it returned as training data; the test half is
	never touched.

```
split := Partition->TrainTest(X, y, 0.3, 42, true);
each(r : ratios) {
  train := Resample->ToPositiveRatio(split->GetTrainX(), split->GetTrainY(), ratios[r], 42);
  model->Fit(train->GetX(), train->GetY());
  preds := model->PredictClass(split->GetTestX());   # the same test set every time
};
```
	~#
	class Resample {
		#~
		Down-samples the over-represented class until positives / rows is the
		requested ratio; the other class is kept whole.

		If the current ratio is above the request, positives are cut to
		Round(ratio * negatives / (1 - ratio)); otherwise negatives are cut to
		Round(positives * (1 - ratio) / ratio). The rows kept are chosen by a seeded
		shuffle and returned in ascending source order. The achieved ratio is exact
		when the arithmetic allows and otherwise within one row; Sample->GetPositiveRatio
		reports it.
		@param X training rows x features
		@param y one training label per row
		@param ratio requested positives / rows, in (0, 1)
		@param seed seeds the choice of rows
		@return the resampled training set; raises LabError when a class is empty, the ratio is out of range, or the request would keep zero rows of a class
		~#
		function : ToPositiveRatio(X : Float[,], y : Bool[], ratio : Float, seed : Int) ~ Sample {
			return ToPositiveRatio(X, y, ratio, seed, false);
		}

		#~
		Reaches the requested ratio by down-sampling (oversample false, as above)
		or by duplicating the under-represented class (oversample true): rows of
		that class are drawn with replacement from a seeded generator and appended
		after the original rows, and nothing is dropped.
		@param X training rows x features
		@param y one training label per row
		@param ratio requested positives / rows, in (0, 1)
		@param seed seeds the choice of rows
		@param oversample true duplicates the minority instead of dropping the majority
		@return the resampled training set; raises LabError on bad input
		~#
		function : ToPositiveRatio(X : Float[,], y : Bool[], ratio : Float, seed : Int, oversample : Bool) ~ Sample {
			if(X = Nil) {
				Refuse("X is Nil");
			};
			if(y = Nil) {
				Refuse("y is Nil");
			};

			dims := X->Size();
			rows := dims[0];
			if(y->Size() <> rows) {
				ys := y->Size();
				Refuse("X has {$rows} rows but y has {$ys} labels");
			};

			if(ratio <= 0.0 | ratio >= 1.0) {
				Refuse("ratio must be in (0, 1), got {$ratio}");
			};

			pos := CountPositives(y);
			neg := rows - pos;
			if(pos = 0) {
				Refuse("no positive rows to resample");
			};
			if(neg = 0) {
				Refuse("no negative rows to resample");
			};

			pos_rows := Int->New[pos];
			neg_rows := Int->New[neg];
			pi := 0;
			ni := 0;
			each(i : rows) {
				if(y[i]) {
					pos_rows[pi] := i;
					pi += 1;
				}
				else {
					neg_rows[ni] := i;
					ni += 1;
				};
			};

			current := pos->As(Float) / rows->As(Float);
			rnd := Random->New(seed);
			keep : Int[];

			if(oversample) {
				if(current < ratio) {
					target := Float->Round(ratio * neg->As(Float) / (1.0 - ratio))->As(Int);
					keep := Append(rows, Draw(pos_rows, target - pos, rnd));
				}
				else {
					target := Float->Round(pos->As(Float) * (1.0 - ratio) / ratio)->As(Int);
					keep := Append(rows, Draw(neg_rows, target - neg, rnd));
				};
			}
			else {
				if(current > ratio) {
					target := Float->Round(ratio * neg->As(Float) / (1.0 - ratio))->As(Int);
					if(target < 1) {
						Refuse("ratio {$ratio} would keep 0 of {$pos} positives against {$neg} negatives; pass oversample true or ask for a larger ratio");
					};
					keep := Merge(Choose(pos_rows, target, rnd), neg_rows);
				}
				else {
					target := Float->Round(pos->As(Float) * (1.0 - ratio) / ratio)->As(Int);
					if(target < 1) {
						Refuse("ratio {$ratio} would keep 0 of {$neg} negatives against {$pos} positives; pass oversample true or ask for a smaller ratio");
					};
					keep := Merge(pos_rows, Choose(neg_rows, target, rnd));
				};
			};

			return Sample->New(Partition->Take(X, keep), Partition->Take(y, keep), keep);
		}

		#~
		Share of positive labels.
		@param y labels
		@return positives over rows, 0.0 for an empty or Nil array
		~#
		function : PositiveRatio(y : Bool[]) ~ Float {
			if(y = Nil | y->Size() = 0) {
				return 0.0;
			};

			return CountPositives(y)->As(Float) / y->Size()->As(Float);
		}

		#~
		Number of positive labels.
		@param y labels
		@return count of true values, 0 for Nil
		~#
		function : CountPositives(y : Bool[]) ~ Int {
			if(y = Nil) {
				return 0;
			};

			count := 0;
			each(i : y) {
				if(y[i]) {
					count += 1;
				};
			};

			return count;
		}

		# the first `count` of a seeded shuffle of `rows`, in ascending order
		function : Choose(rows : Int[], count : Int, rnd : Random) ~ Int[] {
			n := rows->Size();
			idx := Int->New[n];
			each(i : n) {
				idx[i] := rows[i];
			};

			j : Int;
			t : Int;
			for(i := n - 1; i > 0; i -= 1;) {
				j := rnd->NextInt(i + 1);
				t := idx[i];
				idx[i] := idx[j];
				idx[j] := t;
			};

			chosen := Int->New[count];
			each(i : count) {
				chosen[i] := idx[i];
			};

			return SortAscending(chosen);
		}

		# `count` draws with replacement, in draw order
		function : Draw(rows : Int[], count : Int, rnd : Random) ~ Int[] {
			n := rows->Size();
			if(count < 0) {
				count := 0;
			};

			drawn := Int->New[count];
			each(i : count) {
				drawn[i] := rows[rnd->NextInt(n)];
			};

			return drawn;
		}

		# 0..rows-1 followed by the extra draws
		function : Append(rows : Int, extra : Int[]) ~ Int[] {
			out := Int->New[rows + extra->Size()];
			each(i : rows) {
				out[i] := i;
			};
			each(i : extra) {
				out[rows + i] := extra[i];
			};

			return out;
		}

		# two ascending lists merged into one ascending list
		function : Merge(a : Int[], b : Int[]) ~ Int[] {
			out := Int->New[a->Size() + b->Size()];
			i := 0;
			j := 0;
			p := 0;
			while(i < a->Size() & j < b->Size()) {
				if(a[i] < b[j]) {
					out[p] := a[i];
					i += 1;
				}
				else {
					out[p] := b[j];
					j += 1;
				};
				p += 1;
			};
			while(i < a->Size()) {
				out[p] := a[i];
				i += 1;
				p += 1;
			};
			while(j < b->Size()) {
				out[p] := b[j];
				j += 1;
				p += 1;
			};

			return out;
		}

		# insertion sort: the lists here are the kept rows of one class
		function : SortAscending(values : Int[]) ~ Int[] {
			n := values->Size();
			v : Int;
			j : Int;
			for(i := 1; i < n; i += 1;) {
				v := values[i];
				j := i - 1;
				while(j >= 0 & values[j] > v) {
					values[j + 1] := values[j];
					j -= 1;
				};
				values[j + 1] := v;
			};

			return values;
		}

		function : Refuse(message : String) ~ Nil {
			Runtime->Raise(LabError->New("Resample: " + message));
		}
	}

	#~
	A wall-clock stopwatch with sub-millisecond resolution, for training time.

	Accumulates across Start/Stop pairs until Reset. Built on System.Time.Timer,
	which measures elapsed (wall-clock) time on every platform.

```
sw := Stopwatch->New();
sw->Start();
model->Fit(train_x, train_y);
ms := sw->Stop();
"fit took {$ms} ms"->PrintLine();
```
	~#
	class Stopwatch {
		@timer : System.Time.Timer;
		@accumulated_ms : Float;
		@running : Bool;

		#~
		Constructor; the stopwatch is stopped at zero.
		~#
		New() {
			@timer := System.Time.Timer->New();
			@accumulated_ms := 0.0;
			@running := false;
		}

		#~
		Starts timing. Starting a running stopwatch has no effect.
		~#
		method : public : Start() ~ Nil {
			if(<>@running) {
				@timer->Start();
				@running := true;
			};
		}

		#~
		Stops timing and adds the interval to the total.
		@return the total elapsed milliseconds so far
		~#
		method : public : Stop() ~ Float {
			if(@running) {
				@timer->End();
				@accumulated_ms += @timer->GetElapsedTime() * 1000.0;
				@running := false;
			};

			return @accumulated_ms;
		}

		#~
		Stops and clears the total.
		~#
		method : public : Reset() ~ Nil {
			@running := false;
			@accumulated_ms := 0.0;
		}

		#~
		Whether Start has been called without a matching Stop.
		@return true while timing
		~#
		method : public : IsRunning() ~ Bool {
			return @running;
		}

		#~
		Total elapsed milliseconds, including the interval still running.
		@return milliseconds
		~#
		method : public : GetElapsedMs() ~ Float {
			if(@running) {
				# Timer->End freezes its interval, so bank it and start a new one
				@timer->End();
				@accumulated_ms += @timer->GetElapsedTime() * 1000.0;
				@timer->Start();
			};

			return @accumulated_ms;
		}

		#~
		Total elapsed seconds, including the interval still running.
		@return seconds
		~#
		method : public : GetElapsedSeconds() ~ Float {
			return GetElapsedMs() / 1000.0;
		}
	}

	#~
	Label helpers for labels that arrive as strings or need to become strata.

	TableEncoder already maps a CsvTable's label column; these cover a String[]
	read any other way, and the multi-class codes a split or k-fold can be
	stratified by.

```
names := Labels->Column(table, "class");
y := Labels->ToBinaryExcept(names, "normal");         # attacks are positive
families := Labels->ToIndices(names, Labels->Classes(names));
split := Partition->TrainTest(X, y, families, 0.3, 42);
```
	~#
	class Labels {
		#~
		True where the value equals the positive label.
		@param values one label per row
		@param positive the value that is the positive class
		@return one Bool per row; raises LabError for Nil input
		~#
		function : ToBinary(values : String[], positive : String) ~ Bool[] {
			if(values = Nil | positive = Nil) {
				Refuse("ToBinary: values or positive is Nil");
			};

			out := Bool->New[values->Size()];
			each(i : values) {
				out[i] := values[i] <> Nil & values[i]->Equals(positive);
			};

			return out;
		}

		#~
		True everywhere except where the value equals the negative label: the
		intrusion-detection shape, one benign value against many attack names.
		@param values one label per row
		@param negative the value that is the negative class
		@return one Bool per row; raises LabError for Nil input
		~#
		function : ToBinaryExcept(values : String[], negative : String) ~ Bool[] {
			if(values = Nil | negative = Nil) {
				Refuse("ToBinaryExcept: values or negative is Nil");
			};

			out := Bool->New[values->Size()];
			each(i : values) {
				out[i] := values[i] = Nil | <>values[i]->Equals(negative);
			};

			return out;
		}

		#~
		Distinct values in first-seen order.
		@param values labels
		@return the distinct values; raises LabError for Nil input
		~#
		function : Classes(values : String[]) ~ String[] {
			if(values = Nil) {
				Refuse("Classes: values is Nil");
			};

			seen := Vector->New()<String>;
			each(i : values) {
				if(values[i] <> Nil & IndexOf(seen, values[i]) < 0) {
					seen->AddBack(values[i]);
				};
			};

			out := String->New[seen->Size()];
			each(i : seen) {
				out[i] := seen->Get(i);
			};

			return out;
		}

		#~
		The index of each value in a class list, as strata codes.
		@param values labels
		@param classes the classes, e.g. from Classes(values) on the training labels
		@return one code per value, -1.0 for a value not in classes; raises LabError for Nil input
		~#
		function : ToIndices(values : String[], classes : String[]) ~ Float[] {
			if(values = Nil | classes = Nil) {
				Refuse("ToIndices: values or classes is Nil");
			};

			out := Float->New[values->Size()];
			each(i : values) {
				out[i] := -1.0;
				if(values[i] <> Nil) {
					each(c : classes) {
						if(classes[c] <> Nil & classes[c]->Equals(values[i])) {
							out[i] := c->As(Float);
						};
					};
				};
			};

			return out;
		}

		#~
		One column of a parsed table's DATA rows, as strings; the header row is
		skipped. A missing cell is Nil.
		@param table a parsed CsvTable whose row 0 is the header
		@param name the column's header
		@return one value per data row; raises LabError when the table is unparsed or the column is missing
		~#
		function : Column(table : CsvTable, name : String) ~ String[] {
			if(table = Nil | <>table->IsParsed()) {
				Refuse("Column: the table is Nil or did not parse");
			};
			if(name = Nil) {
				Refuse("Column: name is Nil");
			};

			col := table->GetRowId(name);
			if(col < 0) {
				Refuse("Column: no column named '{$name}'");
			};

			rows := table->Size();
			if(rows < 1) {
				return String->New[0];
			};

			out := String->New[rows - 1];
			row : CsvRow;
			for(r := 1; r < rows; r += 1;) {
				row := table->Get(r);
				if(row <> Nil) {
					out[r - 1] := row->Get(col);
				};
			};

			return out;
		}

		function : IndexOf(list : Vector<String>, value : String) ~ Int {
			each(i : list) {
				if(list->Get(i)->Equals(value)) {
					return i;
				};
			};

			return -1;
		}

		function : Refuse(message : String) ~ Nil {
			Runtime->Raise(LabError->New("Labels: " + message));
		}
	}

	#~
	What one trial of a sweep produced: predictions on the training and test
	sets, the labels they are scored against, the fit time, and optionally a
	per-epoch training loss.

	Both label arrays travel with the predictions because a trial may have
	resampled its own training set (the class-imbalance sweep), so the runner
	cannot assume one y.
	~#
	class TrialResult {
		@train_pred : Bool[];
		@train_y : Bool[];
		@test_pred : Bool[];
		@test_y : Bool[];
		@fit_ms : Float;
		@loss : Float[];

		#~
		Constructor
		@param train_pred predicted labels on the training set
		@param train_y true labels of the training set
		@param test_pred predicted labels on the test set
		@param test_y true labels of the test set
		@param fit_ms wall-clock milliseconds the fit took
		~#
		New(train_pred : Bool[], train_y : Bool[], test_pred : Bool[], test_y : Bool[], fit_ms : Float) {
			@train_pred := train_pred;
			@train_y := train_y;
			@test_pred := test_pred;
			@test_y := test_y;
			@fit_ms := fit_ms;
		}

		#~
		Constructor with a training-loss curve.
		@param train_pred predicted labels on the training set
		@param train_y true labels of the training set
		@param test_pred predicted labels on the test set
		@param test_y true labels of the test set
		@param fit_ms wall-clock milliseconds the fit took
		@param loss training loss per epoch
		~#
		New(train_pred : Bool[], train_y : Bool[], test_pred : Bool[], test_y : Bool[], fit_ms : Float, loss : Float[]) {
			@train_pred := train_pred;
			@train_y := train_y;
			@test_pred := test_pred;
			@test_y := test_y;
			@fit_ms := fit_ms;
			@loss := loss;
		}

		#~
		Predicted training labels.
		@return one label per training row
		~#
		method : public : GetTrainPredictions() ~ Bool[] {
			return @train_pred;
		}

		#~
		True training labels.
		@return one label per training row
		~#
		method : public : GetTrainLabels() ~ Bool[] {
			return @train_y;
		}

		#~
		Predicted test labels.
		@return one label per test row
		~#
		method : public : GetTestPredictions() ~ Bool[] {
			return @test_pred;
		}

		#~
		True test labels.
		@return one label per test row
		~#
		method : public : GetTestLabels() ~ Bool[] {
			return @test_y;
		}

		#~
		Fit time.
		@return wall-clock milliseconds
		~#
		method : public : GetFitMs() ~ Float {
			return @fit_ms;
		}

		#~
		Training loss per epoch, when the trial recorded one.
		@return the curve, or Nil
		~#
		method : public : GetLoss() ~ Float[] {
			return @loss;
		}
	}

	#~
	One point of a sweep: given a parameter value, build the model, fit it under
	a Stopwatch, predict on the training and test sets, and return the result.

	An interface rather than a function reference, as ScoreModel and ScoreMetric
	are: it crosses the library boundary reliably and reads clearly in a write-up.

```
class ForestTrial implements Trial {
  @split : DataSplit;
  New(split : DataSplit) { @split := split; }
  method : public : Run(value : Float, name : String, seed : Int) ~ TrialResult {
    forest := RandomForestClassifier->New(value->As(Int), 8, 2, seed);
    sw := Stopwatch->New();
    sw->Start();
    forest->Fit(@split->GetTrainX(), @split->GetTrainY());
    ms := sw->Stop();
    return TrialResult->New(forest->PredictClass(@split->GetTrainX()), @split->GetTrainY(),
      forest->PredictClass(@split->GetTestX()), @split->GetTestY(), ms);
  }
}
```
	~#
	interface Trial {
		#~
		Runs one trial.
		@param value the swept parameter's value
		@param name the value's display name (the meaning of a categorical value)
		@param seed the repetition's seed
		@return what the trial produced; Nil is refused by the runner
		~#
		method : virtual : public : Run(value : Float, name : String, seed : Int) ~ TrialResult;
	}

	#~
	A table of results: a title, one row per parameter value (a display name and
	a numeric value), named numeric columns, optional per-cell standard
	deviations, and a footnote of fixed settings. Renders as aligned text,
	Markdown, CSV and JSON, and reads CSV and JSON back.

	Numbers render with a fixed number of decimals per column (4 by default), so
	the output is byte-stable; CSV and JSON carry up to 10 decimals with trailing
	zeros trimmed, so a value survives a round trip to within 1e-10.

```
t := ResultTable->New("Random forest: trees", "n_estimators");
t->AddColumn("test_accuracy");
t->AddColumn("fit_ms", 1);
t->AddRow("10", 10.0, [0.9412, 12.5]);
t->SetFootnote("max_depth=8; seed=42");
t->ToMarkdown()->PrintLine();
t->Save("rf_trees.csv");
```
	~#
	class ResultTable {
		@title : String;
		@parameter : String;
		@footnote : String;
		@columns : Vector<String>;
		@precision : Vector<IntRef>;
		@row_names : Vector<String>;
		@row_values : Vector<FloatRef>;
		@cells : Vector<FloatArrayRef>;
		@stds : Vector<FloatArrayRef>;
		@has_stds : Bool;

		#~
		Constructor
		@param title shown above the table
		@param parameter the swept parameter's name, the first column's heading
		~#
		New(title : String, parameter : String) {
			@title := (title = Nil) ? "" : title;
			@parameter := (parameter = Nil) ? "" : parameter;
			@footnote := "";
			@columns := Vector->New()<String>;
			@precision := Vector->New()<IntRef>;
			@row_names := Vector->New()<String>;
			@row_values := Vector->New()<FloatRef>;
			@cells := Vector->New()<FloatArrayRef>;
			@stds := Vector->New()<FloatArrayRef>;
			@has_stds := false;
		}

		#~
		Adds a numeric column rendered with 4 decimals. Columns must be added
		before rows.
		@param name column heading
		~#
		method : public : AddColumn(name : String) ~ Nil {
			AddColumn(name, 4);
		}

		#~
		Adds a numeric column.
		@param name column heading
		@param precision decimals when rendered as text or Markdown
		~#
		method : public : AddColumn(name : String, precision : Int) ~ Nil {
			if(name = Nil | name->Size() = 0) {
				Refuse("a column needs a name");
			};
			if(@row_names->Size() > 0) {
				Refuse("add every column before the first row");
			};
			if(ColumnIndex(name) >= 0) {
				Refuse("column '{$name}' is already in the table");
			};

			@columns->AddBack(name);
			@precision->AddBack(IntRef->New(precision < 0 ? 0 : precision));
		}

		#~
		Adds a row without deviations.
		@param name the parameter value's display name
		@param value the parameter's numeric value
		@param cells one value per column
		~#
		method : public : AddRow(name : String, value : Float, cells : Float[]) ~ Nil {
			AddRow(name, value, cells, Nil->As(Float[]));
		}

		#~
		Adds a row with a standard deviation per cell, from repeated runs.
		@param name the parameter value's display name
		@param value the parameter's numeric value
		@param cells one mean per column
		@param stds one standard deviation per column, or Nil for none
		~#
		method : public : AddRow(name : String, value : Float, cells : Float[], stds : Float[]) ~ Nil {
			cols := @columns->Size();
			if(cols = 0) {
				Refuse("add columns before rows");
			};
			if(cells = Nil | cells->Size() <> cols) {
				Refuse("row '{$name}' needs {$cols} cells");
			};
			if(stds <> Nil & stds->Size() <> cols) {
				Refuse("row '{$name}' needs {$cols} deviations");
			};

			copy := Float->New[cols];
			spread := Float->New[cols];
			each(c : cols) {
				copy[c] := cells[c];
				if(stds <> Nil) {
					spread[c] := stds[c];
				};
			};

			@row_names->AddBack((name = Nil) ? FormatNumber(value) : name);
			@row_values->AddBack(FloatRef->New(value));
			@cells->AddBack(FloatArrayRef->New(copy));
			@stds->AddBack(FloatArrayRef->New(spread));
			if(stds <> Nil) {
				@has_stds := true;
			};
		}

		#~
		Sets the footnote of fixed settings printed under the table.
		@param text the footnote
		~#
		method : public : SetFootnote(text : String) ~ Nil {
			@footnote := (text = Nil) ? "" : text;
		}

		#~
		The title.
		@return title text
		~#
		method : public : GetTitle() ~ String {
			return @title;
		}

		#~
		The swept parameter's name.
		@return the first column's heading
		~#
		method : public : GetParameter() ~ String {
			return @parameter;
		}

		#~
		The footnote.
		@return footnote text, empty when unset
		~#
		method : public : GetFootnote() ~ String {
			return @footnote;
		}

		#~
		Column headings, in order.
		@return the numeric columns' names
		~#
		method : public : GetColumnNames() ~ String[] {
			out := String->New[@columns->Size()];
			each(i : @columns) {
				out[i] := @columns->Get(i);
			};

			return out;
		}

		#~
		Rows in the table.
		@return row count
		~#
		method : public : Size() ~ Int {
			return @row_names->Size();
		}

		#~
		A row's display name.
		@param row row index
		@return the name
		~#
		method : public : GetRowName(row : Int) ~ String {
			CheckRow(row);
			return @row_names->Get(row);
		}

		#~
		A row's numeric parameter value.
		@param row row index
		@return the value
		~#
		method : public : GetRowValue(row : Int) ~ Float {
			CheckRow(row);
			return @row_values->Get(row)->Get();
		}

		#~
		A cell.
		@param row row index
		@param col column index
		@return the value (the mean, for repeated runs)
		~#
		method : public : Get(row : Int, col : Int) ~ Float {
			CheckRow(row);
			CheckCol(col);
			return @cells->Get(row)->Get()[col];
		}

		#~
		A cell's standard deviation.
		@param row row index
		@param col column index
		@return the deviation, 0.0 when the table holds none
		~#
		method : public : GetStd(row : Int, col : Int) ~ Float {
			CheckRow(row);
			CheckCol(col);
			return @stds->Get(row)->Get()[col];
		}

		#~
		Whether any row carries standard deviations.
		@return true after an AddRow with deviations
		~#
		method : public : HasStds() ~ Bool {
			return @has_stds;
		}

		#~
		The index of a column by name.
		@param name column heading
		@return the index, or -1
		~#
		method : public : ColumnIndex(name : String) ~ Int {
			each(i : @columns) {
				if(@columns->Get(i)->Equals(name)) {
					return i;
				};
			};

			return -1;
		}

		#~
		One column's values, in row order.
		@param name column heading
		@return one value per row; raises LabError for an unknown column
		~#
		method : public : GetColumn(name : String) ~ Float[] {
			c := ColumnIndex(name);
			if(c < 0) {
				Refuse("no column named '{$name}'");
			};

			out := Float->New[Size()];
			each(r : out) {
				out[r] := @cells->Get(r)->Get()[c];
			};

			return out;
		}

		#~
		One column's standard deviations, in row order.
		@param name column heading
		@return one deviation per row (zeros when the table holds none); raises LabError for an unknown column
		~#
		method : public : GetColumnStds(name : String) ~ Float[] {
			c := ColumnIndex(name);
			if(c < 0) {
				Refuse("no column named '{$name}'");
			};

			out := Float->New[Size()];
			each(r : out) {
				out[r] := @stds->Get(r)->Get()[c];
			};

			return out;
		}

		#~
		The parameter values, in row order: the x axis of a chart.
		@return one value per row
		~#
		method : public : GetRowValues() ~ Float[] {
			out := Float->New[Size()];
			each(r : out) {
				out[r] := @row_values->Get(r)->Get();
			};

			return out;
		}

		#~
		The row names, in row order.
		@return one name per row
		~#
		method : public : GetRowNames() ~ String[] {
			out := String->New[Size()];
			each(r : out) {
				out[r] := @row_names->Get(r);
			};

			return out;
		}

		#~
		An aligned plain-text table: the title, a header, one line per row,
		the footnote. Deviations render as "mean +/- std".
		@return the text, lines ending in LF
		~#
		method : public : ToText() ~ String {
			cols := @columns->Size();
			rows := Size();

			# render every cell first, then size the columns to the widest
			header := String->New[cols + 1];
			header[0] := @parameter;
			each(c : cols) {
				header[c + 1] := @columns->Get(c);
			};

			texts := String->New[rows, cols + 1];
			each(r : rows) {
				texts[r, 0] := @row_names->Get(r);
				each(c : cols) {
					texts[r, c + 1] := FormatCell(r, c, "+/-");
				};
			};

			width := cols + 1;
			widths := Int->New[width];
			each(c : width) {
				widths[c] := header[c]->Size();
				each(r : rows) {
					if(texts[r, c]->Size() > widths[c]) {
						widths[c] := texts[r, c]->Size();
					};
				};
			};

			out := "";
			if(@title->Size() > 0) {
				out += @title;
				out += "\n";
				out += Repeat('=', @title->Size());
				out += "\n";
			};

			each(c : width) {
				if(c > 0) {
					out += "  ";
				};
				out += header[c]->PadTo(widths[c], ' ', c > 0);
			};
			out += "\n";

			each(c : width) {
				if(c > 0) {
					out += "  ";
				};
				out += Repeat('-', widths[c]);
			};
			out += "\n";

			each(r : rows) {
				each(c : width) {
					if(c > 0) {
						out += "  ";
					};
					out += texts[r, c]->PadTo(widths[c], ' ', c > 0);
				};
				out += "\n";
			};

			if(@footnote->Size() > 0) {
				out += "\n";
				out += @footnote;
				out += "\n";
			};

			return out;
		}

		#~
		A GitHub-flavoured Markdown table under a "###" title, the footnote in
		italics. Deviations render as "mean ± std"; a pipe in a name is escaped.
		@return the Markdown, lines ending in LF
		~#
		method : public : ToMarkdown() ~ String {
			cols := @columns->Size();
			out := "";
			if(@title->Size() > 0) {
				out += "### ";
				out += EscapeMarkdown(@title);
				out += "\n\n";
			};

			out += "| ";
			out += EscapeMarkdown(@parameter);
			each(c : cols) {
				out += " | ";
				out += EscapeMarkdown(@columns->Get(c));
			};
			out += " |\n|---|";
			each(c : cols) {
				out += "---:|";
			};
			out += "\n";

			each(r : Size()) {
				out += "| ";
				out += EscapeMarkdown(@row_names->Get(r));
				each(c : cols) {
					out += " | ";
					out += FormatCell(r, c, "±");
				};
				out += " |\n";
			};

			if(@footnote->Size() > 0) {
				out += "\n_";
				out += EscapeMarkdown(@footnote);
				out += "_\n";
			};

			return out;
		}

		#~
		RFC 4180 CSV: a header of the parameter name, "<parameter>_value", the
		columns and, when the table holds deviations, "<column>_std" for each;
		then one record per row. Fields are quoted only when they must be. The
		title and footnote are not written: a CSV is data, the Markdown and JSON
		forms carry the prose.
		@return the CSV, records ending in LF
		~#
		method : public : ToCsv() ~ String {
			cols := @columns->Size();
			width := 2 + cols + (@has_stds ? cols : 0);
			fields := String->New[width];
			fields[0] := @parameter;
			fields[1] := @parameter + "_value";
			each(c : cols) {
				fields[2 + c] := @columns->Get(c);
				if(@has_stds) {
					fields[2 + cols + c] := @columns->Get(c) + "_std";
				};
			};

			out := CsvTable->FormatRow(fields);
			out += "\n";

			each(r : Size()) {
				fields := String->New[width];
				fields[0] := @row_names->Get(r);
				fields[1] := FormatNumber(@row_values->Get(r)->Get());
				each(c : cols) {
					fields[2 + c] := FormatNumber(@cells->Get(r)->Get()[c]);
					if(@has_stds) {
						fields[2 + cols + c] := FormatNumber(@stds->Get(r)->Get()[c]);
					};
				};
				out += CsvTable->FormatRow(fields);
				out += "\n";
			};

			return out;
		}

		#~
		JSON, built with Data.JSON: {"title","parameter","footnote","columns":[],
		"precision":[],"rows":[{"name","value","cells":{column: value},
		"stds":{column: deviation}}]}; "stds" is present only when the table holds
		deviations.
		@return the JSON text
		~#
		method : public : ToJson() ~ String {
			root := JsonElement->New(JsonElement->JsonType->OBJECT);
			root->Insert("title", @title);
			root->Insert("parameter", @parameter);
			root->Insert("footnote", @footnote);

			columns := JsonElement->New(JsonElement->JsonType->ARRAY);
			precision := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(c : @columns) {
				columns->Add(@columns->Get(c));
				precision->Add(@precision->Get(c)->Get());
			};
			root->Insert("columns", columns);
			root->Insert("precision", precision);

			rows := JsonElement->New(JsonElement->JsonType->ARRAY);
			row : JsonElement;
			cells : JsonElement;
			stds : JsonElement;
			each(r : Size()) {
				row := JsonElement->New(JsonElement->JsonType->OBJECT);
				row->Insert("name", @row_names->Get(r));
				row->Insert("value", Number(@row_values->Get(r)->Get()));
				cells := JsonElement->New(JsonElement->JsonType->OBJECT);
				each(c : @columns) {
					cells->Insert(@columns->Get(c), Number(@cells->Get(r)->Get()[c]));
				};
				row->Insert("cells", cells);
				if(@has_stds) {
					stds := JsonElement->New(JsonElement->JsonType->OBJECT);
					each(c : @columns) {
						stds->Insert(@columns->Get(c), Number(@stds->Get(r)->Get()[c]));
					};
					row->Insert("stds", stds);
				};
				rows->Add(row);
			};
			root->Insert("rows", rows);

			return root->ToString();
		}

		#~
		Reads a table written by ToCsv. The title and footnote come back empty.
		@param text CSV text
		@return the table; raises LabError when the text is not a ToCsv table
		~#
		function : FromCsv(text : String) ~ ResultTable {
			if(text = Nil) {
				Refuse("FromCsv: text is Nil");
			};

			table := CsvTable->New(text);
			if(<>table->IsParsed() | table->Size() < 1) {
				Refuse("FromCsv: the text did not parse as CSV");
			};

			header := table->GetHeaders();
			width := header->Size();
			if(width < 2 | <>header->Get(1)->Equals(header->Get(0) + "_value")) {
				Refuse("FromCsv: the header is not <parameter>,<parameter>_value,...");
			};

			result := ResultTable->New("", header->Get(0));
			# metric columns are those before the first "_std" column
			metrics := 0;
			for(c := 2; c < width; c += 1;) {
				if(<>header->Get(c)->EndsWith("_std")) {
					metrics += 1;
				};
			};
			has_stds := width = 2 + 2 * metrics;
			if(<>has_stds & width <> 2 + metrics) {
				Refuse("FromCsv: deviation columns do not match the value columns");
			};
			each(c : metrics) {
				result->AddColumn(header->Get(2 + c));
			};

			row : CsvRow;
			cells : Float[];
			stds : Float[];
			for(r := 1; r < table->Size(); r += 1;) {
				row := table->Get(r);
				if(row <> Nil & row->Size() = width) {
					cells := Float->New[metrics];
					each(c : metrics) {
						cells[c] := row->Get(2 + c)->ToFloat();
					};
					if(has_stds) {
						stds := Float->New[metrics];
						each(c : metrics) {
							stds[c] := row->Get(2 + metrics + c)->ToFloat();
						};
						result->AddRow(row->Get(0), row->Get(1)->ToFloat(), cells, stds);
					}
					else {
						result->AddRow(row->Get(0), row->Get(1)->ToFloat(), cells);
					};
				};
			};

			return result;
		}

		#~
		Reads a table written by ToJson.
		@param text JSON text
		@return the table; raises LabError when the text is not a ToJson table
		~#
		function : FromJson(text : String) ~ ResultTable {
			if(text = Nil) {
				Refuse("FromJson: text is Nil");
			};

			parser := JsonParser->New(text);
			if(<>parser->Parse()) {
				Refuse("FromJson: the text did not parse as JSON");
			};

			root := parser->GetRoot();
			if(root = Nil | <>root->Has("parameter") | <>root->Has("columns") | <>root->Has("rows")) {
				Refuse("FromJson: not a ResultTable document");
			};

			result := ResultTable->New(TextOf(root, "title"), TextOf(root, "parameter"));
			result->SetFootnote(TextOf(root, "footnote"));

			columns := root->Get("columns");
			precision := root->Get("precision");
			each(c : columns->Size()) {
				if(precision <> Nil & precision->Has(c)) {
					result->AddColumn(columns->Get(c)->GetString(), precision->Get(c)->GetInt());
				}
				else {
					result->AddColumn(columns->Get(c)->GetString());
				};
			};

			rows := root->Get("rows");
			row : JsonElement;
			cells : JsonElement;
			stds : JsonElement;
			values : Float[];
			spread : Float[];
			name : String;
			each(r : rows->Size()) {
				row := rows->Get(r);
				cells := row->Get("cells");
				values := Float->New[columns->Size()];
				each(c : columns->Size()) {
					name := columns->Get(c)->GetString();
					if(cells <> Nil & cells->Has(name)) {
						values[c] := cells->Get(name)->GetFloat();
					};
				};
				if(row->Has("stds")) {
					stds := row->Get("stds");
					spread := Float->New[columns->Size()];
					each(c : columns->Size()) {
						name := columns->Get(c)->GetString();
						if(stds->Has(name)) {
							spread[c] := stds->Get(name)->GetFloat();
						};
					};
					result->AddRow(TextOf(row, "name"), row->Get("value")->GetFloat(), values, spread);
				}
				else {
					result->AddRow(TextOf(row, "name"), row->Get("value")->GetFloat(), values);
				};
			};

			return result;
		}

		#~
		Writes the table in the form the file extension names: .md Markdown,
		.csv CSV, .json JSON, anything else the aligned text.
		@param path file to write
		@return true when written
		~#
		method : public : Save(path : String) ~ Bool {
			if(path = Nil) {
				return false;
			};

			lower := path->ToLower();
			if(lower->EndsWith(".md")) {
				return System.IO.Filesystem.FileWriter->WriteFile(path, ToMarkdown());
			};
			if(lower->EndsWith(".csv")) {
				return System.IO.Filesystem.FileWriter->WriteFile(path, ToCsv());
			};
			if(lower->EndsWith(".json")) {
				return System.IO.Filesystem.FileWriter->WriteFile(path, ToJson());
			};

			return System.IO.Filesystem.FileWriter->WriteFile(path, ToText());
		}

		#~
		A line chart of named columns against the parameter: x is the parameter
		value (or the row names as categories when a row name is not its
		number), one series per metric, error bars from the deviations when the
		table holds them.
		@param metrics column names to draw; an empty array draws every column
		@return the chart; raises LabError for an unknown column or an empty table
		~#
		method : public : ToChart(metrics : String[]) ~ Chart {
			return ToChart(metrics, false);
		}

		#~
		A line chart of named columns, optionally on a log x axis (for C, gamma
		or a learning rate).
		@param metrics column names to draw; an empty array draws every column
		@param log_x true for a base-10 log x axis
		@return the chart; raises LabError for an unknown column or an empty table
		~#
		method : public : ToChart(metrics : String[], log_x : Bool) ~ Chart {
			if(Size() = 0) {
				Refuse("ToChart: the table has no rows");
			};

			names := metrics;
			if(names = Nil | names->Size() = 0) {
				names := GetColumnNames();
			};
			each(i : names) {
				if(ColumnIndex(names[i]) < 0) {
					n := names[i];
					Refuse("ToChart: no column named '{$n}'");
				};
			};

			y_label := "";
			each(i : names) {
				if(i > 0) {
					y_label += ", ";
				};
				y_label += names[i];
			};

			chart := Chart->New(@title, @parameter, y_label);

			# categorical when any row's name is not just its number
			categorical := false;
			xs := GetRowValues();
			each(r : xs) {
				if(<>@row_names->Get(r)->Equals(FormatNumber(xs[r]))) {
					categorical := true;
				};
			};
			if(categorical) {
				chart->SetCategories(GetRowNames());
				each(r : xs) {
					xs[r] := r->As(Float);
				};
			}
			else if(log_x) {
				chart->SetLogX(true);
			};

			each(i : names) {
				if(@has_stds) {
					chart->AddLine(names[i], xs, GetColumn(names[i]), GetColumnStds(names[i]));
				}
				else {
					chart->AddLine(names[i], xs, GetColumn(names[i]));
				};
			};

			return chart;
		}

		#~
		A number for CSV and JSON: up to 10 decimals, trailing zeros and a
		trailing point trimmed, never "-0".
		@param value the number
		@return its text
		~#
		function : FormatNumber(value : Float) ~ String {
			text := Float->ToString(value, 10);
			if(text->Has('.')) {
				last := text->Size() - 1;
				while(last > 0 & text->Get(last) = '0') {
					last -= 1;
				};
				if(text->Get(last) = '.') {
					last -= 1;
				};
				text := text->SubString(0, last + 1);
			};
			if(text->Equals("-0")) {
				return "0";
			};

			return text;
		}

		method : FormatCell(r : Int, c : Int, plus_minus : String) ~ String {
			p := @precision->Get(c)->Get();
			text := Float->ToString(@cells->Get(r)->Get()[c], p);
			if(@has_stds) {
				text += " ";
				text += plus_minus;
				text += " ";
				text += Float->ToString(@stds->Get(r)->Get()[c], p);
			};

			return text;
		}

		function : Number(value : Float) ~ JsonElement {
			return JsonElement->New(JsonElement->JsonType->NUMBER, FormatNumber(value));
		}

		function : TextOf(elem : JsonElement, name : String) ~ String {
			if(elem = Nil | <>elem->Has(name)) {
				return "";
			};

			value := elem->Get(name);
			if(value = Nil | value->IsNull()) {
				return "";
			};

			return value->GetString();
		}

		function : EscapeMarkdown(text : String) ~ String {
			if(text = Nil) {
				return "";
			};

			return text->ReplaceAll("|", "\\|");
		}

		function : Repeat(ch : Char, count : Int) ~ String {
			out := String->New();
			each(i : count) {
				out->Append(ch);
			};

			return out;
		}

		method : CheckRow(row : Int) ~ Nil {
			if(row < 0 | row >= Size()) {
				Refuse("row {$row} is outside the table");
			};
		}

		method : CheckCol(col : Int) ~ Nil {
			if(col < 0 | col >= @columns->Size()) {
				Refuse("column {$col} is outside the table");
			};
		}

		function : Refuse(message : String) ~ Nil {
			Runtime->Raise(LabError->New("ResultTable: " + message));
		}
	}

	#~
	A sweep over one named parameter: for every value (and every seed, when
	repeats are asked for) it runs the Trial, scores the predictions, and
	collects a ResultTable with train_accuracy, test_accuracy, precision,
	recall, f1, fpr, false_negatives and fit_ms per value -- mean and sample
	standard deviation over the seeds when there is more than one.

	Test-set metrics come from the test predictions; train_accuracy is the only
	training-set number, there for the overfitting curve. The confusion counts
	come from the trial's Bool predictions and the rates from ThresholdResult,
	every ratio guarded (a value that predicts nothing positive has no precision
	and reports 0.0).

```
exp := Experiment->New("Random forest: trees", "n_estimators");
exp->SetValues([10.0, 50.0, 100.0, 200.0, 500.0]);
exp->SetSeeds([1, 2, 3]);
exp->AddSetting("max_depth", "8");
table := exp->Run(ForestTrial->New(split));
table->ToMarkdown()->PrintLine();
```
	~#
	class Experiment {
		@title : String;
		@parameter : String;
		@values : Float[];
		@names : String[];
		@seeds : Int[];
		@settings : Vector<String>;

		#~
		Constructor
		@param title the table's title
		@param parameter the swept parameter's name
		~#
		New(title : String, parameter : String) {
			@title := title;
			@parameter := parameter;
			@settings := Vector->New()<String>;
			@seeds := Int->New[1];
		}

		#~
		The values to sweep, named by their number.
		@param values one per trial
		~#
		method : public : SetValues(values : Float[]) ~ Nil {
			SetValues(values, Nil->As(String[]));
		}

		#~
		The values to sweep with display names, for a categorical parameter such
		as a kernel (values 0, 1, 2; names "linear", "rbf", "poly").
		@param values one per trial
		@param names one per value, or Nil to name each by its number
		~#
		method : public : SetValues(values : Float[], names : String[]) ~ Nil {
			if(values = Nil | values->Size() = 0) {
				Refuse("at least one value is needed");
			};
			if(names <> Nil & names->Size() <> values->Size()) {
				Refuse("names and values differ in length");
			};

			@values := values;
			@names := String->New[values->Size()];
			each(i : values) {
				if(names <> Nil & names[i] <> Nil) {
					@names[i] := names[i];
				}
				else {
					@names[i] := ResultTable->FormatNumber(values[i]);
				};
			};
		}

		#~
		Seeds for repeated runs; each value is run once per seed and the table
		reports the mean and sample standard deviation. The default is one run
		with seed 0.
		@param seeds one per repetition
		~#
		method : public : SetSeeds(seeds : Int[]) ~ Nil {
			if(seeds = Nil | seeds->Size() = 0) {
				Refuse("at least one seed is needed");
			};

			@seeds := seeds;
		}

		#~
		Records a fixed setting for the footnote, e.g. ("max_depth", "8").
		@param name the setting
		@param value its value
		~#
		method : public : AddSetting(name : String, value : String) ~ Nil {
			@settings->AddBack(name + "=" + value);
		}

		#~
		Runs the sweep.
		@param trial builds, fits and predicts for one value
		@return the table, one row per value; raises LabError when no values are set, the trial returns Nil, or its arrays disagree in length
		~#
		method : public : Run(trial : Trial) ~ ResultTable {
			if(trial = Nil) {
				Refuse("trial is Nil");
			};
			if(@values = Nil) {
				Refuse("call SetValues before Run");
			};

			table := ResultTable->New(@title, @parameter);
			table->AddColumn("train_accuracy");
			table->AddColumn("test_accuracy");
			table->AddColumn("precision");
			table->AddColumn("recall");
			table->AddColumn("f1");
			table->AddColumn("fpr");
			table->AddColumn("false_negatives", 0);
			table->AddColumn("fit_ms", 1);

			metrics := 8;
			reps := @seeds->Size();
			sums := Float->New[metrics];
			sq := Float->New[metrics];
			means := Float->New[metrics];
			stds := Float->New[metrics];
			m : Float[];
			result : TrialResult;
			value : Float;
			name : String;
			seed : Int;

			each(i : @values) {
				value := @values[i];
				name := @names[i];
				each(k : metrics) {
					sums[k] := 0.0;
					sq[k] := 0.0;
				};

				each(s : reps) {
					seed := @seeds[s];
					result := trial->Run(value, name, seed);
					if(result = Nil) {
						Refuse("the trial returned Nil for {$name} (seed {$seed})");
					};
					m := Measure(result, name, seed);
					each(k : metrics) {
						sums[k] += m[k];
						sq[k] += m[k] * m[k];
					};
				};

				means := Float->New[metrics];
				stds := Float->New[metrics];
				each(k : metrics) {
					means[k] := sums[k] / reps->As(Float);
					if(reps > 1) {
						# sample variance via sums, clamped: rounding can leave it a hair below zero
						variance := (sq[k] - reps->As(Float) * means[k] * means[k]) / (reps - 1)->As(Float);
						if(variance < 0.0) {
							variance := 0.0;
						};
						stds[k] := Float->Sqrt(variance);
					};
				};

				if(reps > 1) {
					table->AddRow(name, value, means, stds);
				}
				else {
					table->AddRow(name, value, means);
				};
			};

			table->SetFootnote(Footnote());

			return table;
		}

		# [train_accuracy, test_accuracy, precision, recall, f1, fpr, false_negatives, fit_ms]
		method : Measure(result : TrialResult, name : String, seed : Int) ~ Float[] {
			train := Counts(result->GetTrainPredictions(), result->GetTrainLabels(), "training", name, seed);
			test := Counts(result->GetTestPredictions(), result->GetTestLabels(), "test", name, seed);

			m := Float->New[8];
			m[0] := train->GetAccuracy();
			m[1] := test->GetAccuracy();
			m[2] := test->GetPrecision();
			m[3] := test->GetRecall();
			m[4] := 0.0;
			if(m[2] + m[3] > 0.0) {
				m[4] := 2.0 * m[2] * m[3] / (m[2] + m[3]);
			};
			m[5] := test->GetFpr();
			m[6] := test->GetFalseNegatives()->As(Float);
			m[7] := result->GetFitMs();

			return m;
		}

		# The four confusion cells, handed to ThresholdResult for the rates. One
		# place to change when a shared ConfusionMatrix class exists.
		function : Counts(pred : Bool[], actual : Bool[], which : String, name : String, seed : Int) ~ ThresholdResult {
			if(pred = Nil | actual = Nil) {
				Refuse("the {$which} predictions or labels are Nil for {$name} (seed {$seed})");
			};
			if(pred->Size() <> actual->Size() | pred->Size() = 0) {
				ps := pred->Size();
				as := actual->Size();
				Refuse("{$ps} {$which} predictions against {$as} labels for {$name} (seed {$seed})");
			};

			tp := 0;
			fp := 0;
			fn := 0;
			tn := 0;
			each(i : pred) {
				if(pred[i]) {
					if(actual[i]) {
						tp += 1;
					}
					else {
						fp += 1;
					};
				}
				else {
					if(actual[i]) {
						fn += 1;
					}
					else {
						tn += 1;
					};
				};
			};

			return ThresholdResult->New(0.5, tp, fp, fn, tn);
		}

		method : Footnote() ~ String {
			out := "";
			each(i : @settings) {
				if(i > 0) {
					out += "; ";
				};
				out += @settings->Get(i);
			};

			if(@seeds->Size() > 1) {
				if(out->Size() > 0) {
					out += "; ";
				};
				n := @seeds->Size();
				out += "repeats={$n} seeds (";
				each(i : @seeds) {
					if(i > 0) {
						out += ", ";
					};
					out += @seeds[i]->ToString();
				};
				out += "), cells are mean and sample standard deviation";
			};

			return out;
		}

		function : Refuse(message : String) ~ Nil {
			Runtime->Raise(LabError->New("Experiment: " + message));
		}
	}

	#~
	One series of a Chart: a name, x and y values, optional symmetric error
	bars, drawn as a line with markers or as bars.
	~#
	class ChartSeries {
		@name : String;
		@xs : Float[];
		@ys : Float[];
		@errs : Float[];
		@bars : Bool;

		#~
		Constructor
		@param name legend entry
		@param xs x values (category indexes for bars)
		@param ys y values
		@param errs symmetric error per point, or Nil
		@param bars true to draw bars, false for a line
		~#
		New(name : String, xs : Float[], ys : Float[], errs : Float[], bars : Bool) {
			@name := name;
			@xs := xs;
			@ys := ys;
			@errs := errs;
			@bars := bars;
		}

		#~
		Legend entry.
		@return the name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		x values.
		@return one per point
		~#
		method : public : GetXs() ~ Float[] {
			return @xs;
		}

		#~
		y values.
		@return one per point
		~#
		method : public : GetYs() ~ Float[] {
			return @ys;
		}

		#~
		Error bars.
		@return one per point, or Nil
		~#
		method : public : GetErrors() ~ Float[] {
			return @errs;
		}

		#~
		Whether the series draws as bars.
		@return true for bars
		~#
		method : public : IsBars() ~ Bool {
			return @bars;
		}

		#~
		Points in the series.
		@return point count
		~#
		method : public : Size() ~ Int {
			return @ys->Size();
		}
	}

	#~
	A chart written as standalone SVG 1.1: a line chart (x numeric, linear or
	log, or categorical) with markers and error bars, or a grouped bar chart,
	with a title, axis titles, a 1-2-5 tick grid and a legend. No script, no
	external font, no dependency: it opens in a browser, pastes into Word, and
	converts with any SVG tool. Coordinates are written with one decimal, so
	the same data gives the same bytes on every platform.

```
c := Chart->New("Recall vs C", "C", "recall");
c->SetLogX(true);
c->AddLine("rbf", cs, recall_rbf, recall_rbf_std);
c->AddLine("linear", cs, recall_lin);
c->Save("recall_vs_c.svg");
```
	~#
	class Chart {
		@title : String;
		@x_label : String;
		@y_label : String;
		@width : Int;
		@height : Int;
		@log_x : Bool;
		@categories : String[];
		@y_fixed : Bool;
		@y_min : Float;
		@y_max : Float;
		@series : Vector<ChartSeries>;

		#~
		Constructor; the default size is 800 x 480.
		@param title title above the plot
		@param x_label x-axis title
		@param y_label y-axis title
		~#
		New(title : String, x_label : String, y_label : String) {
			@title := (title = Nil) ? "" : title;
			@x_label := (x_label = Nil) ? "" : x_label;
			@y_label := (y_label = Nil) ? "" : y_label;
			@width := 800;
			@height := 480;
			@log_x := false;
			@y_fixed := false;
			@series := Vector->New()<ChartSeries>;
		}

		#~
		Sets the image size in pixels.
		@param width width, at least 200
		@param height height, at least 150
		~#
		method : public : SetSize(width : Int, height : Int) ~ Nil {
			if(width < 200 | height < 150) {
				Refuse("the size must be at least 200 x 150");
			};

			@width := width;
			@height := height;
		}

		#~
		Draws x on a base-10 log scale, for C, gamma or a learning rate. Every
		x must then be positive.
		@param on true for a log axis
		~#
		method : public : SetLogX(on : Bool) ~ Nil {
			@log_x := on;
		}

		#~
		Makes x categorical: ticks are these names at positions 0, 1, 2, ...,
		and bar series are grouped by them.
		@param names one per category
		~#
		method : public : SetCategories(names : String[]) ~ Nil {
			if(names = Nil | names->Size() = 0) {
				Refuse("at least one category is needed");
			};

			@categories := names;
		}

		#~
		Fixes the y range instead of deriving it from the data.
		@param min bottom of the axis
		@param max top of the axis, above min
		~#
		method : public : SetYRange(min : Float, max : Float) ~ Nil {
			if(max <= min) {
				Refuse("the y range must have max above min");
			};

			@y_fixed := true;
			@y_min := min;
			@y_max := max;
		}

		#~
		Adds a line with markers.
		@param name legend entry
		@param xs x values (category indexes when categories are set)
		@param ys y values, one per x
		~#
		method : public : AddLine(name : String, xs : Float[], ys : Float[]) ~ Nil {
			AddLine(name, xs, ys, Nil->As(Float[]));
		}

		#~
		Adds a line with markers and symmetric error bars.
		@param name legend entry
		@param xs x values
		@param ys y values, one per x
		@param errs half-height of each error bar, one per point; 0 draws none
		~#
		method : public : AddLine(name : String, xs : Float[], ys : Float[], errs : Float[]) ~ Nil {
			if(xs = Nil | ys = Nil | xs->Size() <> ys->Size() | ys->Size() = 0) {
				Refuse("a line needs matching, non-empty xs and ys");
			};
			if(errs <> Nil & errs->Size() <> ys->Size()) {
				Refuse("errors must match the points");
			};

			@series->AddBack(ChartSeries->New((name = Nil) ? "" : name, xs, ys, errs, false));
		}

		#~
		Adds a bar series over the categories: one bar per category, grouped
		with the other bar series. SetCategories must have been called.
		@param name legend entry
		@param ys one height per category
		~#
		method : public : AddBars(name : String, ys : Float[]) ~ Nil {
			AddBars(name, ys, Nil->As(Float[]));
		}

		#~
		Adds a bar series with error bars.
		@param name legend entry
		@param ys one height per category
		@param errs half-height of each error bar, one per category
		~#
		method : public : AddBars(name : String, ys : Float[], errs : Float[]) ~ Nil {
			if(@categories = Nil) {
				Refuse("call SetCategories before AddBars");
			};
			if(ys = Nil | ys->Size() <> @categories->Size()) {
				Refuse("bars need one value per category");
			};
			if(errs <> Nil & errs->Size() <> ys->Size()) {
				Refuse("errors must match the categories");
			};

			xs := Float->New[ys->Size()];
			each(i : xs) {
				xs[i] := i->As(Float);
			};
			@series->AddBack(ChartSeries->New((name = Nil) ? "" : name, xs, ys, errs, true));
		}

		#~
		A training-loss chart: one line per series (one per learning rate, say),
		x is the epoch starting at 1.
		@param title title above the plot
		@param names one legend entry per row of losses
		@param losses rows are series, columns are epochs
		@return the chart
		~#
		function : LossCurve(title : String, names : String[], losses : Float[,]) ~ Chart {
			if(names = Nil | losses = Nil) {
				Refuse("LossCurve needs names and losses");
			};

			dims := losses->Size();
			if(dims[0] <> names->Size() | dims[1] < 1) {
				Refuse("LossCurve needs one name per row of losses and at least one epoch");
			};

			chart := Chart->New(title, "epoch", "training loss");
			xs := Float->New[dims[1]];
			each(e : xs) {
				xs[e] := (e + 1)->As(Float);
			};
			ys : Float[];
			each(s : dims[0]) {
				ys := Float->New[dims[1]];
				each(e : ys) {
					ys[e] := losses[s, e];
				};
				chart->AddLine(names[s], xs, ys);
			};

			return chart;
		}

		#~
		Series added so far.
		@return series count
		~#
		method : public : Size() ~ Int {
			return @series->Size();
		}

		#~
		Writes the SVG to a file.
		@param path file to write
		@return true when written
		~#
		method : public : Save(path : String) ~ Bool {
			if(path = Nil) {
				return false;
			};

			return System.IO.Filesystem.FileWriter->WriteFile(path, ToSvg());
		}

		#~
		Renders the chart.
		@return SVG 1.1 text; raises LabError when there is nothing to draw or a log axis meets a non-positive x
		~#
		method : public : ToSvg() ~ String {
			if(@series->Size() = 0) {
				Refuse("nothing to draw: add a line or bars first");
			};

			# [x_lo, x_hi, y_lo, y_hi, y_step], x on the log10 scale when @log_x
			r := Ranges();

			out := Header();
			out += Grid(r);
			out += XTicks(r);
			out += Axes();
			out += AllSeries(r);
			out += Legend();
			out += "</svg>\n";

			return out;
		}

		# plot area in pixels
		method : Left() ~ Float { return 72.0; }
		method : Right() ~ Float { return (@width - 24)->As(Float); }
		method : Top() ~ Float { return 48.0; }
		method : Bottom() ~ Float { return (@height - 64)->As(Float); }

		# data to pixels; x is already on the log scale when @log_x
		method : X(v : Float, r : Float[]) ~ Float {
			return Left() + (v - r[0]) / (r[1] - r[0]) * (Right() - Left());
		}

		method : Y(v : Float, r : Float[]) ~ Float {
			return Bottom() - (v - r[2]) / (r[3] - r[2]) * (Bottom() - Top());
		}

		method : LogX(v : Float) ~ Float {
			if(@log_x) {
				if(v <= 0.0) {
					Refuse("a log x axis needs positive x values, got {$v}");
				};
				return Float->Log10(v);
			};

			return v;
		}

		method : Ranges() ~ Float[] {
			r := Float->New[5];
			s : ChartSeries;
			xs : Float[];
			ys : Float[];
			errs : Float[];
			v : Float;
			first := true;

			# x
			if(@categories <> Nil) {
				r[0] := -0.5;
				r[1] := @categories->Size()->As(Float) - 0.5;
			}
			else {
				each(i : @series) {
					s := @series->Get(i);
					xs := s->GetXs();
					each(p : xs) {
						v := LogX(xs[p]);
						if(first | v < r[0]) {
							r[0] := v;
						};
						if(first | v > r[1]) {
							r[1] := v;
						};
						first := false;
					};
				};
				if(r[1] = r[0]) {
					r[0] -= 0.5;
					r[1] += 0.5;
				};
				if(@log_x) {
					r[0] := Float->Floor(r[0]);
					r[1] := Float->Ceil(r[1]);
				}
				else {
					nice := NiceRange(r[0], r[1], 6);
					r[0] := nice[0];
					r[1] := nice[1];
				};
			};

			# y
			if(@y_fixed) {
				r[2] := @y_min;
				r[3] := @y_max;
				r[4] := NiceStep(r[3] - r[2], 5);
				return r;
			};

			first := true;
			each(i : @series) {
				s := @series->Get(i);
				ys := s->GetYs();
				errs := s->GetErrors();
				each(p : ys) {
					v := ys[p];
					if(errs <> Nil) {
						v := ys[p] - errs[p];
					};
					if(first | v < r[2]) {
						r[2] := v;
					};
					v := ys[p];
					if(errs <> Nil) {
						v := ys[p] + errs[p];
					};
					if(first | v > r[3]) {
						r[3] := v;
					};
					first := false;
				};
			};

			if(r[2] >= 0.0 & r[3] <= 1.0) {
				# a rate: the whole unit interval, so charts compare
				r[2] := 0.0;
				r[3] := 1.0;
				r[4] := 0.2;
			}
			else {
				if(r[2] > 0.0) {
					r[2] := 0.0;   # bars and counts start at zero
				};
				if(r[3] = r[2]) {
					r[3] := r[2] + 1.0;
				};
				nice := NiceRange(r[2], r[3], 5);
				r[2] := nice[0];
				r[3] := nice[1];
				r[4] := nice[2];
			};

			return r;
		}

		method : Header() ~ String {
			out := "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
			out += "<svg xmlns=\"http://www.w3.org/2000/svg\" version=\"1.1\" width=\"{$@width}\" height=\"{$@height}\" viewBox=\"0 0 {$@width} {$@height}\" font-family=\"sans-serif\" font-size=\"12\">\n";
			out += "<title>" + Escape(@title) + "</title>\n";
			out += "<rect x=\"0\" y=\"0\" width=\"{$@width}\" height=\"{$@height}\" fill=\"white\"/>\n";
			if(@title->Size() > 0) {
				cx := @width / 2;
				out += "<text x=\"{$cx}\" y=\"26\" text-anchor=\"middle\" font-size=\"16\" font-weight=\"bold\">" + Escape(@title) + "</text>\n";
			};

			return out;
		}

		method : Grid(r : Float[]) ~ String {
			ticks := Ticks(r[2], r[3], r[4]);
			left := Fmt(Left());
			right := Fmt(Right());
			out := "<g stroke=\"#dddddd\" stroke-width=\"1\">\n";
			each(t : ticks) {
				sy := Fmt(Y(ticks[t], r));
				out += "<line x1=\"{$left}\" y1=\"{$sy}\" x2=\"{$right}\" y2=\"{$sy}\"/>\n";
			};
			out += "</g>\n<g fill=\"#333333\" text-anchor=\"end\">\n";
			lx := Fmt(Left() - 8.0);
			each(t : ticks) {
				sy := Fmt(Y(ticks[t], r) + 4.0);
				out += "<text x=\"{$lx}\" y=\"{$sy}\">" + Escape(ResultTable->FormatNumber(ticks[t])) + "</text>\n";
			};
			out += "</g>\n";

			return out;
		}

		method : XTicks(r : Float[]) ~ String {
			out := "<g fill=\"#333333\" text-anchor=\"middle\">\n";
			ty := Fmt(Bottom() + 18.0);
			sx : String;
			if(@categories <> Nil) {
				each(c : @categories) {
					sx := Fmt(X(c->As(Float), r));
					out += "<text x=\"{$sx}\" y=\"{$ty}\">" + Escape(@categories[c]) + "</text>\n";
				};
			}
			else if(@log_x) {
				for(e := r[0]->As(Int); e <= r[1]->As(Int); e += 1;) {
					sx := Fmt(X(e->As(Float), r));
					out += "<text x=\"{$sx}\" y=\"{$ty}\">" + Escape(ResultTable->FormatNumber(Float->Pow(10.0, e))) + "</text>\n";
				};
			}
			else {
				xticks := Ticks(r[0], r[1], NiceStep(r[1] - r[0], 6));
				each(t : xticks) {
					sx := Fmt(X(xticks[t], r));
					out += "<text x=\"{$sx}\" y=\"{$ty}\">" + Escape(ResultTable->FormatNumber(xticks[t])) + "</text>\n";
				};
			};
			out += "</g>\n";

			return out;
		}

		method : Axes() ~ String {
			left := Fmt(Left());
			right := Fmt(Right());
			top := Fmt(Top());
			bottom := Fmt(Bottom());
			out := "<g stroke=\"#333333\" stroke-width=\"1.5\" fill=\"none\">\n";
			out += "<line x1=\"{$left}\" y1=\"{$top}\" x2=\"{$left}\" y2=\"{$bottom}\"/>\n";
			out += "<line x1=\"{$left}\" y1=\"{$bottom}\" x2=\"{$right}\" y2=\"{$bottom}\"/>\n";
			out += "</g>\n";

			mx := Fmt((Left() + Right()) / 2.0);
			ay := @height - 16;
			out += "<text x=\"{$mx}\" y=\"{$ay}\" text-anchor=\"middle\" font-size=\"13\">" + Escape(@x_label) + "</text>\n";
			my := Fmt((Top() + Bottom()) / 2.0);
			out += "<text x=\"18\" y=\"{$my}\" text-anchor=\"middle\" font-size=\"13\" transform=\"rotate(-90 18 {$my})\">" + Escape(@y_label) + "</text>\n";

			return out;
		}

		method : AllSeries(r : Float[]) ~ String {
			bar_series := 0;
			each(i : @series) {
				if(@series->Get(i)->IsBars()) {
					bar_series += 1;
				};
			};

			out := "";
			bar_index := 0;
			s : ChartSeries;
			each(i : @series) {
				s := @series->Get(i);
				if(s->IsBars()) {
					out += BarSeries(s, Color(i), bar_index, bar_series, r);
					bar_index += 1;
				}
				else {
					out += LineSeries(s, Color(i), r);
				};
			};

			return out;
		}

		method : LineSeries(s : ChartSeries, color : String, r : Float[]) ~ String {
			xs := s->GetXs();
			ys := s->GetYs();
			errs := s->GetErrors();

			points := "";
			each(p : ys) {
				if(p > 0) {
					points += " ";
				};
				points += Fmt(X(LogX(xs[p]), r)) + "," + Fmt(Y(ys[p], r));
			};
			out := "<polyline fill=\"none\" stroke=\"" + color + "\" stroke-width=\"2\" points=\"" + points + "\"/>\n";

			out += "<g fill=\"" + color + "\" class=\"markers\">\n";
			cx : String;
			cy : String;
			each(p : ys) {
				cx := Fmt(X(LogX(xs[p]), r));
				cy := Fmt(Y(ys[p], r));
				out += "<circle cx=\"{$cx}\" cy=\"{$cy}\" r=\"3.5\"/>\n";
			};
			out += "</g>\n";

			if(errs <> Nil) {
				out += "<g stroke=\"" + color + "\" stroke-width=\"1\" class=\"errorbars\">\n";
				each(p : ys) {
					if(errs[p] > 0.0) {
						out += ErrorBar(X(LogX(xs[p]), r), Y(ys[p] - errs[p], r), Y(ys[p] + errs[p], r));
					};
				};
				out += "</g>\n";
			};

			return out;
		}

		method : BarSeries(s : ChartSeries, color : String, bar_index : Int, bar_series : Int, r : Float[]) ~ String {
			xs := s->GetXs();
			ys := s->GetYs();
			errs := s->GetErrors();
			band := (Right() - Left()) / @categories->Size()->As(Float);
			bar_w := band * 0.7 / bar_series->As(Float);
			base := Y(0.0, r);
			if(base > Bottom()) {
				base := Bottom();
			};

			out := "<g fill=\"" + color + "\" class=\"bars\">\n";
			x0 : Float;
			y0 : Float;
			hgt : Float;
			rx : String;
			ry : String;
			rw := Fmt(bar_w);
			rh : String;
			each(p : ys) {
				x0 := X(xs[p], r) - band * 0.35 + bar_index->As(Float) * bar_w;
				y0 := Y(ys[p], r);
				hgt := base - y0;
				if(hgt < 0.0) {
					y0 := base;
					hgt := -hgt;
				};
				rx := Fmt(x0);
				ry := Fmt(y0);
				rh := Fmt(hgt);
				out += "<rect x=\"{$rx}\" y=\"{$ry}\" width=\"{$rw}\" height=\"{$rh}\"/>\n";
			};
			out += "</g>\n";

			if(errs <> Nil) {
				out += "<g stroke=\"#333333\" stroke-width=\"1\" class=\"errorbars\">\n";
				each(p : ys) {
					if(errs[p] > 0.0) {
						x0 := X(xs[p], r) - band * 0.35 + (bar_index->As(Float) + 0.5) * bar_w;
						out += ErrorBar(x0, Y(ys[p] - errs[p], r), Y(ys[p] + errs[p], r));
					};
				};
				out += "</g>\n";
			};

			return out;
		}

		method : Legend() ~ String {
			out := "<g class=\"legend\">\n";
			# a translucent box, so the entries read even where they sit over a line
			bx := Fmt(Right() - 158.0);
			by := Fmt(Top() + 4.0);
			bh := Fmt(12.0 + @series->Size()->As(Float) * 18.0);
			out += "<rect x=\"{$bx}\" y=\"{$by}\" width=\"150\" height=\"{$bh}\" fill=\"white\" fill-opacity=\"0.85\" stroke=\"#cccccc\"/>\n";
			lx := Fmt(Right() - 150.0);
			tx := Fmt(Right() - 132.0);
			ly : String;
			ty : String;
			each(i : @series) {
				ly := Fmt(Top() + 10.0 + i->As(Float) * 18.0);
				ty := Fmt(Top() + 20.0 + i->As(Float) * 18.0);
				out += "<rect x=\"{$lx}\" y=\"{$ly}\" width=\"12\" height=\"12\" fill=\"" + Color(i) + "\"/>\n";
				out += "<text x=\"{$tx}\" y=\"{$ty}\" fill=\"#333333\">" + Escape(@series->Get(i)->GetName()) + "</text>\n";
			};
			out += "</g>\n";

			return out;
		}

		# a vertical error bar with caps: one line and one path
		function : ErrorBar(x : Float, y_low : Float, y_high : Float) ~ String {
			sx := Fmt(x);
			sy1 := Fmt(y_low);
			sy2 := Fmt(y_high);
			cx1 := Fmt(x - 4.0);
			cx2 := Fmt(x + 4.0);
			out := "<line x1=\"{$sx}\" y1=\"{$sy1}\" x2=\"{$sx}\" y2=\"{$sy2}\"/>\n";
			out += "<path d=\"M {$cx1} {$sy1} L {$cx2} {$sy1} M {$cx1} {$sy2} L {$cx2} {$sy2}\"/>\n";
			return out;
		}

		#~
		A 1-2-5 tick step for a range.
		@param range the axis extent
		@param target roughly how many steps
		@return the step
		~#
		function : NiceStep(range : Float, target : Int) ~ Float {
			if(range <= 0.0) {
				return 1.0;
			};

			raw := range / target->As(Float);
			mag := Float->Pow(10.0, Float->Floor(Float->Log10(raw)));
			frac := raw / mag;
			if(frac <= 1.0) {
				return mag;
			};
			if(frac <= 2.0) {
				return 2.0 * mag;
			};
			if(frac <= 5.0) {
				return 5.0 * mag;
			};

			return 10.0 * mag;
		}

		# [nice low, nice high, step] enclosing lo..hi
		function : NiceRange(lo : Float, hi : Float, target : Int) ~ Float[] {
			step := NiceStep(hi - lo, target);
			out := Float->New[3];
			out[0] := Float->Floor(lo / step) * step;
			out[1] := Float->Ceil(hi / step) * step;
			out[2] := step;
			if(out[1] <= out[0]) {
				out[1] := out[0] + step;
			};

			return out;
		}

		# tick positions from lo to hi inclusive, snapped to the step
		function : Ticks(lo : Float, hi : Float, step : Float) ~ Float[] {
			count := ((hi - lo) / step + 0.5)->As(Int) + 1;
			if(count < 2) {
				count := 2;
			};
			if(count > 50) {
				count := 50;
			};

			out := Float->New[count];
			each(i : count) {
				# snap, so 0.30000000000000004 prints as 0.3
				out[i] := Float->Round((lo + i->As(Float) * step) * 1.0e9) / 1.0e9;
			};

			return out;
		}

		function : Color(i : Int) ~ String {
			select(i % 8) {
				label 0: { return "#1f77b4"; }
				label 1: { return "#ff7f0e"; }
				label 2: { return "#2ca02c"; }
				label 3: { return "#d62728"; }
				label 4: { return "#9467bd"; }
				label 5: { return "#8c564b"; }
				label 6: { return "#e377c2"; }
				other: { return "#17becf"; }
			};
		}

		function : Fmt(v : Float) ~ String {
			text := Float->ToString(v, 1);
			if(text->Equals("-0.0")) {
				return "0.0";
			};

			return text;
		}

		#~
		XML-escapes text for an SVG element or attribute.
		@param text raw text
		@return text with the five XML special characters escaped
		~#
		function : Escape(text : String) ~ String {
			if(text = Nil) {
				return "";
			};

			return text->ReplaceAll("&", "&amp;")->ReplaceAll("<", "&lt;")->ReplaceAll(">", "&gt;")->ReplaceAll("\"", "&quot;")->ReplaceAll("'", "&apos;");
		}

		function : Refuse(message : String) ~ Nil {
			Runtime->Raise(LabError->New("Chart: " + message));
		}
	}
}
