		#~
		Deprecated: the parser decodes. Unescapes JSON escape sequences in text that
		still holds them, such as a string literal copied out of JSON source. Values
		read from a parsed document (GetValue(), GetString(), GetNames()) are ALREADY
		decoded, so do not pass them here: a value that holds a real backslash would
		be decoded a second time and corrupted (a Windows path's backslash-n would
		become a newline).
		@param str encoded string
		@return decoded string
		~#
		function : native : Decode(str : String) ~ String {
			buffer := String->New();

			each(i : str) {
				c := str->Get(i);
				if(c = '\\' & i + 1 < str->Size()) {
					i += 1;
					select(str->Get(i)) {
						# backspace and form feed are 0x08 and 0x0C; these produced 0x10
						# and 0x14 (DLE, DC4)
						label 'b': {
							buffer->Append(0x08->As(Char));
						}

						label 'f': {
							buffer->Append(0x0C->As(Char));
						}

						label 'n': {
							buffer->Append('\n');
						}

						label 'r': {
							buffer->Append('\r');
						}

						label 't': {
							buffer->Append('\t');
						}

						label '\\': {
							buffer->Append('\\');
						}

						label '/': {
							buffer->Append('/');
						}

						label '"': {
							buffer->Append('"');
						}

						label 'u': {
							i += 1;
							if(i + 3 < str->Size()) {
								code := "0x{$str->SubString(i, 4)}"->ToInt();
								i += 3;

								# A character outside the BMP arrives as a surrogate pair,
								# two escapes. Appending each half as a Char is right where a
								# Char is UTF-16 and wrong where it is a full code point
								# (Linux, macOS), so the pair is combined and appended as the
								# code point, which String lays out for the platform.
								if(code >= 0xD800 & code <= 0xDBFF & i + 6 < str->Size() &
										str->Get(i + 1) = '\\' & str->Get(i + 2) = 'u') {
									low := "0x{$str->SubString(i + 3, 4)}"->ToInt();
									if(low >= 0xDC00 & low <= 0xDFFF) {
										buffer->Append(String->FromCodePoint(0x10000 + (code - 0xD800) * 0x400 + (low - 0xDC00)));
										i += 6;
									}
									else {
										buffer->Append(code->As(Char));
									};
								}
								else {
									buffer->Append(code->As(Char));
								};
							}
							else if(i < str->Size()) {
								buffer->Append(str->Get(i));
							};
						}
					};
				}
				else {
					buffer->Append(c);
				};
			};

			return buffer;
		}

		#~
		Appends a single '\uXXXX' escape.

		Int->ToHexString returns a '0x'-prefixed, unpadded value, so appending it
		directly produced escapes carrying the prefix, and short ones were never
		padded. JSON requires exactly four hex digits with no prefix.
		@param code code point to escape
		@param buffer buffer to append to
		~#
		function : AppendHexEscape(code : Int, buffer : String) ~ Nil {
			str_hex := code->ToHexString();
			if(str_hex->StartsWith("0x")) {
				str_hex := str_hex->SubString(2, str_hex->Size() - 2);
			};

			buffer->Append("\\u");
			for(i := str_hex->Size(); i < 4; i += 1;) {
				buffer->Append('0');
			};
			buffer->Append(str_hex);
		}

		#~
		Escapes a string for inclusion in JSON text: the quote, the backslash and every
		control character below U+0020 become escapes, and every character above U+007F
		a u-escape (a surrogate pair outside the BMP), so the text is plain ASCII
		whatever carries it. The slash is written as is. An unpaired surrogate is
		written as the u-escape of U+FFFD, the character the parser reads one as.
		Serialization does this for you: ToString() and Format() escape every string
		value and object key on the way out, so a value handed to Insert() must be RAW
		text -- encoding it first would escape it twice. Call this only when building
		JSON text by hand.
		@param str decoded string
		@return encoded string
		~#
		function : native : Encode(str : String) ~ String {
			buffer := String->New();
			size := str->Size();

			i := 0;
			while(i < size) {
				c := str->Get(i);

				if(c > 127) {
					code := c->As(Int);
					if(code > 0xFFFF) {
						# outside the BMP: JSON escapes need a UTF-16 surrogate pair
						code -= 0x10000;
						AppendHexEscape(0xD800 + (code / 0x400), buffer);
						AppendHexEscape(0xDC00 + (code % 0x400), buffer);
					}
					else if(code >= 0xD800 & code <= 0xDBFF) {
						# a high surrogate is half of a pair where strings are UTF-16,
						# kept whole; alone it is not a character
						low := 0;
						if(i + 1 < size) {
							low := str->Get(i + 1)->As(Int);
						};

						if(low >= 0xDC00 & low <= 0xDFFF) {
							AppendHexEscape(code, buffer);
							AppendHexEscape(low, buffer);
							i += 1;
						}
						else {
							AppendHexEscape(0xFFFD, buffer);
						};
					}
					else if(code >= 0xDC00 & code <= 0xDFFF) {
						AppendHexEscape(0xFFFD, buffer);
					}
					else {
						AppendHexEscape(code, buffer);
					};
				}
				else {
					select(c) {
						# 0x08 and 0x0C; these matched 0x10 and 0x14
						label 0x08: {
							buffer->Append("\\b");
						}

						label 0x0C: {
							buffer->Append("\\f");
						}

						label '\n': {
							buffer->Append("\\n");
						}

						label '\r': {
							buffer->Append("\\r");
						}

						label '\t': {
							buffer->Append("\\t");
						}

						label '\\': {
							buffer->Append("\\\\");
						}

						label '"': {
							buffer->Append("\\\"");
						}

						other: {
							# JSON forbids a raw control character in a string; it was
							# copied through and produced text no parser accepts. The
							# slash falls through to here: it needs no escape, and was
							# written as one, which only made the text longer.
							if(c < 0x20) {
								AppendHexEscape(c->As(Int), buffer);
							}
							else {
								buffer->Append(c);
							};
						}
					};
				};

				i += 1;
			};

			return buffer;
		}

		#~
		Gets the names of object attributes
		@return object attribute names
		~#
		method : public : GetNames() ~ Vector<String> {
			if(@map_elems <> Nil) {
				return @map_elems->GetKeys()<String>;
			};

			return Nil;
		}

		#~
		Gets the size of an array or object value
		@return size of an array or object value

		```
		arr := Data.JSON.JsonParser->TextToElement("[1,2,3,4,5]");
		arr->Size()->PrintLine();  # 5
		```
		~#
		method : public : Size() ~ Int {
			if(@array_elems <> Nil) {
				return @array_elems->Size();
			};

			if(@map_elems <> Nil) {
				return @map_elems->Size();
			};

			return 0;
		}

		#~
		Checks a node's type
		@param elem element to check
		@param type type to check
		@return true of matching, false otherwise
		~#
		function : public : MatchType(elem : JsonElement, type : JsonElement->JsonType) ~ Bool {
			if(elem <> Nil & elem->GetType() = type) {
				return true;
			};

			return false;
		}

		#~
		Checks a node's type
		@param elem element to check
		@param value value to check
		@return true of matching, false otherwise
		~#
		function : public : MatchValue(elem : JsonElement, value : String) ~ Bool {
			if(elem <> Nil & elem->GetType() = JsonElement->JsonType->STRING & elem->GetValue()->Equals(value)) {
				return true;
			};

			return false;
		}

		#~
		Stringify the JSON element
		String values and object keys are escaped as they are written, so text that
		holds quotes, backslashes or newlines produces valid JSON; do not pre-encode
		values before inserting them.
		@return JSON string

		```
		obj := Data.JSON.JsonElement->New(Data.JSON.JsonElement->JsonType->OBJECT);
		obj->Insert("ok", true);
		obj->ToString()->PrintLine();  # {"ok":true}
		```
		~#
		method : public : ToString() ~ String {
			output := String->New();
			Format(output, false, 0);
			return output;
		}

		#~
		Stringify and format the JSON element
		@return formatted JSON string

		```
		obj := Data.JSON.JsonParser->TextToElement("{\"a\":1,\"b\":2}");
		obj->ToFormattedString()->PrintLine();
		```
		~#
		method : public : ToFormattedString() ~ String {
			output := String->New();
			Format(output, true, 0);
			return output;
		}

		method : Format(output : String, pretty : Bool, depth : Int) ~ Nil {
			select(@type) {
				label JsonElement->JsonType->STRING: {
					if(@value <> Nil) {
						# Escape on the way OUT. This appended the raw value, so a string
						# holding a quote, a backslash or a newline produced text that was
						# not JSON, and callers had to know to pre-encode -- two of the three
						# AI clients did not. The serializer is the only layer that knows it
						# is producing JSON, so it is the one that escapes. Do NOT pre-encode
						# values handed to Insert() any more; they would be escaped twice.
						output->Append('"');
						AppendEncoded(@value, output);
						output->Append('"');
					}
					else {
						# never nothing: a value with no text is null
						output->Append("null");
					};
				}

				label JsonElement->JsonType->NUMBER: {
					if(@value <> Nil) {
						output->Append(@value);
					}
					else {
						# never nothing: a value with no text is null
						output->Append("null");
					};
				}

				# true, false, null and the '":' after a key are appended a character at a
				# time: a string literal is a new String each time it is evaluated, about
				# 3,000 instructions against 180 for a character
				label JsonElement->JsonType->TRUE: {
					output->Append('t');
					output->Append('r');
					output->Append('u');
					output->Append('e');
				}

				label JsonElement->JsonType->FALSE: {
					output->Append('f');
					output->Append('a');
					output->Append('l');
					output->Append('s');
					output->Append('e');
				}

				label JsonElement->JsonType->NULL: {
					output->Append('n');
					output->Append('u');
					output->Append('l');
					output->Append('l');
				}

				label JsonElement->JsonType->ARRAY: {
					if(@array_elems <> Nil) {
						output->Append('[');
						if(pretty) {
							output->Append('\n');
							depth += 1;
							FormatPadding(output, depth);
						};

						each(i : @array_elems) {
							@array_elems->Get(i)->Format(output, pretty, depth);
							if(i + 1 < @array_elems->Size()) {
								output->Append(',');
								if(pretty) {
									output->Append('\n');
									FormatPadding(output, depth);
								};
							};
						};

						if(pretty) {
							output->Append('\n');
							depth -= 1;
							FormatPadding(output, depth);
						};
						output->Append(']');
					};
				}

				label JsonElement->JsonType->OBJECT: {
					if(@map_elems <> Nil) {
						output->Append('{');
						if(pretty) {
							output->Append('\n');
							depth += 1;
							FormatPadding(output, depth);
						};

						# one walk of the map gives each key with its value, in key order; asking
						# the map for every key again cost a search per member
						members := @map_elems->GetKeyValues()<Collection.Pair<String, JsonElement>>;
						each(i : members) {
							member := members->Get(i);

							output->Append('"');
							AppendEncoded(member->GetFirst(), output);
							output->Append('"');
							output->Append(':');
							if(pretty) {
								output->Append(' ');
							};

							member->GetSecond()->Format(output, pretty, depth);
							if(i + 1 < members->Size()) {
								output->Append(',');
								if(pretty) {
									output->Append('\n');
									FormatPadding(output, depth);
								};
							};
						};

						if(pretty) {
							output->Append('\n');
							depth -= 1;
							FormatPadding(output, depth);
						};
						output->Append('}');

					};
				}
			};
		}

		#
		# Appends 'str' as the content of a JSON string, escaped as Encode escapes it.
		# Text with nothing to escape (plain ASCII without a quote, a backslash or a
		# control character: most keys and most values) is appended in one piece.
		# Encode builds its result a character at a time and the result was then
		# copied into the output, about 540 instructions a character; this is one
		# pass over the characters and one copy. Anything else goes through Encode.
		#
		function : native : AppendEncoded(str : String, output : String) ~ Nil {
			chars := str->ToCharArray();
			size := chars->Size();
			for(i := 0; i < size; i += 1;) {
				c := chars[i];
				if(c < 0x20 | c > 127 | c = '"' | c = '\\') {
					output->Append(JsonElement->Encode(str));
					return;
				};
			};
			output->Append(chars, 0, size);
		}

		method : FormatPadding(output : String, depth : Int) ~ Nil {
			each(i : depth) {
				output->Append('\t');
			};
		}

		#~
		Queries the object graph. Object attributes referenced by '/' while array elements are referenced by '[index]'. Example "cars/[last]/make".
		@param path query path
		@return matching element

		```
		json := Data.JSON.JsonParser->TextToElement("{\"users\":[{\"name\":\"Alice\"},{\"name\":\"Bob\"}]}");
		alice := json->FindElements("users/[0]/name");
		alice->GetString()->PrintLine();  # Alice
		```
		~#
		method : public : FindElements(path : String) ~ JsonElement {
			filters := path->Split("/");
			if(filters->Size() > 0) {
				element := @self;
				for(i := 0; i < filters->Size() & element <> Nil; i += 1;) {
					element := FindElement(filters[i], element);
				};

				return element;
			}
			else {
				return FindElement(path, @self);
			};

			return Nil;
		}

		method : FindElement(filter : String, node : JsonElement) ~ JsonElement {
			# array
			if(filter->StartsWith('[') & filter->EndsWith(']') & node->GetType() = JsonElement->JsonType->ARRAY) {
				end := filter->Find(']');
				index := filter->SubString(1, end - 1);

				offset : Int;
				if(index->Equals("first")) {
					offset := 0;
				}
				else if(index->Equals("last")) {
					offset := node->Size() - 1;
				}
				else {
					offset := index->ToInt();
				};

				if(offset > -1 & offset < node->Size()) {
					return node->Get(offset);
				};
			}
			# object
			else if(node->GetType() = JsonElement->JsonType->OBJECT) {
				return node->Get(filter);
			};

			return Nil;
		}
	}

	# token class
	class Token {
		@type : Token->Type;
		@value : String;

		#~
		The kind of a token read by the JSON scanner.
		~#
		enum Type {
			#~
			A quoted string; the value is its text with the escapes decoded.
			~#
			IDENT,
			#~
			An integer number.
			~#
			INT_NUM,
			#~
			A number with a fraction or exponent.
			~#
			FLOAT_NUM,
			#~
			Text that starts like a number but is not a valid one.
			~#
			BAD_NUM,
			#~
			The literal true.
			~#
			TRUE,
			#~
			The literal false.
			~#
			FALSE,
			#~
			The literal null.
			~#
			NULL,
			#~
			A comma.
			~#
			COMMA,
			#~
			An opening bracket.
			~#
			OBR,
			#~
			A closing bracket.
			~#
			CBR,
			#~
			An opening brace.
			~#
			OCBR,
			#~
			A closing brace.
			~#
			CCBR,
			#~
			Not produced by the scanner.
			~#
			PREN,
			#~
			A colon.
			~#
			COLON,
			#~
			Any other character, or a string the scanner refused (the value is then
			the parse error).
			~#
			OTHER,
			#~
			The end of the input.
			~#
			EOS
		}

		New(type : Token->Type, value : String) {
			@type := type;
			@value := value;
		}

		New(type : Token->Type) {
			@type := type;
			@value := Nil;
		}

		method : public : GetType() ~ Token->Type {
			return @type;
		}

		method : public : GetValue() ~ String {
			return @value;
		}
	}
}

#~
Support for e JSON Schema metadata (-lib json)
~#
bundle Data.JSON.Scheme {
	#~
	Function type definition
	~#
	class FunctionType implements Compare {
		@name: String;
		@title: String;
		@desc: String;
		@params : Map<String, ParameterType>;
		@req_params : String[];

		#~
		Constructor
		@param func_type_json function JSOfN type
		~#
		New(func_type_json : JsonElement) {
			Parse(func_type_json, "parameters");
		}

		#~
		Constructor
		@param func_type_json function JSON type
		@param params_header parameter header string
		~#
		New(func_type_json : JsonElement, params_header : String) {
			Parse(func_type_json, params_header);
		}

		method : Parse(func_type_json : JsonElement, params_header : String) ~ Nil {
			@name := func_type_json->Get("name")->GetString();

			if(func_type_json->Has("title")){
				@title := func_type_json->Get("title")->GetString();
			}

			if(func_type_json->Has("description")){
				@desc := func_type_json->Get("description")->GetString();
			}

			# get properties by name
			@params := Map->New()<String, ParameterType>;

			params_json := func_type_json->FindElements("{$params_header}/properties");
			param_names := params_json->GetNames();
			each(param_name in param_names) {
				param_json := params_json->Get(param_name);

				param_type := param_json->Get("type")->GetString();

				# set on every pass: a parameter with no description has none
				param_desc : String := Nil;
				if(param_json->Has("description")) {
					param_desc := param_json->Get("description")->GetString();
				};

				param : ParameterType := Nil;
				if(param_type->Equals("string")) {
					param := ParameterType->New(ParameterType->Type->STRING, param_desc);
				}
				else if(param_type->Equals("number")) {
					param := ParameterType->New(ParameterType->Type->NUMBER, param_desc);
				}
				else if(param_type->Equals("integer")) {
					param := ParameterType->New(ParameterType->Type->INTEGER, param_desc);
				}
				else if(param_type->Equals("object")) {
					param := ParameterType->New(ParameterType->Type->OBJECT, param_desc);
				}
				else if(param_type->Equals("boolean")) {
					param := ParameterType->New(ParameterType->Type->BOOLEAN, param_desc);
				};

				# a type this scheme does not model leaves the parameter out
				if(param <> Nil) {
					@params->Insert(param_name, param);
				};

				# "param_name='{$param_name}', param_type={$param_type}, param_desc='{$param_desc}'"->PrintLine();
			};

			required_parms := func_type_json->FindElements("{$params_header}/required");
			@req_params := String->New[required_parms->Size()];
			each(i : required_parms) {
				required_parm := required_parms->Get(i);
				@req_params[i] := required_parm->GetString();
			}
		}

		#~
		Constructor
		@param name function name
		@param params parameters to add to JSON object
		@param req_params required parameters
		~#
		New(name : String, params : Map<String, ParameterType>, req_params : String[]) {
			@name := name;
			@req_params := req_params;
			@params := params;
		}

		#~
		Constructor
		@param name function name
		@param params parameters to add to JSON object
		~#
		New(name : String, params : Map<String, ParameterType>) {
			@name := name;
			@params := params;
		}

		#~
		Constructor
		@param name function name
		@param params parameters to add to JSON object
		@param desc description
		~#
		New(name : String, params : Map<String, ParameterType>, desc : String) {
			@name := name;
			@params := params;
			@desc := desc;
		}

		#~
		Constructor
		@param name function name
		@param params parameters to add to JSON object
		@param req_params required parameters
		@param desc description
		~#
		New(name : String, params : Map<String, ParameterType>, req_params : String[], desc : String) {
			@name := name;
			@req_params := req_params;
			@params := params;
			@desc := desc;
		}

		#~
		Constructor
		@param name function name
		@param title function title
		@param params parameters to add to JSON object
		@param req_params required parameters
		@param desc description
		~#
		New(name : String, title : String, params : Map<String, ParameterType>, req_params : String[], desc : String) {
			@name := name;
			@title := title;
			@req_params := req_params;
			@params := params;
			@desc := desc;
		}

		#~
		Get the function name
		@return function name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Get the function title
		@return function title
		~#
		method : public : GetTitle() ~ String {
			return @title;
		}

		#~
		Get the function description
		@return function description
		~#
		method : public : GetDesc() ~ String {
			return @desc;
		}

		#~
		Get function parameters
		@return function parameters
		~#
		method : public : GetParams() ~ Map<String, ParameterType> {
			return @params;
		}

		#~
		Get the required function parameters
		@return required function parameters
		~#
		method : public : GetRequiredParams() ~ String[] {
			return @req_params;
		}

		#~
		Compares two objects
		@param rhs compare object
		@return 0 if equal, -1 if right-hand side i greater, 1 if left-hand side is greater
		~#
		method : public : Compare(rhs : System.Compare) ~ Int {
			return @name->Compare(rhs);
		}

		#~
		Returns a hash ID for the given class
		@return hash ID
		~#
		method : public : HashID() ~ Int {
			return @name->HashID();
		}

		#~
		JSON element representation
		@return JSON element representation
		~#
		method : public : ToJson() ~ JsonElement {
			func_obj_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			func_obj_json->Insert("name", @name);

			if(@desc <> Nil) {
				func_obj_json->Insert("description", @desc);
			};

			# JSON parameters
			prop_obj_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			if(@params <> Nil) {
				param_values := @params->GetKeyValues()<Pair<String, ParameterType>>;
				each(param_value in param_values) {
					param_name := param_value->GetFirst();
					param_obj_json := param_value->GetSecond();

					prop_obj_json->Insert(param_name, param_obj_json->ToJson());
				};
			};

			func_obj_json->Insert("type", "object");
			func_obj_json->Insert("properties", prop_obj_json);
			if(@req_params <> Nil) {
				req_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);
				each(req_param in @req_params) {
					req_array_json->Add(req_param)
				};
				func_obj_json->Insert("required", req_array_json);
			};

			return func_obj_json;
		}

		#~
		JSON string representation
		@return JSON string representation
		~#
		method : public : ToString() ~ String {
			return ToJson()->ToString();
		}
	}

	#~
	Function parameter type definition
	~#
	class ParameterType implements Compare {
		@type : ParameterType->Type;
		@desc : String;
		@props : Map<String, ParameterType>;
		@req_params : String[];
		@is_array : Bool;

		#~
		JSON function parameter type
		~#
		enum Type {
			STRING,
			NUMBER,
			INTEGER,
			OBJECT,
			BOOLEAN
		}

		#~
		Constructor
		@param type parameter type
		@param is_array true if array, false otherwise
		~#
		New(type : ParameterType->Type, is_array : Bool) {
			@type := type;
			@is_array := is_array;

			@props := Map->New()<String, ParameterType>;
		}

		#~
		Constructor
		@param type parameter type
		@param is_array true if array, false otherwise
		@param desc description
		~#
		New(type : ParameterType->Type, is_array : Bool, desc : String) {
			@type := type;
			@is_array := is_array;
			@desc := desc;

			@props := Map->New()<String, ParameterType>;
		}

		#~
		Constructor
		@param req_params require parameters
		@param is_array true if array, false otherwise
		~#
		New(req_params : String[], is_array : Bool) {
			@type := ParameterType->Type->OBJECT;
			@req_params := req_params;
			@is_array := is_array;

			@props := Map->New()<String, ParameterType>;
		}

		#~
		Constructor
		@param type parameter type
		~#
		New(type : ParameterType->Type) {
			@type := type;

			@props := Map->New()<String, ParameterType>;
		}

		#~
		Constructor
		@param type parameter type
		@param desc description
		~#
		New(type : ParameterType->Type, desc : String) {
			@type := type;
			@desc := desc;

			@props := Map->New()<String, ParameterType>;
		}

		#~
		Constructor
		@param req_params require parameters
		~#
		New(req_params : String[]) {
			@type := ParameterType->Type->OBJECT;
			@req_params := req_params;

			@props := Map->New()<String, ParameterType>;
		}

		#~
		Constructor
		@param req_params require parameters
		@param desc description
		~#
		New(req_params : String[], desc : String) {
			@type := ParameterType->Type->OBJECT;
			@req_params := req_params;
			@desc := desc;

			@props := Map->New()<String, ParameterType>;
		}

		#~
		Set schema to be an array of entities
		@param is_array if true an array of entities, false other
		~#
		method : public : SetArray(is_array : Bool) ~ Nil {
			@is_array := is_array;
		}

		#~
		Returns rather the schema specifies an array of entities
		@return true the scheme specifies array of entities, false otherwise
		~#
		method : public : IsArray() ~ Bool {
			return @is_array;
		}

		#~
		Get the function description
		@return function description
		~#
		method : public : GetDesc() ~ String {
			return @desc;
		}

		#~
		Set the function description
		@param desc sets function description
		~#
		method : public : SetDesc(desc : String) ~ Nil {
			@desc := desc;
		}

		#~
		Get parameter type
		@return parameter type
		~#
		method : public : GetType() ~ ParameterType->Type {
			return @type;
		}

		#~
		Set parameter type
		@param type parameter type
		~#
		method : public : SetType(type : ParameterType->Type) ~ Nil {
			@type := type;
		}

		#~
		Get parameter properties object descriptions
		@return properties object descriptions
		~#
		method : public : GetProps() ~ Map<String, ParameterType> {
			return @props;
		}

		#~
		Set properties
		@param props properties
		~#
		method : public : AddProp(prop_name : String, prop : ParameterType) ~ Nil {
			@props->Insert(prop_name, prop);
		}

		#~
		Returns a hash ID for the given class
		@return hash ID
		~#
		method : public : HashID() ~ Int {
			return @type;
		}

		method : public : Compare(rhs : System.Compare) ~ Int {
			r := 1;

			# check class type
			if(@self->GetClassID() <> rhs->GetClassID()) {
				r := -1;
			};

			right : ParameterType := rhs->As(ParameterType);
			if(@type = right->GetType()) {
				r := 0;
			};

			return r;
		}

		#~
		JSON element representation
		@return JSON element representation
		~#
		method : public : ToJson() ~ JsonElement {
			param_obj_json := JsonElement->New(JsonElement->JsonType->OBJECT);

			if(@is_array) {
				items_obj_json := JsonElement->New(JsonElement->JsonType->OBJECT);

				if(@desc <> Nil) {
					items_obj_json->Insert("description", @desc);
				};

				select(@type) {
					label ParameterType->Type->STRING {
						items_obj_json->Insert("type", "string");
					}

					label ParameterType->Type->NUMBER {
						items_obj_json->Insert("type", "number");
					}

					label ParameterType->Type->INTEGER {
						items_obj_json->Insert("type", "integer");
					}

					label ParameterType->Type->BOOLEAN {
						items_obj_json->Insert("type", "boolean");
					}

					label ParameterType->Type->OBJECT {
						items_obj_json->Insert("type", "object");
						prop_obj_json := JsonElement->New(JsonElement->JsonType->OBJECT);

						prop_values := @props->GetKeyValues()<Pair<String, ParameterType>>;
						each(prop_value in prop_values) {
							prop_name := prop_value->GetFirst();
							prop := prop_value->GetSecond();

							if(prop_name <> Nil)	{
								prop_obj_json->Insert(prop_name, prop->ToJson());
							};
						}
						items_obj_json->Insert("properties", prop_obj_json);

						if(@req_params <> Nil) {
							req_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);
							each(req_param in @req_params) {
								req_array_json->Add(req_param);
							};
							items_obj_json->Insert("required", req_array_json);
						};
					}

					other {
						items_obj_json->Insert("type", Nil);
					}
				};

				param_obj_json->Insert("items", items_obj_json);
				param_obj_json->Insert("type", "array");
			}
			else {
				if(@desc <> Nil) {
					param_obj_json->Insert("description", @desc);
				};

				if(@desc <> Nil) {
					param_obj_json->Insert("description", @desc);
				};

				select(@type) {
					label ParameterType->Type->STRING {
						param_obj_json->Insert("type", "string");
					}

					label ParameterType->Type->NUMBER {
						param_obj_json->Insert("type", "number");
					}

					label ParameterType->Type->INTEGER {
						param_obj_json->Insert("type", "integer");
					}

					label ParameterType->Type->BOOLEAN {
						param_obj_json->Insert("type", "boolean");
					}

					label ParameterType->Type->OBJECT {
						param_obj_json->Insert("type", "object");

						prop_obj_json := JsonElement->New(JsonElement->JsonType->OBJECT);

						prop_values := @props->GetKeyValues()<Pair<String, ParameterType>>;
						each(prop_value in prop_values) {
							prop_name := prop_value->GetFirst();
							prop := prop_value->GetSecond();

							if(prop_name <> Nil)	{
								prop_obj_json->Insert(prop_name, prop->ToJson());
							};
						}
						param_obj_json->Insert("properties", prop_obj_json);

						if(@req_params <> Nil) {
							req_array_json := JsonElement->New(JsonElement->JsonType->ARRAY);
							each(req_param in @req_params) {
								req_array_json->Add(req_param);
							};
							param_obj_json->Insert("required", req_array_json);
						};
					}

					other {
						param_obj_json->Insert("type", Nil);
					}
				};
			};

			return param_obj_json;
		}

		#~
		JSON string representation
		@return JSON string representation
		~#
		method : public : ToString() ~ String {
			return ToJson()->ToString();
		}
	}
}