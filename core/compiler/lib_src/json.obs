		arr->Get(1)->GetInt()->PrintLine();  # 20
		```
		~#
		method : public : Get(index : Int) ~ JsonElement {
			if(@array_elems <> Nil & index >= 0 & index < @array_elems->Size()) {
				return @array_elems->Get(index);
			};

			return Nil;
		}

		#~
		Check to see if the indexed value exists
		@param index index
