use Collection;

#~
JSON parsing and building library. JsonParser reads JSON strings into a JsonElement tree; JsonBuilder constructs JSON documents using a stack-based API. Compile with -lib json.
~#
bundle Data.JSON {
	#~
	Stack driven JSON builder

	```
builder := JsonBuilder->New();
money := builder->PushObject();

money->Insert("type", "usd");
money->Insert("amount", "1013");

deposits := JsonElement->New(JsonElement->JsonType->ARRAY);
deposits->Add(115);
deposits->Add(318);
deposits->Add(580);
money->Insert("deposits", deposits);

builder->Pop()->ToString()->PrintLine();
	```
	~#
	class JsonBuilder {
		@stack : Stack<JsonElement>;

		#~
		Constructor
		~#
		New() {
			@stack := Stack->New()<JsonElement>;
		}

		#~
		Size of element stack
		~#
		method : public : Size() ~ Int {
			return @stack->Size();
		}

		#~
		Pushes an object element on the stack

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		root->Insert("status", "ok");
		root->Insert("count", 3);
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : PushObject() ~ JsonBuilder {
			if(@stack->IsEmpty()) {
				@stack->Push(JsonElement->New(JsonType->OBJECT));
			}
			else if(@stack->Top()->GetType() = JsonType->ARRAY) {
				elem := JsonElement->New(JsonType->OBJECT);
				@stack->Top()->Add(elem);
				@stack->Push(elem);
			};

			return @self;
		}

		#~
		Pushes an object element on the stack
		@param name object name

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		addr := root->PushObject("address");
		addr->Insert("city", "Oakland");
		addr->Insert("zip", "94612");
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : PushObject(name : String) ~ JsonBuilder {
			if(@stack->IsEmpty()) {
				@stack->Push(JsonElement->New(JsonType->OBJECT, name));
			}
			else if(@stack->Top()->GetType() = JsonType->ARRAY) {
				elem := JsonElement->New(JsonType->OBJECT);
				@stack->Top()->Add(elem);
				@stack->Push(elem);
			}
			else if(@stack->Top()->GetType() = JsonType->OBJECT) {
				elem := @stack->Top()->AddChild(name);
				@stack->Top()->Add(elem);
				@stack->Push(elem);
			};

			return @self;
		}

		#~
		Pushes an array element on the stack

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		arr := root->PushArray("scores");
		arr->Add(95);
		arr->Add(87);
		arr->Add(92);
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : PushArray() ~ JsonBuilder {
			if(@stack->IsEmpty()) {
				@stack->Push(JsonElement->New(JsonType->ARRAY));
			}
			else {
				elem := JsonElement->New(JsonType->ARRAY);
				@stack->Top()->Add(elem);
				@stack->Push(elem);
			};

			return @self;
		}

		#~
		Pops a value
		@return popped element

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		root->Insert("x", 1);
		json := builder->Pop();
		json->ToString()->PrintLine();
		```
		~#
		method : public : Pop() ~ JsonElement {
			if(@stack->IsEmpty()) {
				return Nil;
			};

			elem := @stack->Top();
			@stack->Pop();
			return elem;
		}

		#~
		Pop all values
		@return last popped element

		```
		builder := Data.JSON.JsonBuilder->New();
		builder->PushObject()->Insert("a", 1);
		json := builder->PopAll();
		json->ToString()->PrintLine();
		```
		~#
		method : public : PopAll() ~ JsonElement {
			if(@stack->IsEmpty()) {
				return Nil;
			};

			while(@stack->Size() <> 1) {
				@stack->Pop();
			};

			elem := @stack->Top();
			@stack->Pop();
			return elem;
		}

		#~
		Adds a value
		@param value value
		@return true if successful, false otherwise

		```
		builder := Data.JSON.JsonBuilder->New();
		arr := builder->PushArray();
		arr->Add("red");
		arr->Add("green");
		arr->Add("blue");
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : Add(value : String) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->ARRAY) {
				return Nil;
			};

			@stack->Top()->Add(value);
			return @self;
		}

		#~
		Adds a value
		@param value value
		@return true if successful, false otherwise

		```
		builder := Data.JSON.JsonBuilder->New();
		arr := builder->PushArray();
		arr->Add(1);
		arr->Add(2);
		arr->Add(3);
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : Add(value : Int) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->ARRAY) {
				return Nil;
			};

			@stack->Top()->Add(value);
			return @self;
		}

		#~
		Adds a value
		@param value value
		@return true if successful, false otherwise
		~#
		method : public : Add(value : Float) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->ARRAY) {
				return Nil;
			};

			@stack->Top()->Add(value);
			return @self;
		}

		#~
		Adds a value
		@param value value
		@return true if successful, false otherwise
		~#
		method : public : Add(value : Bool) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->ARRAY) {
				return Nil;
			};

			@stack->Top()->Add(value);
			return @self;
		}

		#~
		Adds a value
		@param value value
		@return true if successful, false otherwise
		~#
		method : public : Add(value : JsonElement) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->ARRAY) {
				return Nil;
			};

			@stack->Top()->Add(value);
			return @self;
		}

		#~
		Insert an element
		@param name element name
		@param value value
		@return true if successful, false otherwise

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		root->Insert("age", 30);
		root->Insert("score", 99);
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : Insert(name : String, value : Int) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->OBJECT) {
				return Nil;
			};

			@stack->Top()->Insert(name, value);
			return @self;
		}

		#~
		Insert an element
		@param name element name
		@param value value
		@return true if successful, false otherwise

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		root->Insert("price", 9.99);
		root->Insert("tax", 0.08);
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : Insert(name : String, value : Float) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->OBJECT) {
				return Nil;
			};

			@stack->Top()->Insert(name, value);
			return @self;
		}

		#~
		Insert an element
		@param name element name
		@param value value
		@return true if successful, false otherwise

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		root->Insert("name", "Alice");
		root->Insert("role", "admin");
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : Insert(name : String, value : String) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->OBJECT) {
				return Nil;
			};

			@stack->Top()->Insert(name, value);
			return @self;
		}

		#~
		Insert an element
		@param name element name
		@param value value
		@return true if successful, false otherwise

		```
		builder := Data.JSON.JsonBuilder->New();
		root := builder->PushObject();
		root->Insert("active", true);
		root->Insert("verified", false);
		builder->Pop()->ToString()->PrintLine();
		```
		~#
		method : public : Insert(name : String, value : Bool) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->OBJECT) {
				return Nil;
			};

			@stack->Top()->Insert(name, value);
			return @self;
		}

		#~
		Insert an element
		@param name element name
		@param value value
		@return true if successful, false otherwise
		~#
		method : public : Insert(name : String, value : JsonElement) ~ JsonBuilder {
			if(@stack->IsEmpty() | @stack->Top()->GetType() <> JsonType->OBJECT) {
				return Nil;
			};

			@stack->Top()->Insert(name, value);
			return @self;
		}
	}

	#~
	Support for JSON parsing

	```
doc := Web.HTTP.HttpsClient->QuickGet(Web.HTTP.Url->New("https://dummyjson.com/carts"));
if(doc <> Nil) {
   parser := Data.JSON.JsonParser->New(String->New(doc));
   if(parser->Parse()) {
      carts := parser->GetRoot()->Get("carts");   # Get is Nil for a missing member
      if(carts <> Nil & carts->Size() > 0) {
         cart := carts->Get(Int->Random(carts->Size()));
         cart_id := cart->Get("id");
         products := cart->Get("products");
         if(cart_id <> Nil & products <> Nil) {
            "cart id={$cart_id->GetInt()}\n---"->PrintLine();
            each(product := products) {
               product_id := product->Get("id");
               product_title := product->Get("title");
               if(product_id <> Nil & product_title <> Nil) {
                  "\tid={$product_id->GetInt()}, title: '{$product_title->GetString()}'"->PrintLine();
               };
            };
         };
      };
   };
};
	```
	~#
	class JsonParser {
		@input : Char[];
		@input_index : Int;

		@tokens : Token[];
		@cur_token : Token;
		@token_read_pos : Int;
		@token_write_pos : Int;
		@tokens_max : Int;

		# A token without a value says only what kind it is, so one instance per kind
		# serves the whole parse. They are made on first use: a comma and a colon come
		# once per member, and the padding that fills the token buffer past the end of
		# the input was 16 new tokens per document on average.
		@obr_token : Token;
		@cbr_token : Token;
		@ocbr_token : Token;
		@ccbr_token : Token;
		@comma_token : Token;
		@colon_token : Token;
		@true_token : Token;
		@false_token : Token;
		@null_token : Token;
		@other_token : Token;

		@root : JsonElement;
		@error_msg : String;
		@depth : Int;
		@max_depth : Int;

		#~
		Constructor
		@param stream_in JSON string to process
		~#
		New(stream_in : String) {
			# Nil, the text of a file that could not be read, is empty text: Parse() fails
			if(stream_in = Nil) {
				@input := Char->New[0];
			}
			else {
				@input := stream_in->Trim()->ToCharArray();
			};
			@input_index := 0;

			@tokens_max := 32;
			@tokens := Token->New[@tokens_max];
			@max_depth := 64;
		}

		#~
		Constructor
		@param stream_in JSON character stream
		~#
		New(stream_in : Char[]) {
			if(stream_in = Nil) {
				@input := Char->New[0];
			}
			else {
				@input := stream_in->ToString()->Trim()->ToCharArray();
			};
			@input_index := 0;

			@tokens_max := 32;
			@tokens := Token->New[@tokens_max];
			@max_depth := 64;
		}

		#~
		Constructor
		@param stream_in JSON byte stream
		~#
		New(stream_in : Byte[]) {
			if(stream_in = Nil) {
				@input := Char->New[0];
			}
			else {
				@input := stream_in->ToString()->Trim()->ToCharArray();
			};
			@input_index := 0;

			@tokens_max := 32;
			@tokens := Token->New[@tokens_max];
			@max_depth := 64;
		}

		#~
		Parses JSON text
		@param text JSON text
		@return root document element

		```
		elem := Data.JSON.JsonParser->TextToElement("{\"k\":\"v\"}");
		if(elem <> Nil) {
		  k := elem->Get("k");   # Nil for a missing member
		  if(k <> Nil) {
		    k->GetString()->PrintLine();  # v
		  };
		};
		```
		~#
		function : TextToElement(text : String) ~ JsonElement {
			parser := JsonParser->New(text);
			if(parser->Parse()) {
				return parser->GetRoot();
			};

			return Nil;
		}

		#~
		Parses a Json string
		@return true is successful, false otherwise

		```
		parser := Data.JSON.JsonParser->New("{\"name\":\"Alice\",\"age\":30}");
		if(parser->Parse()) {
		  name := parser->GetRoot()->Get("name");   # Nil for a missing member
		  if(name <> Nil) {
		    name->GetString()->PrintLine();
		  };
		} else {
		  parser->GetError()->PrintLine();
		};
		```
		~#
		method : public : Parse() ~ Bool {
			NextToken();
			if(@cur_token->GetType() <> Token->Type->OTHER) {
# "--- Start Parsing --"->PrintLine();
				@root := ParseValue();
# "--- End Parsing --"->PrintLine();
				return @root <> Nil;
			};

			# a document that is one refused string
			@error_msg := TokenError("*** Unexpected value *** ");

			return false;
    	}

    	#~
		Get the current parsing error
		@return parsing error, Nil if none

		```
		parser := Data.JSON.JsonParser->New("{bad json}");
		if(<>parser->Parse()) {
		  parser->GetError()->PrintLine();
		};
		```
		~#
		method : public : GetError() ~ String {
			return @error_msg;
		}

    	#~
		Get document root
		@return root Json element

		```
		parser := Data.JSON.JsonParser->New("{\"x\":1}");
		if(parser->Parse()) {
		  x := parser->GetRoot()->Get("x");   # Nil for a missing member
		  if(x <> Nil) {
		    x->GetInt()->PrintLine();  # 1
		  };
		};
		```
		~#
		method : public : GetRoot() ~ JsonElement {
			return @root;
		}

		method : ParseValue() ~ JsonElement {
			element : JsonElement;

			select(@cur_token->GetType()) {
				label Token->Type->OBR: {
# "array"->PrintLine();
					element := ParseArray();
				}

				label Token->Type->OCBR: {
# "object"->PrintLine();
					element := ParseObject();
				}

				label Token->Type->IDENT: {
					element := JsonElement->New(@cur_token->GetValue());
# Console->Print("string=")->PrintLine(@cur_token->GetValue());
					NextToken();

				}

				label Token->Type->INT_NUM:
				label Token->Type->FLOAT_NUM: {
					element := JsonElement->New(JsonType->NUMBER, @cur_token->GetValue());
# Console->Print("number=")->PrintLine(@cur_token->GetValue());
					NextToken();
				}

				label Token->Type->TRUE: {
					element := JsonElement->New(JsonType->TRUE);
# "true"->PrintLine();
					NextToken();
				}

				label Token->Type->FALSE: {
					element := JsonElement->New(JsonType->FALSE);
# "false"->PrintLine();
					NextToken();
				}

				label Token->Type->NULL: {
					element := JsonElement->New(JsonType->NULL);
# "null"->PrintLine();
					NextToken();
				}

				other: {
					@error_msg := TokenError("*** Unexpected value *** ");
# @cur_token->GetType()->As(Int)->PrintLine();
					return Nil;
				}
			};

			return element;
		}

		method : ParseObject() ~ JsonElement {
			@depth += 1;
			if(@depth > @max_depth) {
				@error_msg := "*** Maximum nesting depth exceeded ***";
				@depth -= 1;
				return Nil;
			};
			elements := Map->New()<String, JsonElement>;

			NextToken();
			while(@cur_token->GetType() <> Token->Type->EOS &
				@cur_token->GetType() <> Token->Type->CCBR) {

				# parse name
				elem_name : Token;
				if(Match(Token->Type->IDENT) = false) {
					@error_msg := TokenError("*** Expected identifier *** ");
# @cur_token->GetType()->As(Int)->PrintLine();
					@depth -= 1;
					return Nil;
				};
				elem_name := @cur_token;
				NextToken();

				if(Match(Token->Type->COLON) = false) {
					@error_msg := "*** Expected ':' *** ";
# @cur_token->GetType()->As(Int)->PrintLine();
					@depth -= 1;
					return Nil;
				};
				NextToken();

				# parse value
				value := ParseValue();
				if(value = Nil) {
					@depth -= 1;
					return Nil;
				};
# IO.Console->Print("insert=")->PrintLine(elem_name->GetValue());
				elements->Insert(elem_name->GetValue(), value);

				# update
				if(Match(Token->Type->COMMA)) {
					NextToken();
# "comma"->PrintLine();
				};
			};

			if(Match(Token->Type->CCBR) = false) {
				@error_msg := "*** Expected '}' *** ";
# @cur_token->GetType()->As(Int)->PrintLine();
				@depth -= 1;
				return Nil;
			};
			NextToken();

			@depth -= 1;
			return JsonElement->New(elements);
		}

		method : ParseArray() ~ JsonElement {
			@depth += 1;
			if(@depth > @max_depth) {
				@error_msg := "*** Maximum nesting depth exceeded ***";
				@depth -= 1;
				return Nil;
			};
			elements := Vector->New()<JsonElement>;

			NextToken();
			while(@cur_token->GetType() <> Token->Type->EOS &
				@cur_token->GetType() <> Token->Type->CBR) {
				value := ParseValue();
				if(value = Nil) {
					@depth -= 1;
					return Nil;
				};
				elements->AddBack(value);

				# update
				if(Match(Token->Type->COMMA)) {
					NextToken();
# "comma"->PrintLine();
				};
			};

			if(Match(Token->Type->CBR) = false) {
				@error_msg := "*** Expected ']' *** ";
# @cur_token->GetType()->As(Int)->PrintLine();
				@depth -= 1;
				return Nil;
			};
			NextToken();

			@depth -= 1;
			return JsonElement->New(elements);
		}

		# a string the scanner refused carries its own message
		method : TokenError(message : String) ~ String {
			if(@cur_token->GetType() = Token->Type->OTHER & @cur_token->GetValue() <> Nil) {
				return @cur_token->GetValue();
			};

			return message;
		}

		method : Match(token : Token->Type) ~ Bool {
			return @cur_token->GetType() = token;
		}

		method : AddToken(token : Token) ~ Nil {
	 		if(@token_write_pos < @tokens_max) {
	 			@tokens[@token_write_pos++] := token;
	 		};
	 	}

	 	method : NextToken() ~ Nil {
	 		if(@cur_token = Nil | @token_read_pos >= @tokens_max) {
				Scan();
	 		}
	 		else {
	 			@cur_token := @tokens[@token_read_pos++];
	 		};
		}

		method : native : Scan() ~ Nil {
			# The digit and letter tests are written out rather than asked of Char->IsDigit
			# and Char->IsChar: they are the same comparisons, and a call from compiled code
			# costs about 130 instructions, several times per character of a number.
			if(@input <> Nil) {


				# TODO: add-in line numbers

				@token_read_pos := @token_write_pos := 0;

				while(@token_write_pos < @tokens_max) {
					if(@input_index < @input->Size()) {
						# skip whitespace
						if(@input_index < @input->Size()) {
							char := @input[@input_index];
							while(@input_index < @input->Size() & (char = '\r' | char = '\n' | char = '\t' | char = ' ' | char = '\f' | char = '\v')) {
								char := @input[++@input_index];
							};
						};
						# comment
						if(@input_index + 1 < @input->Size() & @input[@input_index] = '/' & @input[@input_index + 1] = '/') {
							@input_index += 2;
							while(@input_index < @input->Size() & (@input[@input_index] <> '\r' & @input[@input_index] <> '\n')) {
								# update
								@input_index += 1;
							};
						}
						# token
						else {
							# parse string
							if(@input_index < @input->Size() & (@input[@input_index] = '"' | ((@input[@input_index] >= 'a' & @input[@input_index] <= 'z') | (@input[@input_index] >= 'A' & @input[@input_index] <= 'Z')))) {
								len : Int; offset : Int; quoted := false;
								if(@input[@input_index] = '"') {
									# A string token carries the DECODED text (RFC 8259 section 7):
									# escapes become the characters they stand for, so GetValue()
									# and GetString() return the real text. The scanner used to keep
									# the escapes as written and the serializer escaped them again,
									# so a parse/serialize round trip doubled every escape.
									quoted := true;
									string_start := @input_index;
									@input_index += 1;
									offset := @input_index;
									size := @input->Size();
									# assigned, not just declared: a local declared in a loop
									# body keeps the value of the previous pass
									decoded : String;
									decoded := Nil;
									error : String;
									error := Nil;
									end := false;
									while(@input_index < size & <>end & error = Nil) {
										c := @input[@input_index];
										if(c = '"') {
											# done
											end := true;
										}
										else if(c = '\\') {
											# the first escape switches to a buffer; text with none is
											# copied in one piece below
											decoded := decoded ?? String->New();
											if(@input_index > offset) {
												decoded->Append(@input, offset, @input_index - offset);
											};
											error := DecodeEscape(decoded);
											offset := @input_index;
										}
										else {
											# update
											@input_index += 1;
										};
									};

									if(error = Nil & <>end) {
										error := "*** Unterminated string starting at offset {$string_start} ***";
									};

									if(error <> Nil) {
										# the error travels in the token, so it is reported when
										# the parser reaches it rather than when it is scanned
										AddToken(Token->New(Token->Type->OTHER, error));
										@input_index := size;
									}
									else {
										if(decoded <> Nil) {
											if(@input_index > offset) {
												decoded->Append(@input, offset, @input_index - offset);
											};
											AddToken(Token->New(Token->Type->IDENT, decoded));
										}
										else if(@input_index > offset) {
											AddToken(Token->New(Token->Type->IDENT, String->New(@input, offset, @input_index - offset)));
										}
										else {
											AddToken(Token->New(Token->Type->IDENT, ""));
										};
										# past the closing quote
										@input_index += 1;
									};
								}
								else {
									offset := @input_index;
									while(@input_index < @input->Size() & (((@input[@input_index] >= 'a' & @input[@input_index] <= 'z') | (@input[@input_index] >= 'A' & @input[@input_index] <= 'Z')) | @input[@input_index] = '_')) {
										# update
										@input_index += 1;
									};
									len := @input_index - offset;

									if(len = 4 & offset + 3 < @input->Size() & @input[offset] = 't' & @input[offset + 1] = 'r' & @input[offset + 2] = 'u' & @input[offset + 3] = 'e') {
										if(@true_token = Nil) {
											@true_token := Token->New(Token->Type->TRUE);
										};
										AddToken(@true_token);
									}
									else if(len = 5 & offset + 4 < @input->Size() & @input[offset] = 'f' & @input[offset + 1] = 'a' & @input[offset + 2] = 'l' & @input[offset + 3] = 's' & @input[offset + 4] = 'e') {
										if(@false_token = Nil) {
											@false_token := Token->New(Token->Type->FALSE);
										};
										AddToken(@false_token);
									}
									else if(len = 4 & offset + 3 < @input->Size() & @input[offset] = 'n' & @input[offset + 1] = 'u' & @input[offset + 2] = 'l' & @input[offset + 3] = 'l') {
										if(@null_token = Nil) {
											@null_token := Token->New(Token->Type->NULL);
										};
										AddToken(@null_token);
									}
									else if(len > 0) {
										AddToken(Token->New(Token->Type->IDENT, String->New(@input, offset, len)));
									}
									else {
										AddToken(Token->New(Token->Type->IDENT, ""));
									};
								};
							}
							# parse number
							else if(@input_index < @input->Size() & ((@input[@input_index] >= '0' & @input[@input_index] <= '9') | @input[@input_index] = '-' | @input[@input_index] = '.')) {
								# RFC 8259: -? (0 | [1-9][0-9]*) (. [0-9]+)? ([eE] [+-]? [0-9]+)?
								# This used to count '-' and '.' over a run of digits/-/./e/E, so
								# "-1.5e-3" (two minus signs) failed the whole document, "2.5E+2"
								# stopped at the '+', and "1-2" or "01" were accepted.
								offset := @input_index;
								size := @input->Size();
								is_valid := true;
								is_float := false;

								# sign
								if(@input[@input_index] = '-') {
									@input_index += 1;
								};

								# integer part: a lone zero, or no leading zero
								if(@input_index < size & @input[@input_index] = '0') {
									@input_index += 1;
								}
								else if(@input_index < size & (@input[@input_index] >= '0' & @input[@input_index] <= '9')) {
									while(@input_index < size & (@input[@input_index] >= '0' & @input[@input_index] <= '9')) {
										@input_index += 1;
									};
								}
								else {
									is_valid := false;
								};

								# fraction: at least one digit after the '.'
								if(is_valid & @input_index < size & @input[@input_index] = '.') {
									is_float := true;
									@input_index += 1;
									if(@input_index < size & (@input[@input_index] >= '0' & @input[@input_index] <= '9')) {
										while(@input_index < size & (@input[@input_index] >= '0' & @input[@input_index] <= '9')) {
											@input_index += 1;
										};
									}
									else {
										is_valid := false;
									};
								};

								# exponent: e|E, optional sign, at least one digit
								if(is_valid & @input_index < size & (@input[@input_index] = 'e' | @input[@input_index] = 'E')) {
									is_float := true;
									@input_index += 1;
									if(@input_index < size & (@input[@input_index] = '+' | @input[@input_index] = '-')) {
										@input_index += 1;
									};
									if(@input_index < size & (@input[@input_index] >= '0' & @input[@input_index] <= '9')) {
										while(@input_index < size & (@input[@input_index] >= '0' & @input[@input_index] <= '9')) {
											@input_index += 1;
										};
									}
									else {
										is_valid := false;
									};
								};

								# anything number-like left over ("01", "1-2", "1.2.3") makes the
								# whole run one bad token rather than two good ones
								while(@input_index < size & ((@input[@input_index] >= '0' & @input[@input_index] <= '9') | @input[@input_index] = '-' | @input[@input_index] = '+' |
										@input[@input_index] = '.' | @input[@input_index] = 'e' | @input[@input_index] = 'E')) {
									is_valid := false;
									@input_index += 1;
								};

								string := String->New(@input, offset, @input_index - offset);
								if(<>is_valid) {
									AddToken(Token->New(Token->Type->BAD_NUM, string));
								}
								else if(is_float) {
									AddToken(Token->New(Token->Type->FLOAT_NUM, string));
								}
								else {
									AddToken(Token->New(Token->Type->INT_NUM, string));
								};
							}
							# parse character
							else if(@input_index < @input->Size()) {
								select(@input[@input_index]) {
									label '[': {
										if(@obr_token = Nil) {
											@obr_token := Token->New(Token->Type->OBR);
										};
										AddToken(@obr_token);
									}

									label ']': {
										if(@cbr_token = Nil) {
											@cbr_token := Token->New(Token->Type->CBR);
										};
										AddToken(@cbr_token);
									}

									label '{': {
										if(@ocbr_token = Nil) {
											@ocbr_token := Token->New(Token->Type->OCBR);
										};
										AddToken(@ocbr_token);
									}

									label '}': {
										if(@ccbr_token = Nil) {
											@ccbr_token := Token->New(Token->Type->CCBR);
										};
										AddToken(@ccbr_token);
									}

									label ',': {
										if(@comma_token = Nil) {
											@comma_token := Token->New(Token->Type->COMMA);
										};
										AddToken(@comma_token);
									}

									label ':': {
										if(@colon_token = Nil) {
											@colon_token := Token->New(Token->Type->COLON);
										};
										AddToken(@colon_token);
									}

									other: {
										if(@other_token = Nil) {
											@other_token := Token->New(Token->Type->OTHER);
										};
										AddToken(@other_token);
									}
								};
								# update
								@input_index += 1;
							};
						};
					}
					else {
						# past the end of the input: the rest of the buffer
						if(@other_token = Nil) {
							@other_token := Token->New(Token->Type->OTHER);
						};
						AddToken(@other_token);
					};
				};

				@cur_token := @tokens[@token_read_pos++];
			};
	 	}

		#
		# Decodes the escape at @input_index (a backslash) into 'buffer' and moves
		# past it. Returns Nil, or the error for an escape RFC 8259 does not allow
		# ('\x', a '\u' without four hex digits, a backslash at the end of the text).
		#
		# A '\u' high surrogate followed by a '\u' low surrogate is one character
		# outside the BMP. An unpaired surrogate becomes U+FFFD, as a UTF-8 decoder
		# does with a broken sequence: RFC 8259 leaves it undefined, and refusing it
		# would lose a whole response over one damaged character (model output cut
		# mid-character is the common source).
		#
		method : native : DecodeEscape(buffer : String) ~ String {
			start := @input_index;
			size := @input->Size();
			if(start + 1 >= size) {
				return "*** Unterminated escape at offset {$start} ***";
			};

			c := @input[start + 1];
			@input_index := start + 2;
			select(c) {
				label '"': {
					buffer->Append('"');
				}

				label '\\': {
					buffer->Append('\\');
				}

				label '/': {
					buffer->Append('/');
				}

				label 'b': {
					buffer->Append(0x08->As(Char));
				}

				label 'f': {
					buffer->Append(0x0C->As(Char));
				}

				label 'n': {
					buffer->Append('\n');
				}

				label 'r': {
					buffer->Append('\r');
				}

				label 't': {
					buffer->Append('\t');
				}

				label 'u': {
					code := ReadHex4(start + 2);
					if(code < 0) {
						return "*** Invalid \\u escape at offset {$start}: four hex digits expected ***";
					};
					@input_index := start + 6;

					if(code >= 0xD800 & code <= 0xDBFF) {
						low := -1;
						if(@input_index + 1 < size & @input[@input_index] = '\\' & @input[@input_index + 1] = 'u') {
							low := ReadHex4(@input_index + 2);
						};

						if(low >= 0xDC00 & low <= 0xDFFF) {
							buffer->Append((0x10000 + ((code - 0xD800) << 10) + (low - 0xDC00))->As(Char));
							@input_index += 6;
						}
						else {
							# the next escape, if any, is decoded on its own
							buffer->Append(0xFFFD->As(Char));
						};
					}
					else if(code >= 0xDC00 & code <= 0xDFFF) {
						buffer->Append(0xFFFD->As(Char));
					}
					else {
						buffer->Append(code->As(Char));
					};
				}

				other: {
					return "*** Invalid escape '\\{$c}' at offset {$start} ***";
				}
			};

			return Nil;
		}

		# the value of the four hex digits at 'index', or -1
		method : native : ReadHex4(index : Int) ~ Int {
			if(index + 4 > @input->Size()) {
				return -1;
			};

			value := 0;
			for(i := index; i < index + 4; i += 1;) {
				c := @input[i]->As(Int);
				digit : Int;
				if(c >= 0x30 & c <= 0x39) {
					# 0-9
					digit := c - 0x30;
				}
				else if(c >= 0x61 & c <= 0x66) {
					# a-f
					digit := c - 0x61 + 10;
				}
				else if(c >= 0x41 & c <= 0x46) {
					# A-F
					digit := c - 0x41 + 10;
				}
				else {
					return -1;
				};
				value := (value << 4) + digit;
			};

			return value;
		}

		method : DumpTokens(tokens : Vector<Token>) ~ Nil {
			if(tokens->Size() > 0) {
				each(i : tokens) {
					select(tokens->Get(i)->As(Token)->GetType()) {
						label Token->Type->IDENT: {
							IO.Console->Print("token=IDENT, value=")->PrintLine(tokens->Get(i)->As(Token)->GetValue());
						}

						label Token->Type->INT_NUM: {
							IO.Console->Print("token=INTEGER, value=")->PrintLine(tokens->Get(i)->As(Token)->GetValue());
						}

						label Token->Type->FLOAT_NUM: {
							IO.Console->Print("token=FLOAT, value=")->PrintLine(tokens->Get(i)->As(Token)->GetValue());
						}

						label Token->Type->OBR: {
							"token='['"->PrintLine();
						}

						label Token->Type->CBR: {
							"token=']'"->PrintLine();
						}

						label Token->Type->OCBR: {
							"token='{'"->PrintLine();
						}

						label Token->Type->CCBR: {
							"token='}'"->PrintLine();
						}

						label Token->Type->PREN: {
							"token='''"->PrintLine();
						}

						label Token->Type->COLON: {
							"token=':'"->PrintLine();
						}

						label Token->Type->COMMA: {
							"token=','"->PrintLine();
						}

						label Token->Type->OTHER:
						label Token->Type->BAD_NUM: {
							"token=OTHER"->PrintLine();
						}
					};
				};
			};
		}
	}

	#~
	JSON value element

```
json := JsonParser->TextToElement("{\"name\": \"John\", \"age\": 30}");
if(json <> Nil) {
  name := json->Get("name");   # Nil for a missing member
  if(name <> Nil) {
    name->GetString()->PrintLine();
  };

  age := json->Get("age");
  if(age <> Nil) {
    age->GetInt()->PrintLine();
  };
};

# create JSON programmatically
obj := JsonElement->New(JsonElement->JsonType->OBJECT);
obj->Insert("city", "Oakland");
obj->Insert("zip", 94612);
obj->ToString()->PrintLine();
```
	~#
	class JsonElement {
		@type : JsonType;
		@value : String;
		@array_elems : Vector<JsonElement>;
		@map_elems : Map<String, JsonElement>;

		#~
		JSON element type
		@class JsonElement
		~#
		enum JsonType {
			STRING,
			NUMBER,
			TRUE,
			FALSE,
			NULL,
			ARRAY,
			OBJECT,
			OTHER
		}

		#~
		Constructor
		@param type Json element type
		~#
		New(type : JsonElement->JsonType) {
			select(type) {
				# the text of a true, false or null element is made when it is first
				# asked for (LiteralValue): most never are
				label JsonElement->JsonType->TRUE {
					@type := type;
				}

				label JsonElement->JsonType->FALSE {
					@type := type;
				}

				label JsonElement->JsonType->NULL {
					@type := type;
				}

				label JsonElement->JsonType->OBJECT {
					@type := type;
					@map_elems := Map->New()<String, JsonElement>;
				}

				label JsonElement->JsonType->ARRAY {
					@type := type;
					@array_elems := Vector->New()<JsonElement>;
				}

				other {
					@type := JsonElement->JsonType->OTHER;
				}
			};
		}

		#~
		Constructor
		@param type Json element type
		@param value Json string value
		~#
		New(type : JsonElement->JsonType, value : String) {
			# a Nil value is JSON's null: as a STRING or NUMBER with no text it was
			# written as nothing at all ({"name":}), which no parser reads back
			if(value = Nil & (type = JsonElement->JsonType->STRING | type = JsonElement->JsonType->NUMBER)) {
				@type := JsonElement->JsonType->NULL;
				@value := "";
			}
			else if(type = JsonElement->JsonType->STRING | type = JsonElement->JsonType->NUMBER) {
				@type := type;
				@value := value;
			}
			else {
				@type := JsonElement->JsonType->OTHER;
			};
		}

		#~
		Constructor
		@param value Json string value
		~#
		New(value : String) {
			# a Nil String is JSON's null (see the constructor above)
			if(value = Nil) {
				@type := JsonElement->JsonType->NULL;
				@value := "";
			}
			else {
				@type := JsonElement->JsonType->STRING;
				@value := value;
			};
		}

		#~
		Constructor
		@param value Json integer value
		~#
		New(value : Int) {
			@type := JsonElement->JsonType->NUMBER;
			@value := value->ToString();
		}

		#~
		Constructor
		@param value Json float value; written as the shortest text that reads back
		as the same value ("1.2e-05", "0.1", "3.0"), not ToString's six decimals,
		which wrote 1.2e-05 as 0.000012 and 1e-07 as 0.000000
		~#
		New(value : Float) {
			@type := JsonElement->JsonType->NUMBER;
			@value := value->ToShortString();
		}

		#~
		Constructor
		@param array_elems Json array value
		~#
		New(array_elems : Vector<JsonElement>) {
			@type := JsonElement->JsonType->ARRAY;
			@array_elems := array_elems;
		}

		#~
		Constructor
		@param map_elems Json object (names/values)
		~#
		New(map_elems : Map<String, JsonElement>) {
			@type := JsonElement->JsonType->OBJECT;
			@map_elems := map_elems;
		}

		#~
		Gets the type
		@return type

		```
		elem := Data.JSON.JsonParser->TextToElement("42");
		if(elem->GetType() = Data.JSON.JsonElement->JsonType->NUMBER) {
		  "Is number"->PrintLine();
		};
		```
		~#
		method : public : GetType() ~ JsonElement->JsonType {
			return @type;
		}

		#~
		Checks for 'null' JSON value
		@return true if 'null', false otherwise

		```
		elem := Data.JSON.JsonParser->TextToElement("null");
		if(elem->IsNull()) {
		  "Null value"->PrintLine();
		};
		```
		~#
		method : public : IsNull() ~ Bool {
			return @type = JsonType->NULL;
		}

		#~
		Checks for 'null' JSON value
		@param elem element to check
		@return true if 'null', false otherwise
		~#
		function : public : IsNull(elem : JsonElement) ~ Bool {
			if(elem = Nil | elem->GetType() = JsonType->NULL) {
				return true;
			};

			return false;
		}

		#~
		Gets the string value, decoded (see GetString)
		@return string value

		```
		elem := Data.JSON.JsonParser->TextToElement("\"hello\"");
		elem->GetValue()->PrintLine();  # hello
		```
		~#
		method : public : GetValue() ~ String {
			return GetString();
		}

		#~
		Gets the string value. A parsed string is already decoded: its escapes are the
		characters they stand for, so do not decode it again.
		@return string value

		```
		root := Data.JSON.JsonParser->TextToElement("{\"city\":\"Oakland\"}");
		city := root->Get("city");   # Nil for a missing member
		if(city <> Nil) {
		  city->GetString()->PrintLine();  # Oakland
		};
		```
		~#
		method : public : GetString() ~ String {
			if(@value = Nil) {
				LiteralValue();
			};

			if(@value <> Nil) {
				return @value;
			};

			return "";
		}

		#
		# Gives a true, false or null element its text ("true", "false", ""), once.
		# The constructor used to make it for every such element; a string literal
		# costs about 3,000 instructions and few of these are ever read as text.
		#
		method : LiteralValue() ~ Nil {
			if(@type = JsonType->TRUE) {
				@value := "true";
			}
			else if(@type = JsonType->FALSE) {
				@value := "false";
			}
			else if(@type = JsonType->NULL) {
				@value := "";
			};
		}

		#~
		Gets the integer value. A number written with a fraction or an exponent (2.5, 1e5) is truncated toward zero,
		from its digits as written and not through a Float: 9007199254740993.0 is 9007199254740993 and 1.9 is 1.
		A value that does not fit a 64-bit integer (1e19, 1e400) is 0, as it is for a number written without them.
		@return integer value

		```
		root := Data.JSON.JsonParser->TextToElement("{\"port\":8080}");
		port := root->Get("port");   # Nil for a missing member
		if(port <> Nil) {
		  port->GetInt()->PrintLine();  # 8080
		};
		```
		~#
		method : public : GetInt() ~ Int {
			if(@value = Nil) {
				LiteralValue();
			};

			if(@value <> Nil) {
				# a number written with a fraction or an exponent ("1e5", "2.5E+2")
				# is truncated toward zero; ToInt() stopped at the 'e' and gave 1
				# for 1e5. The digits are shifted by the exponent and read as an
				# integer: through a Float, as this was, an integer past 2^53 came
				# back rounded (9007199254740993.0 as ...992) and one past 2^63 as
				# whatever the processor's conversion leaves. Text that is not a
				# JSON number (an element built by hand) keeps the float parse.
				if(@type = JsonType->NUMBER & (@value->Has('.') | @value->Has('e') | @value->Has('E'))) {
					exact := Int->New[1];
					if(TruncateNumber(@value, exact)) {
						return exact[0];
					};
					return @value->ToFloat()->As(Int);
				};
				return @value->ToInt();
			};

			return 0;
		}

		# Truncates a number spelled -?digits(.digits)?([eE][+-]?digits)? toward zero without
		# leaving integer arithmetic. The result goes in result[0]; it is 0 when the value does
		# not fit 64 bits, which is what String->ToInt() answers for an integer spelling. False,
		# and nothing stored, when the text is not such a number.
		function : TruncateNumber(text : String, result : Int[]) ~ Bool {
			chars := text->ToCharArray();
			size := chars->Size();
			i := 0;

			negative := false;
			if(i < size) {
				if(chars[i] = '-') {
					negative := true;
					i += 1;
				};
			};

			# the digits of the integer part and of the fraction, in order; 'point' is how many
			# of them stand before the decimal point
			digits := Char->New[size + 1];
			count := 0;
			start := i;
			while(IsDigit(chars, i)) {
				digits[count] := chars[i];
				count += 1;
				i += 1;
			};
			if(i = start) {
				return false;
			};
			point := count;

			if(i < size) {
				if(chars[i] = '.') {
					i += 1;
					start := i;
					while(IsDigit(chars, i)) {
						digits[count] := chars[i];
						count += 1;
						i += 1;
					};
					if(i = start) {
						return false;
					};
				};
			};

			# The exponent, held to a size that cannot overflow. It moves the point across at
			# most 'count' digits, and the result has at most 19, so once it is larger than
			# count + 20 its exact size no longer matters: a positive one puts more than 19
			# digits before the point (does not fit) and a negative one puts none (zero).
			# The bound has to come from the number's own length. It was a fixed 1000000,
			# and a fraction longer than that can take back a larger exponent: 0. followed
			# by 9999999 zeros and 1e10000000 is exactly 1, and read as 0 with the
			# exponent's last digit dropped.
			exponent_limit := count + 20;
			exponent := 0;
			if(i < size) {
				if(chars[i] = 'e' | chars[i] = 'E') {
					i += 1;
					exponent_negative := false;
					if(i < size) {
						if(chars[i] = '+' | chars[i] = '-') {
							exponent_negative := chars[i] = '-';
							i += 1;
						};
					};
					start := i;
					while(IsDigit(chars, i)) {
						if(exponent <= exponent_limit) {
							exponent := exponent * 10 + (chars[i] - '0');
						};
						i += 1;
					};
					if(i = start) {
						return false;
					};
					if(exponent_negative) {
						exponent := exponent * -1;
					};
				};
			};

			if(i <> size) {
				return false;
			};

			# leading zeros carry no value: 0e99999 and 0.000 are zero whatever the exponent
			first := 0;
			while(first < count & digits[first] = '0') {
				first += 1;
			};
			result[0] := 0;
			if(first = count) {
				return true;
			};

			# how many digits, from the first one that is not zero, stand before the point once
			# the exponent has moved it; digits past the ones written are zeros
			whole := point + exponent - first;
			if(whole <= 0 | whole > 19) {
				return true;
			};

			# built as a negative number, whose range is one wider than the positive one
			lowest := -9223372036854775807 - 1;
			value := 0;
			for(k := 0; k < whole; k += 1;) {
				digit := 0;
				if(first + k < count) {
					digit := digits[first + k] - '0';
				};
				if(value < -922337203685477580) {
					return true;
				};
				value := value * 10;
				if(value < lowest + digit) {
					return true;
				};
				value -= digit;
			};

			if(negative) {
				result[0] := value;
			}
			else if(value <> lowest) {
				result[0] := value * -1;
			};

			return true;
		}

		# true if there is a character at 'i' and it is a decimal digit
		function : IsDigit(chars : Char[], i : Int) ~ Bool {
			if(i >= chars->Size()) {
				return false;
			};
			return chars[i] >= '0' & chars[i] <= '9';
		}

		#~
		Gets the float value
		@return float value

		```
		root := Data.JSON.JsonParser->TextToElement("{\"pi\":3.14}");
		pi := root->Get("pi");   # Nil for a missing member
		if(pi <> Nil) {
		  pi->GetFloat()->PrintLine();  # 3.14
		};
		```
		~#
		method : public : GetFloat() ~ Float {
			if(@value = Nil) {
				LiteralValue();
			};

			if(@value <> Nil) {
				return @value->ToFloat();
			};

			return 0.0;
		}

		#~
		Gets the float value
		@return float value

		```
		root := Data.JSON.JsonParser->TextToElement("{\"active\":true}");
		active := root->Get("active");   # Nil for a missing member
		if(active <> Nil) {
		  active->GetBool()->PrintLine();  # true
		};
		```
		~#
		method : public : GetBool() ~ Bool {
			if(@value = Nil) {
				LiteralValue();
			};

			if(@value <> Nil) {
				return @value->ToBool();
			};

			return false;
		}

		#~
		Gets an indexed value from an array type
		@param index index
		@return indexed value

		```
