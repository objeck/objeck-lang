		#~
		Sorts the values in the vector

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(3)); v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2));
v->Sort();
v->Get(0)->PrintLine(); # 1
```
		~#
		method : public : native : Sort() ~ Nil {
			if(@size < 2) {
				return;
			};

			a : H[] := @values;
			b : H[] := H->New[@size];
			MergeSort(0, @size - 1, a, b);
		}

		#~
		Sorts the values in place with a comparator. The sort is stable: values the comparator calls equal keep their order.
		@param compare comparator: negative if the first value goes first, 0 if equal, positive if the second goes first

```
v := Collection.CompareVector->New()<String>;
v->AddBack("pear"); v->AddBack("fig"); v->AddBack("banana");
v->Sort(\(a, b) => a->Size() - b->Size());
v->Get(0)->PrintLine(); # fig
```
		~#
		method : public : Sort(compare : (H, H) ~ Int) ~ Nil {
			if(@size < 2) {
				return;
			};

			b : H[] := H->New[@size];
			SortWith(0, @size - 1, @values, b, compare);
		}

		method : SortWith(low : Int, hi : Int, a : H[], b : H[], compare : (H, H) ~ Int) ~ Nil {
			if(low < hi) {
				if(hi - low < 16) {
					for(i := low + 1; i <= hi; i += 1;) {
						value := a[i];
						j := i - 1;
						while(j >= low & compare(a[j], value) > 0) {
							a[j + 1] := a[j];
							j -= 1;
						};
						a[j + 1] := value;
					};
					return;
				};

				mid := (low + hi) >> 1;
				SortWith(low, mid, a, b, compare);
				SortWith(mid + 1, hi, a, b, compare);
				MergeWith(low, mid, hi, a, b, compare);
			};
		}

		method : MergeWith(low : Int, mid : Int, hi : Int, a : H[], b : H[], compare : (H, H) ~ Int) ~ Nil {
			for(i := low; i <= hi; i += 1;) {
				b[i] := a[i];
			};

			i := low;
			j := mid + 1;
			k := low;
			while(i <= mid & j <= hi) {
				# <= keeps equal values in their original order
				if(compare(b[i], b[j]) <= 0) {
					a[k] := b[i];
					i += 1;
				}
				else {
					a[k] := b[j];
					j += 1;
				};
				k += 1;
			};

			# the rest of the second half is already in place
			while(i <= mid) {
				a[k] := b[i];
				k += 1;
				i += 1;
			};
		}
		
		method : MergeSort(low : Int, hi : Int, a : H[], b : H[]) ~ Nil {
			if(low < hi) {
				if(hi - low < 16) {
					InsertionSort(low, hi, a);
					return;
				};

				mid := (low + hi) >> 1;
				MergeSort(low, mid, a, b);
				MergeSort(mid + 1, hi, a, b);
				Merge(low, mid, hi, a, b);
			};	
		}

		method : InsertionSort(low : Int, hi : Int, a : H[]) ~ Nil {
			for(i := low + 1; i <= hi; i += 1;) {
				value := a[i];
				j := i - 1;
				while(j >= low & a[j]->Compare(value) > 0) {
					a[j + 1] := a[j];
					j -= 1;
				};
				a[j + 1] := value;
			};
		}
		
		method : native : Merge(low : Int, mid : Int, hi : Int, a : H[], b : H[]) ~ Nil {
			# copy both halves of a to auxiliary array b
			for(i := low; i <= hi; i += 1;) {
				b[i] := a[i];
			};

			i := low;
			j := mid + 1;
			k := low;

			# copy back next-greatest element at each time
			while(i <= mid & j <= hi) {
				# cache comparison result to avoid calling Compare() twice
				cmp := b[i]->Compare(b[j]);
				if(cmp <= 0) {
					a[k] := b[i];
					k += 1;
					i += 1;
				}
				else {
					a[k] := b[j];
					k += 1;
					j += 1;
				};
			};

			# copy back remaining elements of first half (if any)
			while(i <= mid) {
				a[k] := b[i];
				k += 1;
				i += 1;
			};
		}

		#~
		Finds a given value in the vector via linear search
		@param value value to search for
		@return index of found value, -1 if not found

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(10)); v->AddBack(IntRef->New(20));
v->Find(IntRef->New(20))->PrintLine();  # 1
v->Find(IntRef->New(99))->PrintLine();  # -1
```
		~#
		method : public : Find(value : H) ~ Int {
         for(i := 0; i < @size; i += 1;) {
            if(@values[i]->Compare(value) = 0) {
               return i;
            };
         };

         return -1;
      }
		
		#~
		Performs a binary search O(log n)
		@param value value to search for
		@return index of found value, -1 if not found

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(3)); v->AddBack(IntRef->New(5));
v->Sort();
v->BinarySearch(IntRef->New(3))->PrintLine(); # 1
```
		~#
		method : public : native : BinarySearch(value : H) ~ Int {
			low := 0;
			high := @size - 1;

			while(low <= high) {
				mid := (low + high) >> 1;
      	
				cmp := @values[mid]->Compare(value);
				if(cmp > 0) {
					high := mid - 1;
				}
				else if(cmp < 0) {
					low := mid + 1;
				}
				else {
					return mid;
				};
			};

			return -1;
		}
		
		#~
		Check of the given value is in the vector
		@param value value to check for
		@return true if found, false otherwise

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(5)); v->AddBack(IntRef->New(10));
v->Has(IntRef->New(5))->PrintLine();  # true
v->Has(IntRef->New(99))->PrintLine(); # false
```
		~#
		method : public : Has(value : H) ~ Bool {
			for(i : Int := 0; i < @size; i += 1;) {
				if(@values[i]->Compare(value) = 0) {
					return true;
				};
			};
			
			return false;
		}
		
		#~
		Uses the given function to filter out values
		@param f function to use a filter. If the function evaluates to true the value is added to the collection.
		@return filtered vector

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2)); v->AddBack(IntRef->New(3));
evens := v->Filter(\(IntRef) ~ Bool : (x) => x->Get() % 2 = 0)<IntRef>;
evens->Size()->PrintLine(); # 1
```
		~#
		method : public : Filter(f : (H) ~ Bool) ~ CompareVector<H> {
			filtered := CompareVector->New()<H>;
			filtered->Reserve(@size);
			
			for(i : Int := 0; i < @size; i += 1;) {
				if(f(@values[i])) {
					filtered->AddBack(@values[i]);
				};
			};
			
			return filtered;
		}

		#~
		Uses the given function to reduce the values
		@param a initial value (i.e. accumulator)
		@param f function to use a reduce
		@return reduced vector

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2)); v->AddBack(IntRef->New(3));
sum := v->Reduce(IntRef->New(0), \(IntRef, IntRef) ~ IntRef : (a, b) => IntRef->New(a->Get() + b->Get()));
sum->PrintLine(); # 6
```
		~#
		method : public : Reduce(a : H, f : (H, H) ~ H) ~ H {
			for(i : Int := 0; i < @size; i += 1;) {
				a := f(a, @values[i]);
			};

			return a;
		}

		#~
		Converts the vector into an object array
		@return object array

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(7)); v->AddBack(IntRef->New(8));
arr := v->ToArray()<IntRef>;
arr[0]->PrintLine(); # 7
arr[1]->PrintLine(); # 8
```
		~#
		method : public : ToArray() ~ H[] {
			array : H[] := H->New[@size];
			Runtime->Copy(array, 0, @values, 0, @size);
			return array;
		}

		#~
		Returns a new vector with duplicate elements removed
		@return vector with unique elements only

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2)); v->AddBack(IntRef->New(1));
unique := v->Distinct()<IntRef>;
unique->Size()->PrintLine(); # 2
```
		~#
		method : public : Distinct() ~ CompareVector<H> {
			result := CompareVector->New()<H>;
			result->Reserve(@size);
			seen := Hash->New()<H, BoolRef>;

			for(i := 0; i < @size; i += 1;) {
				value := @values[i];
				if(value <> Nil & <>seen->Has(value)) {
					seen->Insert(value, true);
					result->AddBack(value);
				};
			};

			return result;
		}

		#~
		Checks if any element matches the predicate
		@param f predicate function
		@return true if any element matches, false otherwise

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(4)); v->AddBack(IntRef->New(9));
v->Any(\(IntRef) ~ Bool : (x) => x->Get() > 5)->PrintLine(); # true
v->Any(\(IntRef) ~ Bool : (x) => x->Get() > 10)->PrintLine(); # false
```
		~#
		method : public : Any(f : (H) ~ Bool) ~ Bool {
			for(i := 0; i < @size; i += 1;) {
				if(f(@values[i])) {
					return true;
				};
			};
			return false;
		}

		#~
		Checks if all elements match the predicate
		@param f predicate function
		@return true if all elements match, false otherwise

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(2)); v->AddBack(IntRef->New(4)); v->AddBack(IntRef->New(6));
v->All(\(IntRef) ~ Bool : (x) => x->Get() % 2 = 0)->PrintLine(); # true
v->All(\(IntRef) ~ Bool : (x) => x->Get() > 3)->PrintLine();     # false
```
		~#
		method : public : All(f : (H) ~ Bool) ~ Bool {
			for(i := 0; i < @size; i += 1;) {
				if(<>f(@values[i])) {
					return false;
				};
			};
			return true;
		}

		#~
		Counts elements matching the predicate
		@param f predicate function
		@return count of matching elements

```
