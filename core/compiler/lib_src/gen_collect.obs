	#~
	Hash table from Int keys to Int values: open addressing over plain arrays, so nothing is boxed. Every Int is a valid key, including 0 and the Int64 extremes.

```
counts := Collection.IntMap->New();
counts->Add(7, 1); counts->Add(7, 1); counts->Add(3, 1);
counts->Find(7)->PrintLine();       # 2
counts->Find(9, -1)->PrintLine();   # -1
counts->Has(3)->PrintLine();        # true
counts->Size()->PrintLine();        # 2
```
	~#
	class IntMap {
		@keys : Int[];
		@values : Int[];
		@used : Bool[];
		@size : Int;
		@mask : Int;
		@shift : Int;

		#~
		Default constructor

```
map := Collection.IntMap->New();
map->Insert(1, 100);
map->Size()->PrintLine(); # 1
```
		~#
		New() {
			Allocate(16);
		}

		#~
		Constructor that reserves room for a number of entries
		@param capacity number of entries expected

```
map := Collection.IntMap->New(100000);
map->Size()->PrintLine(); # 0
```
		~#
		New(capacity : Int) {
			slots := 16;
			while(slots * 7 < capacity * 10 & slots < 1073741824) {
				slots := slots << 1;
			};
			Allocate(slots);
		}

		method : Allocate(slots : Int) ~ Nil {
			@keys := Int->New[slots];
			@values := Int->New[slots];
			@used := Bool->New[slots];
			@size := 0;
			@mask := slots - 1;

			bits := 0;
			s := slots;
			while(s > 1) {
				s := s >> 1;
				bits += 1;
			};
			@shift := 64 - bits;
		}

		method : native : Rehash(slots : Int) ~ Nil {
			old_keys := @keys;
			old_values := @values;
			old_used := @used;
			size := @size;

			Allocate(slots);
			keys := @keys;
			values := @values;
			used := @used;
			mask := @mask;
			shift := @shift;

			count := old_keys->Size();
			for(j := 0; j < count; j += 1;) {
				if(old_used[j]) {
					key := old_keys[j];
					i := ((key * -7046029254386353131) >> shift) and mask;
					while(used[i]) {
						i := (i + 1) and mask;
					};
					used[i] := true;
					keys[i] := key;
					values[i] := old_values[j];
				};
			};
			@size := size;
		}

		#~
		Inserts a value, replacing the value of an existing key
		@param key key
		@param value value

```
map := Collection.IntMap->New();
map->Insert(-5, 25);
map->Find(-5)->PrintLine(); # 25
```
		~#
		method : public : native : Insert(key : Int, value : Int) ~ Nil {
			keys := @keys;
			used := @used;
			mask := @mask;

			i := ((key * -7046029254386353131) >> @shift) and mask;
			while(used[i]) {
				if(keys[i] = key) {
					@values[i] := value;
					return;
				};
				i := (i + 1) and mask;
			};

			used[i] := true;
			keys[i] := key;
			@values[i] := value;
			@size += 1;

			if(@size * 10 > (mask + 1) * 7) {
				Rehash((mask + 1) << 1);
			};
		}

		#~
		Adds to the value of a key; a missing key starts at 0
		@param key key
		@param delta amount to add
		@return new value

```
map := Collection.IntMap->New();
map->Add(1, 5);
map->Add(1, 2)->PrintLine(); # 7
```
		~#
		method : public : native : Add(key : Int, delta : Int) ~ Int {
			keys := @keys;
			used := @used;
			mask := @mask;

			i := ((key * -7046029254386353131) >> @shift) and mask;
			while(used[i]) {
				if(keys[i] = key) {
					value := @values[i] + delta;
					@values[i] := value;
					return value;
				};
				i := (i + 1) and mask;
			};

			used[i] := true;
			keys[i] := key;
			@values[i] := delta;
			@size += 1;

			if(@size * 10 > (mask + 1) * 7) {
				Rehash((mask + 1) << 1);
			};

			return delta;
		}

		#~
		Finds the value of a key
		@param key key
		@return value, or 0 if the key is missing (use Has or Find(key, missing) to tell)

```
map := Collection.IntMap->New();
map->Insert(1, 10);
map->Find(1)->PrintLine(); # 10
map->Find(2)->PrintLine(); # 0
```
		~#
		method : public : Find(key : Int) ~ Int {
			return Find(key, 0);
		}

		#~
		Finds the value of a key
		@param key key
		@param missing value returned when the key is missing
		@return value, or missing

```
map := Collection.IntMap->New();
map->Find(2, -1)->PrintLine(); # -1
```
		~#
		method : public : native : Find(key : Int, missing : Int) ~ Int {
			keys := @keys;
			used := @used;
			mask := @mask;

			i := ((key * -7046029254386353131) >> @shift) and mask;
			while(used[i]) {
				if(keys[i] = key) {
					return @values[i];
				};
				i := (i + 1) and mask;
			};

			return missing;
		}

		#~
		Checks for a key
		@param key key
		@return true if found, false otherwise

```
map := Collection.IntMap->New();
map->Insert(0, 0);
map->Has(0)->PrintLine(); # true
map->Has(1)->PrintLine(); # false
```
		~#
		method : public : native : Has(key : Int) ~ Bool {
			keys := @keys;
			used := @used;
			mask := @mask;

			i := ((key * -7046029254386353131) >> @shift) and mask;
			while(used[i]) {
				if(keys[i] = key) {
					return true;
				};
				i := (i + 1) and mask;
			};

			return false;
		}

		#~
		Removes a key
		@param key key
		@return true if removed, false if the key was missing

```
map := Collection.IntMap->New();
map->Insert(4, 16);
map->Remove(4)->PrintLine(); # true
map->Has(4)->PrintLine();    # false
```
		~#
		method : public : native : Remove(key : Int) ~ Bool {
			keys := @keys;
			values := @values;
			used := @used;
			mask := @mask;
			shift := @shift;

			i := ((key * -7046029254386353131) >> shift) and mask;
			found := false;
			while(used[i] & <>found) {
				if(keys[i] = key) {
					found := true;
				}
				else {
					i := (i + 1) and mask;
				};
			};

			if(<>found) {
				return false;
			};

			j := (i + 1) and mask;
			while(used[j]) {
				ideal := ((keys[j] * -7046029254386353131) >> shift) and mask;
				if(((j - ideal) and mask) >= ((j - i) and mask)) {
					keys[i] := keys[j];
					values[i] := values[j];
					i := j;
				};
				j := (j + 1) and mask;
			};

			used[i] := false;
			keys[i] := 0;
			values[i] := 0;
			@size -= 1;

			return true;
		}

		#~
		Number of entries
		@return number of entries

```
map := Collection.IntMap->New();
map->Insert(1, 1);
map->Size()->PrintLine(); # 1
```
		~#
		method : public : Size() ~ Int {
			return @size;
		}

		#~
		Checks to see if the map is empty
		@return true if empty, false otherwise

```
map := Collection.IntMap->New();
map->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @size = 0;
		}

		#~
		Removes every entry

```
map := Collection.IntMap->New();
map->Insert(1, 1);
map->Empty();
map->Size()->PrintLine(); # 0
```
		~#
		method : public : Empty() ~ Nil {
			Allocate(16);
		}

		#~
		Gets the keys. GetKeys and GetValues list the entries in the same order.
		@return array of keys

```
map := Collection.IntMap->New();
map->Insert(1, 10); map->Insert(2, 20);
map->GetKeys()->Size()->PrintLine(); # 2
```
		~#
		method : public : native : GetKeys() ~ Int[] {
			result := Int->New[@size];
			n := 0;
			for(i := 0; i < @used->Size(); i += 1;) {
				if(@used[i]) {
					result[n] := @keys[i];
					n += 1;
				};
			};
			return result;
		}

		#~
		Gets the values, in the same order as GetKeys
		@return array of values

```
map := Collection.IntMap->New();
map->Insert(1, 10); map->Insert(2, 20);
map->GetValues()->Size()->PrintLine(); # 2
```
		~#
		method : public : native : GetValues() ~ Int[] {
			result := Int->New[@size];
			n := 0;
			for(i := 0; i < @used->Size(); i += 1;) {
				if(@used[i]) {
					result[n] := @values[i];
					n += 1;
				};
			};
			return result;
		}

		#~
		Calls a function for each key and value. The function must not change the map.
		@param f function called
		@return this map

```
map := Collection.IntMap->New();
map->Insert(1, 10);
map->Each(\(k, v) => { "{$k}={$v}"->PrintLine(); });
```
		~#
		method : public : Each(f : (Int, Int) ~ Nil) ~ IntMap {
			keys := GetKeys();
			values := GetValues();
			each(i : keys) {
				f(keys[i], values[i]);
			};
			return @self;
		}

		#~
		Formats the map into a string
		@return string representation

```
map := Collection.IntMap->New();
map->Insert(1, 10);
map->ToString()->PrintLine(); # [(1:10)]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";
			count := 0;
			for(i := 0; i < @used->Size(); i += 1;) {
				if(@used[i]) {
					if(count > 0) {
						buffer->Append(',');
					};
					buffer->Append('(');
					buffer->Append(@keys[i]);
					buffer->Append(':');
					buffer->Append(@values[i]);
					buffer->Append(')');
					count += 1;
				};
			};
			buffer->Append(']');
			return buffer;
		}
	}

	#~
	Hash set of Int values: open addressing over plain arrays, so nothing is boxed. Every Int is a valid member, including 0 and the Int64 extremes.

```
set := Collection.IntSet->New();
set->Add(5)->PrintLine();   # true
set->Add(5)->PrintLine();   # false
set->Has(5)->PrintLine();   # true
set->Size()->PrintLine();   # 1
```
	~#
	class IntSet {
		@keys : Int[];
		@used : Bool[];
		@size : Int;
		@mask : Int;
		@shift : Int;

		#~
		Default constructor

```
set := Collection.IntSet->New();
set->Insert(1);
set->Size()->PrintLine(); # 1
```
		~#
		New() {
			Allocate(16);
		}

		#~
		Constructor that reserves room for a number of values
		@param capacity number of values expected

```
set := Collection.IntSet->New(100000);
set->Size()->PrintLine(); # 0
```
		~#
		New(capacity : Int) {
			slots := 16;
			while(slots * 7 < capacity * 10 & slots < 1073741824) {
				slots := slots << 1;
			};
			Allocate(slots);
		}

		method : Allocate(slots : Int) ~ Nil {
			@keys := Int->New[slots];
			@used := Bool->New[slots];
			@size := 0;
			@mask := slots - 1;

			bits := 0;
			s := slots;
			while(s > 1) {
				s := s >> 1;
				bits += 1;
			};
			@shift := 64 - bits;
		}

		method : native : Rehash(slots : Int) ~ Nil {
			old_keys := @keys;
			old_used := @used;
			size := @size;

			Allocate(slots);
			keys := @keys;
			used := @used;
			mask := @mask;
			shift := @shift;

			count := old_keys->Size();
			for(j := 0; j < count; j += 1;) {
				if(old_used[j]) {
					key := old_keys[j];
					i := ((key * -7046029254386353131) >> shift) and mask;
					while(used[i]) {
						i := (i + 1) and mask;
					};
					used[i] := true;
					keys[i] := key;
				};
			};
			@size := size;
		}

		#~
		Adds a value
		@param value value
		@return true if added, false if it was already in the set

```
set := Collection.IntSet->New();
set->Add(-1)->PrintLine(); # true
```
		~#
		method : public : native : Add(value : Int) ~ Bool {
			keys := @keys;
			used := @used;
			mask := @mask;

			i := ((value * -7046029254386353131) >> @shift) and mask;
			while(used[i]) {
				if(keys[i] = value) {
					return false;
				};
				i := (i + 1) and mask;
			};

			used[i] := true;
			keys[i] := value;
			@size += 1;

			if(@size * 10 > (mask + 1) * 7) {
				Rehash((mask + 1) << 1);
			};

			return true;
		}

		#~
		Inserts a value; the same as Add, for the method name the other sets use
		@param value value

```
set := Collection.IntSet->New();
set->Insert(9);
set->Has(9)->PrintLine(); # true
```
		~#
		method : public : Insert(value : Int) ~ Nil {
			Add(value);
		}

		#~
		Checks for a value
		@param value value
		@return true if found, false otherwise

```
set := Collection.IntSet->New();
set->Add(3);
set->Has(3)->PrintLine(); # true
```
		~#
		method : public : native : Has(value : Int) ~ Bool {
			keys := @keys;
			used := @used;
			mask := @mask;

			i := ((value * -7046029254386353131) >> @shift) and mask;
			while(used[i]) {
				if(keys[i] = value) {
					return true;
				};
				i := (i + 1) and mask;
			};

			return false;
		}

		#~
		Removes a value
		@param value value
		@return true if removed, false if it was not in the set

```
set := Collection.IntSet->New();
set->Add(3);
set->Remove(3)->PrintLine(); # true
```
		~#
		method : public : native : Remove(value : Int) ~ Bool {
			keys := @keys;
			used := @used;
			mask := @mask;
			shift := @shift;

			i := ((value * -7046029254386353131) >> shift) and mask;
			found := false;
			while(used[i] & <>found) {
				if(keys[i] = value) {
					found := true;
				}
				else {
					i := (i + 1) and mask;
				};
			};

			if(<>found) {
				return false;
			};

			j := (i + 1) and mask;
			while(used[j]) {
				ideal := ((keys[j] * -7046029254386353131) >> shift) and mask;
				if(((j - ideal) and mask) >= ((j - i) and mask)) {
					keys[i] := keys[j];
					i := j;
				};
				j := (j + 1) and mask;
			};

			used[i] := false;
			keys[i] := 0;
			@size -= 1;

			return true;
		}

		#~
		Number of values
		@return number of values

```
set := Collection.IntSet->New();
set->Add(1); set->Add(2);
set->Size()->PrintLine(); # 2
```
		~#
		method : public : Size() ~ Int {
			return @size;
		}

		#~
		Checks to see if the set is empty
		@return true if empty, false otherwise

```
set := Collection.IntSet->New();
set->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @size = 0;
		}

		#~
		Removes every value

```
set := Collection.IntSet->New();
set->Add(1);
set->Empty();
set->Size()->PrintLine(); # 0
```
		~#
		method : public : Empty() ~ Nil {
			Allocate(16);
		}

		#~
		Gets the values as an array
		@return array of values

```
set := Collection.IntSet->New();
set->Add(1); set->Add(2);
set->ToArray()->Size()->PrintLine(); # 2
```
		~#
		method : public : native : ToArray() ~ Int[] {
			result := Int->New[@size];
			n := 0;
			for(i := 0; i < @used->Size(); i += 1;) {
				if(@used[i]) {
					result[n] := @keys[i];
					n += 1;
				};
			};
			return result;
		}

		#~
		Calls a function for each value. The function must not change the set.
		@param f function called
		@return this set

```
set := Collection.IntSet->New();
set->Add(1);
set->Each(\(v) => { v->PrintLine(); });
```
		~#
		method : public : Each(f : (Int) ~ Nil) ~ IntSet {
			values := ToArray();
			each(i : values) {
				f(values[i]);
			};
			return @self;
		}

		#~
		Formats the set into a string
		@return string representation

```
set := Collection.IntSet->New();
set->Add(1);
set->ToString()->PrintLine(); # {1}
```
		~#
		method : public : ToString() ~ String {
			buffer := "{";
			count := 0;
			for(i := 0; i < @used->Size(); i += 1;) {
				if(@used[i]) {
					if(count > 0) {
						buffer->Append(',');
					};
					buffer->Append(@keys[i]);
					count += 1;
				};
			};
			buffer->Append('}');
			return buffer;
		}
	}

	#~
	Growable set of bits packed 64 to an Int

```
bits := Collection.BitSet->New(128);
bits->Set(3); bits->Set(64); bits->Set(100);
bits->Get(64)->PrintLine();          # true
bits->Cardinality()->PrintLine();    # 3
bits->NextSetBit(4)->PrintLine();    # 64
```
	~#
	class BitSet {
		@words : Int[];
		@size : Int;

		#~
		Default constructor

```
bits := Collection.BitSet->New();
bits->Set(10);
bits->Size()->PrintLine(); # 11
```
		~#
		New() {
			@words := Int->New[1];
			@size := 0;
		}

		#~
		Constructor for a number of bits, all clear
		@param size number of bits

```
bits := Collection.BitSet->New(65);
bits->Size()->PrintLine(); # 65
```
		~#
		New(size : Int) {
			if(size < 0) {
				size := 0;
			};
			words := (size + 63) >> 6;
			if(words < 1) {
				words := 1;
			};
			@words := Int->New[words];
			@size := size;
		}

		method : EnsureWords(count : Int) ~ Nil {
			if(count > @words->Size()) {
				grow := @words->Size() << 1;
				if(grow < count) {
					grow := count;
				};
				temp := Int->New[grow];
				Runtime->Copy(temp, 0, @words, 0, @words->Size());
				@words := temp;
			};
		}

		#~
		Sets a bit, growing the set when the index is past its size
		@param index bit index (negative indexes are ignored)

```
bits := Collection.BitSet->New();
bits->Set(200);
bits->Get(200)->PrintLine(); # true
```
		~#
		method : public : native : Set(index : Int) ~ Nil {
			if(index < 0) {
				return;
			};

			word := index >> 6;
			if(word >= @words->Size()) {
				EnsureWords(word + 1);
			};
			if(index >= @size) {
				@size := index + 1;
			};

			@words[word] := @words[word] or (1 << (index and 63));
		}

		#~
		Sets or clears a bit
		@param index bit index (negative indexes are ignored)
		@param value true to set, false to clear

```
bits := Collection.BitSet->New(8);
bits->Set(2, true);
bits->Get(2)->PrintLine(); # true
```
		~#
		method : public : Set(index : Int, value : Bool) ~ Nil {
			if(value) {
				Set(index);
			}
			else {
				Clear(index);
			};
		}

		#~
		Clears a bit
		@param index bit index (indexes past the size are already clear)

```
bits := Collection.BitSet->New(8);
bits->Set(2);
bits->Clear(2);
bits->Get(2)->PrintLine(); # false
```
		~#
		method : public : native : Clear(index : Int) ~ Nil {
			if(index < 0 | index >= @size) {
				return;
			};

			word := index >> 6;
			@words[word] := @words[word] and ((1 << (index and 63)) xor -1);
		}

		#~
		Gets a bit
		@param index bit index
		@return true if set, false if clear or out of range

```
bits := Collection.BitSet->New(8);
bits->Set(5);
bits->Get(5)->PrintLine(); # true
bits->Get(6)->PrintLine(); # false
```
		~#
		method : public : native : Get(index : Int) ~ Bool {
			if(index < 0 | index >= @size) {
				return false;
			};

			return ((@words[index >> 6] >> (index and 63)) and 1) = 1;
		}

		#~
		Number of bits: the size given to the constructor, or one past the highest bit ever set if that is larger
		@return number of bits

```
bits := Collection.BitSet->New(10);
bits->Size()->PrintLine(); # 10
```
		~#
		method : public : Size() ~ Int {
			return @size;
		}

		#~
		Counts the set bits
		@return number of set bits

```
bits := Collection.BitSet->New(8);
bits->Set(1); bits->Set(2);
bits->Cardinality()->PrintLine(); # 2
```
		~#
		method : public : native : Cardinality() ~ Int {
			count := 0;
			words := @words;
			size := words->Size();
			for(i := 0; i < size; i += 1;) {
				count += BitCount(words[i]);
			};
			return count;
		}

		function : private : BitCount(x : Int) ~ Int {
			if(x = 0) {
				return 0;
			};
			x := x - ((x >> 1) and 0x5555555555555555);
			x := (x and 0x3333333333333333) + ((x >> 2) and 0x3333333333333333);
			x := (x + (x >> 4)) and 0x0F0F0F0F0F0F0F0F;
			return ((x * 0x0101010101010101) >> 56) and 0xFF;
		}

		#~
		Finds the next set bit at or after an index
		@param start index to start at
		@return index of the next set bit, or -1 if there is none

```
bits := Collection.BitSet->New(200);
bits->Set(70); bits->Set(130);
bits->NextSetBit(0)->PrintLine();   # 70
bits->NextSetBit(71)->PrintLine();  # 130
bits->NextSetBit(131)->PrintLine(); # -1
```
		~#
		method : public : native : NextSetBit(start : Int) ~ Int {
			if(start < 0) {
				start := 0;
			};
			if(start >= @size) {
				return -1;
			};

			words := @words;
			count := words->Size();
			w := start >> 6;
			word := words[w] and (-1 << (start and 63));
			while(true) {
				if(word <> 0) {
					# isolate the lowest set bit, then count the bits below it
					index := (w << 6) + BitCount((word and (0 - word)) - 1);
					if(index < @size) {
						return index;
					};
					return -1;
				};

				w += 1;
				if(w >= count) {
					return -1;
				};
				word := words[w];
			};

			return -1;
		}

		#~
		Keeps only the bits also set in another set (in place)
		@param that other set (Nil clears every bit)
		@return this set

```
a := Collection.BitSet->New(8); a->Set(1); a->Set(2);
b := Collection.BitSet->New(8); b->Set(2);
a->And(b)->Cardinality()->PrintLine(); # 1
```
		~#
		method : public : And(that : BitSet) ~ BitSet {
			words := @words;
			if(that = Nil) {
				for(i := 0; i < words->Size(); i += 1;) {
					words[i] := 0;
				};
				return @self;
			};

			bits := that->GetWords();
			for(i := 0; i < words->Size(); i += 1;) {
				if(i < bits->Size()) {
					words[i] := words[i] and bits[i];
				}
				else {
					words[i] := 0;
				};
			};
			return @self;
		}

		#~
		Adds the bits set in another set (in place)
		@param that other set (Nil changes nothing)
		@return this set

```
a := Collection.BitSet->New(8); a->Set(1);
b := Collection.BitSet->New(8); b->Set(2);
a->Or(b)->Cardinality()->PrintLine(); # 2
```
		~#
		method : public : Or(that : BitSet) ~ BitSet {
			if(that = Nil) {
				return @self;
			};

			bits := that->GetWords();
			EnsureWords(bits->Size());
			words := @words;
			for(i := 0; i < bits->Size(); i += 1;) {
				words[i] := words[i] or bits[i];
			};
			if(that->Size() > @size) {
				@size := that->Size();
			};
			return @self;
		}

		#~
		Flips the bits set in another set (in place)
		@param that other set (Nil changes nothing)
		@return this set

```
a := Collection.BitSet->New(8); a->Set(1); a->Set(2);
b := Collection.BitSet->New(8); b->Set(2); b->Set(3);
a->Xor(b)->Cardinality()->PrintLine(); # 2
```
		~#
		method : public : Xor(that : BitSet) ~ BitSet {
			if(that = Nil) {
				return @self;
			};

			bits := that->GetWords();
			EnsureWords(bits->Size());
			words := @words;
			for(i := 0; i < bits->Size(); i += 1;) {
				words[i] := words[i] xor bits[i];
			};
			if(that->Size() > @size) {
				@size := that->Size();
			};
			return @self;
		}

		#~
		Clears the bits set in another set (in place)
		@param that other set (Nil changes nothing)
		@return this set

```
a := Collection.BitSet->New(8); a->Set(1); a->Set(2);
b := Collection.BitSet->New(8); b->Set(2);
a->AndNot(b)->Get(2)->PrintLine(); # false
```
		~#
		method : public : AndNot(that : BitSet) ~ BitSet {
			if(that = Nil) {
				return @self;
			};

			bits := that->GetWords();
			words := @words;
			for(i := 0; i < words->Size(); i += 1;) {
				if(i < bits->Size()) {
					words[i] := words[i] and (bits[i] xor -1);
				};
			};
			return @self;
		}

		#~
		Gets the backing words; bit i is bit (i and 63) of word (i >> 6). The array is shared, not copied.
		@return words

```
bits := Collection.BitSet->New(8);
bits->Set(0);
bits->GetWords()[0]->PrintLine(); # 1
```
		~#
		method : public : GetWords() ~ Int[] {
			return @words;
		}

		#~
		Copies the set
		@return new set with the same bits

```
a := Collection.BitSet->New(8); a->Set(1);
b := a->Copy();
b->Set(2);
a->Cardinality()->PrintLine(); # 1
```
		~#
		method : public : Copy() ~ BitSet {
			copy := BitSet->New(@size);
			copy->Or(@self);
			return copy;
		}

		#~
		Clears every bit; the size is kept

```
bits := Collection.BitSet->New(8);
bits->Set(1);
bits->Empty();
bits->Cardinality()->PrintLine(); # 0
```
		~#
		method : public : Empty() ~ Nil {
			words := @words;
			for(i := 0; i < words->Size(); i += 1;) {
				words[i] := 0;
			};
		}

		#~
		Formats the set into a string of the indexes of its set bits
		@return string representation

```
bits := Collection.BitSet->New(8);
bits->Set(1); bits->Set(5);
bits->ToString()->PrintLine(); # {1,5}
```
		~#
		method : public : ToString() ~ String {
			buffer := "{";
			count := 0;
			i := NextSetBit(0);
			while(i > -1) {
				if(count > 0) {
					buffer->Append(',');
				};
				buffer->Append(i);
				count += 1;
				i := NextSetBit(i + 1);
			};
			buffer->Append('}');
			return buffer;
		}
	}
}
