	#~
	Balanced ordered tree of 'Compare' keys and 'Base' values
	
	```
	function : Example() ~ Nil {	
	   # insert elements
	   map := Collection.Map->New()<IntRef, String>;
	   map->Insert(415, "San Francisco");
	   map->Insert(510, "Oakland");
	   map->Insert(925, "East Bay");

	   # get size
	   map->Size()->PrintLine();

	   # get value by key
	   map->Find(510)->PrintLine();

	   # get key/values
	   key_values := map->GetKeyValues()<Pair<IntRef, String>>;
	   each(key_value := key_values) {
	      key_value->GetFirst()->PrintLine();
	   };

	   # get values
	   values := map->GetValues()<String>;
	   each(value := values) {
	      value->PrintLine();
	   };

	   # check for key
	   map->Has(408)->PrintLine();
	}
	```
	~#
	class Map<K : Compare, V> {
		@root : TreeNode<K, V>;
		@last : TreeNode<K, V>;
		@size : Int;

		#~
		Default constructor

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("alpha", IntRef->New(1));
map->Size()->PrintLine(); # 1
```
		~#
		New() {
			@root := Nil;
			@size := 0;
		}

		method : native : Skew(node : Collection.TreeNode<K, V>) ~ TreeNode<K, V> {
			if(node = Nil | node->GetLeft() = Nil) {
				return node;
			};
				
			if(node->GetLeft()->GetLevel() = node->GetLevel()) {
				left : TreeNode<K, V> := node->GetLeft();
				node->SetLeft(left->GetRight());
				left->SetRight(node);
				return left;
			};
			
			return node;
		}

		#~
		Converts a vector pairs to a map
		@param pairs vector of pairs
		@return mapped pairs

```
pairs := Collection.Vector->New()<Collection.Tuple.Pair<String, IntRef>>;
pairs->AddBack(Collection.Tuple.Pair->New("one", IntRef->New(1))<String, IntRef>);
pairs->AddBack(Collection.Tuple.Pair->New("two", IntRef->New(2))<String, IntRef>);
map := Collection.Map->Dict(pairs)<String, IntRef>;
map->Find("one")->PrintLine(); # 1
```
		~#
		function : Dict(pairs : Vector<Collection.Tuple.Pair<K, V>>) ~ Map<K, V> {
			dict := Map->New()<K, V>;

			each(pair in pairs) {
				k := pair->GetFirst();
				v := pair->GetSecond();
				dict->Insert(k, v);
			};

			return dict;
		}

		#~
		Size of queue
		@return size of queue

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("a", IntRef->New(1)); map->Insert("b", IntRef->New(2));
map->Size()->PrintLine(); # 2
```
		~#
		method : public : Size() ~ Int {
			return @size;
		}

		#~
		Checks to see if the map is empty
		@return true if empty, false otherwise

```
map := Collection.Map->New()<String, IntRef>;
map->IsEmpty()->PrintLine(); # true
map->Insert("x", IntRef->New(9));
map->IsEmpty()->PrintLine(); # false
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @size = 0;
		}

		#~
		Clears the map

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("a", IntRef->New(1));
map->Empty();
map->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : Empty() ~ Nil {
			@root := Nil;
			@last := Nil;
			@size := 0;
		}
		
		method : native : Split(node : Collection.TreeNode<K, V>) ~ TreeNode<K, V> {
			if(node = Nil | node->GetRight() = Nil | 
					node->GetRight()->GetRight() = Nil) {
				return node;
			};

			if(node->GetRight()->GetRight()->GetLevel() = node->GetLevel()) {
				right : TreeNode<K, V> := node->GetRight();
				node->SetRight(right->GetLeft());
				right->SetLeft(node);
				right->SetLevel(right->GetLevel() + 1);
				
				return right;
			};
			
			return node;
		}
		
		#~
		Searches for a value in a map
		@param key search key
		@return found value, Nil if not found

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("pi", IntRef->New(3));
map->Find("pi")->PrintLine();   # 3
map->Find("e")->PrintLine();    # (Nil)
```
		~#
		method : public : Find(key : K) ~ V {
			node := @root;
			while(node <> Nil) {
				cmp := key->Compare(node->GetKey());
				if(cmp < 0) {
					node := node->GetLeft();
				}
				else if(cmp > 0) {
					node := node->GetRight();
				}
				else {
					return node->Get();		
				};
			};

			return Nil;
		}
		
		#~
		Checks for a value in a map
		@param key search key
		@return true if found, false otherwise

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("cat", IntRef->New(1));
map->Has("cat")->PrintLine(); # true
map->Has("dog")->PrintLine(); # false
```
		~#
		method : public : Has(key : K) ~ Bool {
			node := @root;
			while(node <> Nil) {
				cmp := key->Compare(node->GetKey());
				if(cmp < 0) {
					node := node->GetLeft();
				}
				else if(cmp > 0) {
					node := node->GetRight();
				}
				else {
					return true;		
				};
			};

			return false;
		}
		
		method : Find(key : K, node : Collection.TreeNode<K, V>) ~ V {
			if(node <> Nil) {
				cmp := key->Compare(node->GetKey());
				if(cmp < 0) {
					return Find(key, node->GetLeft());
				}
				else if(cmp > 0) {
					return Find(key, node->GetRight());
				}
				else {
					return node->Get();		
				};
			};
			
			return Nil;
		}

		#~
		Function called for each element
		@param f function called

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("a", IntRef->New(1)); map->Insert("b", IntRef->New(2));
map->Each(\(String, IntRef) ~ Nil : (k, v) => "{$k}={$v}"->PrintLine());
```
		~#
		method : public : Each(f : (K, V) ~ Nil) ~ Map<K, V> {
			Each(@root, f);
			return @self;
		}

		method : Each(node : Collection.TreeNode<K, V>, f : (K, V) ~ Nil) ~ Nil {
			if(node <> Nil) {
				# process left 
				Each(node->GetLeft(), f);

				key := node->GetKey();
				value := node->Get();
				f(key, value);

				# process right
				Each(node->GetRight(), f);
			};
		}

		#~
		Get a collection of keys
		@return vector of keys

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("x", IntRef->New(10)); map->Insert("y", IntRef->New(20));
keys := map->GetKeys()<String>;
each(k := keys) { k->PrintLine(); }
```
		~#
		method : public : GetKeys() ~  Collection.Vector<K> {
			vector := Vector->New()<K>;
			vector->Reserve(@size);
			GetKeys(@root, vector);
			return vector;
		}

		method : GetKeys(node : Collection.TreeNode<K, V>, vector : Collection.Vector<K>) ~ Nil {
			if(node <> Nil) {
				# process left 
				GetKeys(node->GetLeft(), vector);
				
				key : K := node->GetKey();
				vector->AddBack(key);
				
				# process right
				GetKeys(node->GetRight(), vector);
			};
		}
        
		#~
		Get a collection of key-value pairs
		@return vector of key-value pairs

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("a", IntRef->New(1)); map->Insert("b", IntRef->New(2));
kvs := map->GetKeyValues()<Collection.Pair<String, IntRef>>;
each(kv := kvs) { "{$kv->GetFirst()}={$kv->GetSecond()}"->PrintLine(); }
```
		~#
		method : public : GetKeyValues() ~  Collection.Vector<Pair<K,V>> {
			vector := Vector->New()<Pair<K,V>>;
			vector->Reserve(@size);
			GetKeyValues(@root, vector);
			return vector;
		}

		method : GetKeyValues(node : Collection.TreeNode<K, V>, vector : Collection.Vector<Pair<K,V>>) ~ Nil {
			if(node <> Nil) {
				# process left 
				GetKeyValues(node->GetLeft(), vector);
				
				key : K := node->GetKey();
                value : V := node->Get();
                
				vector->AddBack(Pair->New(key, value)<K,V>);
				
				# process right
				GetKeyValues(node->GetRight(), vector);
			};
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("a", IntRef->New(1)); map->Insert("b", IntRef->New(2));
map->ToString()->PrintLine(); # [(a:1),(b:2)]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			ToString(@root, buffer, 0);
			buffer->Append(']');

			return buffer;
		}

		method : ToString(node : Collection.TreeNode<K, V>, buffer : String, count : Int) ~ Int {
			if(node <> Nil) {
				count := ToString(node->GetLeft(), buffer, count);

				if(count > 0) {
					buffer->Append(',');
				};

				key := node->GetKey();
				buffer->Append('(');
				if(key->TypeOf(Stringify)) {
					buffer->Append(key->As(System.Stringify)->ToString());
				}
				else {
					buffer->Append(key->GetInstanceID()->ToHexString());
				};

				buffer->Append(':');

				value := node->Get();
				if(value = Nil) {
					buffer->Append("<Nil>");
				}
				else if(value->TypeOf(Stringify)) {
					buffer->Append(value->As(System.Stringify)->ToString());
				}
				else {
					buffer->Append(value->GetInstanceID()->ToHexString());
				};
				buffer->Append(')');

				count += 1;
				count := ToString(node->GetRight(), buffer, count);
			};

			return count;
		}
        
		#~
		Gets a collection of values
		@return vector of values

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("p", IntRef->New(3)); map->Insert("q", IntRef->New(4));
values := map->GetValues()<IntRef>;
each(v := values) { v->PrintLine(); }
```
		~#
		method : public : GetValues() ~  Collection.Vector<V> {
			vector := Vector->New()<V>;
			vector->Reserve(@size);
			GetValues(@root, vector);
			return vector;
		}

		method : GetValues(node : Collection.TreeNode<K, V>, vector : Collection.Vector<V>) ~ Nil {
			if(node <> Nil) {
				# process left 
				GetValues(node->GetLeft(), vector);
				
				value : V := node->Get();
				vector->AddBack(value);
				
				# process right
				GetValues(node->GetRight(), vector);
			};
		}
        
		#~
		Inserts a value into the map
		@param key key
		@param value value

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("city", IntRef->New(42));
map->Find("city")->PrintLine(); # 42
```
		~#
		method : public : Insert(key : K, value : V) ~ Nil {
			if(key = Nil) {
				return;
			};

			if(@root = Nil) {
				@root := Insert(key, value, Nil->As(Collection.TreeNode<K, V>));
			}
			else {
				@root := Insert(key, value, @root);
			};
		}
		
		method : Insert(key : K, value : V, node : Collection.TreeNode<K, V>) ~  Collection.TreeNode<K, V> {
			if(node = Nil) {
				node := TreeNode->New(key, value, 1)<K, V>;
				@size += 1;
			}
			else {
				cmp := key->Compare(node->GetKey());
				if(cmp < 0) {
					node->SetLeft(Insert(key, value, node->GetLeft()));
				}
				else if(cmp > 0) {
					node->SetRight(Insert(key, value, node->GetRight()));
				}
				else {
					node->Set(value);
					return node;
				};
				node := Skew(node);
				node := Split(node);
			};	
			
			return node;
		}
		
		#~
		Removes a value from the map
		@param key key for value to remove

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("tmp", IntRef->New(0));
map->Remove("tmp")->PrintLine();  # true
map->Has("tmp")->PrintLine();     # false
```
		~#
		method : public : Remove(key : K) ~ Bool {
			if(@root = Nil) {
				return false;
			};
			
			if(@size = 1 & key->Compare(@root->GetKey()) = 0) {
				@root := Nil;
				@size := 0;
				return true;
			};
			
			@last := Nil;
			@root := Remove(key, @root);
			if(@last <> Nil) {
				@size -= 1;
				@last := Nil;
				return true;
			};
			
			return false;
		}
		
		method : native : Remove(key : K, node : Collection.TreeNode<K, V>) ~  Collection.TreeNode<K, V> {
			if(node = Nil) {
				return Nil;
			};

			cmp := key->Compare(node->GetKey());
			if(cmp < 0) {
				node->SetLeft(Remove(key, node->GetLeft()));
			}
			else if(cmp > 0) {
				node->SetRight(Remove(key, node->GetRight()));
			}
			else {
				@last := node;
				if(node->GetLeft() = Nil & node->GetRight() = Nil) {
					return Nil;
				}
				else if(node->GetLeft() = Nil) {
					temp : TreeNode<K, V> := Successor(node);
					node->SetRight(Remove(temp->GetKey(), node->GetRight()));
					node->SetKey(temp->GetKey());
					node->Set(temp->Get());
				} 
				else {
					temp : TreeNode<K, V> := Predecessor(node);
					node->SetLeft(Remove(temp->GetKey(), node->GetLeft()));
					node->SetKey(temp->GetKey());
					node->Set(temp->Get());
				};
				
			};
			
			# rebalanced
			node := DecreaseLevel(node);				
			node := Skew(node);
			node->SetRight(Skew(node->GetRight()));
			if(node->GetRight() <> Nil & node->GetRight()->GetRight() <> Nil) {
				node->GetRight()->SetRight(Skew(node->GetRight()->GetRight()));
			};	
			node := Split(node);								
			node->SetRight(Split(node->GetRight()));

			return node;
		}
		
		method : Predecessor(node : Collection.TreeNode<K, V>) ~ TreeNode<K, V> {
			if(node->GetLeft() <> Nil) {
				left : TreeNode<K, V> := node->GetLeft();
				while(left->GetRight() <> Nil) {
					left := left->GetRight();
				};

				return left;
			};

			return node;
		}

		method : Successor(node : Collection.TreeNode<K, V>) ~ TreeNode<K, V> {
			if(node->GetRight() <> Nil) {
				right : TreeNode<K, V> := node->GetRight();
				while(right->GetLeft() <> Nil) {
					right := right->GetLeft();
				};

				return right;
			};

			return node;
		}

		 method : DecreaseLevel(node : Collection.TreeNode<K, V>) ~ TreeNode<K, V> {
			left : Int := 0;
			right : Int := 0;

			if(node->GetLeft() <> Nil) {
				left := node->GetLeft()->GetLevel();
			};

			if(node->GetRight() <> Nil) {
				right := node->GetRight()->GetLevel();
			};

			value : Int := Int->Min(left, right) + 1;

			if(value < node->GetLevel()) {
				node->SetLevel(value);
				if(node->GetRight() <> Nil & value < node->GetRight()->GetLevel()) {
					node->GetRight()->SetLevel(value);
				};
			};
			return node;
		}
		
		#~
		Uses the given function to filter out values
		@param f function to use a filter. If the function evaluates to true the value is added to the collection.
		@return filtered map

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("a", IntRef->New(1)); map->Insert("b", IntRef->New(2));
filtered := map->Filter(\(String) ~ Bool : (k) => k->Equals("a"))<String, IntRef>;
filtered->Size()->PrintLine(); # 1
```
		~#
		method : public : Filter(f : (K) ~ Bool) ~ Map<K, V> {
			filtered := Map->New()<K, V>;
			Filter(@root, filtered, f);

			return filtered;
		}

		method : Filter(node : Collection.TreeNode<K, V>, filtered : Map<K, V>, f : (K) ~ Bool) ~ Nil {
			if(node <> Nil) {
				Filter(node->GetLeft(), filtered, f);

				key := node->GetKey();
				if(f(key)) {
					filtered->Insert(key, node->Get());
				};

				Filter(node->GetRight(), filtered, f);
			};
		}

		#~
		Uses the given function to reduce the values
		@param a initial value (i.e. accumulator)
		@param f function to use a reduce
		@return reduced value

```
map := Collection.Map->New()<String, IntRef>;
map->Insert("a", IntRef->New(0)); map->Insert("b", IntRef->New(0));
concat := map->Reduce("", \(String, String) ~ String : (acc, k) => "{$acc}{$k}");
concat->PrintLine(); # ab
```
		~#
		method : public : Reduce(a : K, f : (K, K) ~ K) ~ K {
			return Reduce(@root, a, f);
		}

		method : Reduce(node : Collection.TreeNode<K, V>, a : K, f : (K, K) ~ K) ~ K {
			if(node <> Nil) {
				a := Reduce(node->GetLeft(), a, f);
				a := f(a, node->GetKey());
				a := Reduce(node->GetRight(), a, f);
			};

			return a;
		}
	}

	class : private : TreeNode<K : Compare, V> {
		@key : K;
		@value : V;
		@left : TreeNode<K, V>;
		@right : TreeNode<K, V>;
		@level : Int;
		
		New(key : K, value : V, level : Int) {
			@key := key;
			@value := value;
			@level := level;
			@left := Nil;
			@right := Nil;
		}

		method : public : SetKey(key : K) ~ Nil {
			@key := key;
		}
		
		method : public : GetKey() ~ K {
			return @key;
		}

		method : public : Get() ~ V {
			return @value;
		}

		method : public : Set(value : V) ~ Nil {
			@value := value;
		}

		method : public : GetLevel() ~ Int {
			return @level;
		}

		method : public : SetLevel(level : Int) ~ Nil {
			@level := level;
		}

		method : public : GetLeft() ~ TreeNode<K, V> {
			return @left;
		}

		method : public : SetLeft(left : TreeNode<K, V>) ~ Nil {
			@left := left;
		}

		method : public : GetRight() ~ TreeNode<K, V> {
			return @right;
		}

		method : public : SetRight(right : TreeNode<K, V>) ~ Nil {
			@right := right;
		}
	}
	
	#~
	Ordered set of generic objects

	```
# insert elements
set := Collection.Set->New()<String>;
set->Insert("San Francisco");
set->Insert("Oakland");
set->Insert("East Bay");

# get size
set->Size()->PrintLine();

# get value by key
set->Has("Oakland")->PrintLine();
	```	
	~#
	class Set<K : Compare> {
		@map : Map<K, Base>;

		#~
		Default constructor

```
set := Collection.Set->New()<String>;
set->Insert("hello");
set->Size()->PrintLine(); # 1
```
		~#
		New() {
			@map := Map->New()<K, Base>;
		}

		#~
		Inserts a key into the set
		@param key key

```
set := Collection.Set->New()<String>;
set->Insert("apple");
set->Insert("apple"); # duplicate ignored
set->Size()->PrintLine(); # 1
```
		~#
		method : public : Insert(key : K) ~ Nil {
			@map->Insert(key, key);
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
set := Collection.Set->New()<String>;
set->Insert("x"); set->Insert("y");
set->ToString()->PrintLine(); # [x,y]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			keys := GetKeys()<K>;
			each(i : keys) {
				# get string value if instance implements 'Stringify'
				key := keys->Get(i);

				if(key->TypeOf(Stringify)) {
					buffer->Append(key->As(System.Stringify)->ToString());
				}
				# use instance ID instead
				else {
					buffer->Append(key->GetInstanceID()->ToHexString());
				};

				# add comma
				if(i + 1 < keys->Size()) {
					buffer->Append(',');
				};
			};
			buffer->Append(']');

			return buffer;
		}
		
		#~
		Removes a key from the set
		@param key key for value to remove
		@return true if removed, false otherwise

```
set := Collection.Set->New()<String>;
set->Insert("go");
set->Remove("go")->PrintLine();  # true
set->Has("go")->PrintLine();     # false
```
		~#
		method : public : Remove(key : K) ~ Bool {
			return @map->Remove(key);
		}

		#~
		Checks for key in set
		@param key search key
		@return true if found, false otherwise

```
set := Collection.Set->New()<String>;
set->Insert("found");
set->Has("found")->PrintLine();   # true
set->Has("missing")->PrintLine(); # false
```
		~#
		method : public : Has(key : K) ~ Bool {
			return @map->Has(key);
		}

		#~
		Get a collection of keys
		@return vector of keys

```
set := Collection.Set->New()<String>;
set->Insert("a"); set->Insert("b");
keys := set->GetKeys()<String>;
each(k := keys) { k->PrintLine(); }
```
		~#
		method : public : GetKeys() ~ Vector<K> {
			return @map->GetKeys();
		}

		#~
		Clears the set

```
set := Collection.Set->New()<String>;
set->Insert("item");
set->Empty();
set->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : Empty() ~ Nil {
			@map->Empty();
		}

		#~
		Checks to see if the set is empty
		@return true if empty, false otherwise

```
set := Collection.Set->New()<String>;
set->IsEmpty()->PrintLine(); # true
set->Insert("z");
set->IsEmpty()->PrintLine(); # false
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @map->IsEmpty();
		}

		#~
		Size of map
		@return size of queue

```
set := Collection.Set->New()<String>;
set->Insert("a"); set->Insert("b"); set->Insert("c");
set->Size()->PrintLine(); # 3
```
		~#
		method : public : Size() ~ Int {
			return @map->Size();
		}

		#~
		Adds a key to the set; the same as Insert, but says whether it was new
		@param key key
		@return true if added, false if it was already in the set (or is Nil)

```
set := Collection.Set->New()<String>;
set->Add("apple")->PrintLine(); # true
set->Add("apple")->PrintLine(); # false
```
		~#
		method : public : Add(key : K) ~ Bool {
			if(key = Nil | @map->Has(key)) {
				return false;
			};
			@map->Insert(key, key);
			return true;
		}

		#~
		Gets all elements as a vector; the same as GetKeys
		@return vector of elements

```
set := Collection.Set->New()<String>;
set->Insert("x"); set->Insert("y");
set->ToVector()->Size()->PrintLine(); # 2
```
		~#
		method : public : ToVector() ~ Vector<K> {
			return @map->GetKeys();
		}

		#~
		Gets all elements as an array
		@return array of elements

```
set := Collection.Set->New()<String>;
set->Insert("p"); set->Insert("q");
set->ToArray()->Size()->PrintLine(); # 2
```
		~#
		method : public : ToArray() ~ K[] {
			keys := @map->GetKeys();
			array := K->New[keys->Size()];
			each(i : keys) {
				array[i] := keys->Get(i);
			};
			return array;
		}

		#~
		Elements in this set, the other set, or both. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.Set->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.Set->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Union(b)->Size()->PrintLine(); # 4
```
		~#
		method : public : Union(that : Set<K>) ~ Set<K> {
			result := Set->New()<K>;
			keys := ToVector();
			each(i : keys) {
				result->Insert(keys->Get(i));
			};
			if(that <> Nil) {
				keys := that->ToVector();
				each(i : keys) {
					result->Insert(keys->Get(i));
				};
			};
			return result;
		}

		#~
		Elements in both this set and the other set. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.Set->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.Set->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Intersect(b)->Size()->PrintLine(); # 2
```
		~#
		method : public : Intersect(that : Set<K>) ~ Set<K> {
			result := Set->New()<K>;
			keys := ToVector();
			each(i : keys) {
				key := keys->Get(i);
				if(that = Nil) {
				}
				else if(that->Has(key)) {
					result->Insert(key);
				};
			};
			return result;
		}

		#~
		Elements in this set that are not in the other set. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.Set->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.Set->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Difference(b)->Has(1)->PrintLine(); # true
```
		~#
		method : public : Difference(that : Set<K>) ~ Set<K> {
			result := Set->New()<K>;
			keys := ToVector();
			each(i : keys) {
				key := keys->Get(i);
				if(that = Nil) {
					result->Insert(key);
				}
				else if(<>that->Has(key)) {
					result->Insert(key);
				};
			};
			return result;
		}

		#~
		Elements in exactly one of the two sets. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.Set->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.Set->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->SymmetricDifference(b)->Size()->PrintLine(); # 2 (1 and 4)
```
		~#
		method : public : SymmetricDifference(that : Set<K>) ~ Set<K> {
			result := Difference(that);
			if(that <> Nil) {
				keys := that->ToVector();
				each(i : keys) {
					if(<>Has(keys->Get(i))) {
						result->Insert(keys->Get(i));
					};
				};
			};
			return result;
		}

		#~
		Checks that every element of this set is in the other set. The empty set is a subset of every set.
		@param that other set (Nil counts as empty)
		@return true if this set is a subset of the other, false otherwise

```
a := Collection.Set->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.Set->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Intersect(b)->IsSubset(b)->PrintLine(); # true
a->IsSubset(b)->PrintLine(); # false
```
		~#
		method : public : IsSubset(that : Set<K>) ~ Bool {
			if(that = Nil) {
				return IsEmpty();
			};
			if(Size() > that->Size()) {
				return false;
			};
			keys := ToVector();
			each(i : keys) {
				if(<>that->Has(keys->Get(i))) {
					return false;
				};
			};
			return true;
		}

		#~
		Checks that every element of the other set is in this set
		@param that other set (Nil counts as empty)
		@return true if this set is a superset of the other, false otherwise

```
a := Collection.Set->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.Set->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Union(b)->IsSuperset(a)->PrintLine(); # true
```
		~#
		method : public : IsSuperset(that : Set<K>) ~ Bool {
			if(that = Nil) {
				return true;
			};
			return that->IsSubset(@self);
		}

		#~
		Calls a function for each element
		@param f function called
		@return this set

```
set := Collection.Set->New()<String>;
set->Insert("x"); set->Insert("y");
set->Each(\(s) => { s->PrintLine(); });
```
		~#
		method : public : Each(f : (K) ~ Nil) ~ Set<K> {
			keys := ToVector();
			each(i : keys) {
				f(keys->Get(i));
			};
			return @self;
		}

		#~
		Keeps the elements a function accepts. The set is not changed.
		@param f function that returns true for each element to keep
		@return new set

```
set := Collection.Set->New()<String>;
set->Insert("apple"); set->Insert("kiwi");
set->Filter(\(s) => s->Size() > 4)->Size()->PrintLine(); # 1
```
		~#
		method : public : Filter(f : (K) ~ Bool) ~ Set<K> {
			result := Set->New()<K>;
			keys := ToVector();
			each(i : keys) {
				key := keys->Get(i);
				if(f(key)) {
					result->Insert(key);
				};
			};
			return result;
		}
	}

