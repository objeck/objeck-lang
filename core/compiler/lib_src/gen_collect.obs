mmap->Each(\(String, IntRef) ~ Nil : (k, v) => "{$k}={$v}"->PrintLine());
```
		~#
		method : public : Each(f : (K, V) ~ Nil) ~ MultiMap<K, V> {
			keys := GetKeys();
			each(i : keys) {
				key := keys->Get(i);
				values := Find(key);
				each(j : values) {
					f(key, values->Get(j));
				};
			};
			return @self;
		}

