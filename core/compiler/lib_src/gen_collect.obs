list->AddBack(IntRef->New(1));
list->Rewind();
while(list->More()) {
   list->Get()->PrintLine();
   list->Next();
};
```
		~#
		method : public : More() ~ Bool {
			return @cursor <> Nil;
		}

		#~
		Returns the first element in the list
		@return first element in the list, Nil if the list is empty

```
list := Collection.CompareList->New()<IntRef>;
list->AddBack(IntRef->New(10));
list->AddBack(IntRef->New(20));
list->Front()->PrintLine(); # 10
```
		~#
		method : public : Front() ~ H {
			if(@head <> Nil) {
				return @head->Get();
			};

			return Nil;
		}

		#~
		Returns the last element in the list
		@return last element in the list, Nil if the list is empty

```
list := Collection.CompareList->New()<IntRef>;
list->AddBack(IntRef->New(10));
list->AddBack(IntRef->New(20));
list->Back()->PrintLine(); # 20
```
		~#
		method : public : Back() ~ H {
			if(@tail <> Nil) {
				return @tail->Get();
			};

			return Nil;
		}

