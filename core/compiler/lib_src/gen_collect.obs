	#~
	Growable array of Int values; nothing is boxed

```
v := Collection.IntVector->New();
v->AddBack(3); v->AddBack(1); v->AddBack(2);
v->Sort();
v->Get(0)->PrintLine();   # 1
v->Sum()->PrintLine();    # 6
v->Size()->PrintLine();   # 3
```
	~#
	class IntVector {
		@values : Int[];
		@size : Int;

		#~
		Default constructor

```
v := Collection.IntVector->New();
v->AddBack(7);
v->Size()->PrintLine(); # 1
```
		~#
		New() {
			@values := Int->New[16];
			@size := 0;
		}

		#~
		Constructor that reserves room for a number of values
		@param capacity number of values to reserve

```
v := Collection.IntVector->New(1000);
v->Size()->PrintLine(); # 0
```
		~#
		New(capacity : Int) {
			if(capacity < 16) {
				capacity := 16;
			};
			@values := Int->New[capacity];
			@size := 0;
		}

		#~
		Copy constructor
		@param values values to copy

```
v := Collection.IntVector->New([5, 6, 7]);
v->Get(2)->PrintLine(); # 7
```
		~#
		New(values : Int[]) {
			capacity := values->Size();
			if(capacity < 16) {
				capacity := 16;
			};
			@values := Int->New[capacity];
			@size := values->Size();
			Runtime->Copy(@values, 0, values, 0, @size);
		}

		method : Grow(capacity : Int) ~ Nil {
			if(capacity < 16) {
				capacity := 16;
			};
			temp := Int->New[capacity];
			Runtime->Copy(temp, 0, @values, 0, @size);
			@values := temp;
		}

		#~
		Reserves room for at least a number of values
		@param capacity number of values

```
v := Collection.IntVector->New();
v->Reserve(1000000);
v->Size()->PrintLine(); # 0
```
		~#
		method : public : Reserve(capacity : Int) ~ Nil {
			if(capacity > @values->Size()) {
				Grow(capacity);
			};
		}

		#~
		Adds a value to the end
		@param value value

```
v := Collection.IntVector->New();
v->AddBack(42);
v->Get(0)->PrintLine(); # 42
```
		~#
		method : public : native : AddBack(value : Int) ~ Nil {
			if(@size = @values->Size()) {
				Grow(@size << 1);
			};
			@values[@size] := value;
			@size += 1;
		}

		#~
		Gets an indexed value
		@param index index
		@return value, or 0 if the index is out of range

```
v := Collection.IntVector->New([4, 5]);
v->Get(1)->PrintLine(); # 5
```
		~#
		method : public : native : Get(index : Int) ~ Int {
			if(index > -1 & index < @size) {
				return @values[index];
			};

			return 0;
		}

		#~
		Sets an indexed value
		@param value value
		@param index index
		@return true if set, false if the index is out of range

```
v := Collection.IntVector->New([4, 5]);
v->Set(9, 0)->PrintLine(); # true
v->Get(0)->PrintLine();    # 9
