#~
Generic collections library: Vector (dynamic array), Map (hash map), Set, MultiMap, Stack, Queue, and Pair. Provides typed iteration, sorting, filtering, and functional operations (Reduce, Any, All). Compile with -lib gen_collect.
~#
bundle Collection {
	#~
	Generic binary heap

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
        
heap->Insert(IntRef->New(3));
heap->Insert(IntRef->New(1));
heap->Insert(IntRef->New(9));
heap->Insert(IntRef->New(8));
heap->Insert(IntRef->New(6));
heap->Insert(IntRef->New(2));

while(<>heap->IsEmpty()) {
   heap->Pop()->PrintLine();
};
```
	~#
	class Heap<H : Compare> {
		@heap : H[];
		@length : Int;
		@min : Bool;
		@compare : (H, H) ~ Int;
		@has_compare : Bool;

		#~
		Heap sort order
		@class Heap
		~#
		enum Order {
			MIN,
			MAX
		}

		#~
		Constructor
		@param array array of values to insert
		@param order sort order

```
values := IntRef->New[3];
values[0] := 5; values[1] := 2; values[2] := 8;
heap := Collection.Heap->New(values, Collection.Heap->Order->MIN)<IntRef>;
heap->Pop()->PrintLine(); # 2
```
		~#
		New(array : H[], order : Heap->Order) {
			@heap := H->New[16];
			@length := 0;
			@min := order = Heap->Order->MIN ? true : false;

			each(elem in array) {
				Insert(elem);
			};
		}

	   #~
		Constructor
		@param order sort order

```
heap := Collection.Heap->New(Collection.Heap->Order->MAX)<IntRef>;
heap->Insert(IntRef->New(5));
heap->Insert(IntRef->New(9));
heap->Pop()->PrintLine(); # 9
```
		~#
		New(order : Heap->Order) {
			@heap := H->New[16];
			@length := 0;
			@min := order = Heap->Order->MIN ? true : false;
		}

		#~
		Constructor that orders the values with a comparator instead of their Compare method
		@param order sort order: MIN pops the value the comparator ranks lowest first
		@param compare comparator: negative if the first value ranks lower, 0 if equal, positive if higher

```
# longest string first
heap := Collection.Heap->New(Collection.Heap->Order->MAX,
  \(String, String) ~ Int : (a, b) => a->Size() - b->Size())<String>;
heap->Insert("fig"); heap->Insert("banana"); heap->Insert("kiwi");
heap->Pop()->PrintLine(); # banana
```
		~#
		New(order : Heap->Order, compare : (H, H) ~ Int) {
			@heap := H->New[16];
			@length := 0;
			@min := order = Heap->Order->MIN ? true : false;
			@compare := compare;
			@has_compare := true;
		}

		#~
		Constructor for a min-heap ordered by a comparator: Pop returns the value the comparator ranks lowest
		@param compare comparator: negative if the first value ranks lower, 0 if equal, positive if higher

```
heap := Collection.Heap->New(\(IntRef, IntRef) ~ Int : (a, b) => b->Get() - a->Get())<IntRef>;
heap->Insert(IntRef->New(1)); heap->Insert(IntRef->New(5));
heap->Pop()->PrintLine(); # 5: the comparator reverses the order
```
		~#
		New(compare : (H, H) ~ Int) {
			@heap := H->New[16];
			@length := 0;
			@min := true;
			@compare := compare;
			@has_compare := true;
		}

		#~
		Returns a list of non-Nil values
		@return list of values

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(3));
heap->Insert(IntRef->New(1));
arr := heap->ToArray();
arr[0]->PrintLine(); # smallest element
```
		~#
		method : public : ToArray() ~ H[] {
			buffer := H->New[@length];

			i := 0;
			each(elem := @heap) {
				if(elem <> Nil) {
					buffer[i++] := elem;
				};
			};

			return buffer;
		}

		#~
		Returns the heap capacity
		@return heap capacity

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Capacity()->PrintLine(); # initial capacity (16)
```
		~#
		method : public : Capacity() ~ Int {
			return @heap->Size();
		}

		#~
		Inserts a value into the heap and extends the heap size if necessary
		@param value value to insert

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(7));
heap->Insert(IntRef->New(2));
heap->Insert(IntRef->New(5));
heap->Top()->PrintLine(); # 2
```
		~#
		method : public : Insert(value : H) ~ Nil {
			if(@length >= @heap->Size() - 1) {
				@heap := Resize();
			};

			@length++;
			@heap[@length] := value;

			ShiftUp();
		}

		#~
		Pop either the smallest or largest value depending upon the sort order
		@return smallest or largest value

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(4));
heap->Insert(IntRef->New(1));
heap->Pop()->PrintLine(); # 1
heap->Pop()->PrintLine(); # 4
```
		~#
		method : public : Pop() ~ H {
			result := Top();
			if(result = Nil) {
				return Nil;
			};

			Swap(1, @length);
			@heap[@length] := Nil;
			@length--;

			ShiftDown();

			return result;
		}

		#~
		Searches and pops the given value
		@param value value to remove
		@return true if successful, false otherwise

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(3));
heap->Insert(IntRef->New(7));
heap->Pop(IntRef->New(7))->PrintLine(); # true
heap->Size()->PrintLine();              # 1
```
		~#
		method : public : Pop(value : H) ~ Bool {
			each(i : @heap) {
				elem := @heap[i];
				if(elem <> Nil) {
					if(Order(value, elem) = 0) {
						Swap(i, @length);
						@heap[@length] := Nil;
						@length--;

						if(@length > 0 & i <= @length) {
							ShiftDown(i);
							ShiftUp(i);
						};

						return true;
					};
				};
			};

			return false;
		}

		#~
		Checks to see if the heap is empty
		@return true if empty, false otherwise

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->IsEmpty()->PrintLine(); # true
heap->Insert(IntRef->New(1));
heap->IsEmpty()->PrintLine(); # false
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @length <= 0;
		}

		#~
		Check the top of the stack
		@return value on the top of stack, Nil if stack is empty

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(5));
heap->Insert(IntRef->New(2));
heap->Top()->PrintLine(); # 2
```
		~#
		method : public : Top() ~ H {
			if(IsEmpty()) {
				return Nil;
			};

			return @heap[1];
		}

		#~
		Returns the value Pop would return, without removing it; the same as Top
		@return smallest or largest value, Nil if the heap is empty

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(5)); heap->Insert(IntRef->New(2));
heap->Peek()->PrintLine(); # 2
heap->Size()->PrintLine(); # 2
```
		~#
		method : public : Peek() ~ H {
			return Top();
		}

		method : Order(a : H, b : H) ~ Int {
			if(@has_compare) {
				return @compare(a, b);
			};
			return a->Compare(b);
		}

		#~
		Size of heap, including Nil values
		@return size of heap

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(1));
heap->Insert(IntRef->New(2));
heap->Size()->PrintLine(); # 2
```
		~#
		method : public : Size() ~ Int {
			return @length;
		}

		method : Resize() ~ H[] {
			temp := H->New[@heap->Size() * 2];
			Runtime->Copy(temp, 0, @heap, 0, @heap->Size());
			return temp;
		}

		method : ShiftUp() ~ Nil {
			ShiftUp(@length);
		}

		method : ShiftUp(index : Int) ~ Nil {
			if(@min) {
				while(HasParent(index) & (Order(GetParent(index), @heap[index]) > 0)) {
					Swap(index, GetParentIndex(index));
					index := GetParentIndex(index);
				}   
			}
			else {
				while(HasParent(index) & (Order(GetParent(index), @heap[index]) < 0)) {
					Swap(index, GetParentIndex(index));
					index := GetParentIndex(index);
				};  
			};
		}

		method : ShiftDown() ~ Nil {
			ShiftDown(1);
		}

		method : ShiftDown(index : Int) ~ Nil {
			if(@min) {
				while(HasLeftChild((index))) {
					smaller := GetLeftIndex(index);
					if(HasRightChild(index) & Order(@heap[GetLeftIndex(index)], @heap[GetRightIndex(index)]) > 0) {
						smaller := GetRightIndex(index);
					}

					if(Order(@heap[index], @heap[smaller]) > 0) {
						Swap(index, smaller);
					}
					else {
						break;
					};
					index := smaller;
				}               
			}
			else {
				while(HasLeftChild((index))) {
					larger := GetLeftIndex(index);
					if(HasRightChild(index) & Order(@heap[GetLeftIndex(index)], @heap[GetRightIndex(index)]) < 0) {
						larger := GetRightIndex(index);
					}

					if(Order(@heap[index], @heap[larger]) < 0) {
						Swap(index, larger);
					}
					else { 
						break;
					};
					index := larger;
				}               
			}
		}

		method : HasParent(i : Int) ~ Bool {
			return i > 1;
		}

		method : GetLeftIndex(i : Int)  ~ Int {
			return i * 2;
		}

		method : GetRightIndex(i : Int) ~ Int {
			return i * 2 + 1;
		}

		method : HasLeftChild(i : Int) ~ Bool {
			return GetLeftIndex(i) <= @length;
		}

		method : HasRightChild(i : Int) ~ Bool {
			return GetRightIndex(i) <= @length;
		}

		method : GetParentIndex(i : Int) ~ Int {
			return i / 2;
		}

		method : GetParent(i : Int) ~ H {
			return @heap[GetParentIndex(i)];
		}

		method : Swap(index1 : Int, index2 : Int) ~ Nil {
			temp := @heap[index1];
			@heap[index1] := @heap[index2];
			@heap[index2] := temp;
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
heap := Collection.Heap->New(Collection.Heap->Order->MIN)<IntRef>;
heap->Insert(IntRef->New(3));
heap->Insert(IntRef->New(1));
heap->ToString()->PrintLine();
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			for(i := 0; i < @heap->Size(); i += 1;) {
				elem := @heap[i];

				if(elem <> Nil) {
					if(elem->TypeOf(Stringify)) {
						buffer->Append(elem->As(System.Stringify)->ToString());
					}
					else {
						buffer->Append(elem->GetInstanceID()->ToHexString());
					};

					if(i + 1 < @heap->Size() & @heap[i + 1] <> Nil) {
						buffer->Append(',');
					};
				};
			};
			buffer->Append(']')

			return buffer;
		}
	}

	#~
	MRU/LRU object cache
	
	```
cache := Collection.Cache->New(Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(415, "San Francisco");
cache->Insert(925, "East Bay");
cache->Insert(650, "Mountain View");

cache->Find(650)->PrintLine();
cache->Find(650)->PrintLine();

cache->Find(415)->PrintLine();

cache->Find(925)->PrintLine();
cache->Find(925)->PrintLine();

cache->Insert(510, "Oakland");
cache->Find(510)->PrintLine();
cache->Find(510)->PrintLine();
cache->Find(510)->PrintLine();

"---"->PrintLine();
values := cache->GetKeys()<IntRef>;
each(value := values) {
   value->PrintLine();
};
	```	
	~#
	class Cache<K : Compare, S> {
		@type : Cache->Type;
		@max : Int;
		@cache : Map<K, S>;
		@nodes : Hash<K, CacheNode<K> >;
		@head : CacheNode<K>;
		@tail : CacheNode<K>;

		#~
		Cache type
		@class Cache
		~#
		enum Type {
			LRU,
			MRU
		}

		#~
		Default constructor
		@param type MRU or LRU cache
		@param max cache max size

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(1, "one");
cache->Insert(2, "two");
cache->Find(1)->PrintLine(); # one
```
		~#
		New(type : Cache->Type, max : Int) {
			@type := type;
			@max := max;
			@cache := Map->New()<K, S>;
			@nodes := Hash->New()<K, CacheNode<K> >;
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 2)<IntRef, String>;
cache->Insert(10, "ten");
cache->Insert(20, "twenty");
cache->ToString()->PrintLine();
```
		~#
		method : public : ToString() ~ String {
			return @cache->ToString();
		}

		#~
		Inserts a value into the cache. A new key in a full cache first evicts the least (LRU) or most (MRU) recently used entry; an existing key is updated and becomes the most recently used.
		@param key key
		@param value value
		@return true if inserted, false if the key is Nil or the cache size is less than 1

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(1, "alpha");
cache->Insert(2, "beta");
cache->Size()->PrintLine(); # 2
```
		~#
		method : public : Insert(key : K, value : S) ~ Bool {
			if(key = Nil | @max < 1) {
				return false;
			};

			node := @nodes->Find(key);
			if(node <> Nil) {
				Unlink(node);
				PushFront(node);
				@cache->Insert(key, value);
				return true;
			};

			if(@nodes->Size() >= @max) {
				Evict();
			};

			node := CacheNode->New(key)<K>;
			PushFront(node);
			@nodes->Insert(key, node);
			@cache->Insert(key, value);

			return true;
		}

		#~
		Removes a value from the cache
		@param key key for value to remove
		@return true if removed, false otherwise

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(5, "five");
cache->Remove(5)->PrintLine(); # true
cache->Has(5)->PrintLine();    # false
```
		~#
		method : public : Remove(key : K) ~ Bool {
			node := @nodes->Find(key);
			if(node <> Nil) {
				Unlink(node);
				@nodes->Remove(key);
				@cache->Remove(key);
				return true;
			};

			return false;
		}

		method : Evict() ~ Bool {
			victim : CacheNode<K>;
			if(@type = Cache->Type->LRU) {
				victim := @tail;
			}
			else {
				victim := @head;
			};

			if(victim <> Nil) {
				key := victim->GetKey();
				Unlink(victim);
				@nodes->Remove(key);
				@cache->Remove(key);
				return true;
			};

			return false;
		}

		method : Unlink(node : CacheNode<K>) ~ Nil {
			prev := node->GetPrevious();
			next := node->GetNext();

			if(prev <> Nil) {
				prev->SetNext(next);
			}
			else {
				@head := next;
			};

			if(next <> Nil) {
				next->SetPrevious(prev);
			}
			else {
				@tail := prev;
			};

			node->SetPrevious(Nil);
			node->SetNext(Nil);
		}

		method : PushFront(node : CacheNode<K>) ~ Nil {
			node->SetNext(@head);
			if(@head <> Nil) {
				@head->SetPrevious(node);
			};
			@head := node;

			if(@tail = Nil) {
				@tail := node;
			};
		}

		#~
		Get a collection of keys
		@return vector of keys

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(1, "a");
cache->Insert(2, "b");
keys := cache->GetKeys()<IntRef>;
keys->Size()->PrintLine(); # 2
```
		~#
		method : public : GetKeys() ~ Vector<K> {
			return @cache->GetKeys()<K>;
		}

		#~
		Gets a collection of values
		@return vector of values

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(1, "alpha");
cache->Insert(2, "beta");
vals := cache->GetValues()<String>;
each(v := vals) {
   v->PrintLine();
};
```
		~#
		method : public : GetValues() ~ Vector<S> {
			return @cache->GetValues()<S>;
		}

		#~
		Gets a collection of key/value pairs
		@return vector of key/value pairs

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 2)<IntRef, String>;
cache->Insert(10, "ten");
kvs := cache->GetKeyValues()<Collection.Pair<IntRef, String>>;
kvs->Size()->PrintLine(); # 1
```
		~#
		method : public : GetKeyValues() ~ Vector<Pair<K, S>> {
			return @cache->GetKeyValues()<Pair<K, S>>;
		}

		#~
		Searches for a value in cache and updates access priority for LRU/MRU
		@param key search key
		@return found value, Nil if not found

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(1, "one");
cache->Find(1)->PrintLine();  # one
cache->Find(99)->PrintLine(); # (Nil — nothing printed)
```
		~#
		method : public : Find(key : K) ~ S {
			value := @cache->Find(key);
			if(value <> Nil) {
				node := @nodes->Find(key);
				if(node <> Nil) {
					Unlink(node);
					PushFront(node);
				};
			};
			return value;
		}

		#~
		Checks for a value in a cache
		@param key search key
		@return true if found, false otherwise

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(7, "seven");
cache->Has(7)->PrintLine();  # true
cache->Has(99)->PrintLine(); # false
```
		~#
		method : public : Has(key : K) ~ Bool {
			return @cache->Find(key) <> Nil;
		}

		#~
		Size of cache
		@return size of cache

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(1, "a");
cache->Size()->PrintLine(); # 1
```
		~#
		method : public : Size() ~ Int {
			return @cache->Size();
		}

		#~
		Checks to see if the cache is empty
		@return true if empty, false otherwise

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->IsEmpty()->PrintLine(); # true
cache->Insert(1, "a");
cache->IsEmpty()->PrintLine(); # false
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @cache->IsEmpty();
		}

		#~
		Clears the cache

```
cache := Collection.Cache->New(Collection.Cache->Type->LRU, 3)<IntRef, String>;
cache->Insert(1, "a");
cache->Empty();
cache->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : Empty() ~ Nil {
			@cache->Empty();
			@nodes->Empty();
			@head := Nil;
			@tail := Nil;
		}
	}

	class : private : CacheNode<K : Compare> {
		@key : K;
		@previous : CacheNode<K>;
		@next : CacheNode<K>;

		New(key : K) {
			@key := key;
		}

		method : public : GetKey() ~ K {
			return @key;
		}

		method : public : GetPrevious() ~ CacheNode<K> {
			return @previous;
		}

		method : public : SetPrevious(previous : CacheNode<K>) ~ Nil {
			@previous := previous;
		}

		method : public : GetNext() ~ CacheNode<K> {
			return @next;
		}

		method : public : SetNext(next : CacheNode<K>) ~ Nil {
			@next := next;
		}
	}

	#~
	Hash-based set for O(1) membership testing without storing values

```
set := Collection.HashSet->New()<IntRef>;
set->Add(IntRef->New(1));
set->Add(IntRef->New(2));
set->Add(IntRef->New(3));

set->Has(IntRef->New(2))->PrintLine(); # true
set->Has(IntRef->New(5))->PrintLine(); # false

set->Remove(IntRef->New(2));
set->Has(IntRef->New(2))->PrintLine(); # false
```
	~#
	class HashSet<H : Compare> {
		@hash : Hash<H, BoolRef>;

		#~
		Default constructor

```
set := Collection.HashSet->New()<String>;
set->Add("apple");
set->Add("banana");
set->Size()->PrintLine(); # 2
```
		~#
		New() {
			@hash := Hash->New()<H, BoolRef>;
		}

		#~
		Adds a value to the set
		@param value value to add
		@return true if added, false if already exists

```
set := Collection.HashSet->New()<String>;
set->Add("apple")->PrintLine();  # true
set->Add("apple")->PrintLine();  # false (duplicate)
set->Size()->PrintLine();        # 1
```
		~#
		method : public : Add(value : H) ~ Bool {
			if(value = Nil) {
				return false;
			};
			return @hash->InsertIfAbsent(value, true);
		}

		#~
		Checks if a value exists in the set
		@param value value to check
		@return true if found, false otherwise

```
set := Collection.HashSet->New()<String>;
set->Add("hello");
set->Has("hello")->PrintLine(); # true
set->Has("world")->PrintLine(); # false
```
		~#
		method : public : Has(value : H) ~ Bool {
			return @hash->Has(value);
		}

		#~
		Removes a value from the set
		@param value value to remove
		@return true if removed, false if not found

```
set := Collection.HashSet->New()<String>;
set->Add("hello");
set->Remove("hello")->PrintLine(); # true
set->Has("hello")->PrintLine();    # false
```
		~#
		method : public : Remove(value : H) ~ Bool {
			return @hash->Remove(value);
		}

		#~
		Size of set
		@return number of elements

```
set := Collection.HashSet->New()<String>;
set->Add("a");
set->Add("b");
set->Size()->PrintLine(); # 2
```
		~#
		method : public : Size() ~ Int {
			return @hash->Size();
		}

		#~
		Checks if set is empty
		@return true if empty, false otherwise

```
set := Collection.HashSet->New()<String>;
set->IsEmpty()->PrintLine(); # true
set->Add("x");
set->IsEmpty()->PrintLine(); # false
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @hash->IsEmpty();
		}

		#~
		Clears the set

```
set := Collection.HashSet->New()<String>;
set->Add("a");
set->Empty();
set->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : Empty() ~ Nil {
			@hash->Empty();
		}

		#~
		Gets all values as a vector
		@return vector of values

```
set := Collection.HashSet->New()<String>;
set->Add("x");
set->Add("y");
v := set->ToVector()<String>;
v->Size()->PrintLine(); # 2
```
		~#
		method : public : ToVector() ~ Vector<H> {
			return @hash->GetKeys()<H>;
		}

		#~
		Gets all values as an array
		@return array of values

```
set := Collection.HashSet->New()<String>;
set->Add("p");
set->Add("q");
arr := set->ToArray();
arr->Size()->PrintLine(); # 2
```
		~#
		method : public : ToArray() ~ H[] {
			keys := @hash->GetKeys()<H>;
			array := H->New[keys->Size()];
			each(i : keys) {
				array[i] := keys->Get(i);
			};
			return array;
		}

		#~
		Formats the set into a string
		@return string representation

```
set := Collection.HashSet->New()<String>;
set->Add("a");
set->Add("b");
set->ToString()->PrintLine();
```
		~#
		method : public : ToString() ~ String {
			buffer := "{";
			keys := @hash->GetKeys()<H>;
			each(i : keys) {
				value := keys->Get(i);
				if(value->TypeOf(Stringify)) {
					buffer->Append(value->As(System.Stringify)->ToString());
				}
				else {
					buffer->Append(value->GetInstanceID()->ToHexString());
				};
				if(i + 1 < keys->Size()) {
					buffer->Append(',');
				};
			};
			buffer->Append('}');
			return buffer;
		}

		#~
		Inserts a value into the set; the same as Add, for the method name Set and SetHash use
		@param value value to insert

```
set := Collection.HashSet->New()<String>;
set->Insert("apple");
set->Has("apple")->PrintLine(); # true
```
		~#
		method : public : Insert(value : H) ~ Nil {
			Add(value);
		}

		#~
		Gets all values as a vector; the same as ToVector, for the method name Set and SetHash use
		@return vector of values

```
set := Collection.HashSet->New()<String>;
set->Insert("x"); set->Insert("y");
set->GetKeys()->Size()->PrintLine(); # 2
```
		~#
		method : public : GetKeys() ~ Vector<H> {
			return ToVector();
		}

		#~
		Elements in this set, the other set, or both. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.HashSet->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.HashSet->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Union(b)->Size()->PrintLine(); # 4
```
		~#
		method : public : Union(that : HashSet<H>) ~ HashSet<H> {
			result := HashSet->New()<H>;
			keys := ToVector();
			each(i : keys) {
				result->Insert(keys->Get(i));
			};
			if(that <> Nil) {
				keys := that->ToVector();
				each(i : keys) {
					result->Insert(keys->Get(i));
				};
			};
			return result;
		}

		#~
		Elements in both this set and the other set. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.HashSet->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.HashSet->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Intersect(b)->Size()->PrintLine(); # 2
```
		~#
		method : public : Intersect(that : HashSet<H>) ~ HashSet<H> {
			result := HashSet->New()<H>;
			keys := ToVector();
			each(i : keys) {
				key := keys->Get(i);
				if(that = Nil) {
				}
				else if(that->Has(key)) {
					result->Insert(key);
				};
			};
			return result;
		}

		#~
		Elements in this set that are not in the other set. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.HashSet->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.HashSet->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Difference(b)->Has(1)->PrintLine(); # true
```
		~#
		method : public : Difference(that : HashSet<H>) ~ HashSet<H> {
			result := HashSet->New()<H>;
			keys := ToVector();
			each(i : keys) {
				key := keys->Get(i);
				if(that = Nil) {
					result->Insert(key);
				}
				else if(<>that->Has(key)) {
					result->Insert(key);
				};
			};
			return result;
		}

		#~
		Elements in exactly one of the two sets. Neither set is changed.
		@param that other set (Nil counts as empty)
		@return new set

```
a := Collection.HashSet->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.HashSet->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->SymmetricDifference(b)->Size()->PrintLine(); # 2 (1 and 4)
```
		~#
		method : public : SymmetricDifference(that : HashSet<H>) ~ HashSet<H> {
			result := Difference(that);
			if(that <> Nil) {
				keys := that->ToVector();
				each(i : keys) {
					if(<>Has(keys->Get(i))) {
						result->Insert(keys->Get(i));
					};
				};
			};
			return result;
		}

		#~
		Checks that every element of this set is in the other set. The empty set is a subset of every set.
		@param that other set (Nil counts as empty)
		@return true if this set is a subset of the other, false otherwise

```
a := Collection.HashSet->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.HashSet->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Intersect(b)->IsSubset(b)->PrintLine(); # true
a->IsSubset(b)->PrintLine(); # false
```
		~#
		method : public : IsSubset(that : HashSet<H>) ~ Bool {
			if(that = Nil) {
				return IsEmpty();
			};
			if(Size() > that->Size()) {
				return false;
			};
			keys := ToVector();
			each(i : keys) {
				if(<>that->Has(keys->Get(i))) {
					return false;
				};
			};
			return true;
		}

		#~
		Checks that every element of the other set is in this set
		@param that other set (Nil counts as empty)
		@return true if this set is a superset of the other, false otherwise

```
a := Collection.HashSet->New()<IntRef>;
a->Insert(1); a->Insert(2); a->Insert(3);
b := Collection.HashSet->New()<IntRef>;
b->Insert(2); b->Insert(3); b->Insert(4);
a->Union(b)->IsSuperset(a)->PrintLine(); # true
```
		~#
		method : public : IsSuperset(that : HashSet<H>) ~ Bool {
			if(that = Nil) {
				return true;
			};
			return that->IsSubset(@self);
		}

		#~
		Calls a function for each element
		@param f function called
		@return this set

```
set := Collection.HashSet->New()<String>;
set->Insert("x"); set->Insert("y");
set->Each(\(s) => { s->PrintLine(); });
```
		~#
		method : public : Each(f : (H) ~ Nil) ~ HashSet<H> {
			keys := ToVector();
			each(i : keys) {
				f(keys->Get(i));
			};
			return @self;
		}

		#~
		Keeps the elements a function accepts. The set is not changed.
		@param f function that returns true for each element to keep
		@return new set

```
set := Collection.HashSet->New()<String>;
set->Insert("apple"); set->Insert("kiwi");
set->Filter(\(s) => s->Size() > 4)->Size()->PrintLine(); # 1
```
		~#
		method : public : Filter(f : (H) ~ Bool) ~ HashSet<H> {
			result := HashSet->New()<H>;
			keys := ToVector();
			each(i : keys) {
				key := keys->Get(i);
				if(f(key)) {
					result->Insert(key);
				};
			};
			return result;
		}
	}

	#~
	Collection pair that implements Compare interface for use in sorted collections

```
pair := Collection.Pair->New(IntRef->New(1), "one")<IntRef, String>;
pair->GetFirst()->PrintLine();
pair->GetSecond()->PrintLine();
