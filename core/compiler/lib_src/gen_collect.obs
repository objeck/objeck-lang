	class : private : ListNode<H> {
		@value : H;
		@next : ListNode<H>;
		@previous: ListNode<H>;

		New(value : H) {
			@value := value;
		}
		
		method : public : Set(value : H) ~ Nil {
			@value := value;
		}
	
		method : public : Get() ~ H {
			return @value;
		}

		method : public : SetNext(next :  ListNode<H>) ~ Nil {
			@next := next;
		}
	
		method : public : GetNext() ~ ListNode<H> {
			return @next;
		}

		method : public : SetPrevious(previous :  ListNode<H>) ~ Nil {
			@previous := previous;
		}
	
		method : public : GetPrevious() ~ ListNode<H> {
			return @previous;
		}
	}
	
	#~
	Growable generic array
	
	```
	function : Example() ~ Nil {	
	   # insert elements
	   vector := Collection.Vector->New()<IntRef>;
	   vector->AddBack(4);
	   vector->AddBack(1);
	   vector->AddBack(5);
	   vector->AddBack(1);
	   vector->AddBack(0);
   
	   # remove last item
	   vector->RemoveBack();
   
	   # get size
	   vector->Size()->PrintLine();
	   
	   # get elements
	   (vector->Get(0) + vector->Get(1))->PrintLine();
   
	   # print all items with a loop
	   each(item := vector) {
	   	item->PrintLine();
	   };
   
	   # print all items with a function
	   vector->Each(Show(IntRef) ~ Nil);
	}

	function : Show(value : IntRef) ~ Nil {
	   value->PrintLine();
	}
	```
	~#
	class Vector<H> {
		@values : H[];
		@size : Int;

		#~
		Default constructor

```
v := Collection.Vector->New()<String>;
v->AddBack("hello");
v->Size()->PrintLine(); # 1
```
		~#
		New() {
			@values := H->New[32];
			@size := 0;
		}

		#~
		Copy constructor
		@param values values to copy

```
arr := String->New[2];
arr[0] := "a"; arr[1] := "b";
v := Collection.Vector->New(arr)<String>;
v->Size()->PrintLine(); # 2
```
		~#
		New(values : H[]) {
			@values := H->New[values->Size()];
			@size := values->Size();
			Runtime->Copy(@values, 0, values, 0, @size);
 		}

		method : public : Reserve(capacity : Int) ~ Nil {
			if(capacity < 1) {
				capacity := 1;
			};

			if(capacity > @values->Size()) {
				temp : H[] := H->New[capacity];
				Runtime->Copy(temp, 0, @values, 0, @size);
				@values := temp;
			};
		}

		#~
		Copy constructor
		@param values values to copy

```
src := Collection.Vector->New()<String>;
src->AddBack("x");
copy := Collection.Vector->New(src)<String>;
copy->Get(0)->PrintLine(); # x
```
		~#
		New(values : Vector<H>) {
			@values := values->ToArray();
			@size := values->Size();
		}

		method : Expand() ~ Nil {
			if(@size >= @values->Size()) {
				grow := @size >> 1;
				if(grow < 4) {
					grow := 4;
				};
				temp : H[] := H->New[@size + grow];
				Runtime->Copy(temp, 0, @values, 0, @size);
				@values := temp;
			};
		}

		#~
		Zip two vectors together
		@return list of pairs

```
a := Collection.Vector->New()<String>;
a->AddBack("x"); a->AddBack("y");
b := Collection.Vector->New()<String>;
b->AddBack("1"); b->AddBack("2");
zipped := Collection.Vector->Zip(a, b)<String>;
zipped->Get(0)->GetFirst()->PrintLine(); # x
```
		~#
		function : Zip(a : Vector<H>, b : Vector<H>) ~ Vector<Collection.Tuple.Pair<H,H>> {
			max := a->Size();
			if(b->Size() < max) {
				max := b->Size();
			};

			zipped := Vector->New()<Collection.Tuple.Pair<H,H>>;
			zipped->Reserve(max);
			each(i : max) {
				tuple := Collection.Tuple.Pair->New(a->Get(i), b->Get(i))<H, H>;
				zipped->AddBack(tuple)<Collection.Tuple.Pair<H,H>>;
			};

			return zipped;
		}

		#~
		Zip three vectors together
		@return list of triplets

```
a := Collection.Vector->New()<String>;
a->AddBack("x");
b := Collection.Vector->New()<String>;
b->AddBack("y");
c := Collection.Vector->New()<String>;
c->AddBack("z");
zipped := Collection.Vector->Zip(a, b, c)<String>;
zipped->Size()->PrintLine(); # 1
```
		~#
		function : Zip(a : Vector<H>, b : Vector<H>, c : Vector<H>) ~ Vector<Collection.Tuple.Triplet<H,H,H>> {
			max := a->Size();
			if(b->Size() < max) {
				max := b->Size();
			};
			if(c->Size() < max) {
				max := c->Size();
			};

			zipped := Vector->New()<Collection.Tuple.Triplet<H,H,H>>;
			zipped->Reserve(max);
			each(i : max) {
				tuple := Collection.Tuple.Triplet->New(a->Get(i), b->Get(i), c->Get(i))<H,H,H>;
				zipped->AddBack(tuple)<Collection.Tuple.Triplet<H,H,H>>;
			};
			
			return zipped;
		}

		#~
		Zip four vectors together
		@return list of quartets

```
a := Collection.Vector->New()<String>;
a->AddBack("p");
b := Collection.Vector->New()<String>;
b->AddBack("q");
c := Collection.Vector->New()<String>;
c->AddBack("r");
d := Collection.Vector->New()<String>;
d->AddBack("s");
zipped := Collection.Vector->Zip(a, b, c, d)<String>;
zipped->Size()->PrintLine(); # 1
```
		~#
		function : Zip(a : Vector<H>, b : Vector<H>, c : Vector<H>, d : Vector<H>) ~ Vector<Collection.Tuple.Quartet<H,H,H,H>> {
			max := a->Size();
			if(b->Size() < max) {
				max := b->Size();
			};
			if(c->Size() < max) {
				max := c->Size();
			};
			if(d->Size() < max) {
				max := d->Size();
			};

			zipped := Vector->New()<Collection.Tuple.Quartet<H,H,H,H>>;
			zipped->Reserve(max);
			each(i : max) {
				tuple := Collection.Tuple.Quartet->New(a->Get(i), b->Get(i), c->Get(i), d->Get(i))<H,H,H,H>;
				zipped->AddBack(tuple)<Collection.Tuple.Quartet<H,H,H,H>>;
			};
			
			return zipped;
		}

		#~
		Reverses element order
		@return reversed vector, if the vector is empty or hold 1 item then the original list is returned

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b"); v->AddBack("c");
rev := v->Reverse();
rev->Get(0)->PrintLine(); # c
```
		~#
		method : public : Reverse() ~ Vector<H> {
			if(@size < 2) {
				return @self;
			}

			len := @size;
			reversed := Collection.Vector->New()<H>;
			reversed->Reserve(@size);
			each(i : @size) {
				reversed->AddBack(@values[--len])
			};

			return reversed;
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b");
v->ToString()->PrintLine(); # [a,b]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			each(i : @size) {
				# get string value if instance implements 'Stringify'
				value := @values[i];
				if(value->TypeOf(Stringify)) {
					buffer->Append(value->As(System.Stringify)->ToString());
				}
				# use instance ID instead
				else {
					buffer->Append(value->GetInstanceID()->ToHexString());
				};

				# add comma
				if(i + 1 < @size) {
					buffer->Append(',');
				};
			};
			buffer->Append(']');

			return buffer;
		}

		#~
		Compresses the Vector freeing unused memory

```
v := Collection.Vector->New()<String>;
v->AddBack("x"); v->AddBack("y");
v->Compress();
v->Size()->PrintLine(); # 2
```
		~#
		method : public : Compress() ~ Nil {
			temp : H[] := H->New[@size];
			Runtime->Copy(temp, 0, @values, 0, @size);
			@values := temp;
		}

		#~
		Maps the given function to each value in the vector
		@param f function to apply
		@return newly calculated vector

```
v := Collection.Vector->New()<String>;
v->AddBack("hello"); v->AddBack("world");
upper := v->Map(\(String) ~ String : (s) => s->ToUpper());
upper->Get(0)->PrintLine(); # HELLO
lengths := v->Map(\(String) ~ IntRef : (s) => IntRef->New(s->Size())); # a Vector<IntRef>
```
		~#
		method : public : Map<R>(f : (H) ~ R) ~ Vector<R> {
			array : R[] := Base->New[@size];
			for(i : Int := 0; i < @size; i += 1;) {
				array[i] := f(@values[i]);
			};

			return Vector->New(array)<R>;
		}

		#~
		Function called for each element
		@param f function called

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b");
v->Each(\(String) ~ Nil : (s) => s->PrintLine());
```
		~#
		method : public : Each(f : (H) ~ Nil) ~ Vector<H> {
			for(i : Int := 0; i < @size; i += 1;) {
				f(@values[i]);
			};
			return @self;
		}

		#~
		Uses the given function to filter out values
		@param f function to use a filter. If the function evaluates to true the value is added to the collection.
		@return filtered vector

```
v := Collection.Vector->New()<String>;
v->AddBack("apple"); v->AddBack("banana"); v->AddBack("avocado");
filtered := v->Filter(\(String) ~ Bool : (s) => s->StartsWith("a"));
filtered->Size()->PrintLine(); # 2
```
		~#
		method : public : Filter(f : (H) ~ Bool) ~ Vector<H> {
			filtered := Vector->New()<H>;
			filtered->Reserve(@size);

			for(i : Int := 0; i < @size; i += 1;) {
				if(f(@values[i])) {
					filtered->AddBack(@values[i]);
				};
			};

			return filtered;
		}

		#~
		Uses the given function to reduce the values
		@param a initial value (i.e. accumulator)
		@param f function to use a reduce
		@return reduced value

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b"); v->AddBack("c");
joined := v->Reduce("", \(String, String) ~ String : (acc, s) => acc + s);
joined->PrintLine(); # abc
```
		~#
		method : public : Reduce(a : H, f : (H, H) ~ H) ~ H {
			for(i : Int := 0; i < @size; i += 1;) {
				a := f(a, @values[i]);
			};

			return a;
		}

		#~
		Returns a limited list
		@param l limit
		@return limited list

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b"); v->AddBack("c");
first2 := v->Limit(2);
first2->Size()->PrintLine(); # 2
```
		~#
		method : public : Limit(l : Int) ~ Vector<H> {
			if(l > -1 & l < @size) {
				array := H->New[l];
				for(i : Int := 0; i < l; i += 1;) {
					array[i] := @values[i];
				};
				return Vector->New(array)<H>;
			};
      		
			return Vector->New()<H>;
		}
		
		#~
		Swap two values in the vector
		@param a first value
		@param b second value
		@return true if values were swapped

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b");
v->Swap(0, 1)->PrintLine(); # true
v->Get(0)->PrintLine(); # b
```
		~#
		method : public : Swap(a : Int, b : Int) ~ Bool {
			if(a < 0 | b < 0 | a >= @size | b >= @size) {
				return false;
			};
			
			temp := @values[a];
			@values[a] := @values[b];
			@values[b] := temp;
			
			return true;
		}

		#~
		Adds a value to the end
		@param value value to append

```
v := Collection.Vector->New()<String>;
v->AddBack("first");
v->AddBack("second");
v->Size()->PrintLine(); # 2
```
		~#
		method : public : AddBack(value : H) ~ Nil {
			Expand();
			@values[@size] := value;
			@size += 1;
		}

		#~
		Removes the last value
		@return value

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b");
v->RemoveBack()->PrintLine(); # b
v->Size()->PrintLine();       # 1
```
		~#
		method : public : RemoveBack() ~ H {
			if(@size > 0) {
				@size -= 1;
				value := @values[@size];
				@values[@size] := Nil;
				return value;
			};

			return Nil;
		}

		#~
		Removes an indexed value
		@param i index
		@return value

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b"); v->AddBack("c");
v->Remove(1)->PrintLine(); # b
v->Size()->PrintLine();    # 2
```
		~#
		method : public : Remove(i : Int) ~ H {
			if(i > -1 & i < @size) {
				value := @values[i];
				@size -= 1;
				Runtime->Copy(@values, i, @values, i + 1, @size - i);
				@values[@size] := Nil;
				return value;
			};

			return Nil;
		}

		#~
		Gets an indexed value
		@param index index
		@return value, or Nil if invalid index

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b");
v->Get(0)->PrintLine(); # a
v->Get(1)->PrintLine(); # b
```
		~#
		method : public : Get(index : Int) ~ H {
			if(index > -1 & index < @size) {
				return @values[index];
			};

			return Nil;
		}

		#~
		Gets the last value
		@return last value, or Nil if not set

```
v := Collection.Vector->New()<String>;
v->AddBack("a"); v->AddBack("b");
v->Last()->PrintLine(); # b
```
		~#
		method : public : Last() ~ H {
			last := @size - 1;
			if(last > -1) {
				return @values[last];
			}

			return Nil;
		}

		#~
		Gets the first value
		@return first value, or Nil if not set

```
v := Collection.Vector->New()<String>;
v->AddBack("first"); v->AddBack("second");
v->First()->PrintLine(); # first
```
		~#
		method : public : First() ~ H {
			if(@size > 0) {
				return @values[0];
			}

			return Nil;
		}

		#~
		Sets an indexed value
		@param value value
		@param index index

```
v := Collection.Vector->New()<String>;
v->AddBack("old");
v->Set("new", 0)->PrintLine(); # true
v->Get(0)->PrintLine();        # new
```
		~#
		method : public : Set(value : H, index : Int) ~ Bool {
			if(index > -1 & index < @size) {
				@values[index] := value;
				return true;
			};

			return false;
		}

		#~
