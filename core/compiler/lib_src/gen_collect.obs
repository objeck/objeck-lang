		#~
		Sorts the values in place with a comparator. The sort is stable: values the comparator calls equal keep their order.
		@param compare comparator: negative if the first value goes first, 0 if equal, positive if the second goes first

```
v := Collection.Vector->New()<String>;
v->AddBack("pear"); v->AddBack("fig"); v->AddBack("banana");
v->Sort(\(a, b) => a->Size() - b->Size());
v->Get(0)->PrintLine(); # fig
```
		~#
		method : public : Sort(compare : (H, H) ~ Int) ~ Nil {
			if(@size < 2) {
				return;
			};

			b : H[] := H->New[@size];
			SortWith(0, @size - 1, @values, b, compare);
		}

		method : SortWith(low : Int, hi : Int, a : H[], b : H[], compare : (H, H) ~ Int) ~ Nil {
			if(low < hi) {
				if(hi - low < 16) {
					for(i := low + 1; i <= hi; i += 1;) {
						value := a[i];
						j := i - 1;
						while(j >= low & compare(a[j], value) > 0) {
							a[j + 1] := a[j];
							j -= 1;
						};
						a[j + 1] := value;
					};
					return;
				};

				mid := (low + hi) >> 1;
				SortWith(low, mid, a, b, compare);
				SortWith(mid + 1, hi, a, b, compare);
				MergeWith(low, mid, hi, a, b, compare);
			};
		}

		method : MergeWith(low : Int, mid : Int, hi : Int, a : H[], b : H[], compare : (H, H) ~ Int) ~ Nil {
			for(i := low; i <= hi; i += 1;) {
				b[i] := a[i];
			};

			i := low;
			j := mid + 1;
			k := low;
			while(i <= mid & j <= hi) {
				# <= keeps equal values in their original order
				if(compare(b[i], b[j]) <= 0) {
					a[k] := b[i];
					i += 1;
				}
				else {
					a[k] := b[j];
					j += 1;
				};
				k += 1;
			};

			# the rest of the second half is already in place
			while(i <= mid) {
				a[k] := b[i];
				k += 1;
				i += 1;
			};
		}
	}

	#~
	Growable array of comparable generics


	```
function : Example() ~ Nil {	
   # insert elements
   vector := Collection.CompareVector->New()<IntRef>;
   vector->AddBack(4);
   vector->AddBack(1);
   vector->AddBack(5);
   vector->AddBack(9);
   vector->AddBack(2);
   vector->AddBack(5);

   # remove last item
   vector->RemoveBack();

   # get size
   vector->Size()->PrintLine();
   
   # get elements
   (vector->Get(0) + vector->Get(1))->PrintLine();

   # sort elements
   vector->Sort();
	
   # print all items with a loop
   each(item := vector) {
   	item->PrintLine();
   };

   # print all items with a function
   vector->Each(Show(IntRef) ~ Nil);
}

function : Show(value : IntRef) ~ Nil {
   value->PrintLine();
}
	```
	~#
	class CompareVector<H : Compare> {
		@values : H[];
		@size : Int;
		
		#~
		Default constructor

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1));
v->Size()->PrintLine(); # 1
```
		~#
		New() {
			@values := H->New[32];
			@size := 0;
		}

		#~
		Copy constructor
		@param values values to copy

```
arr := IntRef->New[2];
arr[0] := IntRef->New(1); arr[1] := IntRef->New(2);
v := Collection.CompareVector->New(arr)<IntRef>;
v->Size()->PrintLine(); # 2
```
		~#
		New(values : H[]) {
			@values := H->New[values->Size()];
			@size := values->Size();
			Runtime->Copy(@values, 0, values, 0, @size);
 		}

		#~
		Copy constructor
		@param values values to copy

```
src := Collection.CompareVector->New()<IntRef>;
src->AddBack(IntRef->New(5));
copy := Collection.CompareVector->New(src)<IntRef>;
copy->Get(0)->PrintLine(); # 5
```
		~#
		New(values : CompareVector<H>) {
			@values := values->ToArray();
			@size := values->Size();
		}

		method : public : Reserve(capacity : Int) ~ Nil {
			if(capacity < 1) {
				capacity := 1;
			};

			if(capacity > @values->Size()) {
				temp : H[] := H->New[capacity];
				Runtime->Copy(temp, 0, @values, 0, @size);
				@values := temp;
			};
		}

		#~
		Reverses element order
		@return reversed vector, if the vector is empty or hold 1 item then the original list is returned

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2)); v->AddBack(IntRef->New(3));
rev := v->Reverse();
rev->Get(0)->PrintLine(); # 3
```
		~#
		method : public : Reverse() ~ CompareVector<H> {
			if(@size < 2) {
				return @self;
			}

			len := @size;
			reversed := Collection.CompareVector->New()<H>;
			reversed->Reserve(@size);
			each(i : @size) {
				reversed->AddBack(@values[--len])
			};

			return reversed;
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2));
v->ToString()->PrintLine(); # [1,2]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			each(i : @size) {
				# get string value if instance implements 'Stringify'
				value := @values[i];
				if(value->TypeOf(Stringify)) {
					buffer->Append(value->As(System.Stringify)->ToString());
				}
				# use instance ID instead
				else {
					buffer->Append(value->GetInstanceID()->ToHexString());
				};

				# add comma
				if(i + 1 < @size) {
					buffer->Append(',');
				};
			};
			buffer->Append(']');

			return buffer;
		}

		method : Expand() ~ Nil {
			if(@size >= @values->Size()) {
				grow := @size >> 1;
				if(grow < 4) {
					grow := 4;
				};
				temp : H[] := H->New[@size + grow];
				Runtime->Copy(temp, 0, @values, 0, @size);
				@values := temp;
			};
		}

		#~
		Compresses the Vector freeing unused memory

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2));
v->Compress();
v->Size()->PrintLine(); # 2
```
		~#
		method : public : Compress() ~ Nil {
			temp : H[] := H->New[@size];
			Runtime->Copy(temp, 0, @values, 0, @size);
			@values := temp;
		}

		#~
		Maps the given function to each value in the vector
		@param f function to apply
		@return newly calculated vector

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2));
doubled := v->Map(\(IntRef) ~ IntRef : (n) => IntRef->New(n->Get() * 2));
doubled->Get(0)->PrintLine(); # 2
```
		~#
		method : public : Map(f : (H) ~ H) ~ CompareVector<H> {
			array : H[] := H->New[@size];

			for(i : Int := 0; i < @size; i += 1;) {
				array[i] := f(@values[i]);
			};
      
			return CompareVector->New(array)<H>;
		}

		#~
		Returns a limited list
		@param l limit
		@return limited list

```
v := Collection.CompareVector->New()<IntRef>;
v->AddBack(IntRef->New(1)); v->AddBack(IntRef->New(2)); v->AddBack(IntRef->New(3));
first2 := v->Limit(2);
first2->Size()->PrintLine(); # 2
```
		~#
		method : public : Limit(l : Int) ~ CompareVector<H> {
			if(l > -1 & l < @size) {
				array := H->New[l];
				for(i : Int := 0; i < l; i += 1;) {
					array[i] := @values[i];
				};
				return CompareVector->New(array)<H>;
			};
      		
			return CompareVector->New()<H>;
		}

		#~
		Function called for each element
		@param f function called

```
