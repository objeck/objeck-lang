						};
					};

					# add comma
					if(j + 1 < values->Size()) {
						buffer->Append(',');
					};
				};
				buffer->Append(')');

				# add comma
				if(i + 1 < keys->Size()) {
					buffer->Append(',');
				};
			};
			buffer->Append(']');

			return buffer;
