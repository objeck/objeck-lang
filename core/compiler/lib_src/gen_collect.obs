		#~
		Sorts the values in ascending order (a stable merge sort, O(n log n))

```
v := Collection.IntVector->New([3, -1, 2]);
v->Sort();
v->ToString()->PrintLine(); # [-1,2,3]
```
		~#
		method : public : Sort() ~ Nil {
			SortValues(@values, @size);
		}

		function : private : native : SortValues(a : Int[], n : Int) ~ Nil {
			if(n < 2) {
				return;
			};

			run := 32;
			for(lo := 0; lo < n; lo += run;) {
				hi := lo + run;
				if(hi > n) {
					hi := n;
				};
				for(i := lo + 1; i < hi; i += 1;) {
					v := a[i];
					j := i - 1;
					while(j >= lo & a[j] > v) {
						a[j + 1] := a[j];
						j -= 1;
					};
					a[j + 1] := v;
				};
			};

			if(n <= run) {
				return;
			};

			buffer := Int->New[n];
			src := a;
			dest := buffer;
			in_buffer := false;
			width := run;
			while(width < n) {
				for(lo := 0; lo < n; lo += width << 1;) {
					mid := lo + width;
					if(mid > n) {
						mid := n;
					};
					hi := lo + (width << 1);
					if(hi > n) {
						hi := n;
					};

					i := lo;
					j := mid;
					k := lo;
					while(i < mid & j < hi) {
						if(src[j] < src[i]) {
							dest[k] := src[j];
							j += 1;
						}
						else {
							dest[k] := src[i];
							i += 1;
						};
						k += 1;
					};
					while(i < mid) {
						dest[k] := src[i];
						i += 1;
						k += 1;
					};
					while(j < hi) {
						dest[k] := src[j];
						j += 1;
						k += 1;
					};
				};

				temp := src;
				src := dest;
				dest := temp;
				in_buffer := <>in_buffer;
				width := width << 1;
			};

			if(in_buffer) {
				Runtime->Copy(a, 0, src, 0, n);
			};
		}

