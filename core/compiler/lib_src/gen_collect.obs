#~
Typed tuple classes (Pair, Triple, Quad) for grouping related values without defining a class. Immutable by design; use as map keys or return values. Compile with -lib gen_collect.
~#
bundle Collection.Tuple {
	#~
	Tuple class that supports 2 values

```
pair := Collection.Tuple.Pair->New("name", 42)<String, IntRef>;
pair->GetFirst()->PrintLine();
pair->GetSecond()->PrintLine();
```
	~#
	class Pair<A, B> {
		@a : A;
		@b : B;

		#~
		Constructor.
		@param a first parameter
		@param b second parameter

```
pair := Collection.Tuple.Pair->New("hello", 42)<String, IntRef>;
pair->GetFirst()->PrintLine();  # hello
pair->GetSecond()->PrintLine(); # 42
```
		~#
		New(a : A, b : B) {
			@a := a;
			@b := b;
		}

		#~
		Returns the first value
		@return first value

```
pair := Collection.Tuple.Pair->New("alpha", 1)<String, IntRef>;
pair->GetFirst()->PrintLine(); # alpha
```
		~#
		method : public : GetFirst() ~ A {
			return @a;
		}

		#~
		Returns the second value
		@return second value

```
pair := Collection.Tuple.Pair->New("beta", 2)<String, IntRef>;
pair->GetSecond()->PrintLine(); # 2
```
		~#
		method : public : GetSecond() ~ B {
			return @b;
		}

		#~
		Formats tuple into a string
		@return string representation

```
pair := Collection.Tuple.Pair->New("x", 99)<String, IntRef>;
pair->ToString()->PrintLine(); # [x,99]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			if(@a = Nil) {
				buffer += "<Nil>";
			}
			else {
				if(@a->TypeOf(Stringify)) {
					buffer->Append(@a->As(System.Stringify)->ToString());
				}
				# use instance ID instead
				else {
					buffer->Append(@a->GetInstanceID()->ToHexString());
				};
			}

			buffer += ',';

			if(@b = Nil) {
				buffer += "<Nil>";
			}
			else {
				if(@b->TypeOf(Stringify)) {
					buffer->Append(@b->As(System.Stringify)->ToString());
				}
				# use instance ID instead
				else {
					buffer->Append(@b->GetInstanceID()->ToHexString());
				};
			}

			buffer += "]";

			return buffer;
		}
	}
	
