		~#
		method : public : Filter(f : (K) ~ Bool) ~ MultiHash<K, V> {
			filtered := MultiHash->New()<K, V>;
			
			keys := GetKeys();
			each(i : keys) {
				key := keys->Get(i);
				if(f(key)) {
