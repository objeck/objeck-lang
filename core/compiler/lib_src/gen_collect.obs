		~#
		method : public : ToString() ~ String {
			buffer := "{";

			if(@first->TypeOf(Stringify)) {
				buffer->Append(@first->As(System.Stringify)->ToString());
			}
			# use instance ID instead
			else {
				buffer->Append(@first->GetInstanceID()->ToHexString());
			};

			buffer += ',';

			if(@second->TypeOf(Stringify)) {
				buffer->Append(@second->As(System.Stringify)->ToString());
			}
			# use instance ID instead
			else {
				buffer->Append(@second->GetInstanceID()->ToHexString());
			};

			buffer += "}";

			return buffer;
		}
	}

	#~
	Hash unordered table of generics. Open addressing (linear probing over parallel key, value and hash arrays) that doubles at 70% load with no upper limit. Lookups change nothing, so concurrent readers do not interfere; writers still need a lock. Keys of different classes are never equal, and the iteration order is unspecified.

	```
# insert elements
hash := Collection.Hash->New()<IntRef, String>;
hash->Insert(415, "San Francisco");
hash->Insert(510, "Oakland");
hash->Insert(925, "East Bay");

# get size
hash->Size()->PrintLine();

# get value by key
hash->Find(510)->PrintLine();

# get key/values
key_values := hash->GetKeyValues()<Pair<IntRef, String>>;
each(key_value := key_values) {
   key_value->GetFirst()->PrintLine();
};

# get values
values := hash->GetValues()<String>;
each(value := values) {
   value->PrintLine();
};

# check for key
hash->Has(408)->PrintLine();
    ```
	~#
	class Hash<K : Compare, V> {
		@keys : K[];
		@values : V[];
		@hashes : Int[];
		@size : Int;
		@mask : Int;
		@shift : Int;
		@initial_slots : Int;
		@capacity : Int;
		@auto_resize : Bool;

		#~
		Hash table capacity hints. The table is open-addressed: it starts at the next power of two at or above the hint and doubles whenever it is 70% full, with no upper limit.
		@class Hash
		~#
		consts Capacity {
			SMALL := 769,
			MEDIUM := 3079,
			LARGE := 12289,
			EX_LARGE := 49157,
			HUGE := 196613
		}

		#~
		Default constructor
		@param auto_resize kept for compatibility; the table always grows when it needs to

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("apples", 3);
hash->Insert("bananas", 5);
hash->Size()->PrintLine(); # 2
```
		~#
		New(auto_resize : Bool := true) {
			@auto_resize := auto_resize;
			@capacity := Capacity->SMALL;
			@initial_slots := 16;
			Allocate(@initial_slots);
		}

		#~
		Default constructor
		@param capacity expected number of slots, rounded up to a power of two
		@param auto_resize kept for compatibility; the table always grows when it needs to

```
hash := Collection.Hash->New(Collection.Hash->Capacity->MEDIUM)<String, IntRef>;
hash->Insert("key", 42);
hash->Find("key")->PrintLine(); # 42
```
		~#
		New(capacity : Hash->Capacity, auto_resize : Bool := true) {
			@capacity := capacity;
			@auto_resize := auto_resize;
			@initial_slots := SlotsFor(capacity->As(Int));
			Allocate(@initial_slots);
		}

		function : private : SlotsFor(capacity : Int) ~ Int {
			slots := 16;
			while(slots < capacity & slots < 1073741824) {
				slots := slots << 1;
			};
			return slots;
		}

		method : private : Allocate(slots : Int) ~ Nil {
			@keys := K->New[slots];
			@values := V->New[slots];
			@hashes := Int->New[slots];
			@size := 0;
			@mask := slots - 1;

			bits := 0;
			s := slots;
			while(s > 1) {
				s := s >> 1;
				bits += 1;
			};
			@shift := 64 - bits;
		}

		method : private : native : Rehash(slots : Int) ~ Nil {
			old_keys := @keys;
			old_values := @values;
			old_hashes := @hashes;
			size := @size;

			Allocate(slots);
			keys := @keys;
			values := @values;
			hashes := @hashes;
			mask := @mask;
			shift := @shift;

			count := old_keys->Size();
			for(j := 0; j < count; j += 1;) {
				k := old_keys[j];
				if(k <> Nil) {
					h := old_hashes[j];
					i := (h >> shift) and mask;
					while(keys[i] <> Nil) {
						i := (i + 1) and mask;
					};
					keys[i] := k;
					values[i] := old_values[j];
					hashes[i] := h;
				};
			};
			@size := size;
		}

		#~
		Converts a vector pairs to a hash
		@param pairs vector of pairs
		@return hashed pairs

```
pairs := Collection.Vector->New()<Collection.Tuple.Pair<String, IntRef>>;
pairs->AddBack(Collection.Tuple.Pair->New("a", IntRef->New(1))<String, IntRef>);
pairs->AddBack(Collection.Tuple.Pair->New("b", IntRef->New(2))<String, IntRef>);
hash := Collection.Hash->Dict(pairs)<String, IntRef>;
hash->Find("a")->PrintLine(); # 1
```
		~#
		function : Dict(pairs : Vector<Collection.Tuple.Pair<K, V>>) ~ Hash<K, V> {
			dict := Hash->New()<K, V>;

			each(pair in pairs) {
				k := pair->GetFirst();
				v := pair->GetSecond();
				dict->Insert(k, v);
			};

			return dict;
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("x", 10);
hash->Insert("y", 20);
hash->ToString()->PrintLine();
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			count := 0;
			for(i := 0; i < @keys->Size(); i += 1;) {
				key : K := @keys[i];
				if(key <> Nil) {
					if(count > 0) {
						buffer->Append(',');
					};

					buffer->Append('(');
					if(key->TypeOf(Stringify)) {
						buffer->Append(key->As(System.Stringify)->ToString());
					}
					else {
						buffer->Append(key->GetInstanceID()->ToHexString());
					};

					buffer->Append(':');

					value := @values[i];
					if(value = Nil) {
						buffer->Append("<Nil>");
					}
					else if(value->TypeOf(Stringify)) {
						buffer->Append(value->As(System.Stringify)->ToString());
					}
					else {
						buffer->Append(value->GetInstanceID()->ToHexString());
					};
					buffer->Append(')');

					count += 1;
				};
			};
			buffer->Append(']');

			return buffer;
		}

		#~
		Inserts a value into the hash, replacing the value of an equal key. Keys of different classes are never equal.
		@param key key
		@param value value

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("count", 42);
hash->Find("count")->PrintLine(); # 42
```
		~#
		method : public : native : Insert(key : K, value : V) ~ Nil {
			if(key = Nil) {
				return;
			};

			h := key->HashID() * -7046029254386353131;
			keys := @keys;
			hashes := @hashes;
			mask := @mask;

			i := (h >> @shift) and mask;
			k := keys[i];
			while(k <> Nil) {
				if(hashes[i] = h) {
					# the same instance needs no Compare; otherwise only keys of one class are compared
					if(k = key | (k->GetClassID() = key->GetClassID() & k->Compare(key) = 0)) {
						@values[i] := value;
						return;
					};
				};
				i := (i + 1) and mask;
				k := keys[i];
			};

			keys[i] := key;
			@values[i] := value;
			hashes[i] := h;
			@size += 1;

			if(@size * 10 > (mask + 1) * 7) {
				Rehash((mask + 1) << 1);
			};
		}

		#~
		Inserts a value only when the key is not already in the hash
		@param key key
		@param value value
		@return true if inserted, false if the key was already present (or is Nil)

```
hash := Collection.Hash->New()<String, IntRef>;
hash->InsertIfAbsent("a", 1)->PrintLine(); # true
hash->InsertIfAbsent("a", 2)->PrintLine(); # false
hash->Find("a")->PrintLine();              # 1
```
		~#
		method : public : native : InsertIfAbsent(key : K, value : V) ~ Bool {
			if(key = Nil) {
				return false;
			};

			h := key->HashID() * -7046029254386353131;
			keys := @keys;
			hashes := @hashes;
			mask := @mask;

			i := (h >> @shift) and mask;
			k := keys[i];
			while(k <> Nil) {
				if(hashes[i] = h) {
					# the same instance needs no Compare; otherwise only keys of one class are compared
					if(k = key | (k->GetClassID() = key->GetClassID() & k->Compare(key) = 0)) {
						return false;
					};
				};
				i := (i + 1) and mask;
				k := keys[i];
			};

			keys[i] := key;
			@values[i] := value;
			hashes[i] := h;
			@size += 1;

			if(@size * 10 > (mask + 1) * 7) {
				Rehash((mask + 1) << 1);
			};

			return true;
		}

		#~
		Searches for a value in a hash. A lookup changes nothing in the hash, so concurrent readers do not interfere.
		@param key search key
		@return found value, Nil if not found

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("price", 99);
hash->Find("price")->PrintLine(); # 99
```
		~#
		method : public : native : Find(key : K) ~ V {
			if(key = Nil) {
				return Nil;
			};

			h := key->HashID() * -7046029254386353131;
			keys := @keys;
			hashes := @hashes;
			mask := @mask;

			i := (h >> @shift) and mask;
			k := keys[i];
			while(k <> Nil) {
				if(hashes[i] = h) {
					# the same instance needs no Compare; otherwise only keys of one class are compared
					if(k = key | (k->GetClassID() = key->GetClassID() & k->Compare(key) = 0)) {
						return @values[i];
					};
				};
				i := (i + 1) and mask;
				k := keys[i];
			};

			return Nil;
		}

		#~
		Gets the capacity hint the hash was created or last resized with
		@return hash table capacity hint

```
hash := Collection.Hash->New()<String, IntRef>;
hash->GetCapacity()->PrintLine();
```
		~#
		method : public : GetCapacity() ~ Hash->Capacity {
			return @capacity;
		}

		#~
		Sets the hash table capacity hint; use Resize to resize the table
		@param capacity hash table capacity

```
hash := Collection.Hash->New()<String, IntRef>;
hash->SetCapacity(Collection.Hash->Capacity->MEDIUM);
hash->GetCapacity()->PrintLine();
```
		~#
		method : public : SetCapacity(capacity : Hash->Capacity) ~ Nil {
			@capacity := capacity;
		}

		#~
		Gets auto-resize setting
		@return true if auto-resize is set, false otherwise

```
hash := Collection.Hash->New()<String, IntRef>;
hash->IsAutoResize()->PrintLine(); # true
```
		~#
		method : public : IsAutoResize() ~ Bool {
			return @auto_resize;
		}

		#~
		Set auto-resize setting. The table grows whenever it is 70% full either way; the flag is kept for compatibility.
		@param auto_resize true if auto-resize is enable, false otherwise

```
hash := Collection.Hash->New()<String, IntRef>;
hash->SetAutoResize(false);
hash->IsAutoResize()->PrintLine(); # false
```
		~#
		method : public : SetAutoResize(auto_resize : Bool) ~ Nil {
			@auto_resize := auto_resize;
		}

		#~
		Resizes the hash table to at least the given capacity, and to more if the entries need it
		@param capacity table capacity
		@param auto_resize true for hash table auto resizing, false otherwise

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("a", 1);
hash->Resize(Collection.Hash->Capacity->LARGE);
hash->Find("a")->PrintLine(); # 1
```
		~#
		method : public : Resize(capacity : Hash->Capacity, auto_resize : Bool := true) ~ Nil {
			@capacity := capacity;
			@auto_resize := auto_resize;

			slots := SlotsFor(capacity->As(Int));
			while(@size * 10 > slots * 7) {
				slots := slots << 1;
			};
			Rehash(slots);
		}

		#~
		Checks for a value in a hash
		@param key search key
		@return true if found, false otherwise

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("k", 1);
hash->Has("k")->PrintLine();   # true
hash->Has("z")->PrintLine();   # false
```
		~#
		method : public : native : Has(key : K) ~ Bool {
			if(key = Nil) {
				return false;
			};

			h := key->HashID() * -7046029254386353131;
			keys := @keys;
			hashes := @hashes;
			mask := @mask;

			i := (h >> @shift) and mask;
			k := keys[i];
			while(k <> Nil) {
				if(hashes[i] = h) {
					# the same instance needs no Compare; otherwise only keys of one class are compared
					if(k = key | (k->GetClassID() = key->GetClassID() & k->Compare(key) = 0)) {
						return true;
					};
				};
				i := (i + 1) and mask;
				k := keys[i];
			};

			return false;
		}

		#~
		Removes a value from the hash
		@param key key for value to remove
		@return true if removed, false if the key was not found

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("del", 9);
hash->Remove("del")->PrintLine(); # true
hash->Has("del")->PrintLine();    # false
```
		~#
		method : public : native : Remove(key : K) ~ Bool {
			if(key = Nil) {
				return false;
			};

			h := key->HashID() * -7046029254386353131;
			keys := @keys;
			values := @values;
			hashes := @hashes;
			mask := @mask;
			shift := @shift;

			i := (h >> shift) and mask;
			k := keys[i];
			found := false;
			while(k <> Nil & <>found) {
				if(hashes[i] = h) {
					# the same instance needs no Compare; otherwise only keys of one class are compared
					if(k = key | (k->GetClassID() = key->GetClassID() & k->Compare(key) = 0)) {
						found := true;
					};
				};

				if(<>found) {
					i := (i + 1) and mask;
					k := keys[i];
				};
			};

			if(<>found) {
				return false;
			};

			# backward-shift deletion: pull later entries of the run into the hole
			j := i;
			j := (j + 1) and mask;
			k := keys[j];
			while(k <> Nil) {
				ideal := (hashes[j] >> shift) and mask;
				if(((j - ideal) and mask) >= ((j - i) and mask)) {
					keys[i] := k;
					values[i] := values[j];
					hashes[i] := hashes[j];
					i := j;
				};
				j := (j + 1) and mask;
				k := keys[j];
			};

			keys[i] := Nil;
			values[i] := Nil;
			hashes[i] := 0;
			@size -= 1;

			return true;
		}

		#~
		Get a collection of keys. GetKeys, GetValues and GetKeyValues list the entries in the same order.
		@return vector of keys

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("a", 1);
hash->Insert("b", 2);
keys := hash->GetKeys()<String>;
each(k := keys) {
   k->PrintLine();
};
```
		~#
		method : public : native : GetKeys() ~ Vector<K> {
			keys := Vector->New()<K>;
			keys->Reserve(@size);
			for(i := 0; i < @keys->Size(); i += 1;) {
				key := @keys[i];
				if(key <> Nil) {
					keys->AddBack(key);
				};
			};

			return keys;
		}

		#~
		Gets a collection of values
		@return vector of values

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("x", 10);
hash->Insert("y", 20);
vals := hash->GetValues()<IntRef>;
each(v := vals) {
   v->PrintLine();
};
```
		~#
		method : public : native : GetValues() ~ Vector<V> {
			values := Vector->New()<V>;
			values->Reserve(@size);
			for(i := 0; i < @keys->Size(); i += 1;) {
				if(@keys[i] <> Nil) {
					values->AddBack(@values[i]);
				};
			};

			return values;
		}

		#~
		Gets a collection of key/value pairs
		@return vector of key/value pairs

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("m", 100);
kvs := hash->GetKeyValues()<Collection.Pair<String, IntRef>>;
each(kv := kvs) {
   "{kv->GetFirst()}: {kv->GetSecond()}"->PrintLine();
};
```
		~#
		method : public : GetKeyValues() ~ Vector<Pair<K,V>> {
			values := Vector->New()<Pair<K,V>>;
			values->Reserve(@size);

			for(i := 0; i < @keys->Size(); i += 1;) {
				k : K := @keys[i];
				if(k <> Nil) {
					v : V := @values[i];
					values->AddBack(Pair->New(k, v)<K,V>);
				};
			};

			return values;
		}

		#~
		Clears the map

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("a", 1);
hash->Empty();
hash->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : Empty() ~ Nil {
			Allocate(@initial_slots);
		}

		#~
		Checks to see if the hash table is empty
		@return true if empty, false otherwise

```
hash := Collection.Hash->New()<String, IntRef>;
hash->IsEmpty()->PrintLine(); # true
hash->Insert("a", 1);
hash->IsEmpty()->PrintLine(); # false
```
		~#
		method : public: IsEmpty() ~ Bool {
			return @size = 0;
		}

		#~
		Size of map
		@return size of map

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("a", 1);
hash->Insert("b", 2);
hash->Size()->PrintLine(); # 2
```
		~#
		method : public : Size() ~ Int {
			return @size;
		}

		#~
		Copies the hash. The keys and values are shared, not cloned.
		@return new hash with the same entries

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("a", 1);
copy := hash->Copy();
copy->Insert("b", 2);
hash->Size()->PrintLine(); # 1
copy->Size()->PrintLine(); # 2
```
		~#
		method : public : Copy() ~ Hash<K, V> {
			copy := Hash->New(@auto_resize)<K, V>;
			copy->Merge(@self);
			return copy;
		}

		#~
		Inserts every entry of another hash into this one. Where both have a key, that hash's value wins.
		@param that hash to merge in (Nil changes nothing)
		@return this hash

```
a := Collection.Hash->New()<String, IntRef>;
a->Insert("x", 1); a->Insert("y", 2);
b := Collection.Hash->New()<String, IntRef>;
b->Insert("y", 20); b->Insert("z", 30);
a->Merge(b);
a->Find("y")->PrintLine(); # 20
a->Size()->PrintLine();    # 3
```
		~#
		method : public : Merge(that : Hash<K, V>) ~ Hash<K, V> {
			if(that = Nil) {
				return @self;
			};

			pairs := that->GetKeyValues();
			each(i : pairs) {
				pair := pairs->Get(i);
				Insert(pair->GetFirst(), pair->GetSecond());
			};
			return @self;
		}

		#~
		Calls a function for each key and value. The function may change the hash: it is called on a snapshot of the entries.
		@param f function called
		@return this hash

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("a", 1); hash->Insert("b", 2);
hash->Each(\(k, v) => { "{$k}={$v}"->PrintLine(); });
```
		~#
		method : public : Each(f : (K, V) ~ Nil) ~ Hash<K, V> {
			pairs := GetKeyValues();
			each(i : pairs) {
				pair := pairs->Get(i);
				f(pair->GetFirst(), pair->GetSecond());
			};
			return @self;
		}

		#~
		Keeps the entries whose keys a function accepts, as Map->Filter does. The hash is not changed.
		@param f function that returns true for each key to keep
		@return new hash

```
hash := Collection.Hash->New()<String, IntRef>;
hash->Insert("apple", 1); hash->Insert("kiwi", 2);
hash->Filter(\(k) => k->Size() > 4)->Size()->PrintLine(); # 1
```
		~#
		method : public : Filter(f : (K) ~ Bool) ~ Hash<K, V> {
			filtered := Hash->New(@auto_resize)<K, V>;
			pairs := GetKeyValues();
			each(i : pairs) {
				pair := pairs->Get(i);
				if(f(pair->GetFirst())) {
					filtered->Insert(pair->GetFirst(), pair->GetSecond());
				};
			};
			return filtered;
		}
	}
	
	#~
	Growable stack of generics (LIFO)

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(1);
stack->Push(2);
stack->Push(3);
stack->Pop()->PrintLine();  # prints 3
stack->Top()->PrintLine();  # prints 2
stack->Size()->PrintLine(); # prints 2
```
	~#
	class Stack<H> {
		@head : ListNode<H>;
		@size : Int;

		#~
		Default constructor

```
stack := Collection.Stack->New()<String>;
stack->Push("a");
stack->Push("b");
stack->Pop()->PrintLine(); # b
```
		~#
		New() {
		}

		#~
		Converts the stack into an object array
		@return object array

```
stack := Collection.Stack->New()<String>;
stack->Push("x");
stack->Push("y");
arr := stack->ToArray();
arr[0]->PrintLine(); # y (top element)
```
		~#
		method : native : public : ToArray() ~ H[] {
			array := H->New[@size];
			
			i := 0;
			node := @head;
			while(node <> Nil) {
				array[i] := node->Get();
				node := node->GetNext();
				i += 1;
			};
			
			return array;
		}

		#~
		Pushes a value onto the stack
		@param value to push

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(IntRef->New(10));
stack->Push(IntRef->New(20));
stack->Top()->PrintLine(); # 20
```
		~#
		method : public : Push(value : H) ~ Nil {
			if(@head = Nil) {
				@head := ListNode->New(value)<H>;
			}
			else {
				next := ListNode->New(value)<H>;
				next->SetNext(@head);
				@head := next;
			};

			@size += 1;
		}

		#~
		Pops values from the stack
		@param n number of items to pop
		@return popped valued, Nil if stack is empty

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(IntRef->New(1));
stack->Push(IntRef->New(2));
stack->Push(IntRef->New(3));
stack->Pop(2)->PrintLine(); # 2 (value after skipping 2 items)
```
		~#
		method : native : public : Pop(n : Int) ~ H {
			value : H := Nil;

			if(n > 0) {
				count := 0;
				while(@head <> Nil & count < n) {
					value := @head->Get();
					@head := @head->GetNext();
					@size -= 1;
					count += 1;
				};
			};

			return value;
		}

		#~
		Pops a value from the stack
		@return popped valued, Nil if stack is empty

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(IntRef->New(7));
stack->Push(IntRef->New(8));
stack->Pop()->PrintLine(); # 8
stack->Size()->PrintLine(); # 1
```
		~#
		method : public : Pop() ~ H {
			value : H;

			if(@head <> Nil) {
				value := @head->Get();
				@head := @head->GetNext();
				@size -= 1;
			};

			return value;
		}

		#~
		Check the top of the stack
		@return value on the top of stack, Nil if stack is empty

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(IntRef->New(42));
stack->Top()->PrintLine(); # 42
stack->Size()->PrintLine(); # 1 (Top does not remove)
```
		~#
		method : public : Top() ~ H {
			value : H;

			if(@head <> Nil) {
				value := @head->Get();
			};

			return value;
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(IntRef->New(1));
stack->Push(IntRef->New(2));
stack->ToString()->PrintLine(); # [2,1]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			node := @head;
			while(node <> Nil) {
				value := node->Get();
				if(value->TypeOf(Stringify)) {
					buffer->Append(value->As(System.Stringify)->ToString());
				}
				else {
					buffer->Append(value->GetInstanceID()->ToHexString());
				};

				node := node->GetNext();
				if(node <> Nil) {
					buffer->Append(',');
				};
			};
			buffer->Append(']');

			return buffer;
		}

		#~
		Checks to see if the stack is empty
		@return true if empty, false otherwise

```
stack := Collection.Stack->New()<IntRef>;
stack->IsEmpty()->PrintLine(); # true
stack->Push(IntRef->New(1));
stack->IsEmpty()->PrintLine(); # false
```
		~#
		method : public : IsEmpty() ~ Bool {
			return @head = Nil;
		}

		#~
		Clears the stack

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(IntRef->New(5));
stack->Empty();
stack->IsEmpty()->PrintLine(); # true
```
		~#
		method : public : Empty() ~ Nil {
			@head := Nil;
		}

		#~
		Size of stack
		@return size of stack

```
stack := Collection.Stack->New()<IntRef>;
stack->Push(IntRef->New(1));
stack->Push(IntRef->New(2));
stack->Size()->PrintLine(); # 2
```
		~#
		method : public : Size() ~ Int {
			return @size;
		}
	}
	
	#~
	Queue of generics

	```
# insert elements
queue := Collection.Queue->New()<String>;
queue->AddFront("San Francisco");
queue->AddBack("Oakland");
queue->AddBack("East Bay");
queue->AddBack("Mountain View");

# remove element
queue->RemoveBack();

# get size
queue->Size()->PrintLine();

# get value by key
queue->Back()->PrintLine();
queue->Front()->PrintLine();
	```	
	~#
	class Queue<H> {
		@queue : List<H>;
		
		#~
		Default constructor

```
queue := Collection.Queue->New()<String>;
queue->AddBack("first");
queue->AddBack("second");
queue->Front()->PrintLine(); # first
```
		~#
		New() {
			@queue := List->New()<H>;
		}

		#~
		Converts the queue into an object array
		@return object array

```
queue := Collection.Queue->New()<String>;
queue->AddBack("a");
queue->AddBack("b");
arr := queue->ToArray();
arr[0]->PrintLine(); # a
```
		~#
		method : public : ToArray() ~ H[] {
			return @queue->ToArray();
		}

		#~
		Adds a value to the back of the queue
		@param value value to add

```
queue := Collection.Queue->New()<String>;
queue->AddBack("first");
queue->AddBack("second");
queue->Back()->PrintLine(); # second
```
		~#
		method : public: AddBack(value : H) ~ Nil {
			@queue->AddBack(value);
		}

		#~
		Adds a value to the front of the queue
		@param value value to add

```
queue := Collection.Queue->New()<String>;
queue->AddBack("middle");
queue->AddFront("head");
queue->Front()->PrintLine(); # head
```
		~#
		method : public: AddFront(value : H) ~ Nil {
			@queue->AddFront(value);
		}

		#~
		Removes a value from the front of the queue
		@return value removed

```
queue := Collection.Queue->New()<String>;
queue->AddBack("first");
queue->AddBack("second");
queue->RemoveFront()->PrintLine(); # first
queue->Front()->PrintLine();       # second
```
		~#
		method : public : RemoveFront() ~ H {
			if(@queue->Size() > 0) {
				value := @queue->Front();
				@queue->RemoveFront();
				return value;
			};
			
			return Nil;
		}

		#~
		Removes a value from the back of the queue
		@return value removed

```
queue := Collection.Queue->New()<String>;
queue->AddBack("alpha");
queue->AddBack("beta");
queue->RemoveBack()->PrintLine(); # beta
queue->Back()->PrintLine();       # alpha
```
		~#
		method : public : RemoveBack() ~ H {
			if(@queue->Size() > 0) {
				value := @queue->Back();
				@queue->RemoveBack();
				return value;
			};
			
			return Nil;
		}
		
		#~
		Get the value from the front of the queue
		@return head value, Nil if queue is empty

```
