		~#
		method : public : IsSuperset(that : SetHash<K>) ~ Bool {
			if(that = Nil) {
				return true;
			};
			return that->IsSubset(@self);
		}

		#~
		Calls a function for each element
		@param f function called
		@return this set

```
set := Collection.SetHash->New()<String>;
set->Insert("x"); set->Insert("y");
set->Each(\(s) => { s->PrintLine(); });
```
		~#
		method : public : Each(f : (K) ~ Nil) ~ SetHash<K> {
			keys := ToVector();
			each(i : keys) {
				f(keys->Get(i));
			};
			return @self;
		}

		#~
		Keeps the elements a function accepts. The set is not changed.
		@param f function that returns true for each element to keep
		@return new set

```
set := Collection.SetHash->New()<String>;
set->Insert("apple"); set->Insert("kiwi");
set->Filter(\(s) => s->Size() > 4)->Size()->PrintLine(); # 1
```
		~#
		method : public : Filter(f : (K) ~ Bool) ~ SetHash<K> {
			result := SetHash->New()<K>;
			keys := ToVector();
			each(i : keys) {
				key := keys->Get(i);
				if(f(key)) {
					result->Insert(key);
				};
			};
			return result;
		}
	}
		
