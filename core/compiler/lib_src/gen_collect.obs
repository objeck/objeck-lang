	~#
	class MultiMap<K : Compare, V> {
		@map : Map<K, Vector<V> >;

		#~
		Default constructor

```
mmap := Collection.MultiMap->New()<String, IntRef>;
mmap->Insert("a", IntRef->New(1));
mmap->Size()->PrintLine(); # 1
```
		~#
		New() {
			@map := Map->New()<K, Vector<V> >;
		}

		#~
		Inserts a value into the map
		@param key key
		@param value value

```
mmap := Collection.MultiMap->New()<String, IntRef>;
mmap->Insert("fruits", IntRef->New(1));
mmap->Insert("fruits", IntRef->New(2));
mmap->Find("fruits")->Size()->PrintLine(); # 2
```
		~#
		method : public : Insert(key : K, value : V) ~ Nil {
			if(key = Nil) {
				return;
			};

			values := Find(key);
			if(values = Nil) {
				values := Vector->New()<V>;
				@map->Insert(key, values);
			};

			values->AddBack(value);
		}

		#~
		Finds all values for a key in the map
		@param key search key
		@return vector of values, or Nil if not found

```
mmap := Collection.MultiMap->New()<String, IntRef>;
mmap->Insert("k", IntRef->New(10)); mmap->Insert("k", IntRef->New(20));
vals := mmap->Find("k")<IntRef>;
each(v := vals) { v->PrintLine(); } # 10, 20
```
		~#
		method : public : Find(key : K) ~ Vector<V> {
			return @map->Find(key);
		}

		#~
		Get a collection of keys
		@return vector of keys

```
mmap := Collection.MultiMap->New()<String, IntRef>;
mmap->Insert("a", IntRef->New(1)); mmap->Insert("b", IntRef->New(2));
keys := mmap->GetKeys()<String>;
each(k := keys) { k->PrintLine(); }
```
		~#
		method : public : GetKeys() ~ Vector<K> {
			return @map->GetKeys();
		}

		#~
		Gets a collection of all values across all keys
		@return vector of values

```
mmap := Collection.MultiMap->New()<String, IntRef>;
mmap->Insert("a", IntRef->New(1)); mmap->Insert("b", IntRef->New(2));
all_values := mmap->GetValues()<IntRef>;
all_values->Size()->PrintLine(); # 2
```
		~#
		method : public : GetValues() ~ Vector<V> {
			values := Vector->New()<V>;
			values->Reserve(TotalSize());

			keys := @map->GetKeys();
			each(i : keys) {
				key := keys->Get(i);
				local_values := @map->Find(key)<V>;
				each(j : local_values) {
					values->AddBack(local_values->Get(j));
				};
			};

			return values;
		}

		#~
		Formats the collection into a string. If an element implements the 'Stringify'
		interface, it's 'ToString()' is called.
		@return string representation

```
mmap := Collection.MultiMap->New()<String, IntRef>;
mmap->Insert("a", IntRef->New(1)); mmap->Insert("a", IntRef->New(2));
mmap->ToString()->PrintLine(); # [(a:12)]
```
		~#
		method : public : ToString() ~ String {
			buffer := "[";

			keys := @map->GetKeys();
			each(i : keys) {

				# get key
				key := keys->Get(i);
				if(key->TypeOf(Stringify)) {
					buffer->Append('(');
					buffer->Append(key->As(System.Stringify)->ToString());
				}
				# use instance ID instead
				else {
					buffer->Append('(');
					buffer->Append(key->GetInstanceID()->ToHexString());
				};
				buffer->Append(':');

				# get values
				values := @map->Find(key)<V>;
				each(j : values) {
					value := values->Get(j);
					if(value <> Nil) {
						if(value->TypeOf(Stringify)) {
							buffer->Append(value->As(System.Stringify)->ToString());
							
						}
						# use instance ID instead
						else {
							buffer->Append(value->GetInstanceID()->ToHexString());
						};
					};

					# add comma
					if(j + 1 < values->Size()) {
						buffer->Append(',');
					};
				};
				buffer->Append(')');

				# add comma
				if(i + 1 < keys->Size()) {
					buffer->Append(',');
				};
			};
			buffer->Append(']');

			return buffer;
		}

		#~
		Checks to see if the map is empty
		@return true if empty, false otherwise

```
