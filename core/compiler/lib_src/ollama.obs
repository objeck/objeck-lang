	#~
	Ollama chat client. The session keeps the message history, including tool calls and tool results.

```
chat := Chat->New("llama3");
chat->AddMessage("system", "Answer in one sentence.");
chat->Send("How many people live in San Pablo, CA?")->PrintLine();
chat->Send("What are the major landmarks?")->PrintLine();
```
	~#
	class Chat from EndPoint {
		@model : String;
		@messages : Vector<JsonElement>;
		@last_reply : Reply;

		#~
		Constructor; asks the server to load the model
		@param model model name (i.e. llama3, llava)
		~#
		New(model : String) {
			Parent();
			Init(model, true);
		}

		#~
		Constructor
		@param model model name (i.e. llama3, llava)
		@param preload true to ask the server to load the model now
		~#
		New(model : String, preload : Bool) {
			Parent();
			Init(model, preload);
		}

		method : Init(model : String, preload : Bool) ~ Nil {
			@model := model;
			@messages := Vector->New()<JsonElement>;

			if(preload) {
				query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
				query_json->Insert("model", model);
				query_json->Insert("stream", false);

				body := Post("/api/chat", query_json);
				if(body <> Nil) {
					json := ParseResponse(body);
					if(json <> Nil) {
						model_name := Field->Text(json, "model");
						if(model_name <> Nil & <>json->Has("error")) {
							@model := model_name;
						}
						else {
							ReportError(json);
						};
					};
				};
			};
		}

		#~
		Get the model name
		@return model name
		~#
		method : public : GetModel() ~ String {
			return @model;
		}

		#~
		Adds a message to the history without sending it (e.g. a "system" prompt)
		@param role "system", "user", "assistant" or "tool"
		@param content message text
		@return self for chaining
		~#
		method : public : AddMessage(role : String, content : String) ~ Chat {
			message_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			message_json->Insert("role", role);
			message_json->Insert("content", content);
			@messages->AddBack(message_json);
			return @self;
		}

		#~
		Adds the result of a tool call to the history, as a "tool" message. Send it with SendReply(Nil, ...).
		@param tool_name name of the function that was called
		@param content the function's result
		@return self for chaining
		~#
		method : public : AddToolResult(tool_name : String, content : String) ~ Chat {
			message_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			message_json->Insert("role", "tool");
			message_json->Insert("tool_name", tool_name);
			message_json->Insert("content", content);
			@messages->AddBack(message_json);
			return @self;
		}

		#~
		Get the message history
		@return messages, as sent in the request
		~#
		method : public : GetMessages() ~ JsonElement {
			return JsonElement->New(@messages);
		}

		#~
		Get the last reply received, with its tool calls, thinking and metadata
		@return last reply, or Nil
		~#
		method : public : GetLastReply() ~ Reply {
			return @last_reply;
		}

		#~
		Builds the /api/chat request body for the current history.
		@param format output format ("json"), or Nil
		@param options options and request settings, or Nil
		@param tools tool definitions, or Nil
		@return request body
		~#
		method : public : BuildRequest(format : String, options : Options, tools : Vector<Tool>) ~ JsonElement {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", @model);
			query_json->Insert("messages", GetMessages());
			query_json->Insert("stream", false);

			if(options <> Nil) {
				options->ApplyTo(query_json, false);
			};

			if(format <> Nil) {
				query_json->Insert("format", format);
			};

			if(tools <> Nil) {
				tools_json := JsonElement->New(JsonElement->JsonType->ARRAY);
				each(tool in tools) {
					tools_json->Add(tool->ToJson());
				};
				query_json->Insert("tools", tools_json);
			};

			return query_json;
		}

		#~
		Records a reply in the history: an assistant message with its text and tool calls.
		@param reply reply to record
		~#
		method : public : AddReply(reply : Reply) ~ Nil {
			message_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			message_json->Insert("role", "assistant");
			message_json->Insert("content", reply->GetText());

			tool_calls := reply->GetToolCalls();
			if(tool_calls->Size() > 0) {
				calls_json := JsonElement->New(JsonElement->JsonType->ARRAY);
				each(tool_call in tool_calls) {
					calls_json->Add(tool_call->ToJson());
				};
				message_json->Insert("tool_calls", calls_json);
			};

			@messages->AddBack(message_json);
			@last_reply := reply;
		}

		#~
		Sends a message and returns the full reply, including tool calls. When the
		reply has tool calls, run them, add each result with AddToolResult and call
		SendReply(Nil, ...) to get the model's answer.
		@param message user message, or Nil to send the history as it stands
		@param options options and request settings, or Nil
		@param tools tool definitions, or Nil
		@return reply, or Nil with the last error set (the message is then not kept in the history)

```
params := JsonParser->TextToElement("{\"type\":\"object\",\"properties\":{\"city\":{\"type\":\"string\"}},\"required\":[\"city\"]}");
tools := Vector->New()<Tool>;
tools->AddBack(Tool->New("get_weather", "Get the weather for a city", params));

chat := Chat->New("qwen3");
reply := chat->SendReply("What is the weather in Paris?", Nil, tools);
while(reply <> Nil & reply->HasToolCalls()) {
  each(call in reply->GetToolCalls()) {
    city := call->GetArgument("city");
    chat->AddToolResult(call->GetName(), "18C and sunny in {$city}");
  };
  reply := chat->SendReply(Nil, Nil, tools);
};
reply->GetText()->PrintLine();
```
		~#
		method : public : SendReply(message : String, options : Options, tools : Vector<Tool>) ~ Reply {
			images : File[];
			format : String;
			return SendReply(message, images, format, options, tools);
		}

		#~
		Sends a message with images and returns the full reply
		@param message user message
		@param images image files, or Nil
		@param options options and request settings, or Nil
		@param tools tool definitions, or Nil
		@return reply, or Nil with the last error set
		~#
		method : public : SendReply(message : String, images : File[], options : Options, tools : Vector<Tool>) ~ Reply {
			format : String;
			return SendReply(message, images, format, options, tools);
		}

		method : SendReply(message : String, images : File[], format : String, options : Options, tools : Vector<Tool>) ~ Reply {
			added := false;
			if(message <> Nil) {
				message_json := JsonElement->New(JsonElement->JsonType->OBJECT);
				message_json->Insert("role", "user");
				message_json->Insert("content", message);
				if(images <> Nil) {
					images_json := EncodeImages(images);
					if(images_json = Nil) {
						return Nil;
					};
					message_json->Insert("images", images_json);
				};
				@messages->AddBack(message_json);
				added := true;
			};

			body := Post("/api/chat", BuildRequest(format, options, tools));
			reply : Reply;
			if(body <> Nil) {
				reply := Reply->Parse(body);
			};

			if(reply = Nil) {
				if(added) {
					@messages->RemoveBack();
				};
				return Nil;
			};

			AddReply(reply);
			return reply;
		}

		#~
		Chat response from the model given an input
		@param message chat message
		@return chat response, or Nil with the last error set

```
chat := Chat->New("llama3");
chat->Send("What year did the Berlin Wall fall?")->PrintLine();
chat->Send("Who was the US president at the time?")->PrintLine();
```
		~#
		method : public : Send(message : String) ~ String {
			format : String;
			return Send(message, format, Nil, Nil);
		}

		#~
		Chat response with options
		@param message chat message
		@param options options and request settings
		@return chat response, or Nil with the last error set

```
opts := Options->New()->SetTemperature(0.5);
chat := Chat->New("llama3");
chat->Send("Write a haiku about mountains.", opts)->PrintLine();
```
		~#
		method : public : Send(message : String, options : Options) ~ String {
			format : String;
			return Send(message, format, options, Nil);
		}

		#~
		Chat response with format, options and tools. When the model calls a tool the
		text is empty; GetLastReply()->GetToolCalls() has the calls.
		@param message chat message
		@param format output format ("json" or Nil); for a JSON schema use Options->SetFormat
		@param options options and request settings
		@param tools tool definitions for function calling
		@return chat response, or Nil with the last error set

```
opts := Options->New()->SetTemperature(0.0);
chat := Chat->New("llama3");
json_reply := chat->Send("List three colors as JSON.", "json", opts, Nil);
json_reply->PrintLine();
```
		~#
		method : public : Send(message : String, format : String, options : Options, tools : Vector<Tool>) ~ String {
			images : File[];
			reply := SendReply(message, images, format, options, tools);
			if(reply = Nil) {
				return Nil;
			};
			return reply->GetText();
		}

		#~
		Chat response from the model given an input
		@param message chat message
		@param image image file
		@return chat response, or Nil with the last error set

```
