response := Completion->Generate("llama3", "Summarize quantum entanglement briefly.", opts);
response->PrintLine();
```
		~#
		function : Generate(model : String, prompt : String, options : Options) ~ String {
			format : String;
			return Generate(model, prompt, format, options);
		}

		#~
		Generates a response from the model given an input
		@param model model name (i.e. llama3, llava)
		@param prompt prompt
		@param format output format ("json")
		@return query response, or Nil with the last error set
		~#
		function : Generate(model : String, prompt : String, format : String) ~ String {
			return Generate(model, prompt, format, Nil);
		}

		#~
		Generates a response from the model given an input
		@param model model name (i.e. llama3, llava)
		@param prompt prompt
		@param format output format ("json"); for a JSON schema use Options->SetFormat
		@param options options and request settings, or Nil
		@return query response, or Nil with the last error set
		~#
		function : Generate(model : String, prompt : String, format : String, options : Options) ~ String {
			images : File[];
			request := BuildGenerateRequest(model, prompt, format, options, images);
			body := Post("/api/generate", request);
			if(body = Nil) {
