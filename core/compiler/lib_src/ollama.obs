			images := File->New[1];
			images[0] := image;

			return Send(message, images);
		}

		#~
		Chat response from the model given an input
		@param message chat query
		@param images image files
		@return chat response, or Nil with the last error set
		~#
		method : public : Send(message : String, images : File[]) ~ String {
			format : String;
			reply := SendReply(message, images, format, Nil, Nil);
			if(reply = Nil) {
				return Nil;
			};
			return reply->GetText();
		}
	}

	#~
	Ollama detailed model data
	~#
	class ModelDetails {
		@parent_model : String;
		@format : String;
		@family : String;
		@families : Vector<String>;
		@parameter_size : String;
		@quantization_level : String;

		New(details_json : JsonElement) {
			@parent_model := Field->Text(details_json, "parent_model");
			@format := Field->Text(details_json, "format");
			@family := Field->Text(details_json, "family");
			@families := Field->Strings(details_json->Get("families"));
			@parameter_size := Field->Text(details_json, "parameter_size");
			@quantization_level := Field->Text(details_json, "quantization_level");
		}

		#~
		Get the parent model
		@return parent model, or Nil
		~#
		method : public : GetParentModel() ~ String {
			return @parent_model;
		}

		#~
		Get the file format (e.g. "gguf")
		@return format, or Nil
		~#
		method : public : GetFormat() ~ String {
			return @format;
		}

		#~
		Get the model family (e.g. "llama")
		@return family, or Nil
		~#
		method : public : GetFamily() ~ String {
			return @family;
		}

		#~
		Get the model families
		@return families, empty if none
		~#
		method : public : GetFamilies() ~ Vector<String> {
			return @families;
		}

		#~
		Get the parameter size (e.g. "8.0B")
		@return parameter size, or Nil
		~#
		method : public : GetParameterSize() ~ String {
			return @parameter_size;
		}

		#~
		Get the quantization level (e.g. "Q4_0")
		@return quantization level, or Nil
		~#
		method : public : GetQuantizationLevel() ~ String {
			return @quantization_level;
		}

		#~
		String representation of the instance
		@return string representation of the instance
		~#
		method : public : ToString() ~ String {
			buffer := "parent_model='";
			Field->Add(buffer, @parent_model);

			buffer->Append("', format='");
			Field->Add(buffer, @format);

			buffer->Append("', family='");
			Field->Add(buffer, @family);

			buffer->Append("', parameter_size='");
			Field->Add(buffer, @parameter_size);

			buffer->Append("', quantization_level='");
			Field->Add(buffer, @quantization_level);

			buffer->Append('\'');
			return buffer;
		}
	}

	#~
	Ollama model information, from Model->Show
	~#
	class ModelInfo {
		@modelfile : String;
		@parameters : String;
		@system : String;
		@template : String;
		@license : String;
		@capabilities : Vector<String>;
		@model_info : JsonElement;

		New(model_json : JsonElement) {
			@modelfile := Field->Text(model_json, "modelfile");
			@parameters := Field->Text(model_json, "parameters");
			@template := Field->Text(model_json, "template");
			@license := Field->Text(model_json, "license");
			@system := Field->Text(model_json, "system");
			@capabilities := Field->Strings(model_json->Get("capabilities"));
			@model_info := model_json->Get("model_info");
		}

		#~
		String representation of the instance
		@return string representation of the instance
		~#
		method : public : ToString() ~ String {
			buffer := "=> modelfile='";
			if(@modelfile <> Nil) {
				buffer->Append(@modelfile->Size());
			};

			buffer->Append("'\n\t=> parameters='");
			Field->Add(buffer, @parameters);

			buffer->Append("'\n\t=> template='");
			Field->Add(buffer, @template);

			buffer->Append("'\n\t=> license='");
			if(@license <> Nil) {
				buffer->Append(@license->Size());
			};

			if(@system <> Nil) {
				buffer->Append("'\n\t=> system='");
				Field->Add(buffer, @system);
			};

			buffer->Append("'\n\t=> capabilities='");
			each(i : @capabilities) {
				if(i > 0) {
					buffer->Append(',');
				};
				buffer->Append(@capabilities->Get(i));
			};

			buffer->Append('\'');
			return buffer;
		}

		#~
		Get the model file
		@return model file, or Nil
		~#
		method : public : GetModelFile() ~ String {
			return @modelfile;
		}

		#~
		Get the parameters
		@return parameters, or Nil
		~#
		method : public : GetParameters() ~ String {
			return @parameters;
		}

		#~
		Get the template
		@return template, or Nil
		~#
		method : public : GetTemplate() ~ String {
			return @template;
		}

		#~
		Get the license
		@return license, or Nil
		~#
		method : public : GetLicense() ~ String {
			return @license;
		}

		#~
		Get the system
		@return system, or Nil
		~#
		method : public : GetSystem() ~ String {
			return @system;
		}

		#~
		Get the model's capabilities (e.g. "completion", "tools", "vision", "thinking", "embedding")
		@return capabilities, empty if the server did not report them
		~#
		method : public : GetCapabilities() ~ Vector<String> {
			return @capabilities;
		}

		#~
		Checks for a capability
		@param capability capability name (e.g. "tools")
		@return true if the model has it
		~#
		method : public : HasCapability(capability : String) ~ Bool {
			each(value in @capabilities) {
				if(value->Equals(capability)) {
					return true;
				};
			};
			return false;
		}

		#~
		Get the architecture metadata (e.g. "general.architecture", "llama.context_length")
		@return metadata object, or Nil
		~#
		method : public : GetModelInfo() ~ JsonElement {
			return @model_info;
		}
	}

	#~
	Ollama model listing entry, from Model->List (/api/tags) or Model->Running (/api/ps)
	~#
	class ModelPulled {
		@name : String;
		@model : String;
		@modified_at_str : String;
		@expires_at_str : String;
		@size : Int;
		@size_vram : Int;
		@digest : String;

		New(model_json : JsonElement) {
			@name := Field->Text(model_json, "name");
			@model := Field->Text(model_json, "model");
			@modified_at_str := Field->Text(model_json, "modified_at");
			@expires_at_str := Field->Text(model_json, "expires_at");
			@size := Field->IntOf(model_json, "size");
			@size_vram := Field->IntOf(model_json, "size_vram");
			@digest := Field->Text(model_json, "digest");
		}

		#~
		String representation of the instance
		@return string representation of the instance
		~#
		method : public : ToString() ~ String {
			buffer := "name='";
			Field->Add(buffer, @name);

			buffer->Append("', model='");
			Field->Add(buffer, @model);

			buffer->Append("', modified_at_str='");
			Field->Add(buffer, @modified_at_str);

			buffer->Append("', size='");
			buffer->Append(@size);

			buffer->Append("', digest='");
			Field->Add(buffer, @digest);

			buffer->Append('\'');
			return buffer;
		}

		#~
		Get the name
		@return name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Get the model
		@return model
		~#
		method : public : GetModel() ~ String {
			return @model;
		}

		#~
		Get modified time (Model->List only)
		@return modified time, or Nil
		~#
		method : public : GetModifiedTime() ~ System.Time.Date {
			if(@modified_at_str = Nil) {
				return Nil;
			};
			return System.Time.DateUtility->Parse(@modified_at_str, "yyyy-MM-ddThh:mm:ss", false);
		}

		#~
		Get when a running model will be unloaded, as the server's timestamp text (Model->Running only)
		@return expiry timestamp, or Nil
		~#
		method : public : GetExpiresAt() ~ String {
			return @expires_at_str;
		}

		#~
		Get the model size
		@return model size in bytes
		~#
		method : public : GetSize() ~ Int {
			return @size;
		}

		#~
		Get the memory a running model uses on the GPU (Model->Running only)
		@return size in bytes, 0 if not reported
		~#
		method : public : GetSizeVram() ~ Int {
			return @size_vram;
		}

		#~
		Get the model digest
		@return model digest
		~#
		method : public : GetDigest() ~ String {
			return @digest;
		}
	}

	#~
	Ollama model operations: listing, details, pull, copy, delete, create and embeddings

```
models := Model->List();
if(models <> Nil) {
  each(m in models) {
    m->GetPulled()->GetName()->PrintLine();
  };
};
```
	~#
	class Model from EndPoint {
		@model_info : ModelInfo;
		@model_pulled : ModelPulled;
		@model_details : ModelDetails;

		New(model_json : JsonElement) {
			Parent();

			if(model_json->Has("modelfile") | model_json->Has("capabilities") | model_json->Has("model_info")) {
				@model_info := ModelInfo->New(model_json);
			}
			else {
				@model_pulled := ModelPulled->New(model_json);
			};

			details_json := model_json->Get("details");
			if(details_json <> Nil & details_json->GetType() = JsonElement->JsonType->OBJECT) {
				@model_details := ModelDetails->New(details_json);
			};
		}

		#~
		Get the model details
		@return model details, or Nil
		~#
		method : public : GetDetails() ~ ModelDetails {
			return @model_details;
		}

		#~
		Get the listing entry (Model->List and Model->Running)
		@return listing entry, or Nil
		~#
		method : public : GetPulled() ~ ModelPulled {
			return @model_pulled;
		}

		#~
		Get the model information (Model->Show)
		@return model information, or Nil
		~#
		method : public : GetInfo() ~ ModelInfo {
			return @model_info;
		}

		#~
		String representation of the instance
		@return string representation of the instance
		~#
		method : public : ToString() ~ String {
			buffer := "";

			if(@model_info <> Nil ) {
				buffer->Append("info: [\n\t");
				buffer->Append(@model_info->ToString());
				buffer->Append("]");
			};

			if(@model_pulled <> Nil ) {
				buffer->Append("created: [\n\t");
				buffer->Append(@model_pulled->ToString());
				buffer->Append("]");
			};

			if(@model_details <> Nil) {
				buffer->Append("\ndetails: [\n\t");
				buffer->Append(@model_details->ToString());
				buffer->Append("]");
			};

			return buffer;
		}

		#~
		Parses a /api/tags or /api/ps response body.
		@param body response text
		@return models, or Nil with the last error set
		~#
		function : ParseModelList(body : String) ~ Vector<Model> {
			json := ParseResponse(body);
			if(json = Nil) {
				return Nil;
			};

			models_json := json->Get("models");
			if(models_json = Nil | models_json->GetType() <> JsonElement->JsonType->ARRAY) {
				ReportError(json);
				return Nil;
			};

			models := Vector->New()<Model>;
			each(i : models_json) {
				model_json := models_json->Get(i);
				if(model_json->GetType() = JsonElement->JsonType->OBJECT) {
					models->AddBack(Model->New(model_json));
				};
			};

			return models;
		}

		#~
		Parses a /api/show response body.
		@param body response text
		@return model, or Nil with the last error set
		~#
		function : ParseShowResponse(body : String) ~ Model {
			json := ParseResponse(body);
			if(json = Nil) {
				return Nil;
			};

			if(json->Has("error") | json->GetType() <> JsonElement->JsonType->OBJECT) {
				ReportError(json);
				return Nil;
			};

			return Model->New(json);
		}

		#~
		Parses a /api/version response body.
		@param body response text
		@return version, or Nil with the last error set
		~#
		function : ParseVersionResponse(body : String) ~ String {
			json := ParseResponse(body);
			if(json = Nil) {
				return Nil;
			};

			version := Field->Text(json, "version");
			if(version = Nil) {
				ReportError(json);
			};
			return version;
		}

		#~
		Parses a {"status": ...} response body (pull, create).
		@param body response text
		@return true if the status is "success"; otherwise false with the last error set
		~#
		function : ParseStatusResponse(body : String) ~ Bool {
			json := ParseResponse(body);
			if(json = Nil) {
				return false;
			};

			status := Field->Text(json, "status");
			if(status = Nil | json->Has("error")) {
				ReportError(json);
				return false;
			};

			if(<>status->Equals("success")) {
				SetLastError("status: {$status}");
				return false;
			};

			return true;
		}

		#~
		List the models available locally
		@return list of models, or Nil with the last error set

```
models := Model->List();
if(models <> Nil) {
  each(m in models) {
    m->GetPulled()->GetName()->PrintLine();
  };
};
```
		~#
		function : List() ~ Vector<Model> {
			body := Fetch("/api/tags");
			if(body = Nil) {
				return Nil;
			};
			return ParseModelList(body);
		}

		#~
		List the models currently loaded in memory
		@return list of models (see ModelPulled->GetSizeVram and GetExpiresAt), or Nil with the last error set

```
running := Model->Running();
if(running <> Nil) {
  each(m in running) {
    pulled := m->GetPulled();
    name := pulled->GetName(); vram := pulled->GetSizeVram();
    "{$name}: {$vram} bytes VRAM"->PrintLine();
  };
};
```
		~#
		function : Running() ~ Vector<Model> {
			body := Fetch("/api/ps");
			if(body = Nil) {
				return Nil;
			};
			return ParseModelList(body);
		}

		#~
		Get the Ollama server version
		@return version (e.g. "0.12.6"), or Nil with the last error set
		~#
		function : Version() ~ String {
			body := Fetch("/api/version");
			if(body = Nil) {
				return Nil;
			};
			return ParseVersionResponse(body);
		}

		#~
		Download a model from the ollama library. Waits for the download to finish; no progress is reported.
		@param name name of the model to pull
		@return true if successful, false otherwise (see EndPoint->GetLastError)

```
if(Model->Pull("llama3")) {
  "Model downloaded successfully."->PrintLine();
};
```
		~#
		function : Pull(name : String) ~ Bool {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", name);
			query_json->Insert("stream", false);

			body := Post("/api/pull", query_json);
			if(body = Nil) {
				return false;
			};
			return ParseStatusResponse(body);
		}

		#~
		Show information about a model
		@param name name of the model to show
		@return model (see GetInfo and GetDetails), or Nil with the last error set

```
model := Model->Show("llama3");
if(model <> Nil) {
  model->GetDetails()->GetParameterSize()->PrintLine();
  model->GetInfo()->HasCapability("tools")->PrintLine();
};
```
		~#
		function : Show(name : String) ~ Model {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", name);

			body := Post("/api/show", query_json);
			if(body = Nil) {
				return Nil;
			};
			return ParseShowResponse(body);
		}

		#~
		Delete a model and its data.
		@param name name of the model to delete
		@return true if successful, false otherwise (see EndPoint->GetLastError)

```
if(Model->Delete("llama3")) {
  "Model deleted."->PrintLine();
};
```
		~#
		function : Delete(name : String) ~ Bool {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", name);

			SetLastError(Nil);
			host := EndPoint->GetHost();
			url := Url->New("{$host}/api/delete");
			response := Web.HTTP.HttpClient->QuickDelete(url, query_json->ToString()->ToByteArray(), "application/json");
			return Succeeded(response);
		}

		#~
		Copy a model
		@param src source name of the model to copy
		@param dest destination name of the model to copy
		@return true if successful, false otherwise (see EndPoint->GetLastError)

```
if(Model->Copy("llama3", "llama3-backup")) {
  "Model copied."->PrintLine();
};
```
		~#
		function : Copy(src : String, dest : String) ~ Bool {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("source", src);
			query_json->Insert("destination", dest);

			SetLastError(Nil);
			host := EndPoint->GetHost();
			url := Url->New("{$host}/api/copy");
			response := Web.HTTP.HttpClient->QuickPost(url, query_json->ToString()->ToByteArray(), "application/json");
			return Succeeded(response);
		}

		#~
		Builds the /api/embed request body.
		@param model embedding model name
		@param inputs texts to embed
		@param truncate true to truncate inputs that exceed the context; false makes the server return an error instead
		@param dimensions embedding size for models that support it, or 0 for the model's own
		@param options options and request settings (e.g. keep_alive), or Nil
		@return request body
		~#
		function : BuildEmbedRequest(model : String, inputs : String[], truncate : Bool, dimensions : Int, options : Options) ~ JsonElement {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", model);

			if(inputs->Size() = 1) {
				query_json->Insert("input", inputs[0]);
			}
			else {
				inputs_json := JsonElement->New(JsonElement->JsonType->ARRAY);
				each(input in inputs) {
					inputs_json->Add(input);
				};
				query_json->Insert("input", inputs_json);
			};

			query_json->Insert("truncate", truncate);
			if(dimensions > 0) {
				query_json->Insert("dimensions", dimensions);
			};

			if(options <> Nil) {
				options->ApplyTo(query_json, false);
			};

			return query_json;
		}

		#~
		Parses a /api/embed response body.
		@param body response text
		@return one row per input, or Nil with the last error set
		~#
		function : ParseEmbedResponse(body : String) ~ Float[,] {
			json := ParseResponse(body);
			if(json = Nil) {
				return Nil;
			};

			rows_json := json->Get("embeddings");
			if(rows_json = Nil | rows_json->GetType() <> JsonElement->JsonType->ARRAY | json->Has("error")) {
				ReportError(json);
				return Nil;
			};

			rows := rows_json->Size();
			if(rows = 0) {
				SetLastError("response contained no embeddings");
				return Nil;
			};

			cols := rows_json->Get(0)->Size();
			embeddings := Float->New[rows, cols];
			for(i := 0; i < rows; i += 1;) {
				row_json := rows_json->Get(i);
				if(row_json->GetType() <> JsonElement->JsonType->ARRAY | row_json->Size() <> cols) {
					SetLastError("embeddings differ in size");
					return Nil;
				};

				for(j := 0; j < cols; j += 1;) {
					embeddings[i, j] := row_json->Get(j)->GetFloat();
				};
			};

			return embeddings;
		}

		#~
		Embeds one text with /api/embed
		@param model embedding model name
		@param input text to embed
		@return embedding vector, or Nil with the last error set

```
vector := Model->Embed("nomic-embed-text", "The sky is blue.");
if(vector <> Nil) {
  "Dimensions: {$vector->Size()}"->PrintLine();
};
```
		~#
		function : Embed(model : String, input : String) ~ Float[] {
			inputs := String->New[1];
			inputs[0] := input;

			embeddings := Embed(model, inputs, true, 0, Nil);
			if(embeddings = Nil) {
				return Nil;
			};

			dims := embeddings->Size();
			vector := Float->New[dims[1]];
			each(j : vector) {
				vector[j] := embeddings[0, j];
			};
			return vector;
		}

		#~
		Embeds a batch of texts with /api/embed in one request
		@param model embedding model name
		@param inputs texts to embed
		@return one row per input, or Nil with the last error set
		~#
		function : Embed(model : String, inputs : String[]) ~ Float[,] {
			return Embed(model, inputs, true, 0, Nil);
		}

		#~
		Embeds a batch of texts with /api/embed in one request
		@param model embedding model name
		@param inputs texts to embed
		@param truncate true to truncate inputs that exceed the context; false makes the server return an error instead
		@param dimensions embedding size for models that support it, or 0 for the model's own
		@param options options and request settings (e.g. keep_alive), or Nil
		@return one row per input, or Nil with the last error set

```
texts := ["The sky is blue.", "Grass is green."];
embeddings := Model->Embed("nomic-embed-text", texts, true, 0, Nil);
if(embeddings <> Nil) {
  dims := embeddings->Size();
  "{$dims[0]} vectors of {$dims[1]}"->PrintLine();
};
```
		~#
		function : Embed(model : String, inputs : String[], truncate : Bool, dimensions : Int, options : Options) ~ Float[,] {
			if(inputs = Nil | inputs->Size() = 0) {
				SetLastError("no inputs to embed");
				return Nil;
			};

			body := Post("/api/embed", BuildEmbedRequest(model, inputs, truncate, dimensions, options));
			if(body = Nil) {
				return Nil;
			};
			return ParseEmbedResponse(body);
		}

		#~
		Generate embeddings from a model with the older /api/embeddings endpoint (superseded by Embed)
		@param model name of model to generate embeddings from
		@param prompt text to generate embeddings for
		@return embedding vector as Float array, or Nil with the last error set

```
embeddings := Model->Embeddings("nomic-embed-text", "The sky is blue.");
if(embeddings <> Nil) {
  "Dimensions: {$embeddings->Size()}"->PrintLine();
};
```
		~#
		function : Embeddings(model : String, prompt  : String) ~ Float[] {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", model);
			query_json->Insert("prompt", prompt);

			body := Post("/api/embeddings", query_json);
			if(body = Nil) {
				return Nil;
			};

			json := ParseResponse(body);
			if(json = Nil) {
				return Nil;
			};

			embedding_json := json->Get("embedding");
			if(embedding_json = Nil | embedding_json->GetType() <> JsonElement->JsonType->ARRAY) {
				ReportError(json);
				return Nil;
			};

			embedding := Float->New[embedding_json->Size()];
			each(i : embedding) {
				embedding[i] := embedding_json->Get(i)->GetFloat();
			};
			return embedding;
		}

		#~
		Create a model from an existing one with a new system prompt
		@param name name of the model to create
		@param base name of the model to start from
		@param system system prompt, or Nil
		@return true if successful, false otherwise (see EndPoint->GetLastError)

```
if(Model->Create("my-assistant", "llama3", "You are a helpful assistant.")) {
  "Custom model created."->PrintLine();
};
```
		~#
		function : Create(name : String, base : String, system : String) ~ Bool {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", name);
			query_json->Insert("from", base);
			if(system <> Nil) {
				query_json->Insert("system", system);
			};
			query_json->Insert("stream", false);

			body := Post("/api/create", query_json);
			if(body = Nil) {
				return false;
			};
			return ParseStatusResponse(body);
		}

		#~
		Create a model from a Modelfile description. Only servers older than Ollama 0.5.5
		accept a Modelfile; newer ones reject the request (see EndPoint->GetLastError), so
		use Create(name, from, system) with them.
		@param name name of the model to create
		@param modelfile contents of the Modelfile
		@return true if successful, false otherwise
		~#
		function : Create(name : String, modelfile  : String) ~ Bool {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("name", name);
			query_json->Insert("modelfile", modelfile);
			query_json->Insert("stream", false);

			body := Post("/api/create", query_json);
			if(body = Nil) {
				return false;
			};
			return ParseStatusResponse(body);
		}
	}
}
