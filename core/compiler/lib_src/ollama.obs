use Web.HTTP, Collection, Data.JSON, Data.JSON.Scheme, System.IO.Filesystem;

#~
Ollama local LLM client. Runs models (Llama, Mistral, Phi, Qwen, etc.) locally via the Ollama server. Supports text generation, chat sessions with tool calling, structured (JSON schema) output, thinking models, images, batch embeddings and model management. Every request completes before returning -- responses are not streamed, so a long generation produces nothing until it finishes. Compile with -lib ollama.
~#
bundle API.Ollama {
	#~
	Ollama enabled endpoint class
	~#
	class EndPoint {
		@last_error : static : String;
		@host : static : String;

		function : SetLastError(last_error : String) ~ Nil {
			@last_error := last_error;
		}

		#~
		Get the last error
		@return last error
		~#
		function : GetLastError() ~ String {
			return @last_error;
		}

		#~
		Parse a response body. Nil, with the last error set, when the body is not
		JSON. Every request in this library used to inline this and the error
		check that follows; one of the ten copies had its else-if bound to the
		wrong if, so an {"error": ...} reply -- the shape Ollama actually sends --
		was swallowed and a non-JSON body dereferenced Nil.
		@param body response text
		@return parsed element, or Nil
		~#
		function : ParseResponse(body : String) ~ JsonElement {
			if(body = Nil) {
				SetLastError("empty response");
				return Nil;
			};
			json := JsonParser->TextToElement(body);
			if(json = Nil) {
				SetLastError("response was not JSON");
			};
			return json;
		}

		#~
		Record the error a response carries, or that it carried nothing usable.
		@param json parsed response that lacked the expected field
		~#
		function : ReportError(json : JsonElement) ~ Nil {
			if(json <> Nil & json->Has("error")) {
				SetLastError(Field->Text(json->Get("error")));
			}
			else {
				SetLastError("response did not contain the expected field");
			};
		}

		#~
		Sets the Ollama server host URL (e.g. "http://myserver:11434")
		@param host server URL without trailing slash
		~#
		function : SetHost(host : String) ~ Nil {
			@host := host;
		}

		#~
		Gets the Ollama server host URL. Defaults to http://localhost:11434.
		@return host URL
		~#
		function : GetHost() ~ String {
			if(@host = Nil) {
				@host := "http://localhost:11434";
			};
			return @host;
		}

		# POST a JSON body to an /api path; the response text, or Nil with the last error set
		function : private : Post(path : String, request : JsonElement) ~ String {
			SetLastError(Nil);
			host := GetHost();
			url := Url->New("{$host}{$path}");
			response := Web.HTTP.HttpClient->QuickPost(url, request->ToString()->ToByteArray(), "application/json");
			return Content(response, url);
		}

		# GET an /api path; the response text, or Nil with the last error set
		function : private : Fetch(path : String) ~ String {
			SetLastError(Nil);
			host := GetHost();
			url := Url->New("{$host}{$path}");
			response := Web.HTTP.HttpClient->QuickGet(url, "application/json");
			return Content(response, url);
		}

		function : private : Content(response : Web.HTTP.Response, url : Url) ~ String {
			if(response = Nil) {
				url_str := url->ToString();
				SetLastError("no response from {$url_str}");
				return Nil;
			};

			content := response->GetContent();
			if(content = Nil) {
				code := response->GetCode();
				SetLastError("empty response (HTTP {$code})");
				return Nil;
			};

			return content->ToString();
		}

		# True for an HTTP 200; otherwise the last error is set from the body, if it has one
		function : private : Succeeded(response : Web.HTTP.Response) ~ Bool {
			if(response = Nil) {
				SetLastError("no response from server");
				return false;
			};

			code := response->GetCode();
			if(code = 200) {
				return true;
			};

			content := response->GetContent();
			if(content <> Nil) {
				json := JsonParser->TextToElement(content->ToString());
				if(json <> Nil & json->Has("error")) {
					ReportError(json);
					return false;
				};
			};
			SetLastError("request failed (HTTP {$code})");

			return false;
		}

		# Base64 encodes image files for an 'images' field; Nil, with the last error set, if one cannot be read
		function : private : EncodeImages(images : File[]) ~ JsonElement {
			images_json := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(file in images) {
				if(file = Nil | <>file->Exists()) {
					SetLastError("image file not found");
					return Nil;
				};

				file_data := System.IO.Filesystem.FileReader->ReadBinaryFile(file->GetFullName());
				if(file_data = Nil) {
					name := file->GetFullName();
					SetLastError("unable to read image file: {$name}");
					return Nil;
				};

				images_json->Add(Cipher.Encrypt->Base64(file_data));
			};

			return images_json;
		}
	}

	# Reads fields out of parsed responses. The JSON parser decodes strings, so
	# a value read here is the text itself and an element can be sent back as
	# it is: the serializer escapes it once on the way out.
	class : private : Field {
		# decoded string value, or Nil when absent or null
		function : Text(elem : JsonElement) ~ String {
			if(elem = Nil | elem->IsNull()) {
				return Nil;
			};

			if(elem->GetType() = JsonElement->JsonType->STRING) {
				return elem->GetString();
			};

			return elem->ToString();
		}

		function : Text(json : JsonElement, name : String) ~ String {
			if(json = Nil) {
				return Nil;
			};
			return Text(json->Get(name));
		}

		function : IntOf(json : JsonElement, name : String) ~ Int {
			if(json = Nil) {
				return 0;
			};

			elem := json->Get(name);
			if(elem = Nil | elem->GetType() <> JsonElement->JsonType->NUMBER) {
				return 0;
			};
			return elem->GetInt();
		}

		function : BoolOf(json : JsonElement, name : String) ~ Bool {
			if(json = Nil) {
				return false;
			};

			elem := json->Get(name);
			return elem <> Nil & elem->GetType() = JsonElement->JsonType->TRUE;
		}

		function : Strings(elem : JsonElement) ~ Vector<String> {
			values := Vector->New()<String>;
			if(elem <> Nil & elem->GetType() = JsonElement->JsonType->ARRAY) {
				each(i : elem) {
					value := Text(elem->Get(i));
					if(value <> Nil) {
						values->AddBack(value);
					};
				};
			};
			return values;
		}

		# appends text that may be Nil
		function : Add(buffer : String, value : String) ~ Nil {
			if(value <> Nil) {
				buffer->Append(value);
			};
		}
	}

	#~
	Generation options and request settings. Model parameters (temperature, top_p,
	num_ctx, seed, stop, ...) are sent in the request's 'options' object; request
	settings (format, think, keep_alive, and for Completion system, template,
	suffix and raw) are sent as top-level request fields.

```
schema := JsonParser->TextToElement("{\"type\":\"object\",\"properties\":{\"answer\":{\"type\":\"integer\"}},\"required\":[\"answer\"]}");
options := Options->New();
options->SetTemperature(0.0)->SetSeed(42)->SetNumCtx(8192);
options->SetFormat(schema)->SetKeepAlive("10m");
```
	~#
	class Options {
		@values : JsonElement;
		@fields : JsonElement;

		New() {
			@values := JsonElement->New(JsonElement->JsonType->OBJECT);
			@fields := JsonElement->New(JsonElement->JsonType->OBJECT);
		}

		#~
		Sets the temperature (0.0 to 2.0). Lower is more deterministic.
		@param t temperature value
		@return self for chaining
		~#
		method : public : SetTemperature(t : Float) ~ Options {
			@values->Insert("temperature", t);
			return @self;
		}

		#~
		Sets the top-p (nucleus sampling) value.
		@param p top-p value (0.0 to 1.0)
		@return self for chaining
		~#
		method : public : SetTopP(p : Float) ~ Options {
			@values->Insert("top_p", p);
			return @self;
		}

		#~
		Sets the top-k sampling value.
		@param k top-k value
		@return self for chaining
		~#
		method : public : SetTopK(k : Int) ~ Options {
			@values->Insert("top_k", k);
			return @self;
		}

		#~
		Sets the min-p sampling value.
		@param p min-p value (0.0 to 1.0)
		@return self for chaining
		~#
		method : public : SetMinP(p : Float) ~ Options {
			@values->Insert("min_p", p);
			return @self;
		}

		#~
		Sets the context window size in tokens.
		@param n context size
		@return self for chaining
		~#
		method : public : SetNumCtx(n : Int) ~ Options {
			@values->Insert("num_ctx", n);
			return @self;
		}

		#~
		Sets the maximum number of tokens to generate (-1 for no limit).
		@param n token limit
		@return self for chaining
		~#
		method : public : SetNumPredict(n : Int) ~ Options {
			@values->Insert("num_predict", n);
			return @self;
		}

		#~
		Sets the random seed, for reproducible output.
		@param seed seed value
		@return self for chaining
		~#
		method : public : SetSeed(seed : Int) ~ Options {
			@values->Insert("seed", seed);
			return @self;
		}

		#~
		Sets the repeat penalty.
		@param penalty penalty value (1.0 is no penalty)
		@return self for chaining
		~#
		method : public : SetRepeatPenalty(penalty : Float) ~ Options {
			@values->Insert("repeat_penalty", penalty);
			return @self;
		}

		#~
		Sets the stop sequences; generation ends when one is produced.
		@param stops stop sequences
		@return self for chaining
		~#
		method : public : SetStop(stops : String[]) ~ Options {
			stops_json := JsonElement->New(JsonElement->JsonType->ARRAY);
			each(stop in stops) {
				stops_json->Add(stop);
			};
			@values->Insert("stop", stops_json);
			return @self;
		}

		#~
		Sets any numeric model parameter by name (see the Modelfile parameter list).
		@param name parameter name
		@param value parameter value
		@return self for chaining
		~#
		method : public : Set(name : String, value : Float) ~ Options {
			@values->Insert(name, value);
			return @self;
		}

		#~
		Sets any integer model parameter by name (see the Modelfile parameter list).
		@param name parameter name
		@param value parameter value
		@return self for chaining
		~#
		method : public : Set(name : String, value : Int) ~ Options {
			@values->Insert(name, value);
			return @self;
		}

		#~
		Sets the output format to "json" (any JSON value).
		@param format "json"
		@return self for chaining
		~#
		method : public : SetFormat(format : String) ~ Options {
			@fields->Insert("format", format);
			return @self;
		}

		#~
		Sets the output format to a JSON schema (structured output); the reply text is JSON matching the schema.
		@param schema JSON schema
		@return self for chaining
		~#
		method : public : SetFormat(schema : JsonElement) ~ Options {
			@fields->Insert("format", schema);
			return @self;
		}

		#~
		Enables or disables thinking for thinking models; the reasoning is returned separately (see Reply->GetThinking).
		@param think true to think
		@return self for chaining
		~#
		method : public : SetThink(think : Bool) ~ Options {
			@fields->Insert("think", think);
			return @self;
		}

		#~
		Sets the thinking level for models that support levels ("low", "medium" or "high").
		@param level thinking level
		@return self for chaining
		~#
		method : public : SetThink(level : String) ~ Options {
			@fields->Insert("think", level);
			return @self;
		}

		#~
		Sets how long the model stays loaded after the request (e.g. "5m", "1h", "0" to unload).
		@param duration keep-alive duration
		@return self for chaining
		~#
		method : public : SetKeepAlive(duration : String) ~ Options {
			@fields->Insert("keep_alive", duration);
			return @self;
		}

		#~
		Sets the system prompt, overriding the Modelfile's (Completion only; a Chat takes a "system" message instead).
		@param system system prompt
		@return self for chaining
		~#
		method : public : SetSystem(system : String) ~ Options {
			@fields->Insert("system", system);
			return @self;
		}

		#~
		Sets the prompt template, overriding the Modelfile's (Completion only).
		@param template prompt template
		@return self for chaining
		~#
		method : public : SetTemplate(template : String) ~ Options {
			@fields->Insert("template", template);
			return @self;
		}

		#~
		Sets the text that follows the generated text, for fill-in-the-middle (Completion only).
		@param suffix suffix text
		@return self for chaining
		~#
		method : public : SetSuffix(suffix : String) ~ Options {
			@fields->Insert("suffix", suffix);
			return @self;
		}

		#~
		Sends the prompt without applying the prompt template (Completion only).
		@param raw true for a raw prompt
		@return self for chaining
		~#
		method : public : SetRaw(raw : Bool) ~ Options {
			@fields->Insert("raw", raw);
			return @self;
		}

		#~
		Converts the model parameters to JSON for the request's 'options' object.
		@return JSON element, or Nil if no model parameters are set
		~#
		method : public : ToJson() ~ JsonElement {
			if(@values->Size() = 0) {
				return Nil;
			};

			return @values;
		}

		#~
		Adds the model parameters and request settings to a request body.
		@param request request body
		@param generate true for an /api/generate request; system, template, suffix and raw are sent only then
		~#
		method : public : ApplyTo(request : JsonElement, generate : Bool) ~ Nil {
			if(@values->Size() > 0) {
				request->Insert("options", @values);
			};

			names := @fields->GetNames();
			each(name in names) {
				if(generate | (<>name->Equals("system") & <>name->Equals("template") & <>name->Equals("suffix") & <>name->Equals("raw"))) {
					request->Insert(name, @fields->Get(name));
				};
			};
		}
	}

	#~
	Tool definition for function calling in chat.

```
params := JsonParser->TextToElement("{\"type\":\"object\",\"properties\":{\"location\":{\"type\":\"string\"}},\"required\":[\"location\"]}");
tool := Tool->New("get_weather", "Get the weather for a location", params);
```
	~#
	class Tool {
		@name : String;
		@description : String;
		@parameters : JsonElement;

		#~
		Constructor
		@param name function name
		@param description function description
		@param parameters JSON schema for parameters
		~#
		New(name : String, description : String, parameters : JsonElement) {
			@name := name;
			@description := description;
			@parameters := parameters;
		}

		#~
		Constructor from a function definition, the form the other AI client libraries use
		@param func function definition
		~#
		New(func : FunctionType) {
			@name := func->GetName();
			@description := func->GetDesc();

			func_json := func->ToJson();
			@parameters := JsonElement->New(JsonElement->JsonType->OBJECT);
			@parameters->Insert("type", "object");
			@parameters->Insert("properties", func_json->Get("properties"));
			required_json := func_json->Get("required");
			if(required_json <> Nil) {
				@parameters->Insert("required", required_json);
			};
		}

		#~
		Get the function name
		@return function name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Converts tool to JSON for the request.
		@return JSON element
		~#
		method : public : ToJson() ~ JsonElement {
			tool_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			tool_json->Insert("type", "function");

			func_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			func_json->Insert("name", @name);
			if(@description <> Nil) {
				func_json->Insert("description", @description);
			};
			if(@parameters <> Nil) {
				func_json->Insert("parameters", @parameters);
			};

			tool_json->Insert("function", func_json);
			return tool_json;
		}
	}

	#~
	A function call the model asked for. Run it, then return the result with Chat->AddToolResult.
	~#
	class ToolCall {
		@name : String;
		@arguments : JsonElement;

		New(call_json : JsonElement) {
			func_json := call_json->Get("function");
			if(func_json <> Nil) {
				@name := Field->Text(func_json, "name");
				@arguments := func_json->Get("arguments");
			};

			if(@arguments = Nil) {
				@arguments := JsonElement->New(JsonElement->JsonType->OBJECT);
			};
		}

		#~
		Get the name of the function to call
		@return function name
		~#
		method : public : GetName() ~ String {
			return @name;
		}

		#~
		Get the call's arguments, an object keyed by parameter name
		@return arguments
		~#
		method : public : GetArguments() ~ JsonElement {
			return @arguments;
		}

		#~
		Get one argument as text (a number or boolean in its JSON form)
		@param name parameter name
		@return argument text, or Nil if absent
		~#
		method : public : GetArgument(name : String) ~ String {
			elem := @arguments->Get(name);
			if(elem = Nil | elem->IsNull()) {
				return Nil;
			};

			if(elem->GetType() = JsonElement->JsonType->STRING) {
				return elem->GetString();
			};

			return elem->ToString();
		}

		#~
		Converts the call to JSON, as it appears in an assistant message
		@return JSON element
		~#
		method : public : ToJson() ~ JsonElement {
			func_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			func_json->Insert("name", @name);
			func_json->Insert("arguments", @arguments);

			call_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			call_json->Insert("function", func_json);
			return call_json;
		}
	}

	#~
	A complete reply from /api/generate or /api/chat: the text, any thinking and tool calls, and the timing and token counts. Durations are in nanoseconds.

```
reply := Completion->GenerateReply("llama3", "Why is the sky blue?", Nil);
if(reply <> Nil) {
  reply->GetText()->PrintLine();
  "tokens: {$reply->GetEvalCount()}, done: {$reply->GetDoneReason()}"->PrintLine();
};
```
	~#
	class Reply {
		@model : String;
		@role : String;
		@text : String;
		@thinking : String;
		@done : Bool;
		@done_reason : String;
		@tool_calls : Vector<ToolCall>;
		@total_duration : Int;
		@load_duration : Int;
		@prompt_eval_count : Int;
		@prompt_eval_duration : Int;
		@eval_count : Int;
		@eval_duration : Int;

		New(json : JsonElement) {
			@model := Field->Text(json, "model");
			@done := Field->BoolOf(json, "done");
			@done_reason := Field->Text(json, "done_reason");
			@total_duration := Field->IntOf(json, "total_duration");
			@load_duration := Field->IntOf(json, "load_duration");
			@prompt_eval_count := Field->IntOf(json, "prompt_eval_count");
			@prompt_eval_duration := Field->IntOf(json, "prompt_eval_duration");
			@eval_count := Field->IntOf(json, "eval_count");
			@eval_duration := Field->IntOf(json, "eval_duration");
			@tool_calls := Vector->New()<ToolCall>;

			message_json := json->Get("message");
			if(message_json <> Nil) {
				# /api/chat
				@role := Field->Text(message_json, "role");
				@text := Field->Text(message_json, "content");
				@thinking := Field->Text(message_json, "thinking");

				calls_json := message_json->Get("tool_calls");
				if(calls_json <> Nil & calls_json->GetType() = JsonElement->JsonType->ARRAY) {
					each(i : calls_json) {
						@tool_calls->AddBack(ToolCall->New(calls_json->Get(i)));
					};
				};
			}
			else {
				# /api/generate
				@role := "assistant";
				@text := Field->Text(json, "response");
				@thinking := Field->Text(json, "thinking");
			};

			if(@text = Nil) {
				@text := "";
			};
		}

		#~
		Parses a /api/generate or /api/chat response body.
		@param body response text
		@return reply, or Nil with the last error set (EndPoint->GetLastError) for an error body or one that is not a reply
		~#
		function : Parse(body : String) ~ Reply {
			json := EndPoint->ParseResponse(body);
			if(json = Nil) {
				return Nil;
			};

			if(<>json->Has("error") & (json->Has("message") | json->Has("response"))) {
				return Reply->New(json);
			};

			EndPoint->ReportError(json);
			return Nil;
		}

		#~
		Get the generated text (empty when the model only called tools)
		@return text
		~#
		method : public : GetText() ~ String {
			return @text;
		}

		#~
		Get the model's reasoning, for thinking models with think enabled
		@return thinking text, or Nil
		~#
		method : public : GetThinking() ~ String {
			return @thinking;
		}

		#~
		Get the role of the reply message
		@return role (normally "assistant")
		~#
		method : public : GetRole() ~ String {
			return @role;
		}

		#~
		Get the model that replied
		@return model name
		~#
		method : public : GetModel() ~ String {
			return @model;
		}

		#~
		Get the tool calls the model made (chat with tools only)
		@return tool calls, empty if none
		~#
		method : public : GetToolCalls() ~ Vector<ToolCall> {
			return @tool_calls;
		}

		#~
		Checks for tool calls
		@return true if the model called one or more tools
		~#
		method : public : HasToolCalls() ~ Bool {
			return @tool_calls->Size() > 0;
		}

		#~
		Checks whether generation finished
		@return true if done
		~#
		method : public : IsDone() ~ Bool {
			return @done;
		}

		#~
		Get why generation stopped (e.g. "stop", "length", "load")
		@return done reason, or Nil
		~#
		method : public : GetDoneReason() ~ String {
			return @done_reason;
		}

		#~
		Get the total request time
		@return nanoseconds
		~#
		method : public : GetTotalDuration() ~ Int {
			return @total_duration;
		}

		#~
		Get the time spent loading the model
		@return nanoseconds
		~#
		method : public : GetLoadDuration() ~ Int {
			return @load_duration;
		}

		#~
		Get the number of prompt tokens evaluated
		@return token count
		~#
		method : public : GetPromptEvalCount() ~ Int {
			return @prompt_eval_count;
		}

		#~
		Get the time spent evaluating the prompt
		@return nanoseconds
		~#
		method : public : GetPromptEvalDuration() ~ Int {
			return @prompt_eval_duration;
		}

		#~
		Get the number of tokens generated
		@return token count
		~#
		method : public : GetEvalCount() ~ Int {
			return @eval_count;
		}

		#~
		Get the time spent generating
		@return nanoseconds
		~#
		method : public : GetEvalDuration() ~ Int {
			return @eval_duration;
		}

		#~
		Get the generation speed
		@return tokens per second, or 0.0 if no timing was reported
		~#
		method : public : GetTokensPerSecond() ~ Float {
			if(@eval_duration <= 0) {
				return 0.0;
			};
			return @eval_count->As(Float) * 1000000000.0 / @eval_duration->As(Float);
		}
	}

	#~
	Ollama model interactions

```
prompt := "What number is this?";
file := System.IO.Filesystem.File->New("../gemini/thirteen.png");
Completion->Generate("llava", prompt, file)->PrintLine();
```
	~#
	class Completion from EndPoint {
		#~
		The response handling behind every Generate overload, as a function of the
		body text so it can be tested without a server.
		@param body response text from /api/generate
		@return the generated text, or Nil with the last error set
		~#
		function : ParseGenerateResponse(body : String) ~ String {
			reply := Reply->Parse(body);
			if(reply = Nil) {
				return Nil;
			};
			return reply->GetText();
		}

		#~
		Builds the /api/generate request body every Generate overload sends.
		@param model model name
		@param prompt prompt
		@param format output format ("json"), or Nil
		@param options options and request settings, or Nil
		@param images image files, or Nil
		@return request body, or Nil with the last error set if an image cannot be read
		~#
		function : BuildGenerateRequest(model : String, prompt : String, format : String, options : Options, images : File[]) ~ JsonElement {
			query_json := JsonElement->New(JsonElement->JsonType->OBJECT);
			query_json->Insert("model", model);
			query_json->Insert("prompt", prompt);
			if(options <> Nil) {
				options->ApplyTo(query_json, true);
			};
			if(format <> Nil) {
				query_json->Insert("format", format);
			};
			if(images <> Nil) {
				images_json := EncodeImages(images);
				if(images_json = Nil) {
					return Nil;
				};
				query_json->Insert("images", images_json);
			};
			query_json->Insert("stream", false);

			return query_json;
		}

		#~
		Generates a reply with its metadata (thinking, done reason, token counts, timings)
		@param model model name (i.e. llama3, llava)
		@param prompt prompt
		@param options options and request settings, or Nil
		@return reply, or Nil with the last error set
		~#
		function : GenerateReply(model : String, prompt : String, options : Options) ~ Reply {
			images : File[];
			return GenerateReply(model, prompt, images, options);
		}

		#~
		Generates a reply about images, with its metadata
		@param model model name (i.e. llava)
		@param prompt prompt
		@param images image files, or Nil
		@param options options and request settings, or Nil
		@return reply, or Nil with the last error set
		~#
		function : GenerateReply(model : String, prompt : String, images : File[], options : Options) ~ Reply {
			format : String;
			request := BuildGenerateRequest(model, prompt, format, options, images);
			if(request = Nil) {
				return Nil;
			};

			body := Post("/api/generate", request);
			if(body = Nil) {
				return Nil;
			};

			return Reply->Parse(body);
		}

		#~
		Generates a response from the model given an input
		@param model model name (i.e. llama3, llava)
		@param prompt prompt
		@return query response, or Nil with the last error set

```
response := Completion->Generate("llama3", "What is the capital of France?");
response->PrintLine();
```
		~#
		function : Generate(model : String, prompt : String) ~ String {
			format : String;
			return Generate(model, prompt, format, Nil);
		}

		#~
		Generates a response from the model given an input with options
		@param model model name (i.e. llama3, llava)
