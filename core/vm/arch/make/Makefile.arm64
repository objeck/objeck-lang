# Target CPU for shipped binaries (#893). -mcpu=native tuned every build to the machine
# that compiled it, and CI and release build linux-arm64 on SVE2 hardware, so the
# published tarball died with SIGILL on ARMv8.0-8.2 CPUs: Raspberry Pi 4/5, Graviton2,
# Ampere Altra, Snapdragon X, Apple silicon in a Linux VM. ARMv8-A is what every
# ARM64 Linux CPU implements (the Pi 4's Cortex-A72 included); -moutline-atomics keeps
# LSE atomics available at run time on the CPUs that have them. For a local build
# tuned to this machine: make ARM64_CPU=-mcpu=native
ARM64_CPU ?= -march=armv8-a -moutline-atomics
ARGS=-O3 -flto=auto $(ARM64_CPU) -Wall -D_ARM64 -D_RPI4 -Wno-unused-function -std=c++20 -MMD -MP

AR=gcc-ar
SRC=memory.o memory_verify.o
LIB=../memory.a

$(LIB): $(SRC)
	$(AR) -cvq $(LIB) $(SRC)

%.o: %.cpp
	$(CXX) $(ARGS) -c $< 

# Auto-generated header dependencies (see -MMD -MP in ARGS). Without these make
# never learned that the objects include ../shared/version.h and friends, so a
# header edit silently relinked stale .o files -- 'make clean' was mandatory.
-include $(wildcard *.d)

clean:
	rm -f *.o *.d *~ $(LIB)
