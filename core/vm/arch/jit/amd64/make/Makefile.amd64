ARGS=-O3 -flto=auto -D_X64 -Wall -Wno-unused-function -std=c++20 -mavx2 -Wno-deprecated-declarations -Wunused-variable -fno-sanitize-recover -MMD -MP

AR=gcc-ar
COMMON_LIBS=jit_common.a
COMMON_PATH=..
# ../jit_common.o is built by the jit_common.a sub-make, so it is NOT listed
# as a prerequisite: this makefile has a %.o: %.cpp rule that matches it, and
# under -j make would run that rule and the sub-make at the same time, both
# writing the same file -- or reach ar before either finished
#   ar: ../jit_common.o: No such file or directory
# Naming it only inside the recipe leaves make no way to try to produce it,
# while jit_common.a as a prerequisite still orders the sub-make first.
COMMON_OBJ=../jit_common.o
SRC=jit_amd_lp64.o
LIB=../../../jit_amd_lp64.a

$(LIB): $(COMMON_LIBS) $(SRC)
	rm -f $(LIB).tmp; $(AR) -cvq $(LIB).tmp $(COMMON_OBJ) $(SRC) && mv -f $(LIB).tmp $(LIB)

jit_common.a:
	cd $(COMMON_PATH); $(MAKE) -f make/Makefile.amd64

%.o: %.cpp
	$(CXX) -m64 $(ARGS) -c $< 

# Auto-generated header dependencies (see -MMD -MP in ARGS). Without these make
# never learned that the objects include ../shared/version.h and friends, so a
# header edit silently relinked stale .o files -- 'make clean' was mandatory.
-include $(wildcard *.d)

clean:
	cd $(COMMON_PATH); $(MAKE) -f make/Makefile.amd64 clean
	rm -f *.o *.d *~ $(LIB)
