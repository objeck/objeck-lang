ARGS=-O3 -Wall -Wall -std=c++20 -D_ARM64 -D_OBJECK_NATIVE_LIB_PATH -D_DEBUGGER -Wno-int-to-pointer-cast -Wno-unused-function -Wno-unused-variable -Wno-strict-overflow -MMD -MP

SRC=tree.o scanner.o parser.o debugger.o dap.o
OBJ_LIBS=../vm/vm.a ../vm/jit_arm_a64.a ../vm/memory.a
VM_PATH=../vm
MEM_PATH=../vm/arch
JIT_PATH=../vm/arch/jit/arm64
EXE=obd

$(EXE): $(SRC) $(OBJ_LIBS)
	$(CXX) -pthread -o $(EXE) $(SRC) $(OBJ_LIBS) -Wunused-function -ldl -lmbedtls -lmbedx509 -lmbedcrypto -lreadline -lz

../vm/vm.a:
	cd $(VM_PATH); $(MAKE) -f make/Makefile.arm64.obd

# The vm.a sub-make builds memory.a and jit_arm_a64.a itself, as its own
# prerequisites. Under -j these two rules ran beside it and rebuilt the same
# archives concurrently -- two gcc-ar -cvq on amd64/jit_common.a, then
#   ar: amd64/jit_common.a: file format not recognized
# and no obd. Ordering them after vm.a leaves them to find everything built.
../vm/memory.a ../vm/jit_arm_a64.a: | ../vm/vm.a

../vm/memory.a:
	cd $(MEM_PATH); $(MAKE) -f make/Makefile.arm64

../vm/jit_arm_a64.a:
	cd $(JIT_PATH); $(MAKE) -f make/Makefile.arm64
	
%.o: %.cpp
	$(CXX) $(ARGS) -c $< 

# Auto-generated header dependencies (see -MMD -MP in ARGS). Without these make
# never learned that the objects include ../shared/version.h and friends, so a
# header edit silently relinked stale .o files -- 'make clean' was mandatory.
-include $(wildcard *.d)

clean:
	cd $(VM_PATH); $(MAKE) -f make/Makefile.arm64.obd clean
	rm -f $(EXE) *.o *.d *~
