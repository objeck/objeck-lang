# objeck.org on the playground droplet. Append to /etc/caddy/Caddyfile beside the
# playground.objeck.org block, then `caddy validate` and `systemctl reload caddy`.
# Do that only AFTER the DNS records point at this host (Let's Encrypt needs them).
#
# Objeck serves the site (programs/examples/site_server.obs, run by
# objeck-org-site.service on 127.0.0.1:8081); Caddy only terminates TLS, renews
# certificates and compresses. The staging names used during the soak:
#   staging.objeck.org   Caddy file_server   (the stable fallback)
#   staging2.objeck.org  Objeck, via the proxy below
#
# The deploy user's ~/public_html is the web root, so core/release/deploy_website.sh
# works unchanged: OBJECK_ORG_HOST=<droplet> OBJECK_ORG_USER=objeckorg.
# Pages, api/latest/ and objeck-release.pub all live under it.

# Security headers shared by the sites below. A snippet must be defined BEFORE it is
# imported, so this stays above them. The CSP is report-only: it logs in the browser console
# what it would block and breaks nothing; to enforce it, rename the header to
# Content-Security-Policy after the console stays clean. HSTS is short on purpose (one day)
# and has no includeSubDomains, because cpanel, ftp, mail and admin live on another host.
# The hosts are what the site loads: cdnjs (highlight.js), jsDelivr (mermaid), Google Fonts,
# GitHub and shields.io images, and the YouTube player that loads only when played.
(security_headers) {
	header {
		Strict-Transport-Security "max-age=86400"
		X-Frame-Options "SAMEORIGIN"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https://raw.githubusercontent.com https://img.shields.io https://github.com; media-src 'self'; frame-src https://www.youtube-nocookie.com https://www.youtube.com; connect-src 'self' https://cdn.jsdelivr.net; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
	}
}

objeck.org {
	import security_headers
	redir https://www.objeck.org{uri} permanent
}

www.objeck.org {
	import security_headers
	encode zstd gzip
	reverse_proxy 127.0.0.1:8081 {
		# if the Objeck process is down, fail over to serving the files directly
		# (see the handle_errors block) rather than returning a 502
		fail_duration 10s
	}

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	handle_errors {
		@upstream expression {http.error.status_code} in [502, 503, 504]
		handle @upstream {
			root * /home/objeckorg/public_html
			rewrite * {http.request.uri.path}
			file_server
		}
	}

	log {
		output file /var/log/caddy/objeck-org-access.log
		format json
	}
}

# Stable fallback for the whole setup: Caddy serving the files itself.
# Swap this in for the reverse_proxy above to leave Objeck out of the path:
#   root * /home/objeckorg/public_html
#   file_server
